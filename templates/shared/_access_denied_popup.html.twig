{# Access Denied Popup Overlay - using theme-matching styles #}
<div id="accessDeniedOverlay" class="access-denied-overlay" style="display: none;">
    <div class="access-denied-backdrop"></div>
    <div class="access-denied-popup">
        <div class="access-denied-icon">🚫</div>
        <h2 class="access-denied-title">Access Denied</h2>
        <p class="access-denied-message" id="accessDeniedMessage"></p>
        <button type="button" class="access-denied-close-btn" onclick="closeAccessDeniedPopup()">OK</button>
    </div>
</div>

<style>
.access-denied-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: accessDeniedFadeIn 0.3s ease-out;
}

.access-denied-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

.access-denied-popup {
    position: relative;
    z-index: 2;
    width: 90%;
    max-width: 450px;
    padding: 2.5rem 2rem;
    background: rgba(0, 0, 0, 0.85);
    border: 2px solid rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.4);
    border-radius: 24px;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    animation: accessDeniedSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-align: center;
}

[data-theme="light"] .access-denied-popup {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.3);
    box-shadow: 0 20px 60px rgba(108, 92, 231, 0.2),
                0 0 0 1px rgba(255, 255, 255, 0.8) inset;
}

@keyframes accessDeniedFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes accessDeniedSlideUp {
    from {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.access-denied-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    animation: accessDeniedIconPulse 2s ease-in-out infinite;
}

@keyframes accessDeniedIconPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.access-denied-title {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    background: var(--main-home-accent-gradient, linear-gradient(135deg, transparent, transparent, transparent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.access-denied-message {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.05rem;
    margin-bottom: 2rem;
    line-height: 1.6;
}

[data-theme="light"] .access-denied-message {
    color: rgba(0, 0, 0, 0.75);
}

.access-denied-close-btn {
    padding: 0.9rem 2.5rem;
    background: var(--main-home-accent-gradient, linear-gradient(135deg, transparent, transparent, transparent));
    color: white;
    border: none;
    border-radius: 14px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.4);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.access-denied-close-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.5);
}

.access-denied-close-btn:active {
    transform: translateY(0);
}

/* Closing animation */
.access-denied-overlay.closing {
    animation: accessDeniedFadeOut 0.3s ease-out forwards;
}

.access-denied-overlay.closing .access-denied-popup {
    animation: accessDeniedSlideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes accessDeniedFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
}

@keyframes accessDeniedSlideDown {
    from {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
    to {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
    }
}

/* Prevent body scroll when popup is open */
body.access-denied-active {
    overflow: hidden;
}
</style>

{% if app.session.has('access_denied_message') %}
<script>
(function() {
    const message = {{ app.session.get('access_denied_message')|json_encode|raw }};
    
    // Clear the session message
    {% do app.session.remove('access_denied_message') %}
    
    // Show popup after a short delay to ensure DOM is ready
    setTimeout(function() {
        const overlay = document.getElementById('accessDeniedOverlay');
        const messageEl = document.getElementById('accessDeniedMessage');
        
        if (overlay && messageEl) {
            messageEl.textContent = message;
            overlay.style.display = 'flex';
            document.body.classList.add('access-denied-active');
        }
    }, 100);
})();
</script>
{% endif %}

<script>
function closeAccessDeniedPopup() {
    const overlay = document.getElementById('accessDeniedOverlay');
    
    if (overlay) {
        overlay.classList.add('closing');
        
        setTimeout(() => {
            overlay.style.display = 'none';
            overlay.classList.remove('closing');
            document.body.classList.remove('access-denied-active');
        }, 300);
    }
}
</script>
