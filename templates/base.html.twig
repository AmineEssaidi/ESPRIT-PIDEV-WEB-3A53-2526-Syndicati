<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <script src="{{ asset('frontend/js/global-settings.js') }}"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sneat - Dashboard{% endblock %}</title>

    <!-- Preload critical resources -->
    {% if app.request.get('_route') starts with 'admin_' %}
        <link rel="preload" href="{{ asset('css/admin.css') }}" as="style">
        <link rel="stylesheet" href="{{ asset('frontend/css/syndicat.css') }}">
        <link rel="stylesheet" href="{{ asset('frontend/css/glass-modal.css') }}">
        <link rel="preconnect" href="https://demos.themeselection.com">
        <!-- CSS Dependencies -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
        <link href="{{ asset('css/admin.css') }}" rel="stylesheet">
        <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    {% else %}
        <link rel="preload" href="{{ asset('css/app.css') }}" as="style">
        <link rel="preconnect" href="https://demos.themeselection.com">
        <!-- CSS Dependencies -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
        <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    {% endif %}

    {% block stylesheets %}{% endblock %}
</head>
</head>
{% set is_admin = app.request.get('_route') starts with 'admin_' %}

<body class="{{ is_admin ? 'admin-body' : 'layout-menu-fixed' }}"
      data-user-info="{{ app.session.get('user') ? 'true' : 'false' }}"
      data-user-role="{{ app.session.get('user').role|default('Guest') }}"
      data-is-admin="{{ app.session.get('user') and app.session.get('user').role in ['OWNER', 'ADMIN', 'SUPERADMIN'] ? 'true' : 'false' }}">
    {% include 'frontend/shared/_global_video_background.html.twig' %}
    <!-- Page Loader -->
    <div class="page-loader" id="pageLoader">
        <div class="loader-content">
            <div class="loader-dots">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
        </div>
    </div>

    {% include 'shared/_access_denied_popup.html.twig' %}
    {% include 'shared/_obsidian_modals.html.twig' %}

    {% if is_admin %}
        <div class="admin-shell">
            {% include 'admin/_sidebar.html.twig' %}

            <main class="admin-main">
                <div class="admin-main-surface">
    {% else %}
        <div class="layout-wrapper layout-content-navbar">
            <div class="layout-page">
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
    {% endif %}

                        {% block content %}{% endblock %}

    {% if is_admin %}
                </div>
            </main>
        </div>
    {% else %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- JavaScript Dependencies - defer for non-blocking load -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="{{ asset('js/app.js') }}" defer></script>
    <script src="{{ asset('js/page-loader.js') }}"></script>
    <script src="{{ asset('js/address-bar-rewrite.js') }}"></script>
    {% if is_admin %}
        <script src="{{ asset('js/admin-core.js') }}"></script>
        <script src="{{ asset('js/admin-sidebar.js') }}" defer></script>
        <script src="{{ asset('js/admin-delete.js') }}" defer></script>
        {% include 'admin/_delete_popup.html.twig' %}
    {% endif %}

    {% block javascripts %}{% endblock %}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // function to disable validation
            const disableValidation = (form) => {
                form.setAttribute('novalidate', 'novalidate');
            };

            // Disable for existing forms
            document.querySelectorAll('form').forEach(disableValidation);

            // Observer for dynamic forms
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    mutation.addedNodes.forEach((node) => {
                        if (node.tagName === 'FORM') {
                            disableValidation(node);
                        } else if (node.querySelectorAll) {
                            node.querySelectorAll('form').forEach(disableValidation);
                        }
                    });
                });
            });

            observer.observe(document.body, { childList: true, subtree: true });
        });
    </script>

    <script src="{{ asset('frontend/js/syndicati-agent.js') }}" defer></script>
</body>
</html>