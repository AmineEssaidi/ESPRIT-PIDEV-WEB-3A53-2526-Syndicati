<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <script src="{{ asset('frontend/js/global-settings.js') }}"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sneat - Dashboard{% endblock %}</title>

    <!-- Preload critical resources -->
    {% if app.request.get('_route') starts with 'admin_' %}
        <link rel="preload" href="{{ asset('css/admin.css') }}" as="style">
        <link rel="preconnect" href="https://demos.themeselection.com">
        <!-- CSS Dependencies -->
        <link href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}" rel="stylesheet">
        <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
        <link href="{{ asset('css/admin.css') }}" rel="stylesheet">
        <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    {% else %}
        <link rel="preload" href="{{ asset('css/app.css') }}" as="style">
        <link rel="preconnect" href="https://demos.themeselection.com">
        <!-- CSS Dependencies -->
        <link href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('css/app.css') }}" rel="stylesheet">
        <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    {% endif %}

    {% block stylesheets %}{% endblock %}
</head>
</head>
{% set is_admin = app.request.get('_route') starts with 'admin_' %}

<body class="{{ is_admin ? 'admin-body' : 'layout-menu-fixed' }}">
    <!-- Page Loader -->
    <div class="page-loader" id="pageLoader">
        <div class="loader-content">
            <div class="loader-dots">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
        </div>
    </div>

    {% include 'shared/_access_denied_popup.html.twig' %}

    {% if is_admin %}
        <div class="admin-shell">
            {% include 'admin/_sidebar.html.twig' %}

            <main class="admin-main">
                <div class="admin-main-surface">
    {% else %}
        <div class="layout-wrapper layout-content-navbar">
            <div class="layout-page">
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
    {% endif %}

                        {% block content %}{% endblock %}

    {% if is_admin %}
                </div>
            </main>
        </div>
    {% else %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- JavaScript Dependencies - defer for non-blocking load -->
    <script src="{{ asset('vendor/bootstrap/bootstrap.bundle.min.js') }}" defer></script>
    <script src="{{ asset('js/app.js') }}" defer></script>
    <script src="{{ asset('js/page-loader.js') }}"></script>
    {% if is_admin %}
        <script src="{{ asset('js/admin-sidebar.js') }}" defer></script>
    {% endif %}

    <script>
    // Admin page loader navigation (matches frontend)
    document.addEventListener('DOMContentLoaded', function() {
        const loader = document.getElementById('pageLoader');
        if (!loader) return;
        function showLoader() {
            loader.classList.remove('fade-out');
            loader.classList.add('active');
            loader.offsetHeight;
        }
        // Intercept all internal <a> clicks
        document.body.addEventListener('click', function(e) {
            const a = e.target.closest('a');
            if (!a) return;
            const href = a.getAttribute('href');
            if (!href || href.startsWith('#') || a.hasAttribute('target') || a.hasAttribute('download') || a.getAttribute('rel') === 'external') return;
            // Only handle internal links
            if (href.startsWith('http') && !href.startsWith(window.location.origin)) return;
            // Ignore JS links
            if (href.startsWith('javascript:')) return;
            // Ignore if modifier keys are pressed
            if (e.ctrlKey || e.shiftKey || e.metaKey || e.altKey) return;
            // Prevent default and show loader
            e.preventDefault();
            showLoader();
            setTimeout(() => { window.location.href = href; }, 350);
        });
    });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>