<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <script src="{{ asset('frontend/js/global-settings.js') }}"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sneat - Dashboard{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">

    <!-- Preload critical resources -->
    {% if app.request.get('_route') starts with 'admin_' %}
        <link rel="preload" href="{{ asset('css/admin.css') }}" as="style">
        <link rel="preconnect" href="https://demos.themeselection.com">
        <!-- CSS Dependencies -->
        <link href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}" rel="stylesheet">
        <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
        <link href="{{ asset('css/admin.css') }}" rel="stylesheet">
        <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    {% else %}
        <link rel="preload" href="{{ asset('css/app.css') }}" as="style">
        <link rel="preconnect" href="https://demos.themeselection.com">
        <!-- CSS Dependencies -->
        <link href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('css/app.css') }}" rel="stylesheet">
        <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    {% endif %}

    {% block stylesheets %}{% endblock %}
</head>
</head>
{% set is_admin = app.request.get('_route') starts with 'admin_' %}

<body class="{{ is_admin ? 'admin-body' : 'layout-menu-fixed' }}">
    <!-- Page Loader -->
    <div class="page-loader" id="pageLoader">
        <div class="loader-content">
            <div class="loader-dots">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
        </div>
    </div>

    {% include 'shared/_access_denied_popup.html.twig' %}

    {% if is_admin %}
        <div class="admin-shell">
            {% include 'admin/_sidebar.html.twig' %}

            <main class="admin-main">
                <div class="admin-main-surface">
    {% else %}
        <div class="layout-wrapper layout-content-navbar">
            <div class="layout-page">
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
    {% endif %}

                        {% block content %}{% endblock %}

    {% if is_admin %}
                </div>
            </main>
        </div>
    {% else %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- JavaScript Dependencies - defer for non-blocking load -->
    <script src="{{ asset('vendor/bootstrap/bootstrap.bundle.min.js') }}" defer></script>
    <script src="{{ asset('js/app.js') }}" defer></script>
    <script src="{{ asset('js/page-loader.js') }}"></script>
    {% if is_admin %}
        <script src="{{ asset('js/admin-sidebar.js') }}" defer></script>
    {% endif %}

    {% block javascripts %}{% endblock %}
</body>
</html>