{% extends 'base_symfony.html.twig' %}

{% block title %}Reponse{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Reponse #{{ reponse.id }}</h1>

    <table class="table table-dark table-bordered">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reponse.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ reponse.titrereponse }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ reponse.messagereponse }}</td>
            </tr>
            <tr>
                <th>Created At</th>
                <td>{{ reponse.createdAt ? reponse.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-3 d-flex gap-2">
        <a href="{{ path('app_reponse_index') }}" class="btn btn-secondary">Back to list</a>
        <a href="{{ path('app_reponse_edit', {'id': reponse.id}) }}" class="btn btn-warning">Edit</a>
        {{ include('syndicat/reponse/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
