{% extends 'base_symfony.html.twig' %}

{% block title %}New Reponse{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Create New Response for Reclamation #{{ reclamation.id }}</h1>

    <div class="card bg-dark text-white border-secondary mb-4">
        <div class="card-body">
            <h5 class="card-title">Original Reclamation: {{ reclamation.titrereclamations }}</h5>
            <p class="card-text">{{ reclamation.descreclamation }}</p>
        </div>
    </div>

    {{ include('syndicat/reponse/_form.html.twig') }}

    <div class="mt-3">
        <a href="{{ path('app_reclamation_index') }}" class="btn btn-secondary">Back to Reclamations</a>
    </div>
</div>
{% endblock %}
