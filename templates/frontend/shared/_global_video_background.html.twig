<!-- Global Premium Video Background -->
{% set is_static_video_page = app.request.attributes.get('_route') starts with 'frontend_settings' %}
<div class="global-video-bg-container">
    {% if is_static_video_page %}
        <div id="heroVideoGlobal" class="global-video-element global-video-static" aria-hidden="true"></div>
    {% else %}
        <video id="heroVideoGlobal" autoplay loop muted playsinline preload="metadata" class="global-video-element" style="background: #000;">
            <source src="{{ asset('videos/syndicati.mp4') }}" type="video/mp4">
            Your browser does not support the video tag.
        </video>
    {% endif %}
    <div class="global-video-overlay"></div>
</div>

<style>
/* Critical styles to ensure video background works everywhere */
.global-video-bg-container {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1 !important; /* Changed from -9999 to -1 to ensure visibility */
    overflow: hidden;
    pointer-events: none;
    background: transparent;
}

.global-video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
}

.global-video-static {
    background:
        radial-gradient(circle at 22% 18%, rgba(255, 190, 96, 0.24), transparent 34%),
        radial-gradient(circle at 82% 22%, rgba(16, 185, 129, 0.16), transparent 34%),
        linear-gradient(135deg, #10100e 0%, #1e1515 48%, #061b15 100%);
}

.global-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5); /* Universal darken overlay for text readability */
    z-index: 1;
}

/* Force transparency on documented layout containers to let video show through */
html, body, 
.layout-wrapper, .layout-container, .layout-page, .content-wrapper,
.main-home-layout-wrapper, .main-home-page, .main-home-content-wrapper,
.container-xxl, .app-brand {
    background: transparent !important;
}

/* Ensure navbar doesn't have a solid blocking background if not intended */
.layout-navbar {
    background: rgba(255, 255, 255, 0.05) !important;
    backdrop-filter: blur(10px);
}
</style>

<script>
(function() {
    if (window.hasGlobalVideo) return;
    window.hasGlobalVideo = true;

    const video = document.getElementById('heroVideoGlobal');
    if (video && video.tagName === 'VIDEO') {
        video.playbackRate = 0.5;
        // Force play on low power mode devices if possible
        video.setAttribute('playsinline', '');
        video.muted = true;
        
        const playVideo = () => {
            video.play()
                .then(() => {
                    console.log("Global video playback started");
                })
                .catch(err => {
                    console.warn("Autoplay blocked or failed:", err);
                });
        };

        // Emit signal when actually rendering frames to avoid black/gray flashes
        video.onplaying = () => {
            window.videoBgReady = true;
            document.dispatchEvent(new CustomEvent('video-bg-ready'));
            console.log("Video BG Signal: READY (Flag Set)");
        };
        video.addEventListener('ended', playVideo);
        playVideo();
        
        // Refocus play on user interaction if autoplay failed
        document.addEventListener('click', () => {
             if (video.paused) playVideo();
        }, { once: true });
    }
})();
</script>
