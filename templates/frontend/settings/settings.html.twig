                                    color: #f8fffb;
                                    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.48);
                                }
                                .settings-page .main-home-hero-subtitle {
                                    text-align: center;
                                    display: block;
                                    margin-left: auto;
                                    margin-right: auto;
                                    margin-bottom: 2rem;
                                    background: none;
                                    -webkit-background-clip: border-box;
                                    -webkit-text-fill-color: currentColor;
                                    background-clip: border-box;
                                    color: rgba(248, 255, 251, 0.78);
                                    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.42);
                                }

                                html.accents-animated .settings-page .main-home-hero-subtitle {
                                    animation: none;
                                }

                                .settings-container {
                                    width: 100%;
                                    display: flex;
                                    flex-direction: column;
                                    align-items: center;
                                }

                                #theme-customization-form {
                                    display: flex;
                                    flex-direction: column;
                                    align-items: center;
                                    width: 100%;
                                    gap: 3rem;
                                }

                                .settings-section {
                                    display: flex;
                                    flex-direction: row;
                                    align-items: flex-start;
                                    gap: 3rem;
                                    padding: 3rem 4.5rem;
                                    background: rgba(255, 255, 255, 0.03);
                                    border: 1px solid rgba(255, 255, 255, 0.1);
                                    border-radius: 40px;
                                    backdrop-filter: none;
                                    -webkit-backdrop-filter: none;
                                    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
                                    margin: 0 auto 3rem auto;
                                    width: 96%;
                                    max-width: 1500px;
                                    box-sizing: border-box;
                                    content-visibility: auto;
                                    contain-intrinsic-size: 380px;
                                }

                                .settings-section:hover {
                                    background: linear-gradient(145deg, rgba(var(--main-home-accent-rgb), 0.18), rgba(0, 0, 0, 0.42) 48%, rgba(255, 255, 255, 0.06));
                                    border-color: rgba(var(--main-home-accent-rgb), 0.42);
                                    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.32), 0 0 22px rgba(var(--main-home-accent-rgb), 0.10);
                                }

                                .settings-section-icon {
                                    font-size: 2.2rem;
                                    flex-shrink: 0;
                                    width: 70px;
                                    height: 70px;
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    color: #f8fffb;
                                    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)), rgba(var(--main-home-accent-rgb), 0.16);
                                    border-radius: 20px;
                                    border: 1px solid rgba(var(--main-home-accent-rgb), 0.28);
                                    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2), 0 0 26px rgba(var(--main-home-accent-rgb), 0.14);
                                }

                                .settings-section-content {
                                    flex: 1;
                                }

                                .settings-section-title {
                                    font-size: 1.6rem;
                                    font-weight: 800;
                                    margin: 0 0 0.5rem 0;
                                    background: none;
                                    -webkit-background-clip: border-box;
                                    -webkit-text-fill-color: currentColor;
                                    background-clip: border-box;
                                    color: #f8fffb;
                                    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.38);
                                    letter-spacing: -0.5px;
                                    text-align: left;
                                }

                                html.accents-animated .settings-section-title {
                                    animation: none;
                                }

                                .settings-section-desc {
                                    color: rgba(248, 255, 251, 0.74);
                                    font-size: 1.1rem;
                                    margin: 0 0 2.5rem 0;
                                    max-width: none;
                                    line-height: 1.6;
                                }

                                .settings-theme-toggles {
                                    display: flex;
                                    gap: 1.5rem;
                                    flex-wrap: wrap;
                                    width: 100%;
                                    justify-content: flex-start;
                                }

                                .settings-theme-card {
                                    flex: 1;
                                            min-width: 200px;
                                            cursor: pointer;
                                            position: relative;
                                }

                                .settings-theme-card input {
                                            display: none;
                                }

                                .settings-theme-card-content {
                                            padding: 1.25rem;
                                            background: rgba(0, 0, 0, 0.4);
                                            border: 2px solid rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.2);
                                            border-radius: 16px;
                                            display: flex;
                                            align-items: center;
                                            gap: 1rem;
                                            transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
                                }

                                .settings-theme-card:hover .settings-theme-card-content {
                                            background: rgba(0, 0, 0, 0.5);
                                            border-color: rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.4);
                                    transform: translateY(-2px);
                                }

                                .settings-theme-card input:checked + .settings-theme-card-content {
                                            background: rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.15);
                                            border-color: var(--main-home-accent-color, #6c5ce7);
                                            box-shadow: 0 4px 20px rgba(var(--main-home-accent-rgb, 108, 92, 231), 0.3);
                                }

                                .settings-theme-icon {
                                            font-size: 1.8rem;
                                }

                                .settings-theme-info {
                                            display: flex;
                                            flex-direction: column;
                                            gap: 0.25rem;
                                            flex: 1;
                                }

                                .settings-theme-name {
                                            font-weight: 600;
                                            font-size: 1rem;
                                            color: #fff;
                                }

                                .settings-theme-tag {
                                            font-size: 0.8rem;
                                            color: rgba(255, 255, 255, 0.5);
                                            text-transform: uppercase;
                                            letter-spacing: 0.5px;
                                }

