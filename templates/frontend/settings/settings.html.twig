                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #ff6b6b, #feca57, #ff9ff3)" data-name="Coral"  style="background: linear-gradient(135deg, #ff6b6b, #feca57, #ff9ff3);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #0abde3, #2e86de, #54a0ff)" data-name="Ocean"  style="background: linear-gradient(135deg, #0abde3, #2e86de, #54a0ff);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #1dd1a1, #10ac84, #00d2d3)" data-name="Forest"  style="background: linear-gradient(135deg, #1dd1a1, #10ac84, #00d2d3);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #f39c12, #e74c3c, #e67e22)" data-name="Amber"  style="background: linear-gradient(135deg, #f39c12, #e74c3c, #e67e22);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #a29bfe, #6c5ce7, #fd79a8)" data-name="Lavender"  style="background: linear-gradient(135deg, #a29bfe, #6c5ce7, #fd79a8);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #00b894, #00cec9, #81ecec)" data-name="Mint"  style="background: linear-gradient(135deg, #00b894, #00cec9, #81ecec);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%)" data-name="Sky High"  style="background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, rgba(255,255,255,0.24) 0%, rgba(255,255,255,0.05) 38%, rgba(255,255,255,0.18) 66%, rgba(255,255,255,0.03) 100%)" data-color="#f5f5f5" data-name="Clear Glass"  style="background: linear-gradient(135deg, rgba(255,255,255,0.42) 0%, rgba(255,255,255,0.08) 42%, rgba(255,255,255,0.30) 72%, rgba(255,255,255,0.04) 100%);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, rgba(255,255,255,0.18) 0%, rgba(8,12,18,0.05) 30%, rgba(255,255,255,0.26) 54%, rgba(0,0,0,0.10) 100%)" data-color="#e5e7eb" data-name="Smoked Glass"  style="background: linear-gradient(135deg, rgba(255,255,255,0.34) 0%, rgba(8,12,18,0.18) 40%, rgba(255,255,255,0.24) 64%, rgba(0,0,0,0.26) 100%);"><span class="settings-accent-check">✓</span></button>
                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.02) 28%, rgba(255,255,255,0.32) 52%, rgba(255,255,255,0.08) 100%)" data-color="#ffffff" data-name="Crystal"  style="background: linear-gradient(135deg, rgba(255,255,255,0.28) 0%, rgba(255,255,255,0.04) 35%, rgba(255,255,255,0.46) 58%, rgba(255,255,255,0.10) 100%);"><span class="settings-accent-check">✓</span></button>
                                            </div>
                                            
                                            <div class="settings-custom-color">
