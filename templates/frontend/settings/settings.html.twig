                                            <p class="settings-section-desc" >{{ 'settings.language_hint'|trans }}</p>
                                            
                                            <div class="settings-language-select">
                                                <select id="languageSelect" class="settings-select">
                                                    <option value="fr" selected>🇫🇷 Français</option>
