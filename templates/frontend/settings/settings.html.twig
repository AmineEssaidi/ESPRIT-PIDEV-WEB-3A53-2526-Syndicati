                                                <button type="button" class="settings-accent-btn accent-choice" data-gradient="linear-gradient(135deg, #06b6d4, #6c5ce7, #ff1493)" data-name="Cyan"  style="background: linear-gradient(135deg, #06b6d4, #6c5ce7, #ff1493);"><span class="settings-accent-check">✓</span></button>
