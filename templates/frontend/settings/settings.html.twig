<script src="{{ asset('js/page-loader.js') }}"></script>
<script>
                                    document.addEventListener('DOMContentLoaded', function() {
                                        const themeRadios = document.querySelectorAll('input[name="themeMode"]');
                                        let theme = localStorage.getItem('theme') || 'dark';
                                        themeRadios.forEach(r => { 
                                            if(r.value === theme) {
                                                r.checked = true;
                                                r.closest('.settings-theme-card')?.classList.add('selected');
                                            }
                                        });
                                        themeRadios.forEach(r => r.addEventListener('change', function() {
                                            document.querySelectorAll('.settings-theme-card').forEach(card => card.classList.remove('selected'));
                                            this.closest('.settings-theme-card')?.classList.add('selected');
                                            localStorage.setItem('theme', this.value);
                                            document.documentElement.setAttribute('data-theme', this.value);
                                            // Optionally update any theme icons or UI here if needed
                                        }));

                                        const accentChoices = document.querySelectorAll('.accent-choice');
                                        const customAccentColor = document.getElementById('customAccentColor');
                                        const customAccentHex = document.getElementById('customAccentHex');
                                        let accent = localStorage.getItem('accent-gradient') || 'linear-gradient(135deg, #6c5ce7, #8b5cf6, #06b6d4)';
                                        let accentColor = localStorage.getItem('accent-color') || '#6c5ce7';
                                        
                                        accentChoices.forEach(btn => {
                                            if(btn.dataset.gradient === accent) {
                                                btn.classList.add('selected');
                                            }
                                            btn.addEventListener('click', function() {
                                                accentChoices.forEach(b => b.classList.remove('selected'));
                                                this.classList.add('selected');
                                                localStorage.setItem('accent-gradient', this.dataset.gradient);
                                                const color = this.dataset.gradient.match(/linear-gradient\([^,]+,\s*([^,\s)]+)/)?.[1] || '#6c5ce7';
                                                localStorage.setItem('accent-color', color);
                                                customAccentHex.value = '';
                                                window.location.reload();
                                            });
                                        });
                                        
                                        customAccentColor.value = accentColor;
                                        customAccentColor.addEventListener('input', function() {
                                            const color = this.value;
                                            const grad = `linear-gradient(135deg, ${color}, #8b5cf6, #06b6d4)`;
                                            localStorage.setItem('accent-gradient', grad);
                                            localStorage.setItem('accent-color', color);
                                            customAccentHex.value = color;
                                            window.location.reload();
                                        });
                                        customAccentHex.addEventListener('input', function() {
                                            let val = this.value;
                                            if (!val.startsWith('#')) val = '#' + val;
                                            if (/^#[0-9a-fA-F]{3,8}$/.test(val)) {
                                                const grad = `linear-gradient(135deg, ${val}, #8b5cf6, #06b6d4)`;
                                                localStorage.setItem('accent-gradient', grad);
                                                localStorage.setItem('accent-color', val);
                                                customAccentColor.value = val;
                                                window.location.reload();
                                            }
                                        });

                                        const languageSelect = document.getElementById('languageSelect');
                                        if (languageSelect) {
                                            let lang = localStorage.getItem('lang') || 'fr';
                                            languageSelect.value = lang;
                                            languageSelect.addEventListener('change', function() {
                                                if (window.setLanguage) {
                                                    window.setLanguage(this.value);
                                                }
                                            });
                                        }

                                        setTimeout(() => {
                                            if (window.SmartTranslate) {
                                                let lang = localStorage.getItem('lang') || 'fr';
                                                SmartTranslate.init(lang);
                                            }
                                        }, 200);
                                    });
</script>
