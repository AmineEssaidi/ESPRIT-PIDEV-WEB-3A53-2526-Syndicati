                                .settings-theme-card input:checked + .settings-theme-card-content .settings-theme-check {
                                            background: var(--main-home-accent-gradient, linear-gradient(135deg, #04130f 0%, #0a4f35 24%, #10b981 48%, #25f2a3 68%, #d6fff1 82%, #063b2d 100%));
                                            border-color: transparent;
                                }

                                .settings-theme-card input:checked + .settings-theme-card-content .settings-theme-check::after {
                                            content: '✓';
                                            color: white;
                                            font-size: 0.9rem;
                                            font-weight: 700;
                                }

