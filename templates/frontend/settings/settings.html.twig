                                            <div class="settings-accessibility-grid">
                                                <label class="settings-toggle-wrapper settings-accessibility-toggle">
                                                    <span>
                                                        <strong>Reduce Motion</strong>
                                                        <small>Minimize animated transitions and scrolling effects.</small>
                                                    </span>
                                                    <span class="settings-toggle">
                                                        <input type="checkbox" id="accessReduceMotion">
                                                        <span class="settings-toggle-slider"></span>
                                                    </span>
                                                </label>
                                                <label class="settings-toggle-wrapper settings-accessibility-toggle">
                                                    <span>
                                                        <strong>High Contrast</strong>
                                                        <small>Boost contrast for text, panels, and focus states.</small>
                                                    </span>
                                                    <span class="settings-toggle">
                                                        <input type="checkbox" id="accessHighContrast">
                                                        <span class="settings-toggle-slider"></span>
                                                    </span>
                                                </label>
                                                <label class="settings-toggle-wrapper settings-accessibility-toggle">
                                                    <span>
                                                        <strong>Dyslexia-Friendly Font</strong>
                                                        <small>Use a wider, simpler font with more spacing.</small>
                                                    </span>
                                                    <span class="settings-toggle">
                                                        <input type="checkbox" id="accessDyslexiaFont">
                                                        <span class="settings-toggle-slider"></span>
                                                    </span>
                                                </label>
                                                <label class="settings-toggle-wrapper settings-accessibility-toggle">
                                                    <span>
                                                        <strong>Comfortable Controls</strong>
                                                        <small>Use larger tap targets for buttons, links, and fields.</small>
                                                    </span>
                                                    <span class="settings-toggle">
                                                        <input type="checkbox" id="accessComfortableTargets">
                                                        <span class="settings-toggle-slider"></span>
                                                    </span>
                                                </label>
                                                <label class="settings-toggle-wrapper settings-accessibility-toggle">
                                                    <span>
                                                        <strong>Voice Input</strong>
                                                        <small>Add dictation buttons to searches, forms, comments, and complaints.</small>
                                                    </span>
                                                    <span class="settings-toggle">
                                                        <input type="checkbox" id="accessVoiceInput">
                                                        <span class="settings-toggle-slider"></span>
                                                    </span>
                                                </label>
                                                <label class="settings-toggle-wrapper settings-accessibility-toggle">
                                                    <span>
                                                        <strong>Color-Blind Safe Status</strong>
                                                        <small>Add symbols beside status colors so meaning is not color-only.</small>
                                                    </span>
                                                    <span class="settings-toggle">
                                                        <input type="checkbox" id="accessColorblindSafe">
                                                        <span class="settings-toggle-slider"></span>
                                                    </span>
                                                </label>
                                                <label class="settings-toggle-wrapper settings-accessibility-toggle">
                                                    <span>
                                                        <strong>Agent Captions</strong>
                                                        <small>Show captions/transcripts for spoken AI responses.</small>
                                                    </span>
                                                    <span class="settings-toggle">
                                                        <input type="checkbox" id="accessAgentCaptions">
                                                        <span class="settings-toggle-slider"></span>
                                                    </span>
                                                </label>
                                            </div>

                                            <div class="settings-scale-control">
                                                <div>
                                                    <strong>Text and UI Scale</strong>
                                                    <small>Adjust the app size for easier reading.</small>
                                                </div>
                                                <input type="range" id="accessUiScale" min="0.9" max="1.25" step="0.05">
                                                <div class="settings-scale-actions">
                                                    <output id="accessUiScaleValue">100%</output>
                                                    <button type="button" id="accessUiScaleReset" class="settings-scale-reset">Reset</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <style>
                                .settings-page {
                                    --syndicati-logo-gradient: linear-gradient(135deg, #04130f 0%, #0a4f35 24%, #10b981 48%, #25f2a3 68%, #d6fff1 82%, #063b2d 100%);
                                    --syndicati-logo-rgb: 16, 185, 129;
                                }

                                /* Match header/footer width: they use width calc(100% - 60px) with 30px margin. */
                                .settings-page .main-home-content-wrapper .main-home-content-box {
                                    width: calc(100% - 60px);
                                    margin: 30px auto;
                                    max-width: none;
                                    background:
                                        linear-gradient(145deg, rgba(2, 9, 8, 0.86), rgba(var(--main-home-accent-rgb), 0.13)),
                                        rgba(0, 0, 0, 0.38);
                                    backdrop-filter: none;
                                    -webkit-backdrop-filter: none;
                                    border: 1px solid rgba(var(--main-home-accent-rgb), 0.22);
                                    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.34), 0 0 0 1px rgba(214, 255, 241, 0.06) inset;
                                    contain: paint;
                                }
                                .settings-master-wrapper {
                                    width: 100%;
                                    display: flex;
                                    flex-direction: column;
                                    align-items: center;
                                    padding: 2rem 0;
                                }

