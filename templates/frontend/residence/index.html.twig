{% extends targetBlock is defined ? 'base_ajax.html.twig' : 'base_symfony.html.twig' %}

{% block title %}Residences - Syndicati{% endblock %}

{% block stylesheets %}
    {% if not targetBlock is defined %}
        <link href="{{ asset('frontend/css/residence.css') }}" rel="stylesheet">
        <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
        <style>
            .apartment-review-widget { border: 1px solid rgba(255, 107, 107, 0.28); border-radius: 24px; background: linear-gradient(135deg, rgba(255, 107, 107, 0.12), rgba(255, 255, 255, 0.04)); box-shadow: 0 18px 60px rgba(0, 0, 0, 0.25); }
            .apt-review-score-grid { display: grid; grid-template-columns: repeat(11, minmax(36px, 1fr)); gap: 8px; }
            .apt-review-score-btn { min-height: 40px; border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 12px; color: rgba(255, 255, 255, 0.72); background: rgba(255, 255, 255, 0.06); font-weight: 800; transition: transform .16s ease, border-color .16s ease, background .16s ease, color .16s ease; }
            .apt-review-score-btn:hover, .apt-review-score-btn.active { transform: translateY(-2px); color: #fff; border-color: rgba(255, 107, 107, 0.72); background: linear-gradient(135deg, #ff6b6b, #ffd166, #ff9de2); box-shadow: 0 10px 28px rgba(255, 107, 107, 0.25); }
            .apt-review-meta { color: rgba(255, 255, 255, 0.62); font-size: .86rem; }
            @media (max-width: 768px) { .apt-review-score-grid { grid-template-columns: repeat(6, minmax(36px, 1fr)); } }
        </style>
    {% endif %}
{% endblock %}

{% block body %}
    {% if targetBlock is defined %}
        {% if targetBlock == 'apartments' %}
            {{ block('apartment_list') }}
        {% elseif targetBlock == 'details' %}
            {{ block('apartment_details') }}
        {% endif %}
    {% else %}
        <div class="main-home-layout-wrapper">
            <div class="main-home-page">
                {% include 'frontend/shared/_main_navbar.html.twig' with {'active_tab': 'residence'} %}
        
                <div class="main-home-page-content" style="padding: 0; padding-bottom: 5rem;">

                   {% if smsSent|default(false) %}
                   <div class="alert alert-success" role="alert">
                        Votre SMS a été envoyé avec succès!
                    </div>
                   {% endif %}

                    <!-- Hero Section -->
                    <div class="residence-hero">
                        <div class="residence-hero-glow"></div>
                        
                        <div class="container residence-hero-content">
                            <div class="row align-items-center">
                                <div class="col-lg-8" data-aos="fade-up">
                                    <span class="residence-badge">
                                        <i class='bx bx-home-alt-2'></i> Premium Living
                                    </span>
                                    <h1 class="residence-title">Luxury Living<br>Redefined.</h1>
                                    <p class="residence-subtitle">Explore our curated selection of high-end residences and apartments. Experience a new standard of comfort and elegance with Syndicati.</p>
                                    
                                    <div class="d-flex gap-3">
                                        <a href="#showcase" class="syndicat-btn-submit" style="width: auto; padding: 1rem 3rem; margin-top: 0; text-decoration: none;">
                                            View Residences <i class='bx bx-chevron-down' style="margin-left: 0.5rem;"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Residences Showcase -->
                    <div id="showcase" class="residence-showcase container-fluid px-5">
                        <div id="residenceSwitcher" class="glass-switcher">
                            
                            <!-- Face 1: Residences List -->
                            <div id="residenceFace" class="glass-switcher-face glass-switcher-face-main">
                                {{ block('residence_list') }}
                            </div>

                            <!-- Face 2: Apartments List (AJAX) -->
                            <div id="apartmentsFace" class="glass-switcher-face glass-switcher-face-extra">
                                <div id="apartmentsLoading" class="text-center p-5" style="display: none;">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                                <div id="apartmentsContent">
                                    {{ block('apartment_list') }}
                                </div>
                            </div>

                            <!-- Face 3: Apartment Details (AJAX) -->
                            <div id="detailsFace" class="glass-switcher-face glass-switcher-face-details">
                                <div id="detailsLoading" class="text-center p-5" style="display: none;">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                                <div id="detailsContent">
                                    {{ block('apartment_details') }}
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Pagination -->
                    {% if residences is defined and residences.pageCount|default(0) > 1 %}
                    <div class="residence-pagination-wrapper d-flex flex-column align-items-center mt-5" id="pagination-container">
                        <nav aria-label="Residence pagination">
                            <ul class="residence-pagination">
                                {% if residences.currentPageNumber > 1 %}
                                    <li><a href="{{ path('app_residence_index', {page: residences.currentPageNumber - 1}) }}" class="residence-page-link"><i class='bx bx-chevron-left'></i></a></li>
                                {% endif %}
                                
                                {% for page in 1..residences.pageCount %}
                                    <li>
                                        <a href="{{ path('app_residence_index', {page: page}) }}" 
                                           class="residence-page-link {{ page == residences.currentPageNumber ? 'active' : '' }}">
                                            {{ page }}
                                        </a>
                                    </li>
                                {% endfor %}
                                
                                {% if residences.currentPageNumber < residences.pageCount %}
                                    <li><a href="{{ path('app_residence_index', {page: residences.currentPageNumber + 1}) }}" class="residence-page-link"><i class='bx bx-chevron-right'></i></a></li>
                                {% endif %}
                            </ul>
                        </nav>
                        
                        <div class="text-center mt-3">
                            <p class="text-white-50 mb-0">
                                <i class='bx bx-buildings me-2'></i>
                                Showing {{ residences|length }} of {{ residences.getTotalItemCount }} residence{{ residences.getTotalItemCount != 1 ? 's' : '' }}
                                <span class="mx-2">•</span>
                                Page {{ residences.currentPageNumber }} of {{ residences.pageCount }}
                            </p>
                        </div>
                    </div>
                    {% endif %}

                </div> <!-- .main-home-page-content -->

                {% include 'frontend/shared/_main_footer.html.twig' %}
            </div> <!-- .main-home-page -->
        </div> <!-- .main-home-layout-wrapper -->

    {% endif %}
{% endblock %}

{% block residence_list %}
    <div class="section-label" data-aos="fade-up">
        <h2>Our Residences</h2>
        <p>Discover the perfect space that suits your lifestyle.</p>
    </div>

    <div class="row g-4">
        {% if residences is defined %}                    
            {% if residences is empty %}
                <div class="col-12 text-center p-5">
                    <h1 class="text-white">Aucune résidence disponible</h1>
                </div>
            {% else %}
                {% for res in residences %}
                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}">
                        <div class="residence-card">
                            <div class="position-relative overflow-hidden">
                                {% if res.imageR %}
                                    <img src="{{ media_url(res.imageR, 'residence_images') }}" alt="{{ res.nomR }}" class="residence-card-img">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=800&q=80" alt="Residence" class="residence-card-img">
                                {% endif %}
                                <div class="residence-card-overlay">
                                    <span class="residence-price-tag">{{ res.dateAjout|date('Y') }}</span>
                                </div>
                            </div>
                            <div class="residence-card-body">
                                <span class="residence-type">Residence</span>
                                <h3 class="residence-card-title">{{ res.nomR }}</h3>
                                <div class="residence-location">
                                    <i class='bx bx-map'></i> {{ res.adresse }}
                                </div>
                                <div class="residence-stats">
                                    <div class="residence-stat-item">
                                        <span class="residence-stat-value">{{ res.nEtages }}</span>
                                        <span class="residence-stat-label">Floors</span>
                                    </div>
                                    <div class="residence-stat-item">
                                        <span class="residence-stat-value">{{ res.totalAppartements }}</span>
                                        <span class="residence-stat-label">Units</span>
                                    </div>
                                    <div class="residence-stat-item">
                                        <span class="residence-stat-value">{{ res.nBlocs }}</span>
                                        <span class="residence-stat-label">Blocks</span>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-6">
                                        <button class="main-home-btn main-home-btn-primary w-100" onclick="loadApartments({{ res.idResidence }})">
                                            See Apartments
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <a class="main-home-btn main-home-btn-primary w-100" href="{{ path('pdf_residence', {'id': res.idResidence}) }}" download>Export PDF</a>
                                    </div>
                                </div>
                            </div>
                            <div class="residence-card-bar"></div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        {% endif %}
    </div>
{% endblock %}

{% block apartment_list %}
    {% if residence is defined and appartements is defined %}
        <div class="apartments-partial">
            <div class="section-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <button class="btn-switcher-back me-3" onclick="goBack('main')">
                        <i class='bx bx-left-arrow-alt'></i>
                    </button>
                    <h2 class="d-inline-block mb-0">Apartments in {{ residence.nomR }}</h2>
                </div>
            </div>

            <div class="row g-4">
                {% for apt in appartements %}
                    <div class="col-lg-4 col-md-6">
                        <div class="residence-card">
                            <div class="position-relative overflow-hidden">
                                {% if apt.imageA %}
                                    <img src="{{ media_url(apt.imageA, 'appartement_images') }}" class="residence-card-img">
                                {% else %}
                                    <img src="{{ media_url(residence.imageR, 'residence_images') }}" class="residence-card-img" style="filter:brightness(10%) blur(5px)">
                                {% endif %}
                                <div class="residence-card-overlay">
                                    <span class="residence-price-tag">{{ apt.disponible ? 'Available' : 'Rented' }}</span>
                                </div>
                            </div>
                            <div class="residence-card-body">
                                <h3>Apartment {{ apt.typeA }}</h3>
                                <div class="apartment-info-row">
                                    <i class='bx bx-buildings'></i>
                                    <span>Bloc {{ apt.appartementInfo.bloc ?? 'N/A' }}</span>
                                </div>
                                <div class="apartment-info-row">
                                    <i class='bx bx-layer'></i>
                                    <span>Floor {{ apt.appartementInfo.floor ?? 'N/A' }}</span>
                                    </div>
                                <div class="apartment-features">
                                    <div class="col-auto">
                                        {% if apt.parking %}
                                            <span class="apartment-feature-tag">
                                                <i class='bx bxs-car'></i> Parking
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="col-auto">
                                        {% if apt.disponible %}
                                            <span class="apartment-feature-tag">
                                                <i class='bx bx-money'></i> {{ apt.prixLocation }} TND
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="col-12 text-center mt-3">
                                        <hr>
                                        <button class="main-home-btn main-home-btn-primary w-100" onclick="loadApartmentDetails({{ apt.idApp }})">
                                            Voir les détails
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center p-5">
                        <p class="text-white-50">No apartments found for this residence.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block apartment_details %}
    {% if appartement is defined %}
        <div class="apartment-details-partial">
            <div class="section-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <button class="btn-switcher-back me-3" onclick="goBack('apartments')">
                        <i class='bx bx-left-arrow-alt'></i>
                    </button>
                    <h2 class="d-inline-block mb-0">Détails de l'Appartement</h2>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="residence-card p-0 overflow-hidden">
                        {% if appartement.imageA %}
                            <img src="{{ media_url(appartement.imageA, 'appartement_images') }}" class="w-100" style="height: 400px; object-fit: cover;">
                        {% else %}
                            <img src="{{ media_url(appartement.residence.imageR, 'residence_images') }}" class="w-100" style="height: 400px; object-fit: cover; filter: brightness(30%) blur(5px);">
                        {% endif %}
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="glass-form-group p-4 h-100">
                        <div class="mb-4">
                            <span class="residence-badge mb-3">Type {{ appartement.typeA }}</span>
                            <h3 class="mb-3">{{ appartement.residence.nomR }}</h3>
                        </div>
                        <div class="apartment-info-grid">
                            <div class="apartment-info-row">
                                <i class='bx bx-money'></i>
                                <span>Loyer: <strong>{{ appartement.prixLocation }} TND</strong></span>
                            </div>
                            <div class="apartment-info-row">
                                <i class='bx bx-checkbox-square'></i>
                                <span>Surface: <strong>{{ appartement.superficie }} m²</strong></span>
                            </div>
                            <div class="apartment-info-row">
                                <i class='bx bx-buildings'></i>
                                <span>Bloc {{ appartement.appartementInfo.bloc ?? 'N/A' }}</span>
                            </div>
                            <div class="apartment-info-row">
                                <i class='bx bx-layer'></i>
                                <span>Etage {{ appartement.appartementInfo.floor ?? 'N/A' }}</span>
                            </div>
                        </div>
                        {% if appartement.parking %}
                            <div class="mt-3">
                                <span class="apartment-feature-tag"><i class='bx bxs-car'></i> Parking inclus</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="apartment-review-widget mt-4 p-4"
                 data-apartment-review
                 data-save-url="{{ path('frontend_residence_review_save', {'id': appartement.idApp}) }}"
                 data-token="{{ csrf_token('review_frontend_' ~ appartement.idApp) }}"
                 data-current-score="{{ currentReviewScore|default(0) }}">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <span class="residence-badge mb-2"><i class='bx bxs-star'></i> Your review</span>
                        <h3 class="mb-1">Rate this apartment</h3>
                        <p class="text-white-50 mb-0">Choose a score from 0 to 10. Your latest score is saved per apartment.</p>
                    </div>
                    <div class="text-end">
                        <div class="fs-3 fw-bold"><span data-review-average>{{ reviewAverage|default(0) }}</span><span class="fs-6 text-white-50">/10</span></div>
                        <div class="apt-review-meta"><span data-review-count>{{ reviewCount|default(0) }}</span> review{{ reviewCount|default(0) == 1 ? '' : 's' }}</div>
                    </div>
                </div>
                <div class="apt-review-score-grid" data-review-score-grid>
                    {% for score in 0..10 %}
                        <button type="button" class="apt-review-score-btn {{ currentReviewScore|default(0) == score ? 'active' : '' }}" data-score="{{ score }}">{{ score }}</button>
                    {% endfor %}
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                    <div class="apt-review-meta">Selected: <strong data-review-selected>{{ currentReviewScore|default(0) }}</strong>/10</div>
                    <button type="button" class="glass-btn-save" data-review-submit style="width: auto; min-width: 180px;">Save review</button>
                </div>
                <div class="apt-review-meta mt-2" data-review-status></div>
            </div>

            <!-- Recommendations -->
            {% if app_recommende is defined %}
            <div class="mt-5">
                <h3 class="mb-4">Appartements Similaires</h3>
                <div class="row g-3">
                    {% for item in app_recommende %}
                        {% set apt_rec = item.apartment %}
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="residence-card p-0 overflow-hidden">
                                <div class="position-relative">
                                    {% if apt_rec.imageA %}
                                        <img src="{{ media_url(apt_rec.imageA, 'appartement_images') }}" class="residence-card-img" style="height: 180px;">
                                    {% else %}
                                        <img src="{{ media_url(apt_rec.residence.imageR, 'residence_images') }}" class="residence-card-img" style="height: 180px; filter: brightness(20%) blur(5px);">
                                    {% endif %}
                                    <div class="residence-card-overlay">
                                        <span class="residence-price-tag" style="font-size: 0.7rem;">{{ item.score|round }}% Match</span>
                                    </div>
                                </div>
                                <div class="p-3">
                                    <h6 class="mb-2">{{ apt_rec.typeA }} • {{ apt_rec.prixLocation }} TND</h6>
                                    <button class="main-home-btn main-home-btn-primary w-100 py-2" style="font-size: 0.8rem;" onclick="loadApartmentDetails({{ apt_rec.idApp }})">
                                        Consulter
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Contact Section -->
            <div class="mt-5">
                <div class="glass-form-group p-4">
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-7">
                            <h3 class="mb-3">Contacter le propriétaire</h3>
                            <p class="text-white-50 mb-4">Envoyez une demande directe à <strong>{{ appartement.user.firstname }} {{ appartement.user.lastname }}</strong>.</p>
                            <form id="formulaire-email-appartment" action="{{ path('envoyer_email_residence')}}" method="post" data-ajax="true">
                                <input type="hidden" name="id_app" value="{{ appartement.idApp }}">
                                <div class="mb-3">
                                    <input class="glass-input w-100" type="text" name="nom_u" placeholder="Votre nom complet" required>
                                </div>
                                <div class="mb-3">
                                    <input class="glass-input w-100" type="email" name="email_u" placeholder="Votre email" required>
                                </div>
                                <div class="mb-3">
                                    <textarea class="glass-input w-100" name="message_u" placeholder="Votre message (optionnel)" rows="3"></textarea>
                                </div>
                                <button type="submit" class="glass-btn-save w-100">Envoyer le message</button>
                            </form>
                        </div>
                        <div class="col-lg-5 text-center">
                            {% set ownerPhone = appartement.user ? appartement.user.phone|default('') : '' %}
                            {% set whatsappPhone = ownerPhone|replace({'+': '', ' ': '', '-': '', '(': '', ')': '', '.': ''}) %}
                            {% set whatsappText = 'Bonjour, je suis interesse par l appartement ' ~ appartement.typeA ~ ' a ' ~ appartement.residence.nomR %}
                            {% set whatsappUrl = whatsappPhone ? 'https://wa.me/' ~ whatsappPhone ~ '?text=' ~ whatsappText|url_encode : absolute_url(path('send_sms', {'id': appartement.idApp})) %}
                            <div class="p-3 bg-white rounded-4 d-inline-block">
                                <a href="{{ whatsappUrl }}" target="_blank" rel="noopener">
                                    <img src="{{ qr_code_url(whatsappUrl) }}" alt="WhatsApp QR Code" style="width: 180px; height: 180px;">
                                </a>
                            </div>
                            <p class="mt-3 text-white-50" style="font-size: 0.9rem;">Scannez pour ouvrir WhatsApp</p>
                            {% if whatsappPhone %}
                                <a href="{{ whatsappUrl }}" target="_blank" rel="noopener" class="glass-btn-save w-100 mt-2 d-inline-flex align-items-center justify-content-center" style="background: rgba(34, 197, 94, 0.18); border-color: rgba(34, 197, 94, 0.5); text-decoration: none;">
                                    <i class='bx bxl-whatsapp me-2'></i>Ouvrir WhatsApp
                                </a>
                            {% endif %}
                            <button onclick="triggerSms({{ appartement.idApp }}, this)" class="glass-btn-save w-100 mt-2" style="background: rgba(59, 130, 246, 0.2); border-color: rgba(59, 130, 246, 0.5);">
                                <i class='bx bx-send me-2'></i>Envoyer demande via SMS
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof AOS !== 'undefined') {
            AOS.init({
                duration: 1000,
                once: true,
                offset: 100
            });
        }

        const switcher = document.getElementById('residenceSwitcher');
        const apartmentsContent = document.getElementById('apartmentsContent');
        const detailsContent = document.getElementById('detailsContent');
        const apartmentsLoading = document.getElementById('apartmentsLoading');
        const detailsLoading = document.getElementById('detailsLoading');
        const pagination = document.getElementById('pagination-container');

        // Helper to switch faces
        window.switchToFace = function(face) {
            if (!switcher) return;
            switcher.classList.remove('active-main', 'active-extra', 'active-details');
            
            if (face === 'main') {
                switcher.classList.add('active-main');
                if (pagination) pagination.style.display = 'flex';
            } else if (face === 'apartments') {
                switcher.classList.add('active-extra');
                if (pagination) pagination.style.display = 'none';
            } else if (face === 'details') {
                switcher.classList.add('active-details');
                if (pagination) pagination.style.display = 'none';
            }
            
            // Scroll to top of showcase
            const showcase = document.getElementById('showcase');
            if (showcase) {
                const headerOffset = 100;
                const elementPosition = showcase.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                window.scrollTo({
                    top: offsetPosition,
                    behavior: "smooth"
                });
            }
        };

        // Load Apartments for a Residence
        window.loadApartments = function(residenceId) {
            if (apartmentsLoading) apartmentsLoading.style.display = 'block';
            if (apartmentsContent) apartmentsContent.innerHTML = '';
            switchToFace('apartments');

            fetch(`/residence/${residenceId}?ajax=1`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.text())
            .then(html => {
                if (apartmentsLoading) apartmentsLoading.style.display = 'none';
                if (apartmentsContent) {
                    apartmentsContent.innerHTML = html;
                    // Manual visibility force just in case
                    apartmentsContent.querySelectorAll('[data-aos]').forEach(el => {
                        el.style.opacity = '1';
                        el.style.transform = 'none';
                    });
                    if (typeof AOS !== 'undefined') AOS.refresh();
                }
            })
            .catch(err => {
                console.error('Error loading apartments:', err);
                if (apartmentsContent) apartmentsContent.innerHTML = '<div class="alert alert-danger">Error loading apartments.</div>';
            });
        };

        // Load Apartment Details
        window.loadApartmentDetails = function(apartmentId) {
            if (detailsLoading) detailsLoading.style.display = 'block';
            if (detailsContent) detailsContent.innerHTML = '';
            switchToFace('details');

            fetch(`/residence/appartementform/${apartmentId}?ajax=1`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.text())
            .then(html => {
                if (detailsLoading) detailsLoading.style.display = 'none';
                if (detailsContent) {
                    detailsContent.innerHTML = html;
                    initApartmentReviewWidgets(detailsContent);
                    // Manual visibility force
                    detailsContent.querySelectorAll('[data-aos]').forEach(el => {
                        el.style.opacity = '1';
                        el.style.transform = 'none';
                    });
                    if (typeof AOS !== 'undefined') AOS.refresh();
                }
            })
            .catch(err => {
                console.error('Error loading details:', err);
                if (detailsContent) detailsContent.innerHTML = '<div class="alert alert-danger">Error loading details.</div>';
            });
        };

        function setReviewScore(widget, score) {
            widget.dataset.currentScore = String(score);
            widget.querySelectorAll('.apt-review-score-btn').forEach(btn => {
                btn.classList.toggle('active', Number(btn.dataset.score) === score);
            });
            const selected = widget.querySelector('[data-review-selected]');
            if (selected) selected.textContent = String(score);
            const status = widget.querySelector('[data-review-status]');
            if (status) status.textContent = '';
        }

        function initApartmentReviewWidgets(root = document) {
            root.querySelectorAll('[data-apartment-review]').forEach(widget => {
                setReviewScore(widget, Number(widget.dataset.currentScore || 0));
            });
        }

        document.addEventListener('click', function(e) {
            const scoreBtn = e.target.closest('.apt-review-score-btn');
            if (scoreBtn) {
                const widget = scoreBtn.closest('[data-apartment-review]');
                if (widget) setReviewScore(widget, Number(scoreBtn.dataset.score || 0));
                return;
            }

            const submitBtn = e.target.closest('[data-review-submit]');
            if (!submitBtn) return;

            const widget = submitBtn.closest('[data-apartment-review]');
            if (!widget) return;

            const status = widget.querySelector('[data-review-status]');
            const originalText = submitBtn.innerHTML;
            const formData = new FormData();
            formData.append('score', widget.dataset.currentScore || '0');
            formData.append('_token', widget.dataset.token || '');

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="spinner-border spinner-border-sm me-2"></i>Saving...';
            if (status) status.textContent = '';

            fetch(widget.dataset.saveUrl, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;

                if (data.status === 'success') {
                    const average = widget.querySelector('[data-review-average]');
                    const count = widget.querySelector('[data-review-count]');
                    if (average) average.textContent = data.average;
                    if (count) count.textContent = data.count;
                    if (status) status.textContent = data.message;
                    if (window.pushNotif) window.pushNotif('Saved', data.message, 'SUCCESS');
                } else {
                    if (status) status.textContent = data.message || 'Could not save review.';
                    if (window.pushNotif) window.pushNotif('Erreur', data.message || 'Could not save review.', 'ERROR');
                }
            })
            .catch(err => {
                console.error('Error saving review:', err);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
                if (status) status.textContent = 'Could not save review.';
            });
        });

        initApartmentReviewWidgets(document);

        // Back navigation
        window.goBack = function(target) {
            switchToFace(target);
        };

        // SMS Trigger handler
        window.triggerSms = function(apartmentId, btn) {
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="spinner-border spinner-border-sm me-2"></i>Envoi...';

            fetch(`/residence/${apartmentId}/sendSms`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = originalText;

                if (data.status === 'success') {
                    window.pushNotif('Génial!', data.message, 'SUCCESS');
                } else {
                    window.pushNotif('Erreur', data.message, 'ERROR');
                }
            })
            .catch(err => {
                console.error('Error triggering SMS:', err);
                btn.disabled = false;
                btn.innerHTML = originalText;
                showToast('Erreur lors de l\'envois du SMS.', 'error');
            });
        };

        // Contact Form AJAX
        document.addEventListener('submit', function(e) {
            if (e.target && e.target.id === 'formulaire-email-appartment') {
                e.preventDefault();
                const form = e.target;
                const formData = new FormData(form);
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="spinner-border spinner-border-sm me-2"></i>Envoi en cours...';

                fetch(form.action + '?ajax=1', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => response.json())
                .then(data => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;

                    if (data.status === 'success') {
                        window.pushNotif('Génial!', data.message, 'SUCCESS');
                        form.reset();
                    } else {
                        window.pushNotif('Erreur', data.message, 'ERROR');
                    }
                })
                .catch(err => {
                    console.error('Error sending email:', err);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    window.pushNotif('Erreur', 'Erreur lors de l\'envois du message.', 'ERROR');
                });
            }
        });

    });
</script>
{% endblock %}
