
{% block a %}
        {% for appartement in appartements %}
        <div class="col-sm-4 p-1">
        <div class="main-home-testimonial-card ">
            <div class="main-home-testimonial-content">
                <h4 class="main-home-event-title main-home-content-title">Appartement {{ appartement.typeA }}</h4>
                <img src="{{ appartement.imageA }}">
            </div>
            <div class="main-home-testimonial-author">
                <div class="row ">
                <span>Appartement Bloc {{ appartement.bloc }}, étage {{ appartement.etage }} Numéro {{ appartement.numero }}</span>
                <br><hr>
                    <span class="col-sm-auto">Parking {{ appartement.parking ? 'Disponible' : 'Non Disponible' }}</span>
                    <span class="main-home-participation-rate col-sm">{{ appartement.disponible ? 'Disponible' : 'Non Disponible' }}</span>
                </div>
            </div>
        </div>
        </div>
        {% else %}
<p> Appartements non disponible </p>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
