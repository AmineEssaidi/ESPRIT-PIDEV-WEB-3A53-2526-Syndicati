<style>
.glass-stats-panel {
    background: rgba(var(--main-home-accent-rgb), 0.08);
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    border: 1px solid rgba(var(--main-home-accent-rgb), 0.15);
    border-radius: clamp(32px, 5vw, 64px);
    padding: clamp(40px, 6vw, 80px);
    margin: 40px auto;
    position: relative;
    z-index: 10;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4);
    max-width: 1400px;
    width: 95%;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 30px;
}
.main-home-stat-item {
    text-align: center;
    flex: 1;
    min-width: 150px;
    padding: 15px;
}
.main-home-stat-number {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(to bottom, #fff 30%, rgba(var(--main-home-accent-rgb), 0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -3px;
    line-height: 1;
    margin-bottom: 8px;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));
}
.main-home-stat-label {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.85rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const counters = document.querySelectorAll('.counter');
    const speed = 200;

    const animateCounters = () => {
        counters.forEach(counter => {
            const target = +counter.getAttribute('data-target');
            const count = +counter.innerText;
            const inc = target / speed;

            if (count < target) {
                counter.innerText = Math.ceil(count + inc);
                setTimeout(animateCounters, 1);
            } else {
                counter.innerText = target;
            }
        });
    };

    // Intersection Observer to start counter when visible
    const observer = new IntersectionObserver((entries) => {
        if(entries[0].isIntersecting) animateCounters();
    }, { threshold: 0.5 });
    
    if(counters.length) observer.observe(counters[0].parentElement);
});
</script>


