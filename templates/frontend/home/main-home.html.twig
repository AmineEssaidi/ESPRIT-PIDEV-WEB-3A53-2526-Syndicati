    border-radius: clamp(32px, 5vw, 64px);
    padding: clamp(40px, 6vw, 80px);
    margin: 40px auto;
    position: relative;
    z-index: 10;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4);
    max-width: 1400px;
    width: 95%;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 30px;
}
.main-home-stat-item {
    text-align: center;
    flex: 1;
    min-width: 150px;
    padding: 15px;
}
.main-home-stat-number {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(to bottom, #fff 30%, rgba(var(--main-home-accent-rgb), 0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -3px;
    line-height: 1;
    margin-bottom: 8px;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));
}
.main-home-stat-label {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 700;
    text-transform: uppercase;
