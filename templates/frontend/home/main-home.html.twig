<!-- JavaScript Dependencies - defer for non-blocking load -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="{{ asset('frontend/js/main-home.js') }}" defer></script>
<script src="{{ asset('js/page-loader.js') }}"></script>
<script>
(function() {

    // Onboarding live theme + language preview (overlay) + AJAX navigation
    document.addEventListener('DOMContentLoaded', function() {
        const themeLight = document.getElementById('theme_light');
        const themeDark = document.getElementById('theme_dark');
        const selectedTheme = document.getElementById('selected_theme');
        const selectedLocale = document.getElementById('selected_locale');
        const html = document.documentElement;

        // Live theme preview
        if (themeLight && themeDark && selectedTheme) {
            function applyTheme() {
                const isLight = themeLight.checked;
                html.setAttribute('data-theme', isLight ? 'light' : 'dark');
                selectedTheme.value = isLight ? 'light' : 'dark';
            }
            themeLight.addEventListener('change', applyTheme);
            themeDark.addEventListener('change', applyTheme);
        }

        // Live language preview
        const langRadios = document.querySelectorAll('input[name="language_preference"]');
        if (langRadios.length && selectedLocale) {
            const localeMap = { FR: 'fr', EN: 'en', AR: 'ar', FR_AR: 'fr' };
            langRadios.forEach(r => {
                r.addEventListener('change', function() {
                    const lang = localeMap[this.value] || 'fr';
                    selectedLocale.value = (this.value === 'FR_AR' ? 'fr_ar' : lang);
                    if (window.setLanguage) window.setLanguage(lang);
                });
            });
        }

        // Front-end onboarding wizard (no per-step server calls)
        const form = document.getElementById('onboardingOverlayForm');
        const steps = Array.from(document.querySelectorAll('.onboarding-step'));
        const currentStepInput = document.getElementById('onboardingCurrentStep');
        if (form && steps.length && currentStepInput) {
            let current = 1;
            const total = steps.length;

            const nextBtn   = form.querySelector('[data-onboarding-action="next"]');
            const prevBtn   = form.querySelector('[data-onboarding-action="prev"]');
            const finishBtn = form.querySelector('[data-onboarding-action="finish"]');
            const cancelBtn = form.querySelector('[data-onboarding-action="cancel"]');

            const showStep = (n) => {
                current = n;
                currentStepInput.value = String(n);
                steps.forEach(step => {
                    step.style.display = (parseInt(step.dataset.step || '0', 10) === n) ? 'block' : 'none';
                });
                if (prevBtn) prevBtn.style.visibility = n > 1 ? 'visible' : 'hidden';
                if (nextBtn) nextBtn.style.display = n < total ? 'inline-flex' : 'none';
                if (finishBtn) finishBtn.style.display = n === total ? 'inline-flex' : 'none';
            };

            showStep(current);

            const closeOverlay = () => {
                const overlay = document.querySelector('.onboarding-overlay');
                if (!overlay) return;
                overlay.classList.add('onboarding-finish');
                setTimeout(() => {
                    overlay.remove();
                    document.body.classList.remove('onboarding-active');
                }, 900);
            };

            const saveOnboarding = () => {
                const formData = new FormData(form);
                fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                    body: formData
                })
                .then(resp => resp.json())
                .then(data => {
                    if (data && data.success) {
                        closeOverlay();
                    } else {
                        console.error('Onboarding save failed', data);
                    }
                })
                .catch(err => {
                    console.error('Onboarding save error', err);
                });
            };

            if (nextBtn) {
                nextBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (current < total) showStep(current + 1);
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (current > 1) showStep(current - 1);
                });
            }

            if (finishBtn) {
                finishBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    // Save everything then close when done
                    saveOnboarding();
                });
            }

            if (cancelBtn) {
                cancelBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    // Close immediately for UX, fire-and-forget save in background
                    closeOverlay();
                    try {
                        saveOnboarding();
                    } catch (err) {
                        console.error('Onboarding cancel/save error', err);
                    }
                });
            }
        }
    });
})();
</script>

<script src="{{ asset('frontend/js/syndicati-agent.js') }}" defer></script>
