<script>
// Main Home specific JavaScript
document.addEventListener('DOMContentLoaded', function() {
    // Initialize theme toggle (override external JS version)
    initMainHomeThemeToggle();
    
    // Initialize heart animation
    setupHeartAnimation();
    
    // Initialize interactive elements
    initInteractiveElements();
    
    // Initialize animations
    initAnimations();
    
    // Initialize tab dropdowns
    initTabDropdowns();
});

function initMainHomeThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    
    // Load saved theme
    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);
    
    if (themeToggle) {
        // Remove any existing listeners by cloning
        const newToggle = themeToggle.cloneNode(true);
        themeToggle.parentNode.replaceChild(newToggle, themeToggle);
        
        newToggle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            
            console.log('Theme changed to:', newTheme);
        });
        
        console.log('Theme toggle initialized successfully');
    } else {
        console.error('Theme toggle element not found');
    }
}

function setupHeartAnimation() {
    // Heart animation is handled by CSS
    console.log('Heart animation initialized');
}

function initInteractiveElements() {
    // Search functionality is handled by the header search
    console.log('Interactive elements initialized');
}

function initAnimations() {
    // Add entrance animations to welcome cards
    const welcomeCards = document.querySelectorAll('.main-home-welcome-card');
    welcomeCards.forEach((card, index) => {
        card.style.animationDelay = `${index * 0.1}s`;
        card.classList.add('animate-in');
    });
}

// Tab dropdown functionality
function initTabDropdowns() {
    const navTabs = document.querySelectorAll('.main-home-nav-tab');
    let hoverTimeout;
    let isHovering = false;
    
    function closeAllDropdowns() {
        navTabs.forEach(tab => {
            const dropdown = tab.querySelector('.main-home-tab-dropdown');
            if (dropdown) {
                dropdown.style.display = 'none';
            }
        });
    }
    
    navTabs.forEach(tab => {
        const dropdown = tab.querySelector('.main-home-tab-dropdown');
        const tabText = tab.querySelector('.main-home-tab-text');
        const homeLink = tabText.querySelector('a');
        
        // Handle Home tab (has link, no dropdown)
        if (homeLink) {
            // Home tab should behave like other tabs but navigate on click
            tabText.addEventListener('click', function(e) {
                // Let the link handle navigation naturally
                // No preventDefault needed
            });
            
            // No hover dropdown functionality for Home tab
            return;
        }
        
        // Only add dropdown functionality to tabs that have dropdowns
        if (!dropdown) {
            return;
        }
        
        // Click to toggle dropdown
        tabText.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const isOpen = dropdown.style.display === 'block';
            closeAllDropdowns();
            
            if (!isOpen) {
                dropdown.style.display = 'block';
            }
        });
        
        // Hover to show dropdown - more reliable
        tab.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            isHovering = true;
            closeAllDropdowns();
            dropdown.style.display = 'block';
        });
        
        // Hover to hide dropdown with delay
        tab.addEventListener('mouseleave', function() {
            isHovering = false;
            hoverTimeout = setTimeout(() => {
                if (!isHovering) {
                    dropdown.style.display = 'none';
                }
            }, 300); // Increased delay for better UX
        });
        
        // Keep dropdown open when hovering over it
        dropdown.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            isHovering = true;
        });
        
        dropdown.addEventListener('mouseleave', function() {
            isHovering = false;
            hoverTimeout = setTimeout(() => {
                if (!isHovering) {
                    dropdown.style.display = 'none';
                }
            }, 300);
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!tab.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    });
}

// Video Player Control
const videoPlayer = document.getElementById('mainVideoPlayer');
const videoControlBtn = document.getElementById('videoControlBtn');
const pauseIcon = document.querySelector('.main-home-video-pause-icon');
const playIcon = document.querySelector('.main-home-video-play-icon');

if (videoPlayer && videoControlBtn) {
    videoControlBtn.addEventListener('click', function() {
        if (videoPlayer.paused) {
            videoPlayer.play();
            pauseIcon.style.display = 'inline';
            playIcon.style.display = 'none';
        } else {
            videoPlayer.pause();
            pauseIcon.style.display = 'none';
            playIcon.style.display = 'inline';
        }
    });
    
    // Sync button state with video state
    videoPlayer.addEventListener('play', function() {
        pauseIcon.style.display = 'inline';
        playIcon.style.display = 'none';
    });
    
    videoPlayer.addEventListener('pause', function() {
        pauseIcon.style.display = 'none';
        playIcon.style.display = 'inline';
    });
}

// Scroll Down Pill functionality
document.addEventListener('DOMContentLoaded', function() {
    var pill = document.getElementById('scrollDownPill');
    function checkPill() {
        var hero = document.querySelector('.main-home-hero');
        if (!pill || !hero) return;
        var rect = hero.getBoundingClientRect();
        if (rect.bottom < 120) {
            pill.classList.add('hide');
        } else {
            pill.classList.remove('hide');
        }
    }
    window.addEventListener('scroll', checkPill);
    checkPill();
});
</script>
<style>
.scroll-down-pill-wrapper {
    position: fixed;
    left: 50%;
    bottom: 36px;
    transform: translateX(-50%);
    z-index: 9999;
    pointer-events: none;
    width: auto;
    display: flex;
    justify-content: center;
    align-items: center;
}
.scroll-down-pill {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--scroll-pill-bg, #fff);
    color: var(--scroll-pill-text, #222);
    border-radius: 32px;
    box-shadow: 0 2px 8px 0 rgba(90,90,214,0.10);
    padding: 14px 22px;
    font-size: 1.5rem;
    font-family: var(--font-primary), 'Inter', 'Segoe UI', Arial, sans-serif;
    font-weight: 700;
    opacity: 0.98;
    pointer-events: auto;
    cursor: pointer;
    border: none;
    outline: none;
    transition: background 0.2s, color 0.2s, box-shadow 0.2s, opacity 0.3s, transform 0.2s cubic-bezier(.4,0,.2,1);
    animation: scroll-pill-fadein 1.2s cubic-bezier(.4,0,.2,1) 0.5s both;
    letter-spacing: 0.04em;
    overflow: visible;
}
.scroll-down-pill::before,
.scroll-down-pill::after {
    display: none !important;
}
.scroll-down-pill:hover {
    box-shadow: 0 4px 16px 0 rgba(90,90,214,0.14);
    opacity: 1;
}
@keyframes scroll-pill-fadein {
    from { opacity: 0; transform: translateY(32px); }
    to { opacity: 0.98; transform: translateY(0); }
}
:root {
    --scroll-pill-bg: #fff;
    --scroll-pill-text: #222;
}
[data-theme="dark"] {
    --scroll-pill-bg: #222;
    --scroll-pill-text: #fff;
}
</style>
<style>
.scroll-down-pill.morph {
    transform: scale(1.08) rotate(-3deg);
    box-shadow: 0 8px 24px 0 rgba(90,90,214,0.18);
}
</style>
</body>
