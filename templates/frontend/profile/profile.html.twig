                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </dd>
                                    <dt class="col-sm-3">Timezone</dt>
                                    <dd class="col-sm-9">
                                        {% if profile.timezone is not null %}
                                            {{ profile.timezone }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </dd>
                                    <dt class="col-sm-3">Phone</dt>
                                    <dd class="col-sm-9">
                                        {% if user.phone %}
                                            {{ user.phone }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
