        console.error('submitComment function not found in forum.js');
    }
};

window.handleForumImagePreview = function(input, publicationId) {
    const preview = document.getElementById(`forum-image-preview-${publicationId}`);
    const file = input.files[0];
    if (file && preview) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML = `
                <div class="position-relative d-inline-block">
                    <img src="${e.target.result}" class="rounded-3 border border-white border-opacity-10" style="height: 60px; width: 60px; object-fit: cover;">
                    <button type="button" class="btn btn-danger btn-sm p-0 d-flex align-items-center justify-content-center position-absolute" 
                            style="top: -8px; right: -8px; width: 22px; height: 22px; border-radius: 50%; z-index: 999; border: 2px solid #000;"
                            onclick="window.removeForumImage(${publicationId})" title="Remove Image">
                        <i class='bx bx-x' style='font-size: 16px;'></i>
                    </button>
                </div>
            `;
            preview.classList.remove('d-none');
        };
        reader.readAsDataURL(file);
    }
};

window.removeForumImage = function(publicationId) {
    const preview = document.getElementById(`forum-image-preview-${publicationId}`);
    if (preview) {
        preview.innerHTML = '';
        preview.classList.add('d-none');
        const form = preview.closest('form');
        if (form) {
            const fileInput = form.querySelector('input[type="file"]');
            if (fileInput) fileInput.value = '';
        }
    }
};

document.addEventListener('DOMContentLoaded', function() {
    const currentUserId = {{ user.idUser|default('0') }};
    const isAdmin = {{ isAdmin ? 'true' : 'false' }};
    let currentAdminFilter = isAdmin ? 'all' : 'my';
    let currentResidenceFilter = isAdmin ? 'all' : 'my';


    // Pagination & Filtering Variables
    const itemsPerPage = 3;
    const allReclamationItems = Array.from(document.querySelectorAll('.reclamation-item'));
    const paginationContainer = document.getElementById('reclamation-pagination');


    window.initializeReclamationPagination = function() {
        try {
            // console.log("Initializing Reclamation Pagination. Filter:", currentAdminFilter);
            
            // 1. Filter items
            const filteredItems = allReclamationItems.filter(item => {
                if (currentAdminFilter === 'all') return true;
                const itemUserId = String(item.dataset.userId);
                const currentId = String(currentUserId);
                return itemUserId === currentId;
            });


            // 2. Hide all items initially
            allReclamationItems.forEach(item => {
                item.style.display = 'none';
                item.classList.remove('active');
            });

            if (filteredItems.length === 0) {
                if (paginationContainer) paginationContainer.innerHTML = '';
                return;
            }

            // 3. Simple Display if no pagination needed
            if (!paginationContainer || filteredItems.length <= itemsPerPage) {
                if (paginationContainer) paginationContainer.innerHTML = '';
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            // 4. Advanced Pagination
            const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
            paginationContainer.innerHTML = '';
            
            function showPage(page) {
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;
                
                filteredItems.forEach((item, idx) => {
                    if (idx >= start && idx < end) {
                        item.style.display = 'block';
                        setTimeout(() => item.classList.add('active'), 10);
                    } else {
                        item.style.display = 'none';
                        item.classList.remove('active');
                    }
                });

                paginationContainer.querySelectorAll('.pagination-pill').forEach(pill => {
                    pill.classList.toggle('active', parseInt(pill.dataset.page) === page);
                });
            }

            for (let i = 1; i <= totalPages; i++) {
                const pill = document.createElement('div');
                pill.className = 'pagination-pill';
                pill.textContent = i;
                pill.dataset.page = i;
                if (i === 1) pill.classList.add('active');
                
                pill.addEventListener('click', () => {
                    showPage(i);
                    document.getElementById('tab-reclamation').scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                
                paginationContainer.appendChild(pill);
            }

            showPage(1);
        } catch (e) { console.error("Reclamation Pagination Error:", e); }
    };

    // Initial load
    if (typeof window.initializeReclamationPagination === 'function') {
        window.initializeReclamationPagination();
    }

    // --- Forum Glass Switcher & Sub Tabs ---
    const profileForumSwitcher = document.getElementById('profile-forum-switcher');
    
    document.querySelectorAll('.profile-forum-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.profile-forum-tab').forEach(t => {
                t.classList.remove('active', 'text-white');
                t.classList.add('text-white-50');
                t.style.background = 'transparent';
            });
            this.classList.add('active', 'text-white');
            this.classList.remove('text-white-50');
            this.style.background = 'rgba(255,255,255,0.1)';
            
            const page = this.dataset.page;
            
            // Toggle filter visibility
            const catFilters = document.getElementById('profile-pub-category-filters');
            if (catFilters) {
                catFilters.style.opacity = page === '1' ? '1' : '0';
                catFilters.style.pointerEvents = page === '1' ? 'auto' : 'none';
            }

            document.querySelectorAll('.profile-forum-content').forEach(content => {
                if(content.dataset.page === page) {
                    content.style.display = 'block';
                    content.style.animation = 'fadeInUp 0.3s ease forwards';
                } else {
                    content.style.display = 'none';
                }
            });
        });
    });

    window.backToProfileForumList = function() {
        if (!profileForumSwitcher) return;
        const face1 = profileForumSwitcher.querySelector('[data-face="1"]');
        const face2 = profileForumSwitcher.querySelector('[data-face="2"]');
        if (face2) {
            face2.style.position = 'absolute';
            face2.style.transform = 'translateX(100%)';
            setTimeout(() => { face2.classList.remove('active'); }, 400);
        }
        if (face1) {
            face1.classList.add('active');
            face1.style.position = 'relative';
            setTimeout(() => { face1.style.transform = 'translateX(0)'; }, 10);
        }
    };

    // --- Forum React Sync ---
    window.loadPublicationReactions = function() {
        if(typeof window.loadReactionStatus === 'function' && window.currentPostId) {
            window.loadReactionStatus(window.currentPostId);
        }
    };

    window.viewProfileForumItem = function(type, id) {
