{% set currentUser = currentUser|default(app.session.get('user')) %}
<body style="background: transparent !important;"
      data-user-info="{{ currentUser ? 'true' : 'false' }}"
      data-user-role="{{ currentUser ? currentUser.role : 'Guest' }}"
      data-is-admin="{{ currentUser and currentUser.role in ['OWNER', 'ADMIN', 'SUPERADMIN'] ? 'true' : 'false' }}">
    {% include 'frontend/shared/_global_video_background.html.twig' %}
<div class="page-loader" id="pageLoader">
    <div class="loader-content">
        <div class="loader-dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
    </div>
</div>
<script>
(function() {
    const loader = document.getElementById('pageLoader');
    if (!loader) return;

    let dismissed = false;
    const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        setTimeout(() => {
            loader.style.transition = 'opacity 0.4s ease';
            loader.style.opacity = '0';
            setTimeout(() => loader.style.display = 'none', 400);
        }, 100);
    };

    // Listen for the custom "video-bg-ready" event
    document.addEventListener('video-bg-ready', dismiss, { once: true });

    // Immediate check: if video already signaled before we parsed this script
    if (window.videoBgReady) {
        dismiss();
    }

    // Ultimate safety: dismiss after 4s (large profile page)
    setTimeout(dismiss, 4000);
})();
</script>

