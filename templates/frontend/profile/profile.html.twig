                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }

            const statusBadge = document.getElementById('event-modal-status');
            const statusColors = { 'planifie': '#4fc3f7', 'en_cours': '#00e676', 'termine': '#9e9e9e', 'annule': '#ff3b30' };
            statusBadge.style.background = (statusColors[data.status] || '#4fc3f7') + '15';
            statusBadge.style.color = statusColors[data.status] || '#4fc3f7';
            statusBadge.style.borderColor = (statusColors[data.status] || '#4fc3f7') + '30';
            statusBadge.textContent = data.status.replace('_', ' ').charAt(0).toUpperCase() + data.status.replace('_', ' ').slice(1);

            // Admin Logic
            const moderatorRoles = ['OWNER', 'ADMIN', 'SUPERADMIN', 'SYNDIC'];
            const userRole = '{{ user.roleUser|default('') }}';
            const isModerator = moderatorRoles.includes(userRole);
            const isOwner = data.userId == currentUserId;

            if (isModerator || isOwner) {
                document.getElementById('event-modal-admin-actions').classList.remove('d-none');
            } else {
                document.getElementById('event-modal-admin-actions').classList.add('d-none');
            }

            new bootstrap.Modal(document.getElementById('eventViewModal')).show();
        });
    });

    document.getElementById('btn-edit-event').addEventListener('click', function() {
        if (!currentActiveEventData) return;
        const data = currentActiveEventData;

        document.getElementById('edit-event-id').value = data.eventId;
        document.getElementById('edit-event-title').value = data.title;
        document.getElementById('edit-event-description').value = data.description;
        document.getElementById('edit-event-date').value = data.date;
        document.getElementById('edit-event-location').value = data.location;
        document.getElementById('edit-event-places').value = data.places;
        document.getElementById('edit-event-remaining').value = data.remaining;
        document.getElementById('edit-event-type').value = data.type;
        document.getElementById('edit-event-status').value = data.status;

        bootstrap.Modal.getInstance(document.getElementById('eventViewModal')).hide();
        setTimeout(() => {
            new bootstrap.Modal(document.getElementById('eventEditModal')).show();
        }, 400);
    });

    document.getElementById('event-edit-form').addEventListener('submit', function(e) {
        e.preventDefault();
        const form = this;
        const btn = document.getElementById('save-event-btn');
        const original = btn.innerHTML;
        const eventId = document.getElementById('edit-event-id').value;

        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Saving...';

        const formData = new FormData(form);
        fetch(`/api/evenement/update/${eventId}`, {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Update specific event item in list
                const item = document.querySelector(`.event-item[data-event-id="${eventId}"]`);
                if (item) {
                    item.dataset.title = formData.get('titre_event');
                    item.dataset.description = formData.get('description_event');
                    item.dataset.location = formData.get('lieu_event');
                    item.dataset.date = formData.get('date_event');
                    item.dataset.status = formData.get('statut_event');
                    item.dataset.type = formData.get('type_event');
                    item.dataset.places = formData.get('nb_places');
                    item.dataset.remaining = formData.get('nb_restants');
                    
                    if (data.data.image) {
                        item.dataset.image = data.data.image;
                        const img = item.querySelector('.event-list-image-wrap img');
                        if (img) img.src = data.data.image;
                        else {
                            const wrap = item.querySelector('.event-list-image-wrap');
                            wrap.innerHTML = `<img src="${data.data.image}" alt="${data.data.title}" style="width: 100%; height: 100%; object-fit: cover;">`;
                            wrap.classList.remove('d-flex', 'align-items-center', 'justify-content-center');
                            wrap.style.borderStyle = 'solid';
                        }
                    }

                    item.querySelector('h5').textContent = data.data.title;
                    item.querySelector('.reclamation-status-text i.bx-calendar').nextSibling.textContent = ' ' + data.data.date;
                    item.querySelector('.reclamation-status-text i.bx-map').nextSibling.textContent = ' ' + formData.get('lieu_event');
                    item.querySelector('.reclamation-desc-text').textContent = data.data.description.substring(0, 100) + (data.data.description.length > 100 ? '...' : '');
                    
                    const listBadge = item.querySelector('.status-badge');
                    const statusColors = { 'planifie': '#4fc3f7', 'en_cours': '#00e676', 'termine': '#9e9e9e', 'annule': '#ff3b30' };
                    listBadge.style.background = (statusColors[data.data.status] || '#4fc3f7') + '15';
                    listBadge.style.color = statusColors[data.data.status] || '#4fc3f7';
                    listBadge.style.borderColor = (statusColors[data.data.status] || '#4fc3f7') + '30';
                    listBadge.textContent = data.data.status.replace('_', ' ').charAt(0).toUpperCase() + data.data.status.replace('_', ' ').slice(1);
                    
                    item.querySelector('.bx-purchase-tag-alt').nextSibling.textContent = ' ' + formData.get('type_event').charAt(0).toUpperCase() + formData.get('type_event').slice(1);
                    item.querySelector('.bx-user').nextSibling.textContent = ` ${item.dataset.remaining}/${formData.get('nb_places')} enrolled`;
                }

                bootstrap.Modal.getInstance(document.getElementById('eventEditModal')).hide();
                // Optionally re-open view modal with updated data
                setTimeout(() => {
                    const item = document.querySelector(`.event-item[data-event-id="${eventId}"]`);
                    if (item) item.click();
                }, 400);
            } else { alert(data.message || 'Error updating event'); }
            btn.disabled = false; btn.innerHTML = original;
        })
        .catch(err => { console.error(err); btn.disabled = false; btn.innerHTML = original; });
    });

    window.deleteForumComment = async function(commentId, token, pubId) {
        if (!confirm('Are you sure you want to delete this comment?')) return;
        const formData = new FormData();
        formData.append('_token', token);
        try {
            const res = await fetch(`/forum/comment/delete/${commentId}`, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await res.json();
            if (data.success) {
                window.loadComments(pubId, true);
            } else {
                if (window.showCoolPopup) window.showCoolPopup('Error', data.message || 'Deletion failed', 'error');
                else alert(data.message || 'Deletion failed');
            }
        } catch (err) {
            console.error('Comment Delete Error:', err);
        }
    };

    window.handleCommentEditToggle = function(pubId, commentId) {
        const text = document.getElementById(`comment-text-${commentId}`);
        const editZone = document.getElementById(`comment-edit-zone-${commentId}`);
        if (text && editZone) {
            text.classList.toggle('d-none');
            editZone.classList.toggle('d-none');
            if (!editZone.classList.contains('d-none')) {
                document.getElementById(`comment-textarea-${commentId}`).focus();
            }
        }
    };

    window.previewEditImage = function(input, commentId) {
        const container = document.getElementById(`edit-image-preview-container-${commentId}`);
        const img = document.getElementById(`edit-image-preview-${commentId}`);
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                img.src = e.target.result;
                container.classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    };

    window.clearEditImage = function(commentId) {
        const input = document.getElementById(`edit-image-${commentId}`);
        const container = document.getElementById(`edit-image-preview-container-${commentId}`);
        const img = document.getElementById(`edit-image-preview-${commentId}`);
        input.value = '';
        img.src = '';
        container.classList.add('d-none');
    };

    window.handleCommentSave = async function(pubId, commentId) {
        const textarea = document.getElementById(`comment-textarea-${commentId}`);
        const fileInput = document.getElementById(`edit-image-${commentId}`);
        const token = document.getElementById(`edit-token-${commentId}`).value;
        const newText = textarea.value.trim();

        if (!newText) return;

        const formData = new FormData();
        formData.append('description', newText);
        formData.append('_token', token);
        if (fileInput.files.length > 0) {
            formData.append('image_commentaire', fileInput.files[0]); // Fixed typo
        }

        try {
            const res = await fetch(`/forum/comment/edit/${commentId}`, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await res.json();
            if (data.success) {
                window.loadComments(pubId, true);
            } else {
                alert(data.message || 'Update failed');
            }
        } catch (err) {
            console.error('Comment Update Error:', err);
        }
    };

    // --- Profile Social Actions Logic ---
    document.addEventListener('click', async function(e) {
        const btn = e.target.closest('.social-btn-profile');
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        const action = btn.dataset.action;
        const type = btn.dataset.type || null;
        const pubId = btn.dataset.pubId;

        if (!pubId) return;

        let url = `/forum/action/${action}/${pubId}`;
        if (type) url += `/${type}`;

        console.log(`Profile: Executing Action ${action} for Pub ${pubId}`);

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await response.json();

            if (data.success) {
                // UI Feedback
                if (action === 'react') {
                    const row = btn.closest('.modal-social-actions');
                    const likeBtn = row.querySelector('.like');
                    const dislikeBtn = row.querySelector('.dislike');
                    
                    if (type === 'like') {
                        likeBtn.classList.toggle('active');
                        dislikeBtn.classList.remove('active');
                    } else if (type === 'dislike') {
                        dislikeBtn.classList.toggle('active');
                        likeBtn.classList.remove('active');
                    }
                } else if (action === 'bookmark') {
                    btn.classList.toggle('active');
                    const icon = btn.querySelector('i');
                    if (btn.classList.contains('active')) {
                        icon.className = 'bx bxs-bookmark';
                    } else {
                        icon.className = 'bx bx-bookmark';
                    }
                } else if (action === 'report') {
                    btn.classList.toggle('active');
                }

                // Update Counts in Modal
                if (data.counts) {
                    const c = data.counts;
                    const cLike = document.querySelector(`.count-like-${pubId}`);
                    const cDislike = document.querySelector(`.count-dislike-${pubId}`);
                    const cReport = document.querySelector(`.count-report-${pubId}`);
                    
                    if (cLike) cLike.textContent = c.likes;
                    if (cDislike) cDislike.textContent = c.dislikes;
                    if (cReport) cReport.textContent = c.reports;
                    
                    // Update Counts in List (Visual only)
                    const listItem = document.querySelector(`.publication-item[data-publication-id="${pubId}"]`);
                    if (listItem) {
                        const listLike = listItem.querySelector('.bx-like').nextElementSibling;
                        const listDislike = listItem.querySelector('.bx-dislike').nextElementSibling;
                        if (listLike) listLike.textContent = c.likes;
                        if (listDislike) listDislike.textContent = c.dislikes;
                        
                        // Update icons in list
                        const listLikeIcon = listItem.querySelector('.bx-like');
                        const listDislikeIcon = listItem.querySelector('.bx-dislike');
                        
                        if (action === 'react') {
                            if (type === 'like') {
                                listLikeIcon.classList.toggle('text-primary', btn.classList.contains('active'));
                                listDislikeIcon.classList.remove('text-danger');
                            } else if (type === 'dislike') {
                                listDislikeIcon.classList.toggle('text-danger', btn.classList.contains('active'));
                                listLikeIcon.classList.remove('text-primary');
                            }
                        }
                    }
                }
            }
        } catch (err) {
            console.error('Profile AJAX Error:', err);
        }
    });

    // Admin Filter logic for all tabs
    function handleAdminFilter(btnClass, filterVarSetter, initFunc) {
        document.querySelectorAll('.' + btnClass).forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.' + btnClass).forEach(b => {
                    b.classList.remove('active', 'btn-primary');
                    b.classList.add('btn-outline-light');
                });
                this.classList.remove('btn-outline-light');
                this.classList.add('active', 'btn-primary');
                filterVarSetter(this.dataset.filter);
                initFunc();
            });
        });
    }

    if (isAdmin) {
        handleAdminFilter('admin-reclamation-filter-btn', (val) => { currentAdminFilter = val; }, window.initializeReclamationPagination);
        handleAdminFilter('admin-forum-filter-btn', (val) => { currentForumAdminFilter = val; }, window.initializeMyPostsPagination);
        handleAdminFilter('admin-events-filter-btn', (val) => { currentEventAdminFilter = val; }, window.initializeEventsPagination);

        // Residence Filter Logic
        const residenceItems = document.querySelectorAll('.residence-item');
        document.querySelectorAll('.admin-residence-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if (this.classList.contains('active')) return;

                document.querySelectorAll('.admin-residence-filter-btn').forEach(b => {
                    b.classList.remove('active', 'btn-primary');
                    b.classList.add('btn-outline-light');
                });
                this.classList.remove('btn-outline-light');
                this.classList.add('active', 'btn-primary');

                currentResidenceFilter = this.dataset.filter;
                
                // Apply filter
                residenceItems.forEach(item => {
                    if (currentResidenceFilter === 'all') {
                        item.style.display = 'block';
                        item.nextElementSibling && (item.nextElementSibling.style.display = 'block'); // Show HR
                    } else {
                        const itemUserId = String(item.dataset.userId);
                        const currentId = String(currentUserId);
                        if (itemUserId === currentId) {
                            item.style.display = 'block';
                            item.nextElementSibling && (item.nextElementSibling.style.display = 'block');
                        } else {
                            item.style.display = 'none';
                            item.nextElementSibling && (item.nextElementSibling.style.display = 'none');
                        }
                    }
                });
            });
        });
    }

    window.deleteProfilePublication = async function(event, pubId) {
        event.stopPropagation();
        if (!confirm('Are you sure you want to delete this publication?')) return;
        
        const item = document.querySelector(`.publication-item[data-publication-id="${pubId}"]`);
        const token = item ? item.dataset.token : null;
        
        const formData = new FormData();
        if (token) formData.append('_token', token);
        
        try {
            const response = await fetch(`/forum/delete/${pubId}`, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await response.json();
            if (data.success) {
                if (window.showCoolPopup) window.showCoolPopup('Success', data.message || 'Post deleted', 'success');
                else alert(data.message || 'Post deleted');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                if (window.showCoolPopup) window.showCoolPopup('Error', data.message || 'Deletion failed', 'error');
                else alert(data.message || 'Deletion failed');
            }
        } catch (err) {
            console.error('Delete Error:', err);
            alert('An unexpected error occurred');
        }
    };

    // Statistics Toggle Logic
    window.toggleStats = function(event, pubId) {
        event.stopPropagation();
        const statsDiv = document.getElementById(`stats-${pubId}`);
        if (statsDiv) {
            statsDiv.classList.toggle('active');
            const btn = event.currentTarget;
            if (statsDiv.classList.contains('active')) {
                btn.style.background = 'rgba(255, 255, 255, 0.15)';
                btn.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                btn.innerHTML = "<i class='bx bx-chevron-up'></i> Hide Stats";
            } else {
                btn.style.background = '';
                btn.style.borderColor = '';
                btn.innerHTML = "<i class='bx bx-stats'></i> Details Stats";
            }
        }
    };

    // Safety: Hide page loader if it's still spinning
    setTimeout(() => {
        const pageLoader = document.getElementById('pageLoader');
        if (pageLoader) pageLoader.style.display = 'none';
    }, 100);
});
</script>
</body>
</html>
