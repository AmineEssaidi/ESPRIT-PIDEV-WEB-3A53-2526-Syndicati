<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Two-Factor Authentication Modal Logic ---
        const twofaModal = document.getElementById('twofa-settings-modal');
        const twofaOpenBtn = document.getElementById('twofa-settings-open');
        const twofaCloseBtn = document.getElementById('twofa-settings-modal-close');
        const twofaCancelBtn = document.getElementById('twofa-settings-modal-cancel');
        const twofaToggle = document.getElementById('twofa-toggle');
        const twofaStatusText = document.getElementById('twofa-status-text');
        const twofaEmailSection = document.getElementById('twofa-email-section');
        const twofaTotpSection = document.getElementById('twofa-totp-section');
        const twofaTestEmailBtn = document.getElementById('twofa-test-email');
        const twofaSetupTotpBtn = document.getElementById('twofa-setup-totp-btn');
        const twofaRemoveTotpBtn = document.getElementById('twofa-remove-totp');
        const twofaTotpConfiguredBlock = document.getElementById('twofa-totp-configured-block');
        const twofaTotpSetupBlock = document.getElementById('twofa-totp-setup-block');

        // TOTP QR Modal elements
        const totpQrModal = document.getElementById('totp-qr-modal');
        const totpQrModalClose = document.getElementById('totp-qr-modal-close');
        const totpQrModalCancel = document.getElementById('totp-qr-modal-cancel');
        const totpQrCodeContainer = document.getElementById('totp-qr-code');
        const totpQrCodeWrapper = document.getElementById('totp-qr-code-container');
        const totpSecretDisplay = document.getElementById('totp-manual-entry');
        const totpSecretText = document.getElementById('totp-secret-display');
        const totpVerifyCodeInput = document.getElementById('totp-verify-code-input');
        const totpQrVerifyBtn = document.getElementById('totp-qr-verify-btn');
        let currentTotpSecret = null;

        function syncTwofaModalFromServer() {
            fetch('{{ path("2fa_status") }}', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) return;
                    const enabled = !!data.twoFactorEnabled;
                    const totpConfigured = !!data.totpConfigured;
                    if (twofaToggle) twofaToggle.checked = enabled;
                    if (twofaStatusText) twofaStatusText.textContent = enabled ? 'Enabled' : 'Disabled';
                    if (twofaEmailSection) twofaEmailSection.style.display = enabled ? 'block' : 'none';
                    if (twofaTotpSection) twofaTotpSection.style.display = enabled ? 'block' : 'none';
                    if (twofaTotpConfiguredBlock) twofaTotpConfiguredBlock.style.display = totpConfigured ? 'block' : 'none';
                    if (twofaTotpSetupBlock) twofaTotpSetupBlock.style.display = totpConfigured ? 'none' : 'block';
                })
                .catch(() => {});
        }

        function openTwofaModal() {
            if (twofaModal) {
                twofaModal.style.display = 'flex';
                twofaModal.offsetHeight;
                twofaModal.classList.add('active');
                document.body.style.overflow = 'hidden';
                syncTwofaModalFromServer();
            }
        }

        function closeTwofaModal() {
            if (twofaModal) {
                twofaModal.classList.remove('active');
                setTimeout(() => {
                    twofaModal.style.display = 'none';
                    document.body.style.overflow = '';
                }, 400);
            }
        }

        // Toggle 2FA
        if (twofaToggle) {
            twofaToggle.addEventListener('change', async function() {
                const enabled = this.checked;
                const originalState = !enabled;
                this.disabled = true;

                try {
                    const response = await fetch('{{ path("2fa_toggle") }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ enabled: enabled })
                    });

                    const data = await response.json();
                    if (data.success) {
                        twofaStatusText.textContent = enabled ? 'Enabled' : 'Disabled';
                        twofaEmailSection.style.display = enabled ? 'block' : 'none';
                        twofaTotpSection.style.display = enabled ? 'block' : 'none';
                        if (typeof showCoolPopup === 'function') {
                            showCoolPopup('Success', data.message, 'success');
                        }
                    } else {
                        this.checked = originalState;
                        if (typeof showCoolPopup === 'function') {
                            showCoolPopup('Error', data.message || 'Failed to update 2FA settings', 'error');
                        }
                    }
                } catch (error) {
                    this.checked = originalState;
                    console.error('Error:', error);
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Error', 'Failed to update 2FA settings', 'error');
                    }
                } finally {
                    this.disabled = false;
                }
            });
        }

        // Test Email OTP
        if (twofaTestEmailBtn) {
            twofaTestEmailBtn.addEventListener('click', async function() {
                const originalHtml = this.innerHTML;
                this.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Sending...';
                this.disabled = true;

                try {
                    const response = await fetch('{{ path("2fa_send_test_code") }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const data = await response.json();
                    if (data.success) {
                        window.pushNotif('Code sent! Check your email for the verification code', 'SUCCESS');
                    } else {
                        window.pushNotif(data.message || 'Failed to send code', 'ERROR');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    window.pushNotif('Failed to send code', 'ERROR');
                } finally {
                    this.disabled = false;
                }
            });
        }

        // TOTP QR Modal functions
        function openTotpQrModal() {
            if (totpQrModal) {
                totpQrModal.style.display = 'flex';
                totpQrModal.offsetHeight;
                totpQrModal.classList.add('active');
                document.body.style.overflow = 'hidden';
                generateTotpQr();
            }
        }

        function closeTotpQrModal() {
            if (totpQrModal) {
                totpQrModal.classList.remove('active');
                setTimeout(() => {
                    totpQrModal.style.display = 'none';
                    document.body.style.overflow = '';
                    // Reset form
                    if (totpVerifyCodeInput) totpVerifyCodeInput.value = '';
                    if (totpQrCodeContainer) totpQrCodeContainer.innerHTML = '<div class="text-center"><i class="bx bx-loader-alt bx-spin" style="font-size: 2rem; color: rgba(255,255,255,0.5);"></i><div style="color: rgba(255,255,255,0.7); font-size: 0.85rem; margin-top: 0.5rem;">Generating QR code...</div></div>';
                    if (totpSecretDisplay) totpSecretDisplay.style.display = 'none';
                    if (totpSecretText) totpSecretText.textContent = '';
                    currentTotpSecret = null;
                    // Sync 2FA modal from server so toggle and TOTP state stay correct
                    syncTwofaModalFromServer();
                }, 400);
            }
        }

        async function generateTotpQr() {
            if (!totpQrCodeContainer) return;

            try {
                const response = await fetch('{{ path("2fa_generate_totp") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();
                if (data.success && data.qrCode && data.secret) {
                    currentTotpSecret = data.secret;
                    
                    // Display manual entry code
                    if (totpSecretText) {
                        totpSecretText.textContent = data.secret;
                        if (totpSecretDisplay) totpSecretDisplay.style.display = 'block';
                    }

                    // Generate QR code using multiple methods for reliability
                    totpQrCodeContainer.innerHTML = '';
                    
                    // Method 1: Try QRCode.js library
                    if (typeof QRCode !== 'undefined') {
                        try {
                            await new Promise((resolve, reject) => {
                                QRCode.toCanvas(totpQrCodeContainer, data.qrCode, {
                                    width: 240,
                                    margin: 2,
                                    color: {
                                        dark: '#000000',
                                        light: '#FFFFFF'
                                    },
                                    errorCorrectionLevel: 'M'
                                }, function(error) {
                                    if (error) {
                                        reject(error);
                                    } else {
                                        resolve();
                                    }
                                });
                            });
                            // Success - QR code generated
                            return;
                        } catch (error) {
                            console.warn('QRCode.js failed, trying API method:', error);
                        }
                    }

                    // Method 2: Use QR code API as fallback
                    const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(data.qrCode)}&bgcolor=FFFFFF&color=000000&margin=2`;
                    const img = document.createElement('img');
                    img.src = qrApiUrl;
                    img.alt = 'QR Code';
                    img.style.width = '100%';
                    img.style.height = 'auto';
                    img.style.display = 'block';
                    img.onerror = function() {
                        // Fallback: Show manual entry only
                        totpQrCodeContainer.innerHTML = '<div style="color: rgba(255,255,255,0.7); padding: 1rem; text-align: center;"><i class="bx bx-error-circle" style="font-size: 2rem; margin-bottom: 0.5rem;"></i><div>QR code unavailable. Please use the manual entry code below.</div></div>';
                    };
                    totpQrCodeContainer.appendChild(img);
                    
                    // Focus on code input
                    if (totpVerifyCodeInput) {
                        setTimeout(() => totpVerifyCodeInput.focus(), 300);
                    }
                } else {
                    totpQrCodeContainer.innerHTML = '<div style="color: rgba(255,255,255,0.7); padding: 1rem; text-align: center;"><i class="bx bx-error-circle" style="font-size: 2rem; margin-bottom: 0.5rem;"></i><div>' + (data.message || 'Failed to generate QR code') + '</div></div>';
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Error', data.message || 'Failed to generate QR code', 'error');
                    }
                }
            } catch (error) {
                console.error('Error generating QR code:', error);
                if (totpQrCodeContainer) {
                    totpQrCodeContainer.innerHTML = '<div style="color: rgba(255,255,255,0.7); padding: 1rem; text-align: center;"><i class="bx bx-error-circle" style="font-size: 2rem; margin-bottom: 0.5rem;"></i><div>Failed to generate QR code. Please try again.</div></div>';
                }
                if (typeof showCoolPopup === 'function') {
                    showCoolPopup('Error', 'Failed to generate QR code', 'error');
                }
            }
        }

        // Setup TOTP - Open modal
        if (twofaSetupTotpBtn) {
            twofaSetupTotpBtn.addEventListener('click', function() {
                openTotpQrModal();
            });
        }

        // Verify TOTP code from modal
        if (totpQrVerifyBtn && totpVerifyCodeInput) {
            totpQrVerifyBtn.addEventListener('click', async function() {
                const code = totpVerifyCodeInput.value.trim();
                if (!code || code.length !== 6) {
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Error', 'Please enter a valid 6-digit code', 'error');
                    } else {
                        alert('Please enter a valid 6-digit code');
                    }
                    return;
                }

                const originalHtml = this.innerHTML;
                this.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Verifying...';
                this.disabled = true;

                try {
                    const response = await fetch('{{ path("2fa_verify_totp") }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ code: code, secret: currentTotpSecret || undefined })
                    });

                    const data = await response.json();
                    if (data.success) {
                        window.pushNotif('Authenticator app configured successfully!', 'SUCCESS');
                        closeTotpQrModal();
                        // Update 2FA modal to show "already configured" immediately
                        if (twofaTotpConfiguredBlock) twofaTotpConfiguredBlock.style.display = 'block';
                        if (twofaTotpSetupBlock) twofaTotpSetupBlock.style.display = 'none';
                        if (twofaToggle) twofaToggle.checked = true;
                        if (twofaStatusText) twofaStatusText.textContent = 'Enabled';
                        if (twofaEmailSection) twofaEmailSection.style.display = 'block';
                        if (twofaTotpSection) twofaTotpSection.style.display = 'block';
                        setTimeout(() => location.reload(), 500);
                    } else {
                        window.pushNotif(data.message || 'Invalid code', 'ERROR');
                        if (totpVerifyCodeInput) {
                            totpVerifyCodeInput.value = '';
                            totpVerifyCodeInput.focus();
                        }
                    }
                } catch (error) {
                    console.error('Error:', error);
                    window.pushNotif('Failed to verify code', 'ERROR');
                } finally {
                    this.innerHTML = originalHtml;
                    this.disabled = false;
                }
            });

            // Allow Enter key to submit
            totpVerifyCodeInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    totpQrVerifyBtn.click();
                }
            });
        }

        // Close TOTP QR modal
        if (totpQrModalClose) totpQrModalClose.addEventListener('click', closeTotpQrModal);
        if (totpQrModalCancel) totpQrModalCancel.addEventListener('click', closeTotpQrModal);
        if (totpQrModal) {
            totpQrModal.addEventListener('click', function(e) {
                if (e.target === totpQrModal) closeTotpQrModal();
            });
        }

        // Remove TOTP
        if (twofaRemoveTotpBtn) {
            twofaRemoveTotpBtn.addEventListener('click', async function() {
                if (!confirm('Are you sure you want to remove the authenticator app? You will need to set it up again to use it.')) {
                    return;
                }

                const originalHtml = this.innerHTML;
                this.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Removing...';
                this.disabled = true;

                try {
                    const response = await fetch('{{ path("2fa_remove_totp") }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const data = await response.json();
                    if (data.success) {
                        window.pushNotif('Authenticator app removed', 'SUCCESS');
                        location.reload();
                    } else {
                        window.pushNotif(data.message || 'Failed to remove', 'ERROR');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    window.pushNotif('Failed to remove', 'ERROR');
                } finally {
                    this.innerHTML = originalHtml;
                    this.disabled = false;
                }
            });
        }

        if (twofaOpenBtn) twofaOpenBtn.addEventListener('click', openTwofaModal);
        if (twofaCloseBtn) twofaCloseBtn.addEventListener('click', closeTwofaModal);
        if (twofaCancelBtn) twofaCancelBtn.addEventListener('click', closeTwofaModal);
        if (twofaModal) {
            twofaModal.addEventListener('click', function(e) {
                if (e.target === twofaModal) closeTwofaModal();
            });
        }

        // --- WebAuthn Modal Logic ---
        const waModal = document.getElementById('webauthn-settings-modal');
        const waOpenBtn = document.getElementById('webauthn-settings-open');
        const waCloseBtn = document.getElementById('webauthn-settings-modal-close');
        const waCancelBtn = document.getElementById('webauthn-settings-modal-cancel');
        const listContainerId = 'webauthn-credential-list';
        let isLoaded = false;

        function openWaModal() {
            if (waModal) {
                waModal.style.display = 'flex';
                waModal.offsetHeight;
                waModal.classList.add('active');
                document.body.style.overflow = 'hidden';
                if (!isLoaded) loadWebAuthn();
            }
        }

        function closeWaModal() {
            if (waModal) {
                waModal.classList.remove('active');
                setTimeout(() => {
                    waModal.style.display = 'none';
                    document.body.style.overflow = '';
                }, 400);
            }
        }

        function loadWebAuthn() {
            if (typeof WebAuthnManager !== 'undefined') {
                WebAuthnManager.listCredentials().then(list => {
                    WebAuthnManager.renderCredentialList(listContainerId, list);
                    isLoaded = true;
                });
            }
        }

        if (waOpenBtn) waOpenBtn.addEventListener('click', openWaModal);
        if (waCloseBtn) waCloseBtn.addEventListener('click', closeWaModal);
        if (waCancelBtn) waCancelBtn.addEventListener('click', closeWaModal);
        if (waModal) {
             waModal.addEventListener('click', function(e) {
                if (e.target === waModal) closeWaModal();
            });
        }
        
        // Also allow manual refresh
        const registerBtn = document.getElementById('webauthn-register-btn');
        if (registerBtn && typeof WebAuthnManager !== 'undefined') {
            registerBtn.addEventListener('click', async function() {
                const originalHtml = registerBtn.innerHTML;
                registerBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Registering...';
                registerBtn.disabled = true;

                try {
                    const result = await WebAuthnManager.register();
                    if (result.success) {
                        if (typeof showCoolPopup === 'function') showCoolPopup('Success', 'Device registered successfully', 'success');
                        
                        // Reload list
                        const list = await WebAuthnManager.listCredentials();
                        WebAuthnManager.renderCredentialList(listContainerId, list);
                    } else {
                        if (typeof showCoolPopup === 'function') showCoolPopup('Error', result.message, 'error');
                    }
                } catch (e) {
                    console.error(e);
                } finally {
                    registerBtn.innerHTML = originalHtml;
                    registerBtn.disabled = false;
                }
            });
        }
    });
</script>
<script>

// 1. Profile Settings Modal Logic
(function() {
    var modal = document.getElementById('profile-settings-modal');
    var openBtn = document.getElementById('profile-settings-open');
    var closeBtn = document.getElementById('profile-settings-modal-close');
    var cancelBtn = document.getElementById('profile-settings-modal-cancel');
    
    if (!modal || !openBtn) return;

    window.openProfileSettingsModal = function() {
        modal.style.display = 'flex';
        modal.offsetHeight;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    window.closeProfileSettingsModal = function() {
        modal.classList.remove('active');
        setTimeout(function() {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }, 400);
    }

    openBtn.addEventListener('click', window.openProfileSettingsModal);
    if (closeBtn) closeBtn.addEventListener('click', window.closeProfileSettingsModal);
    if (cancelBtn) cancelBtn.addEventListener('click', window.closeProfileSettingsModal);
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) window.closeProfileSettingsModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') window.closeProfileSettingsModal();
    });

    // Helper for AJAX submission
    function handleAjaxSubmit(form, onSuccess) {
        if (!form) return;
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            // Clear previous errors
            form.querySelectorAll('.main-home-validation-message').forEach(m => {
                m.classList.remove('error');
                m.textContent = '';
            });
            form.querySelectorAll('.input-error').forEach(i => i.classList.remove('input-error'));
            form.querySelectorAll('.input-success').forEach(i => i.classList.remove('input-success'));

            const submitBtn = form.querySelector('button[type="submit"]');
            const originalBtnHtml = submitBtn ? submitBtn.innerHTML : null;
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Processing...';
                submitBtn.disabled = true;
            }

            const formData = new FormData(form);
            fetch(form.action || window.location.href, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.pushNotif(data.message || 'Success!', 'SUCCESS');
                    if (onSuccess) onSuccess(data);
                    else setTimeout(() => window.location.reload(), 800);
                } else {
                    if (data.errors && typeof data.errors === 'object' && !Array.isArray(data.errors)) {
                        // data-field based mapping (structured object)
                        Object.entries(data.errors).forEach(([field, msg]) => {
                            const container = form.querySelector(`.main-home-validation-message[data-field="${field}"]`) ||
                                              form.querySelector(`[data-field$="[${field}]"]`) ||
                                              form.querySelector(`#${field}-validation`);
                            if (container) {
                                container.textContent = msg;
                                container.classList.add('error', 'active');
                            }
                            const input = form.querySelector(`[name*="${field}"]`);
                            if (input) input.classList.add('input-error');
                        });
                    } else if (data.errors && Array.isArray(data.errors)) {
                        // Fallback: flat array of error strings
                        data.errors.forEach(errStr => {
                            window.pushNotif(errStr, 'ERROR');
                        });
                    } else {
                        window.pushNotif(data.message || 'An error occurred.', 'ERROR');
                    }
                }
            })
            .catch(error => {
                console.error('Error:', error);
                window.pushNotif('A network error occurred.', 'ERROR');
            })
            .finally(() => {
                if (submitBtn) {
                    submitBtn.innerHTML = originalBtnHtml;
                    submitBtn.disabled = false;
                }
            });
        });
    }

    // Attach to profile settings form
    const settingsForm = document.getElementById('profile-settings-form');
    if (settingsForm) {
        handleAjaxSubmit(settingsForm, function(data) {
            window.closeProfileSettingsModal();
            // Update bio/description in UI
            const bioEl = document.querySelector('.main-home-profile-bio');
            const descInput = document.getElementById('profile_type_description_profile'); // Correct ID for DescriptionProfile in ProfileType
            if (bioEl && descInput) {
                bioEl.textContent = descInput.value || '—';
            }
            // SUCCESS POPUP is already shown by handleAjaxSubmit
        });
    }
})();

