    <script>
    // ── Friend Info Preview Card (same mechanics as calendar-event-preview) ──
    (function () {
        const preview = document.getElementById('friend-info-preview');
        const closeBtn = document.getElementById('fim-close');
        const infoUrl  = '{{ path("frontend_profile_friend_info", {id: 0}) }}';

        function positionPreview(rect) {
            // position:fixed → viewport coords ONLY (getBoundingClientRect already is viewport-relative)
            const cardCenterX = rect.left + rect.width / 2;
            const cardTopY    = rect.top;        // top edge of the card in the viewport
            preview.style.left = cardCenterX + 'px';
            preview.style.top  = cardTopY + 'px'; // CSS transform: translate(-50%,-100%) pulls it above
        }

        function showPreview(uid, fallbackName, fallbackAvatar, rect) {
            // Immediate load with placeholders
            document.getElementById('fim-name').textContent    = fallbackName || '…';
            document.getElementById('fim-role').textContent    = '…';
            document.getElementById('fim-email').textContent   = '…';
            document.getElementById('fim-created').textContent = '…';
            document.getElementById('fim-level').textContent   = '…';
            document.getElementById('fim-xp').textContent      = '…';
            const avatarEl = document.getElementById('fim-avatar');
            avatarEl.src = fallbackAvatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(fallbackName||'U')}&background=random&color=fff&bold=true`;

            positionPreview(rect);
            preview.style.display = 'block';
            requestAnimationFrame(() => preview.classList.add('show'));

            // Fetch real data
            fetch(infoUrl.replace('/0', '/' + uid), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(d => {
                if (!d.success) return;
                document.getElementById('fim-name').textContent    = d.name;
                document.getElementById('fim-role').textContent    = d.role;
                document.getElementById('fim-email').textContent   = d.email;
                document.getElementById('fim-created').textContent = d.created;
                document.getElementById('fim-level').textContent   = d.level;
                document.getElementById('fim-xp').textContent      = d.xp;
                if (d.avatar) avatarEl.src = d.avatar;
            })
            .catch(console.error);
        }

        function hidePreview() {
            preview.classList.remove('show');
            setTimeout(() => { preview.style.display = 'none'; }, 300);
        }

        closeBtn?.addEventListener('click', hidePreview);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePreview(); });

        // Hide when clicking outside
        document.addEventListener('click', e => {
            if (preview.classList.contains('show') &&
                !preview.contains(e.target) &&
                !e.target.closest('.friend-card-platinum')) {
                hidePreview();
            }
        });

        // Open on friend card click
        document.addEventListener('click', e => {
            const card = e.target.closest('.friend-card-platinum');
            if (!card) return;
            e.preventDefault();
            e.stopPropagation();
            const uid  = card.dataset.userId;
            const name = card.dataset.name;
            const av   = card.querySelector('img')?.src;
            if (uid) showPreview(uid, name, av, card.getBoundingClientRect());
        });
    })();
    </script>
    <script>
    // ─── Profile Hero Switcher Controller ───
    (function() {
        // Elements
        const qaBtn = document.getElementById('hero-quick-actions-btn');
        const heroDefault = document.getElementById('hero-default-info');
        const heroSwitcher = document.getElementById('hero-switcher');
        const switcherBack = document.getElementById('hero-switcher-back');
        const tiles = document.querySelectorAll('.hero-tile');
        const panels = document.querySelectorAll('.hero-panel');
        const panelBackBtns = document.querySelectorAll('.hero-panel-back');
        const detailsContainer = document.querySelector('.main-home-profile-details');

        // Global Helper for WebAuthn (Biometrics)
        window.loadWebAuthnCredentials = function(containerId) {
            if (typeof WebAuthnManager !== 'undefined') {
                WebAuthnManager.listCredentials().then(list => {
                    WebAuthnManager.renderCredentialList(containerId || 'hero-webauthn-list', list);
                });
            }
        };

        // Functions
        function hideAllInHero() {
            heroDefault.style.display = 'none';
            heroSwitcher.style.display = 'none';
            panels.forEach(p => p.style.display = 'none');
            
            heroDefault.classList.remove('hero-anim-in', 'hero-anim-out');
            heroSwitcher.classList.remove('hero-anim-in', 'hero-anim-out');
            panels.forEach(p => p.classList.remove('hero-anim-in', 'hero-anim-out'));
        }

        function showDefault() {
            hideAllInHero();
            qaBtn.classList.remove('active');
            heroDefault.style.display = 'block';
            heroDefault.classList.add('hero-anim-in');
        }

        function showSwitcher() {
            hideAllInHero();
            qaBtn.classList.add('active');
            heroSwitcher.style.display = 'block';
            heroSwitcher.classList.add('hero-anim-in');
        }

        function showPanel(id) {
            hideAllInHero();
            const panel = document.getElementById('hero-panel-' + id);
            if (panel) {
                panel.style.display = 'block';
                panel.classList.add('hero-anim-in');
                
                // Specific panel initializations
                if (id === 'biometrics') {
                    window.loadWebAuthnCredentials('hero-webauthn-list');
                } else if (id === '2fa') {
                    // Sync 2FA state from server or main toggle
                    const mainToggle = document.getElementById('twofa-toggle');
                    const heroToggle = document.getElementById('hero-twofa-toggle');
                    if (mainToggle && heroToggle) {
                        heroToggle.checked = mainToggle.checked;
                        document.getElementById('hero-twofa-status-text').textContent = mainToggle.checked ? 'Enabled' : 'Disabled';
                        document.getElementById('hero-twofa-sections').style.display = mainToggle.checked ? 'block' : 'none';
                    }
                }
            }
        }

        // Event Listeners
        qaBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            if (heroSwitcher.style.display === 'block') showDefault();
            else showSwitcher();
        });

        switcherBack?.addEventListener('click', (e) => {
            e.preventDefault();
            showDefault();
        });

        tiles.forEach(tile => {
            tile.addEventListener('click', () => {
                const panelId = tile.dataset.panel;
                showPanel(panelId);
            });
        });

        panelBackBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                showSwitcher();
            });
        });

        // ─── 2FA Integration ───
        const heroTwofaToggle = document.getElementById('hero-twofa-toggle');
        const heroTwofaStatusTxt = document.getElementById('hero-twofa-status-text');
        const heroTwofaSections = document.getElementById('hero-twofa-sections');
        
        heroTwofaToggle?.addEventListener('change', async function() {
            const enabled = this.checked;
            this.disabled = true;
            try {
                const response = await fetch('{{ path("2fa_toggle") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ enabled: enabled })
                });
                const data = await response.json();
                if (data.success) {
                    heroTwofaStatusTxt.textContent = enabled ? 'Enabled' : 'Disabled';
                    heroTwofaSections.style.display = enabled ? 'block' : 'none';
                } else {
                    this.checked = !enabled;
                    if (window.pushNotif) window.pushNotif(data.message || 'Error', 'ERROR');
                }
            } catch (err) {
                this.checked = !enabled;
            } finally {
                this.disabled = false;
            }
        });

        document.getElementById('hero-twofa-test-email')?.addEventListener('click', function() {
            const btn = this;
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Sending...';
            
            fetch('{{ path("2fa_send_test_code") }}', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        if (window.pushNotif) window.pushNotif('Code sent! Check your email.', 'SUCCESS');
                        btn.innerHTML = '<i class="bx bx-check"></i> Sent';
                    } else {
                        if (window.pushNotif) window.pushNotif(data.message || 'Error', 'ERROR');
                        btn.innerHTML = '<i class="bx bx-x"></i> Error';
                    }
                    setTimeout(() => { btn.innerHTML = original; btn.disabled = false; }, 2000);
                });
        });

        // INLINED TOTP SETUP
        const heroTotpQrStep = document.getElementById('hero-twofa-totp-qr-step');
        const heroTotpQrCode = document.getElementById('hero-totp-qr-code');
        const heroTotpVerifyCode = document.getElementById('hero-totp-verify-code');
        const heroTotpVerifyBtn = document.getElementById('hero-totp-verify-btn');
        const heroTotpCancel = document.getElementById('hero-totp-cancel');
        const heroTotpSecretDisplay = document.getElementById('hero-totp-secret-display');
        const heroTotpSecretText = document.getElementById('hero-totp-secret-text');
        const heroTotpStatusConf = document.getElementById('hero-twofa-totp-conf');
        const heroTotpStatusSetup = document.getElementById('hero-twofa-totp-setup');

        document.getElementById('hero-twofa-setup-totp')?.addEventListener('click', async () => {
             heroTotpStatusSetup.style.display = 'none';
             heroTotpQrStep.style.display = 'block';
             heroTotpQrCode.innerHTML = '<div class="text-center"><i class="bx bx-loader-alt bx-spin" style="color:#000; font-size:1.5rem;"></i></div>';
             
             try {
                const response = await fetch('{{ path("2fa_generate_totp") }}', { 
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' } 
                });
                const data = await response.json();
                if (data.success) {
                    // Use QRCode.toCanvas or toDataURL. Assuming qrcode.min.js is used.
                    if (typeof QRCode !== 'undefined') {
                        heroTotpQrCode.innerHTML = '';
                        const canvas = document.createElement('canvas');
                        heroTotpQrCode.appendChild(canvas);
                        QRCode.toCanvas(canvas, data.qrCodeUrl, { width: 120, margin: 0 });
                    }
                    if (data.secret) {
                        heroTotpSecretText.textContent = data.secret;
                        heroTotpSecretDisplay.style.display = 'block';
                    }
                } else {
                    if (window.pushNotif) window.pushNotif(data.message || 'Error', 'ERROR');
                    heroTotpStatusSetup.style.display = 'block';
                    heroTotpQrStep.style.display = 'none';
                }
             } catch (err) {
                 console.error(err);
                 heroTotpStatusSetup.style.display = 'block';
                 heroTotpQrStep.style.display = 'none';
             }
        });

        heroTotpCancel?.addEventListener('click', () => {
            heroTotpQrStep.style.display = 'none';
            heroTotpStatusSetup.style.display = 'block';
        });

        heroTotpVerifyBtn?.addEventListener('click', async () => {
            const code = heroTotpVerifyCode.value;
            if (!code || code.length !== 6) return;
            
            const original = heroTotpVerifyBtn.innerHTML;
            heroTotpVerifyBtn.disabled = true;
            heroTotpVerifyBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Verifying...';
            
            try {
                const response = await fetch('{{ path("2fa_verify_totp") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ code: code })
                });
                const data = await response.json();
                if (data.success) {
                    heroTotpQrStep.style.display = 'none';
                    heroTotpStatusConf.style.display = 'block';
                    if (window.pushNotif) window.pushNotif('Authenticator app activated!', 'SUCCESS');
                } else {
                    if (window.pushNotif) window.pushNotif(data.message || 'Invalid code', 'ERROR');
                    heroTotpVerifyBtn.innerHTML = original;
                    heroTotpVerifyBtn.disabled = false;
                }
            } catch (err) {
                heroTotpVerifyBtn.innerHTML = original;
                heroTotpVerifyBtn.disabled = false;
            }
        });
        
        document.getElementById('hero-twofa-remove-totp')?.addEventListener('click', async () => {
            if (!confirm('Remove authenticator app?')) return;
            try {
                const response = await fetch('{{ path("2fa_remove_totp") }}', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await response.json();
                if (data.success) {
                    heroTotpStatusConf.style.display = 'none';
                    heroTotpStatusSetup.style.display = 'block';
                    if (window.pushNotif) window.pushNotif('Authenticator removed', 'SUCCESS');
                }
            } catch (err) {}
        });

        // ─── FaceID & Biometrics INLINED ───
        document.getElementById('hero-faceid-start-capture')?.addEventListener('click', () => {
            // Already handled by step-toggle in HTML? No, we need logic.
            document.getElementById('hero-faceid-step-1').style.display = 'none';
            document.getElementById('hero-faceid-step-2').style.display = 'block';
            
            // Re-use Face ID logic
            if (typeof initFaceIDLogic === 'function') {
                initFaceIDLogic({
                    containerId: 'hero-faceid-step-2',
                    videoId: 'hero-faceid-video',
                    canvasId: 'hero-faceid-canvas',
                    hintId: 'hero-faceid-hint',
                    progressId: 'hero-faceid-progress',
                    instructionId: 'hero-faceid-instruction',
                    btnId: 'hero-faceid-start-capture',
                    pinId: 'hero-faceid-pin',
                    cameraSelectId: 'hero-faceid-camera-select',
                    switchCameraBtnId: 'hero-faceid-switch-camera'
                });
            }
        });

        document.getElementById('hero-webauthn-register')?.addEventListener('click', async () => {
            const btn = document.getElementById('hero-webauthn-register');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Initializing...';
            btn.disabled = true;
            
            try {
                if (typeof WebAuthn !== 'undefined') {
                    const success = await WebAuthn.register();
                    if (success) {
                        if (window.pushNotif) window.pushNotif('Device registered successfully!', 'SUCCESS');
                        window.loadWebAuthnCredentials('hero-webauthn-list');
                    }
                }
            } catch (err) {
                console.error(err);
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        });

        // ─── Profile Settings AJAX ───
        const settingsForm = document.getElementById('profile-settings-form');
        if (settingsForm) {
            settingsForm.addEventListener('submit', async function(e) {
                const heroSaveBtn = document.getElementById('hero-settings-save');
                if (!heroSaveBtn) return;
                
                e.preventDefault();
                const originalHtml = heroSaveBtn.innerHTML;
                heroSaveBtn.disabled = true;
                heroSaveBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Saving...';

                try {
                    const formData = new FormData(settingsForm);
                    const response = await fetch(settingsForm.action, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    
                    if (response.ok) {
                        heroSaveBtn.innerHTML = '<i class="bx bx-check"></i> Profile Updated!';
                        if (window.pushNotif) window.pushNotif('Profile settings saved successfully', 'SUCCESS');
                        setTimeout(() => {
                            heroSaveBtn.innerHTML = originalHtml;
                            heroSaveBtn.disabled = false;
                            location.reload(); 
                        }, 1200);
                    } else {
                        throw new Error('Save failed');
                    }
                } catch (err) {
                    heroSaveBtn.innerHTML = '<i class="bx bx-x"></i> Error';
                    heroSaveBtn.disabled = false;
                    setTimeout(() => { heroSaveBtn.innerHTML = originalHtml; }, 2000);
                }
            });
        }


    })();
    </script>

    <script src="{{ asset('frontend/js/forum.js') }}"></script>
    <script src="{{ asset('frontend/js/syndicati-agent.js') }}" defer></script>
    <script src="{{ asset('frontend/js/syndicati-messaging.js') }}" defer></script>
</body>
