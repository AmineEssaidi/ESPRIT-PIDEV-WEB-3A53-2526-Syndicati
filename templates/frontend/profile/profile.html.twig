                                <div>
                                    <small class="text-secondary d-block">Remaining</small>
                                    <span id="event-modal-remaining" class="fw-bold"></span>
                                </div>
                            </div>
                            <div id="event-modal-admin-actions" class="mt-4 pt-3 d-none">
