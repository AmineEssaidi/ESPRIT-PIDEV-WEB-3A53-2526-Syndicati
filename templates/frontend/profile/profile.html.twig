    <script>
        window.currentUserId = {{ user.idUser|default(0) }};
        document.addEventListener('DOMContentLoaded', function() {
            // --- Reusable Face ID Initialization ---
            function initFaceIDLogic(config) {
                const {
                    openBtn, modal, closeBtn, cancelBtn, startBtn,
                    step1, step2, video, pinInput, progressBar,
                    instruction, livenessHint, cameraSelect, switchBtn,
                    isHero = false
                } = config;

                let stream = null;
                let currentDeviceId = null;

                async function getCameras() {
                    try {
                        const devices = await navigator.mediaDevices.enumerateDevices();
                        const videoDevices = devices.filter(device => device.kind === 'videoinput');
                        if (videoDevices.length > 1 && cameraSelect) {
                            cameraSelect.innerHTML = videoDevices.map(d => `<option value="${d.deviceId}">${d.label || 'Camera ' + d.deviceId.slice(0,5)}</option>`).join('');
                            cameraSelect.style.display = 'block';
                            if (switchBtn) switchBtn.style.display = 'block';
                        }
                    } catch (e) { console.warn('Could not list cameras:', e); }
                }

                async function startStream(deviceId = null) {
                    if (stream) stream.getTracks().forEach(t => t.stop());
                    const constraints = { video: deviceId ? { deviceId: { exact: deviceId } } : { facingMode: 'user' } };
                    stream = await navigator.mediaDevices.getUserMedia(constraints);
                    video.srcObject = stream;
                    currentDeviceId = deviceId;
                }

                const closeHandler = () => {
                    if (!isHero && modal) {
                        modal.classList.remove('active');
                        setTimeout(() => { modal.style.display = 'none'; document.body.style.overflow = ''; }, 500);
                    }
                    if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
                };

                openBtn?.addEventListener('click', () => {
                    if (!isHero && modal) {
                        modal.style.display = 'flex';
                        modal.offsetHeight;
                        modal.classList.add('active');
                        document.body.style.overflow = 'hidden';
                    }
                    step1.style.display = 'block';
                    step2.style.display = 'none';
                });

                closeBtn?.addEventListener('click', closeHandler);
                cancelBtn?.addEventListener('click', closeHandler);
                if (modal && !isHero) modal.addEventListener('click', (e) => { if (e.target === modal) closeHandler(); });

                startBtn?.addEventListener('click', async () => {
                    const pin = pinInput.value;
                    if (pin.length < 4) { alert('Please enter at least a 4-digit PIN'); return; }
                    try {
                        await startStream();
                        await getCameras();
                        step1.style.display = 'none';
                        step2.style.display = 'block';
                        livenessHint.textContent = 'Initializing models...';

                        await FaceID.startEnrollment(video, pin, (progress) => {
                            progressBar.style.width = (progress * 100) + '%';
                            if (progress < 0.3) instruction.textContent = 'Look straight at the camera...';
                            else if (progress < 0.6) instruction.textContent = 'Slowly turn your head left and right...';
                            else if (progress < 0.9) instruction.textContent = 'Now blink a few times...';
                            else instruction.textContent = 'Great! Almost done...';
                            livenessHint.textContent = 'Capturing face features...';
                        }).then(result => {
                            if (typeof showCoolPopup === 'function') showCoolPopup('Success', 'Face ID enrolled successfully!', 'success');
                            else alert('Face ID enrolled successfully!');
                            closeHandler();
                        }).catch(err => { if (err.message !== 'STOP') { alert(err.message); closeHandler(); } });
                    } catch (e) { alert('Could not access camera or load models.'); closeHandler(); }
                });

                switchBtn?.addEventListener('click', async () => {
                    const nextId = cameraSelect?.value;
                    if (nextId === currentDeviceId) return;
                    try { await startStream(nextId); } catch (e) { alert('Could not switch to selected camera.'); }
                });
                cameraSelect?.addEventListener('change', () => switchBtn?.click());
            }

            // 1. Initialize for the original Modal
            initFaceIDLogic({
                openBtn: document.getElementById('faceid-enroll-open'),
                modal: document.getElementById('faceid-enroll-modal'),
                closeBtn: document.getElementById('faceid-enroll-modal-close'),
                cancelBtn: document.getElementById('faceid-enroll-modal-cancel'),
                startBtn: document.getElementById('faceid-start-capture'),
                step1: document.getElementById('faceid-enroll-step-1'),
                step2: document.getElementById('faceid-enroll-step-2'),
                video: document.getElementById('faceid-video'),
                pinInput: document.getElementById('faceid-pin'),
                progressBar: document.getElementById('faceid-progress'),
                instruction: document.getElementById('faceid-instruction'),
                livenessHint: document.getElementById('faceid-liveness-hint'),
                cameraSelect: document.getElementById('faceid-camera-select'),
                switchBtn: document.getElementById('faceid-switch-camera')
            });

            // 2. Initialize for the new Hero Panel
            initFaceIDLogic({
                openBtn: null, // Managed by hero switcher navigation
                modal: null,
                closeBtn: document.querySelector('#hero-panel-faceid .hero-panel-back'),
                cancelBtn: null,
                startBtn: document.getElementById('hero-faceid-start-capture'),
                step1: document.getElementById('hero-faceid-step-1'),
                step2: document.getElementById('hero-faceid-step-2'),
                video: document.getElementById('hero-faceid-video'),
                pinInput: document.getElementById('hero-faceid-pin'),
                progressBar: document.getElementById('hero-faceid-progress'),
                instruction: document.getElementById('hero-faceid-instruction'),
                livenessHint: document.getElementById('hero-faceid-hint'),
                cameraSelect: null,
                switchBtn: null,
                isHero: true
            });
        });

    </script>


