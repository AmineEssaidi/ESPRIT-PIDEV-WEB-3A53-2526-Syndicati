                                            <button type="button" class="hero-panel-back"><i class="bx bx-arrow-back"></i></button>
                                            <span><i class="bx bx-camera-home"></i> Face ID</span>
                                        </div>
                                        <div id="hero-faceid-step-1">
                                            <p class="hero-panel-desc">Protect your account with local Face ID. This only works on this PC.</p>
                                            <input type="password" id="hero-faceid-pin" class="hero-panel-input" placeholder="Enter a local PIN for encryption">
                                            <small style="color:rgba(255,255,255,0.4); font-size:0.75rem; display:block; margin-top:0.4rem;">This PIN encrypts your Face ID locally.</small>
                                            <button class="hero-panel-primary-btn mt-3" id="hero-faceid-start-capture">
                                                <i class="bx bx-face"></i> Start Enrollment
                                            </button>
                                        </div>
                                        <div id="hero-faceid-step-2" style="display:none;">
                                            <div style="position:relative; width:100%; aspect-ratio:4/3; background:#000; border-radius:12px; overflow:hidden; margin-bottom:0.75rem;">
                                                <video id="hero-faceid-video" autoplay muted playsinline style="width:100%;height:100%;object-fit:cover;"></video>
                                                <canvas id="hero-faceid-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
                                                <div id="hero-faceid-hint" style="position:absolute;bottom:0;left:0;right:0;padding:0.5rem;background:rgba(0,0,0,0.5);font-size:0.75rem;color:#fff;">Looking for face...</div>
                                            </div>
                                            <div class="progress mb-2" style="height:8px;background:rgba(255,255,255,0.1);border-radius:100px;">
                                                <div id="hero-faceid-progress" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width:0%;border-radius:100px;"></div>
                                            </div>
                                            <p id="hero-faceid-instruction" style="font-size:0.8rem;color:rgba(255,255,255,0.6);">Look straight at the camera, then turn slightly.</p>
