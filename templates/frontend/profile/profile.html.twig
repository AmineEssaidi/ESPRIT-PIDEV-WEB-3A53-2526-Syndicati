<script>

// 1. Profile Settings Modal Logic
(function() {
    var modal = document.getElementById('profile-settings-modal');
    var openBtn = document.getElementById('profile-settings-open');
    var closeBtn = document.getElementById('profile-settings-modal-close');
    var cancelBtn = document.getElementById('profile-settings-modal-cancel');
    
    if (!modal || !openBtn) return;

    window.openProfileSettingsModal = function() {
        modal.style.display = 'flex';
        modal.offsetHeight;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    window.closeProfileSettingsModal = function() {
        modal.classList.remove('active');
        setTimeout(function() {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }, 400);
    }

    openBtn.addEventListener('click', window.openProfileSettingsModal);
    if (closeBtn) closeBtn.addEventListener('click', window.closeProfileSettingsModal);
    if (cancelBtn) cancelBtn.addEventListener('click', window.closeProfileSettingsModal);
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) window.closeProfileSettingsModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') window.closeProfileSettingsModal();
    });

    // Helper for AJAX submission
    function handleAjaxSubmit(form, onSuccess) {
        if (!form) return;
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalBtnHtml = submitBtn ? submitBtn.innerHTML : null;
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Processing...';
                submitBtn.disabled = true;
            }

            const formData = new FormData(form);
            fetch(form.action || window.location.href, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Success', data.message, 'success');
                    } else { alert(data.message); }
                    if (onSuccess) onSuccess(data);
                    else window.location.reload();
                } else {
                    let errorMsg = data.message || 'An error occurred.';
                    if (data.errors && Array.isArray(data.errors)) {
                        errorMsg += '\n' + data.errors.join('\n');
                    }
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Error', errorMsg, 'error');
                    } else { alert(errorMsg); }
                }
            })
            .catch(error => {
                console.error('Error:', error);
                if (typeof showCoolPopup === 'function') {
                    showCoolPopup('Error', 'A network error occurred.', 'error');
                } else { alert('A network error occurred.'); }
            })
            .finally(() => {
                if (submitBtn) {
                    submitBtn.innerHTML = originalBtnHtml;
                    submitBtn.disabled = false;
                }
            });
        });
    }

    // Attach to profile settings form
    const settingsForm = document.getElementById('profile-settings-form');
    if (settingsForm) {
        handleAjaxSubmit(settingsForm, function(data) {
            window.closeProfileSettingsModal();
            // Update bio/description in UI
            const bioEl = document.querySelector('.main-home-profile-bio');
            const descInput = document.getElementById('profile_type_description_profile'); // Correct ID for DescriptionProfile in ProfileType
            if (bioEl && descInput) {
                bioEl.textContent = descInput.value || '—';
            }
            // SUCCESS POPUP is already shown by handleAjaxSubmit
        });
    }
})();

// 2. Onboarding Modal Logic
(function() {
    var modal = document.getElementById('profile-onboarding-modal');
    var openBtn = document.getElementById('profile-onboarding-modify-open');
    var closeBtn = document.getElementById('profile-onboarding-modal-close');
    
    if (!modal || !openBtn) return;

    window.openOnboardingModal = function() {
        modal.style.display = 'flex';
        modal.offsetHeight;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    window.closeOnboardingModal = function() {
        modal.classList.remove('active');
        setTimeout(function() {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }, 400);
    }

    openBtn.addEventListener('click', window.openOnboardingModal);
    if (closeBtn) closeBtn.addEventListener('click', window.closeOnboardingModal);
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) window.closeOnboardingModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') window.closeOnboardingModal();
    });
})();

// 3. Onboarding Wizard Logic
(function() {
    var modal = document.getElementById('profile-onboarding-modal');
    if (!modal) return;
    var form = document.getElementById('profile-onboarding-form');
    var steps = [1,2,3,4,5,6,7];
    var currentStep = 1;
    var dots = modal.querySelectorAll('.glass-wizard-dot');
    var prevBtn = document.getElementById('ob-prev');
    var nextBtn = document.getElementById('ob-next');
    var submitBtn = document.getElementById('ob-submit');

    function getLocaleSelect() { return form ? form.querySelector('[name*="[selectedLocale]"]') : null; }
    function getThemeSelect() { return form ? form.querySelector('[name*="[selectedTheme]"]') : null; }

    function syncLocaleTheme() {
        var localeRadio = modal.querySelector('input[name="ob_locale_radio"]:checked');
        var themeRadio = modal.querySelector('input[name="ob_theme_radio"]:checked');
        var localeSelect = getLocaleSelect();
        var themeSelect = getThemeSelect();
        if (localeRadio && localeSelect) localeSelect.value = localeRadio.value;
        if (themeRadio && themeSelect) themeSelect.value = themeRadio.value;
        /* Real-time theme: same as actual onboarding */
        if (themeRadio) {
            var themeVal = themeRadio.value;
            document.documentElement.setAttribute('data-theme', themeVal);
            try { localStorage.setItem('theme', themeVal); } catch (e) {}
        }
        /* Real-time language: same as actual onboarding */
        if (localeRadio && typeof window.setLanguage === 'function') {
            window.setLanguage(localeRadio.value);
        }
    }

    modal.querySelectorAll('input[name="ob_locale_radio"], input[name="ob_theme_radio"]').forEach(function(r) {
        r.addEventListener('change', syncLocaleTheme);
    });

    function showStep(step) {
        currentStep = step;
        steps.forEach(function(s) {
            var el = document.getElementById('ob-step-' + s);
            if (el) el.classList.toggle('active', s === step);
        });
        dots.forEach(function(d, i) {
            d.classList.remove('active', 'done');
            if (i + 1 < step) d.classList.add('done');
            else if (i + 1 === step) d.classList.add('active');
        });
        if (prevBtn) prevBtn.style.visibility = step === 1 ? 'hidden' : 'visible';
        if (nextBtn) nextBtn.style.display = step === 7 ? 'none' : 'inline-flex';
        if (submitBtn) submitBtn.style.display = step === 7 ? 'inline-flex' : 'none';
        syncLocaleTheme();
    }

    if (prevBtn) prevBtn.addEventListener('click', function() { if (currentStep > 1) showStep(currentStep - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { if (currentStep < 7) showStep(currentStep + 1); });

    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = submitBtn;
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Saving...';
            btn.disabled = true;

            const formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Success', data.message, 'success');
                    } else { alert(data.message); }
                    
                    // Update UI dynamically
                    const localeRadio = modal.querySelector('input[name="ob_locale_radio"]:checked');
                    const themeRadio = modal.querySelector('input[name="ob_theme_radio"]:checked');
                    
                    if (localeRadio) {
                        const label = localeRadio.parentElement.querySelector('label').textContent;
                        const el = document.getElementById('ob-val-locale');
                        if (el) el.textContent = label;
                    }
                    if (themeRadio) {
                        const label = themeRadio.parentElement.querySelector('label').textContent;
                        const el = document.getElementById('ob-val-theme');
                        if (el) el.textContent = label;
                    }
                    
                    // Update preferences grid
                    const grid = document.getElementById('ob-preferences-grid');
                    if (grid) {
                        modal.querySelectorAll('input[type="radio"][name^="prefs["]:checked').forEach(radio => {
                            const nameMatch = radio.name.match(/prefs\[(.*)\]/);
                            if (nameMatch) {
                                const key = nameMatch[1];
                                const label = radio.parentElement.querySelector('label').textContent;
                                const item = grid.querySelector(`.profile-onboarding-pref-item[data-pref-key="${key}"]`);
                                if (item) {
                                    const valSpan = item.querySelector('.profile-onboarding-pref-value');
                                    if (valSpan) valSpan.textContent = label;
                                }
                            }
                        });
                    }

                    window.closeOnboardingModal();
                } else {
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Error', data.message || 'Error saving choices', 'error');
                    } else { alert(data.message || 'Error'); }
                    btn.innerHTML = original;
                    btn.disabled = false;
                }
            })
            .catch(err => {
                console.error(err);
                btn.innerHTML = original;
                btn.disabled = false;
                if (typeof showCoolPopup === 'function') {
                    showCoolPopup('Error', 'Network error', 'error');
                }
            });
        });
    }

    var openBtn = document.getElementById('profile-onboarding-modify-open');
    if (openBtn) openBtn.addEventListener('click', function() { showStep(1); });
})();

(function() {
    var form = document.getElementById('profile-avatar-upload-form');
    var fileInput = document.getElementById('profile-avatar-file-input');
    if (form && fileInput) {
        fileInput.addEventListener('change', function() {
            if (!fileInput.files || !fileInput.files.length) return;
            
            // Visual feedback - show spinner on avatar
            const avatarImg = document.getElementById('profile-avatar-img');
            const originalSrc = avatarImg.src;
            const hint = form.querySelector('.profile-avatar-upload-hint');
            if (hint) hint.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i>';

            const formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (avatarImg) avatarImg.src = '/' + data.avatar;
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Success', data.message, 'success');
                    }
                } else {
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Error', data.message || 'Upload failed', 'error');
                    } else { alert(data.message || 'Error'); }
                }
            })
            .catch(err => {
                console.error(err);
                if (typeof showCoolPopup === 'function') {
                    showCoolPopup('Error', 'Network error during upload', 'error');
                }
            })
            .finally(() => {
                if (hint) hint.innerHTML = '<i class="bx bx-camera"></i> Upload';
            });
        });
    }
})();

/* Tab Switching Logic */
(function() {
    const pills = document.querySelectorAll('.profile-nav-pill');
    const contents = document.querySelectorAll('.profile-tab-content');

    pills.forEach(pill => {
        pill.addEventListener('click', () => {
            const tabName = pill.dataset.tab;
            
            // Update Active Pill
            pills.forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            
            // Update Active Content
            contents.forEach(content => {
                content.classList.remove('active');
            });
            
            const activeContent = document.getElementById('tab-' + tabName);
            if (activeContent) {
                activeContent.classList.add('active');
            }
        });
    });

    // List initialization logic moved to the main DOMContentLoaded block below to avoid scope issues

    // Lightbox Functionality (Global)
    const lightbox = document.getElementById('reclamation-lightbox');
    const lightboxImg = document.getElementById('lightbox-image');
    const lightboxClose = document.getElementById('lightbox-close');

    window.openLightbox = function(src) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = src;
        lightbox.style.display = 'flex';
        // Force reflow for transition
        lightbox.offsetHeight;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden'; // Prevent scrolling
    };

    window.closeLightbox = function() {
        if (!lightbox) return;
        lightbox.classList.remove('active');
        setTimeout(() => {
            lightbox.style.display = 'none';
            if (lightboxImg) lightboxImg.src = '';
            document.body.style.overflow = '';
        }, 300);
    };

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightbox) {
        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
        });
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox && lightbox.classList.contains('active')) {
            closeLightbox();
        }
    });
})();
</script>

