    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchTrigger = document.querySelector('.btn-resident-search-trigger');
            const searchInput = document.querySelector('.resident-search-input');
            const searchContainer = document.querySelector('.search-input-wrapper');
            const triggerWrapper = document.querySelector('.search-trigger-wrapper');
            const closeBtn = document.querySelector('.btn-search-close');
            const resultsDropdown = document.querySelector('.search-results-dropdown-platinum');

            if (searchTrigger) {
                searchTrigger.addEventListener('click', () => {
                    triggerWrapper.classList.add('d-none');
                    searchContainer.classList.remove('d-none');
                    searchInput.focus();
                });
            }

            if (closeBtn) {
                closeBtn.addEventListener('click', () => {
                    searchContainer.classList.add('d-none');
                    triggerWrapper.classList.remove('d-none');
                    searchInput.value = '';
                    resultsDropdown.classList.remove('has-results');
                    resultsDropdown.innerHTML = '';
                });
            }

            let searchTimeout;
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    clearTimeout(searchTimeout);
                    const query = e.target.value.trim();
                    if (query.length < 2) {
                        resultsDropdown.classList.remove('has-results');
                        return;
                    }

                    searchTimeout = setTimeout(async () => {
                        console.log('Searching for:', query);
                        const formData = new FormData();
                        formData.append('query', query);

                        try {
                            const response = await fetch('{{ path("frontend_profile_search_residents") }}', {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                }
                            });
                            const data = await response.json();
                            console.log('Search results:', data);

                            if (data.success) {
                                renderSearchResults(data.residents);
                            }
                        } catch (err) {
                            console.error('Search error:', err);
                        }
                    }, 400);
                });
            }

            function renderSearchResults(residents) {
                if (residents.length === 0) {
                    resultsDropdown.innerHTML = '<div class="p-3 text-center text-muted small">No residents found.</div>';
                } else {
                    resultsDropdown.innerHTML = residents.map(r => `
                        <div class="search-result-item-platinum">
                            <img src="${r.avatar}" class="result-avatar-platinum">
                            <span class="result-name-platinum">${r.name}</span>
                            <button class="btn-add-resident" data-id="${r.id}">
                                <i class="bx bx-user-plus me-1"></i> Add
                            </button>
                        </div>
                    `).join('');

                    resultsDropdown.querySelectorAll('.btn-add-resident').forEach(btn => {
                        btn.addEventListener('click', async (e) => {
                            const targetId = btn.dataset.id;
                            btn.disabled = true;
                            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i>';

                            const formData = new FormData();
                            formData.append('targetId', targetId);
                            formData.append('_csrf_token', '{{ csrf_token("profile_add_resident") }}');

                            try {
                                const response = await fetch('{{ path("frontend_profile_add_resident") }}', {
                                    method: 'POST',
                                    body: formData,
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest'
                                    }
                                });
                                const data = await response.json();
                                if (data.success) {
                                    btn.classList.add('requested');
                                    btn.innerHTML = '<i class="bx bx-check me-1"></i> Requested';
                                } else {
                                    btn.disabled = false;
                                    btn.innerHTML = '<i class="bx bx-user-plus me-1"></i> Add';
                                    alert(data.message);
                                }
                            } catch (err) {
                                console.error('Add error:', err);
                                alert('An error occurred. Please try again.');
                            }
                        });
                    });
                }
                resultsDropdown.classList.add('has-results');
            }
        });
    </script>

    <script>
    // ── Circle Tab Switcher ──
    function circleSetTab(tab) {
        const panelFriends  = document.getElementById('circle-panel-friends');
        const panelPending  = document.getElementById('circle-panel-pending');
        const btnFriends    = document.getElementById('circle-tab-friends');
        const btnPending    = document.getElementById('circle-tab-pending');
        if (!panelFriends || !panelPending) return;

        const isF = tab === 'friends';
        panelFriends.style.display  = isF ? '' : 'none';
        panelPending.style.display  = isF ? 'none' : '';

        const activeBg   = 'var(--syndicat-accent-gradient)';
        const inactiveBg = 'rgba(255,255,255,0.04)';

        btnFriends.style.background = isF ? activeBg : inactiveBg;
        btnFriends.style.color      = isF ? '#fff' : 'rgba(255,255,255,0.5)';
        btnPending.style.background = isF ? inactiveBg : activeBg;
        btnPending.style.color      = isF ? 'rgba(255,255,255,0.5)' : '#fff';
    }

    // ── Accept / Decline Friend Requests ──
    document.addEventListener('DOMContentLoaded', () => {
        const acceptUrl  = '{{ path("frontend_profile_accept_resident") }}';
        const declineUrl = '{{ path("frontend_profile_decline_resident") }}';

        document.body.addEventListener('click', async (e) => {
            const acceptBtn  = e.target.closest('.btn-accept-request');
            const declineBtn = e.target.closest('.btn-decline-request');
            const btn = acceptBtn || declineBtn;
            if (!btn) return;

            const relId = btn.dataset.relId;
            const row   = btn.closest('.pending-request-row');
            btn.disabled = true;
            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i>';

            const fd = new FormData();
            fd.append('relationshipId', relId);

            try {
                const url  = acceptBtn ? acceptUrl : declineUrl;
                const resp = await fetch(url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await resp.json();

                if (data.success) {
                    if (acceptBtn) {
                        btn.closest('.d-flex.gap-1').innerHTML =
                            '<span style="color: #43b581; font-size: 0.75rem; font-weight: 700;"><i class="bx bx-check-circle me-1"></i>Accepted!</span>';
                    } else {
                        row.style.opacity = '0';
                        row.style.transition = 'opacity .3s';
                        setTimeout(() => row.remove(), 300);
                    }
                    // Update the pending badge count
                    const badge = document.getElementById('circle-pending-badge');
                    if (badge) {
                        const current = parseInt(badge.textContent) || 0;
                        const next = current - 1;
                        if (next <= 0) badge.remove();
                        else badge.textContent = next + ' PENDING';
                    }
                } else {
                    btn.disabled = false;
                    btn.innerHTML = acceptBtn ? '<i class="bx bx-check"></i>' : '<i class="bx bx-x"></i>';
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Error', data.message || 'Something went wrong.', 'error');
                    }
                }
            } catch (err) {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = acceptBtn ? '<i class="bx bx-check"></i>' : '<i class="bx bx-x"></i>';
            }
        });
    });
    </script>

