    // --- Events Pagination & Filtering ---
    const allEventItems = Array.from(document.querySelectorAll('.event-item'));
    const eventPaginationContainer = document.getElementById('events-pagination');
    let currentEventAdminFilter = isAdmin ? 'all' : 'my';

    window.initializeEventsPagination = function() {
        try {
            const filteredItems = allEventItems.filter(item => {
                if (currentEventAdminFilter === 'all') return true;
                return item.dataset.userId == currentUserId;
            });

            allEventItems.forEach(item => {
                item.style.display = 'none';
                item.classList.remove('active');
            });

            if (!eventPaginationContainer) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            eventPaginationContainer.innerHTML = '';
            if (filteredItems.length === 0) return;

            if (filteredItems.length <= itemsPerPage) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
            
            function showEventPage(page) {
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;
                
                filteredItems.forEach(item => {
                    item.style.display = 'none';
                    item.classList.remove('active');
                });

                filteredItems.slice(start, end).forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });

                eventPaginationContainer.querySelectorAll('.pagination-pill').forEach(pill => {
                    pill.classList.toggle('active', parseInt(pill.dataset.page) === page);
                });
            }

            for (let i = 1; i <= totalPages; i++) {
                const pill = document.createElement('div');
                pill.className = 'pagination-pill';
                pill.textContent = i;
                pill.dataset.page = i;
                if (i === 1) pill.classList.add('active');
                
                pill.addEventListener('click', () => {
                    showEventPage(i);
                    document.getElementById('tab-events').scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                
                eventPaginationContainer.appendChild(pill);
            }
            showEventPage(1);
        } catch (e) { console.error("Event Pagination Error:", e); }
    };

    window.initializeEventsPagination();

    window.handleCommentAction = async function (pubId, commentId, action, type = null) {
        let url = `/forum/action/comment/${action}/${commentId}`;
        if (type) url += `/${type}`;

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await response.json();

            if (data.success) {
                // Update Comment UI
                const commentEl = document.querySelector(`.comment-item[data-id="${commentId}"]`);
                if (commentEl) {
                    const btnLike = commentEl.querySelector('.btn-comment-like');
                    const btnDislike = commentEl.querySelector('.btn-comment-dislike');
                    const btnSignal = commentEl.querySelector('.btn-comment-signal');

                    if (action === 'react') {
                        if (type === 'like') {
                            btnLike.classList.toggle('active');
                            btnDislike.classList.remove('active');
                        } else if (type === 'dislike') {
                            btnDislike.classList.toggle('active');
                            btnLike.classList.remove('active');
                        }
                    } else if (action === 'report') {
                        btnSignal.classList.toggle('active');
                    }

                    // Update Counts
                    if (data.counts) {
                        const countLike = commentEl.querySelector('.count-comment-like');
                        const countDislike = commentEl.querySelector('.count-comment-dislike');
                        const countReport = commentEl.querySelector('.count-comment-report');

                        if (countLike && data.counts.likes !== undefined) countLike.textContent = data.counts.likes;
                        if (countDislike && data.counts.dislikes !== undefined) countDislike.textContent = data.counts.dislikes;
                        if (countReport && data.counts.reports !== undefined) countReport.textContent = data.counts.reports;
                    }
                }
                // window.showCoolPopup('Success', data.message, 'success');
            } else {
                // window.showCoolPopup('Information', data.message, 'info');
            }
        } catch (err) {
            console.error('Comment AJAX Error:', err);
        }
    };

