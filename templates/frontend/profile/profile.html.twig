<script>
window.openReclamationDetails = function(id) {
    const modalEl = document.getElementById('reclamationDetailsModal');
    const content = document.getElementById('reclamation-modal-content');
    
    // Reset content
    content.innerHTML = `
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>`;
    
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
    
    fetch(`/syndicat/${id}/details`, {
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(res => res.text())
    .then(html => {
        content.innerHTML = html;
        attachReplyHandler(id);
    })
    .catch(err => {
        content.innerHTML = `<div class="p-4 text-center text-danger">Failed to load details.</div>`;
    });
};

function attachReplyHandler(recId) {
    const form = document.getElementById('reponse-form');
    if (!form) return;
    
    form.onsubmit = function(e) {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i>';
        
        const formData = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Refresh modal content to show new reply
                fetch(`/syndicat/${recId}/details`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.text())
                .then(html => {
                    document.getElementById('reclamation-modal-content').innerHTML = html;
                    attachReplyHandler(recId);
                });
            } else {
                alert(data.message || 'Error');
                btn.disabled = false;
                btn.innerHTML = original;
            }
        })
        .catch(err => {
            console.error(err);
            btn.disabled = false;
            btn.innerHTML = original;
        });
    };
}

