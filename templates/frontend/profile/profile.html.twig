<!-- Modals Container at End of Body -->
{% for rec in reclamations %}
    <!-- Individual Modal for Reclamation -->
    <!-- Added data-bs-theme="dark" for explicit bootstrap dark mode style on modal -->
    <div class="modal fade" id="reclamationModal-{{ rec.id }}" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="background: #000000; border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 20px;">
                <div class="modal-header border-bottom border-light border-opacity-10 py-4 px-4">
                    <div class="d-flex flex-column gap-1">
                        {% set status_colors = {
                            'confirme': '#00e676',
                            'active': '#00e676',
                            'en_attente': '#ffeb3b',
                            'refuse': '#ff3b30',
                            'annule': '#9e9e9e',
                            'termine': '#4fc3f7'
                        } %}
                        {% set status_labels = {
                            'confirme': 'Confirmed',
                            'active': 'Active',
                            'en_attente': 'In Progress',
                            'refuse': 'Rejected',
                            'annule': 'Cancelled',
                            'termine': 'Completed'
                        } %}
                        <div class="d-flex align-items-center gap-2">
                             <span class="badge" style="background: {{ status_colors[rec.statutreclamation|default('en_attente')] }}15; color: {{ status_colors[rec.statutreclamation|default('en_attente')] }}; border: 1px solid {{ status_colors[rec.statutreclamation|default('en_attente')] }}30; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                                {{ status_labels[rec.statutreclamation|default('en_attente')] }}
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="modal-title text-white fw-bold mb-0">{{ rec.titrereclamations }}</h4>
                            {% if isAdmin %}
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 edit-reclamation-trigger" data-reclamation-id="{{ rec.id }}" style="font-size: 0.75rem; font-weight: 600; border-width: 1px; transition: all 0.2s;">
                                    <i class="bx bx-edit-alt"></i> Edit
                                </button>
                            {% endif %}
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white bg-white bg-opacity-10 p-2 rounded-circle w-auto h-auto" data-bs-dismiss="modal" aria-label="Close" style="opacity: 0.8; transition: all 0.2s;"></button>
                </div>
                <div class="modal-body p-0 scrollbar-hide">
                    <div class="p-4 border-bottom border-light border-opacity-10" style="background: rgba(255,255,255,0.01);">
                        <p class="mb-3 text-light opacity-90" style="font-size: 1.05rem; line-height: 1.6;">{{ rec.descreclamation }}</p>
                        
                        <!-- Images -->
                        {% if rec.decodedImages is defined and rec.decodedImages is not empty %}
                            <div class="d-flex gap-2 overflow-auto pb-2 scrollbar-hide">
                                {% for img in rec.decodedImages %}
                                    <a href="javascript:void(0)" onclick="openLightbox('{{ asset('reclamation_images/' ~ img) }}')" class="flex-shrink-0">
                                        <div class="position-relative group">
                                            <img src="{{ asset('reclamation_images/' ~ img) }}" class="rounded-3 border border-secondary border-opacity-25" style="height: 100px; width: 100px; object-fit: cover; transition: transform 0.2s;" loading="lazy">
                                            <div class="position-absolute inset-0 d-flex align-items-center justify-content-center bg-black bg-opacity-25 opacity-0 hover-opacity-100 rounded-3 transition-all">
                                                <i class='bx bx-zoom-in text-white fs-4'></i>
                                            </div>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                        
                        <div class="d-flex align-items-center gap-3 mt-2 text-secondary small">
                             <span><i class="bx bx-calendar"></i> {{ rec.createdAt is not null ? rec.createdAt|date('d M Y, H:i') : 'N/A' }}</span>
                             {% if rec.user %}
                                <span><i class="bx bx-user"></i> {{ rec.user.firstName }} {{ rec.user.lastName }}</span>
                             {% endif %}
                        </div>
                    </div>

                    <!-- Discussion Area -->
                    <div class="d-flex flex-column h-100" style="min-height: 300px; background: #000000;">
                        <div class="px-4 py-3 border-bottom border-light border-opacity-10" style="background: #000000;">
                            <h6 class="text-white mb-0 d-flex align-items-center gap-2">
                                <i class='bx bx-message-rounded-dots text-primary'></i> Discussion History
                            </h6>
                        </div>
                        
                        <div class="flex-grow-1 p-4 d-flex flex-column gap-3 scrollbar-hide" id="responses-list-{{ rec.id }}" style="max-height: 400px; overflow-y: auto;">
                            <!-- Responses injected via JS -->
                            <div class="text-center text-white-50 py-5">
                                <i class="bx bx-loader-alt bx-spin fs-3 mb-2"></i>
                                <p>Loading discussion...</p>
                            </div>
                        </div>

                        <!-- Reply Input Area -->
                        <div class="p-3 border-top border-light border-opacity-10" style="background: #000000;">
                            <form action="{{ path('api_reponse_add', {'id': rec.id}) }}" method="post" enctype="multipart/form-data" class="reponse-api-form" data-reclamation-id="{{ rec.id }}">
                                <div class="rounded-3 border border-secondary border-opacity-25 p-2" style="background: #000000;">
                                    <div class="d-flex align-items-start gap-2">
                                         <button type="button" class="btn btn-link text-secondary text-decoration-none p-0 mt-2" onclick="this.nextElementSibling.click()" title="Attach Image">
                                            <i class='bx bx-image-add fs-4'></i>
                                        </button>
                                        <input type="file" name="image" class="d-none" onchange="const preview = this.parentElement.nextElementSibling; const file = this.files[0]; if(file){ const reader = new FileReader(); reader.onload = function(e){ preview.innerHTML = `<img src='${e.target.result}' class='rounded-3 border border-secondary border-opacity-25' style='height: 60px; object-fit: cover;'> <button type='button' class='btn-close btn-close-white position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger p-1' onclick='this.parentElement.innerHTML=\'\'; this.parentElement.previousElementSibling.querySelector(\'input[type=file]\').value=\'\';'></button>`; preview.classList.remove('d-none'); }; reader.readAsDataURL(file); }">
                                        
                                        <div class="flex-grow-1 d-flex flex-column gap-1">
                                            <input type="text" name="title" class="form-control bg-transparent border-0 shadow-none p-0 px-2" placeholder="Title (optional)" style="font-size: 0.85rem; height: auto; color: white !important;">
                                            <textarea name="message" class="form-control bg-transparent border-0 shadow-none p-0 px-2" placeholder="Type a message..." rows="1" style="resize: none; min-height: 40px; color: white !important;" required></textarea>
                                        </div>
 
                                        <button type="submit" class="btn btn-primary rounded-3 px-3 py-2 fw-bold align-self-end"><i class='bx bx-send'></i></button>
                                    </div>
                                    <div class="position-relative d-none mt-2 px-2" id="image-preview-container-{{ rec.id }}"></div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if isAdmin %}
    <!-- Admin Edit Modal for Reclamation -->
    <div class="modal fade" id="adminEditReclamationModal-{{ rec.id }}" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(2px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="background: #0a0a0a; border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 20px;">
                <div class="modal-header border-bottom border-light border-opacity-10 py-3 px-4">
                    <h5 class="modal-title text-white fw-bold m-0"><i class="bx bx-edit-alt text-primary"></i> Edit Reclamation</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form action="{{ path('api_reclamation_update', {'id': rec.id}) }}" method="post" class="admin-reclamation-edit-form" data-reclamation-id="{{ rec.id }}">
                        <div class="mb-4">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Title</label>
                            <input type="text" name="title" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" value="{{ rec.titrereclamations }}" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Description</label>
                            <textarea name="description" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" rows="4" required>{{ rec.descreclamation }}</textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Status</label>
                            <select name="status" class="form-select bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3">
                                <option value="active" {{ rec.statutreclamation == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="en_attente" {{ rec.statutreclamation == 'en_attente' ? 'selected' : '' }}>In Progress</option>
                                <option value="refuse" {{ rec.statutreclamation == 'refuse' ? 'selected' : '' }}>Rejected</option>
                                <option value="termine" {{ rec.statutreclamation == 'termine' ? 'selected' : '' }}>Completed</option>
                            </select>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary px-4 py-2 rounded-pill fw-bold" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
{% endfor %}

{# --- Forum Publication Modals --- #}
{% for pub in publications %}
    <!-- View Publication Modal -->
    <div class="modal fade" id="publicationModal-{{ pub.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 overflow-hidden" style="background: #000; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 24px;">
                <div class="modal-header border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 45px; height: 45px; background: rgba(255, 255, 255, 0.05); border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255, 255, 255, 0.1);">
                            <i class="bx bx-message-square-dots" style="font-size: 1.4rem; color: #fff;"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white mb-0" style="font-size: 1.25rem;">{{ pub.titrePub }}</h5>
                            <span class="badge" style="background: rgba(255, 255, 255, 0.1); color: #fff; font-size: 0.7rem; text-transform: uppercase; border: 1px solid rgba(255, 255, 255, 0.1);">{{ pub.categoriePub }}</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        {% if isAdmin %}
                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#adminEditPublicationModal-{{ pub.id }}">
                                <i class="bx bx-edit-alt"></i> Edit
                            </button>
                        {% endif %}
                        <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label class="text-secondary small text-uppercase fw-bold mb-2 d-block">Publication Details</label>
                        <p class="text-white-50 leading-relaxed">{{ pub.descriptionPub }}</p>
                        
                        {% if pub.imagePub %}
                            <div class="mt-3">
                                <img src="{{ asset('forum_images/' ~ pub.imagePub) }}" alt="Publication Image" 
                                     style="max-width: 100%; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); cursor: pointer;"
                                     onclick="openLightbox(this.src)">
                            </div>
                        {% endif %}
                    </div>

                    <div class="discussion-section">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <label class="text-secondary small text-uppercase fw-bold m-0"><i class="bx bx-comment-detail"></i> Discussion</label>
                            <span class="text-white-50 small" id="comments-count-{{ pub.id }}">...</span>
                        </div>
                        <div id="comments-list-{{ pub.id }}" class="scrollbar-hide" style="max-height: 400px; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; padding-right: 5px;">
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <p class="text-muted small mt-2">Loading discussion...</p>
                            </div>
                        </div>
                        
                        <!-- Add Comment form -->
                        <div class="mt-4 pt-4 border-top border-white border-opacity-10">
                            <form class="comment-submission-form" data-publication-id="{{ pub.id }}" action="{{ path('forum_comment_add', {'id': pub.id}) }}" method="post" enctype="multipart/form-data">
                                <div class="d-flex gap-3 align-items-start w-100">
                                    <div style="flex: 1;">
                                        <div class="d-flex align-items-start gap-2 mb-2">
                                            <button type="button" class="btn btn-link text-secondary text-decoration-none p-0 mt-2" onclick="this.nextElementSibling.click()" title="Attach Image">
                                                <i class='bx bx-image-add fs-4'></i>
                                            </button>
                                            <input type="file" name="image_commentaire" class="d-none" onchange="window.handleForumImagePreview(this, {{ pub.id }})">
                                            
                                            <textarea name="description" class="form-control bg-dark border border-white border-opacity-10 text-white p-3 rounded-4 shadow-none flex-grow-1" 
                                                      placeholder="Add a comment..." rows="2" style="resize: none;"></textarea>
                                        </div>
                                        <div class="position-relative d-none mb-3 px-2" id="forum-image-preview-{{ pub.id }}" style="width: fit-content;"></div>
                                        <div class="d-flex align-items-center justify-content-between mt-2">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" name="visibility" id="anon-{{ pub.id }}" checked>
                                                <label class="form-check-label text-secondary small" for="anon-{{ pub.id }}">Public</label>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-sm px-4 py-2 rounded-pill fw-bold">Send message</button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Edit Publication Modal -->
    {% if isAdmin %}
    <div class="modal fade" id="adminEditPublicationModal-{{ pub.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0" style="background: #000; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 20px;">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-bold text-white"><i class="bx bx-edit"></i> Edit Publication #{{ pub.id }}</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form class="admin-publication-edit-form" data-publication-id="{{ pub.id }}" action="{{ path('api_forum_publication_update', {'id': pub.id}) }}">
                        <div class="mb-3">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Title</label>
                            <input type="text" name="title" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" value="{{ pub.titrePub }}" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Description</label>
                            <textarea name="description" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" rows="4" required>{{ pub.descriptionPub }}</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Category</label>
                            <select name="category" class="form-select bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3">
                                {% for cat in ['Announcement', 'Suggestion', 'Jeux Video', 'Informatique', 'Nouveauté', 'Discussion General', 'Culture', 'Sport'] %}
                                    <option value="{{ cat }}" {{ pub.categoriePub == cat ? 'selected' : '' }}>{{ cat }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary px-4 py-2 rounded-pill fw-bold" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
{% endfor %}    <!-- Event View Modal -->
    <div class="modal fade" id="eventViewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary border-opacity-25 text-white shadow-lg" style="border-radius: 24px; overflow: hidden;">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-bold fs-4">Event Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-md-5">
                            <div id="event-modal-image-container" class="rounded-4 overflow-hidden shadow-sm" style="height: 250px; background: rgba(255,255,255,0.05);">
                                <img id="event-modal-image" src="" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h2 id="event-modal-title" class="fw-bold mb-0"></h2>
                                <span id="event-modal-status" class="status-badge" style="padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.8rem; font-weight: 700;"></span>
                            </div>
                            <div class="d-flex flex-wrap gap-3 mb-4 text-secondary">
