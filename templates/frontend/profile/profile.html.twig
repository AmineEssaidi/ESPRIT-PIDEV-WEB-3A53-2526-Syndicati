                                    <i class="bx bx-edit-alt me-2"></i>Edit Event
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Event Edit Modal -->
    <div class="modal fade" id="eventEditModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary border-opacity-25 text-white shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 p-4">
                    <h5 class="modal-title fw-bold">Edit Event</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <form id="event-edit-form" enctype="multipart/form-data">
                        <input type="hidden" name="id" id="edit-event-id">
                        <div class="mb-3">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Title</label>
                            <input type="text" name="titre_event" id="edit-event-title" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Description</label>
                            <textarea name="description_event" id="edit-event-description" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" rows="3" required></textarea>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Date</label>
                                <input type="datetime-local" name="date_event" id="edit-event-date" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Location</label>
                                <input type="text" name="lieu_event" id="edit-event-location" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" required>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Total</label>
                                <input type="number" name="nb_places" id="edit-event-places" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" min="0">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Remaining</label>
                                <input type="number" name="nb_restants" id="edit-event-remaining" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" min="0">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Type</label>
                                <select name="type_event" id="edit-event-type" class="form-select bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3">
                                    {% for type in ['reunion', 'social', 'formation', 'maintenance', 'culturel', 'sportif'] %}
                                        <option value="{{ type }}">{{ type|title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Status</label>
                            <select name="statut_event" id="edit-event-status" class="form-select bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3">
                                {% for status in ['planifie', 'en_cours', 'termine', 'annule'] %}
                                    <option value="{{ status }}">{{ status|replace({'_': ' '})|title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small text-uppercase fw-bold mb-2">Image</label>
                            <input type="file" name="image_event" id="edit-event-image" class="form-control bg-dark border-secondary border-opacity-25 text-white p-3 rounded-3" accept="image/*">
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
