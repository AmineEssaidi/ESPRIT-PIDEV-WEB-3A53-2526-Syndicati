                        <div style="width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,0.2);"></div>
                        <span class="text-white-50 small d-flex align-items-center gap-1 fw-medium" style="letter-spacing: 0.5px;"><i class="bx bx-calendar-alt fs-6"></i> ${date}</span>
                    </div>
                    <h2 class="text-white fw-bold mb-0" style="font-size: 2.4rem; letter-spacing: -1px; line-height: 1.1;">${title}</h2>
                </div>
                
                <!-- Main Narrative -->
                <div class="mb-5">
                    <p class="text-light opacity-80" style="line-height: 1.9; font-size: 1.15rem; white-space: pre-wrap; letter-spacing: 0.2px;">${desc}</p>
                    ${img ? `
                        <div class="mt-5 rounded-4 overflow-hidden position-relative group shadow-2xl" style="border: 1px solid rgba(255,255,255,0.1); max-height: 450px;">
                            <img src="${img}" style="width: 100%; height: 100%; object-fit: cover; cursor: zoom-in; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);" onclick="openLightbox(this.src)" class="pub-detail-img" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'">
                            <div class="position-absolute bottom-0 start-0 w-100 p-4 bg-gradient-to-t from-black/60 to-transparent pointer-events-none">
                                <span class="text-white-50 small"><i class="bx bx-expand-alt me-1"></i> Click to enlarge view</span>
                            </div>
