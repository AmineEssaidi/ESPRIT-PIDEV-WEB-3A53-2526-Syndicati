                                    </div>

                                    <div id="hero-panel-settings" class="hero-panel" style="display:none;">
                                        <div class="hero-panel-topbar">
                                            <button type="button" class="hero-panel-back"><i class="bx bx-arrow-back"></i></button>
                                            <span><i class="bx bx-cog"></i> Profile Settings</span>
                                        </div>
                                        <div class="hero-panel-scrollable">
                                            {% if profileForm is defined %}
                                            {{ form_start(profileForm, { 'attr': { 'id': 'profile-settings-form', 'class': '', 'data-ajax': 'true' } }) }}
                                            
                                            {# AVATAR SECTION IN HERO #}
                                            <div class="glass-avatar-section mb-4" style="text-align: center;">
                                                <div class="glass-avatar-wrapper mx-auto" onclick="document.getElementById('profile_avatarFile').click()" style="width: 100px; height: 100px; border-radius: 30px; position: relative; overflow: hidden; cursor: pointer; border: 2px solid rgba(255,255,255,0.1);">
                                                    {% if profile.avatar %}
                                                        <img src="{{ asset(profile.avatar) }}" alt="Avatar" id="hero-avatar-preview" style="width:100%; height:100%; object-fit:cover;">
                                                    {% else %}
                                                        <img src="https://ui-avatars.com/api/?name={{ user.firstName }}+{{ user.lastName }}&background=random" alt="Avatar" id="hero-avatar-preview" style="width:100%; height:100%; object-fit:cover;">
                                                    {% endif %}
                                                    <div class="glass-avatar-overlay" style="position: absolute; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity 0.2s;">
                                                        <i class="bx bx-camera" style="font-size: 1.5rem; color:#fff;"></i>
                                                    </div>
                                                </div>
                                                <style>.glass-avatar-wrapper:hover .glass-avatar-overlay { opacity: 1 !important; }</style>
                                                <div style="font-size: 0.75rem; color: rgba(255,255,255,0.5); margin-top: 0.5rem;">Click to change avatar</div>
                                                {{ form_widget(profileForm.avatarFile, {'attr': {'id': 'profile_avatarFile', 'class': 'd-none', 'accept': 'image/*', 'onchange': 'if(typeof previewAvatar === "function") previewAvatar(this, "hero-avatar-preview")'}}) }}
                                            </div>

                                            <div class="glass-form-group mb-2">
                                                {{ form_label(profileForm.description_profile, 'Bio', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                {{ form_widget(profileForm.description_profile, { 'attr': { 'class': 'glass-textarea', 'placeholder': 'Tell us a bit about yourself...' } }) }}
                                                <div id="description_profile-validation" data-field="description_profile" class="main-home-validation-message"></div>
                                            </div>
                                            <div class="row g-2 mb-2">
                                                <div class="col-12">
                                                    {{ form_label(profileForm.phone, 'Phone', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                    {{ form_widget(profileForm.phone, { 'attr': { 'class': 'glass-input' } }) }}
                                                    <div id="phone-validation" data-field="phone" class="main-home-validation-message"></div>
                                                </div>
                                            </div>
                                            <div class="row g-2 mb-2">
                                                <div class="col-4">
                                                    {{ form_label(profileForm.theme, 'Theme', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                    {{ form_widget(profileForm.theme, { 'attr': { 'class': 'glass-select' } }) }}
                                                </div>
                                                <div class="col-4">
                                                    {{ form_label(profileForm.locale, 'Language', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                    {{ form_widget(profileForm.locale, { 'attr': { 'class': 'glass-select' } }) }}
                                                </div>
                                                <div class="col-4">
                                                    {{ form_label(profileForm.timezone, 'Timezone', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                    {{ form_widget(profileForm.timezone, { 'attr': { 'class': 'glass-input' } }) }}
                                                </div>
                                            </div>
                                            <div class="glass-section-title" style="font-size:0.8rem; margin-bottom:0.5rem;"><i class="bx bx-shield-quarter"></i> Security</div>
                                            <div class="glass-form-group mb-2">
                                                {{ form_label(profileForm.currentPassword, 'Current Password', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                {{ form_widget(profileForm.currentPassword, { 'attr': { 'class': 'glass-input', 'placeholder': 'Required to change password' } }) }}
                                                <div id="currentPassword-validation" data-field="currentPassword" class="main-home-validation-message"></div>
                                            </div>
                                            <div class="row g-2 mb-3">
                                                <div class="col-6">
                                                    {{ form_label(profileForm.newPassword.first, 'New Password', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                    {{ form_widget(profileForm.newPassword.first, { 'attr': { 'class': 'glass-input', 'minlength': '6' } }) }}
                                                    <div id="newPassword_first-validation" data-field="first" class="main-home-validation-message"></div>
                                                </div>
                                                <div class="col-6">
                                                    {{ form_label(profileForm.newPassword.second, 'Confirm', { 'label_attr': { 'class': 'glass-label' } }) }}
                                                    {{ form_widget(profileForm.newPassword.second, { 'attr': { 'class': 'glass-input', 'data-match': 'first' } }) }}
                                                    <div id="newPassword_second-validation" data-field="second" class="main-home-validation-message"></div>
                                                </div>
                                            </div>
                                            <div style="display:flex; gap:0.75rem; justify-content:flex-end;">
                                                <button type="submit" id="hero-settings-save" class="hero-panel-primary-btn" style="width:auto; padding:0.6rem 1.5rem;">
                                                    <i class="bx bx-save"></i> Save Changes
                                                </button>
                                            </div>
                                            {{ form_end(profileForm) }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- Discord Style Standing & Circle Row -->
                    <div class="row g-4 mb-5">
                        <div class="col-lg-7">
                            <div class="main-home-profile-card h-100">
                                <div class="standing-header-flex">
                                    <div class="standing-lvl-box">
                                        <div class="standing-lvl-num">{{ userStanding.level }}</div>
                                        <div class="standing-lvl-txt">LVL</div>
                                    </div>
                                    <div>
                                        <h4 class="text-white fw-900 mb-1" style="letter-spacing: 1px;">RESIDENT STANDING</h4>
                                        <p class="text-muted small mb-0">Your status within the Horizon community</p>
                                    </div>
                                    <div class="ms-auto text-end">
                                        <div class="text-white fw-900 h3 mb-0">{{ userStanding.points }}</div>
                                        <div class="text-muted small fw-bold" style="letter-spacing: 1px;">SYNDIC PTS</div>
                                    </div>
                                </div>

                                <div class="discord-standing-container">
                                    <div class="discord-standing-bar">
                                        {# Track #}
                                        <div class="standing-track">
                                            {% set progressWidth = 0 %}
                                            {% set trackColor = '#43b581' %}
                                            {% if userStanding.standingLabel == 'NORMAL' %} 
                                                {% set progressWidth = 0 %}
                                                {% set trackColor = '#43b581' %}
                                            {% elseif userStanding.standingLabel == 'WARNED' %} 
                                                {% set progressWidth = 33.33 %}
                                                {% set trackColor = '#faa61a' %}
                                            {% elseif userStanding.standingLabel == 'SUSPENDED' %} 
                                                {% set progressWidth = 66.66 %}
                                                {% set trackColor = '#f04747' %}
                                            {% elseif userStanding.standingLabel == 'BANNED' %} 
                                                {% set progressWidth = 100 %}
                                                {% set trackColor = '#f04747' %}
                                            {% endif %}
                                            <div class="standing-track-fill" style="width: {{ progressWidth }}%; background: {{ trackColor }};"></div>
                                        </div>

                                        {# Steps #}
                                        <div class="standing-point-wrapper active-state">
                                            <div class="standing-point active success">
                                                <i class="bx bx-check"></i>
                                            </div>
                                            <span class="standing-point-label">All good!</span>
                                        </div>

                                        <div class="standing-point-wrapper {{ userStanding.standingLabel in ['WARNED', 'SUSPENDED', 'BANNED'] ? 'active-state' : '' }}">
                                            <div class="standing-point {{ userStanding.standingLabel in ['WARNED', 'SUSPENDED', 'BANNED'] ? 'active warning' : '' }}">
                                                <i class="bx bx-error-alt"></i>
                                            </div>
                                            <span class="standing-point-label">Limited</span>
                                        </div>

                                        <div class="standing-point-wrapper {{ userStanding.standingLabel in ['SUSPENDED', 'BANNED'] ? 'active-state' : '' }}">
                                            <div class="standing-point {{ userStanding.standingLabel in ['SUSPENDED', 'BANNED'] ? 'active danger' : '' }}">
                                                <i class="bx bx-shield-x"></i>
                                            </div>
                                            <span class="standing-point-label">At risk</span>
                                        </div>

                                        <div class="standing-point-wrapper {{ userStanding.standingLabel == 'BANNED' ? 'active-state' : '' }}">
                                            <div class="standing-point {{ userStanding.standingLabel == 'BANNED' ? 'active danger' : '' }}">
                                                <i class="bx bx-x"></i>
                                            </div>
                                            <span class="standing-point-label">Suspended</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 pt-4 border-top border-white-5">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted small fw-bold" style="letter-spacing: 1px;">XP TOWARDS LEVEL {{ userStanding.level + 1 }}</span>
                                        <span class="text-white fw-bold small">{{ userStanding.points % 100 }}/100</span>
                                    </div>
                                    <div class="mt-2" style="height: 8px; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.03);">
                                        <div style="width: {{ userStanding.points % 100 }}%; height: 100%; background: var(--main-home-accent-gradient); box-shadow: 0 0 15px rgba(var(--main-home-accent-rgb), 0.4);"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="main-home-profile-card h-100">
                                {# ── Circle Header ── #}
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h5 class="text-white fw-800 mb-0" style="letter-spacing: 0.5px;">CIRCLE</h5>
                                    <div class="d-flex gap-2 ms-auto">
                                        <span class="glass-badge glass-badge-info" id="circle-friends-badge" style="padding: 0.2rem 0.6rem; font-size: 0.65rem;">{{ friendCount }} FRIENDS</span>
                                        {% if pendingFriendCount > 0 %}
                                            <span class="glass-badge glass-badge-danger animate-pulse" id="circle-pending-badge" style="padding: 0.2rem 0.6rem; font-size: 0.65rem; cursor: pointer;" onclick="circleSetTab('pending')">{{ pendingFriendCount }} PENDING</span>
                                        {% endif %}
                                    </div>
                                </div>

                                {# ── Tab Switcher ── #}
                                <div class="d-flex gap-2 mb-4" id="circle-tab-switcher">
                                    <button class="circle-tab-btn active" id="circle-tab-friends" onclick="circleSetTab('friends')" style="flex: 1; padding: 0.5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: var(--syndicat-accent-gradient); color: #fff; font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; cursor: pointer; transition: all .2s;">
                                        <i class="bx bx-group me-1"></i> Friends
                                    </button>
                                    <button class="circle-tab-btn" id="circle-tab-pending" onclick="circleSetTab('pending')" style="flex: 1; padding: 0.5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.5); font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; cursor: pointer; transition: all .2s;">
                                        <i class="bx bx-bell me-1"></i> Pending{% if pendingFriendCount > 0 %} <span style="background: #f04747; color: #fff; border-radius: 20px; padding: 0 5px; font-size: 0.65rem;">{{ pendingFriendCount }}</span>{% endif %}
                                    </button>
                                </div>

                                {# ── Friends Panel ── #}
                                <div id="circle-panel-friends">
                                    <div class="friends-grid-platinum">
                                        {% for friend in sampleFriends %}
                                            {% set fav = friendAvatarMap[friend.idUser] ?? null %}
                                            <a href="#" class="friend-card-platinum"
                                               data-user-id="{{ friend.idUser }}"
                                               data-name="{{ friend.firstName }} {{ friend.lastName }}"
                                               title="{{ friend.firstName }} {{ friend.lastName }}">
                                                <div class="friend-avatar-platinum">
                                                    {% if fav %}
                                                        <img src="{{ fav starts with 'http' ? fav : asset(fav) }}" alt="{{ friend.firstName }}">
                                                    {% else %}
                                                        <img src="{{ 'https://ui-avatars.com/api/?name=' ~ friend.firstName|url_encode ~ '+' ~ friend.lastName|url_encode ~ '&background=random&color=fff&bold=true' }}" alt="{{ friend.firstName }}">
                                                    {% endif %}
                                                </div>
                                                <span class="friend-name-platinum">{{ friend.firstName }}</span>
                                            </a>
                                        {% else %}
                                            <div class="py-5 text-center w-100">
                                                <i class="bx bx-user-plus mb-3 d-block" style="font-size: 3.5rem; opacity: 0.05; color: #fff;"></i>
                                                <p class="text-muted small mb-0 fw-600">No active connections yet.</p>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>

                                {# ── Pending Panel ── #}
                                <div id="circle-panel-pending" style="display: none;">
                                    {% if pendingRequests is empty %}
                                        <div class="py-5 text-center">
                                            <i class="bx bx-check-circle mb-3 d-block" style="font-size: 3.5rem; opacity: 0.05; color: #fff;"></i>
                                            <p class="text-muted small mb-0 fw-600">No pending requests.</p>
                                        </div>
                                    {% else %}
                                        <div class="d-flex flex-column gap-2" id="pending-requests-list">
                                            {% for rel in pendingRequests %}
                                                {% set sender = rel.status == 'PENDING_FIRST_SECOND' ? rel.userFirst : rel.userSecond %}
                                                {% set sav = pendingAvatarMap[sender.idUser] ?? null %}
                                                <div class="pending-request-row d-flex align-items-center gap-3" data-rel-id="{{ rel.id }}" style="padding: 0.75rem; border-radius: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);">
                                                    <img src="{% if sav %}{{ sav starts with 'http' ? sav : asset(sav) }}{% else %}{{ 'https://ui-avatars.com/api/?name=' ~ sender.firstName|url_encode ~ '+' ~ sender.lastName|url_encode ~ '&background=random&color=fff&bold=true' }}{% endif %}"
                                                         alt="{{ sender.firstName }}"
                                                         style="width: 42px; height: 42px; border-radius: 12px; object-fit: cover; flex-shrink: 0;">
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <div class="text-white fw-700" style="font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ sender.firstName }} {{ sender.lastName }}</div>
                                                        <div class="text-muted" style="font-size: 0.7rem;">Wants to connect</div>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0">
                                                        <button class="btn-accept-request" data-rel-id="{{ rel.id }}" title="Accept"
                                                            style="width: 32px; height: 32px; border-radius: 10px; border: none; background: rgba(67,181,129,0.2); color: #43b581; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; transition: all .2s;">
                                                            <i class="bx bx-check"></i>
                                                        </button>
                                                        <button class="btn-decline-request" data-rel-id="{{ rel.id }}" title="Decline"
                                                            style="width: 32px; height: 32px; border-radius: 10px; border: none; background: rgba(240,71,71,0.15); color: #f04747; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; transition: all .2s;">
                                                            <i class="bx bx-x"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>

                                {# ── Search Section ── #}
                                <div class="mt-4 pt-4 border-top border-white-5 resident-search-container">
                                    <div class="search-trigger-wrapper">
                                        <button class="main-home-btn-auth-submit w-100 btn-resident-search-trigger" style="padding: 1rem; font-size: 0.85rem; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px; font-weight: 800;">
                                            <i class="bx bx-search-alt me-2"></i> Explore Community
                                        </button>
                                    </div>
                                    <div class="search-input-wrapper d-none">
                                        <div class="position-relative">
                                            <input type="text" class="form-control resident-search-input" placeholder="Search by name..."
                                                   style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; color: #fff; padding: 1rem 3rem 1rem 1.5rem; font-size: 0.9rem;">
                                            <i class="bx bx-x position-absolute btn-search-close" style="right: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 1.5rem; cursor: pointer; color: rgba(255,255,255,0.3);"></i>
                                        </div>
                                        <div class="search-results-dropdown-platinum mt-3">
                                            <!-- Results will appear here -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </div>

                <div id="profile-main-page-2" class="profile-main-page">
                    <!-- Sick Pagination Navigation -->
                    <div class="row mb-5">
                    <div class="col-12">
                        <div class="profile-nav-container">
                            <div class="profile-nav-pill active" data-tab="account">
                                <i class="bx bx-user"></i> Account
                            </div>
                            <div class="profile-nav-pill" data-tab="forum">
                                <i class="bx bx-message-square-detail"></i> Forum
                            </div>
                            <div class="profile-nav-pill" data-tab="events">
                                <i class="bx bx-calendar-event"></i> Events
                            </div>
                            <div class="profile-nav-pill" data-tab="reclamation">
                                <i class="bx bx-error-alt"></i> Reclamation
                            </div>
                            <div class="profile-nav-pill" data-tab="residence">
                                <i class="bx bx-building-house"></i> Residence
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Page 1 (Account & Onboarding) -->
                <div id="tab-account" class="profile-tab-content active">
                    <!-- Account info (from user + profile: Bio, Timezone) -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="main-home-profile-card mb-4">
                            <div class="main-home-card-header">
                                <h3 class="main-home-card-title"><i class="bx bx-user"></i> Account</h3>
                            </div>
                            <div class="main-home-card-content">
                                <dl class="row mb-0">
                                    <dt class="col-sm-3">First name</dt>
                                    <dd class="col-sm-9">{{ user.firstName }}</dd>
                                    <dt class="col-sm-3">Last name</dt>
                                    <dd class="col-sm-9">{{ user.lastName }}</dd>
                                    <dt class="col-sm-3">Email</dt>
                                    <dd class="col-sm-9">{{ user.emailUser }}</dd>
                                    <dt class="col-sm-3">Role</dt>
                                    <dd class="col-sm-9">{{ user.roleUser }}</dd>
                                    <dt class="col-sm-3">Verified</dt>
                                    <dd class="col-sm-9">{{ user.isVerified ? 'Yes' : 'No (pending admin)' }}</dd>
                                    <dt class="col-sm-3">Account created</dt>
                                    <dd class="col-sm-9">{{ user.createdAt|date('d/m/Y H:i') }}</dd>
