<script>
window.handleForumImagePreview = function(input, publicationId) {
    const preview = document.getElementById(`forum-image-preview-${publicationId}`);
    const file = input.files[0];
    if (file && preview) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML = `
                <div class="position-relative d-inline-block">
                    <img src="${e.target.result}" class="rounded-3 border border-white border-opacity-10" style="height: 60px; width: 60px; object-fit: cover;">
                    <button type="button" class="btn btn-danger btn-sm p-0 d-flex align-items-center justify-content-center position-absolute" 
                            style="top: -8px; right: -8px; width: 22px; height: 22px; border-radius: 50%; z-index: 999; border: 2px solid #000;"
                            onclick="window.removeForumImage(${publicationId})" title="Remove Image">
                        <i class='bx bx-x' style='font-size: 16px;'></i>
                    </button>
                </div>
            `;
            preview.classList.remove('d-none');
        };
        reader.readAsDataURL(file);
    }
};

window.removeForumImage = function(publicationId) {
    const preview = document.getElementById(`forum-image-preview-${publicationId}`);
    if (preview) {
        preview.innerHTML = '';
        preview.classList.add('d-none');
        const form = preview.closest('form');
        if (form) {
            const fileInput = form.querySelector('input[type="file"]');
            if (fileInput) fileInput.value = '';
        }
    }
};

document.addEventListener('DOMContentLoaded', function() {
    const currentUserId = {{ user.idUser|default('0') }};
    const isAdmin = {{ isAdmin ? 'true' : 'false' }};
    let currentAdminFilter = isAdmin ? 'all' : 'my';
    let currentResidenceFilter = isAdmin ? 'all' : 'my';


    // Pagination & Filtering Variables
    const itemsPerPage = 3;
    const allReclamationItems = Array.from(document.querySelectorAll('.reclamation-item'));
    const paginationContainer = document.getElementById('reclamation-pagination');


    window.initializeReclamationPagination = function() {
        try {
            // console.log("Initializing Reclamation Pagination. Filter:", currentAdminFilter);
            
            // 1. Filter items
            const filteredItems = allReclamationItems.filter(item => {
                if (currentAdminFilter === 'all') return true;
                const itemUserId = String(item.dataset.userId);
                const currentId = String(currentUserId);
                return itemUserId === currentId;
            });


            // 2. Hide all items initially
            allReclamationItems.forEach(item => {
                item.style.display = 'none';
                item.classList.remove('active');
            });

            if (filteredItems.length === 0) {
                if (paginationContainer) paginationContainer.innerHTML = '';
                return;
            }

            // 3. Simple Display if no pagination needed
            if (!paginationContainer || filteredItems.length <= itemsPerPage) {
                if (paginationContainer) paginationContainer.innerHTML = '';
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            // 4. Advanced Pagination
            const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
            paginationContainer.innerHTML = '';
            
            function showPage(page) {
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;
                
                filteredItems.forEach((item, idx) => {
                    if (idx >= start && idx < end) {
                        item.style.display = 'block';
                        setTimeout(() => item.classList.add('active'), 10);
                    } else {
                        item.style.display = 'none';
                        item.classList.remove('active');
                    }
                });

                paginationContainer.querySelectorAll('.pagination-pill').forEach(pill => {
                    pill.classList.toggle('active', parseInt(pill.dataset.page) === page);
                });
            }

            for (let i = 1; i <= totalPages; i++) {
                const pill = document.createElement('div');
                pill.className = 'pagination-pill';
                pill.textContent = i;
                pill.dataset.page = i;
                if (i === 1) pill.classList.add('active');
                
                pill.addEventListener('click', () => {
                    showPage(i);
                    document.getElementById('tab-reclamation').scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                
                paginationContainer.appendChild(pill);
            }

            showPage(1);
        } catch (e) { console.error("Reclamation Pagination Error:", e); }
    };

    // Initial load
    if (typeof window.initializeReclamationPagination === 'function') {
        window.initializeReclamationPagination();
    }

    // --- Forum: My Posts Pagination ---
    const allMyForumItems = Array.from(document.querySelectorAll('.my-publication-item'));
    const myForumPaginationContainer = document.getElementById('forum-my-posts-pagination');
    let currentForumAdminFilter = isAdmin ? 'all' : 'my';

    window.initializeMyPostsPagination = function() {
        try {
            const filteredItems = allMyForumItems.filter(item => {
                if (currentForumAdminFilter === 'all') return true;
                return item.dataset.userId == currentUserId;
            });

            allMyForumItems.forEach(item => {
                item.style.display = 'none';
                item.classList.remove('active');
            });

            if (!myForumPaginationContainer) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            myForumPaginationContainer.innerHTML = '';
            if (filteredItems.length === 0) return;

            if (filteredItems.length <= itemsPerPage) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
            function showPage(page) {
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;
                filteredItems.forEach(item => { item.style.display = 'none'; item.classList.remove('active'); });
                filteredItems.slice(start, end).forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                myForumPaginationContainer.querySelectorAll('.pagination-pill').forEach(pill => {
                    pill.classList.toggle('active', parseInt(pill.dataset.page) === page);
                });
            }

            for (let i = 1; i <= totalPages; i++) {
                const pill = document.createElement('div');
                pill.className = 'pagination-pill';
                pill.textContent = i;
                pill.dataset.page = i;
                if (i === 1) pill.classList.add('active');
                pill.addEventListener('click', () => { showPage(i); document.getElementById('tab-forum').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
                myForumPaginationContainer.appendChild(pill);
            }
            showPage(1);
        } catch (e) { console.error("My Posts Pagination Error:", e); }
    };

    // --- Forum: Bookmarked Posts Pagination ---
    const allBookmarkedForumItems = Array.from(document.querySelectorAll('.bookmarked-publication-item'));
    const bookmarkedPaginationContainer = document.getElementById('forum-bookmarked-pagination');

    window.initializeBookmarkedPagination = function() {
        try {
            // Bookmarks are NOT filtered by user ID (they belong to current user anyway)
            const filteredItems = allBookmarkedForumItems;

            allBookmarkedForumItems.forEach(item => {
                item.style.display = 'none';
                item.classList.remove('active');
            });

            if (!bookmarkedPaginationContainer) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            bookmarkedPaginationContainer.innerHTML = '';
            if (filteredItems.length === 0) return;

            if (filteredItems.length <= itemsPerPage) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
            function showPage(page) {
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;
                filteredItems.forEach(item => { item.style.display = 'none'; item.classList.remove('active'); });
                filteredItems.slice(start, end).forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                bookmarkedPaginationContainer.querySelectorAll('.pagination-pill').forEach(pill => {
                    pill.classList.toggle('active', parseInt(pill.dataset.page) === page);
                });
            }

            for (let i = 1; i <= totalPages; i++) {
                const pill = document.createElement('div');
                pill.className = 'pagination-pill';
                pill.textContent = i;
                pill.dataset.page = i;
                if (i === 1) pill.classList.add('active');
                pill.addEventListener('click', () => { showPage(i); document.getElementById('tab-forum').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
                bookmarkedPaginationContainer.appendChild(pill);
            }
            showPage(1);
        } catch (e) { console.error("Bookmarked Pagination Error:", e); }
    };

    window.initializeMyPostsPagination();
    window.initializeBookmarkedPagination();
    
    // --- Forum Sub-nav Switching Logic ---
    const forumSubNavPills = document.querySelectorAll('.forum-sub-nav-pill');
    const forumContentSections = document.querySelectorAll('.forum-content-section');

    forumSubNavPills.forEach(pill => {
        pill.addEventListener('click', function() {
            const targetTab = this.dataset.forumTab;
            
            // Update pills
            forumSubNavPills.forEach(p => p.classList.remove('active'));
            this.classList.add('active');
            
            // Update sections
            forumContentSections.forEach(section => {
                section.classList.remove('active');
