                    ` : ''}
                </div>
                
                <!-- Obsidian Action Center -->
                <div id="splitViewActionBar" class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 rounded-4 mb-5 position-relative overflow-hidden" style="background: rgba(30, 30, 35, 0.95); border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-gradient-to-br from-white/5 to-transparent pointer-events-none"></div>
                    
                    <div class="d-flex align-items-center gap-3 ps-2 position-relative z-1">
                        <button class="btn btn-icon reaction-btn btn-like d-flex align-items-center justify-content-center text-white-50 hover-text-success rounded-circle" style="width: 48px; height: 48px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);" onclick="window.toggleReaction('Like')" title="Appreciate">
                            <i class='bx bx-like fs-4'></i> <span class="count ms-1 fw-bold fs-6"></span>
                        </button>
                        <button class="btn btn-icon reaction-btn btn-dislike d-flex align-items-center justify-content-center text-white-50 hover-text-danger rounded-circle" style="width: 48px; height: 48px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);" onclick="window.toggleReaction('Dislike')" title="Criticize">
                            <i class='bx bx-dislike fs-4'></i> <span class="count ms-1 fw-bold fs-6"></span>
