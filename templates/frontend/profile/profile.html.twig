<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <script src="{{ asset('frontend/js/global-settings.js') }}"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil - PiDev</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('frontend/css/main-home.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/glass-modal.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/scroll-pill.css') }}" rel="stylesheet">
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    <style>
        /* Clickable avatar upload */
        .profile-avatar-form { display: block; margin: 0; padding: 0; }
        .profile-avatar-file-input { position: absolute; width: 0.1px; height: 0.1px; opacity: 0; overflow: hidden; z-index: -1; }
        .main-home-profile-avatar-clickable { display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; }
        .main-home-profile-avatar-clickable:hover .profile-avatar-upload-hint { opacity: 1; }
        .profile-avatar-upload-hint { position: absolute; inset: 0; background: rgba(0,0,0,0.5); color: #fff; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; gap: 0.35rem; opacity: 0; transition: opacity 0.2s; border-radius: 50%; }
        .profile-onboarding-pill { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.75rem 1rem; background: rgba(255,255,255,0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); }
        .profile-onboarding-pill-label { font-size: 0.8rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.05em; }
        .profile-onboarding-pill-value { font-size: 1rem; font-weight: 600; color: rgba(255,255,255,0.95); }
        .profile-onboarding-preferences-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.5rem; }
        .profile-onboarding-pref-item { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.5rem 0.75rem; background: rgba(255,255,255,0.04); border-radius: 8px; font-size: 0.9rem; }
        .profile-onboarding-pref-key { color: rgba(255,255,255,0.6); text-transform: capitalize; }
        .profile-onboarding-pref-value { color: rgba(255,255,255,0.9); font-weight: 500; }
        .profile-onboarding-suggestions-text { margin: 0; padding: 0.75rem 1rem; background: rgba(255,255,255,0.04); border-radius: 8px; color: rgba(255,255,255,0.85); font-size: 0.95rem; line-height: 1.5; }
        [data-theme="light"] .profile-onboarding-pill { background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.08); }
        [data-theme="light"] .profile-onboarding-pill-label { color: #64748b; }
        [data-theme="light"] .profile-onboarding-pill-value { color: #1e293b; }
        [data-theme="light"] .profile-onboarding-pref-item { background: rgba(0,0,0,0.03); }
        [data-theme="light"] .profile-onboarding-pref-key { color: #64748b; }
        [data-theme="light"] .profile-onboarding-pref-value { color: #1e293b; }
        [data-theme="light"] .profile-onboarding-suggestions-text { background: rgba(0,0,0,0.04); color: #334155; }
        [data-theme="light"] #profile-onboarding-modal .ob-textarea { background: #fff; border-color: #e2e8f0; color: #1e293b; }

        /* Hide scrollbar for Chrome, Safari and Opera */
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        /* Hide scrollbar for IE, Edge and Firefox */
        .scrollbar-hide {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }

        /* Sick Pagination Styles */
        .profile-nav-container {
            margin: 2rem 0;
            display: flex;
            justify-content: center;
            gap: 0.75rem;
            padding: 0.6rem;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 100px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            width: fit-content;
            margin-left: auto;
            margin-right: auto;
        }

        .profile-nav-pill {
            padding: 0.8rem 1.8rem;
            border-radius: 100px;
            color: rgba(255, 255, 255, 0.5);
            font-weight: 700;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid transparent;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 0.75rem;
            font-family: 'Inter', sans-serif;
            white-space: nowrap;
        }

        .profile-nav-pill i {
            font-size: 1.1rem;
            transition: transform 0.3s ease;
        }

        .profile-nav-pill:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.05);
        }

        .profile-nav-pill:hover i {
            transform: translateY(-2px);
        }

        .profile-nav-pill.active {
            background: var(--syndicat-accent-gradient);
            color: #fff;
            box-shadow: 0 0 25px var(--syndicat-accent);
            transform: scale(1.05);
        }

        .profile-tab-content {
            display: none;
            opacity: 0;
            transform: translateY(15px);
            transition: all 0.4s ease-out;
        }

        .profile-tab-content.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        [data-theme="light"] .profile-nav-container {
            background: rgba(0, 0, 0, 0.03);
            border-color: rgba(0, 0, 0, 0.08);
        }
        [data-theme="light"] .profile-nav-pill {
            color: #64748b;
        }
        [data-theme="light"] .profile-nav-pill:hover {
            background: rgba(0, 0, 0, 0.05);
            color: #1e293b;
        }

        /* Reclamation List Styles */
        .reclamation-image-preview:hover {
            transform: scale(1.05);
            border-color: var(--syndicat-accent) !important;
        }

        .reclamation-item, .publication-item {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 15px;
            padding: 1.25rem;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
            display: none;
            opacity: 0;
            transform: translateY(10px);
        }

        .reclamation-item.active, .publication-item.active {
            display: block !important;
            opacity: 1 !important;
            transform: translateY(0);
        }

        .reclamation-item:hover, .publication-item:hover {
            border-color: rgba(var(--syndicat-accent-rgb), 0.3);
            background: rgba(var(--syndicat-accent-rgb), 0.02);
            transform: translateY(-5px) !important;
        }

        .reclamation-status-text {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem;
        }

        .reclamation-desc-text, .publication-desc-text, .event-desc-text,
        .reclamation-item h5, .publication-item h5, .event-item h5 {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.95rem;
            line-height: 1.6;
            overflow-wrap: break-word;
            word-wrap: break-word;
            word-break: break-word;
        }

        .reclamation-item h5, .publication-item h5 {
            color: #fff;
            font-size: 1.1rem;
            font-weight: 700;
        }

        [data-theme="light"] .reclamation-item {
            background: #fff;
            border-color: #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        [data-theme="light"] .reclamation-status-text {
            color: #64748b;
        }
        [data-theme="light"] .reclamation-desc-text, [data-theme="light"] .publication-desc-text,
        [data-theme="light"] .reclamation-item h5, [data-theme="light"] .publication-item h5 {
            color: #475569;
        }

        /* Pagination Controls Styles */
        .reclamation-pagination {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 2rem;
            padding: 0.5rem;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 100px;
            width: fit-content;
            margin-left: auto;
            margin-right: auto;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .pagination-pill {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: rgba(255, 255, 255, 0.5);
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .pagination-pill:hover:not(.active) {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
        }

        .pagination-pill.active {
            background: var(--syndicat-accent-gradient);
            color: #fff;
            box-shadow: 0 0 15px var(--syndicat-accent);
        }

        .reclamation-page {
            display: none;
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.4s ease;
        }

        .reclamation-page.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        [data-theme="light"] .reclamation-pagination {
            background: rgba(0, 0, 0, 0.03);
            border-color: rgba(0, 0, 0, 0.05);
        }
        [data-theme="light"] .pagination-pill {
            color: #64748b;
        }

        /* Image Lightbox Styles */
        .reclamation-lightbox {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(10px);
            z-index: 10000;
            display: none;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            cursor: zoom-out;
        }

        .reclamation-lightbox.active {
            display: flex;
            opacity: 1;
        }

        .lightbox-content {
            max-width: 90%;
            max-height: 90%;
            position: relative;
            transform: scale(0.9);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: default;
        }

        .reclamation-lightbox.active .lightbox-content {
            transform: scale(1);
        }

        .lightbox-image {
            max-width: 100%;
            max-height: 90vh;
            border-radius: 12px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .lightbox-close {
            position: absolute;
            top: -40px;
            right: 0;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lightbox-close:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(90deg);
        }

        /* Forum Sub-nav Styles */
        .forum-sub-nav {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            padding: 0.4rem;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            width: fit-content;
        }

        .forum-sub-nav-pill {
            padding: 0.6rem 1.2rem;
            border-radius: 10px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .forum-sub-nav-pill:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.04);
        }

        .forum-sub-nav-pill.active {
            background: rgba(var(--syndicat-accent-rgb), 0.1);
            color: var(--syndicat-accent);
            border-color: rgba(var(--syndicat-accent-rgb), 0.2);
        }

        .forum-content-section {
            display: none;
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.4s ease;
        }

        .forum-content-section.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        /* Profile Social Action Buttons */
        .action-btn-profile {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.6rem 1rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .action-btn-profile:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            transform: translateY(-2px);
        }

        .action-btn-profile.active.like {
            background: rgba(46, 213, 115, 0.15);
            border-color: rgba(46, 213, 115, 0.3);
            color: #2ed573;
            box-shadow: 0 4px 15px rgba(46, 213, 115, 0.2);
        }

        .action-btn-profile.active.dislike {
            background: rgba(255, 71, 87, 0.15);
            border-color: rgba(255, 71, 87, 0.3);
            color: #ff4757;
            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.2);
        }

        /* Publication Stats Preview */
        .publication-stats-preview {
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            padding: 0 1rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 16px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            margin-top: 0;
        }

        .publication-stats-preview.active {
            max-height: 200px;
            opacity: 1;
            padding: 1.2rem;
            margin-top: 1rem;
            background: rgba(255, 255, 255, 0.03);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .action-btn-profile.active.bookmark {
            background: rgba(33, 150, 243, 0.15);
            border-color: rgba(33, 150, 243, 0.3);
            color: #2196f3;
            box-shadow: 0 4px 15px rgba(33, 150, 243, 0.2);
        }

        .action-btn-profile.active.signal {
            background: rgba(255, 152, 0, 0.15);
            border-color: rgba(255, 152, 0, 0.3);
            color: #ff9800;
            box-shadow: 0 4px 15px rgba(255, 152, 0, 0.2);
        }

        /* Comment Specific Actions */
        .btn-comment-action {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.6);
            padding: 0.35rem 0.75rem;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }

        .btn-comment-action:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
        }

        .btn-comment-action.active.btn-comment-like {
            background: rgba(46, 213, 115, 0.1);
            color: #2ed573;
            border-color: rgba(46, 213, 115, 0.3);
        }

        .btn-comment-action.active.btn-comment-dislike {
            background: rgba(255, 71, 87, 0.1);
            color: #ff4757;
            border-color: rgba(255, 71, 87, 0.3);
        }

        .btn-comment-action.active.btn-comment-signal {
            background: rgba(255, 152, 0, 0.1);
            color: #ff9800;
            border-color: rgba(255, 152, 0, 0.3);
        }
    </style>
    <style>
        /* Essential for scrolling: make form a flex container */
        .glass-modal-form {
            display: flex;
            flex-direction: column;
            min-height: 0;
            flex: 1;
            overflow: hidden;
        }
    </style>
</head>
<body style="background: transparent !important;">
    {% include 'frontend/shared/_global_video_background.html.twig' %}
<div class="page-loader" id="pageLoader">
    <div class="loader-content">
        <div class="loader-dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
    </div>
</div>

<div class="main-home-layout-wrapper">
    <div class="main-home-page">
        {% set _navbar_avatar_url = profile.avatar ? (profile.avatar starts with 'http' ? profile.avatar : asset(profile.avatar)) : null %}
        {% include 'frontend/shared/_main_navbar.html.twig' with {'active_tab': 'profile', 'profile_avatar_url': _navbar_avatar_url} %}

        <div class="main-home-content-wrapper">
            <div class="container-xxl">
                <!-- Profile Header: user data from user table -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="main-home-profile-header">
                            <div class="main-home-profile-banner">
                                <div class="main-home-profile-banner-overlay"></div>
                            </div>
                            <div class="main-home-profile-info">
                                <div class="main-home-profile-avatar-container">
                                    <form id="profile-avatar-upload-form" action="{{ path('frontend_profile_avatar_upload') }}" method="post" enctype="multipart/form-data" class="profile-avatar-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('profile_avatar_upload') }}">
                                        <input type="file" name="avatar_file" id="profile-avatar-file-input" accept="image/jpeg,image/png,image/gif,image/webp" class="profile-avatar-file-input">
                                        <label for="profile-avatar-file-input" class="main-home-profile-avatar main-home-profile-avatar-clickable" title="Click to upload a new photo">
                                            {% if profile.avatar %}
                                                <img src="{{ profile.avatar starts with 'http' ? profile.avatar : asset(profile.avatar) }}" alt="Avatar" class="main-home-profile-avatar-img" id="profile-avatar-img">
                                            {% else %}
                                                <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=200&h=200&fit=crop&crop=face" alt="Profile Picture" class="main-home-profile-avatar-img" id="profile-avatar-img">
                                            {% endif %}
                                            <span class="profile-avatar-upload-hint"><i class="bx bx-camera"></i> Upload</span>
                                        </label>
                                    </form>
                                </div>
                                <div class="main-home-profile-details">
                                    <h1 class="main-home-profile-name">{{ user.firstName }} {{ user.lastName }}</h1>
                                    <p class="main-home-profile-title">{{ user.roleUser }}</p>
                                    <p class="main-home-profile-location">
                                        <i class="bx bx-envelope"></i> {{ user.emailUser }}
                                    </p>
                                    <div class="main-home-profile-stats">
                                        <div class="main-home-stat-item">
                                            <span class="main-home-stat-label">Account created</span>
                                            <span class="main-home-stat-number">{{ user.createdAt|date('d/m/Y') }}</span>
                                        </div>
                                        <div class="main-home-stat-item">
                                            <span class="main-home-stat-label">Status</span>
                                            <span class="main-home-stat-number">{{ user.isVerified ? 'Verified' : 'Pending verification' }}</span>
                                        </div>
                                    </div>
                                    <div class="main-home-profile-actions" style="margin-top: 1rem;">
                                        <button type="button" class="main-home-btn main-home-btn-primary" id="profile-settings-open" title="Profile settings">
                                            <i class="bx bx-cog"></i> Profile settings
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sick Pagination Navigation -->
                <div class="row mb-5">
                    <div class="col-12">
                        <div class="profile-nav-container">
                            <div class="profile-nav-pill active" data-tab="account">
                                <i class="bx bx-user"></i> Account
                            </div>
                            <div class="profile-nav-pill" data-tab="forum">
                                <i class="bx bx-message-square-detail"></i> Forum
                            </div>
                            <div class="profile-nav-pill" data-tab="events">
                                <i class="bx bx-calendar-event"></i> Events
                            </div>
                            <div class="profile-nav-pill" data-tab="reclamation">
                                <i class="bx bx-error-alt"></i> Reclamation
                            </div>
                            <div class="profile-nav-pill" data-tab="residence">
                                <i class="bx bx-building-house"></i> Residence
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Page 1 (Account & Onboarding) -->
                <div id="tab-account" class="profile-tab-content active">
                    <!-- Account info (from user + profile: Bio, Timezone) -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="main-home-profile-card mb-4">
                            <div class="main-home-card-header">
                                <h3 class="main-home-card-title"><i class="bx bx-user"></i> Account</h3>
                            </div>
                            <div class="main-home-card-content">
                                <dl class="row mb-0">
                                    <dt class="col-sm-3">First name</dt>
                                    <dd class="col-sm-9">{{ user.firstName }}</dd>
                                    <dt class="col-sm-3">Last name</dt>
                                    <dd class="col-sm-9">{{ user.lastName }}</dd>
                                    <dt class="col-sm-3">Email</dt>
                                    <dd class="col-sm-9">{{ user.emailUser }}</dd>
                                    <dt class="col-sm-3">Role</dt>
                                    <dd class="col-sm-9">{{ user.roleUser }}</dd>
                                    <dt class="col-sm-3">Verified</dt>
                                    <dd class="col-sm-9">{{ user.isVerified ? 'Yes' : 'No (pending admin)' }}</dd>
                                    <dt class="col-sm-3">Account created</dt>
                                    <dd class="col-sm-9">{{ user.createdAt|date('d/m/Y H:i') }}</dd>
                                    <dt class="col-sm-3">Bio</dt>
                                    <dd class="col-sm-9 main-home-profile-bio">
                                        {% if profile.descriptionProfile %}
                                            {{ profile.descriptionProfile }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </dd>
                                    <dt class="col-sm-3">Timezone</dt>
                                    <dd class="col-sm-9">
                                        {% if profile.timezone is not null %}
                                            {{ profile.timezone }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Your onboarding choices (read-only display, same style as onboarding steps pills) -->
                {% if onboarding is not null %}
                {% set _ob_pref_labels = {
                    'notification_channel': 'Notification Channel',
                    'notification_frequency': 'Notification Frequency',
                    'property_type': 'Property Type',
                    'occupancy_status': 'Occupancy Status',
                    'parking_type': 'Parking Type',
                    'meeting_participation': 'Meeting Participation',
                    'document_delivery': 'Document Delivery',
                    'contact_preference': 'Contact Preference',
                    'maintenance_priority': 'Maintenance Priority',
                    'community_engagement': 'Community Engagement',
                    'payment_method_preference': 'Payment Method',
                    'noise_sensitivity': 'Noise Sensitivity',
                    'pets_status': 'Pets Status',
                    'accessibility_needs': 'Accessibility Needs',
                    'language_preference': 'Language Preference',
                    'theme_preference': 'Theme Preference'
                } %}
                {% set _ob_pref_order = ['notification_channel','notification_frequency','property_type','occupancy_status','parking_type','meeting_participation','document_delivery','contact_preference','maintenance_priority','community_engagement','payment_method_preference','noise_sensitivity','pets_status','accessibility_needs','language_preference','theme_preference'] %}
                {% set _ob_value_labels = {
                    'EMAIL':'Email','SMS':'SMS','IN_APP':'In app','ALL':'All','NONE':'None',
                    'INSTANT':'Instant','DAILY_DIGEST':'Daily digest','WEEKLY_DIGEST':'Weekly','MONTHLY':'Monthly','IMPORTANT_ONLY':'Important only',
                    'APARTMENT':'Apartment','STUDIO':'Studio','DUPLEX':'Duplex',
                    'OWNER_OCCUPIED':'Owner occupied','OWNER_RENTING':'Owner renting','TENANT':'Tenant','TEMPORARY':'Temporary',
                    'OUTDOOR':'Outdoor','COVERED':'Covered','UNDERGROUND':'Underground','MULTIPLE':'Multiple',
                    'IN_PERSON':'In person','ONLINE':'Online','HYBRID':'Hybrid','PROXY_ONLY':'Proxy only',
                    'DIGITAL':'Digital','PAPER':'Paper','BOTH':'Both','ECO_FRIENDLY':'Eco-friendly',
                    'PHONE':'Phone','WHATSAPP':'WhatsApp','NO_CONTACT':'Urgency only',
                    'URGENT_ONLY':'Urgent only','PREVENTIVE':'Preventive','SCHEDULED':'Scheduled','FLEXIBLE':'Flexible',
                    'VERY_ACTIVE':'Very active','ACTIVE':'Active','MODERATE':'Moderate','OBSERVER':'Observer','MINIMAL':'Minimal',
                    'BANK_TRANSFER':'Bank transfer','CASH':'Cash','CHECK':'Check','AUTO_DEBIT':'Auto debit',
                    'HIGH':'High','LOW':'Low','NOT_CONCERNED':'Not concerned',
                    'NO_PETS':'None','CAT':'Cat','DOG':'Dog','MULTIPLE':'Multiple','OTHER':'Other',
                    'ELEVATOR_REQUIRED':'Elevator required','WHEELCHAIR':'Wheelchair','VISUAL_IMPAIRMENT':'Visual',
                    'FR':'Français','EN':'English','AR':'Arabic','FR_AR':'Bilingue FR/AR',
                    'LIGHT':'Light','DARK':'Dark'
                } %}
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="main-home-profile-card mb-4">
                            <div class="main-home-card-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
                                <h3 class="main-home-card-title" style="margin: 0;"><i class="bx bx-check-double"></i> Your onboarding choices</h3>
                                <button type="button" class="main-home-btn main-home-btn-primary" id="profile-onboarding-modify-open" title="Modify onboarding choices" style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                                    <i class="bx bx-edit"></i> Modify onboarding choices
                                </button>
                            </div>
                            <div class="main-home-card-content">
                                <div class="row g-3">
                                    <div class="col-md-6 col-lg-4">
                                        <div class="profile-onboarding-pill">
                                            <span class="profile-onboarding-pill-label">Language</span>
                                            <span class="profile-onboarding-pill-value" id="ob-val-locale">{{ _ob_value_labels[onboarding.selectedLocale|upper] is defined ? _ob_value_labels[onboarding.selectedLocale|upper] : onboarding.selectedLocale|upper }}</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="profile-onboarding-pill">
                                            <span class="profile-onboarding-pill-label">Theme</span>
                                            <span class="profile-onboarding-pill-value" id="ob-val-theme">{{ _ob_value_labels[onboarding.selectedTheme|upper] is defined ? _ob_value_labels[onboarding.selectedTheme|upper] : onboarding.selectedTheme|capitalize }}</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="profile-onboarding-pill">
                                            <span class="profile-onboarding-pill-label">Status</span>
                                            <span class="profile-onboarding-pill-value">{{ onboarding.completed ? 'Completed' : 'In progress' }}</span>
                                        </div>
                                    </div>
                                    {% if onboarding.selectedPreferences is not null and onboarding.selectedPreferences is not empty %}
                                    <div class="col-12 mt-2">
                                        <span class="profile-onboarding-pill-label" style="display: block; margin-bottom: 0.75rem;">Preferences</span>
                                        <div class="profile-onboarding-preferences-grid" id="ob-preferences-grid">
                                            {% for key in _ob_pref_order %}
                                            {% if onboarding.selectedPreferences[key] is defined and onboarding.selectedPreferences[key] is not null and onboarding.selectedPreferences[key] != '' %}
                                            <div class="profile-onboarding-pref-item" data-pref-key="{{ key }}">
                                                <span class="profile-onboarding-pref-key">{{ _ob_pref_labels[key] is defined ? _ob_pref_labels[key] : key|replace({'_': ' '})|title }}</span>
                                                <span class="profile-onboarding-pref-value" data-pref-val="{{ onboarding.selectedPreferences[key] }}">{{ _ob_value_labels[onboarding.selectedPreferences[key]] is defined ? _ob_value_labels[onboarding.selectedPreferences[key]] : onboarding.selectedPreferences[key] }}</span>
                                            </div>
                                            {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                    {% endif %}
                                    {% if onboarding.suggestions %}
                                    <div class="col-12 mt-2">
                                        <span class="profile-onboarding-pill-label" style="display: block; margin-bottom: 0.5rem;">Suggestions</span>
                                        <p class="profile-onboarding-suggestions-text">{{ onboarding.suggestions }}</p>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
                </div>

                <!-- Tab Content: Page 4 (Residence) -->
                <div id="tab-residence" class="profile-tab-content">
                    <div class="row">
                        <div class="col-12">
                            <div class="main-home-profile-card">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <h3 class="main-home-card-title"><i class="bx bx-building-house"></i> Your Residences</h3>
                                    {% if isAdmin %}
                                        <div class="admin-toggle-wrapper d-flex align-items-center gap-2 p-1 rounded-pill" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-residence-filter-btn btn-outline-light" data-filter="my" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">My Own</button>
                                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-residence-filter-btn active btn-primary" data-filter="all" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">Everyone</button>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="main-home-card-content">
                                    {% if appartements|length > 0 %}
                                        <div id="residence-items-container">
                                            <div class="residence-list">
                                                {% for appt in appartements %}
                                                    <div class="residence-item mb-3" 
                                                         data-user-id="{{ appt.user ? appt.user.idUser : '0' }}"
                                                         {% if appt.residence %}onclick="openResidenceDetails({{ appt.residence.idResidence }})"{% endif %}
                                                         style="cursor: pointer;">
                                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                                            <div class="d-flex align-items-center gap-3">
                                                                <div style="width: 50px; height: 50px; background: rgba(var(--syndicat-accent-rgb), 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                                                    <i class="bx bx-home" style="font-size: 1.5rem; color: var(--syndicat-accent);"></i>
                                                                </div>
                                                                <div>
                                                                    <h5 class="mb-1" style="font-weight: 700;">{{ appt.residence ? appt.residence.nomR : 'Unknown Residence' }}</h5>
                                                                    <p class="reclamation-status-text mb-0"><i class="bx bx-map"></i> {{ appt.residence ? appt.residence.adresse : 'Unknown Address' }}</p>
                                                                    {% if appt.appartementInfo is defined and appt.appartementInfo is not null %}
                                                                        <div class="d-flex gap-2 mt-2 flex-wrap">
                                                                            {% if appt.appartementInfo.bloc is defined and appt.appartementInfo.bloc %}
                                                                                <span class="badge bg-dark border border-secondary border-opacity-25 text-white-50 fw-normal d-flex align-items-center gap-1" title="Bloc">
                                                                                    <i class="bx bx-building"></i> {{ appt.appartementInfo.bloc }}
                                                                                </span>
                                                                            {% endif %}
                                                                            {% if appt.appartementInfo.floor is defined and appt.appartementInfo.floor %}
                                                                                <span class="badge bg-dark border border-secondary border-opacity-25 text-white-50 fw-normal d-flex align-items-center gap-1" title="Floor">
                                                                                    <i class="bx bx-layer"></i> {{ appt.appartementInfo.floor }}
                                                                                </span>
                                                                            {% endif %}
                                                                            {% if appt.appartementInfo.number is defined and appt.appartementInfo.number %}
                                                                                <span class="badge bg-dark border border-secondary border-opacity-25 text-white-50 fw-normal d-flex align-items-center gap-1" title="Apartment Number">
                                                                                    <i class="bx bx-hash"></i> {{ appt.appartementInfo.number }}
                                                                                </span>
                                                                            {% endif %}
                                                                        </div>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-3">
                                                                <span class="status-badge" style="background: rgba(var(--syndicat-accent-rgb), 0.1); color: var(--syndicat-accent); padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border: 1px solid rgba(var(--syndicat-accent-rgb), 0.2);">
                                                                    {{ appt.typeA }}
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="mt-3">
                                                            <div class="row g-2">
                                                                <div class="col-sm-6">
                                                                    <p class="mb-1 text-white-50" style="font-size: 0.9rem;"><i class="bx bx-check-circle"></i> Availability: <span class="text-white fw-bold">{{ appt.disponible ? 'Available' : 'Occupied' }}</span></p>
                                                                </div>
                                                                <div class="col-sm-6">
                                                                    <p class="mb-1 text-white-50" style="font-size: 0.9rem;"><i class="bx bx-car"></i> Parking: <span class="text-white fw-bold">{{ appt.parking ? 'Yes' : 'No' }}</span></p>
                                                                </div>
                                                            </div>
                                                            {% if appt.imageA %}
                                                                <div class="mt-3" style="width: 100px; height: 60px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
                                                                    <img src="{{ asset('uploads/residence/' ~ appt.imageA) }}" alt="Apartment Image" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;" onclick="openLightbox(this.src)">
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                    <hr class="my-3" style="border-color: rgba(255,255,255,0.1);">
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="text-center py-5">
                                            <p class="text-muted">No apartments found.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Page 2 (Forum Placeholder) -->
                <div id="tab-forum" class="profile-tab-content">
                    <div class="row">
                        <div class="col-12">
                            <div class="main-home-profile-card">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                                    <h3 class="main-home-card-title mb-0"><i class="bx bx-message-square-detail"></i> Forum Activity</h3>
                                    <div class="forum-sub-nav">
                                        <div class="forum-sub-nav-pill active" data-forum-tab="my-posts">
                                            My Posts
                                        </div>
                                        <div class="forum-sub-nav-pill" data-forum-tab="bookmarked-posts">
                                            Bookmarked
                                        </div>
                                    </div>
                                    {% if isAdmin %}
                                        <div class="admin-toggle-wrapper d-flex align-items-center gap-2 p-1 rounded-pill" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-forum-filter-btn btn-outline-light" data-filter="my" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">My Own</button>
                                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-forum-filter-btn active btn-primary" data-filter="all" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">Everyone</button>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="main-home-card-content">
                                    <!-- My Posts Section -->
                                    <div id="forum-sec-my-posts" class="forum-content-section active">
                                        {% if publications|length > 0 %}
                                            <div id="forum-publications-container">
                                                <div class="forum-publication-list">
                                                    {% for pub in publications %}
                                                        <div class="my-publication-item publication-item mb-3" 
                                                             data-publication-id="{{ pub.id }}" 
                                                             data-user-id="{{ pub.user ? pub.user.idUser : '0' }}" 
                                                             data-bs-toggle="modal" 
                                                             data-bs-target="#publicationModal-{{ pub.id }}" 
                                                             style="cursor: pointer;"
                                                             data-user-reaction="{{ userInteractions.reactions[pub.id] ?? '' }}"
                                                             data-user-bookmark="{{ userInteractions.bookmarks[pub.id] ?? 'false' }}"
                                                             data-user-report="{{ userInteractions.reports[pub.id] ?? 'false' }}"
                                                             data-count-like="{{ globalCounts[pub.id].likes ?? 0 }}"
                                                             data-count-dislike="{{ globalCounts[pub.id].dislikes ?? 0 }}"
                                                             data-count-report="{{ globalCounts[pub.id].reports ?? 0 }}"
                                                             data-token="{{ csrf_token('delete' ~ pub.id) }}">
                                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <div style="width: 50px; height: 50px; background: rgba(var(--syndicat-accent-rgb), 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                                                        <i class="bx bx-message-square-dots" style="font-size: 1.5rem; color: var(--syndicat-accent);"></i>
                                                                    </div>
                                                                    <div>
                                                                        <h5 class="mb-1" style="font-weight: 700;">{{ pub.titrePub }}</h5>
                                                                        <p class="reclamation-status-text mb-0"><i class="bx bx-calendar"></i> Posted on {{ pub.dateCreationPub|date('d M Y') }}</p>
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <span class="status-badge" style="background: rgba(var(--syndicat-accent-rgb), 0.1); color: var(--syndicat-accent); padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border: 1px solid rgba(var(--syndicat-accent-rgb), 0.2);">
                                                                        {{ pub.categoriePub }}
                                                                    </span>
                                                                    <i class="bx bx-chevron-right text-muted" style="font-size: 1.5rem;"></i>
                                                                </div>
                                                            </div>
                                                            <div class="mt-3">
                                                                <p class="publication-desc-text mb-3">{{ pub.descriptionPub|slice(0, 150) }}{{ pub.descriptionPub|length > 150 ? '...' : '' }}</p>
                                                                
                                                                <div class="d-flex align-items-center gap-2 mb-3">
                                                                    <div class="d-flex align-items-center gap-1 text-white-50 small p-2 rounded-3" style="background: rgba(255,255,255,0.03);">
                                                                        <i class='bx bx-like {% if (userInteractions.reactions[pub.id] ?? '') == 'like' %}text-primary{% endif %}'></i>
                                                                        <span>{{ globalCounts[pub.id].likes ?? 0 }}</span>
                                                                    </div>
                                                                    <div class="d-flex align-items-center gap-1 text-white-50 small p-2 rounded-3" style="background: rgba(255,255,255,0.03);">
                                                                        <i class='bx bx-dislike {% if (userInteractions.reactions[pub.id] ?? '') == 'dislike' %}text-danger{% endif %}'></i>
                                                                        <span>{{ globalCounts[pub.id].dislikes ?? 0 }}</span>
                                                                    </div>
                                                                    <div style="flex: 1;"></div>
                                                                    <button class="action-btn-profile py-1 px-3 stats-btn-toggle" onclick="toggleStats(event, {{ pub.id }})" title="View Statistics" style="font-size: 0.8rem; height: 32px; border-radius: 8px;">
                                                                        <i class='bx bx-stats'></i> Details Stats
                                                                    </button>
                                                                    <button class="action-btn-profile py-1 px-3 text-danger" onclick="deleteProfilePublication(event, {{ pub.id }})" title="Delete Publication" style="font-size: 0.8rem; height: 32px; border-radius: 8px; background: rgba(255, 59, 48, 0.1); border-color: rgba(255, 59, 48, 0.2);">
                                                                        <i class='bx bx-trash'></i>
                                                                    </button>
                                                                </div>

                                                                {% set likes = globalCounts[pub.id].likes ?? 0 %}
                                                                {% set dislikes = globalCounts[pub.id].dislikes ?? 0 %}
                                                                {% set total = likes + dislikes %}
                                                                {% set likePercent = total > 0 ? (likes / total * 100)|round : 0 %}
                                                                {% set dislikePercent = total > 0 ? (dislikes / total * 100)|round : 0 %}

                                                                <div id="stats-{{ pub.id }}" class="publication-stats-preview">
                                                                    <div class="d-flex justify-content-between mb-2 small fw-bold">
                                                                        <span class="text-primary"><i class='bx bx-like'></i> {{ likePercent }}% Likes</span>
                                                                        <span class="text-danger">{{ dislikePercent }}% Dislikes <i class='bx bx-dislike'></i></span>
                                                                    </div>
                                                                    <div class="progress" style="height: 6px; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.05);">
                                                                        <div class="progress-bar" role="progressbar" style="width: {{ likePercent }}%; background: linear-gradient(90deg, #2ed573, #7bed9f);" aria-valuenow="{{ likePercent }}" aria-valuemin="0" aria-valuemax="100"></div>
                                                                        <div class="progress-bar" role="progressbar" style="width: {{ dislikePercent }}%; background: linear-gradient(90deg, #ff6b81, #ff4757);" aria-valuenow="{{ dislikePercent }}" aria-valuemin="0" aria-valuemax="100"></div>
                                                                    </div>
                                                                    {% if total == 0 %}
                                                                        <p class="text-white-50 small mt-3 mb-0 text-center" style="font-style: italic;"><i class='bx bx-info-circle'></i> No reactions yet to calculate statistics.</p>
                                                                    {% endif %}
                                                                </div>

                                                                {% if pub.imagePub %}
                                                                    <div class="reclamation-image-preview" style="width: 80px; height: 80px; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); transition: transform 0.2s;" onclick="event.stopPropagation();">
                                                                        <img src="{{ asset('forum_images/' ~ pub.imagePub) }}" alt="Publication Image" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;" onclick="event.stopPropagation(); openLightbox(this.src)">
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                                <div id="forum-my-posts-pagination" class="reclamation-pagination"></div>
                                            </div>
                                        {% else %}
                                            <div class="text-center py-5">
                                                <div class="opacity-25 mb-3"><i class='bx bx-message-square-x' style="font-size: 4rem;"></i></div>
                                                <p class="text-muted">You haven't posted anything yet.</p>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <!-- Bookmarked Posts Section -->
                                    <div id="forum-sec-bookmarked-posts" class="forum-content-section">
                                        {% if bookmarkedPublications|length > 0 %}
                                            <div id="forum-bookmarked-container">
                                                <div class="forum-publication-list">
                                                    {% for pub in bookmarkedPublications %}
                                                        <div class="bookmarked-publication-item publication-item mb-3" 
                                                             data-publication-id="{{ pub.id }}" 
                                                             data-bs-toggle="modal" 
                                                             data-bs-target="#publicationModal-{{ pub.id }}" 
                                                             style="cursor: pointer;"
                                                             data-user-reaction="{{ userInteractions.reactions[pub.id] ?? '' }}"
                                                             data-user-bookmark="{{ userInteractions.bookmarks[pub.id] ?? 'false' }}"
                                                             data-user-report="{{ userInteractions.reports[pub.id] ?? 'false' }}"
                                                             data-count-like="{{ globalCounts[pub.id].likes ?? 0 }}"
                                                             data-count-dislike="{{ globalCounts[pub.id].dislikes ?? 0 }}"
                                                             data-count-report="{{ globalCounts[pub.id].reports ?? 0 }}"
                                                             data-token="{{ csrf_token('delete' ~ pub.id) }}">
                                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <div style="width: 50px; height: 50px; background: rgba(33, 150, 243, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                                                        <i class="bx bxs-bookmark" style="font-size: 1.5rem; color: #2196f3;"></i>
                                                                    </div>
                                                                    <div>
                                                                        <h5 class="mb-1" style="font-weight: 700;">{{ pub.titrePub }}</h5>
                                                                        <div class="d-flex align-items-center gap-2">
                                                                            <p class="reclamation-status-text mb-0"><i class="bx bx-user"></i> {{ pub.user.firstName }} {{ pub.user.lastName }}</p>
                                                                            <span class="text-muted opacity-25">•</span>
                                                                            <p class="reclamation-status-text mb-0"><i class="bx bx-calendar"></i> {{ pub.dateCreationPub|date('d M Y') }}</p>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <span class="status-badge" style="background: rgba(33, 150, 243, 0.1); color: #2196f3; padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border: 1px solid rgba(33, 150, 243, 0.2);">
                                                                        {{ pub.categoriePub }}
                                                                    </span>
                                                                    {% if pub.user.idUser == user.idUser %}
                                                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" 
                                                                                onclick="deleteProfilePublication(event, {{ pub.id }})"
                                                                                title="Delete My Post">
                                                                            <i class="bx bx-trash"></i>
                                                                        </button>
                                                                    {% endif %}
                                                                    <i class="bx bx-chevron-right text-muted" style="font-size: 1.5rem;"></i>
                                                                </div>
                                                            </div>
                                                            <div class="mt-3">
                                                                <p class="publication-desc-text mb-3">{{ pub.descriptionPub|slice(0, 150) }}{{ pub.descriptionPub|length > 150 ? '...' : '' }}</p>
                                                                
                                                                <div class="d-flex align-items-center gap-3 mb-2">
                                                                    <div class="d-flex align-items-center gap-1 text-white-50 small">
                                                                        <i class='bx bx-like {% if (userInteractions.reactions[pub.id] ?? '') == 'like' %}text-primary{% endif %}'></i>
                                                                        <span>{{ globalCounts[pub.id].likes ?? 0 }}</span>
                                                                    </div>
                                                                    <div class="d-flex align-items-center gap-1 text-white-50 small">
                                                                        <i class='bx bx-dislike {% if (userInteractions.reactions[pub.id] ?? '') == 'dislike' %}text-danger{% endif %}'></i>
                                                                        <span>{{ globalCounts[pub.id].dislikes ?? 0 }}</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                                <div id="forum-bookmarked-pagination" class="reclamation-pagination"></div>
                                            </div>
                                        {% else %}
                                            <div class="text-center py-5">
                                                <div class="opacity-25 mb-3"><i class='bx bx-bookmark-plus' style="font-size: 4rem;"></i></div>
                                                <p class="text-muted">You haven't bookmarked any posts yet.</p>
                                                <a href="{{ path('frontend_forum') }}" class="main-home-btn main-home-btn-primary mt-3" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;">
                                                    <i class="bx bx-search"></i> Explore the Forum
                                                </a>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Page 3 (Events) -->
                <div id="tab-events" class="profile-tab-content">
                    <div class="row">
                        <div class="col-12">
                            <div class="main-home-profile-card">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <h3 class="main-home-card-title"><i class="bx bx-calendar-event"></i> Your Events</h3>
                                    {% if isAdmin %}
                                        <div class="admin-toggle-wrapper d-flex align-items-center gap-2 p-1 rounded-pill" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-events-filter-btn btn-outline-light" data-filter="my" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">My Own</button>
                                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-events-filter-btn active btn-primary" data-filter="all" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">Everyone</button>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="main-home-card-content">
                                    {% if events|length > 0 %}
                                        <div id="events-container">
                                            <div class="events-list">
                                                {% for event in events %}
                                                    <div class="event-item mb-3" 
                                                         data-event-id="{{ event.id }}" 
                                                         data-user-id="{{ event.user ? event.user.idUser : '0' }}"
                                                         data-title="{{ event.titreEvent }}"
                                                         data-description="{{ event.descriptionEvent }}"
                                                         data-date="{{ event.dateEvent|date('Y-m-d\\TH:i') }}"
                                                         data-date-formatted="{{ event.dateEvent|date('d M Y, H:i') }}"
                                                         data-location="{{ event.lieuEvent }}"
                                                         data-places="{{ event.nbPlaces }}"
                                                         data-remaining="{{ event.nbRestants }}"
                                                         data-status="{{ event.statutEvent }}"
                                                         data-type="{{ event.typeEvent }}"
                                                         data-image="{{ event.imageEvent ? asset('event_images/' ~ event.imageEvent) : '' }}"
                                                         style="cursor: pointer; transition: all 0.3s ease; border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.25rem; background: rgba(255,255,255,0.02);">
                                                        <div class="d-flex flex-column flex-md-row gap-4">
                                                            {% if event.imageEvent %}
                                                                <div class="event-list-image-wrap" style="width: 140px; height: 100px; border-radius: 14px; overflow: hidden; flex-shrink: 0; border: 1px solid rgba(255,255,255,0.1);">
                                                                    <img src="{{ asset('event_images/' ~ event.imageEvent) }}" alt="{{ event.titreEvent }}" style="width: 100%; height: 100%; object-fit: cover;">
                                                                </div>
                                                            {% else %}
                                                                <div class="event-list-image-wrap d-flex align-items-center justify-content-center" style="width: 140px; height: 100px; border-radius: 14px; background: rgba(var(--syndicat-accent-rgb), 0.05); flex-shrink: 0; border: 1px dashed rgba(255,255,255,0.1);">
                                                                    <i class="bx bx-calendar-event text-muted fs-2"></i>
                                                                </div>
                                                            {% endif %}
                                                            
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                                                    <div>
                                                                        <h5 class="mb-1" style="font-weight: 700; color: #fff; overflow-wrap: break-word;">{{ event.titreEvent }}</h5>
                                                                        <div class="d-flex align-items-center gap-3 flex-wrap">
                                                                            <p class="reclamation-status-text mb-0"><i class="bx bx-calendar"></i> {{ event.dateEvent|date('d M Y, H:i') }}</p>
                                                                            <p class="reclamation-status-text mb-0"><i class="bx bx-map"></i> {{ event.lieuEvent }}</p>
                                                                        </div>
                                                                    </div>
                                                                    {% set status_colors = {
                                                                        'planifie': '#4fc3f7',
                                                                        'en_cours': '#00e676',
                                                                        'termine': '#9e9e9e',
                                                                        'annule': '#ff3b30'
                                                                    } %}
                                                                    <span class="status-badge" style="background: {{ status_colors[event.statutEvent|default('planifie')] }}20; color: {{ status_colors[event.statutEvent|default('planifie')] }}; padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border: 1px solid {{ status_colors[event.statutEvent|default('planifie')] }}40;">
                                                                        {{ event.statutEvent|replace({'_': ' '})|title }}
                                                                    </span>
                                                                </div>
                                                                <div class="mt-2">
                                                                    <p class="reclamation-desc-text mb-1" style="overflow-wrap: break-word;">{{ event.descriptionEvent|slice(0, 100) }}{{ event.descriptionEvent|length > 100 ? '...' : '' }}</p>
                                                                    <div class="d-flex align-items-center gap-3 text-muted" style="font-size: 0.8rem; opacity: 0.7;">
                                                                        <span><i class="bx bx-purchase-tag-alt"></i> {{ event.typeEvent|title }}</span>
                                                                        <span><i class="bx bx-user"></i> {{ event.nbRestants }}/{{ event.nbPlaces }} enrolled</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            <div id="events-pagination" class="reclamation-pagination"></div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="text-center py-5">
                                            <p class="text-muted">No events found.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Page 4 (Reclamation) -->
                <div id="tab-reclamation" class="profile-tab-content">
                    <div class="row">
                        <div class="col-12">
                            <div class="main-home-profile-card">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <h3 class="main-home-card-title"><i class="bx bx-error-alt"></i> Your Reclamations</h3>
                                        {% if isAdmin %}
                                            <div class="admin-toggle-wrapper d-flex align-items-center gap-2 p-1 rounded-pill" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                                <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-reclamation-filter-btn btn-outline-light" data-filter="my" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">My Own</button>
                                                <button type="button" class="btn btn-sm rounded-pill px-3 py-1 admin-reclamation-filter-btn active btn-primary" data-filter="all" style="font-size: 0.75rem; font-weight: 600; transition: all 0.2s;">Everyone</button>
                                            </div>
                                        {% endif %}
                                    </div>
                                <div class="main-home-card-content">
                                    {% if reclamations|length > 0 %}
                                        <div class="reclamation-container">
                                            <div class="reclamation-list">
                                                {% for rec in reclamations %}
                                                    <div class="reclamation-item mb-3" 
                                                         data-reclamation-id="{{ rec.id }}" 
                                                         onclick="openReclamationDetails({{ rec.id }})"
                                                         style="cursor: pointer;">
                                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                                            <div class="d-flex align-items-center gap-3">
                                                                <div style="width: 50px; height: 50px; background: rgba(var(--syndicat-accent-rgb), 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                                                    <i class="bx bx-file" style="font-size: 1.5rem; color: var(--syndicat-accent);"></i>
                                                                </div>
                                                                <div>
                                                                    <h5 class="mb-1" style="font-weight: 700;">{{ rec.titrereclamations }}</h5>
                                                                    <p class="reclamation-status-text mb-0" data-reclamation-id="{{ rec.id }}"><i class="bx bx-calendar"></i> Submitted on {{ rec.createdAt is not null ? rec.createdAt|date('d M Y') : 'N/A' }}</p>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-3">
                                                                {% set status_colors = {
                                                                    'confirme': '#00e676',
                                                                    'active': '#00e676',
                                                                    'en_attente': '#ffeb3b',
                                                                    'refuse': '#ff3b30',
                                                                    'annule': '#9e9e9e',
                                                                    'termine': '#4fc3f7'
                                                                } %}
                                                                {% set status_labels = {
                                                                    'confirme': 'Confirmed',
                                                                    'active': 'Active',
                                                                    'en_attente': 'In Progress',
                                                                    'refuse': 'Rejected',
                                                                    'annule': 'Cancelled',
                                                                    'termine': 'Completed'
                                                                } %}
                                                                <span class="status-badge" style="background: {{ status_colors[rec.statutreclamation|default('en_attente')] }}20; color: {{ status_colors[rec.statutreclamation|default('en_attente')] }}; padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border: 1px solid {{ status_colors[rec.statutreclamation|default('en_attente')] }}40;">
                                                                    {{ status_labels[rec.statutreclamation|default('en_attente')] }}
                                                                </span>
                                                                <i class="bx bx-chevron-right text-muted" style="font-size: 1.5rem;"></i>
                                                            </div>
                                                        </div>
                                                        <div class="mt-3">
                                                            <p class="reclamation-desc-text mb-3">{{ rec.descreclamation|slice(0, 150) }}{{ rec.descreclamation|length > 150 ? '...' : '' }}</p>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>

                                            {# Pagination Controls #}
                                            {% if reclamations|length > 3 %}
                                                <div class="reclamation-pagination" id="reclamation-pagination">
                                                    {# Will be populated by JS #}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <div class="text-center py-5">
                                            <div style="background: rgba(255,255,255,0.03); border-radius: 50%; width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                                                <i class="bx bx-error-alt" style="font-size: 3.5rem; color: var(--syndicat-accent);"></i>
                                            </div>
                                            <h3 class="mb-2" style="font-weight: 700;">No Reclamations Yet</h3>
                                            <p class="text-muted mx-auto" style="max-width: 400px;">You haven't submitted any reclamations yet. When you do, they'll appear here with their current status.</p>
                                            <a href="{{ path('frontend_syndicat') }}" class="main-home-btn main-home-btn-primary mt-3" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.5rem;">
                                                <i class="bx bx-plus"></i> Submit a Reclamation
                                            </a>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% include 'frontend/shared/_main_footer.html.twig' %}
    </div>
</div>

<!-- Image Lightbox -->
<div class="reclamation-lightbox" id="reclamation-lightbox">
    <div class="lightbox-content">
        <button class="lightbox-close" id="lightbox-close"><i class="bx bx-x"></i></button>
        <img src="" alt="View Enlarged" class="lightbox-image" id="lightbox-image">
    </div>
</div>

<!-- Onboarding edit modal: 7-step wizard with custom Locale/Theme pills and preference radios -->
{% if onboardingForm is defined and onboardingForm is not null %}
{% set _ob_prefs = onboarding.selectedPreferences|default({}) %}
<div id="profile-onboarding-modal" class="glass-modal-overlay">
    <div class="glass-modal-container" style="max-width: 580px;">
        <div class="glass-modal-header">
            <div>
                <h3 class="glass-modal-title">Modify onboarding choices</h3>
                <p class="glass-modal-subtitle">Update language, theme, preferences and suggestions.</p>
            </div>
            <button type="button" class="glass-modal-close" id="profile-onboarding-modal-close" aria-label="Close">
                <i class="bx bx-x"></i>
            </button>
        </div>

        <div class="glass-modal-body">
            {{ form_start(onboardingForm, { 'attr': {
                'id': 'profile-onboarding-form',
                'method': 'post',
                'action': path('frontend_profile_onboarding_update'),
                'class': 'glass-modal-form'
            } }) }}
            <div class="glass-wizard-progress" id="ob-progress">
                {% for i in 1..7 %}<div class="glass-wizard-dot {% if i == 1 %}active{% endif %}" data-step="{{ i }}"></div>{% endfor %}
            </div>

            <div id="ob-step-1" class="glass-wizard-step active">
                <div class="glass-form-group">
                    <label class="glass-label">Language Preference</label>
                    <div class="glass-wizard-options ob-locale-pills">
                        {% for val, label in {'fr':'🇫🇷 Français','en':'🇺🇸 English','ar':'🇸🇦 العربية','fr_ar':'🇫🇷🇸🇦 Bilingue FR/AR'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="ob_locale_radio" id="ob_locale_{{ val }}" value="{{ val }}" {{ onboarding.selectedLocale == val ? 'checked' : '' }}>
                            <label for="ob_locale_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Theme Mode</label>
                    <div class="glass-wizard-options ob-theme-pills">
                        <div class="glass-wizard-opt">
                            <input type="radio" name="ob_theme_radio" id="ob_theme_light" value="light" {{ onboarding.selectedTheme == 'light' ? 'checked' : '' }}>
                            <label for="ob_theme_light"><i class="bx bx-sun"></i> Light</label>
                        </div>
                        <div class="glass-wizard-opt">
                            <input type="radio" name="ob_theme_radio" id="ob_theme_dark" value="dark" {{ onboarding.selectedTheme == 'dark' ? 'checked' : '' }}>
                            <label for="ob_theme_dark"><i class="bx bx-moon"></i> Dark</label>
                        </div>
                    </div>
                </div>
            </div>

            <div id="ob-step-2" class="glass-wizard-step">
                <div class="glass-form-group">
                    <label class="glass-label">Notification Channels</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'EMAIL':'📧 Email','SMS':'📱 SMS','IN_APP':'🔔 In app','ALL':'📬 All','NONE':'🔕 None'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[notification_channel]" id="ob_nc_{{ val }}" value="{{ val }}" {{ (_ob_prefs.notification_channel|default('EMAIL')) == val ? 'checked' : '' }}>
                            <label for="ob_nc_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Update Frequency</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'INSTANT':'Instant','DAILY_DIGEST':'Daily','WEEKLY_DIGEST':'Weekly','MONTHLY':'Monthly','IMPORTANT_ONLY':'Important only'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[notification_frequency]" id="ob_nf_{{ val }}" value="{{ val }}" {{ (_ob_prefs.notification_frequency|default('DAILY_DIGEST')) == val ? 'checked' : '' }}>
                            <label for="ob_nf_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div id="ob-step-3" class="glass-wizard-step">
                <div class="glass-form-group">
                    <label class="glass-label">Property Categorization</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'APARTMENT':'Apartment','STUDIO':'Studio','DUPLEX':'Duplex'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[property_type]" id="ob_pt_{{ val }}" value="{{ val }}" {{ (_ob_prefs.property_type|default('APARTMENT')) == val ? 'checked' : '' }}>
                            <label for="ob_pt_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Resident Status</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'OWNER_OCCUPIED':'Owner','OWNER_RENTING':'Landlord','TENANT':'Tenant','TEMPORARY':'Temporary'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[occupancy_status]" id="ob_os_{{ val }}" value="{{ val }}" {{ (_ob_prefs.occupancy_status|default('OWNER_OCCUPIED')) == val ? 'checked' : '' }}>
                            <label for="ob_os_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Parking Facilities</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'NONE':'None','OUTDOOR':'Outdoor','COVERED':'Covered','UNDERGROUND':'Underground','MULTIPLE':'Multiple'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[parking_type]" id="ob_pk_{{ val }}" value="{{ val }}" {{ (_ob_prefs.parking_type|default('NONE')) == val ? 'checked' : '' }}>
                            <label for="ob_pk_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div id="ob-step-4" class="glass-wizard-step">
                <div class="glass-form-group">
                    <label class="glass-label">Meeting Participation</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'IN_PERSON':'In person','ONLINE':'Online','HYBRID':'Hybrid','PROXY_ONLY':'Proxy only'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[meeting_participation]" id="ob_mp_{{ val }}" value="{{ val }}" {{ (_ob_prefs.meeting_participation|default('HYBRID')) == val ? 'checked' : '' }}>
                            <label for="ob_mp_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Document Preferences</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'DIGITAL':'Digital','PAPER':'Paper','BOTH':'Both','ECO_FRIENDLY':'Eco-friendly'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[document_delivery]" id="ob_dd_{{ val }}" value="{{ val }}" {{ (_ob_prefs.document_delivery|default('DIGITAL')) == val ? 'checked' : '' }}>
                            <label for="ob_dd_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Primary Contact Mode</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'EMAIL':'Email','PHONE':'Phone','WHATSAPP':'WhatsApp','IN_PERSON':'In person','NO_CONTACT':'Urgency only'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[contact_preference]" id="ob_cp_{{ val }}" value="{{ val }}" {{ (_ob_prefs.contact_preference|default('EMAIL')) == val ? 'checked' : '' }}>
                            <label for="ob_cp_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div id="ob-step-5" class="glass-wizard-step">
                <div class="glass-form-group">
                    <label class="glass-label">Maintenance Strategy</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'URGENT_ONLY':'Urgent only','PREVENTIVE':'Preventive','SCHEDULED':'Scheduled','FLEXIBLE':'Flexible'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[maintenance_priority]" id="ob_mt_{{ val }}" value="{{ val }}" {{ (_ob_prefs.maintenance_priority|default('FLEXIBLE')) == val ? 'checked' : '' }}>
                            <label for="ob_mt_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Community Role</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'VERY_ACTIVE':'Very active','ACTIVE':'Active','MODERATE':'Moderate','OBSERVER':'Observer','MINIMAL':'Minimal'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[community_engagement]" id="ob_ce_{{ val }}" value="{{ val }}" {{ (_ob_prefs.community_engagement|default('MODERATE')) == val ? 'checked' : '' }}>
                            <label for="ob_ce_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div id="ob-step-6" class="glass-wizard-step">
                <div class="glass-form-group">
                    <label class="glass-label">Preferred Financial Interactions</label>
                    <div class="glass-wizard-options mb-2">
                        {% for val, label in {'BANK_TRANSFER':'Transfer','CASH':'Cash','CHECK':'Check','ONLINE':'Online','AUTO_DEBIT':'Auto debit'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[payment_method_preference]" id="ob_pm_{{ val }}" value="{{ val }}" {{ (_ob_prefs.payment_method_preference|default('ONLINE')) == val ? 'checked' : '' }}>
                            <label for="ob_pm_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Environment Sensitivities</label>
                    <div class="glass-wizard-options mb-2">
                        {% for val, label in {'HIGH':'Noise Sensitive','MODERATE':'Moderate','LOW':'Low','NOT_CONCERNED':'Not concerned'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[noise_sensitivity]" id="ob_ns_{{ val }}" value="{{ val }}" {{ (_ob_prefs.noise_sensitivity|default('MODERATE')) == val ? 'checked' : '' }}>
                            <label for="ob_ns_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Living Companions (Pets)</label>
                    <div class="glass-wizard-options mb-2">
                        {% for val, label in {'NO_PETS':'None','CAT':'Cat','DOG':'Dog','MULTIPLE':'Multiple','OTHER':'Other'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[pets_status]" id="ob_ps_{{ val }}" value="{{ val }}" {{ (_ob_prefs.pets_status|default('NO_PETS')) == val ? 'checked' : '' }}>
                            <label for="ob_ps_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="glass-form-group">
                    <label class="glass-label">Special Access Requirements</label>
                    <div class="glass-wizard-options">
                        {% for val, label in {'NONE':'None','ELEVATOR_REQUIRED':'Elevator','WHEELCHAIR':'Wheelchair','VISUAL_IMPAIRMENT':'Visual','OTHER':'Other'} %}
                        <div class="glass-wizard-opt">
                            <input type="radio" name="prefs[accessibility_needs]" id="ob_an_{{ val }}" value="{{ val }}" {{ (_ob_prefs.accessibility_needs|default('NONE')) == val ? 'checked' : '' }}>
                            <label for="ob_an_{{ val }}">{{ label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

