    // --- Forum Generic Pagination ---
    let currentForumAdminFilter = isAdmin ? 'all' : 'my';
    let currentPubCategoryFilter = 'General';

    function initForumListPagination(itemClass, containerId, countId) {
        const items = Array.from(document.querySelectorAll(itemClass));
        const paginationContainer = document.getElementById(containerId);
        
        let filteredItems = items.filter(item => {
            let adminPass = (currentForumAdminFilter === 'all') || (item.dataset.userId == currentUserId);
            
            // Special Category Filtering for Publications
            if (itemClass === '.publication-item') {
                const catElement = item.querySelector('[id^="pub-category-"]');
                const itemCat = catElement ? catElement.textContent.trim() : '';
                let catPass = true;
                if (currentPubCategoryFilter === 'Announcement') {
                    catPass = itemCat === 'Announcement';
                } else if (currentPubCategoryFilter === 'General') {
                    catPass = itemCat !== 'Announcement';
                }
                return adminPass && catPass;
            }
            return adminPass;
        });

        items.forEach(item => { item.style.display = 'none'; item.style.opacity = '0'; });
        
        if (countId) {
            const countEl = document.getElementById(countId);
            if (countEl) countEl.textContent = filteredItems.length;
        }

        if (!paginationContainer) return;
        paginationContainer.innerHTML = '';

        if (filteredItems.length === 0) return;

        if (filteredItems.length <= itemsPerPage) {
            filteredItems.forEach(item => { item.style.display = 'block'; setTimeout(() => item.style.opacity = '1', 50); });
            return;
        }

        const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
        
        function showForumPage(page) {
            const start = (page - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            filteredItems.forEach(item => { 
                item.style.display = 'none'; 
                item.style.opacity = '0';
            });
            filteredItems.slice(start, end).forEach(item => { 
                item.style.display = 'block'; 
                setTimeout(() => item.style.opacity = '1', 50);
            });

            paginationContainer.querySelectorAll('.pagination-pill').forEach(pill => {
                pill.classList.toggle('active', parseInt(pill.dataset.page) === page);
            });
        }

        for (let i = 1; i <= totalPages; i++) {
            const pill = document.createElement('div');
            pill.className = 'pagination-pill';
            pill.textContent = i;
            pill.dataset.page = i;
            if (i === 1) pill.classList.add('active');
            
            pill.addEventListener('click', () => {
                showForumPage(i);
                profileForumSwitcher.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
            paginationContainer.appendChild(pill);
        }
        showForumPage(1);
    }

    window.initializeForumPagination = function() {
        initForumListPagination('.publication-item', 'forum-pagination-pubs', 'count-pubs');
        initForumListPagination('.comment-item', 'forum-pagination-comments', 'count-comms');
        initForumListPagination('.reaction-item', 'forum-pagination-reactions', 'count-reacts');
        initForumListPagination('.bookmark-item', 'forum-pagination-bookmarks', 'count-bookmarks');
    };

    // Initialize Category Filters
    document.querySelectorAll('.profile-cat-filter').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const cat = this.dataset.cat;
            currentPubCategoryFilter = cat;
            
            // UI Toggle
            document.querySelectorAll('.profile-cat-filter').forEach(b => {
                b.classList.remove('btn-light', 'fw-bold', 'active');
                b.classList.add('btn-outline-light');
            });
            this.classList.remove('btn-outline-light');
            this.classList.add('btn-light', 'fw-bold', 'active');

            // Refresh pagination which inherently filters
            window.initializeForumPagination();
        });
    });

    window.initializeForumPagination();

    // --- Events Pagination & Filtering ---
    const allEventItems = Array.from(document.querySelectorAll('.event-item'));
    const eventPaginationContainer = document.getElementById('events-pagination');
    let currentEventAdminFilter = isAdmin ? 'all' : 'my';

    window.initializeEventsPagination = function() {
        try {
            const filteredItems = allEventItems.filter(item => {
                if (currentEventAdminFilter === 'all') return true;
                return item.dataset.userId == currentUserId;
            });

            allEventItems.forEach(item => {
                item.style.display = 'none';
                item.classList.remove('active');
            });

            if (!eventPaginationContainer) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            eventPaginationContainer.innerHTML = '';
            if (filteredItems.length === 0) return;

            if (filteredItems.length <= itemsPerPage) {
                filteredItems.forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });
                return;
            }

            const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
            
            function showEventPage(page) {
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;
                
                filteredItems.forEach(item => {
                    item.style.display = 'none';
                    item.classList.remove('active');
                });

                filteredItems.slice(start, end).forEach(item => {
                    item.style.display = 'block';
                    setTimeout(() => item.classList.add('active'), 10);
                });

                eventPaginationContainer.querySelectorAll('.pagination-pill').forEach(pill => {
                    pill.classList.toggle('active', parseInt(pill.dataset.page) === page);
                });
            }

            for (let i = 1; i <= totalPages; i++) {
                const pill = document.createElement('div');
                pill.className = 'pagination-pill';
                pill.textContent = i;
                pill.dataset.page = i;
                if (i === 1) pill.classList.add('active');
                
                pill.addEventListener('click', () => {
                    showEventPage(i);
                    document.getElementById('tab-events').scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                
                eventPaginationContainer.appendChild(pill);
            }
            showEventPage(1);
        } catch (e) { console.error("Event Pagination Error:", e); }
    };

    window.initializeEventsPagination();




    window.previewProfileCommentImage = function(event, pubId) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById(`comment-image-preview-container-${pubId}`);
        const previewImage = document.getElementById(`comment-image-preview-${pubId}`);
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove('d-none');
            }
            reader.readAsDataURL(file);
        } else {
            removeProfileCommentImage(pubId);
        }
    };

    window.removeProfileCommentImage = function(pubId) {
        const fileInput = document.getElementById(`comment-image-input-${pubId}`);
        const previewContainer = document.getElementById(`comment-image-preview-container-${pubId}`);
        const previewImage = document.getElementById(`comment-image-preview-${pubId}`);
        
        fileInput.value = '';
        previewImage.src = '';
        previewContainer.classList.add('d-none');
    };

    // Unified Comment Handling is now delegated to forum.js
    window.loadResponses = function(reclamationId, isSilent = false) {
        const list = document.getElementById(`responses-list-${reclamationId}`);
        if (!list) return;

        // SMART LOADING: Avoid refetching if we have content and it's recent (or just exists)
        const hasContent = list.children.length > 0 && !list.innerHTML.includes('bx-loader-alt');
        const lastFetch = list.dataset.lastFetch || 0;
        const now = Date.now();
        
        // If not silent and we have content fetched less than 30s ago, don't show loader or refetch
        if (!isSilent && hasContent && (now - lastFetch < 30000)) {
            list.scrollTo({ top: list.scrollHeight, behavior: 'auto' });
            return; 
        }

        if (!isSilent && !hasContent) {
            list.innerHTML = `
                <div class="text-center text-white-50 py-5 disc-loader">
                    <i class="bx bx-loader-alt bx-spin fs-3 mb-2"></i>
                    <p>Loading discussion...</p>
                </div>`;
        }

        fetch(`/api/syndicat/reponse/list/${reclamationId}`)
            .then(res => res.json())
            .then(responses => {
                try {
                    if (responses.length === 0) {
                        list.innerHTML = `
                            <div class="text-center text-secondary py-5 opacity-50">
                                <i class='bx bx-message-square-dots fs-3 mb-2'></i>
                                <p>Start the conversation</p>
                            </div>`;
                        return;
                    }

                    const newContent = responses.map(r => {
                        const isMe = r.isMe;
                        return `
                            <div class="d-flex w-100 ${isMe ? 'justify-content-end' : 'justify-content-start'}">
                                <div class="d-flex flex-column ${isMe ? 'align-items-end' : 'align-items-start'}" style="max-width: 80%;">
                                    <div class="d-flex align-items-center gap-2 mb-1 px-1">
                                        <div class="details-author-avatar" style="width: 24px; height: 24px;">
                                            <img src="${r.author.avatar}" alt="${r.author.name}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 6px;" loading="lazy">
                                        </div>
                                        <small class="text-secondary" style="font-size: 0.75rem;">${r.author.name}</small>
                                        <small class="text-secondary opacity-50" style="font-size: 0.7rem;">${r.createdAt}</small>
                                    </div>
                                    <div class="card border-0 shadow-sm p-3 ${isMe ? 'bg-primary text-white' : 'border border-secondary border-opacity-25 text-light'}" 
                                         style="border-radius: 18px; ${isMe ? 'border-bottom-right-radius: 4px;' : 'border-bottom-left-radius: 4px; background-color: #111;'} overflow-wrap: break-word; word-wrap: break-word; word-break: break-word;">
                                        ${r.title ? `<div class="fw-bold mb-1 border-bottom border-white border-opacity-10 pb-1" style="font-size: 0.85rem; overflow-wrap: break-word;">${r.title}</div>` : ''}
                                        <p class="mb-0" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.5; overflow-wrap: break-word;">${r.message}</p>
                                        ${r.images && r.images.length > 0 ? `
                                            <div class="mt-2 pt-2 border-top border-white border-opacity-10 row g-2">
                                                ${r.images.map(img => `
                                                    <div class="col-auto">
                                                        <a href="javascript:void(0)" onclick="openLightbox('${img}')">
                                                                <img src="${img}" class="rounded-3" style="max-height: 40px; width: 40px; object-fit: cover;" loading="lazy">
                                                        </a>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        ` : ''}
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');

                    list.innerHTML = newContent;
                    list.dataset.lastFetch = Date.now();
                    list.scrollTo({ top: list.scrollHeight, behavior: isSilent ? 'smooth' : 'auto' });
                } catch (renderError) { console.error("History Render Error:", renderError); }
            })
            .catch(err => {
                console.error(err);
                if (!isSilent) list.innerHTML = '<div class="text-center text-danger py-4">Failed to load discussion.</div>';
            });
    };

    // Global Submission Handler
    document.body.addEventListener('submit', function(e) {
        if (e.target.classList.contains('reponse-api-form')) {
            e.preventDefault();
            const form = e.target;
            const recId = form.dataset.reclamationId;
            const btn = form.querySelector('button[type="submit"]');
            if (btn.disabled) return;
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            
            fetch(form.action, { method: 'POST', body: new FormData(form) })
            .then(res => res.json())
            .then(data => {
                    if(data.success) {
                        form.reset();
                        const preview = form.querySelector('[id^="image-preview-container-"]');
                        if(preview) { preview.innerHTML = ''; preview.classList.add('d-none'); }
                        
                        // Incremental Update: Just reload the list silently to avoid flicker, 
                        // but force a fetch to show the new message
                        list.dataset.lastFetch = 0; 
                        window.loadResponses(recId, true);
                    } else { alert(data.message || 'Error'); }
                btn.disabled = false; btn.innerHTML = original;
            })
            .catch(err => { console.error(err); btn.disabled = false; btn.innerHTML = original; });
        }
        
        if (e.target.classList.contains('admin-reclamation-edit-form')) {
            e.preventDefault();
            const form = e.target;
            const btn = form.querySelector('button[type="submit"]');
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            fetch(form.action, { method: 'POST', body: new FormData(form) })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const editModalEl = document.getElementById(`adminEditReclamationModal-${recId}`);
                    const editModalBootstrap = bootstrap.Modal.getInstance(editModalEl);
                    if (editModalBootstrap) editModalBootstrap.hide();
                    
                    const formData = new FormData(form);
                    const newTitle = formData.get('title');
                    const newDesc = formData.get('description');
                    const newStatus = formData.get('status');
                    
                    // 1. Update List Item UI
                    const listItem = document.querySelector(`.reclamation-item[data-reclamation-id="${recId}"]`);
                    if (listItem) {
                        const titleEl = listItem.querySelector('h5');
                        if (titleEl) titleEl.textContent = newTitle;
                        const descEl = listItem.querySelector('.reclamation-desc-text');
                        if (descEl) descEl.textContent = newDesc.substring(0, 150) + (newDesc.length > 150 ? '...' : '');
                        
                        // Status Badge in List
                        const listBadge = listItem.querySelector('.status-badge');
                        if (listBadge) {
                            const colors = { 'confirme': '#00e676', 'active': '#00e676', 'en_attente': '#ffeb3b', 'refuse': '#ff3b30', 'annule': '#9e9e9e', 'termine': '#4fc3f7' };
                            const labels = { 'confirme': 'Confirmed', 'active': 'Active', 'en_attente': 'In Progress', 'refuse': 'Rejected', 'annule': 'Cancelled', 'termine': 'Completed' };
                            listBadge.style.background = (colors[newStatus] || '#9e9e9e') + '15';
                            listBadge.style.color = colors[newStatus] || '#9e9e9e';
                            listBadge.style.borderColor = (colors[newStatus] || '#9e9e9e') + '30';
                            listBadge.textContent = labels[newStatus] || newStatus;
                        }
                    }
                    
                    // 2. Update Details Modal UI
                    const detailsModalEl = document.getElementById(`reclamationModal-${recId}`);
                    if (detailsModalEl) {
                        const dTitle = detailsModalEl.querySelector('.modal-title');
                        if (dTitle) dTitle.textContent = newTitle;
                        const dDesc = detailsModalEl.querySelector('.modal-body p');
                        if (dDesc) dDesc.textContent = newDesc;
                        
                        const dBadge = detailsModalEl.querySelector('.badge');
                        if (dBadge) {
                            const colors = { 'confirme': '#00e676', 'active': '#00e676', 'en_attente': '#ffeb3b', 'refuse': '#ff3b30', 'annule': '#9e9e9e', 'termine': '#4fc3f7' };
                            const labels = { 'confirme': 'Confirmed', 'active': 'Active', 'en_attente': 'In Progress', 'refuse': 'Rejected', 'annule': 'Cancelled', 'termine': 'Completed' };
                            dBadge.style.background = (colors[newStatus] || '#9e9e9e') + '15';
                            dBadge.style.color = colors[newStatus] || '#9e9e9e';
                            dBadge.style.borderColor = (colors[newStatus] || '#9e9e9e') + '30';
                            dBadge.textContent = labels[newStatus] || newStatus;
                        }
                        
                        // Show View Modal back
                        setTimeout(() => {
                            const viewModal = new bootstrap.Modal(detailsModalEl);
                            viewModal.show();
                        }, 400);
                    }
                } else { alert(data.message || 'Error'); }
                btn.disabled = false; btn.innerHTML = original;
            })
            .catch(err => { console.error(err); btn.disabled = false; btn.innerHTML = original; });
        }

        // Admin Publication Edit
        if (e.target.classList.contains('admin-publication-edit-form')) {
            e.preventDefault();
            const form = e.target;
            const btn = form.querySelector('button[type="submit"]');
            const original = btn.innerHTML;
            const pubId = form.dataset.publicationId;
            const pubModalEl = document.getElementById(`publicationModal-${pubId}`);
            const editModalEl = document.getElementById(`adminEditPublicationModal-${pubId}`);

            // Clear previous errors
            form.querySelectorAll('.main-home-validation-message').forEach(m => {
                m.classList.remove('error');
                m.textContent = '';
            });
            form.querySelectorAll('.glass-input, .glass-textarea, .glass-select').forEach(i => i.classList.remove('input-error'));

            btn.disabled = true;
            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Saving...';

            const formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Update UI in list
                    const pubItem = document.querySelector(`.publication-item[data-publication-id="${pubId}"]`);
                    if (pubItem) {
                        pubItem.querySelector('h5').textContent = formData.get('titre_pub');
                        pubItem.querySelector('.status-badge').textContent = formData.get('categorie_pub');
                        const desc = formData.get('description_pub');
                        const descEl = pubItem.querySelector('.publication-desc-text');
                        if (descEl) descEl.textContent = desc.length > 150 ? desc.substring(0, 150) + '...' : desc;
                    }

                    // Update UI in View Modal
                    if (pubModalEl) {
                        const titleEl = pubModalEl.querySelector('.modal-title');
                        if (titleEl) titleEl.textContent = formData.get('titre_pub');
                        const badgeEl = pubModalEl.querySelector('.badge');
                        if (badgeEl) badgeEl.textContent = formData.get('categorie_pub');
                        const leadingEl = pubModalEl.querySelector('.leading-relaxed') || pubModalEl.querySelector('p');
                        if (leadingEl) leadingEl.textContent = formData.get('description_pub');
                    }

                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Success', 'Publication updated successfully', 'success');
                    }

                    // Smooth Transition
                    const editModal = bootstrap.Modal.getInstance(editModalEl);
                    if (editModal) {
                        editModal.hide();
                        setTimeout(() => {
                            if (pubModalEl) {
                                new bootstrap.Modal(pubModalEl).show();
                            }
                        }, 400);
                    }
                } else {
                    btn.disabled = false;
                    btn.innerHTML = original;
                    if (data.errors) {
                        Object.entries(data.errors).forEach(([field, msg]) => {
                            // Find container by data-field
                            const container = form.querySelector(`.main-home-validation-message[data-field="${field}"]`) || 
                                              form.querySelector(`#admin-pub-${field}-${pubId}-validation`) ||
                                              form.querySelector(`[data-field$="[${field}]"]`);
                            
                            if (container) {
                                container.textContent = msg;
                                container.classList.add('error', 'active');
                            }
                            
                            const input = form.querySelector(`[name="${field}"]`) || form.querySelector(`[name*="[${field}]"]`);
                            if (input) input.classList.add('input-error');
                        });
                    } else {
                        if (typeof pushNotif === 'function') {
                            pushNotif(data.message || 'Error updating publication', 'ERROR');
                        }
                    }
                }
            })
            .catch(err => {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = original;
            });
        }
    });

    // Modal Trigger for Admin
    document.querySelectorAll('.edit-reclamation-trigger').forEach(trigger => {
        trigger.addEventListener('click', function(e) {
            e.stopPropagation();
            new bootstrap.Modal(document.getElementById(`adminEditReclamationModal-${this.dataset.reclamationId}`)).show();
        });
    });

    // Auto-load on show
    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('show.bs.modal', function() {
            // Reclamations
            const recList = this.querySelector('[id^="responses-list-"]');
            if (recList) window.loadResponses(recList.id.replace('responses-list-', ''));
            
            // Forum
            const forumList = this.querySelector('[id^="comments-list-"]');
            if (forumList) window.loadComments(forumList.id.replace('comments-list-', ''));
        });
    });


    // --- Event Modal Handling ---
    let currentActiveEventData = null;

    document.querySelectorAll('.event-item').forEach(item => {
        item.addEventListener('click', function() {
            const data = this.dataset;
            currentActiveEventData = data;
            
            // Populate View Modal
            document.getElementById('event-modal-title').textContent = data.title;
            document.getElementById('event-modal-description').textContent = data.description;
            document.getElementById('event-modal-date').textContent = data.dateFormatted;
            document.getElementById('event-modal-location').textContent = data.location;
            document.getElementById('event-modal-type').textContent = data.type.charAt(0).toUpperCase() + data.type.slice(1);
            document.getElementById('event-modal-places').textContent = data.places;
            document.getElementById('event-modal-remaining').textContent = data.remaining;
            
            const img = document.getElementById('event-modal-image');
            if (data.image) {
                img.src = data.image;
                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }

            const statusBadge = document.getElementById('event-modal-status');
            const statusColors = { 'planifie': '#4fc3f7', 'en_cours': '#00e676', 'termine': '#9e9e9e', 'annule': '#ff3b30' };
            statusBadge.style.background = (statusColors[data.status] || '#4fc3f7') + '15';
            statusBadge.style.color = statusColors[data.status] || '#4fc3f7';
            statusBadge.style.borderColor = (statusColors[data.status] || '#4fc3f7') + '30';
            statusBadge.textContent = data.status.replace('_', ' ').charAt(0).toUpperCase() + data.status.replace('_', ' ').slice(1);

            // Admin Logic
            const moderatorRoles = ['OWNER', 'ADMIN', 'SUPERADMIN', 'SYNDIC'];
            const userRole = '{{ user.roleUser|default('') }}';
            const isModerator = moderatorRoles.includes(userRole);
            const isOwner = data.userId == currentUserId;

            if (isModerator || isOwner) {
                document.getElementById('event-modal-admin-actions').classList.remove('d-none');
            } else {
                document.getElementById('event-modal-admin-actions').classList.add('d-none');
            }

            new bootstrap.Modal(document.getElementById('eventViewModal')).show();
        });
    });

    document.getElementById('btn-edit-event').addEventListener('click', function() {
        if (!currentActiveEventData) return;
        const data = currentActiveEventData;

        document.getElementById('edit-event-id').value = data.eventId;
        document.getElementById('edit-event-title').value = data.title;
        document.getElementById('edit-event-description').value = data.description;
        document.getElementById('edit-event-date').value = data.date;
        document.getElementById('edit-event-location').value = data.location;
        document.getElementById('edit-event-places').value = data.places;
        document.getElementById('edit-event-remaining').value = data.remaining;
        document.getElementById('edit-event-type').value = data.type;
        document.getElementById('edit-event-status').value = data.status;

        bootstrap.Modal.getInstance(document.getElementById('eventViewModal')).hide();
        setTimeout(() => {
            new bootstrap.Modal(document.getElementById('eventEditModal')).show();
        }, 400);
    });

    // Profile Comment Submission AJAX
    document.querySelectorAll('.comment-submission-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const pubId = this.dataset.publicationId;
            const btn = this.querySelector('button[type="submit"]');
            const original = btn.innerHTML;
            const textarea = this.querySelector('textarea[name="description"]');
            const validationDiv = document.getElementById(`comment-description-${pubId}-validation`);

            // Clear previous errors
            if (validationDiv) {
                validationDiv.textContent = '';
                validationDiv.classList.remove('error');
            }
            textarea.classList.remove('input-error');

            btn.disabled = true;
            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i>';

            const formData = new FormData(this);
            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (typeof showCoolPopup === 'function') {
                        showCoolPopup('Success', 'Comment posted!', 'success');
                    }
                    this.reset();
                    // Optional: Refresh comments via window.loadComments if available
                    if (typeof window.loadComments === 'function') {
                        window.loadComments(pubId);
                    } else if (typeof window.switchPublicationView === 'function') {
                         window.switchPublicationView(pubId); // Re-triggering view might reload comments
                    }
                } else {
                    if (data.errors && Array.isArray(data.errors)) {
                        data.errors.forEach(errStr => {
                            if (validationDiv) {
                                validationDiv.textContent = errStr;
                                validationDiv.classList.add('error');
                            }
                            textarea.classList.add('input-error');
                            if (typeof showCoolPopup === 'function') {
                                showCoolPopup('Validation Error', errStr, 'error');
                            }
                        });
                    } else {
                        if (typeof pushNotif === 'function') {
                            pushNotif(data.message || 'Error posting comment', 'ERROR');
                        }
                    }
                }
                btn.disabled = false;
                btn.innerHTML = original;
            })
            .catch(err => {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = original;
            });
        });
    });

    document.getElementById('event-edit-form').addEventListener('submit', function(e) {
        e.preventDefault();
        const form = this;
        const btn = document.getElementById('save-event-btn');
        const original = btn.innerHTML;
        const eventId = document.getElementById('edit-event-id').value;

        // Clear previous errors
        form.querySelectorAll('.main-home-validation-message').forEach(m => {
            m.classList.remove('error');
            m.textContent = '';
        });
        form.querySelectorAll('.glass-input, .glass-textarea, .glass-select').forEach(i => i.classList.remove('input-error'));

        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Saving...';

        const formData = new FormData(form);
        fetch(`/api/evenement/update/${eventId}`, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Update specific event item in list
                const item = document.querySelector(`.event-item[data-event-id="${eventId}"]`);
                if (item) {
                    item.dataset.title = formData.get('titre_event');
                    item.dataset.description = formData.get('description_event');
                    item.dataset.location = formData.get('lieu_event');
                    item.dataset.date = formData.get('date_event');
                    item.dataset.status = formData.get('statut_event');
                    item.dataset.type = formData.get('type_event');
                    item.dataset.places = formData.get('nb_places');
                    item.dataset.remaining = formData.get('nb_restants');
                    
                    if (data.data.image) {
                        item.dataset.image = data.data.image;
                        const img = item.querySelector('.event-list-image-wrap img');
                        if (img) img.src = data.data.image;
                        else {
                            const wrap = item.querySelector('.event-list-image-wrap');
                            wrap.innerHTML = `<img src="${data.data.image}" alt="${data.data.title}" style="width: 100%; height: 100%; object-fit: cover;">`;
                            wrap.classList.remove('d-flex', 'align-items-center', 'justify-content-center');
                            wrap.style.borderStyle = 'solid';
                        }
                    }

                    item.querySelector('h5').textContent = data.data.title;
                    item.querySelector('.reclamation-status-text i.bx-calendar').nextSibling.textContent = ' ' + data.data.date;
                    item.querySelector('.reclamation-status-text i.bx-map').nextSibling.textContent = ' ' + formData.get('lieu_event');
                    item.querySelector('.reclamation-desc-text').textContent = data.data.description.substring(0, 100) + (data.data.description.length > 100 ? '...' : '');
                    
                    const listBadge = item.querySelector('.status-badge');
                    const statusColors = { 'planifie': '#4fc3f7', 'en_cours': '#00e676', 'termine': '#9e9e9e', 'annule': '#ff3b30' };
                    listBadge.style.background = (statusColors[data.data.status] || '#4fc3f7') + '15';
                    listBadge.style.color = statusColors[data.data.status] || '#4fc3f7';
                    listBadge.style.borderColor = (statusColors[data.data.status] || '#4fc3f7') + '30';
                    listBadge.textContent = data.data.status.replace('_', ' ').charAt(0).toUpperCase() + data.data.status.replace('_', ' ').slice(1);
                    
                    item.querySelector('.bx-purchase-tag-alt').nextSibling.textContent = ' ' + formData.get('type_event').charAt(0).toUpperCase() + formData.get('type_event').slice(1);
                    item.querySelector('.bx-user').nextSibling.textContent = ` ${item.dataset.remaining}/${formData.get('nb_places')} enrolled`;
                }

                if (typeof showCoolPopup === 'function') {
                    showCoolPopup('Success', 'Event updated successfully', 'success');
                }

                bootstrap.Modal.getInstance(document.getElementById('eventEditModal')).hide();
                // Optionally re-open view modal with updated data
                setTimeout(() => {
                    const item = document.querySelector(`.event-item[data-event-id="${eventId}"]`);
                    if (item) item.click();
                }, 400);
            } else {
                btn.disabled = false;
                btn.innerHTML = original;
                if (data.errors && Array.isArray(data.errors)) {
                    data.errors.forEach(errStr => {
                        if (typeof showCoolPopup === 'function') {
                            showCoolPopup('Validation Error', errStr, 'error');
                        }
                        // Map to specific container if possible
                        const lower = errStr.toLowerCase();
                        let field = '';
                        if (lower.includes('title')) field = 'title';
                        else if (lower.includes('description')) field = 'description';
                        else if (lower.includes('date')) field = 'date';
                        else if (lower.includes('location') || lower.includes('venue')) field = 'location';

                        if (field) {
                            const el = document.getElementById(`edit-event-${field}-validation`);
                            if (el) { el.textContent = errStr; el.classList.add('error'); }
                            const input = form.querySelector(`[name*="${field}"]`);
                            if (input) input.classList.add('input-error');
                        }
                    });
                } else {
                    if (typeof pushNotif === 'function') {
                        pushNotif(data.message || 'Error updating event', 'ERROR');
                    }
                }
            }
            btn.disabled = false; btn.innerHTML = original;
        })
        .catch(err => {
            console.error(err);
            btn.disabled = false;
            btn.innerHTML = original;
        });
    });

    // Admin Filter logic for all tabs
    function handleAdminFilter(btnClass, filterVarSetter, initFunc) {
        document.querySelectorAll('.' + btnClass).forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.' + btnClass).forEach(b => {
                    b.classList.remove('active', 'btn-primary');
                    b.classList.add('btn-outline-light');
                });
                this.classList.remove('btn-outline-light');
                this.classList.add('active', 'btn-primary');
                filterVarSetter(this.dataset.filter);
                initFunc();
            });
        });
    }

    if (isAdmin) {
        handleAdminFilter('admin-reclamation-filter-btn', (val) => { currentAdminFilter = val; }, window.initializeReclamationPagination);
        handleAdminFilter('admin-forum-filter-btn', (val) => { currentForumAdminFilter = val; }, window.initializeForumPagination);
        handleAdminFilter('admin-events-filter-btn', (val) => { currentEventAdminFilter = val; }, window.initializeEventsPagination);

        // Residence Filter Logic
        const residenceItems = document.querySelectorAll('.residence-item');
        document.querySelectorAll('.admin-residence-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if (this.classList.contains('active')) return;

                document.querySelectorAll('.admin-residence-filter-btn').forEach(b => {
                    b.classList.remove('active', 'btn-primary');
                    b.classList.add('btn-outline-light');
                });
                this.classList.remove('btn-outline-light');
                this.classList.add('active', 'btn-primary');

                currentResidenceFilter = this.dataset.filter;
                
                // Apply filter
                residenceItems.forEach(item => {
                    if (currentResidenceFilter === 'all') {
                        item.style.display = 'block';
                        item.nextElementSibling && (item.nextElementSibling.style.display = 'block'); // Show HR
                    } else {
                        const itemUserId = String(item.dataset.userId);
                        const currentId = String(currentUserId);
                        if (itemUserId === currentId) {
                            item.style.display = 'block';
                            item.nextElementSibling && (item.nextElementSibling.style.display = 'block');
                        } else {
                            item.style.display = 'none';
                            item.nextElementSibling && (item.nextElementSibling.style.display = 'none');
                        }
                    }
                });
            });
        });
    }

    });
    </script>

    {% include 'frontend/video_conference/_modal.html.twig' %}

    <!-- Face ID Scripts: load from local first so faceapi is always defined (CDN can fail or return HTML) -->
