<script>
// Search functionality
document.addEventListener('DOMContentLoaded', function() {
    const searchBtn = document.querySelector('.main-home-search-icon-btn');
    const searchExpand = document.querySelector('.main-home-search-expand');
    const searchInput = document.querySelector('.main-home-search-input');
    
    if (searchBtn && searchExpand && searchInput) {
        searchBtn.addEventListener('click', function() {
            searchExpand.classList.toggle('active');
            if (searchExpand.classList.contains('active')) {
                searchInput.focus();
            }
        });
        
        // Close search when clicking outside
        document.addEventListener('click', function(e) {
            if (!searchBtn.contains(e.target) && !searchExpand.contains(e.target)) {
                searchExpand.classList.remove('active');
            }
        });
    }
});

// Profile dropdown functionality
document.addEventListener('DOMContentLoaded', function() {
    const profileDropdown = document.querySelector('.main-home-user-profile-dropdown');
    const avatarOnly = document.querySelector('.main-home-user-avatar-only');
    const dropdown = document.querySelector('.main-home-profile-dropdown');
    
    if (avatarOnly && dropdown) {
        avatarOnly.addEventListener('click', function(e) {
            e.stopPropagation();
            dropdown.classList.toggle('active');
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!profileDropdown.contains(e.target)) {
                dropdown.classList.remove('active');
            }
        });
    }
});

// Tab dropdown functionality
function initTabDropdowns() {
    const navTabs = document.querySelectorAll('.main-home-nav-tab');
    let hoverTimeout;
    let isHovering = false;
    
    function closeAllDropdowns() {
        navTabs.forEach(tab => {
            const dropdown = tab.querySelector('.main-home-tab-dropdown');
            if (dropdown) {
                dropdown.style.display = 'none';
            }
        });
    }
    
    navTabs.forEach(tab => {
        const dropdown = tab.querySelector('.main-home-tab-dropdown');
        const tabText = tab.querySelector('.main-home-tab-text');
        const homeLink = tabText.querySelector('a');
        
        // Handle Home tab (has link, no dropdown)
        if (homeLink) {
            // Home tab should behave like other tabs but navigate on click
            tabText.addEventListener('click', function(e) {
                // Let the link handle navigation naturally
                // No preventDefault needed
            });
            
            // No hover dropdown functionality for Home tab
            return;
        }
        
        // Only add dropdown functionality to tabs that have dropdowns
        if (!dropdown) {
            return;
        }
        
        // Click to toggle dropdown
        tabText.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const isOpen = dropdown.style.display === 'block';
            closeAllDropdowns();
            
            if (!isOpen) {
                dropdown.style.display = 'block';
            }
        });
        
        // Hover to show dropdown - more reliable
        tab.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            isHovering = true;
            closeAllDropdowns();
            dropdown.style.display = 'block';
        });
        
        // Hover to hide dropdown with delay
        tab.addEventListener('mouseleave', function() {
            isHovering = false;
            hoverTimeout = setTimeout(() => {
                if (!isHovering) {
                    dropdown.style.display = 'none';
                }
            }, 300); // Increased delay for better UX
        });
        
        // Keep dropdown open when hovering over it
        dropdown.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            isHovering = true;
        });
        
        dropdown.addEventListener('mouseleave', function() {
            isHovering = false;
            hoverTimeout = setTimeout(() => {
                if (!isHovering) {
                    dropdown.style.display = 'none';
                }
            }, 300);
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!tab.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    });
}

// Initialize tab dropdowns when page loads
document.addEventListener('DOMContentLoaded', function() {
    initTabDropdowns();
});

// Interactive 3D Globe - Fresh Start
document.addEventListener('DOMContentLoaded', function() {
    // Load Three.js from CDN
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
    script.onload = function() {
        initGlobe();
    };
    document.head.appendChild(script);
});

function initGlobe() {
    const container = document.getElementById('globe-container');
    if (!container) return;

    // Scene setup
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, container.offsetWidth / container.offsetHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    
    renderer.setSize(container.offsetWidth, container.offsetHeight);
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);

    // Create globe
    const globeGeometry = new THREE.SphereGeometry(2, 64, 64);
    
    // Simple world map texture
    const canvas = document.createElement('canvas');
    canvas.width = 1024;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    
    // Ocean background
    ctx.fillStyle = '#0066cc';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Continents
    ctx.fillStyle = '#228B22';
    drawContinents(ctx, canvas.width, canvas.height);
    
    const texture = new THREE.CanvasTexture(canvas);
    const globeMaterial = new THREE.MeshPhongMaterial({ 
        map: texture
    });
    
    const globe = new THREE.Mesh(globeGeometry, globeMaterial);
    scene.add(globe);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x404040, 0.6);
    scene.add(ambientLight);
    
    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
    directionalLight.position.set(5, 5, 5);
    scene.add(directionalLight);

    // Camera position
    camera.position.z = 5;

    // Mouse controls
    let mouseX = 0, mouseY = 0;
    let targetRotationX = 0, targetRotationY = 0;
    let isMouseDown = false;

    container.addEventListener('mousedown', (e) => {
        isMouseDown = true;
        mouseX = e.clientX;
        mouseY = e.clientY;
    });

    container.addEventListener('mouseup', () => {
        isMouseDown = false;
    });

    container.addEventListener('mousemove', (e) => {
        if (isMouseDown) {
            const deltaX = e.clientX - mouseX;
            const deltaY = e.clientY - mouseY;
            
            targetRotationY += deltaX * 0.01;
            targetRotationX += deltaY * 0.01;
            
            mouseX = e.clientX;
            mouseY = e.clientY;
        }
    });

    // Auto-rotation
    let autoRotation = 0.005;

    // Animation loop
    function animate() {
        requestAnimationFrame(animate);
        
        // Smooth rotation
        globe.rotation.y += (targetRotationY - globe.rotation.y) * 0.1;
        globe.rotation.x += (targetRotationX - globe.rotation.x) * 0.1;
        
        // Auto-rotation when not interacting
        if (!isMouseDown) {
            globe.rotation.y += autoRotation;
        }
        
        renderer.render(scene, camera);
    }

    // Handle window resize
    window.addEventListener('resize', () => {
        camera.aspect = container.offsetWidth / container.offsetHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.offsetWidth, container.offsetHeight);
    });

    animate();
}

function drawContinents(ctx, width, height) {
    // Draw simple continent shapes
    
    // North America
    ctx.beginPath();
    ctx.ellipse(width * 0.2, height * 0.4, width * 0.12, height * 0.2, 0, 0, 2 * Math.PI);
    ctx.fill();
    
    // South America
    ctx.beginPath();
    ctx.ellipse(width * 0.3, height * 0.75, width * 0.06, height * 0.15, 0, 0, 2 * Math.PI);
    ctx.fill();
    
    // Europe
    ctx.beginPath();
    ctx.ellipse(width * 0.5, height * 0.25, width * 0.05, height * 0.08, 0, 0, 2 * Math.PI);
    ctx.fill();
    
    // Africa
    ctx.beginPath();
    ctx.ellipse(width * 0.52, height * 0.55, width * 0.04, height * 0.15, 0, 0, 2 * Math.PI);
    ctx.fill();
    
    // Asia
    ctx.beginPath();
    ctx.ellipse(width * 0.75, height * 0.35, width * 0.18, height * 0.2, 0, 0, 2 * Math.PI);
    ctx.fill();
    // Australia
    ctx.beginPath();
    ctx.ellipse(width * 0.8, height * 0.8, width * 0.08, height * 0.05, 0, 0, 2 * Math.PI);
    ctx.fill();
}

</script>
