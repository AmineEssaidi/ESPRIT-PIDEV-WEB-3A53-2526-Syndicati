{% extends 'base_symfony.html.twig' %}
{% block title %}Events - Explore What's Happening{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/evenement.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/evenement-form-custom.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
    <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
    <!-- Leaflet Map -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
    <style>
        .leaflet-container {
            background: rgba(255,255,255,0.05);
            height: 200px !important;
            width: 100% !important;
            border-radius: 12px;
            margin-top: 1rem;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .custom-map-marker {
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--event-gradient);
            border: 2px solid #fff;
            border-radius: 50%;
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 0 15px rgba(var(--main-home-accent-rgb), 0.5);
            width: 32px !important;
            height: 32px !important;
        }
        .leaflet-popup-content-wrapper {
            background: rgba(15, 15, 25, 0.95) !important;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px !important;
            color: #fff !important;
        }
        .leaflet-popup-tip {
            background: rgba(15, 15, 25, 0.95) !important;
        }
        .marker-popup-content h6 {
            font-weight: 800;
            color: var(--event-accent);
            margin: 0 0 5px 0;
        }
        .marker-popup-content p {
            font-size: 0.8rem;
            opacity: 0.7;
            margin: 0 0 10px 0;
            line-height: 1.3;
        }
        .btn-navigate {
            display: block;
            text-align: center;
            padding: 4px 8px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px;
            color: #fff !important;
            text-decoration: none !important;
            font-size: 0.75rem;
            font-weight: 700;
            transition: 0.2s;
        }
        .btn-navigate:hover {
            background: var(--event-gradient);
            border-color: transparent;
        }

        /* Validation Styles (Sign-Up Style) */
        .main-home-validation-message {
            font-size: 0.8rem;
            margin-top: 0.4rem;
            font-weight: 600;
            min-height: 1.2rem;
            transition: all 0.2s;
            display: block;
        }
        .main-home-validation-message.error {
            color: #ff4d4d !important;
        }
        .main-home-validation-message.success {
            color: #2ed573 !important;
        }
        .glass-input.input-error {
            border-color: #ff4d4d !important;
            background: rgba(255, 77, 77, 0.05) !important;
            box-shadow: 0 0 0 4px rgba(255, 77, 77, 0.1) !important;
        }
        .glass-input.input-success {
            border-color: #2ed573 !important;
            background: rgba(46, 213, 115, 0.05) !important;
            box-shadow: 0 0 0 4px rgba(46, 213, 115, 0.1) !important;
        }
    </style>
{% endblock %}

{% block body %}
<div class="main-home-layout-wrapper">
    <div class="main-home-page">
        {% include 'frontend/shared/_main_navbar.html.twig' with {'active_tab': 'evenement'} %}
        
        <div class="main-home-page-content" style="padding: 2rem 0;">
            <!-- Hero Section -->
            <div class="event-hero-section">
                <div class="event-hero-bg-glow"></div>
                <div class="event-bg-glow-secondary"></div>
                
                <div class="container position-relative" style="z-index: 2;">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <span class="event-hero-badge">
                                <i class='bx bxs-zap'></i> Community Experiences
                            </span>
                            <h1 class="event-hero-title">Discover. Connect.<br>Experience.</h1>
                            <p class="event-hero-subtitle">Join exclusive events, workshops, and gatherings designed for our community. Your next great story starts here.</p>
                            
                            <div class="d-flex gap-3 mt-4">
                                <a href="#events" class="btn-event-action" style="padding: 1rem 2.5rem; font-size: 1rem;">Explore Events</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Event Content -->
            <div id="events" class="pb-5">
                
                <!-- 1. PERMANENT DASHBOARD (Formerly Empty State) -->
                <div class="forum-empty-state mb-5">
                    <!-- Mini Hero Glows -->
                    <div class="event-hero-bg-glow" style="opacity: 0.4;"></div>
                    <div class="event-bg-glow-secondary" style="opacity: 0.3;"></div>
                    
                    <!-- Left Column: Dynamic Messaging -->
                    <div class="empty-state-left">
                        <span class="event-section-pill" style="margin-bottom: 2rem;">
                            <i class='bx bx-calendar-event'></i> Event Dashboard
                        </span>
                        
                        {% if evenements|length > 0 %}
                            <h3 class="event-hero-title" style="font-size: 3rem; margin-bottom: 1.5rem;">Join the Action.<br>{{ evenements|length }} Events Upcoming.</h3>
                            <p class="event-hero-subtitle" style="margin: 0 0 3rem 0; width: 100%; max-width: 500px;">The community is buzzing! Browse the events below and secure your spot before they fill up.</p>
                        {% else %}
                            <h3 class="event-hero-title" style="font-size: 3rem; margin-bottom: 1.5rem;">The Stage is Set...<br>Awaiting Your Pulse.</h3>
                            <p class="event-hero-subtitle" style="margin: 0 0 3rem 0; width: 100%; max-width: 500px;">It looks like there are no events scheduled at the moment. Be the heartbeat of our community and organize something truly legendary.</p>
                        {% endif %}
                        
                        <div class="d-flex gap-3 mt-4">
                                <div class="main-home-made-with-love" style="background: rgba(255,255,255,0.02); padding: 1rem 2rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.05);">
                                <span style="color: rgba(255,255,255,0.5); font-size: 0.9rem;">Join 500+ members in our next gathering</span>
                                </div>
                        </div>
                    </div>

                    <!-- Right Column: Interactive Dashboard & Actions -->
                    <div id="evenementDashboardSwitcher" class="empty-state-right glass-switcher style-slide">
                        
                        <!-- FACE 1: DASHBOARD MAIN -->
                        <div class="glass-switcher-face glass-switcher-face-main glass-dashboard-card">
                            {% if app.session.get('is_logged_in') %}
                                <div id="btnHostEventDashboard" class="event-host-pill-trigger">
                                    <div style="width: 40px; height: 40px; background: var(--event-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                                        <i class='bx bx-plus'></i>
                                    </div>
                                    <div class="text-start">
                                        <div style="font-size: 0.95rem; font-weight: 800;">Host an Event</div>
                                        <div style="font-size: 0.75rem; color: rgba(255,255,255,0.4); font-weight: 600;">Start your community journey</div>
                                    </div>
                                    <i class='bx bx-chevron-right' style="margin-left: auto; font-size: 1.5rem; opacity: 0.5;"></i>
                                </div>
                            {% endif %}

                            <!-- Mini Glass Calendar -->
                            <div class="glass-calendar">
                                <div class="calendar-header">
                                    <div class="calendar-month" id="calendarMonthDisplay">{{ "now"|date("F Y") }}</div>
                                    <div class="d-flex gap-2">
                                        <i class='bx bx-chevron-left' id="prevMonth" style="cursor: pointer; opacity: 0.5;"></i>
                                        <i class='bx bx-chevron-right' id="nextMonth" style="cursor: pointer; opacity: 0.5;"></i>
                                    </div>
                                </div>
                                <div class="calendar-grid" id="calendarGrid">
                                    <!-- Days labels -->
                                    <div class="calendar-day-label">Mo</div>
                                    <div class="calendar-day-label">Tu</div>
                                    <div class="calendar-day-label">We</div>
                                    <div class="calendar-day-label">Th</div>
                                    <div class="calendar-day-label">Fr</div>
                                    <div class="calendar-day-label">Sa</div>
                                    <div class="calendar-day-label">Su</div>
                                    
                                    <!-- Days will be injected by JS -->
                                </div>
                                <!-- Category Insight Pills -->
                                <div class="category-tags-list">
                                    <span class="tag-pill">#Workshops</span>
                                    <span class="tag-pill">#Meetups</span>
                                    <span class="tag-pill">#Social</span>
                                    <span class="tag-pill">#Sports</span>
                                    <span class="tag-pill" style="background: rgba(var(--main-home-accent-rgb), 0.1); border-color: rgba(var(--main-home-accent-rgb), 0.2); color: #fff;">+ {{ evenements|length }} Events</span>
                                </div>
                            </div>
                        </div>

                        <!-- FACE 2: HOST EVENT FORM -->
                        <div class="glass-switcher-face glass-switcher-face-extra glass-dashboard-card">
                            <div class="organize-header mb-4">
                                <div>
                                    <h3 class="organize-title">Organize Event</h3>
                                    <p class="organize-subtitle">Share your vision with the community</p>
                                </div>
                                <button class="btn-switcher-back" onclick="switchGlassCard('evenementDashboardSwitcher', 'main')">
                                    <i class='bx bx-x'></i>
                                </button>
                            </div>

                            <div class="glass-switcher-content-scroll" style="max-height: 520px; overflow-y: auto; overflow-x: hidden; padding-right: 12px;">
                                {{ form_start(form, {'action': path('app_evenement_new'), 'attr': {'class': 'main-home-auth-form organize-form', 'enctype': 'multipart/form-data', 'id': 'createEventFormDashboard', 'data-ajax': 'true'}}) }}
                                    <div class="glass-form-group">
                                        <label class="glass-label">Event Title</label>
                                        {{ form_widget(form.titre_event, {'attr': {'class': 'glass-input', 'placeholder': 'e.g. Sunset Rooftop Gathering', 'minlength': '5', 'required': 'required'}}) }}
                                        <div class="main-home-validation-message" data-field="titre_event"></div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="glass-form-group">
                                                <label class="glass-label">Date & Time</label>
                                                {{ form_widget(form.date_event, {'attr': {'class': 'glass-input flatpickr-input', 'placeholder': 'When?', 'required': 'required'}}) }}
                                                <div class="main-home-validation-message" data-field="date_event"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="glass-form-group">
                                                <label class="glass-label">Event Type</label>
                                                <div class="custom-select-wrapper">
                                                    <select name="{{ form.type_event.vars.full_name }}" id="{{ form.type_event.vars.id }}_dashboard" class="glass-input">
                                                        {% for choice in form.type_event.vars.choices %}
                                                            <option value="{{ choice.value }}">{{ choice.value|replace({'_': ' '})|title }}</option>
                                                        {% endfor %}
                                                    </select>
                                                    {% do form.type_event.setRendered %}
                                                </div>
                                                <div class="main-home-validation-message" data-field="type_event"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="glass-form-group">
                                        <label class="glass-label">Location</label>
                                        {{ form_widget(form.lieu_event, {'attr': {'class': 'glass-input', 'placeholder': 'Where is the magic happening?', 'required': 'required'}}) }}
                                        <div class="main-home-validation-message" data-field="lieu_event"></div>
                                    </div>

                                    <div class="glass-form-group">
                                        <label class="glass-label">Description</label>
                                        {{ form_widget(form.description_event, {'attr': {'class': 'glass-input', 'placeholder': 'What makes this event special?', 'rows': '3', 'minlength': '10', 'required': 'required'}}) }}
                                        <div class="main-home-validation-message" data-field="description_event"></div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="glass-form-group">
                                                <label class="glass-label">Total Places</label>
                                                {{ form_widget(form.nb_places, {'attr': {'class': 'glass-input', 'required': 'required', 'min': '1'}}) }}
                                                <div class="main-home-validation-message" data-field="nb_places"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="glass-form-group">
                                                <label class="glass-label">Initial Remaining</label>
                                                {{ form_widget(form.nb_restants, {'attr': {'class': 'glass-input', 'required': 'required', 'min': '0'}}) }}
                                                <div class="main-home-validation-message" data-field="nb_restants"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="glass-form-group">
                                        <label class="glass-label">Event Banner</label>
                                        <div class="custom-file-upload">
                                            {{ form_widget(form.image_event, {'attr': {'class': 'glass-input'}}) }}
                                        </div>
                                        <div class="main-home-validation-message" data-field="image_event"></div>
                                    </div>

                                    <button type="submit" class="main-home-btn-auth-submit w-100 mt-4" style="margin: 0; height: 60px; font-size: 1.1rem; letter-spacing: 0.5px;">
                                        Organize Now <i class='bx bx-rocket ms-2'></i>
                                    </button>

                                    {% do form.statut_event.setRendered %}
                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>

                        {# Pass detailed event data to JS for calendar previews #}
                        <script>
                            window.calendarEvents = {
                                {% for event in evenements %}
                                    "{{ event.dateEvent|date('Y-m-d') }}": {
                                        "id": "{{ event.id }}",
                                        "title": "{{ event.titreEvent }}",
                                        "image": "{{ event.imageEvent ? asset('event_images/' ~ event.imageEvent) : '' }}",
                                        "type": "{{ event.typeEvent }}",
                                        "lieu": "{{ event.lieuEvent }}",
                                        "date": "{{ event.dateEvent|date('F d, Y • H:i') }}"
                                    }{% if not loop.last %},{% endif %}
                                {% endfor %}
                            };
                        </script>

                        </div>
                    </div>
                </div>

                <!-- Floating Event Preview -->
                <div id="calendarEventPreview" class="calendar-event-preview">
                    <div class="preview-card">
                        <div class="preview-banner" id="previewBanner"></div>
                        <div class="preview-content">
                            <span class="preview-tag" id="previewType"></span>
                            <h4 class="preview-title" id="previewTitle"></h4>
                            <div class="preview-meta">
                                <i class='bx bx-time-five'></i> <span id="previewDate"></span>
                            </div>
                            <button class="preview-btn" id="previewViewBtn">View Details</button>
                        </div>
                    </div>
                </div>

                <!-- 2. EVENTS GRID (Below) -->
                {% if evenements|length > 0 %}
                    <div style="padding: 0 3rem;">
                        <div class="mb-4 d-flex justify-content-between align-items-center">
                            <span class="event-section-pill">
                                <i class='bx bx-calendar-check'></i> Upcoming Events
                            </span>
                            <div class="event-pagination-info" id="eventPaginationInfo">
                                <span style="color: rgba(255,255,255,0.5); font-size: 0.9rem;">Showing <span id="currentEventRange"></span> of {{ evenements|length }}</span>
                            </div>
                        </div>
                        
                        <div class="event-grid" id="eventGrid">
                            {% for evenement in evenements %}
                                {% include 'frontend/evenement/_card.html.twig' with {'evenement': evenement} %}
                            {% endfor %}
                        </div>
                        
                        <div class="event-pagination-controls" id="eventPaginationControls">
                            <button class="event-pagination-btn" id="prevEventPage" disabled>
                                <i class='bx bx-chevron-left'></i>
                            </button>
                            <div class="event-pagination-pages" id="eventPaginationPages"></div>
                            <button class="event-pagination-btn" id="nextEventPage">
                                <i class='bx bx-chevron-right'></i>
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>

        </div>

        {% include 'frontend/shared/_main_footer.html.twig' %}
        <div style="height: 120px; width: 100%;"></div>
    </div>
</div>

{# Legacy editEventModal removed to favor in-card switcher #}


<input type="hidden" id="currentUserId" value="{{ currentUserId }}">
<input type="hidden" id="currentUserRole" value="{{ currentUserRole }}">

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script src="{{ asset('frontend/js/evenement.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Flatpickr
            flatpickr(".flatpickr-input", {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                theme: "dark",
                disableMobile: "true"
            });

            // Pagination Logic for Event Cards
            const cardsPerPage = 3;
            let currentPage = 1;
            const eventGrid = document.getElementById('eventGrid');
            if (eventGrid) {
                const cards = eventGrid.querySelectorAll('.event-card');
                const totalPages = Math.ceil(cards.length / cardsPerPage);

                function updatePagination() {
                    const start = (currentPage - 1) * cardsPerPage;
                    const end = start + cardsPerPage;

                    cards.forEach((card, index) => {
                        if (index >= start && index < end) {
                            card.style.display = 'block';
                            setTimeout(() => { card.style.opacity = '1'; }, 10);
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    // Update range text
                    const rangeDisplay = document.getElementById('currentEventRange');
                    if (rangeDisplay) {
                        rangeDisplay.textContent = cards.length > 0 ? `${start + 1}-${Math.min(end, cards.length)}` : '0-0';
                    }

                    // Update buttons
                    const prevBtn = document.getElementById('prevEventPage');
                    const nextBtn = document.getElementById('nextEventPage');
                    if (prevBtn) prevBtn.disabled = currentPage === 1;
                    if (nextBtn) nextBtn.disabled = currentPage === totalPages || totalPages === 0;

                    // Update page numbers
                    const pagesContainer = document.getElementById('eventPaginationPages');
                    if (pagesContainer) {
                        pagesContainer.innerHTML = '';
                        for (let i = 1; i <= totalPages; i++) {
                            const btn = document.createElement('button');
                            btn.className = `event-pagination-btn ${i === currentPage ? 'active' : ''}`;
                            btn.textContent = i;
                            btn.onclick = () => {
                                currentPage = i;
                                updatePagination();
                                // Smarter scroll: only if card is out of view
                                const gridRect = eventGrid.getBoundingClientRect();
                                if (gridRect.top < 0 || gridRect.bottom > window.innerHeight) {
                                    window.scrollTo({
                                        top: window.pageYOffset + gridRect.top - 100,
                                        behavior: 'smooth'
                                    });
                                }
                            };
                            pagesContainer.appendChild(btn);
                        }
                    }
                }

                const prevBtn = document.getElementById('prevEventPage');
                const nextBtn = document.getElementById('nextEventPage');
                if (prevBtn) prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; updatePagination(); document.getElementById('events').scrollIntoView({ behavior: 'smooth' }); } };
                if (nextBtn) nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; updatePagination(); document.getElementById('events').scrollIntoView({ behavior: 'smooth' }); } };

                if (cards.length > 0) updatePagination();
                else {
                    const controls = document.getElementById('eventPaginationControls');
                    if (controls) controls.style.display = 'none';
                    const info = document.getElementById('eventPaginationInfo');
                    if (info) info.style.display = 'none';
                }
            }
        });
    </script>
{% endblock %}
{% endblock %}
