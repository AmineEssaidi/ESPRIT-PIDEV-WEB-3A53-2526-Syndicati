{% extends 'base_symfony.html.twig' %}
{% block title %}Events - Explore What's Happening{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/evenement.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/evenement-form-custom.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
    <!-- Leaflet Map - Using Cloudflare CDN for reliability -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
    <style>
        .leaflet-container {
            background: rgba(255,255,255,0.05);
            height: 300px !important;
            width: 100% !important;
            border-radius: 15px;
            margin-top: 1rem;
            border: 1px solid rgba(255,255,255,0.1);
            position: relative;
        }
        .leaflet-container::after {
            content: "Map Loading...";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: rgba(255,255,255,0.3);
            z-index: 0;
        }
        /* Fix for Leaflet visibility */
        .leaflet-pane { z-index: 400 !important; }
        .leaflet-tile-pane { z-index: 200 !important; }
        .leaflet-map-pane canvas { z-index: 100 !important; }
        .leaflet-map-pane svg { z-index: 100 !important; }
        .leaflet-top, .leaflet-bottom { z-index: 1000 !important; }
    </style>
{% endblock %}

{% block body %}
<div class="main-home-layout-wrapper">
    <div class="main-home-page">
        {% include 'frontend/shared/_main_navbar.html.twig' with {'active_tab': 'evenement'} %}
        
        <div class="main-home-page-content" style="padding: 2rem 0;">
            <!-- Hero Section -->
            <div class="event-hero-section">
                <div class="event-hero-bg-glow"></div>
                <div class="event-bg-glow-secondary"></div>
                
                <div class="container position-relative" style="z-index: 2;">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <span class="event-hero-badge">
                                <i class='bx bxs-zap'></i> Community Experiences
                            </span>
                            <h1 class="event-hero-title">Discover. Connect.<br>Experience.</h1>
                            <p class="event-hero-subtitle">Join exclusive events, workshops, and gatherings designed for our community. Your next great story starts here.</p>
                            
                            <div class="d-flex gap-3 mt-4">
                                <a href="#events" class="btn-event-action" style="padding: 1rem 2.5rem; font-size: 1rem;">Explore Events</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Event Content -->
            <div id="events" class="pb-5">
                
                <!-- 1. PERMANENT DASHBOARD (Formerly Empty State) -->
                <div class="forum-empty-state mb-5">
                    <!-- Mini Hero Glows -->
                    <div class="event-hero-bg-glow" style="opacity: 0.4;"></div>
                    <div class="event-bg-glow-secondary" style="opacity: 0.3;"></div>
                    
                    <!-- Left Column: Dynamic Messaging -->
                    <div class="empty-state-left">
                        <span class="event-section-pill" style="margin-bottom: 2rem;">
                            <i class='bx bx-calendar-event'></i> Event Dashboard
                        </span>
                        
                        {% if evenements|length > 0 %}
                            <h3 class="event-hero-title" style="font-size: 3rem; margin-bottom: 1.5rem;">Join the Action.<br>{{ evenements|length }} Events Upcoming.</h3>
                            <p class="event-hero-subtitle" style="margin: 0 0 3rem 0; width: 100%; max-width: 500px;">The community is buzzing! Browse the events below and secure your spot before they fill up.</p>
                        {% else %}
                            <h3 class="event-hero-title" style="font-size: 3rem; margin-bottom: 1.5rem;">The Stage is Set...<br>Awaiting Your Pulse.</h3>
                            <p class="event-hero-subtitle" style="margin: 0 0 3rem 0; width: 100%; max-width: 500px;">It looks like there are no events scheduled at the moment. Be the heartbeat of our community and organize something truly legendary.</p>
                        {% endif %}
                        
                        <div class="d-flex gap-3 mt-4">
                                <div class="main-home-made-with-love" style="background: rgba(255,255,255,0.02); padding: 1rem 2rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.05);">
                                <span style="color: rgba(255,255,255,0.5); font-size: 0.9rem;">Join 500+ members in our next gathering</span>
                                </div>
                        </div>
                    </div>

                    <!-- Right Column: Interactive Dashboard & Actions -->
                    <div class="empty-state-right">
                        {% if app.session.get('is_logged_in') %}
                            <div id="btnHostEventDashboard" class="event-host-pill-trigger">
                                <div style="width: 40px; height: 40px; background: var(--event-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                                    <i class='bx bx-plus'></i>
                                </div>
                                <div class="text-start">
                                    <div style="font-size: 0.95rem; font-weight: 800;">Host an Event</div>
                                    <div style="font-size: 0.75rem; color: rgba(255,255,255,0.4); font-weight: 600;">Start your community journey</div>
                                </div>
                                <i class='bx bx-chevron-right' style="margin-left: auto; font-size: 1.5rem; opacity: 0.5;"></i>
                            </div>
                        {% endif %}

                        <!-- Mini Glass Calendar -->
                        <div class="glass-calendar">
                            <div class="calendar-header">
                                <div class="calendar-month" id="calendarMonthDisplay">{{ "now"|date("F Y") }}</div>
                                <div class="d-flex gap-2">
                                    <i class='bx bx-chevron-left' id="prevMonth" style="cursor: pointer; opacity: 0.5;"></i>
                                    <i class='bx bx-chevron-right' id="nextMonth" style="cursor: pointer; opacity: 0.5;"></i>
                                </div>
                            </div>
                            <div class="calendar-grid" id="calendarGrid">
                                <!-- Days labels -->
                                <div class="calendar-day-label">Mo</div>
                                <div class="calendar-day-label">Tu</div>
                                <div class="calendar-day-label">We</div>
                                <div class="calendar-day-label">Th</div>
                                <div class="calendar-day-label">Fr</div>
                                <div class="calendar-day-label">Sa</div>
                                <div class="calendar-day-label">Su</div>
                                
                                <!-- Days will be injected by JS -->
                            </div>
                        </div>

                        {# Pass detailed event data to JS for calendar previews #}
                        <script>
                            window.calendarEvents = {
                                {% for event in evenements %}
                                    "{{ event.dateEvent|date('Y-m-d') }}": {
                                        "id": "{{ event.id }}",
                                        "title": "{{ event.titreEvent }}",
                                        "image": "{{ event.imageEvent ? asset('event_images/' ~ event.imageEvent) : '' }}",
                                        "type": "{{ event.typeEvent }}",
                                        "lieu": "{{ event.lieuEvent }}",
                                        "date": "{{ event.dateEvent|date('F d, Y • H:i') }}"
                                    }{% if not loop.last %},{% endif %}
                                {% endfor %}
                            };
                        </script>

                        <!-- Category Insight Pills -->
                        <div class="category-tags-list">
                            <span class="tag-pill">#Workshops</span>
                            <span class="tag-pill">#Meetups</span>
                            <span class="tag-pill">#Social</span>
                            <span class="tag-pill">#Sports</span>
                            <span class="tag-pill">+ {{ evenements|length }} Events</span>
                        </div>
                    </div>
                </div>

                <!-- Floating Event Preview -->
                <div id="calendarEventPreview" class="calendar-event-preview">
                    <div class="preview-card">
                        <div class="preview-banner" id="previewBanner"></div>
                        <div class="preview-content">
                            <span class="preview-tag" id="previewType"></span>
                            <h4 class="preview-title" id="previewTitle"></h4>
                            <div class="preview-meta">
                                <i class='bx bx-time-five'></i> <span id="previewDate"></span>
                            </div>
                            <button class="preview-btn" id="previewViewBtn">View Details</button>
                        </div>
                    </div>
                </div>

                <!-- 2. EVENTS GRID (Below) -->
                {% if evenements|length > 0 %}
                    <div style="padding: 0 3rem;">
                        <div class="mb-4 d-flex justify-content-between align-items-center">
                            <span class="event-section-pill">
                                <i class='bx bx-calendar-check'></i> Upcoming Events
                            </span>
                            <div class="event-pagination-info" id="eventPaginationInfo">
                                <span style="color: rgba(255,255,255,0.5); font-size: 0.9rem;">Showing <span id="currentEventRange"></span> of {{ evenements|length }}</span>
                            </div>
                        </div>
                        
                        <div class="event-grid" id="eventGrid">
                            {% for evenement in evenements %}
                                {% include 'frontend/evenement/_card.html.twig' with {'evenement': evenement} %}
                            {% endfor %}
                        </div>
                        
                        <div class="event-pagination-controls" id="eventPaginationControls">
                            <button class="event-pagination-btn" id="prevEventPage" disabled>
                                <i class='bx bx-chevron-left'></i>
                            </button>
                            <div class="event-pagination-pages" id="eventPaginationPages"></div>
                            <button class="event-pagination-btn" id="nextEventPage">
                                <i class='bx bx-chevron-right'></i>
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>

        </div>

        {% include 'frontend/shared/_main_footer.html.twig' %}
    </div>
</div>

<!-- CREATE EVENT MODAL -->
<div id="createEventModal" class="event-modal">
    <div class="event-modal-content" style="max-width: 600px;">
        <span class="event-modal-close" onclick="closeCreateModal()">&times;</span>
        <div class="main-home-auth-header">
            <h1 class="main-home-auth-title">Organize Event</h1>
            <p class="main-home-auth-subtitle">Create a memorable experience</p>
        </div>

                {{ form_start(form, {'attr': {'class': 'main-home-auth-form', 'enctype': 'multipart/form-data', 'id': 'createEventForm', 'data-ajax': 'true'}}) }}
                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Event Title</label>
                        {{ form_widget(form.titre_event, {'attr': {'class': 'main-home-form-input', 'placeholder': 'What is the event called?'}}) }}
                        <div class="text-danger small">{{ form_errors(form.titre_event) }}</div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="main-home-form-group">
                                <label class="main-home-form-label">Date & Time</label>
                                {{ form_widget(form.date_event, {'attr': {'class': 'main-home-form-input flatpickr-input'}}) }}
                                <div class="text-danger small">{{ form_errors(form.date_event) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="main-home-form-group">
                                <label class="main-home-form-label">Event Type</label>
                                <div class="custom-select-wrapper">
                                    <select name="{{ form.type_event.vars.full_name }}" id="{{ form.type_event.vars.id }}" class="main-home-form-input">
                                        {% for choice in form.type_event.vars.choices %}
                                            <option value="{{ choice.value }}">{{ choice.value|replace({'_': ' '})|title }}</option>
                                        {% endfor %}
                                    </select>
                                    {% do form.type_event.setRendered %}
                                </div>
                                <div class="text-danger small">{{ form_errors(form.type_event) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Location / Map</label>
                        {{ form_widget(form.lieu_event, {'attr': {'class': 'main-home-form-input', 'placeholder': 'Where is it happening?'}}) }}
                        <div class="text-danger small">{{ form_errors(form.lieu_event) }}</div>
                        
                        <div id="createEventMap" class="leaflet-container"></div>
                        <p class="text-muted small mt-2"><i class='bx bx-info-circle'></i> Click on the map to set the exact location.</p>
                        
                        <input type="hidden" name="{{ form.lat_event.vars.full_name|replace({ 'lat_event': 'lat_event' }) }}" id="createLat">
                        <input type="hidden" name="{{ form.lng_event.vars.full_name|replace({ 'lng_event': 'lng_event' }) }}" id="createLng">

                        <!-- Form Weather Preview (New) -->
                        <div id="createWeatherPreview" class="sidebar-card mt-3 weather-pill" style="display: none; background: rgba(var(--main-home-accent-rgb), 0.05); border: 1px dashed rgba(var(--main-home-accent-rgb), 0.2);">
                            <div class="d-flex align-items-center gap-3">
                                <div id="createWeatherIcon" style="font-size: 2rem; color: var(--main-home-accent);"><i class='bx bx-sun'></i></div>
                                <div class="flex-grow-1">
                                    <div style="font-size: 0.7rem; text-transform: uppercase; color: rgba(255,255,255,0.4); letter-spacing: 0.5px;">Live Forecast</div>
                                    <div id="createWeatherCondition" style="font-size: 0.9rem; font-weight: 700; color: white;">...</div>
                                </div>
                                <div class="text-end">
                                    <div id="createWeatherTemp" style="font-size: 1.1rem; font-weight: 800; color: var(--main-home-accent);">--°C</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Description</label>
                        {{ form_widget(form.description_event, {'attr': {'class': 'main-home-form-input', 'placeholder': 'Tell us more about it...'}}) }}
                        <div class="text-danger small">{{ form_errors(form.description_event) }}</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="main-home-form-group">
                                <label class="main-home-form-label">Total Places</label>
                                {{ form_widget(form.nb_places, {'attr': {'class': 'main-home-form-input'}}) }}
                                <div class="text-danger small">{{ form_errors(form.nb_places) }}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="main-home-form-group">
                                <label class="main-home-form-label">Remaining</label>
                                {{ form_widget(form.nb_restants, {'attr': {'class': 'main-home-form-input'}}) }}
                                <div class="text-danger small">{{ form_errors(form.nb_restants) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Event Status</label>
                        <div class="custom-status-selector">
                            <div class="status-pill" data-value="planifie"><span>Upcoming</span></div>
                            <div class="status-pill" data-value="en_cours"><span>Ongoing</span></div>
                            <div class="status-pill" data-value="termine"><span>Completed</span></div>
                            <div class="status-pill" data-value="annule"><span>Cancelled</span></div>
                        </div>
                        {{ form_widget(form.statut_event, {'attr': {'style': 'position: absolute; opacity: 0; pointer-events: none;'}}) }}
                        <div class="text-danger small">{{ form_errors(form.statut_event) }}</div>
                    </div>

                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Event Banner</label>
                        {{ form_widget(form.image_event, {'attr': {'class': 'main-home-form-input'}}) }}
                        <div class="text-danger small">{{ form_errors(form.image_event) }}</div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="button" class="btn-event-action" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); flex: 1;" onclick="closeCreateModal()">
                            Cancel
                        </button>
                        <button type="submit" class="main-home-btn-auth-submit" style="flex: 2; margin: 0;">
                            Live the Event
                        </button>
                    </div>
                {{ form_end(form) }}
    </div>
</div>

<!-- EVENT DETAILS MODAL -->
<div id="eventDetailsModal" class="event-modal">
    <div class="event-modal-content">
        <span class="event-modal-close" onclick="closeDetailsModal()">&times;</span>
        <div id="modalEventBanner" class="event-details-hero-modal">
            <div class="hero-overlay"></div>
        </div>
        
        <div class="event-details-body">
            <div class="event-details-grid">
                <!-- LEFT COLUMN: Main Info -->
                <div class="main-info">
                    <span id="modalEventType" class="event-hero-badge mb-3"></span>
                    <h2 id="modalEventTitle" class="event-hero-title mb-2"></h2>
                    <p id="modalEventDescription" class="event-hero-subtitle" style="font-size: 1.1rem; max-width: 100%; color: rgba(255,255,255,0.7);"></p>

                    <button id="btnOpenParticipation" class="main-home-btn-auth-submit w-100 mt-3" style="height: 60px;">
                        Participate
                    </button>

                    <!-- Host/Admin Actions -->
                    <div id="modalAdminActions" class="d-none mt-4 pt-4 border-top border-secondary">
                        <div style="display: flex; gap: 1rem; align-items: stretch;">
                            <button id="btnOpenEdit" class="btn-event-action" style="flex: 1; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #fff;">
                                <i class='bx bxs-edit-alt'></i> Edit
                            </button>
                            <form id="deleteEventForm" method="POST" style="flex: 1; display: flex;">
                                <input type="hidden" name="_token" id="deleteEventToken">
                                <button type="button" id="btnOpenDeleteConfirm" class="btn-event-action" style="background: rgba(255, 77, 77, 0.15); color: #ff4d4d; border: 1px solid rgba(255, 77, 77, 0.3); width: 100%;">
                                    <i class='bx bxs-trash'></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>

                    <div id="detailsEventMap" class="leaflet-container" style="border-radius: 15px; margin-top: 2rem; border: 1px solid rgba(255,255,255,0.1); display: none;"></div>
                </div>
                
                <!-- RIGHT COLUMN: Sidebar Info -->
                <div class="sidebar-info">
                    <div class="sidebar-card">
                        <div class="event-details-meta-pill">
                            <i class='bx bxs-calendar'></i>
                            <div class="event-details-meta-content">
                                <label>Date & Time</label>
                                <span id="modalEventDate" style="font-weight: 600;"></span>
                            </div>
                        </div>

                        <div class="event-details-meta-pill">
                            <i class='bx bxs-map-pin'></i>
                            <div class="event-details-meta-content">
                                <label>Location</label>
                                <span id="modalEventLieu" style="font-weight: 600;"></span>
                            </div>
                        </div>

                        <div class="event-details-meta-pill">
                            <i class='bx bxs-group'></i>
                            <div class="event-details-meta-content">
                                <label>Availability</label>
                                <span id="modalEventAvailability" style="font-weight: 600;"></span>
                            </div>
                        </div>
                        
                        <div class="event-details-meta-pill">
                            <i class='bx bxs-category'></i>
                            <div class="event-details-meta-content">
                                <label>Type</label>
                                <span id="modalEventTypeDisplay" style="font-weight: 600;"></span>
                            </div>
                        </div>

                        <!-- Weather Widget (Improved) -->
                        <div id="weatherWidget" class="sidebar-card mt-3 weather-pill" style="display: none; background: rgba(var(--main-home-accent-rgb), 0.1); border: 1px solid rgba(var(--main-home-accent-rgb), 0.2);">
                            <!-- Loading State -->
                            <div id="weatherLoading" style="text-align: center; padding: 1rem; color: rgba(255,255,255,0.4);">
                                <i class='bx bx-loader-alt bx-spin' style="font-size: 1.5rem; color: var(--main-home-accent);"></i>
                                <div style="font-size: 0.75rem; margin-top: 0.5rem; font-weight: 600;">Fetching Forecast...</div>
                            </div>
                            
                            <!-- Error / No Location State -->
                            <div id="weatherError" style="display: none; text-align: center; padding: 1rem; color: rgba(255,255,255,0.4); font-size: 0.8rem;">
                                <i class='bx bx-map-alt' style="font-size: 1.5rem; margin-bottom: 0.5rem; display: block; opacity: 0.5;"></i>
                                <div style="font-weight: 600;">Location data required for weather</div>
                            </div>

                            <!-- Success State -->
                            <div id="weatherContent" style="display: none;">
                                <div class="d-flex align-items-center gap-3">
                                    <div id="weatherIcon" style="font-size: 2.5rem; color: var(--main-home-accent);">
                                        <i class='bx bx-sun'></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div id="weatherCondition" style="font-size: 0.9rem; font-weight: 700; color: white;">Clear sky</div>
                                        <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);" id="weatherWind">Wind: 10km/h</div>
                                    </div>
                                    <div class="text-end">
                                        <div id="weatherTempMax" style="font-size: 1.2rem; font-weight: 800; color: var(--main-home-accent);">24°C</div>
                                        <div id="weatherTempMin" style="font-size: 0.8rem; color: rgba(255,255,255,0.5);">18°C</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Extra spacer at bottom of modal body -->
        </div>
    </div>
</div>

<!-- EDIT EVENT MODAL (Refined UI) -->
<div id="editEventModal" class="event-modal">
    <div class="event-modal-content" style="max-width: 600px;">
        <span class="event-modal-close" onclick="closeEditModal()">&times;</span>
        <div class="main-home-auth-header">
            <h1 class="main-home-auth-title">Edit Event</h1>
            <p class="main-home-auth-subtitle">Update your event details</p>
        </div>

        <form id="editEventForm" method="POST" enctype="multipart/form-data" class="main-home-auth-form" data-ajax="true">
            <input type="hidden" name="evenement[_token]" value="{{ csrf_token('evenement') }}">
            
            <div class="main-home-form-group">
                <label class="main-home-form-label">Event Title</label>
                <input type="text" name="evenement[titre_event]" id="editTitre" class="main-home-form-input" required placeholder="What is the event called?">
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Event Type</label>
                        <div class="custom-select-wrapper">
                            <select name="evenement[type_event]" id="editType" class="main-home-form-input">
                                {% for choice in form.type_event.vars.choices %}
                                    <option value="{{ choice.value }}">{{ choice.value|replace({'_': ' '})|title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Date & Time</label>
                        <input type="text" name="evenement[date_event]" id="editDate" class="main-home-form-input flatpickr-input" required placeholder="Pick a date">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="main-home-form-group">
                         <label class="main-home-form-label">Event Status</label>
                        <div class="custom-status-selector">
                            {% set statusMap = {
                                'planifie': 'Upcoming',
                                'en_cours': 'Ongoing',
                                'termine': 'Completed',
                                'annule': 'Cancelled'
                            } %}
                            {% for choice in form.statut_event.vars.choices %}
                                <div class="status-pill" data-value="{{ choice.value }}">
                                    <span>{{ statusMap[choice.value]|default(choice.value|title) }}</span>
                                </div>
                            {% endfor %}
                        </div>
                        <select name="evenement[statut_event]" id="editStatut" style="position: absolute; opacity: 0; pointer-events: none;">
                            {% for choice in form.statut_event.vars.choices %}
                                <option value="{{ choice.value }}">{{ statusMap[choice.value]|default(choice.value|title) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <div class="main-home-form-group">
                <label class="main-home-form-label">Location / Map</label>
                <input type="text" name="evenement[lieu_event]" id="editLieu" class="main-home-form-input" required placeholder="Where is it happening?">
                
                <div id="editEventMap" class="leaflet-container" style="border-radius: 15px; margin-top: 1rem; border: 1px solid rgba(255,255,255,0.1);"></div>
                <input type="hidden" name="evenement[lat_event]" id="editLat">
                <input type="hidden" name="evenement[lng_event]" id="editLng">

                <!-- Form Weather Preview (New) -->
                <div id="editWeatherPreview" class="sidebar-card mt-3 weather-pill" style="display: none; background: rgba(var(--main-home-accent-rgb), 0.05); border: 1px dashed rgba(var(--main-home-accent-rgb), 0.2);">
                    <div class="d-flex align-items-center gap-3">
                        <div id="editWeatherIcon" style="font-size: 2rem; color: var(--main-home-accent);"><i class='bx bx-sun'></i></div>
                        <div class="flex-grow-1">
                            <div style="font-size: 0.7rem; text-transform: uppercase; color: rgba(255,255,255,0.4); letter-spacing: 0.5px;">Live Forecast</div>
                            <div id="editWeatherCondition" style="font-size: 0.9rem; font-weight: 700; color: white;">...</div>
                        </div>
                        <div class="text-end">
                            <div id="editWeatherTemp" style="font-size: 1.1rem; font-weight: 800; color: var(--main-home-accent);">--°C</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="main-home-form-group">
                <label class="main-home-form-label">Description</label>
                <textarea name="evenement[description_event]" id="editDesc" class="main-home-form-input" rows="4" placeholder="Tell us more..."></textarea>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Total Places</label>
                        <input type="number" name="evenement[nb_places]" id="editPlaces" class="main-home-form-input">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="main-home-form-group">
                        <label class="main-home-form-label">Remaining</label>
                        <input type="number" name="evenement[nb_restants]" id="editRestants" class="main-home-form-input">
                    </div>
                </div>
            </div>

            <div class="main-home-form-group">
                <label class="main-home-form-label">Update Banner (Optional)</label>
                <input type="file" name="evenement[image_event]" class="main-home-form-input" style="padding-top: 0.7rem;">
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="button" class="btn-event-action" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); flex: 1;" onclick="closeEditModal()">
                    Cancel
                </button>
                <button type="submit" class="main-home-btn-auth-submit" style="flex: 2; margin: 0;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<input type="hidden" id="currentUserId" value="{{ currentUserId }}">
<input type="hidden" id="currentUserRole" value="{{ currentUserRole }}">

<!-- Custom Delete Confirmation Modal -->
<div id="deleteConfirmModal" class="event-modal">
    <div class="event-modal-content" style="max-width: 450px; text-align: center; padding: 3rem 2rem;">
        <div class="delete-icon-wrapper mb-4" style="font-size: 4rem; color: #ff4d4d;">
            <i class='bx bxs-error-circle'></i>
        </div>
        <h2 class="event-hero-title mb-3" style="font-size: 1.8rem;">Are you sure?</h2>
        <p style="color: rgba(255,255,255,0.7); font-size: 1.1rem; margin-bottom: 2.5rem;">
            This action cannot be undone. This event will be permanently removed from Horizon.
        </p>
        <div class="d-flex gap-3">
            <button type="button" class="btn-event-action" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); flex: 1;" onclick="closeDeleteConfirm()">
                Cancel
            </button>
            <button type="button" id="confirmDeleteBtn" class="btn-event-action" style="background: rgba(255, 77, 77, 0.15); color: #ff4d4d; border: 1px solid rgba(255, 77, 77, 0.3); flex: 1.5;">
                Yes, Delete it
            </button>
        </div>
    </div>
</div>

<!-- PARTICIPATION MODAL -->
<div id="participationModal" class="event-modal">
    <div class="event-modal-content" style="max-width: 500px;">
        <span class="event-modal-close" onclick="closeParticipationModal()">&times;</span>
        <div class="main-home-auth-header">
            <h1 class="main-home-auth-title" style="font-size: 2rem;">Event Participation</h1>
            <p class="main-home-auth-subtitle">Confirm your spot for <span id="participationEventTitle" style="color: var(--event-accent); font-weight: 800;"></span></p>
        </div>

        {{ form_start(participationForm, {'attr': {'id': 'participationForm', 'class': 'main-home-auth-form'}}) }}
            <div class="main-home-form-group">
                <label class="main-home-form-label">Number of Guests</label>
                {{ form_widget(participationForm.nb_accompagnants, {'attr': {'class': 'main-home-form-input', 'placeholder': 'How many people are joining you?'}}) }}
                <div class="text-danger small">{{ form_errors(participationForm.nb_accompagnants) }}</div>
            </div>

            <div class="main-home-form-group">
                <label class="main-home-form-label">Special Note / Comment</label>
                {{ form_widget(participationForm.commentaire_participation, {'attr': {'class': 'main-home-form-input', 'placeholder': 'Anything you want to let the host know?', 'rows': '3'}}) }}
                <div class="text-danger small">{{ form_errors(participationForm.commentaire_participation) }}</div>
            </div>

            <div class="main-home-made-with-love mb-4" style="background: rgba(var(--main-home-accent-rgb), 0.05); padding: 1rem; border-radius: 15px; border: 1px solid rgba(var(--main-home-accent-rgb), 0.1);">
                <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);">By participating, your details (Name, Email) will be shared with the event host.</div>
            </div>

            <div class="d-flex gap-3">
                <button type="button" class="btn-event-action" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); flex: 1;" onclick="closeParticipationModal()">
                    Cancel
                </button>
                <button type="submit" class="main-home-btn-auth-submit" style="flex: 2; margin: 0;">
                    Confirm Participation
                </button>
            </div>
        {{ form_end(participationForm) }}
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    
    <script>
        /* ==========================================================================
           EVENEMENT MODULE INLINED JAVASCRIPT
           ========================================================================== */
        
        document.addEventListener('DOMContentLoaded', function () {
            // --- STATE ---
            let eventMaps = {};
            let displayDate = new Date();
            const today = new Date();

            // --- HELPERS ---
            function lockScroll() {
                document.body.style.overflow = 'hidden';
            }
            function unlockScroll() {
                document.body.style.overflow = '';
            }

            // --- MAP LOGIC ---
            function initLeafletMap(containerId, latInputId, lngInputId, initialLat, initialLng, interactive = true) {
                console.log('initLeafletMap:', containerId);
                const container = document.getElementById(containerId);
                if (!container) return;

                if (typeof L === 'undefined') {
                    container.innerHTML = '<div style="padding:20px; color:red;">Leaflet failing...</div>';
                    return;
                }

                if (eventMaps[containerId]) {
                    eventMaps[containerId].remove();
                }

                try {
                    const lat = initialLat ? parseFloat(initialLat) : 36.8065;
                    const lng = initialLng ? parseFloat(initialLng) : 10.1815;

                    const map = L.map(containerId).setView([lat, lng], 13);
                    eventMaps[containerId] = map;

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap'
                    }).addTo(map);

                    let marker;
                    if (initialLat && initialLng) {
                        marker = L.marker([lat, lng], { draggable: interactive }).addTo(map);
                        
                        // Trigger Weather Preview for Forms on Load
                        if (interactive) {
                            const prefix = containerId.replace('EventMap', '');
                            updateWeatherPreview(prefix, initialLat, initialLng);
                        }
                    }

                    if (interactive) {
                        map.on('click', function(e) {
                            const { lat, lng } = e.latlng;
                            if (marker) marker.setLatLng(e.latlng);
                            else marker = L.marker([lat, lng]).addTo(map);
                            
                            if (latInputId) document.getElementById(latInputId).value = lat;
                            if (lngInputId) document.getElementById(lngInputId).value = lng;

                            // Trigger Weather Preview for Forms
                            const prefix = containerId.replace('EventMap', ''); // 'create' or 'edit'
                            updateWeatherPreview(prefix, lat, lng);
                        });
                    }
                    setTimeout(() => map.invalidateSize(), 500);
                } catch (e) {
                    console.error('Leaflet failing:', e);
                }
            }

            // --- WEATHER PREVIEW LOGIC ---
            async function updateWeatherPreview(prefix, lat, lng) {
                const previewCont = document.getElementById(prefix + 'WeatherPreview');
                const iconCont = document.getElementById(prefix + 'WeatherIcon');
                const condCont = document.getElementById(prefix + 'WeatherCondition');
                const tempCont = document.getElementById(prefix + 'WeatherTemp');
                const dateInput = document.getElementById(prefix === 'create' ? '{{ form.date_event.vars.id }}' : 'editDate');
                
                if (!previewCont || !dateInput) return;
                
                const date = dateInput.value;
                if (!date) return;

                previewCont.style.display = 'block';
                previewCont.style.opacity = '0.5';

                try {
                    const res = await fetch(`/evenement/weather/preview?lat=${lat}&lng=${lng}&date=${date}`);
                    const data = await res.json();
                    if (data.success) {
                        const w = data.data;
                        condCont.textContent = w.condition;
                        tempCont.textContent = Math.round(w.temp_max) + '°C';
                        iconCont.innerHTML = `<i class='bx ${w.icon}'></i>`;
                        previewCont.style.opacity = '1';
                    } else {
                        previewCont.style.display = 'none';
                    }
                } catch (err) {
                    previewCont.style.display = 'none';
                }
            }

            // --- CREATE MODAL ---
            const createModal = document.getElementById('createEventModal');
            window.openCreateModal = function() {
                if (!createModal) return;
                lockScroll();
                createModal.style.display = 'flex';
                setTimeout(() => {
                    createModal.classList.add('show');
                    initLeafletMap('createEventMap', 'createLat', 'createLng', null, null, true);
                }, 10);
            };
            window.closeCreateModal = function() {
                if (!createModal) return;
                createModal.classList.remove('show');
                unlockScroll();
                setTimeout(() => createModal.style.display = 'none', 300);
            };

            // Bind triggers
            document.querySelectorAll('#btnOpenCreate, #btnOpenCreateTop, #btnEmptyCreate, #btnHostEventDashboard').forEach(btn => {
                btn.onclick = openCreateModal;
            });

            // --- DETAILS MODAL ---
            const detailsModal = document.getElementById('eventDetailsModal');
            window.closeDetailsModal = function() {
                if (!detailsModal) return;
                detailsModal.classList.remove('show');
                unlockScroll();
                setTimeout(() => detailsModal.style.display = 'none', 300);
            };

            document.querySelectorAll('.view-event-details').forEach(btn => {
                btn.onclick = function() {
                    const data = btn.dataset;
                    
                    // Inject Text
                    document.getElementById('modalEventTitle').textContent = data.title;
                    document.getElementById('modalEventDescription').textContent = data.description;
                    document.getElementById('modalEventDate').textContent = data.date;
                    document.getElementById('modalEventLieu').textContent = data.lieu;
                    const typeBadge = document.getElementById('modalEventType');
                    if(typeBadge) typeBadge.textContent = data.type;
                    const typeDisplay = document.getElementById('modalEventTypeDisplay');
                    if (typeDisplay) typeDisplay.textContent = data.type;
                    const avail = document.getElementById('modalEventAvailability');
                    if(avail) avail.textContent = `${data.restants} / ${data.places} Places`;

                    // Banner handling
                    const banner = document.getElementById('modalEventBanner');
                    if (data.image) {
                        banner.innerHTML = `<img src="${data.image}" style="width:100%; height:100%; object-fit:cover;"><div class="hero-overlay"></div>`;
                    } else {
                        banner.innerHTML = `<div style="width: 100%; height: 100%; background: var(--event-gradient);"></div><div class="hero-overlay"></div>`;
                    }

                    // Admin Actions
                    const currentUserId = document.getElementById('currentUserId')?.value || "";
                    const currentUserRole = document.getElementById('currentUserRole')?.value || "";
                    const adminActions = document.getElementById('modalAdminActions');
                    if (adminActions) {
                        if (String(currentUserId) === String(data.authorId) || ['ADMIN', 'SYNDIC', 'SUPERADMIN'].includes(currentUserRole.toUpperCase())) {
                            adminActions.classList.remove('d-none');
                            adminActions.style.display = 'block';
                        } else {
                            adminActions.classList.add('d-none');
                            adminActions.style.display = 'none';
                        }
                    }

                    // Edit/Delete setup
                    const deleteForm = document.getElementById('deleteEventForm');
                    if (deleteForm) {
                        deleteForm.action = data.deletePath;
                        const deleteToken = document.getElementById('deleteEventToken');
                        if (deleteToken) deleteToken.value = data.token;
                    }
                    window.currentEventData = data;

                    // Show Modal
                    detailsModal.style.display = 'flex';
                    lockScroll();

                    // Weather Fetch (Robust Logic)
                    const weatherCont = document.getElementById('weatherWidget');
                    const weatherLoading = document.getElementById('weatherLoading');
                    const weatherError = document.getElementById('weatherError');
                    const weatherContent = document.getElementById('weatherContent');

                    if (weatherCont) {
                        const hasPos = (data.lat && data.lng && data.lat !== "0" && data.lng !== "0");
                        weatherCont.style.display = 'block';
                        
                        if (!hasPos) {
                            weatherLoading.style.display = 'none';
                            weatherContent.style.display = 'none';
                            weatherError.style.display = 'block';
                        } else {
                            weatherLoading.style.display = 'block';
                            weatherContent.style.display = 'none';
                            weatherError.style.display = 'none';
                            
                            fetch(`/evenement/${data.id}/weather`)
                                .then(res => res.json())
                                .then(res => {
                                    weatherLoading.style.display = 'none';
                                    if (res.success) {
                                        const w = res.data;
                                        document.getElementById('weatherCondition').textContent = w.condition;
                                        document.getElementById('weatherTempMax').textContent = Math.round(w.temp_max) + '°C';
                                        document.getElementById('weatherTempMin').textContent = Math.round(w.temp_min) + '°C';
                                        document.getElementById('weatherWind').textContent = 'Wind: ' + w.wind + ' km/h';
                                        document.getElementById('weatherIcon').innerHTML = `<i class='bx ${w.icon}'></i>`;
                                        weatherContent.style.display = 'block';
                                    } else {
                                        weatherError.style.display = 'block';
                                        weatherError.innerHTML = `<i class='bx bx-error-circle'></i> <div>Weather unavailable</div>`;
                                    }
                                })
                                .catch(() => {
                                    weatherLoading.style.display = 'none';
                                    weatherError.style.display = 'block';
                                    weatherError.innerHTML = `<i class='bx bx-wifi-off'></i> <div>Network Error</div>`;
                                });
                        }
                    }

                    setTimeout(() => {
                        detailsModal.classList.add('show');
                        if (data.lat && data.lng) {
                            initLeafletMap('detailsEventMap', null, null, data.lat, data.lng, false);
                        }
                    }, 10);
                };
            });

            // --- EDIT MODAL ---
            const editModal = document.getElementById('editEventModal');
            window.closeEditModal = function() {
                if (!editModal) return;
                editModal.classList.remove('show');
                unlockScroll();
                setTimeout(() => editModal.style.display = 'none', 300);
            };

            const btnOpenEdit = document.getElementById('btnOpenEdit');
            if (btnOpenEdit) {
                btnOpenEdit.onclick = function() {
                    const data = window.currentEventData;
                    if (!data) return;

                    document.getElementById('editTitre').value = data.title;
                    document.getElementById('editDesc').value = data.description;
                    document.getElementById('editLieu').value = data.lieu;
                    document.getElementById('editPlaces').value = data.places;
                    document.getElementById('editRestants').value = data.restants;
                    document.getElementById('editType').value = data.type;
                    document.getElementById('editLat').value = data.lat || "";
                    document.getElementById('editLng').value = data.lng || "";
                    if (data.dateRaw) document.getElementById('editDate').value = data.dateRaw;
                    
                    document.getElementById('editEventForm').action = data.editPath;

                    detailsModal.classList.remove('show');
                    setTimeout(() => {
                        detailsModal.style.display = 'none';
                        editModal.style.display = 'flex';
                        setTimeout(() => {
                            editModal.classList.add('show');
                            initLeafletMap('editEventMap', 'editLat', 'editLng', data.lat, data.lng, true);
                        }, 10);
                    }, 300);
                };
            }

            // --- DELETE ---
            const deleteConfirmModal = document.getElementById('deleteConfirmModal');
            window.closeDeleteConfirm = function() { deleteConfirmModal.classList.remove('show'); setTimeout(()=>deleteConfirmModal.style.display='none',300); }
            const btnOpenDeleteConfirm = document.getElementById('btnOpenDeleteConfirm');
            if (btnOpenDeleteConfirm) {
                btnOpenDeleteConfirm.onclick = () => {
                    deleteConfirmModal.style.display = 'flex';
                    setTimeout(() => deleteConfirmModal.classList.add('show'), 10);
                };
            }
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            if (confirmDeleteBtn) {
                confirmDeleteBtn.onclick = () => document.getElementById('deleteEventForm').submit();
            }

            // --- PARTICIPATION ---
            const participationModal = document.getElementById('participationModal');
            window.closeParticipationModal = function() { participationModal.classList.remove('show'); setTimeout(()=>participationModal.style.display='none',300); }
            const btnOpenParticipation = document.getElementById('btnOpenParticipation');
            if (btnOpenParticipation) {
                btnOpenParticipation.onclick = () => {
                    const data = window.currentEventData;
                    document.getElementById('participationEventTitle').textContent = data.title;
                    document.getElementById('participationForm').action = `/participation/new/${data.id}`;
                    participationModal.style.display = 'flex';
                    setTimeout(() => participationModal.classList.add('show'), 10);
                };
            }

            // --- CALENDAR ---
            const calendarGrid = document.getElementById('calendarGrid');
            const calendarMonthDisplay = document.getElementById('calendarMonthDisplay');
            
            function renderCalendar() {
                if (!calendarGrid || !calendarMonthDisplay) return;
                const year = displayDate.getFullYear();
                const month = displayDate.getMonth();
                const monthName = new Intl.DateTimeFormat('en-US', { month: 'long' }).format(displayDate);
                calendarMonthDisplay.textContent = `${monthName} ${year}`;

                const labels = calendarGrid.querySelectorAll('.calendar-day-label');
                calendarGrid.innerHTML = '';
                labels.forEach(l => calendarGrid.appendChild(l));

                let firstDay = new Date(year, month, 1).getDay();
                firstDay = (firstDay === 0) ? 6 : firstDay - 1; // Adjust for Monday start
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                const daysInPrevMonth = new Date(year, month, 0).getDate();

                for (let i = firstDay; i > 0; i--) {
                    calendarGrid.appendChild(createDayEl(daysInPrevMonth - i + 1, 'empty'));
                }
                for (let i = 1; i <= daysInMonth; i++) {
                    const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
                    const dayEl = createDayEl(i);
                    if (year === today.getFullYear() && month === today.getMonth() && i === today.getDate()) dayEl.classList.add('active');
                    if (window.calendarEvents && window.calendarEvents[dateStr]) {
                        dayEl.classList.add('has-event');
                        dayEl.onclick = (e) => { e.stopPropagation(); showEventPreview(dayEl, window.calendarEvents[dateStr]); };
                    }
                    calendarGrid.appendChild(dayEl);
                }
                const currentCount = calendarGrid.querySelectorAll('.calendar-day').length;
                for (let i = 1; i <= (42 - currentCount); i++) {
                    calendarGrid.appendChild(createDayEl(i, 'empty'));
                }
            }

            function createDayEl(num, extra = '') {
                const d = document.createElement('div');
                d.className = 'calendar-day ' + extra;
                d.textContent = num;
                return d;
            }

            const previewPopover = document.getElementById('calendarEventPreview');
            function showEventPreview(el, ev) {
                if (!previewPopover) return;
                document.getElementById('previewTitle').textContent = ev.title;
                document.getElementById('previewDate').textContent = ev.date;
                document.getElementById('previewType').textContent = ev.type;
                const banner = document.getElementById('previewBanner');
                if(ev.image) banner.style.backgroundImage = `url(${ev.image})`;
                else banner.style.background = 'var(--event-gradient)';
                
                document.getElementById('previewViewBtn').onclick = () => {
                   document.querySelectorAll('.view-event-details').forEach(b => {
                       if (b.dataset.title === ev.title) b.click();
                   });
                };

                const rect = el.getBoundingClientRect();
                previewPopover.style.top = `${rect.top - 10}px`;
                previewPopover.style.left = `${rect.left + rect.width/2}px`;
                previewPopover.classList.add('show');
            }

            document.getElementById('prevMonth')?.addEventListener('click', () => { displayDate.setMonth(displayDate.getMonth()-1); renderCalendar(); });
            document.getElementById('nextMonth')?.addEventListener('click', () => { displayDate.setMonth(displayDate.getMonth()+1); renderCalendar(); });
            renderCalendar();

            // --- PAGINATION ---
            const eventGrid = document.getElementById('eventGrid');
            if (eventGrid) {
                const allEventCards = Array.from(eventGrid.querySelectorAll('.event-card'));
                const perPage = 4;
                const totalPages = Math.ceil(allEventCards.length / perPage);
                const paginationControls = document.getElementById('eventPaginationControls');
                if (totalPages <= 1 && paginationControls) paginationControls.style.display = 'none';

                function showPage(page) {
                    allEventCards.forEach((c, idx) => {
                        const start = (page-1)*perPage;
                        const end = start + perPage;
                        c.style.display = (idx >= start && idx < end) ? 'flex' : 'none';
                    });
                    const range = document.getElementById('currentEventRange');
                    if(range) range.textContent = `${(page-1)*perPage + 1}-${Math.min(page*perPage, allEventCards.length)}`;
                    document.getElementById('prevEventPage').disabled = (page === 1);
                    document.getElementById('nextEventPage').disabled = (page === totalPages);
                    renderPages(page);
                }

                function renderPages(current) {
                    const cont = document.getElementById('eventPaginationPages');
                    if(!cont) return;
                    cont.innerHTML = '';
                    for(let i=1; i<=totalPages; i++) {
                        const b = document.createElement('button');
                        b.className = 'event-pagination-page' + (i === current ? ' active' : '');
                        b.textContent = i;
                        b.onclick = () => showPage(i);
                        cont.appendChild(b);
                    }
                }

                let curPage = 1;
                document.getElementById('prevEventPage').onclick = () => { if(curPage > 1) showPage(--curPage); };
                document.getElementById('nextEventPage').onclick = () => { if(curPage < totalPages) showPage(++curPage); };
                showPage(1);
            }

            // --- FORM HELPERS ---
            initializeCustomFormElements();
            
            // --- FORM SUBMISSIONS ---
            const createForm = document.getElementById('createEventForm');
            if (createForm) {
                createForm.onsubmit = async function(e) {
                    e.preventDefault();
                    const btn = this.querySelector('button[type="submit"]');
                    const original = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Organizing...';
                    btn.disabled = true;

                    try {
                        const res = await fetch(this.action || '/evenement/new', {
                            method: 'POST',
                            body: new FormData(this),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            showCoolPopup('Event Live!', 'Your event has been successfully organized.', 'success');
                            setTimeout(() => window.location.reload(), 2000);
                        } else {
                            showCoolPopup('Check your event', data.message || 'Validation failed.', 'error');
                            btn.innerHTML = original;
                            btn.disabled = false;
                        }
                    } catch (err) {
                        showCoolPopup('Error', 'Something went wrong.', 'error');
                        btn.innerHTML = original;
                        btn.disabled = false;
                    }
                };
            }

            const editForm = document.getElementById('editEventForm');
            if (editForm) {
                editForm.onsubmit = async function(e) {
                    e.preventDefault();
                    const btn = this.querySelector('button[type="submit"]');
                    const original = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';
                    btn.disabled = true;

                    try {
                        const res = await fetch(this.action, {
                            method: 'POST',
                            body: new FormData(this),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            showCoolPopup('Updated!', 'Your event details have been saved.', 'success');
                            setTimeout(() => window.location.reload(), 2000);
                        } else {
                            showCoolPopup('Check your edit', data.message || 'Validation failed.', 'error');
                            btn.innerHTML = original;
                            btn.disabled = false;
                        }
                    } catch (err) {
                        showCoolPopup('Error', 'Something went wrong.', 'error');
                        btn.innerHTML = original;
                        btn.disabled = false;
                    }
                };
            }

            // Global click to close stuff
            window.onclick = function(e) {
                if (e.target.classList.contains('event-modal')) {
                    closeCreateModal(); closeDetailsModal(); closeEditModal(); closeDeleteConfirm(); closeParticipationModal();
                }
                if (!e.target.closest('.calendar-event-preview') && !e.target.closest('.calendar-day')) {
                    previewPopover?.classList.remove('show');
                }
            };
        });

        // Exposed functions
        function showCoolPopup(title, message, type = 'success') {
            const popup = document.getElementById('coolPopup');
            document.getElementById('coolPopupTitle').textContent = title;
            document.getElementById('coolPopupMessage').innerHTML = message;
            const icon = document.getElementById('coolPopupIcon');
            icon.innerHTML = (type === 'success') ? "<i class='bx bxs-check-circle' style='color: #00d2ff;'></i>" : "<i class='bx bxs-error-circle' style='color: #ff4d4d;'></i>";
            popup.style.display = 'flex';
            setTimeout(() => popup.classList.add('show'), 10);
        }
        function closeCoolPopup() {
            const popup = document.getElementById('coolPopup');
            popup.classList.remove('show');
            setTimeout(() => popup.style.display = 'none', 300);
        }

        function initializeCustomFormElements() {
            // Dropdowns
            document.querySelectorAll('.custom-select-wrapper select').forEach(select => {
                if (select.nextElementSibling?.classList.contains('custom-dropdown-trigger')) return;
                const wrapper = select.closest('.custom-select-wrapper');
                const trigger = document.createElement('div');
                trigger.className = 'custom-dropdown-trigger';
                trigger.innerHTML = `<span class="selected-text">${select.options[select.selectedIndex]?.text || 'Select...'}</span><span class="arrow">&#xea4e;</span>`;
                const menu = document.createElement('div');
                menu.className = 'custom-dropdown-menu';
                Array.from(select.options).forEach(opt => {
                    const item = document.createElement('div');
                    item.className = 'custom-dropdown-option' + (opt.selected ? ' selected' : '');
                    item.textContent = opt.text;
                    item.onclick = () => {
                        select.value = opt.value;
                        trigger.querySelector('.selected-text').textContent = opt.text;
                        menu.querySelectorAll('.custom-dropdown-option').forEach(o => o.classList.remove('selected'));
                        item.classList.add('selected');
                        trigger.classList.remove('active');
                        menu.classList.remove('active');
                    };
                    menu.appendChild(item);
                });
                trigger.onclick = (e) => { e.stopPropagation(); trigger.classList.toggle('active'); menu.classList.toggle('active'); };
                wrapper.appendChild(trigger);
                wrapper.appendChild(menu);
                select.style.cssText = 'position:absolute; opacity:0; pointer-events:none;';
            });

            // Flatpickr
            document.querySelectorAll('input[name*="date_event"], .flatpickr-input').forEach(input => {
                if (!input._flatpickr) flatpickr(input, { enableTime: true, dateFormat: "Y-m-d H:i", minDate: "today" });
            });

            // Status Pills
            document.querySelectorAll('select[name*="statut_event"]').forEach(select => {
                const group = select.closest('.main-home-form-group');
                const pills = group?.querySelectorAll('.status-pill');
                if (pills) {
                    pills.forEach(p => {
                        if (p.dataset.value === select.value) p.classList.add('active');
                        p.onclick = () => {
                            pills.forEach(p2 => p2.classList.remove('active'));
                            p.classList.add('active');
                            select.value = p.dataset.value;
                        };
                    });
                }
            });
        }
    </script>
{% endblock %}
