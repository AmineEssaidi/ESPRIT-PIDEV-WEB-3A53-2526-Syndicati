<div class="event-card">
    <div class="event-card-image">
        <span class="event-type-tag">{{ evenement.typeEvent }}</span>
        <div class="event-card-image-overlay"></div>
        {% if evenement.imageEvent %}
            <img src="{{ asset('event_images/' ~ evenement.imageEvent) }}" alt="{{ evenement.titreEvent }}" loading="lazy">
        {% else %}
            <div style="width: 100%; height: 100%; background: var(--event-gradient);"></div>
        {% endif %}
    </div>

    <div class="event-card-body">
        <div class="event-meta">
            <span><i class='bx bxs-calendar-event'></i> {{ evenement.dateEvent|date('M d, Y') }}</span>
            <span><i class='bx bxs-map-pin'></i> {{ evenement.lieuEvent }}</span>
        </div>

        <h3 class="event-card-title">{{ evenement.titreEvent }}</h3>
        <p class="event-card-desc">{{ evenement.descriptionEvent }}</p>

        <div class="event-card-footer">
            <div class="event-availability">
                <span class="avail-count">{{ evenement.nbRestants ?? 0 }}</span>
                <span class="avail-label">Places Left</span>
            </div>
            <div class="btn-event-action view-event-details" 
               style="cursor: pointer;"
               data-id="{{ evenement.id }}"
               data-title="{{ evenement.titreEvent }}"
               data-description="{{ evenement.descriptionEvent }}"
               data-date="{{ evenement.dateEvent|date('F d, Y • H:i') }}"
               data-date-raw="{{ evenement.dateEvent|date('Y-m-d\\TH:i') }}"
               data-lieu="{{ evenement.lieuEvent }}"
               data-type="{{ evenement.typeEvent }}"
               data-restants="{{ evenement.nbRestants }}"
               data-places="{{ evenement.nbPlaces }}"
               data-statut="{{ evenement.statutEvent }}"
               data-image="{% if evenement.imageEvent %}{{ asset('event_images/' ~ evenement.imageEvent) }}{% endif %}"
               data-author-id="{{ evenement.user.idUser|default(evenement.user.id|default('')) }}"
               data-edit-path="{{ path('app_evenement_edit', {'id': evenement.id}) }}"
               data-delete-path="{{ path('app_evenement_delete', {'id': evenement.id}) }}"
               data-has-participated="{{ evenement.id in participatedEventIds ? 'true' : 'false' }}"
               data-token="{{ csrf_token('delete' ~ evenement.id) }}">
                View Details
            </div>
        </div>
    </div>
</div>
