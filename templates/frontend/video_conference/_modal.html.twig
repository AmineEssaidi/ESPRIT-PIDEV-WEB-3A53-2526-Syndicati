                    <div id="modal-video-grid" class="confer-spotlight-display">
                        <!-- Host/Active Speaker Box -->
                        <div class="confer-video-wrapper spotlight-active" id="local-video-wrapper">
                            <video id="localVideo" autoplay muted playsinline class="confer-video-el"></video>
