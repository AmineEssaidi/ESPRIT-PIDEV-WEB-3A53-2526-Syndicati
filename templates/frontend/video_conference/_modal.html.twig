<div class="glass-modal-overlay" id="video-conf-modal" style="display: none !important; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(20px); z-index: 999999 !important; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.4s ease;">
    <div class="glass-modal-container confer-overhaul-container" style="max-width: 900px; width: 95%; height: auto; max-height: 90vh; border-radius: 32px; overflow: hidden; position: relative; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); background: rgba(15, 15, 25, 0.9);">
        <!-- Mesh Background Glows -->
        <div class="confer-bg-glow primary" style="position: absolute; top: -100px; left: -100px; width: 300px; height: 300px; background: #8a2be2; filter: blur(100px); opacity: 0.15; pointer-events: none;"></div>
        <div class="confer-bg-glow secondary" style="position: absolute; bottom: -100px; right: -100px; width: 300px; height: 300px; background: #00d2ff; filter: blur(100px); opacity: 0.15; pointer-events: none;"></div>

        <div class="glass-modal-header border-0 p-4 d-flex justify-content-between align-items-center position-relative" style="z-index: 10;">
            <div class="d-flex align-items-center gap-3">
                <div class="confer-status-pill" style="background: rgba(138, 43, 226, 0.1); border: 1px solid rgba(138, 43, 226, 0.2); padding: 0.4rem 0.9rem; border-radius: 100px; color: #8a2be2; font-size: 0.75rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; text-transform: uppercase;">
                    <i class='bx bx-video'></i>
                    <span id="video-modal-title">Setup Your Spotlight</span>
                </div>
            </div>
            <button class="btn btn-link text-white-50 p-2" id="video-conf-modal-close" style="font-size: 1.5rem; text-decoration: none;"><i class="bx bx-x"></i></button>
        </div>

        <div class="glass-modal-body p-4 pt-0 position-relative" style="z-index: 5;">
            <!-- Security Context Warning -->
            <div id="modal-security-alert" class="d-none mb-4 p-3 rounded-4" style="background: rgba(255, 187, 0, 0.1); border: 1px solid rgba(255, 187, 0, 0.2);">
                <div class="d-flex gap-3 align-items-center">
                    <div class="flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: rgba(255, 187, 0, 0.2); border-radius: 12px; color: #ffbb00;">
                        <i class='bx bx-shield-quarter fs-4'></i>
                    </div>
                    <div>
                        <h6 class="text-white fw-bold mb-1" style="font-size: 0.9rem;">Browser Security Restriction</h6>
                        <p class="text-white-50 mb-0" style="font-size: 0.8rem; line-height: 1.4;">
                            Media APIs are blocked on insecure IP origins. To fix this, enable the flag:<br>
                            <code class="text-warning bg-dark px-2 rounded">chrome://flags/#unsafely-treat-insecure-origin-as-secure</code><br>
                            and add <span class="text-white fw-bold">{{ app.request.schemeAndHttpHost }}</span> to the list.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Host/Setup View -->
            <div id="video-view-host" class="row g-4">
                <div class="col-lg-7">
                    <div class="confer-preview-box position-relative rounded-4 overflow-hidden bg-black shadow-inner" style="aspect-ratio: 16/9; border: 1px solid rgba(255,255,255,0.08); min-height: 200px;">
                        <video id="modal-preview-video" autoplay muted playsinline style="width: 100%; height: 100%; object-fit: cover; background: #000;"></video>
                        <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);">
                            <div class="d-flex justify-content-center gap-3">
                                <button id="modal-preview-toggleAudio" class="modal-ctrl-btn active" title="Toggle Mic"><i class='bx bx-microphone'></i></button>
                                <button id="modal-preview-toggleVideo" class="modal-ctrl-btn active" title="Toggle Camera"><i class='bx bx-video'></i></button>
                            </div>
                        </div>
                        <div id="modal-preview-placeholder" class="position-absolute inset-0 d-none flex-column align-items-center justify-content-center text-white-50">
                            <i class='bx bx-video-off fs-1 mb-2'></i>
                            <p class="small fw-bold">Camera is Off</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 d-flex flex-column justify-content-center">
                    <h4 class="text-white fw-bold mb-2">Host a Custom Session</h4>
                    <p class="text-white-50 small mb-3">Configure your room details and start your real-time session.</p>
                    
                    <div class="bg-white bg-opacity-5 rounded-4 p-1 border border-white border-opacity-10 mb-3">
                        <input type="text" id="modal-host-room-name" class="bg-transparent border-0 text-white px-3 w-100" placeholder="Room Name (Optional)" style="outline: none; height: 45px;">
                    </div>

                    <button id="modal-host-submit" class="btn btn-primary-gradient w-100 py-3 rounded-4 fw-bold mb-3 shadow-lg">
                        <i class="bx bx-plus-circle me-2"></i>Create & Join
                    </button>
                    <button class="btn btn-link text-white-50 small w-100 video-switch-to-join" style="text-decoration: none;">Already have a code? Join instead</button>
                </div>
            </div>

            <!-- Join View -->
            <div id="video-view-join" class="row g-4 d-none">
                <div class="col-12 text-center py-4">
                    <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: rgba(0, 210, 255, 0.1); border-radius: 20px; border: 1px solid rgba(0, 210, 255, 0.2);">
                        <i class='bx bx-hash fs-1' style="color: #00d2ff;"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Join with Room Code</h4>
                    <p class="text-white-50 small mb-4 mx-auto" style="max-width: 400px;">Enter the unique code shared with you to join the session instantly.</p>
                    
                    <div class="bg-white bg-opacity-5 rounded-4 p-1 border border-white border-opacity-10 d-flex mx-auto mb-4" style="max-width: 400px;" id="join-input-wrapper">
                        <input type="text" id="modal-join-code-input" class="bg-transparent border-0 text-white px-3 flex-grow-1" placeholder="Enter Room Code..." style="outline: none; height: 50px; font-size: 1.1rem; letter-spacing: 2px; text-transform: uppercase;">
                        <button id="modal-join-submit" class="btn btn-primary-gradient px-4 rounded-3 border-0">Connect</button>
                    </div>

                    <button class="btn btn-link text-white-50 small video-switch-to-host" style="text-decoration: none;">I want to host a custom room</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.modal-ctrl-btn { width: 44px; height: 44px; border-radius: 50%; border: none; background: rgba(0,0,0,0.4); backdrop-filter: blur(10px); color: #fff; font-size: 1.25rem; transition: 0.2s; display: inline-flex; align-items: center; justify-content: center; }
.modal-ctrl-btn:hover { background: rgba(255,255,255,0.1); transform: scale(1.1); }
.modal-ctrl-btn.off { background: rgba(255, 71, 71, 0.4); color: #ff4747; }
.btn-primary-gradient { background: linear-gradient(135deg, #8a2be2, #00d2ff); border: none; color: #fff; transition: 0.3s; }
.btn-primary-gradient:hover { transform: translateY(-3px); filter: brightness(1.1); box-shadow: 0 15px 30px rgba(138,43,226,0.3); }
</style>

<script>
(function() {
    function initVideoModal() {
        const modal = document.getElementById('video-conf-modal');
        if (!modal) return;

        const securityAlert = document.getElementById('modal-security-alert');
        if (securityAlert && !window.isSecureContext) {
            securityAlert.classList.remove('d-none');
            console.warn('VIDEO_MODAL: Insecure context detected, media permissions will be blocked.');
        }

        const closeBtn = document.getElementById('video-conf-modal-close');
        
        const hostView = document.getElementById('video-view-host');
        const joinView = document.getElementById('video-view-join');
        const modalTitle = document.getElementById('video-modal-title');
        
        const hostSubmit = document.getElementById('modal-host-submit');
        const hostRoomName = document.getElementById('modal-host-room-name');
        
        const joinSubmit = document.getElementById('modal-join-submit');
        const joinInput = document.getElementById('modal-join-code-input');
        
        const previewVideo = document.getElementById('modal-preview-video');
        const toggleVideo = document.getElementById('modal-preview-toggleVideo');
        const toggleAudio = document.getElementById('modal-preview-toggleAudio');
        const placeholder = document.getElementById('modal-preview-placeholder');

        let previewStream = null;

        async function startPreview() {
            if (previewStream) return;
            try {
                previewStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                previewVideo.srcObject = previewStream;
                placeholder.classList.add('d-none');
            } catch (err) {
                console.warn('VIDEO_MODAL: Preview error:', err);
                placeholder.classList.remove('d-none');
            }
        }

        function stopPreview() {
            if (previewStream) {
                previewStream.getTracks().forEach(t => t.stop());
                previewStream = null;
            }
        }

        function openModalLogic(mode) {
            console.log('VIDEO_MODAL: Opening in mode:', mode);
            
            // 1. Force Display
            modal.style.setProperty('display', 'flex', 'important');
            
            // 2. Trigger opacity/animation via .active class (common in Syndicati CSS)
            setTimeout(() => {
                modal.classList.add('active');
                modal.style.setProperty('opacity', '1', 'important');
            }, 10);
            
            if (mode === 'host') {
                showHostView();
            } else {
                showJoinView();
            }
        }

        function showHostView() {
            hostView.classList.remove('d-none');
            joinView.classList.add('d-none');
            modalTitle.innerText = 'Setup & Host';
            startPreview();
        }

        function showJoinView() {
            hostView.classList.add('d-none');
            joinView.classList.remove('d-none');
            modalTitle.innerText = 'Join Session';
            stopPreview();
            setTimeout(() => { if(joinInput) joinInput.focus(); }, 350);
        }

        // Global delegation for maximum resilience
        document.body.addEventListener('click', (e) => {
            const hostBtn = e.target.closest('.confer-host-trigger');
            const joinBtn = e.target.closest('.confer-join-trigger');
            
            if (hostBtn) {
                e.preventDefault();
                openModalLogic('host');
            } else if (joinBtn) {
                e.preventDefault();
                openModalLogic('join');
            }
        });

        if (closeBtn) {
            closeBtn.onclick = () => {
                modal.classList.remove('active');
                modal.style.setProperty('opacity', '0', 'important');
                setTimeout(() => {
                    modal.style.setProperty('display', 'none', 'important');
                    stopPreview();
                }, 400);
            };
        }

        // Switch paths inside modal
        document.querySelectorAll('.video-switch-to-join').forEach(btn => btn.onclick = (e) => { e.preventDefault(); showJoinView(); });
        document.querySelectorAll('.video-switch-to-host').forEach(btn => btn.onclick = (e) => { e.preventDefault(); showHostView(); });

        // Controls
        if (toggleVideo) {
            toggleVideo.onclick = () => {
                if (!previewStream) return;
                const v = previewStream.getVideoTracks()[0];
                v.enabled = !v.enabled;
                toggleVideo.classList.toggle('off', !v.enabled);
                placeholder.classList.toggle('d-none', v.enabled);
            };
        }

        if (toggleAudio) {
            toggleAudio.onclick = () => {
                if (!previewStream) return;
                const a = previewStream.getAudioTracks()[0];
                a.enabled = !a.enabled;
                toggleAudio.classList.toggle('off', !a.enabled);
            };
        }

        // Host Action
        if (hostSubmit) {
            hostSubmit.onclick = async () => {
                hostSubmit.disabled = true;
                hostSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';
                
                const roomName = hostRoomName.value.trim();
                const formData = new FormData();
                if (roomName) formData.append('roomName', roomName);

                try {
                    const response = await fetch("{{ path('video_conf_create') }}", { method: 'POST', body: formData });
                    const data = await response.json();
                    if (data.success) {
                        window.location.href = data.joinUrl;
                    } else {
                        window.pushNotif(data.error || 'Failed to create room', 'ERROR');
                        hostSubmit.disabled = false;
                        hostSubmit.innerText = 'Create & Join';
                    }
                } catch (e) {
                    hostSubmit.disabled = false;
                    hostSubmit.innerText = 'Create & Join';
                }
            };
        }

        // Join Action
        if (joinSubmit) {
            joinSubmit.onclick = () => {
                const code = joinInput.value.trim();
                if (code) {
                    joinSubmit.disabled = true;
                    joinSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                    window.location.href = "/video-conference/room/" + code;
                } else {
                    window.pushNotif('Please enter a room code', 'WARNING');
                }
            };
        }
        
        console.log('VIDEO_MODAL: Initialization successful');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initVideoModal);
    } else {
        initVideoModal();
    }
})();
</script>
