<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="{{ asset('frontend/js/webrtc-manager.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('video-conf-modal');
    const closeBtn = document.getElementById('video-conf-modal-close');
    const hostBtn = document.getElementById('host-conference-btn');
    const copyBtn = document.getElementById('copy-link-btn');
    const endCallBtn = document.getElementById('endCall');
    let localStream = null;
    let qrCode = null;

    if (!window.myConfPeerId) {
        window.myConfPeerId = 'peer_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
    }

    hostBtn.addEventListener('click', async function() {
        window.isConfHost = true;
        updateStatus('Creating session...', 'primary');
        
        try {
            const response = await fetch("{{ path('video_conf_create') }}", {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            
            const data = await response.json();
            if (data.success) {
                document.getElementById('modal-joinLink').value = data.joinUrl;
                document.getElementById('modal-room-id').textContent = data.roomToken;
                
                modal.classList.add('active');
                
                // QR Code
                const qrContainer = document.getElementById('modal-qrcode');
                qrContainer.innerHTML = '';
                new QRCode(qrContainer, { text: data.joinUrl, width: 140, height: 140 });

                await startCamera();
                startParticipantTracking(data.roomToken);
                updateStatus('Live Spotlight', 'success');
            }
        } catch (error) {
            console.error('Error:', error);
            updateStatus('Failed to host', 'error');
        }
    });

    async function startCamera() {
        const waitingState = document.getElementById('local-waiting-state');
        try {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                throw new Error("Camera API requires secure context (HTTPS/localhost)");
            }
            localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
            document.getElementById('localVideo').srcObject = localStream;
            if (waitingState) waitingState.style.display = 'none';
        } catch (err) {
            console.error('Media Error:', err);
            localStream = null; // Explicitly null for fallback
            if (waitingState) {
                const msg = err.name === 'NotAllowedError' ? 'Camera access denied' : 'Camera disabled (LAN HTTP)';
                waitingState.innerHTML = `<p style="color: #ff4d4d; font-size: 0.85rem; text-align: center; padding: 0 1rem;"><i class='bx bx-camera-off fs-3 mb-2 d-block'></i>${msg}</p>`;
            }
        }
    }

    function updateStatus(text, type) {
        const el = document.getElementById('confer-status-text');
        const pill = document.querySelector('.confer-status-pill');
        if (el) el.textContent = text;
        
        if (pill) {
            pill.style.borderColor = type === 'success' ? 'rgba(0, 255, 128, 0.4)' : (type === 'error' ? 'rgba(255, 77, 77, 0.4)' : 'rgba(0, 210, 255, 0.4)');
            pill.style.color = type === 'success' ? '#00ff80' : (type === 'error' ? '#ff4d4d' : '#00d2ff');
            pill.querySelector('.pulse-dot').style.background = type === 'success' ? '#00ff80' : (type === 'error' ? '#ff4d4d' : '#00d2ff');
        }
    }

    // Participant Tracking
    let heartbeatInterval = null;
    let pollingInterval = null;

    async function startParticipantTracking(token) {
        const heartbeatUrl = "/video-conference/heartbeat/" + token;
        const participantsUrl = "/video-conference/participants/" + token;

        const updateParticipants = async () => {
            document.getElementById('modal-live-indicator').style.display = 'block';
            try {
                const res = await fetch(participantsUrl);
                const data = await res.json();
                
                if (data.participants) {
                    processWebrtcSignals(data.participants, localStream, 'modal-video-grid', token, window.isConfHost);
                    renderParticipantList(data.participants);
                }
            } catch (e) { console.error('Tracking Error', e); }
        };

        const sendHeartbeat = async () => {
            try {
                const res = await fetch(heartbeatUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ peerId: window.myConfPeerId })
                });
                if (!res.ok) throw new Error('HB status: ' + res.status);
                const d = await res.json();
                if (d.sessionId) window.myConfSessionId = d.sessionId;
            } catch (e) { 
                console.error('Heartbeat Error', e);
                updateStatus('Sync Error', 'error');
            }
        };

        const initSync = async () => {
            await sendHeartbeat();
            await updateParticipants();
            heartbeatInterval = setInterval(sendHeartbeat, 5000);
            pollingInterval = setInterval(updateParticipants, 4000);
        };
        initSync();
    }

    function renderParticipantList(participants) {
        const list = document.getElementById('modal-participants-list');
        if (!list) return;

        if (participants.length === 0) {
            list.innerHTML = '<div class="confer-empty-state"><i class="bx bx-user-plus"></i><p>Waiting for guests...</p></div>';
            return;
        }

        list.innerHTML = participants.map(p => `
            <div class="d-flex align-items-center justify-content-between p-3 rounded-4 mb-2" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #8a2be2, #00d2ff); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; color: #fff;">
                        ${p.name.charAt(0).toUpperCase()}
                    </div>
                    <span class="text-white small fw-600">${p.name}</span>
                </div>
                ${p.isHost ? '<span style="font-size: 0.6rem; color: #ffc107; border: 1px solid #ffc10744; padding: 2px 6px; border-radius: 4px;">HOST</span>' : ''}
            </div>
        `).join('');
    }

    function stopConference() {
        if (localStream) localStream.getTracks().forEach(t => t.stop());
        if (heartbeatInterval) clearInterval(heartbeatInterval);
        if (pollingInterval) clearInterval(pollingInterval);
        cleanupWebrtc();
        modal.classList.remove('active');

        // Cleanup grid
        document.querySelectorAll('.confer-video-wrapper').forEach(w => {
            if (w.id !== 'local-video-wrapper') w.remove();
        });
        document.getElementById('local-video-wrapper').classList.remove('pip-mode');
        document.getElementById('local-waiting-state').style.display = 'flex';
    }

    closeBtn.addEventListener('click', stopConference);
    endCallBtn.addEventListener('click', () => confirm('End this spotlight session?') && stopConference());
    copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(document.getElementById('modal-joinLink').value);
        copyBtn.innerHTML = '<i class="bx bx-check"></i>';
        setTimeout(() => copyBtn.innerHTML = '<i class="bx bx-copy"></i>', 2000);
    });

    document.getElementById('toggleAudio').onclick = function() {
        if (!localStream) return;
        const enabled = localStream.getAudioTracks()[0].enabled = !localStream.getAudioTracks()[0].enabled;
        this.classList.toggle('active-off', !enabled);
        this.innerHTML = enabled ? '<i class="bx bx-microphone"></i>' : '<i class="bx bx-microphone-off"></i>';
    };

    document.getElementById('toggleVideo').onclick = function() {
        if (!localStream) return;
        const enabled = localStream.getVideoTracks()[0].enabled = !localStream.getVideoTracks()[0].enabled;
        this.classList.toggle('active-off', !enabled);
        this.innerHTML = enabled ? '<i class="bx bx-video"></i>' : '<i class="bx bx-video-off"></i>';
    };

    // Join Handler
    document.getElementById('join-by-code-btn').onclick = async function() {
        const code = document.getElementById('join-room-code').value.trim();
        if (!code) return;
        
        try {
            const res = await fetch("/video-conference/info/" + code);
            const data = await res.json();
            if (data.success) {
                window.isConfHost = data.isHost;
                document.getElementById('modal-joinLink').value = window.location.origin + "/video-conference/room/" + code;
                document.getElementById('modal-room-id').textContent = code;
                modal.classList.add('active');
                await startCamera();
                startParticipantTracking(code);
                updateStatus('Connected to Session', 'success');
            }
        } catch (e) { alert('Invalid Room Code'); }
    };
});
</script>
