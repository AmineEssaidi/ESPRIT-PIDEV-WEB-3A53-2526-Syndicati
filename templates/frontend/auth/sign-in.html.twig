}
.faceid-switch-btn:hover {
    background: rgba(255,255,255,0.1);
}

.faceid-input-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    max-width: 100%;
}

.faceid-input-label {
    font-size: 0.75rem;
