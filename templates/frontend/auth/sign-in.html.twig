.main-home-auth-card--signin {
    width: 100% !important;
    max-width: 820px !important;
    min-height: 280px !important;
    max-height: 100% !important;
    padding: 0 !important;
    display: flex !important;
    align-items: stretch !important;
    overflow: hidden !important;
    background: rgba(10, 10, 10, 0.85) !important;
    backdrop-filter: blur(30px) saturate(200%) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 28px !important;
    border-top-left-radius: 28px !important;
    border-top-right-radius: 28px !important;
    border-bottom-left-radius: 28px !important;
    border-bottom-right-radius: 28px !important;
    margin: 0 auto !important;
    box-shadow: 0 40px 100px rgba(0,0,0,0.8) !important;
    transition: max-width 0.5s cubic-bezier(0.4, 0, 0.2, 1), min-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.35s ease !important;
    position: relative !important;
    z-index: 2 !important;
}

/* When Face ID opens: card gets BIGGER but still fits in middle section */
.main-home-auth-card--signin.faceid-active {
    max-width: 1280px !important;
    min-height: 320px !important;
    max-height: 100% !important;
    border-color: rgba(var(--main-home-accent-rgb), 0.35) !important;
}

/* Flex container: fills card, rounded; enough padding so content isn’t cramped */
.main-home-auth-card--signin .main-home-auth-flex-container {
    display: flex;
    width: 100%;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: 28px;
    padding: 2rem 2.5rem;
    box-sizing: border-box;
}

.main-home-auth-card--signin.faceid-active .main-home-auth-flex-container {
    overflow: hidden;
}

.main-home-auth-card--signin .main-home-auth-form-column {
    flex: 1 1 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.25rem 0;
    transition: flex-basis 0.5s cubic-bezier(0.4, 0, 0.2, 1), padding 0.5s cubic-bezier(0.4, 0, 0.2, 1), border 0.3s ease !important;
}

.main-home-auth-card--signin.faceid-active .main-home-auth-form-column {
    flex: 0 0 46%;
    padding-right: 2rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
}

/* Face ID panel: slides in from right, smooth expand */
.main-home-auth-card--signin .main-home-auth-faceid-column {
    flex: 0 0 0;
    min-width: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    display: flex;
    flex-direction: column;
    transition: flex-basis 0.5s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.5s cubic-bezier(0.4, 0, 0.2, 1), max-width 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease 0.15s, padding 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
    padding-left: 0;
}

/* Face ID column: no scroll, content fits */
.main-home-auth-card--signin.faceid-active .main-home-auth-faceid-column {
    flex: 0 0 54%;
    min-width: 300px;
    max-width: 54%;
    opacity: 1;
    visibility: visible;
    overflow: hidden;
    padding: 1rem 1.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

/* Panel inner: flex column, fills height, no overflow */
.faceid-panel-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    min-width: 0;
    max-width: 100%;
    gap: 0.75rem;
    padding: 0;
    box-sizing: border-box;
}

.faceid-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}

.faceid-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
}

.faceid-close {
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
}
.faceid-close:hover {
    background: rgba(var(--main-home-accent-rgb), 0.2);
    border-color: var(--main-home-accent);
}

/* Media: video + hint, can shrink to fit */
.faceid-media-section {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.faceid-video-wrapper {
    position: relative;
    width: 100%;
    max-width: 320px;
    flex: 1 1 0;
    min-height: 180px;
    max-height: 260px;
    background: #000;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

#faceid-auth-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.faceid-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
