<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    {% if app.session.get('is_logged_in') and app.session.get('user') is iterable %}
        <script>
            window.serverSettings = {{ app.session.get('user').settings|default({})|json_encode|raw }};
        </script>
    {% endif %}
    <script src="{{ asset('frontend/js/global-settings.js') }}"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In - PiDev</title>

    <!-- Preload critical resources -->
    <link rel="preload" href="{{ asset('frontend/css/main-home.css') }}" as="style">
    <link rel="preload" href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}" as="style">
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    
    <!-- CSS Dependencies -->
    <link href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/main-home.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/scroll-pill.css') }}" rel="stylesheet">
    <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
    {% if hcaptcha_site_key is defined and hcaptcha_site_key %}
    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
    {% endif %}
</head>
<body class="sign-in-page">
<!-- Page Loader -->
<div class="page-loader" id="pageLoader">
    <div class="loader-content">
        <div class="loader-dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
    </div>
</div>

{% include 'shared/_access_denied_popup.html.twig' %}

<!-- TOTP 2FA popup (authenticator app code) - matches sign-in card UI -->
<div id="totp-2fa-overlay" class="totp-2fa-overlay" style="display: {{ show_totp_popup|default(false) ? 'flex' : 'none' }};" aria-hidden="{{ show_totp_popup|default(false) ? 'false' : 'true' }}">
    <div class="totp-2fa-popup">
        <div class="totp-2fa-popup-inner">
            <h2 class="totp-2fa-title">Two-Factor Authentication</h2>
            <p class="totp-2fa-subtitle">Enter the 6-digit code from your authenticator app</p>
            <div id="totp-2fa-error" class="totp-2fa-error" style="display: none;"></div>
            <div class="totp-2fa-form">
                <input type="text" id="totp-2fa-code" class="totp-2fa-input main-home-form-input" placeholder="000000" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" />
                <div class="totp-2fa-actions">
                    <button type="button" id="totp-2fa-verify-btn" class="main-home-btn main-home-btn-auth-submit totp-2fa-btn">Verify</button>
                    <button type="button" class="main-home-forgot-btn totp-2fa-cancel" id="totp-2fa-cancel-btn">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Email OTP 2FA popup (code sent to user's email) -->
<div id="email-otp-2fa-overlay" class="totp-2fa-overlay" style="display: none;" data-otp-mode="login">
    <div class="totp-2fa-popup">
        <div class="totp-2fa-popup-inner">
            <h2 class="totp-2fa-title">Check your email</h2>
            <p class="totp-2fa-subtitle">Enter the 6-digit code we sent to your email address</p>
            <div id="email-otp-2fa-error" class="totp-2fa-error" style="display: none;"></div>
            <div class="totp-2fa-form">
                <input type="text" id="email-otp-2fa-code" class="totp-2fa-input main-home-form-input" placeholder="000000" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" />
                <div class="totp-2fa-actions">
                    <button type="button" id="email-otp-2fa-verify-btn" class="main-home-btn main-home-btn-auth-submit totp-2fa-btn">Verify</button>
                    <button type="button" class="main-home-forgot-btn totp-2fa-cancel" id="email-otp-2fa-cancel-btn">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- OTP Channel Selection Overlay -->
<div id="otp-channel-selection-overlay" class="totp-2fa-overlay" style="display: none;">
    <div class="totp-2fa-popup">
        <div class="totp-2fa-popup-inner">
            <h2 class="totp-2fa-title">Choose Verification Method</h2>
            <p class="totp-2fa-subtitle">Select how you want to receive your 6-digit code</p>
            <div class="totp-2fa-actions" style="flex-direction: column; gap: 0.75rem;">
                <button type="button" id="otp-send-email-btn" class="main-home-btn main-home-btn-auth-submit totp-2fa-btn" style="width: 100%;">
                    <i class="bx bx-envelope"></i> Send to Email
                </button>
                <button type="button" id="otp-send-sms-btn" class="main-home-btn main-home-btn-auth-submit totp-2fa-btn" style="width: 100%; border-color: rgba(var(--syndicat-accent-rgb), 0.3);">
                    <i class="bx bx-phone"></i> Send to SMS (<span id="otp-phone-preview">****</span>)
                </button>
                <button type="button" class="main-home-forgot-btn totp-2fa-cancel" id="otp-channel-cancel-btn">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Confirmation Popup (for password reset complete) -->
<div id="success-confirmation-overlay" class="totp-2fa-overlay" style="display: none;">
    <div class="totp-2fa-popup">
        <div class="totp-2fa-popup-inner">
            <div class="totp-2fa-icon" style="color: #ff4b5c; font-size: 3rem; margin-bottom: 1rem; text-align: center;">
                <i class="bx bx-check-shield"></i>
            </div>
            <h2 class="totp-2fa-title">Access Restored</h2>
            <p id="success-confirmation-message" class="totp-2fa-subtitle">Your credentials have been updated. Check your email for your new password.</p>
            <div class="totp-2fa-actions">
                <button type="button" id="success-confirmation-btn" class="main-home-btn main-home-btn-auth-submit totp-2fa-btn">Got it</button>
            </div>
        </div>
    </div>
</div>

<!-- Layout Wrapper -->
<div class="main-home-layout-wrapper">
    <div class="main-home-page">
        <!-- Include Shared Navbar -->
        {% include 'frontend/shared/_main_navbar.html.twig' with {'active_tab': 'sign_in'} %}

        <!-- Auth Content -->
        <div class="main-home-content-wrapper">
            <div class="main-home-auth-container">
                <div class="main-home-auth-card {{ show_destination_choice|default(false) ? 'main-home-auth-card--destination' : 'main-home-auth-card--signin' }}" id="signin-auth-card">
                    {% if show_destination_choice|default(false) %}
                        <div class="main-home-auth-destination">
                            <div class="main-home-auth-destination-header">
                                <div class="main-home-auth-destination-icon">✓</div>
                                <h1 class="main-home-auth-title">You're in</h1>
                                <p class="main-home-auth-subtitle">Where do you want to go?</p>
                            </div>
                            <div class="main-home-auth-destination-buttons">
                                <a href="{{ path('main_home') }}" class="main-home-destination-btn main-home-destination-btn--home">
                                    <span class="main-home-destination-btn-icon">🏠</span>
                                    <span class="main-home-destination-btn-text">Log into Home</span>
                                </a>
                                <a href="{{ path('admin_dashboard') }}" class="main-home-destination-btn main-home-destination-btn--dashboard">
                                    <span class="main-home-destination-btn-icon">📊</span>
                                    <span class="main-home-destination-btn-text">Dashboard</span>
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <div class="main-home-auth-flex-container">
                            <div class="main-home-auth-form-column">
                                <div class="main-home-auth-form-wrap">
                                    <div class="main-home-auth-header" style="margin-bottom: 0.25rem;">
                                        <h1 class="main-home-auth-title" style="font-size: 1.8rem; margin-bottom: 0;">Welcome Back</h1>
                                        <p class="main-home-auth-subtitle" style="font-size: 1rem;">Sign in to continue</p>
                                    </div>

                                    <div id="signin-ajax-error" class="main-home-auth-error" style="display: {{ (error is defined and error) ? 'block' : 'none' }};">{{ error|default('') }}</div>

                                    <form id="signin-form" class="main-home-auth-form" action="{{ path('auth_sign_in') }}" method="POST" novalidate data-no-page-loader style="gap: 0.75rem;">
                                        <div class="main-home-form-row">
                                            <div class="main-home-form-group main-home-form-half">
                                                <label for="email" class="main-home-form-label">Email</label>
                                                <input 
                                                    type="email" 
                                                    id="email" 
                                                    name="email" 
                                                    class="main-home-form-input" 
                                                    placeholder="Enter your email"
                                                    value="{{ last_email|default('') }}"
                                                />
                                            </div>

                                            <div class="main-home-form-group main-home-form-half">
                                                <label for="password" class="main-home-form-label">Password</label>
                                                <div class="main-home-password-wrapper">
                                                    <input 
                                                        type="password" 
                                                        id="password" 
                                                        name="password" 
                                                        class="main-home-form-input" 
                                                        placeholder="Enter your password"
                                                    />
                                                    <button type="button" class="main-home-password-toggle" onclick="togglePassword('password')">
                                                        <span class="main-home-eye-icon">👁️</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="auth-actions-grid">
                                            <!-- Left: Actions Stack -->
                                            <div class="auth-buttons-column">
                                                <button type="submit" class="main-home-btn main-home-btn-auth-submit" id="signin-submit-btn">Sign In</button>
                                                <button type="button" class="main-home-forgot-btn" id="request-otp-btn" style="display: none;">Send OTP</button>
                                                <a href="#" class="main-home-forgot-btn" id="forgot-password-link">Forgot Password?</a>
                                            </div>

                                            <div class="auth-actions-divider"></div>

                                            <!-- Right: Security Verification -->
                                            {% if hcaptcha_site_key is defined and hcaptcha_site_key %}
                                            <div class="auth-captcha-column">
                                                <div class="premium-captcha-container">
                                                    <div class="captcha-label">
                                                        <i class="bx bxs-shield-quarter"></i>
                                                        <span>Security</span>
                                                    </div>
                                                    <div class="main-home-hcaptcha-wrap">
                                                        <div class="h-captcha" data-sitekey="{{ hcaptcha_site_key }}" data-theme="dark"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            {% endif %}
                                        </div>
                                                
                                            <div class="auth-social-divider" style="margin: 0.5rem 0;">
                                                <span>Or continue with</span>
                                            </div>

                                            <div class="auth-methods-container">
                                                <div class="auth-methods-primary">
                                                    <a href="{{ path('auth_google_connect') }}" class="main-home-social-btn main-home-social-google" style="text-decoration: none; flex: 1;">
                                                        <span class="main-home-social-icon"><i class="bx bxl-google" style="color: #4285F4;"></i></span>
                                                        <span>Sign in with Google</span>
                                                    </a>
                                                    <button type="button" id="toggle-more-auth" class="main-home-social-btn auth-more-toggle" title="More login options">
                                                        <i class="bx bx-chevron-down"></i>
                                                    </button>
                                                </div>

                                                <div class="auth-methods-secondary" id="secondary-auth-methods">
                                                    <div class="secondary-methods-content">
                                                        <button type="button" class="main-home-social-btn main-home-social-github">
                                                            <span class="main-home-social-icon"><i class="bx bxl-github"></i></span>
                                                            <span>GitHub</span>
                                                        </button>
                                                        <div class="biometric-methods-grid">
                                                            <button type="button" id="webauthn-login-btn" class="main-home-social-btn main-home-biometric-btn">
                                                                <i class="bx bx-fingerprint"></i>
                                                                <span>Passkey</span>
                                                            </button>
                                                            <button type="button" id="faceid-login-btn" class="main-home-social-btn main-home-biometric-btn">
                                                                <i class="bx bx-camera-home"></i>
                                                                <span>Face ID</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>

                                    <p class="main-home-auth-footer" style="margin-top: 0.5rem; text-align: center; font-size: 0.8rem;">
                                        Don't have an account? 
                                        <a href="{{ path('user_signup') }}" class="main-home-auth-link">Sign Up</a>
                                    </p>
                                </div>
                            </div>

                            <!-- Face ID panel: NOW INSIDE the flex row -->
                            <div class="main-home-auth-faceid-column" id="faceid-panel">
                                <div class="faceid-panel-inner">
                                    <div class="faceid-header">
                                        <h2 class="faceid-title">Face ID</h2>
                                        <button type="button" class="faceid-close" id="faceid-panel-close" aria-label="Close">&times;</button>
                                    </div>
                                    <div class="faceid-media-section">
                                        <div class="faceid-video-wrapper">
                                            <video id="faceid-auth-video" autoplay muted playsinline></video>
                                            <div class="faceid-overlay">
                                                <div class="scanner-frame"></div>
                                            </div>
                                        </div>
                                        <div id="faceid-auth-liveness-hint" class="faceid-status-hint">
                                            <i class="bx bx-scan"></i> <span>Initializing...</span>
                                        </div>
                                    </div>
                                    <div class="faceid-controls">
                                        <div class="faceid-camera-row">
                                            <select id="faceid-auth-camera-select" class="faceid-custom-select" style="display: none;">
                                                <option value="">Default Camera</option>
                                            </select>
                                            <button type="button" id="faceid-auth-switch-camera" class="faceid-switch-btn" style="display: none;">
                                                <i class="bx bx-sync"></i> Switch
                                            </button>
                                        </div>
                                        <div class="faceid-input-wrap">
                                            <label class="faceid-input-label">PIN</label>
                                            <input type="password" id="faceid-auth-pin" class="faceid-modern-input" placeholder="Enter PIN">
                                        </div>
                                        <button type="button" class="faceid-verify-btn" id="faceid-auth-verify-btn">Verify</button>
                                    </div>
                                </div>
                            </div>
                        </div> <!-- End .main-home-auth-flex-container -->

                        <!-- Face ID Scripts -->
                        <script src="{{ asset('vendor/face-api/face-api.min.js') }}"></script>
                        <script src="{{ asset('frontend/js/face-id.js') }}"></script>

                            <script src="{{ asset('frontend/js/webauthn.js') }}"></script>
                            <script>
                                (function() {
                                    // WebAuthn Login
                                    document.getElementById('webauthn-login-btn')?.addEventListener('click', async () => {
                                        const email = document.getElementById('email').value;
                                        if (!email) {
                                            window.pushNotif('Please enter your email first to use biometrics.', 'WARNING');
                                            return;
                                        }
                                        
                                        const btn = document.getElementById('webauthn-login-btn');
                                        const originalContent = btn.innerHTML;
                                        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Authenticating...';
                                        btn.disabled = true;

                                        try {
                                            const success = await WebAuthn.authenticate(email);
                                            if (success) {
                                                window.location.href = "{{ path('main_home') }}";
                                            }
                                        } catch (err) {
                                            console.error(err);
                                            window.pushNotif(err.message || 'Authentication failed', 'ERROR');
                                        } finally {
                                            btn.innerHTML = originalContent;
                                            btn.disabled = false;
                                        }
                                    });

                                    // Face ID: expands right side of the same sign-in card
                                    const faceLoginBtn = document.getElementById('faceid-login-btn');
                                    const card = document.getElementById('signin-auth-card') || document.querySelector('.main-home-auth-card');
                                    const panelCloseBtn = document.getElementById('faceid-panel-close');
                                    const video = document.getElementById('faceid-auth-video');
                                    const livenessHint = document.getElementById('faceid-auth-liveness-hint');
                                    const verifyBtn = document.getElementById('faceid-auth-verify-btn');
                                    const pinInput = document.getElementById('faceid-auth-pin');
                                    const cameraSelect = document.getElementById('faceid-auth-camera-select');
                                    const switchBtn = document.getElementById('faceid-auth-switch-camera');

                                    let stream = null;
                                    let currentDeviceId = null;

                                    async function getCameras() {
                                        try {
                                            const devices = await navigator.mediaDevices.enumerateDevices();
                                            const videoDevices = devices.filter(d => d.kind === 'videoinput');
                                            if (videoDevices.length > 1) {
                                                cameraSelect.innerHTML = videoDevices.map(d => `<option value="${d.deviceId}">${d.label || 'Camera ' + d.deviceId.slice(0,5)}</option>`).join('');
                                                cameraSelect.style.display = 'block';
                                                switchBtn.style.display = 'block';
                                            } else {
                                                cameraSelect.style.display = 'none';
                                                switchBtn.style.display = 'none';
                                            }
                                        } catch (e) { console.warn('Cam list error:', e); }
                                    }

                                    async function startStream(deviceId = null) {
                                        if (stream) { stream.getTracks().forEach(t => t.stop()); }
                                        const constraints = {
                                            video: deviceId ? { deviceId: { exact: deviceId } } : { facingMode: 'user' }
                                        };
                                        stream = await navigator.mediaDevices.getUserMedia(constraints);
                                        video.srcObject = stream;
                                        currentDeviceId = deviceId;
                                    }

                                    function closeFacePanel() {
                                        if (card) card.classList.remove('faceid-active');
                                        if (stream) {
                                            stream.getTracks().forEach(t => t.stop());
                                            stream = null;
                                        }
                                    }

                                    faceLoginBtn?.addEventListener('click', async () => {
                                        const email = document.getElementById('email').value;
                                        if (!email) {
                                            window.pushNotif('Please enter your email first.', 'WARNING');
                                            return;
                                        }
                                        if (card) card.classList.add('faceid-active');
                                        try {
                                            await startStream();
                                            await getCameras();
                                            livenessHint.innerHTML = '<i class="bx bx-scan"></i> <span>Awaiting facial signature...</span>';
                                        } catch (e) {
                                            window.pushNotif('Camera access denied or error: ' + e.message, 'ERROR');
                                            closeFacePanel();
                                        }
                                    });

                                    if (panelCloseBtn) panelCloseBtn.addEventListener('click', closeFacePanel);

                                    switchBtn.onclick = async () => {
                                        const nextId = cameraSelect.value;
                                        if (nextId === currentDeviceId) return;
                                        try { await startStream(nextId); } catch (e) { window.pushNotif('Failed to switch camera', 'ERROR'); }
                                    };

                                    cameraSelect.onchange = () => switchBtn.click();

                                    verifyBtn.onclick = async () => {
                                        const email = document.getElementById('email').value;
                                        const pin = pinInput.value;
                                        if (!pin) { window.pushNotif('Please enter your PIN', 'WARNING'); return; }

                                        verifyBtn.disabled = true;
                                        verifyBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Verifying...';

                                        try {
                                            const result = await FaceID.authenticate(video, email, pin);
                                            if (result.status === 'ok') {
                                                window.location.href = "{{ path('main_home') }}";
                                            }
                                        } catch (e) {
                                            window.pushNotif(e.message, 'ERROR');
                                        } finally {
                                            verifyBtn.disabled = false;
                                            verifyBtn.innerHTML = 'Verify & Authenticate';
                                        }
                                    };
                                })();
                            </script>

                        </div> {# auth-form-wrap #}
                    {% endif %}
                </div> {# auth-card #}
            </div> {# auth-container #}
        </div> {# content-wrapper #}

        <!-- Include Shared Footer -->
        {% include 'frontend/shared/_main_footer.html.twig' %}
    </div> {# main-home-page #}
</div> {# main-home-layout-wrapper #}

<!-- Scroll pill + JavaScript Dependencies -->
{% include 'frontend/shared/_scroll_pill.html.twig' %}

<script src="{{ asset('frontend/js/scroll-pill.js') }}" defer></script>
<script src="{{ asset('vendor/bootstrap/bootstrap.bundle.min.js') }}" defer></script>
<script src="{{ asset('frontend/js/main-home.js') }}" defer></script>
<script src="{{ asset('js/page-loader.js') }}"></script>
{% if hcaptcha_site_key is defined and hcaptcha_site_key %}
<script src="{{ asset('frontend/js/hcaptcha-signin.js') }}" defer></script>
{% endif %}
<script>
    // Password toggle
    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        input.type = input.type === 'password' ? 'text' : 'password';
    }
    // Destination choice animation (admin roles post-login)
    {% if show_destination_choice|default(false) %}
    document.addEventListener('DOMContentLoaded', function() {
        var card = document.querySelector('.main-home-auth-card--destination');
        var btns = document.querySelectorAll('.main-home-destination-btn');
        if (card) card.classList.add('main-home-auth-card--destination-visible');
        btns.forEach(function(btn, i) {
            btn.style.animationDelay = (0.15 * (i + 1)) + 's';
        });
    });
    {% endif %}
</script>

<!-- Global Video Background -->
{% include 'frontend/shared/_global_video_background.html.twig' %}

<style>
