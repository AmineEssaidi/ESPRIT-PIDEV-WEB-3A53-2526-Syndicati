    align-items: center;
    gap: 0.35rem;
    background: rgba(var(--main-home-accent-rgb), 0.08);
    padding: 0.4rem 0.75rem;
    border-radius: 100px;
    border: 1px solid rgba(var(--main-home-accent-rgb), 0.15);
}

/* Controls: compact row + PIN + Verify, no scroll */
.faceid-controls {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    max-width: 100%;
