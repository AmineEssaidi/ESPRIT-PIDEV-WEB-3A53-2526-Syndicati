<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle More Auth Options
    const toggleBtn = document.getElementById('toggle-more-auth');
    const secondaryMethods = document.getElementById('secondary-auth-methods');
    if (toggleBtn && secondaryMethods) {
        toggleBtn.addEventListener('click', function() {
            const isActive = this.classList.toggle('active');
            secondaryMethods.classList.toggle('active');
        });
    }

    const requestOtpBtn = document.getElementById('request-otp-btn');
    const otpRequestSection = document.getElementById('otp-request-section');
    const otpCodeInput = document.getElementById('otp-code-input');
    const otpVerifyBtn = document.getElementById('otp-verify-btn');
    const otpResendBtn = document.getElementById('otp-resend-btn');
    const otpCancelBtn = document.getElementById('otp-cancel-btn');
    const emailInput = document.getElementById('email');
    const signinForm = document.getElementById('signin-form');
    const signinSubmitBtn = document.getElementById('signin-submit-btn');
    const authErrorEl = document.getElementById('signin-ajax-error');
    
    const forgotLink = document.getElementById('forgot-password-link');
    const otpOverlay = document.getElementById('email-otp-2fa-overlay');
    const otpInput = document.getElementById('email-otp-2fa-code');
    const otpVerifyBtnOverlay = document.getElementById('email-otp-2fa-verify-btn');
    const otpCancelBtnOverlay = document.getElementById('email-otp-2fa-cancel-btn');
    const otpErrorOverlay = document.getElementById('email-otp-2fa-error');

    // Forgot Password Flow
    forgotLink?.addEventListener('click', async (e) => {
        e.preventDefault();
        const email = emailInput?.value.trim();
        if (!email) {
            if (authErrorEl) { authErrorEl.textContent = 'Please enter your email first to reset your password.'; authErrorEl.style.display = 'block'; }
            return;
        }

        forgotLink.style.opacity = '0.5';
        forgotLink.style.pointerEvents = 'none';
        forgotLink.textContent = 'Processing...';

        try {
            const response = await fetch("{{ path('auth_forgot_password_request') }}", {
                method: 'POST',
                body: JSON.stringify({ email }),
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            
            if (data.success) {
                otpOverlay?.setAttribute('data-otp-mode', 'reset');
                const title = otpOverlay?.querySelector('.totp-2fa-title');
                const subtitle = otpOverlay?.querySelector('.totp-2fa-subtitle');
                if (title) title.textContent = 'Reset Password';
                if (subtitle) subtitle.textContent = 'Enter the 6-digit code to reset your password';
                
                if (otpOverlay) otpOverlay.style.display = 'flex';
                if (authErrorEl) authErrorEl.style.display = 'none';
            } else {
                if (authErrorEl) { authErrorEl.textContent = data.message; authErrorEl.style.display = 'block'; }
            }
        } catch (err) {
            if (authErrorEl) { authErrorEl.textContent = 'An error occurred. Please try again.'; authErrorEl.style.display = 'block'; }
        } finally {
            forgotLink.style.opacity = '1';
            forgotLink.style.pointerEvents = 'auto';
            forgotLink.textContent = 'Forgot Password?';
        }
    });

    // Verification Logic (Shared for Overlay)
    otpVerifyBtnOverlay?.addEventListener('click', async () => {
        const email = emailInput?.value.trim();
        const code = otpInput?.value.trim();
        const mode = otpOverlay?.getAttribute('data-otp-mode') || 'login';

        if (!code || code.length !== 6) {
            if (otpErrorOverlay) { otpErrorOverlay.textContent = 'Please enter a valid 6-digit code.'; otpErrorOverlay.style.display = 'block'; }
            return;
        }

        otpVerifyBtnOverlay.disabled = true;
        otpVerifyBtnOverlay.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Verifying...';

        try {
            const endpoint = mode === 'reset' 
                ? "{{ path('auth_forgot_password_verify') }}" 
                : "{{ path('2fa_verify_otp_login') }}";

            const response = await fetch(endpoint, {
                method: 'POST',
                body: JSON.stringify({ email, code }),
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();

            if (data.success) {
                if (otpOverlay) otpOverlay.style.display = 'none';
                if (otpInput) otpInput.value = '';
                
                if (mode === 'reset') {
                    const successOverlay = document.getElementById('success-confirmation-overlay');
                    const successMessage = document.getElementById('success-confirmation-message');
                    if (successOverlay && successMessage) {
                        successMessage.textContent = data.message;
                        successOverlay.style.display = 'flex';
                    } else {
                        alert(data.message);
                    }
                } else if (data.redirect) {
                    window.location.href = data.redirect;
                } else {
                    window.location.reload();
                }
            } else {
                if (otpErrorOverlay) { otpErrorOverlay.textContent = data.message; otpErrorOverlay.style.display = 'block'; }
            }
        } catch (err) {
            if (otpErrorOverlay) { otpErrorOverlay.textContent = 'Verification error. Please try again.'; otpErrorOverlay.style.display = 'block'; }
        } finally {
            otpVerifyBtnOverlay.disabled = false;
            otpVerifyBtnOverlay.innerHTML = 'Verify';
        }
    });

    document.getElementById('success-confirmation-btn')?.addEventListener('click', () => {
        document.getElementById('success-confirmation-overlay').style.display = 'none';
    });

    // AJAX sign-in
    if (signinForm && signinSubmitBtn) {
        signinForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const email = emailInput?.value.trim();
            const password = document.getElementById('password')?.value;
            if (!email || !password) {
                if (authErrorEl) { authErrorEl.textContent = 'Please enter your email and password.'; authErrorEl.style.display = 'block'; }
                return;
            }
            if (authErrorEl) authErrorEl.style.display = 'none';
            var btnHtml = signinSubmitBtn.innerHTML;
            signinSubmitBtn.disabled = true;
            signinSubmitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Signing in...';
            try {
                var formData = new FormData(signinForm);
                var response = await fetch('{{ path("auth_sign_in") }}', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });
                var data = await response.json().catch(function() { return {}; });
                if (data.requireTotp) {
                    var overlay = document.getElementById('totp-2fa-overlay');
                    var codeInput = document.getElementById('totp-2fa-code');
                    if (overlay) overlay.style.display = 'flex';
                    if (codeInput) { codeInput.value = ''; codeInput.focus(); }
                } else if (data.requireEmailOtp) {
                    otpOverlay?.setAttribute('data-otp-mode', 'login');
                    if (otpOverlay) otpOverlay.style.display = 'flex';
                    if (otpInput) { otpInput.value = ''; otpInput.focus(); }
                } else if (data.redirect) {
                    window.location.href = data.redirect;
                    return;
                } else if (data.success === false && data.error) {
                    if (authErrorEl) { authErrorEl.textContent = data.error; authErrorEl.style.display = 'block'; }
                }
            } catch (err) {
                if (authErrorEl) { authErrorEl.textContent = 'Something went wrong. Please try again.'; authErrorEl.style.display = 'block'; }
            } finally {
                signinSubmitBtn.disabled = false;
                signinSubmitBtn.innerHTML = btnHtml;
            }
        });
    }

    // Show request OTP button when email is entered
    if (emailInput) {
        emailInput.addEventListener('input', function() {
            const email = this.value.trim();
            if (email && email.includes('@')) {
                if (requestOtpBtn) requestOtpBtn.style.display = 'flex';
            } else {
                if (requestOtpBtn) requestOtpBtn.style.display = 'none';
            }
        });
    }

    // Request OTP code
    if (requestOtpBtn) {
        requestOtpBtn.addEventListener('click', async function() {
            const email = emailInput?.value.trim();
            if (!email || !email.includes('@')) {
                alert('Please enter a valid email address in the Email box first');
                return;
            }

            const originalHtml = this.innerHTML;
            this.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Checking...';
            this.disabled = true;

            try {
                const channelCheck = await fetch('{{ path("2fa_check_channels") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ email: email })
                });

                const channelData = await channelCheck.json();
                if (channelData.success && channelData.channels && channelData.channels.length > 1) {
                    const selectionOverlay = document.getElementById('otp-channel-selection-overlay');
                    const phonePreview = document.getElementById('otp-phone-preview');
                    if (phonePreview) phonePreview.textContent = channelData.phone || '****';
                    
                    if (selectionOverlay) {
                        selectionOverlay.style.display = 'flex';
                        const emailBtn = document.getElementById('otp-send-email-btn');
                        const smsBtn = document.getElementById('otp-send-sms-btn');
                        const cancelBtn = document.getElementById('otp-channel-cancel-btn');

                        const sendCodeFunc = async (channel) => {
                            selectionOverlay.style.display = 'none';
                            this.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Sending...';
                            await performOtpRequest(email, channel, this, originalHtml);
                        };

                        emailBtn.onclick = () => sendCodeFunc('email');
                        smsBtn.onclick = () => sendCodeFunc('sms');
                        cancelBtn.onclick = () => {
                            selectionOverlay.style.display = 'none';
                            this.innerHTML = originalHtml;
                            this.disabled = false;
                        };
                    }
                } else {
                    this.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Sending...';
                    await performOtpRequest(email, 'email', this, originalHtml);
                }
            } catch (error) {
                console.error('Error:', error);
                this.innerHTML = originalHtml;
                this.disabled = false;
                await performOtpRequest(email, 'email', this, originalHtml);
            }
        });
    }

    async function performOtpRequest(email, channel, btn, originalHtml) {
        try {
            const response = await fetch('{{ path("2fa_request_otp") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ email: email, channel: channel })
            });

            const data = await response.json();
            if (data.success) {
                otpOverlay?.setAttribute('data-otp-mode', 'login');
                const title = otpOverlay?.querySelector('.totp-2fa-title');
                const subtitle = otpOverlay?.querySelector('.totp-2fa-subtitle');
                const targetText = channel === 'sms' ? 'phone' : 'email';
                if (title) title.textContent = channel === 'sms' ? 'Check your phone' : 'Check your email';
                if (subtitle) subtitle.textContent = 'Enter the 6-digit code we sent to your ' + targetText;
                
                if (otpOverlay) otpOverlay.style.display = 'flex';
                if (otpInput) { otpInput.value = ''; otpInput.focus(); }
                if (otpErrorOverlay) otpErrorOverlay.style.display = 'none';
                
                if (typeof showCoolPopup === 'function') {
                    showCoolPopup('Code sent', 'Verification code sent to your ' + targetText, 'success');
                }
            } else {
                alert(data.message || 'Failed to send OTP code');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Failed to send OTP code. Please try again.');
        } finally {
            if (btn) { btn.innerHTML = originalHtml; btn.disabled = false; }
        }
    }

    if (otpResendBtn) {
        otpResendBtn.addEventListener('click', function() {
            requestOtpBtn?.click();
        });
    }

    if (otpCancelBtn) {
        otpCancelBtn.addEventListener('click', function() {
            if (otpRequestSection) otpRequestSection.style.display = 'none';
            if (signinSubmitBtn) signinSubmitBtn.style.display = 'inline-flex';
            if (otpCodeInput) otpCodeInput.value = '';
        });
    }

    // Biometrics
    const totpOverlay = document.getElementById('totp-2fa-overlay');
    const totp2faCodeInput = document.getElementById('totp-2fa-code');
    const totp2faVerifyBtn = document.getElementById('totp-2fa-verify-btn');
    const totp2faCancelBtn = document.getElementById('totp-2fa-cancel-btn');
    const totpErrorEl = document.getElementById('totp-2fa-error');

    if (totpOverlay && totp2faCodeInput && totp2faVerifyBtn) {
        totp2faCancelBtn?.addEventListener('click', async function() {
            try { await fetch('{{ path("2fa_cancel_login") }}', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } }); } catch (e) {}
            totpOverlay.style.display = 'none';
            if (totp2faCodeInput) totp2faCodeInput.value = '';
        });
        totp2faCodeInput.addEventListener('input', function() { this.value = this.value.replace(/\D/g, '').slice(0, 6); });
        totp2faVerifyBtn.addEventListener('click', async function() {
            const code = totp2faCodeInput.value.trim();
            if (code.length !== 6) return;
            const originalHtml = totp2faVerifyBtn.innerHTML;
            totp2faVerifyBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Verifying...';
            totp2faVerifyBtn.disabled = true;
            try {
                const response = await fetch('{{ path("2fa_verify_totp_login") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ code: code })
                });
                const data = await response.json();
                if (data.success && data.redirect) { window.location.href = data.redirect; return; }
                if (totpErrorEl) { totpErrorEl.textContent = data.message || 'Invalid code.'; totpErrorEl.style.display = 'block'; }
            } catch (err) {
                if (totpErrorEl) { totpErrorEl.textContent = 'Something went wrong.'; totpErrorEl.style.display = 'block'; }
            } finally {
                totp2faVerifyBtn.innerHTML = originalHtml;
                totp2faVerifyBtn.disabled = false;
            }
        });
    }
});
</script>

<script src="{{ asset('frontend/js/syndicati-agent.js') }}" defer></script>
<script src="{{ asset('frontend/js/syndicati-messaging.js') }}" defer></script>

</body>
