<script>
// Main Home specific JavaScript
document.addEventListener('DOMContentLoaded', function() {
    // Initialize theme toggle (override external JS version)
    initMainHomeThemeToggle();
    
    // Initialize heart animation
    setupHeartAnimation();
    
    // Initialize interactive elements
    initInteractiveElements();
    
    // Initialize animations
    initAnimations();
    
    // Initialize tab dropdowns
    initTabDropdowns();
});

function initMainHomeThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    
    // Load saved theme
    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);
    
    if (themeToggle) {
        // Remove any existing listeners by cloning
        const newToggle = themeToggle.cloneNode(true);
        themeToggle.parentNode.replaceChild(newToggle, themeToggle);
        
        newToggle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            
            console.log('Theme changed to:', newTheme);
        });
        
        console.log('Theme toggle initialized successfully');
    } else {
        console.error('Theme toggle element not found');
    }
}

function setupHeartAnimation() {
    // Heart animation is handled by CSS
    console.log('Heart animation initialized');
}

function initInteractiveElements() {
    // Search functionality is handled by the header search
    console.log('Interactive elements initialized');
}

function initAnimations() {
    // Add entrance animations to welcome cards
    const welcomeCards = document.querySelectorAll('.main-home-welcome-card');
    welcomeCards.forEach((card, index) => {
        card.style.animationDelay = `${index * 0.1}s`;
        card.classList.add('animate-in');
    });
}

// Tab dropdown functionality
function initTabDropdowns() {
    const navTabs = document.querySelectorAll('.main-home-nav-tab');
    let hoverTimeout;
    let isHovering = false;
    
    function closeAllDropdowns() {
        navTabs.forEach(tab => {
            const dropdown = tab.querySelector('.main-home-tab-dropdown');
            if (dropdown) {
                dropdown.style.display = 'none';
            }
        });
    }
    
    navTabs.forEach(tab => {
        const dropdown = tab.querySelector('.main-home-tab-dropdown');
        const tabText = tab.querySelector('.main-home-tab-text');
        const homeLink = tabText.querySelector('a');
        
        // Handle Home tab (has link, no dropdown)
        if (homeLink) {
            // Home tab should behave like other tabs but navigate on click
            tabText.addEventListener('click', function(e) {
                // Let the link handle navigation naturally
                // No preventDefault needed
            });
            
            // No hover dropdown functionality for Home tab
            return;
        }
        
        // Only add dropdown functionality to tabs that have dropdowns
        if (!dropdown) {
            return;
        }
        
        // Click to toggle dropdown
        tabText.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const isOpen = dropdown.style.display === 'block';
            closeAllDropdowns();
            
            if (!isOpen) {
                dropdown.style.display = 'block';
            }
        });
        
        // Hover to show dropdown - more reliable
        tab.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            isHovering = true;
            closeAllDropdowns();
            dropdown.style.display = 'block';
        });
        
        // Hover to hide dropdown with delay
        tab.addEventListener('mouseleave', function() {
            isHovering = false;
            hoverTimeout = setTimeout(() => {
                if (!isHovering) {
                    dropdown.style.display = 'none';
                }
            }, 300); // Increased delay for better UX
        });
        
        // Keep dropdown open when hovering over it
        dropdown.addEventListener('mouseenter', function() {
            clearTimeout(hoverTimeout);
            isHovering = true;
        });
        
        dropdown.addEventListener('mouseleave', function() {
            isHovering = false;
            hoverTimeout = setTimeout(() => {
                if (!isHovering) {
                    dropdown.style.display = 'none';
                }
            }, 300);
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!tab.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    });
}

<!-- Scroll Down Pill -->
<div class="scroll-down-pill-wrapper" id="scrollDownPill">
    <button class="scroll-down-pill" id="scrollPillBtnDown" aria-label="Scroll down">
        <span style="display:inline-block; font-size:2.1rem; line-height:1; vertical-align:middle;">&#8595;</span>
    </button>
    <button class="scroll-down-pill" id="scrollPillBtnUp" aria-label="Scroll up" style="display:none; margin-left:12px;">
        <span style="display:inline-block; font-size:2.1rem; line-height:1; vertical-align:middle;">&#8593;</span>
