<style>
.scroll-down-pill-wrapper {
    position: fixed;
    left: 50%;
    bottom: 36px;
    transform: translateX(-50%);
    z-index: 9999;
    pointer-events: auto;
    width: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: width 0.4s cubic-bezier(.4,0,.2,1);
}
.scroll-down-pill {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--scroll-pill-bg, #fff);
    color: var(--scroll-pill-text, #222);
    border-radius: 32px;
    box-shadow: 0 2px 8px 0 rgba(90,90,214,0.10);
    padding: 14px 22px;
    font-size: 1.5rem;
    font-family: var(--font-primary), 'Inter', 'Segoe UI', Arial, sans-serif;
    font-weight: 700;
    opacity: 0.98;
    pointer-events: auto;
    cursor: pointer;
    border: none;
    outline: none;
    transition: background 0.2s, color 0.2s, box-shadow 0.2s, opacity 0.3s, transform 0.2s cubic-bezier(.4,0,.2,1);
    letter-spacing: 0.04em;
    overflow: visible;
}
.scroll-down-pill.morph {
    transform: scale(1.08) rotate(-3deg);
    box-shadow: 0 8px 24px 0 rgba(90,90,214,0.18);
}
</style>
<script>
(function() {
    var btnDown = document.getElementById('scrollPillBtnDown');
    var btnUp = document.getElementById('scrollPillBtnUp');
    var morphed = false;
    var downClickTimeout = null;
    var upClickTimeout = null;
    var dblDelay = 300;

    if (!btnDown || !btnUp) {
        return;
    }

    function ensureSplitShown() {
        if (!morphed) {
            morphed = true;
            // Show the up button immediately, make morph very quick
            btnUp.style.display = 'flex';
            btnDown.classList.add('morph');
            setTimeout(function() {
                btnDown.classList.remove('morph');
            }, 120);
        }
    }

    function scrollOneDown() {
        window.scrollBy({
            top: window.innerHeight,
            left: 0,
            behavior: 'smooth'
        });
    }

    function scrollToBottom() {
        var doc = document.documentElement;
        var body = document.body || { scrollHeight: 0 };
        var scrollHeight = Math.max(doc.scrollHeight, body.scrollHeight);
        var target = scrollHeight - window.innerHeight;
        if (target < 0) target = 0;
        window.scrollTo({
            top: target,
            left: 0,
            behavior: 'smooth'
        });
    }

    function scrollOneUp() {
        var target = window.scrollY - window.innerHeight;
        if (target < 0) target = 0;
        window.scrollTo({
            top: target,
            left: 0,
            behavior: 'smooth'
        });
    }

    function scrollToTop() {
        window.scrollTo({
            top: 0,
            left: 0,
            behavior: 'smooth'
        });
    }

    function resetIfAtTop() {
        if (window.scrollY <= 0) {
            // Back at the very top: only show down button
            btnUp.style.display = 'none';
            btnDown.style.display = 'flex';
            morphed = false;
        }
    }

    function resetIfAtBottom() {
        var doc = document.documentElement;
        var body = document.body || { scrollHeight: 0 };
        var scrollHeight = Math.max(doc.scrollHeight, body.scrollHeight);

        // Avoid conflicting with "top" logic on very small pages
        if (window.scrollY <= 0) {
            return;
        }

        if (window.innerHeight + window.scrollY >= scrollHeight - 2) {
            // At or near bottom: hide down, keep up visible
            btnDown.style.display = 'none';
            btnUp.style.display = 'flex';
        } else if (morphed) {
            // In the middle of the page after split: keep both visible
            btnDown.style.display = 'flex';
            btnUp.style.display = 'flex';
        }
    }

    // Down button: single-click = one viewport down, double-click = bottom
    btnDown.addEventListener('click', function(e) {
        e.preventDefault();
        clearTimeout(downClickTimeout);
        downClickTimeout = setTimeout(function() {
            scrollOneDown();
            ensureSplitShown();
        }, dblDelay);
    });

    btnDown.addEventListener('dblclick', function(e) {
        e.preventDefault();
        clearTimeout(downClickTimeout);
        scrollToBottom();
        ensureSplitShown();
    });

    // Up button: single-click = one viewport up, double-click = top
    btnUp.addEventListener('click', function(e) {
        e.preventDefault();
        clearTimeout(upClickTimeout);
        upClickTimeout = setTimeout(function() {
            scrollOneUp();
        }, dblDelay);
    });

    btnUp.addEventListener('dblclick', function(e) {
        e.preventDefault();
        clearTimeout(upClickTimeout);
        scrollToTop();
    });

    function handleScroll() {
        resetIfAtTop();
        resetIfAtBottom();
    }

    window.addEventListener('scroll', handleScroll);
    handleScroll();
})();
</script>
</body>
</html>
