{% extends 'base_symfony.html.twig' %}
{% block title %}Forum - Horizon Community{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/forum.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
{% set currentUser = currentUser|default(app.session.get('user')) %}
<div class="main-home-layout-wrapper">
    <div class="main-home-page">
        {% include 'frontend/shared/_main_navbar.html.twig' with {'active_tab': 'forum'} %}
        
        <div class="main-home-page-content" style="padding: 0 0 2rem 0; min-height: 100vh;">
            
             <!-- 1. HERO SECTION (Move Outside Container) -->
             <div class="forum-hero-section mb-5">
                <div class="forum-hero-bg-glow"></div>
                <div class="forum-hero-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8" style="padding-left: 5vw;">
                            <span class="forum-hero-badge">
                                <i class='bx bxs-conversation'></i> Community Hub
                            </span>
                            <h1 class="forum-hero-title">Voices of<br>Horizon.</h1>
                            <p class="forum-hero-text">
                                Join the conversation. Connect with neighbors, share ideas, and help shape our community together.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="forum-container">
                {# Hidden inputs for JS context #}
                {% if currentUser is not null %}
                    <input type="hidden" id="currentUserId" value="{{ currentUser.id_user ?? currentUser.id }}">
                    <input type="hidden" id="currentUserRole" value="{{ currentUser.role }}">
                {% endif %}

                <!-- 2. MAIN SPLIT VIEW CONTAINER -->
                <div class="forum-split-container" style="height: 92vh; min-height: 1050px;">
                    
                    <!-- LEFT: GLASS SWITCHER (Main Content) -->
                    <div id="forumGlassSwitcher" class="forum-split-main glass-switcher style-slide">
                        
                        <!-- FACE 1: READ VIEW -->
                        <div class="glass-switcher-face glass-switcher-face-main">
                            <div id="splitViewContent" class="h-100 d-flex flex-column">
                                <!-- Hero Image Overlay -->
                                <div id="splitViewHero" class="forum-detail-hero">
                                    <div class="forum-hero-text-overlay">
                                        <div class="mb-2">
                                            <span id="splitViewCategory" class="badge bg-primary">Select a Topic</span>
                                            <span id="splitViewDate" class="text-white-50 ms-2"></span>
                                        </div>
                                        <h1 id="splitViewTitle" class="text-white fw-bold mb-3 display-6" style="text-shadow: 0 4px 10px rgba(0,0,0,0.5);">Welcome to the Forum</h1>
                                        <div class="d-flex align-items-center">
                                            <div id="splitViewAvatar" class="forum-list-avatar me-2">H</div>
                                            <span id="splitViewAuthor" class="text-white fw-semibold">Horizon Community</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Scrollable Body -->
                                <div class="forum-main-content custom-scrollbar">
                                    <div class="forum-detail-body">
                                        <div id="splitViewDescription" class="details-text-content mb-5">
                                            <p class="text-white-50 text-center mt-5">Select a discussion from the sidebar to start reading.</p>
                                        </div>

                                        <!-- Owner Actions -->
                                        <div id="splitViewActions" class="d-none mb-4 p-3 rounded-4" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                            <div class="d-flex gap-2">
                                                <button id="btnEditSplit" class="action-btn" title="Edit Post"><i class='bx bxs-edit-alt'></i> Edit</button>
                                                <button id="btnDeleteSplit" class="action-btn" title="Delete Post"><i class='bx bxs-trash'></i> Delete</button>
                                            </div>
                                        </div>

                                        <!-- Comments -->
                                        <div id="commentsSection" class="comments-section d-none">
                                            <h4 class="comments-section-title mb-4">
                                                <i class='bx bx-message-rounded-dots text-primary'></i> Discussion
                                            </h4>
                                            <div id="commentsList" class="comments-wrapper mb-4"></div>

                                            {% if app.session.get('user') %}
                                                <div class="comment-form-container p-4">
                                                    <form id="addCommentForm" action="" method="POST" enctype="multipart/form-data">
                                                        <div class="glass-form-group mb-3">
                                                            <textarea name="description" class="glass-textarea" rows="3" placeholder="Share your thoughts..." style="background: rgba(0,0,0,0.2) !important;"></textarea>
                                                        </div>
                                                        <!-- Image Upload (Optional) -->
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div class="comment-upload-group">
                                                                <label for="commentImageInput" class="comment-img-upload-btn">
                                                                    <i class='bx bx-image-add'></i>
                                                                </label>
                                                                <input type="file" name="image" id="commentImageInput" accept="image/*" class="d-none">
                                                                <div id="commentImagePreviewContainer" class="d-none">
                                                                    <div id="commentImagePreview" class="comment-img-preview-box"></div>
                                                                    <div id="removeCommentImg" class="comment-img-remove-btn"><i class='bx bx-x'></i></div>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-3">
                                                                <label class="visibility-pill-toggle">
                                                                    <input type="checkbox" name="visibility" id="commentVisibilityToggle" checked>
                                                                    <div class="visibility-pill-slider"></div>
                                                                    <div class="visibility-pill-option">
                                                                        <i class='bx bx-user-x'></i>
                                                                        <span>Anon</span>
                                                                    </div>
                                                                    <div class="visibility-pill-option">
                                                                        <i class='bx bx-planet'></i>
                                                                        <span>Public</span>
                                                                    </div>
                                                                </label>
                                                                <button type="submit" class="glass-btn-save">Post <i class='bx bx-send ms-2'></i></button>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- FACE 2: CREATE FORM -->
                        <div class="glass-switcher-face glass-switcher-face-extra">
                            <div class="h-100 d-flex flex-column p-4">
                                <div class="card-header-actions mb-4">
                                    <button type="button" class="btn-switcher-back" onclick="window.switchGlassFace('main')">
                                        <i class='bx bx-arrow-back'></i> Back to Discussion
                                    </button>
                                    <h4 class="text-white m-0">Create New Post</h4>
                                </div>
                                <div class="forum-main-content custom-scrollbar p-1">
                                    {{ form_start(form, {'attr': {'id': 'createPostForm', 'class': 'syndicat-form', 'data-ajax': 'true'}}) }}
                                        <div class="glass-form-group">
                                            <label class="glass-label">Title</label>
                                            {{ form_widget(form.titre_pub, {'attr': {'class': 'glass-input', 'placeholder': 'Enter title', 'data-min-length': '5', 'required': 'required'}}) }}
                                        </div>
                                        <div class="glass-form-group" id="createCategoryGroup">
                                            <label class="glass-label">Category</label>
                                            {{ form_widget(form.categorie_pub, {'attr': {'class': 'glass-select', 'id': 'createCategorySelect'}}) }}
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Description</label>
                                            {{ form_widget(form.description_pub, {'attr': {'class': 'glass-textarea', 'rows': '8', 'data-min-length': '10', 'required': 'required'}}) }}
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Image (Optional)</label>
                                            {{ form_widget(form.image_pub, {'attr': {'class': 'glass-input'}}) }}
                                        </div>
                                        <button type="submit" class="glass-btn-save w-100 mt-3">Post Now <i class='bx bx-send ms-1'></i></button>
                                    {{ form_end(form) }}
                                </div>
                            </div>
                        </div>

                        <!-- FACE 3: EDIT FORM -->
                        <div class="glass-switcher-face glass-switcher-face-edit">
                            <div class="h-100 d-flex flex-column p-4">
                                <div class="card-header-actions mb-4">
                                    <button type="button" class="btn-switcher-back" onclick="window.switchGlassFace('main')">
                                        <i class='bx bx-arrow-back'></i> Cancel Edit
                                    </button>
                                    <h4 class="text-white m-0">Edit Post</h4>
                                </div>
                                <div class="forum-main-content custom-scrollbar p-1">
                                    <form id="editPostForm" method="POST" enctype="multipart/form-data" class="syndicat-form" data-ajax="true">
                                        <div class="glass-form-group">
                                            <label class="glass-label">Title</label>
                                            <input type="text" name="title" id="editPostTitle" class="glass-input" required>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Category</label>
                                            <select name="category" id="editPostCategory" class="glass-select" required>
                                                {% for cat in constant('App\\Entity\\Forum\\Publication::CATEGORIES') %}
                                                    <option value="{{ cat }}">{{ cat }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Description</label>
                                            <textarea name="description" id="editPostDescription" class="glass-textarea" rows="8" required></textarea>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Update Image</label>
                                            <input type="file" name="image_pub" class="glass-input" accept="image/*">
                                        </div>
                                        <button type="submit" class="glass-btn-save w-100 mt-3">Save Changes <i class='bx bx-check ms-1'></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- RIGHT: SIDEBAR -->
                    <div class="forum-split-sidebar">
                        <div class="forum-sidebar-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="m-0 text-white fw-bold">Discussions</h5>
                            </div>
                            
                            <!-- MOVED BUTTONS -->
                            {% if app.session.get('user') %}
                                <div class="d-flex gap-2">
                                    <button class="btn-sidebar-action primary flex-grow-1" onclick="window.switchGlassFace('extra', false)">
                                        <i class='bx bx-plus-circle'></i> New Post
                                    </button>
                                    {% if currentUser.role in ['ADMIN', 'SUPERADMIN', 'OWNER', 'SYNDIC'] %}
                                        <button class="btn-sidebar-action" title="New Announcement" style="width: auto;" onclick="window.switchGlassFace('extra', true)">
                                            <i class='bx bxs-megaphone'></i>
                                        </button>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                        <div class="forum-list-wrapper custom-scrollbar">
                            {% for publication in publications|filter(p => p.categoriePub != 'Announcement') %}
                                {% include 'frontend/forum/_list_item.html.twig' with {
                                    'publication': publication,
                                    'author_profile': author_profiles[publication.user.idUser]|default(null)
                                } %}
                            {% else %}
                                <div class="text-center text-white-50 mt-5">
                                    <i class='bx bx-message-square-dots fs-1 mb-2'></i>
                                    <p>No discussions yet.</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                </div><!-- End Split Container -->

            </div><!-- End Forum Container -->
        </div><!-- End Page Content -->

        {% include 'frontend/shared/_main_footer.html.twig' %}
    </div>
</div>

<!-- SHARED COMPONENTS -->

<!-- Toast Notification -->
<div id="forumToast" class="forum-toast">
    <div class="toast-content">
        <i id="toastIcon" class='bx bx-check-circle'></i>
        <span id="toastMessage"></span>
    </div>
</div>

<!-- CUSTOM POPUP -->
<script>
    window.showCoolPopup = function(title, message, type = 'success') {
        // Reuse existing popup structure or create simple alert
        alert(`${title}\n\n${message}`); 
        // Note: For full "Cool Popup", check layout overrides. 
        // I will rely on standard alert for fallback or inject the cool popup HTML if needed.
    };
    // Inject Cool Popup HTML 
    document.write(`
    <div id="coolPopup" class="cool-popup-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:9999; justify-content:center; align-items:center;">
        <div class="cool-popup-content p-5 text-center rounded-4 border border-secondary" style="background: #1a1a2e; max-width:400px;">
            <div id="coolPopupIcon" class="fs-1 mb-3"></div>
            <h3 id="coolPopupTitle" class="text-white fw-bold"></h3>
            <p id="coolPopupMessage" class="text-white-50 mb-4"></p>
            <button onclick="document.getElementById('coolPopup').style.display='none'" class="btn btn-primary w-100">Got it</button>
        </div>
    </div>`);
    
    window.showCoolPopup = function(title, message, type) {
        const p = document.getElementById('coolPopup');
        document.getElementById('coolPopupTitle').textContent = title;
        document.getElementById('coolPopupMessage').innerHTML = message;
        document.getElementById('coolPopupIcon').innerHTML = type === 'success' ? '✅' : '❌';
        p.style.display = 'flex';
    };
</script>

<!-- Confirm Delete Modal -->
<div id="confirmDeleteModal" class="glass-modal-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:9999; justify-content:center; align-items:center;">
    <div class="glass-modal-container p-4 rounded-4 border border-danger text-center" style="background: #1a1a2e; max-width:400px;">
        <i class='bx bxs-error-circle text-danger fs-1 mb-3'></i>
        <h3 class="text-white fw-bold">Delete Post?</h3>
        <p class="text-white-50">This action cannot be undone.</p>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <button onclick="document.getElementById('confirmDeleteModal').style.display='none'" class="btn btn-outline-light">Cancel</button>
            <button id="btnConfirmDeleteAction" class="btn btn-danger">Yes, Delete</button>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('frontend/js/form-validation.js') }}"></script>
    <script src="{{ asset('frontend/js/forum.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (document.getElementById('createPostForm')) {
                document.getElementById('createPostForm').validator = new FormValidator('createPostForm');
            }
            if (document.getElementById('editPostForm')) {
                // Manually init validation for edit form which uses raw HTML
                 const editValidator = new FormValidator('editPostForm', {
                    errorClass: 'glass-form-error'
                });
                // Add constraints manually since we used raw inputs
                 const titleInput = document.getElementById('editPostTitle');
                 if(titleInput) { titleInput.dataset.minLength = '10'; titleInput.required = true; }
                 
                 const descInput = document.getElementById('editPostDescription');
                 if(descInput) { descInput.dataset.minLength = '50'; descInput.required = true; }
                 
                 document.getElementById('editPostForm').validator = editValidator;
            }
        });
    </script>
{% endblock %}
