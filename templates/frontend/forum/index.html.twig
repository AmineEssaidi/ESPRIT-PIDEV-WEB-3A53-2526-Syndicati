{% extends 'base_symfony.html.twig' %}
{% block title %}Forum - Horizon Community{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/forum.css') }}" rel="stylesheet">
    <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
    <style>
        /* Any module-specific forum overrides can go here */
    </style>
{% endblock %}

{% block body %}
{% set currentUser = currentUser|default(app.session.get('user')) %}
<div class="main-home-layout-wrapper">
    <div class="main-home-page">
        {% include 'frontend/shared/_main_navbar.html.twig' with {'active_tab': 'forum'} %}
        
        <div class="main-home-page-content" style="padding: 0 0 2rem 0; min-height: 100vh;">
            
             <!-- 1. HERO SECTION (Move Outside Container) -->
             <div class="forum-hero-section mb-5">
                <div class="forum-hero-bg-glow"></div>
                <div class="forum-hero-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8" style="padding-left: 5vw;">
                            <span class="forum-hero-badge">
                                <i class='bx bxs-conversation'></i> Community Hub
                            </span>
                            <h1 class="forum-hero-title">Voices of<br>Horizon.</h1>
                            <p class="forum-hero-text">
                                Join the conversation. Connect with neighbors, share ideas, and help shape our community together.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="forum-container">
                {# Hidden inputs for JS context #}
                {% if currentUser is not null %}
                    <input type="hidden" id="currentUserId" value="{{ currentUser.id_user ?? currentUser.id }}">
                    <input type="hidden" id="currentUserRole" value="{{ currentUser.role }}">
                {% endif %}

                <!-- 2. MAIN SPLIT VIEW CONTAINER -->
                <div class="forum-split-container" style="height: 88vh; min-height: 700px;">
                    
                    <!-- LEFT: GLASS SWITCHER (Main Content) -->
                    <div id="forumGlassSwitcher" class="forum-split-main glass-switcher style-slide">
                        
                        <!-- FACE 1: READ VIEW -->
                        <div class="glass-switcher-face glass-switcher-face-main h-100">
                            <div id="splitViewContent" class="h-100 d-flex flex-column custom-scrollbar">
                                <!-- Hero Image Overlay -->
                                <div id="splitViewHero" class="forum-detail-hero">
                                    <div class="forum-hero-text-overlay">
                                        <div class="mb-2">
                                            <span id="splitViewCategory" class="badge bg-primary">Select a Topic</span>
                                            <span id="splitViewDate" class="text-white-50 ms-2"></span>
                                        </div>
                                        <h1 id="splitViewTitle" class="text-white fw-bold mb-3 display-6" style="text-shadow: 0 4px 10px rgba(0,0,0,0.5);">Welcome to the Forum</h1>
                                        <div class="d-flex align-items-center">
                                            <div id="splitViewAvatar" class="forum-list-avatar me-2">H</div>
                                            <span id="splitViewAuthor" class="text-white fw-semibold">Horizon Community</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Scrollable Body -->
                                <div class="forum-main-content custom-scrollbar">
                                    <div class="forum-detail-body">
                                        <div id="splitViewDescription" class="details-text-content mb-5">
                                            <p class="text-white-50 text-center mt-5">Select a discussion from the sidebar to start reading.</p>
                                        </div>

                                        <!-- Owner Actions -->
                                        <!-- UNIFIED ACTION BAR (ADMIN + REACTIONS) -->
                                        <div id="splitViewActionBar" class="d-flex flex-wrap align-items-center gap-2 mb-4 p-2 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1);">
                                            
                                            <!-- REACTIONS -->
                                            <div class="d-flex gap-2 border-end pe-2 me-1" style="border-color: rgba(255,255,255,0.1) !important;">
                                                <button class="reaction-btn btn-like" onclick="window.toggleReaction('Like')" title="Like">
                                                    <i class='bx bx-like'></i> <span class="count"></span>
                                                </button>
                                                <button class="reaction-btn btn-dislike" onclick="window.toggleReaction('Dislike')" title="Dislike">
                                                    <i class='bx bx-dislike'></i> <span class="count"></span>
                                                </button>
                                            </div>

                                            <!-- RATIO BAR -->
                                            <div class="ratio-bar-container mx-2 d-flex align-items-center gap-2" style="width: 150px;">
                                                <div id="publicationRatioBar" class="ratio-bar flex-grow-1">
                                                    <div class="ratio-fill" style="width: 0%;"></div>
                                                </div>
                                                <small id="publicationRatioText" class="text-white-50" style="font-size: 0.7rem; min-width: 30px;">0%</small>
                                            </div>

                                            <div class="d-flex gap-2">
                                                <div class="position-relative">
                                                    <button class="reaction-btn btn-emoji" onclick="window.toggleEmojiPicker(event)" title="React with Emoji">
                                                        <i class='bx bx-smile'></i>
                                                    </button>
                                                    <div id="emojiPicker" class="emoji-picker-popup d-none">
                                                        <div class="emoji-grid">
                                                            <span onclick="window.reactEmoji('❤️')">❤️</span>
                                                            <span onclick="window.reactEmoji('😂')">😂</span>
                                                            <span onclick="window.reactEmoji('😮')">😮</span>
                                                            <span onclick="window.reactEmoji('😢')">😢</span>
                                                            <span onclick="window.reactEmoji('😡')">😡</span>
                                                            <span onclick="window.reactEmoji('👍')">👍</span>
                                                            <span onclick="window.reactEmoji('🔥')">🔥</span>
                                                            <span onclick="window.reactEmoji('✨')">✨</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <button class="reaction-btn btn-bookmark" onclick="window.toggleReaction('Bookmark')" title="Bookmark">
                                                    <i class='bx bx-bookmark'></i>
                                                </button>
                                            </div>

                                            <!-- OWNER ACTIONS (Conditionally Hidden) -->
                                            <div id="splitViewOwnerActions" class="d-none d-flex gap-2">
                                                <button id="btnEditSplit" class="action-btn" title="Edit Post"><i class='bx bxs-edit-alt'></i> Edit</button>
                                                <button id="btnDeleteSplit" class="action-btn" title="Delete Post"><i class='bx bxs-trash'></i> Delete</button>
                                            </div>

                                            <button class="reaction-btn btn-report ms-auto" onclick="window.toggleReportPanel()" title="Report Publication">
                                                <i class='bx bx-flag'></i>
                                            </button>
                                        </div>

                                        <!-- INLINE REPORT PANEL -->
                                        <div id="reportPanel" class="report-panel mb-4 overflow-hidden" style="max-height: 0; transition: max-height 0.3s ease-out;">
                                            <div class="p-4 rounded-4" style="background: rgba(255, 75, 92, 0.05); border: 1px solid rgba(255, 75, 92, 0.2);">
                                                <h5 class="text-white mb-3 d-flex align-items-center gap-2">
                                                    <i class='bx bxs-error-circle text-danger'></i> Report Publication
                                                </h5>
                                                <textarea id="reportReason" class="glass-textarea mb-3" rows="3" placeholder="Why are you reporting this? (e.g. spam, harassment, inappropriate content...)" style="background: rgba(0,0,0,0.2) !important;"></textarea>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button onclick="window.toggleReportPanel()" class="btn btn-sm btn-outline-light rounded-pill px-3">Cancel</button>
                                                    <button onclick="window.submitInlineReport(event)" class="btn btn-sm btn-danger rounded-pill px-3 d-flex align-items-center gap-2">
                                                        Submit Report <i class='bx bx-send'></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Comments -->
                                        <div id="commentsSection" class="comments-section d-none">
                                            <h4 class="comments-section-title mb-4">
                                                <i class='bx bx-message-rounded-dots text-primary'></i> Discussion
                                            </h4>
                                            <div id="commentsList" class="comments-wrapper mb-4"></div>

                                            {% if app.session.get('user') %}
                                                <div class="comment-form-container p-4">
                                                    <form id="addCommentForm" action="" method="POST" enctype="multipart/form-data" data-ajax="true">
                                                        <div class="glass-form-group mb-3">
                                                            <textarea name="description_commentaire" id="comment_description" class="glass-textarea" rows="3" placeholder="Share your thoughts..." style="background: rgba(0,0,0,0.2) !important;" required minlength="5"></textarea>
                                                            <div class="main-home-validation-message" data-field="description_commentaire"></div>
                                                        </div>
                                                        <!-- Image Upload (Optional) -->
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div class="comment-upload-group">
                                                                <label for="commentImageInput" class="comment-img-upload-btn">
                                                                    <i class='bx bx-image-add'></i>
                                                                </label>
                                                                <input type="file" name="image_commentaire" id="commentImageInput" accept="image/*" class="d-none">
                                                                <div id="commentImagePreviewContainer" class="d-none">
                                                                    <div id="commentImagePreview" class="comment-img-preview-box"></div>
                                                                    <div id="removeCommentImg" class="comment-img-remove-btn"><i class='bx bx-x'></i></div>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-3">
                                                                <label class="visibility-pill-toggle">
                                                                    <input type="checkbox" name="visibility" id="commentVisibilityToggle" checked>
                                                                    <div class="visibility-pill-slider"></div>
                                                                    <div class="visibility-pill-option">
                                                                        <i class='bx bx-user-x'></i>
                                                                        <span>Anon</span>
                                                                    </div>
                                                                    <div class="visibility-pill-option">
                                                                        <i class='bx bx-planet'></i>
                                                                        <span>Public</span>
                                                                    </div>
                                                                </label>
                                                                <button type="submit" class="glass-btn-save">Post <i class='bx bx-send ms-2'></i></button>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- FACE 2: CREATE FORM -->
                        <div class="glass-switcher-face glass-switcher-face-extra">
                            <div class="h-100 d-flex flex-column p-4">
                                <div class="card-header-actions mb-4">
                                    <button type="button" class="btn-switcher-back" onclick="window.switchGlassFace('main')">
                                        <i class='bx bx-arrow-back'></i> Back to Discussion
                                    </button>
                                    <h4 class="text-white m-0">Create New Post</h4>
                                </div>
                                <div class="forum-main-content custom-scrollbar p-1">
                                    {{ form_start(form, {'attr': {'id': 'createPostForm', 'class': 'syndicat-form', 'data-ajax': 'true'}}) }}
                                        <div class="glass-form-group">
                                            <label class="glass-label">Title</label>
                                            {{ form_widget(form.titre_pub, {'attr': {'class': 'glass-input', 'id': 'create_titre_pub', 'placeholder': 'Enter title', 'minlength': '5', 'required': 'required'}}) }}
                                            <div class="main-home-validation-message" data-field="titre_pub"></div>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Category</label>
                                            {{ form_widget(form.categorie_pub, {'attr': {'class': 'glass-select', 'id': 'create_categorie_pub'}}) }}
                                            <div class="main-home-validation-message" data-field="categorie_pub"></div>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Description</label>
                                            {{ form_widget(form.description_pub, {'attr': {'class': 'glass-textarea', 'id': 'create_description_pub', 'rows': '8', 'minlength': '20', 'required': 'required'}}) }}
                                            <div class="main-home-validation-message" data-field="description_pub"></div>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Image (Optional)</label>
                                            {{ form_widget(form.image_pub, {'attr': {'class': 'glass-input', 'id': 'create_image_pub'}}) }}
                                            <div class="main-home-validation-message" data-field="image_pub"></div>
                                        </div>
                                        <button type="submit" class="glass-btn-save w-100 mt-3">Post Now <i class='bx bx-send ms-1'></i></button>
                                    {{ form_end(form) }}
                                </div>
                            </div>
                        </div>

                        <!-- FACE 3: EDIT FORM -->
                        <div class="glass-switcher-face glass-switcher-face-edit">
                            <div class="h-100 d-flex flex-column p-4">
                                <div class="card-header-actions mb-4">
                                    <button type="button" class="btn-switcher-back" onclick="window.switchGlassFace('main')">
                                        <i class='bx bx-arrow-back'></i> Cancel Edit
                                    </button>
                                    <h4 class="text-white m-0">Edit Post</h4>
                                </div>
                                <div class="forum-main-content custom-scrollbar p-1">
                                    <form id="editPostForm" method="POST" enctype="multipart/form-data" class="syndicat-form" data-ajax="true">
                                        <div class="glass-form-group">
                                            <label class="glass-label">Title</label>
                                            <input type="text" name="title" id="editPostTitle" class="glass-input" required minlength="5">
                                            <div class="main-home-validation-message" data-field="title"></div>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Category</label>
                                            <select name="category" id="editPostCategory" class="glass-select" required>
                                                {% for cat in constant('App\\Entity\\Forum\\Publication::CATEGORIES') %}
                                                    <option value="{{ cat }}">{{ cat }}</option>
                                                {% endfor %}
                                            </select>
                                            <div class="main-home-validation-message" data-field="category"></div>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Description</label>
                                            <textarea name="description" id="editPostDescription" class="glass-textarea" rows="8" required minlength="20"></textarea>
                                            <div class="main-home-validation-message" data-field="description"></div>
                                        </div>
                                        <div class="glass-form-group">
                                            <label class="glass-label">Update Image</label>
                                            <div id="editPostImageArea" class="mb-3 d-flex gap-3 flex-wrap">
                                                <!-- Current Image -->
                                                <div id="currentPostImageContainer" class="d-none">
                                                    <small class="text-white-50 d-block mb-1">Current Image:</small>
                                                    <div class="position-relative">
                                                        <img id="currentPostImgPreview" src="" class="rounded-3" style="width: 100px; height: 100px; object-fit: cover; border: 1px solid rgba(255,255,255,0.1);">
                                                    </div>
                                                </div>
                                                <!-- New Image Preview -->
                                                <div id="newPostImagePreviewContainer" class="d-none">
                                                    <small class="text-white-50 d-block mb-1">New Selection:</small>
                                                    <div class="position-relative">
                                                        <img id="newPostImgPreview" src="" class="rounded-3" style="width: 100px; height: 100px; object-fit: cover; border: 2px solid var(--main-home-accent-color);">
                                                        <div id="removeNewPostImg" class="comment-img-remove-btn" style="top:-5px; right:-5px;"><i class='bx bx-x'></i></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <input type="file" name="image_pub" id="editPostImageInput" class="glass-input" accept="image/*">
                                        </div>
                                        <button type="submit" class="glass-btn-save w-100 mt-3">Save Changes <i class='bx bx-check ms-1'></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- RIGHT: SIDEBAR -->
                    <div class="forum-split-sidebar">
                        <div class="forum-sidebar-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="m-0 text-white fw-bold">Discussions</h5>
                            </div>
                            
                            <!-- MOVED BUTTONS -->
                            {% if app.session.get('user') %}
                                <div class="d-flex gap-2">
                                    <button class="btn-sidebar-action primary flex-grow-1" onclick="window.switchGlassFace('extra', false)">
                                        <i class='bx bx-plus-circle'></i> New Post
                                    </button>
                                    {% if currentUser.role in ['ADMIN', 'SUPERADMIN', 'OWNER', 'SYNDIC'] %}
                                        <button class="btn-sidebar-action" title="New Announcement" style="width: auto;" onclick="window.switchGlassFace('extra', true)">
                                            <i class='bx bxs-megaphone'></i>
                                        </button>
                                    {% endif %}
                                </div>

                                <!-- CATEGORY FILTERS -->
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn-sidebar-action flex-grow-1 active" id="btnFilterGeneral" onclick="window.loadForumCategory('General', this)">
                                        <i class='bx bx-grid-alt'></i> General
                                    </button>
                                    <button class="btn-sidebar-action flex-grow-1" id="btnFilterAnnouncement" onclick="window.loadForumCategory('Announcement', this)">
                                        <i class='bx bxs-megaphone'></i> Announcements
                                    </button>
                                </div>
                            {% endif %}
                        </div>
                        <div class="forum-list-wrapper custom-scrollbar" id="forumListContainer">
                            {% for publication in publications|filter(p => p.categoriePub != 'Announcement') %}
                                {% include 'frontend/forum/_list_item.html.twig' with {
                                    'publication': publication,
                                    'author_profile': author_profiles[publication.user.idUser]|default(null)
                                } %}
                            {% else %}
                                <div class="text-center text-white-50 mt-5">
                                    <i class='bx bx-message-square-dots fs-1 mb-2'></i>
                                    <p>No discussions yet.</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                </div><!-- End Split Container -->

            </div><!-- End Forum Container -->
        </div><!-- End Page Content -->

        {% include 'frontend/shared/_main_footer.html.twig' %}
    </div>
</div>

<!-- SHARED COMPONENTS -->

<!-- Toast Notification -->
<div id="forumToast" class="forum-toast">
    <div class="toast-content">
        <i id="toastIcon" class='bx bx-check-circle'></i>
        <span id="toastMessage"></span>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('frontend/js/form-validation.js') }}"></script>
    <script src="{{ asset('frontend/js/forum.js') }}"></script>
    <script>
        // FormValidator auto-initializes via Global Auto-Init in form-validation.js
    </script>
{% endblock %}
