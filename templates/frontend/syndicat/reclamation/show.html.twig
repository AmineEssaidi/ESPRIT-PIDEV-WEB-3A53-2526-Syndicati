<h2>Détails de la réclamation</h2>

<p><strong>Titre:</strong> {{ reclamation.titrereclamations }}</p>
<p><strong>Description:</strong> {{ reclamation.descreclamation }}</p>
<p><strong>Date:</strong> {{ reclamation.datereclamation | date }}</p>
<p><strong>Status:</strong> {{ reclamation.statutreclamation }}</p>

<hr>

<h3>Réponses</h3>

{% if reclamation.reponses is empty %}
    <p>Aucune réponse pour cette réclamation.</p>
{% else %}
    <table border="2">
        <tr>
            <td>Message</td>
            <td>Date</td>
        </tr>

        {% for r in reclamation.reponses %}
            <tr>
                <td>{{ r.messagereponse }}</td>
                <td>{{ r.datereponse | date }}</td>
            </tr>
        {% endfor %}
    </table>
{% endif %}

<br>

<a href="{{ path('frontend_syndicat_reclamation') }}">
    ⬅ Retour à la liste
</a>
