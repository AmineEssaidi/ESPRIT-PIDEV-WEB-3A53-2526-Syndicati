<div class="modal-header border-bottom border-secondary pb-3">
    <div>
        <h5 class="modal-title text-white fw-bold mb-1">{{ reclamation.titrereclamations }}</h5>
        <span class="badge bg-{{ reclamation.statutreclamation == 'active' ? 'success' : (reclamation.statutreclamation == 'en_attente' ? 'warning' : 'danger') }}">
            {{ reclamation.statutreclamation|capitalize }}
        </span>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <!-- Description -->
    <div class="p-3 rounded-3 bg-dark-subtle mb-3 border border-secondary border-opacity-25">
        <p class="mb-0 text-light small">{{ reclamation.descreclamation }}</p>
    </div>

    <!-- Images -->
    {% if images is defined and images is not empty %}
        <div class="d-flex gap-2 mb-4 overflow-auto pb-2">
            {% for img in images %}
                <a href="{{ asset('reclamation_images/' ~ img) }}" target="_blank" class="flex-shrink-0">
                    <img src="{{ asset('reclamation_images/' ~ img) }}" class="rounded-3 border border-secondary" style="height: 80px; width: 80px; object-fit: cover; cursor: zoom-in;">
                </a>
            {% endfor %}
        </div>
    {% endif %}

    <hr class="border-secondary opacity-25">

    <!-- Discussion -->
    <h6 class="text-white mb-3 d-flex align-items-center gap-2">
        <i class='bx bx-message-square-detail text-primary'></i> Discussion
    </h6>
    
    <div class="d-flex flex-column gap-3 mb-4 pe-2" style="max-height: 400px; overflow-y: auto;">
        {% for reponse in reclamation.reponses %}
            <div class="d-flex {{ reponse.user.idUser == app.session.get('user').id ? 'justify-content-end' : 'justify-content-start' }}">
                <div class="card border-0 shadow-sm {{ reponse.user.idUser == app.session.get('user').id ? 'bg-primary text-white' : 'bg-secondary bg-opacity-25 text-light' }}" style="max-width: 85%; border-radius: 12px; {{ reponse.user.idUser == app.session.get('user').id ? 'border-bottom-right-radius: 2px;' : 'border-bottom-left-radius: 2px;' }}">
                    <div class="card-body p-2 px-3">
                        <div class="d-flex justify-content-between align-items-center mb-1 gap-3">
                            <span class="fw-bold" style="font-size: 0.75rem;">{{ reponse.titrereponse ?: 'Response' }}</span>
                            <small class="opacity-75" style="font-size: 0.65rem;">
                                {{ reponse.user.firstName }} • {{ reponse.createdAt|date('M d, H:i') }}
                            </small>
                        </div>
                        <p class="mb-0 small" style="white-space: pre-wrap;">{{ reponse.messagereponse }}</p>
                        
                        {% if reponse.imagereponse %}
                             {% set respImagesRaw = reponse.imagereponse %}
                             {% if '[' in respImagesRaw %}
                                 {% set respImages = respImagesRaw|json_decode %}
                             {% else %}
                                 {% set respImages = [respImagesRaw] %}
                             {% endif %}

                             {% if respImages %}
                                <div class="mt-2 pt-2 border-top border-white border-opacity-25 row g-2">
                                    {% for rImg in respImages %}
                                        <div class="col-auto">
                                            <a href="{{ asset('reclamation_images/' ~ rImg) }}" target="_blank">
                                                <img src="{{ asset('reclamation_images/' ~ rImg) }}" class="rounded-2" style="max-height: 60px; object-fit: cover;">
                                            </a>
                                        </div>
                                    {% endfor %}
                                </div>
                             {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center text-secondary py-4 small">
                <i class='bx bx-ghost fs-4 mb-2 d-block'></i>
                No responses yet. Only the sound of crickets...
            </div>
        {% endfor %}
    </div>

    <!-- Reply Form -->
    <div class="bg-dark border border-secondary rounded-3 p-3">
        {{ form_start(form, {'action': path('frontend_reclamation_details', {'id': reclamation.id}), 'attr': {'id': 'reponse-form', 'class': 'd-flex flex-column gap-2'}}) }}
            
            {# Optional Title Input #}
            {{ form_widget(form.titrereponse, {'attr': {'class': 'form-control form-control-sm bg-dark text-white border-secondary mb-1', 'placeholder': 'Optional Title'}}) }}

            <div class="input-group">
                {{ form_widget(form.messagereponse, {'attr': {'class': 'form-control bg-dark text-white border-secondary', 'placeholder': 'Type your reply...', 'rows': 1, 'style': 'resize: none;'}}) }}
                <button type="submit" class="btn btn-primary"><i class='bx bx-send'></i></button>
            </div>
            
            <div class="d-flex align-items-center gap-2 mt-1">
                 <label class="btn btn-sm btn-outline-secondary border-0 text-start p-0 px-2 d-flex align-items-center gap-2 text-light opacity-75 hover-opacity-100" style="cursor: pointer;">
                    <i class='bx bx-image-add fs-5'></i> 
                    <span class="small">Attach Image</span>
                    {{ form_widget(form.imagereponse, {'attr': {'class': 'd-none', 'onchange': "if(this.files.length > 0) document.getElementById('file-chosen').textContent = this.files[0].name;"}}) }}
                </label>
                <span id="file-chosen" class="small text-muted fst-italic"></span>
            </div>
            
            {{ form_errors(form) }}
        {{ form_end(form) }}
    </div>
</div>
