<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        {% if app.session.get('is_logged_in') and app.session.get('user') is iterable %}
            <script>
                window.serverSettings = {{ app.session.get('user').settings|default({})|json_encode|raw }};
            </script>
        {% endif %}
        <script src="{{ asset('frontend/js/global-settings.js') }}"></script>
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <!-- Main Home & Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
        <link href="{{ asset('frontend/css/main-home.css') }}" rel="stylesheet">
        <link href="{{ asset('frontend/css/validation.css') }}" rel="stylesheet">
        <link href="{{ asset('frontend/css/scroll-pill.css') }}" rel="stylesheet">
        <link href="{{ asset('css/page-loader.css') }}" rel="stylesheet">
        <link href="{{ asset('frontend/css/glass-modal.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </head>
    <body style="background: transparent !important;"
          data-user-info="{{ app.session.get('user') ? 'true' : 'false' }}"
          data-user-role="{{ app.session.get('user').role|default('Guest') }}"
          data-is-admin="{{ app.session.get('user') and app.session.get('user').role in ['OWNER', 'ADMIN', 'SUPERADMIN'] ? 'true' : 'false' }}">
        {% include 'frontend/shared/_global_video_background.html.twig' %}
        
        <!-- Page Loader -->
        <div class="page-loader" id="pageLoader">
            <div class="loader-content">
                <div class="loader-dots">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>
            </div>
        </div>

        {% block body %}{% endblock %}
        {% include 'shared/_obsidian_modals.html.twig' %}
        {% include 'frontend/shared/_scroll_pill.html.twig' %}

        <script src="{{ asset('js/page-loader.js') }}"></script>
        <script src="{{ asset('js/address-bar-rewrite.js') }}"></script>
        <script src="{{ asset('frontend/js/form-validation.js') }}"></script>
        <script src="{{ asset('frontend/js/main-home.js') }}" defer></script>
        <script src="{{ asset('frontend/js/notification-manager.js') }}" defer></script>
        <script src="{{ asset('frontend/js/scroll-pill.js') }}" defer></script>
        <script src="{{ asset('js/activity-tracker.js') }}" defer></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                 const disableValidation = (form) => {
                    form.setAttribute('novalidate', 'novalidate');
                };
                document.querySelectorAll('form').forEach(disableValidation);
                const observer = new MutationObserver((mutations) => {
                    mutations.forEach((mutation) => {
                        mutation.addedNodes.forEach((node) => {
                            if (node.tagName === 'FORM') {
                                disableValidation(node);
                            } else if (node.querySelectorAll) {
                                node.querySelectorAll('form').forEach(disableValidation);
                            }
                        });
                    });
                });
                observer.observe(document.body, { childList: true, subtree: true });
            });
        </script>
        {# AI Chat / Agent bubble – same on all frontend pages (Residence, Syndicat, Forum, Evenement, etc.) #}
        <script src="{{ asset('frontend/js/syndicati-agent.js') }}" defer></script>
        <script src="{{ asset('frontend/js/syndicati-messaging.js') }}" defer></script>
    </body>
</html>
