{% extends 'emails/base_email.html.twig' %}

{% block body %}
    <h2 style="color: #ff4b5c;">Identity Synchronized</h2>
    <p>Hello {{ user.firstName }},</p>
    <p>Your Horizon account ({{ user.emailUser }}) has been successfully linked to your Google Identity.</p>

    <div style="background: rgba(255, 75, 92, 0.03); padding: 35px; border-radius: 24px; border: 1px solid rgba(255, 75, 92, 0.2); margin: 35px 0;">
        <h3 style="margin-bottom: 20px; color: #ff4b5c; font-size: 18px; letter-spacing: -0.5px;">Security Update</h3>
        
        <p style="color: rgba(255, 255, 255, 0.7); font-size: 14px; line-height: 1.6;">
            You can now bypass standard credential entry and access your dashboard with one-tap Google login. Your existing Horizon password remains unchanged.
        </p>

        <div style="margin-top: 25px; padding: 15px; background: rgba(0, 0, 0, 0.3); border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
            <p style="margin: 0; font-size: 13px; color: rgba(255, 255, 255, 0.5); text-align: center;">
                Status: <strong>LINKED</strong> • Provider: <strong>Google</strong>
            </p>
        </div>
    </div>

    <div class="button-container">
        <a href="{{ url('main_home') }}" class="button">Access Platform</a>
    </div>

    <p style="font-size: 14px; color: rgba(255, 255, 255, 0.4); text-align: center; margin-top: 40px;">
        Horizon Neural Gateway • Secure External Auth
    </p>
{% endblock %}

{% block footer_extra %}
    <p style="margin-top: 15px; font-style: italic; color: #ff4b5c; font-size: 11px;">Protocol: SOC-LINK-G-{{ user.idUser }} • Verified Provider</p>
{% endblock %}
