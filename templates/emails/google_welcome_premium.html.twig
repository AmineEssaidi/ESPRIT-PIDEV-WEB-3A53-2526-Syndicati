{% extends 'emails/base_email.html.twig' %}

{% block body %}
    <h2 style="color: #ff4b5c;">Identity Synchronized</h2>
    <p>Hello {{ user.firstName }},</p>
    <p>Your Horizon account has been automatically provisioned via Google Social Login. You can now access all features using your Google identity or the secure credentials below.</p>

    <div style="background: rgba(255, 75, 92, 0.03); padding: 35px; border-radius: 24px; border: 1px solid rgba(255, 75, 92, 0.2); margin: 35px 0;">
        <h3 style="margin-bottom: 20px; color: #ff4b5c; font-size: 18px; letter-spacing: -0.5px;">Auto-Generated Credentials</h3>
        
        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-radius: 12px; margin-bottom: 15px; border: 1px solid rgba(255,255,255,0.05);">
            <p style="margin: 0 0 5px 0; font-size: 11px; color: rgba(255, 255, 255, 0.3); text-transform: uppercase;">Username (Email)</p>
            <p style="margin: 0; font-size: 16px; color: #ffffff; font-weight: 500;">{{ user.emailUser }}</p>
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
            <p style="margin: 0 0 5px 0; font-size: 11px; color: rgba(255, 255, 255, 0.3); text-transform: uppercase;">Generated Password</p>
            <code style="font-size: 22px; color: #ff4b5c; font-weight: 700; letter-spacing: 1px;">{{ password }}</code>
        </div>

        <div style="margin-top: 25px; padding: 15px; background: rgba(255, 75, 92, 0.1); border-radius: 12px; border: 1px solid rgba(255, 75, 92, 0.2);">
            <p style="margin: 0; font-size: 13px; color: #ff4b5c; line-height: 1.5; text-align: center;">
                <strong>Security Recommendation:</strong> While you can always login with Google, it is recommended to update your account password in settings.
            </p>
        </div>
    </div>

    <div class="button-container">
        <a href="{{ url('auth_sign_in') }}" class="button">Access Platform</a>
    </div>

    <p style="font-size: 14px; color: rgba(255, 255, 255, 0.4); text-align: center; margin-top: 40px;">
        Horizon Neural Gateway • Secure External Auth
    </p>
{% endblock %}

{% block footer_extra %}
    <p style="margin-top: 15px; font-style: italic; color: #ff4b5c; font-size: 11px;">Protocol: SOC-AUTH-G-{{ user.idUser }} • Verified Provider</p>
{% endblock %}
