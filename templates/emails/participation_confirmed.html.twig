{% extends 'emails/base.html.twig' %}

{% block body %}
    <h1>Confirmation de participation</h1>
    <p>Bonjour {{ user.firstName }} {{ user.lastName }},</p>
    <p>Nous vous confirmons votre inscription à l'événement <strong>{{ evenement.titreEvent }}</strong>.</p>

    <div style="background: #f8f9fa; padding: 15px; border-radius: 5px; margin: 20px 0;">
        <h3>Récapitulatif de votre inscription :</h3>
        <ul>
            <li><strong>Date de l'événement :</strong> {{ evenement.dateEvent|date('d/m/Y H:i') }}</li>
            <li><strong>Lieu :</strong> {{ evenement.lieuEvent }}</li>
            <li><strong>Nombre d'accompagnants :</strong> {{ participation.nbAccompagnants }}</li>
        </ul>
    </div>

    <p>Nous avons hâte de vous y voir !</p>

    <p>Cordialement,<br>L'équipe Horizon</p>
{% endblock %}
