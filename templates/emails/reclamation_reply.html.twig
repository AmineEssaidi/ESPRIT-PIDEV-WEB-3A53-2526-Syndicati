{% extends 'emails/base_email.html.twig' %}

{% block body %}
    <h2 style="color: #ff4b5c;">New Response Received</h2>
    <p>Hello {{ recipientName|default(user.firstName) }},</p>
    <p>A new secure response has been added to your reclamation regarding "<strong>{{ reclamation.titrereclamations }}</strong>".</p>

    <div style="background: rgba(255, 75, 92, 0.03); padding: 30px; border-radius: 20px; border: 1px solid rgba(255, 75, 92, 0.2); margin: 35px 0;">
        <h3 style="margin-bottom: 12px; color: #ff4b5c; font-size: 18px;">Response from Agent</h3>
        <p style="font-size: 13px; color: rgba(255, 255, 255, 0.4); margin-bottom: 15px;">Sender: {{ senderName }}</p>

        <div style="margin: 20px 0; padding: 20px; background: rgba(0,0,0,0.3); border-radius: 16px; border-left: 4px solid #ff4b5c;">
            {% if reponse.titrereponse %}
                <h4 style="margin: 0 0 10px 0; color: #ffffff;">{{ reponse.titrereponse }}</h4>
            {% endif %}
            <p style="margin-bottom: 0; font-size: 15px; color: rgba(255, 255, 255, 0.9); line-height: 1.6;">
                {{ reponse.messagereponse|nl2br }}
            </p>
        </div>

        {% if imageUrls is not empty %}
        <div style="margin: 20px 0;">
            <p style="font-size: 13px; color: rgba(255, 255, 255, 0.5); margin-bottom: 10px;">Attached Intelligence:</p>
            {% for url in imageUrls %}
                <div style="display: inline-block; margin-right: 10px; margin-bottom: 10px;">
                    <img src="{{ url }}" alt="Response Image" style="width: 150px; height: 150px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1);">
                </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <div style="text-align: center; margin-top: 40px;">
        <a href="{{ url('app_reclamation_index') }}" class="button" style="display: inline-block; background: rgba(255, 75, 92, 0.1); border: 1px solid rgba(255, 75, 92, 0.4); color: #ff4b5c !important; padding: 16px 36px; border-radius: 16px; text-decoration: none; font-weight: 800; text-transform: uppercase;">View Reclamation Portal</a>
    </div>
{% endblock %}

{% block footer_extra %}
    <p style="margin-top: 15px; font-style: italic; color: #ff4b5c;">Secure Transmission • Syndicate Auth</p>
{% endblock %}
