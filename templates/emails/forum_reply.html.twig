{% extends 'emails/base_email.html.twig' %}

{% block body %}
    <h2>Hello {{ author.firstName }},</h2>
    <p><strong>{{ senderName }}</strong> just engaged with your protocol:</p>
    <p style="font-style: italic; color: #ff4b5c; font-weight: 700;">"{{ comment.publication.titrePub }}"</p>

    <div style="background: rgba(255, 75, 92, 0.03); padding: 30px; border-radius: 20px; border-left: 5px solid #ff4b5c; margin: 35px 0; box-shadow: inset 0 0 20px rgba(0,0,0,0.5);">
        <p style="margin-bottom: 0; font-size: 16px; color: rgba(255, 255, 255, 0.9); line-height: 1.6;">"{{ comment.descriptionCommentaire }}"</p>
    </div>

    <div class="button-container">
        <a href="{{ forumUrl }}" class="button">View Reaction</a>
    </div>

    <p style="font-size: 14px; color: rgba(255, 255, 255, 0.3); text-align: center;">Keep the conversation alive and maintain the momentum.</p>
{% endblock %}
