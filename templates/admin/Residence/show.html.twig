{% extends 'base.html.twig' %}
{% block title %}Residence{% endblock %}

{% block content %}
<div class="container">
    <div class="row">
                <h3>{{ residence.nomR }} à {{ residence.adresse }}</h3>

        <div class="col-sm-7">
            <img class="img-fluid rounded" src="{{ residence.imageR ? asset('images/residence/' ~  residence.imageR) : '' }}" width="600"></td>
        </div>
        <div class="col-sm-auto">


    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ residence.nomR }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ residence.adresse }}</td>
            </tr>
            <tr>
                <th>Date Ajout</th>
                <td>{{ residence.dateAjout ? residence.dateAjout|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>


    <a href="{{ path('admin_residence_edit', {'id': residence.id}) }} role="button" class="btn btn-info">edit</a>

    {{ include('admin/Residence/_delete_form.html.twig') }}

</div>
    <a href="{{ path('admin_residence') }}" class=" mt-3 btn btn-primary" role="button">back to list</a>

</div>
{% endblock %}
{% block javascripts %}
	{{ parent() }}
{% endblock %}