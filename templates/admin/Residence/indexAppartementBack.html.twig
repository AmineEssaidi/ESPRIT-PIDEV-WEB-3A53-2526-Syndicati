{% extends 'base.html.twig' %}

{% block title %}Appartement index{% endblock %}


{% block content %}
    <h1>Appartement index</h1>

        <div class="liquid-glass-table-container">
            
            <div class="evenement-table-toolbar bg-faded" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
                <div class="col-sm-3-auto">
                        <input type="text" class="evenement-search-input" placeholder="Search evenement..." title="Search evenement...">
                        <i class="bx bx-search evenement-search-icon"></i>
                </div>
                    <div class="col-sm-auto">
                        <span>Trier par: </span><button class="btn btn-primary" title="Add Evenement">ID</span>

                    </div>
                    <div class="col-sm-auto">
                        <span>Filtres: </span><button class="btn btn-primary" title="Add Evenement">ID</span>

                    </div>
                    <div class="col-sm-auto">
                    <button class="btn btn-info" title="Add Evenement">
                        <i class="bx bx-plus"></i> <a class="text-white" href="{{ path('admin_appartement_new') }}">Appartement</a>
                    </button>
                </div>
                    </div>
            <div class="container">
                <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Numero</th>
                <th>Etage</th>
                <th>Bloc</th>
                <th>Parking</th>
                <th>Disponible</th>
                <th>Image_a</th>
                <th>Type_a</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for appartement in appartements %}
            <tr>
                <td>{{ appartement.numero }}</td>
                <td>{{ appartement.etage }}</td>
                <td>{{ appartement.bloc }}</td>
                <td>{{ appartement.parking ? 'Yes' : 'No' }}</td>
                <td>{{ appartement.disponible ? 'Yes' : 'No' }}</td>
                <td><img src="{{ appartement.imageA ? asset('images/appartements/' ~  appartement.imageA) : '' }}" width="100"></td>
                <td>{{ appartement.typeA }}</td>
                <td>
                <button class="btn btn-primary"><a class="text-white" href="{{ path('admin_appartement_show', { 'id': appartement.id}) }}"><img src="https://img.icons8.com/?size=512&id=7695&format=png" width=15></a></button>
                <button class="btn btn-info"><a class="text-white" href="{{ path('admin_appartement_edit', {'id': appartement.id}) }}"><img src="https://img.icons8.com/m_two_tone/512/FFFFFF/edit.png" width=15></a></button>
                <button class="btn btn-danger"><a class="text-white" href="{{ path('admin_appartement_delete', {'id': appartement.id}) }}"><img src="https://img.icons8.com/m_rounded/512/FFFFFF/filled-trash.png" width=15></a></button>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('admin_appartement_new') }}">Create new</a>
{% endblock %}
