
{% block title %}Appartement{% endblock %}

{% block content %}
    <h1>Appartement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ appartement.id }}</td>
            </tr>
            <tr>
                <th>Numero</th>
                <td>{{ appartement.numero }}</td>
            </tr>
            <tr>
                <th>Etage</th>
                <td>{{ appartement.etage }}</td>
            </tr>
            <tr>
                <th>Bloc</th>
                <td>{{ appartement.bloc }}</td>
            </tr>
            <tr>
                <th>Parking</th>
                <td>{{ appartement.parking ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Disponible</th>
                <td>{{ appartement.disponible ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Image_a</th>
                <td>{{ appartement.imageA }}</td>
            </tr>
            <tr>
                <th>Type_a</th>
                <td>{{ appartement.typeA }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_appartement') }}">back to list</a>

    <a href="{{ path('admin_appartement_edit', {'id': appartement.id}) }}">edit</a>

    {{ include('admin/Residence/_delete_formAppartementBack.html.twig') }}
{% endblock %}
