{% block stylesheets %}
	<style>
        /* Global Modal Reset & Box Sizing */
        .users-edit-modal *, .users-edit-modal *::before, .users-edit-modal *::after {
            box-sizing: border-box !important;
        }

        /* Pill Tab Navigation */
        .users-pagination-wrapper { width: 100%; max-width: 100%; }
        .users-pagination-pills {
            position: relative;
            display: inline-flex;
            background: linear-gradient(135deg, rgba(28, 32, 42, 0.85) 80%, rgba(22, 26, 34, 0.85) 100%);
            border-radius: 999px;
            padding: 0.35rem;
            box-shadow: 0 4px 16px rgba(0,0,0,0.25);
            gap: 0.4rem;
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.08);
        }

        .pill-tab {
            position: relative;
            background: transparent;
            border: none;
            color: rgba(191,201,216,0.8);
            padding: 0.75rem 2rem;
            border-radius: 999px;
            cursor: pointer;
            font-weight: 700;
            font-size: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 2;
            white-space: nowrap;
        }
        .pill-tab:hover {
            color: #fff;
            background: rgba(255,255,255,0.05);
        }
        .pill-tab.active {
            background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
            color: #fff;
            text-shadow: none;
            box-shadow: 0 4px 12px rgba(0, 114, 255, 0.3);
        }
        .residence-page-content {
            animation: fadeIn 0.4s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Light theme for pill navigation */
        [data-theme="light"] .users-pagination-pills {
            background: linear-gradient(135deg, #f5f7fa 80%, #e3e8f7 100%);
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            border-color: #e3e8f7;
        }
        [data-theme="light"] .pill-tab {
            color: #5c6370;
        }
        [data-theme="light"] .pill-tab:hover {
            color: #23272f;
            background: rgba(0,0,0,0.02);
        }
        [data-theme="light"] .pill-tab.active {
            background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
            color: #fff;
            text-shadow: none;
            box-shadow: 0 4px 16px rgba(0,123,255,0.15);
        }


		[data-theme="light"] .residence-sort-dir-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
			color: #23272f;
		}
		[data-theme="light"] .residence-sort-dir-icon svg polyline {
			stroke: #0072ff;
		}
		[data-theme="light"] .residence-sort-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
			color: #fff !important;
			box-shadow: 0 2px 8px rgba(0,123,255,0.08);
		}
		[data-theme="light"] .residence-search-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
		}
		[data-theme="light"] .residence-search-input {
			color: #23272f;
		}
		[data-theme="light"] .residence-search-icon {
			color: #0072ff;
		}
		/* --- Residence ToolBar Styles --- */
		.residence-table-toolbar { width: 100%; display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; justify-content: space-between; }
		.residence-search-pill {
			display: flex;
			align-items: center;
			background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
			border-radius: 999px;
			padding: 0.3rem 1.1rem;
			box-shadow: 0 2px 8px rgba(0,0,0,0.10);
			position: relative;
		}
		.residence-search-input {
			background: transparent;
			border: none;
			color: #fff;
			font-size: 1rem;
			outline: none;
			width: 160px;
			padding: 0.2rem 0.5rem 0.2rem 0;
		}
		.residence-search-icon {
			color: #bfc9d8;
			font-size: 1.2rem;
			margin-left: 0.3rem;
		}
		.residence-sort-dir-pill {
			background: linear-gradient(90deg, #2a2e39 0%, #23272f 100%);
			border: none;
			border-radius: 999px;
			padding: 0.3rem 0.7rem;
			box-shadow: 0 2px 8px rgba(0,0,0,0.10);
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: background 0.18s, color 0.18s;
			outline: none;
			font-size: 1.1rem;
			color: #fff;
		}
		.residence-sort-dir-pill:active {
			background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
		}
		.residence-sort-pill {
			position: relative;
			z-index: 20;
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			border-radius: 999px;
			padding: 0.3rem 1.1rem;
			box-shadow: 0 2px 8px rgba(0,123,255,0.10);
			display: flex;
			align-items: center;
			min-width: 160px;
			cursor: pointer;
			user-select: none;
			color: #fff;
			transition: background 0.18s, color 0.18s;
		}
		.residence-sort-selected {
			flex: 1;
			font-size: 1rem;
			font-weight: 600;
			padding-right: 1.2rem;
		}
		.residence-sort-arrow {
			display: inline-block;
			width: 1.1em;
			height: 1.1em;
			background: url('data:image/svg+xml;utf8,<svg fill="white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>') no-repeat center/contain;
			margin-left: -1.1em;
		}
		.residence-sort-dropdown {
			position: absolute;
			left: 0;
			top: 110%;
			min-width: 100%;
			background: rgba(30, 60, 120, 0.85);
			border-radius: 1.2em;
			box-shadow: 0 8px 32px rgba(0,198,255,0.18);
			backdrop-filter: blur(16px) saturate(160%);
			z-index: 10;
			padding: 0.3em 0;
			display: flex;
			flex-direction: column;
			gap: 0.1em;
			animation: residence-sort-dropdown-fade 0.18s cubic-bezier(.4,1.4,.6,1) both;
		}
		@keyframes residence-sort-dropdown-fade {
			0% { opacity: 0; transform: translateY(-10px) scale(0.98); }
			100% { opacity: 1; transform: translateY(0) scale(1); }
		}
		.residence-sort-option {
			padding: 0.7em 1.5em;
			border-radius: 1em;
			color: #fff;
			font-size: 1rem;
			cursor: pointer;
			transition: background 0.13s, color 0.13s;
		}
		.residence-sort-option:hover, .residence-sort-option.active {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
		}

        /* Modal Styles */
        .users-edit-modal { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 2rem; }
        .users-edit-modal-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(8px); cursor: pointer; }
        .users-edit-modal-card { position: relative; background: linear-gradient(165deg, rgba(32, 38, 52, 0.98) 0%, rgba(20, 24, 32, 0.98) 100%); border-radius: 24px; box-shadow: 0 25px 80px rgba(0,0,0,0.7); max-width: 800px; width: 100%; border: 1px solid rgba(255,255,255,0.12); overflow: visible; max-height: 90vh; display: flex; flex-direction: column; }
        .users-edit-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.75rem 2.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .users-edit-modal-header h3 { margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: -0.01em; }
        .users-edit-modal-subtitle { margin: 0.5rem 0 0 0; font-size: 0.9rem; color: rgba(191,201,216,0.8); font-weight: 400; }
        .users-edit-modal-close { background: rgba(255,255,255,0.08); border: none; color: #bfc9d8; width: 2.4rem; height: 2.4rem; border-radius: 50%; font-size: 1.6rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.25s ease; }
        .users-edit-modal-close:hover { background: rgba(255,255,255,0.15); color: #fff; transform: rotate(90deg); }
        .users-edit-modal-body { padding: 2.25rem 2.5rem; display: flex; flex-direction: column; align-items: stretch; overflow-y: auto; scrollbar-width: none; overflow-x: visible; }
        .users-edit-modal-body::-webkit-scrollbar { display: none; }

        /* Custom Form Groups replacing forum-view-row */
        .residence-form-group { margin-bottom: 1.75rem; width: 100%; display: flex; flex-direction: column; }
        .residence-edit-label { display: block; margin-bottom: 0.75rem; color: #bfc9d8; font-weight: 600; font-size: 0.95rem; letter-spacing: 0.02em; }
        .residence-edit-input { width: 100%; border: 1px solid rgba(255, 255, 255, 0.12); padding: 0.95rem 1.25rem; border-radius: 16px; background: rgba(0, 0, 0, 0.3); color: #fff; font-size: 1rem; outline: none; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); border-left: 4px solid transparent; }
        .residence-edit-input:focus { border-color: rgba(0, 198, 255, 0.5); border-left-color: #00c6ff; background: rgba(0, 0, 0, 0.45); box-shadow: 0 8px 25px rgba(0,0,0,0.2); }
        
        [data-theme="light"] .residence-edit-input { background: #f0f4f8; border-color: #dce2e8; color: #1c202a; }
        [data-theme="light"] .residence-edit-label { color: #4a5568; }

        /* Modal Actions Grid */
        .users-edit-modal-actions { display: flex; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 1rem; align-items: center; }
        .users-edit-modal-actions-spacer { flex: 1; }

        /* Custom Dropdown UI Styles */
        .custom-glass-dropdown {
            position: relative;
            width: 100%;
            user-select: none;
        }
        .custom-glass-dropdown-trigger {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 16px;
            padding: 0 1.25rem;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: all 0.25s ease;
            font-size: 1rem;
            height: 56px;
            border-left: 4px solid transparent;
        }
        .custom-glass-dropdown-trigger:hover {
            border-color: rgba(0, 198, 255, 0.45);
            background: rgba(0, 0, 0, 0.4);
        }
        .custom-glass-dropdown.open .custom-glass-dropdown-trigger {
            border-color: #0072ff;
            border-left-color: #00c6ff;
            box-shadow: 0 10px 30px rgba(0, 114, 255, 0.15);
        }
        .custom-glass-dropdown-arrow {
            font-size: 1.4rem;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            color: #00c6ff;
        }
        .custom-glass-dropdown.open .custom-glass-dropdown-arrow {
            transform: rotate(180deg);
        }
        .custom-glass-dropdown-menu {
            position: absolute;
            top: 115%;
            left: 0;
            width: 100%;
            background: rgba(26, 30, 40, 0.98);
            backdrop-filter: blur(35px) saturate(210%);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
            z-index: 1000;
            display: none;
            flex-direction: column;
            padding: 0.75rem;
            max-height: 250px;
            overflow-y: auto;
            scrollbar-width: thin;
            animation: dropdown-pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.1) forwards;
        }
        @keyframes dropdown-pop {
            0% { opacity: 0; transform: translateY(-10px) scale(0.95); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        .custom-glass-dropdown-menu::-webkit-scrollbar { width: 5px; }
        .custom-glass-dropdown-menu::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }

        .custom-glass-dropdown-option {
            padding: 0.9rem 1.25rem;
            border-radius: 12px;
            color: rgba(191, 201, 216, 0.9);
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 1rem;
            margin-bottom: 4px;
        }
        .custom-glass-dropdown-option:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            transform: scale(1.02);
            padding-left: 1.5rem;
        }
        .custom-glass-dropdown-option.selected {
            background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
            color: #fff;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3);
        }

        /* Essential Fix for Overlapping boxes */
        .hidden-select {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            width: 0 !important;
            position: absolute !important;
            opacity: 0 !important;
            overflow: hidden !important;
        }

        /* Responsive Grid System */
        .modal-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            width: 100%;
            margin-bottom: 1.75rem;
        }

        /* Custom File Input UI */
        .custom-file-wrapper { position: relative; width: 100%; }
        .custom-file-trigger { 
            width: 100%; 
            background: rgba(0, 0, 0, 0.3); 
            border: 1px dashed rgba(255, 255, 255, 0.2); 
            border-radius: 16px; 
            padding: 1rem 1.5rem; 
            display: flex; 
            align-items: center; 
            gap: 1rem; 
            cursor: pointer; 
            transition: all 0.3s ease; 
        }
        .custom-file-trigger:hover { background: rgba(0, 198, 255, 0.05); border-color: #00c6ff; }
        .custom-file-icon { font-size: 1.8rem; color: #00c6ff; }
        .custom-file-text { flex: 1; color: rgba(191, 201, 216, 0.8); font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .custom-file-btn { background: rgba(255, 255, 255, 0.1); color: #fff; padding: 0.5rem 1rem; border-radius: 10px; font-weight: 600; font-size: 0.85rem; }

        /* Legacy Compatibility Row */
        .forum-view-row { display: flex; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .forum-view-label { min-width: 120px; font-size: 0.9rem; font-weight: 700; color: rgba(191,201,216,0.7); text-transform: uppercase; letter-spacing: 0.08em; }
        .forum-view-value { flex: 1; font-size: 1.05rem; color: #e3e8f7; line-height: 1.6; }

        /* General Buttons Enhancements */
        .users-btn-cancel, .users-btn-modify, .users-btn-delete { 
            border: none; border-radius: 14px; padding: 0.9rem 1.75rem; 
            font-size: 1.05rem; font-weight: 700; cursor: pointer; 
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
            display: inline-flex; align-items: center; gap: 0.75rem; 
        }
        .users-btn-cancel { background: rgba(255, 255, 255, 0.08); color: #bfc9d8; }
        .users-btn-cancel:hover { background: rgba(255, 255, 255, 0.15); color: #fff; transform: translateY(-2px); }
        .users-btn-modify { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); color: #fff; box-shadow: 0 10px 25px rgba(0, 114, 255, 0.3); }
        .users-btn-modify:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0, 114, 255, 0.45); }
        .users-btn-delete { background: linear-gradient(135deg, #ff3b30 0%, #ff2d92 100%); color: #fff; box-shadow: 0 10px 25px rgba(255, 45, 146, 0.25); }
        .users-btn-delete:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(255, 45, 146, 0.4); }

        [data-theme="light"] .custom-glass-dropdown-trigger { background: #f0f4f8; border-color: #dce2e8; color: #1c202a; }
        [data-theme="light"] .custom-glass-dropdown-menu { background: #fff; border-color: #dce2e8; }
        [data-theme="light"] .custom-file-trigger { background: #f0f4f8; border-color: #dce2e8; }

		/* Blocs Checkbox Styling */
		.blocs-checkbox-container {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			padding: 0.5rem 0;
		}
		.blocs-checkboxes {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			width: 100%;
		}
		.blocs-checkboxes > div {
			flex: 0 0 auto;
		}
		.blocs-checkboxes input[type="checkbox"] {
			/* Hide the actual input but keep it in flow/accessible if needed, 
			   or just display:none since we rely on the label's 'for' attribute */
			display: none; 
		}
		.blocs-checkboxes label {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.75rem 1.5rem;
			background: rgba(0, 0, 0, 0.3);
			border: 1.5px solid rgba(255, 255, 255, 0.1);
			border-radius: 12px;
			color: rgba(255, 255, 255, 0.7);
			font-weight: 600;
			font-size: 0.95rem;
			cursor: pointer;
			transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			min-width: 80px;
			user-select: none;
		}
		.blocs-checkboxes label:hover {
			background: rgba(0, 198, 255, 0.08);
			border-color: rgba(0, 198, 255, 0.3);
			color: #fff;
			transform: translateY(-2px);
		}
		.blocs-checkboxes input[type="checkbox"]:checked + label {
			background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
			border-color: transparent;
			color: #fff;
			box-shadow: 0 8px 20px rgba(0, 114, 255, 0.35);
			transform: scale(1.05);
		}
		[data-theme="light"] .blocs-checkboxes label {
			background: #f0f4f8;
			border-color: #dce2e8;
			color: #4a5568;
		}
		[data-theme="light"] .blocs-checkboxes label:hover {
			background: rgba(0, 198, 255, 0.1);
			border-color: #00c6ff;
			color: #0072ff;
		}
		[data-theme="light"] .blocs-checkboxes input[type="checkbox"]:checked + label {
			background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
			color: #fff;
		}

        /* --- SICK UI COOL POPUP SYSTEM --- */
        #cool-popup-wrapper {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 30000;
        }
        .cool-popup-backdrop {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(12px);
        }
        .cool-popup-card {
            position: relative;
            background: linear-gradient(165deg, rgba(32, 38, 52, 0.95) 0%, rgba(20, 24, 32, 0.95) 100%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 28px;
            padding: 2.5rem;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            text-align: center;
            transform: scale(0.9);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        #cool-popup-wrapper.active .cool-popup-card {
            transform: scale(1);
            opacity: 1;
        }
        .cool-popup-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 2.5rem;
        }
        .cool-popup-icon.success { background: rgba(16, 185, 129, 0.15); color: #10b981; }
        .cool-popup-icon.error { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
        .cool-popup-icon.confirm { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
        .cool-popup-title { color: #fff; font-size: 1.75rem; font-weight: 800; margin-bottom: 0.75rem; }
        .cool-popup-message { color: rgba(191, 201, 216, 0.85); font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem; }
        .cool-popup-actions { display: flex; gap: 1rem; justify-content: center; }
        .cool-btn {
            border: none; border-radius: 14px; padding: 0.9rem 1.8rem;
            font-weight: 700; cursor: pointer; transition: all 0.3s ease; font-size: 1rem;
        }
        .cool-btn-primary { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); color: #fff; }
        .cool-btn-secondary { background: rgba(255, 255, 255, 0.1); color: #bfc9d8; }
        .cool-btn-danger { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: #fff; }
        .cool-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2); }
	</style>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Residence Management - Horizon Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Residence Management' } %}

<div class="users-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
    <div class="users-pagination-pills pills-animated">
        <button class="pill-tab active" data-page="1">Residences</button>
        <button class="pill-tab" data-page="2">Appartments</button>
    </div>
</div>
<div id="residence-content" class="residence-content" style="margin-top: 1.5rem;">
    <div class="residence-page-content" data-page="1">
<div class="liquid-glass-table-container">
        <h3 style="margin-bottom:1.5rem;">Properties Directory</h3>
        <div class="residence-table-toolbar">
            <div style="display: flex; align-items: center;">
                <button class="residence-btn-add-db" id="btn-show-add-modal" title="Add Residence"><i class="bx bx-plus-circle"></i> New Residence</button>
            </div>
            <div style="display: flex; gap: 0.75rem; align-items: center;">
                <button class="residence-sort-dir-pill" id="residence-sort-dir-pill" title="Toggle Sort Direction">
                    <span id="residence-sort-dir-icon-svg"></span>
                </button>
