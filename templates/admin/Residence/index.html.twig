{% block javascripts %}
{{ parent() }}
<script>
    /* --- SICK UI COOL POPUP UTILITY --- */
    function showCoolPopup(title, message, type = 'success', onConfirm = null) {
        const wrapper = document.getElementById('cool-popup-wrapper');
        const icon = document.getElementById('cool-popup-icon');
        const titleEl = document.getElementById('cool-popup-title');
        const messageEl = document.getElementById('cool-popup-message');
        const actions = document.getElementById('cool-popup-actions');

        titleEl.textContent = title;
        messageEl.textContent = message;
        icon.className = `cool-popup-icon ${type}`;
        
        let iconHtml = '';
        if (type === 'success') iconHtml = '<i class="bx bxs-check-circle"></i>';
        else if (type === 'error') iconHtml = '<i class="bx bxs-x-circle"></i>';
        else if (type === 'confirm') iconHtml = '<i class="bx bxs-help-circle"></i>';
        icon.innerHTML = iconHtml;

        actions.innerHTML = '';
        if (type === 'confirm') {
            const cancelBtn = document.createElement('button');
            cancelBtn.className = 'cool-btn cool-btn-secondary';
            cancelBtn.textContent = 'Cancel';
            cancelBtn.onclick = () => {
                wrapper.classList.remove('active');
                setTimeout(() => wrapper.style.display = 'none', 400);
            };
            
            const confirmBtn = document.createElement('button');
            confirmBtn.className = 'cool-btn cool-btn-danger';
            confirmBtn.textContent = 'Proceed';
            confirmBtn.onclick = () => {
                wrapper.classList.remove('active');
                setTimeout(() => wrapper.style.display = 'none', 400);
                if (onConfirm) onConfirm();
            };
            
            actions.appendChild(cancelBtn);
            actions.appendChild(confirmBtn);
        } else {
            const okBtn = document.createElement('button');
            okBtn.className = 'cool-btn cool-btn-primary';
            okBtn.textContent = 'Got it';
            okBtn.onclick = () => {
                wrapper.classList.remove('active');
                setTimeout(() => wrapper.style.display = 'none', 400);
            };
            actions.appendChild(okBtn);
        }

        wrapper.style.display = 'flex';
        setTimeout(() => wrapper.classList.add('active'), 10);
    }

    window.residenceData = [
        {% for r in residences %}
        {
            id: "{{ r.idResidence }}",
            name: "{{ r.nomR|e('js') }}",
            address: "{{ r.adresse|e('js') }}",
            date: "{{ r.dateAjout|date('Y-m-d H:i') }}",
            apartments: "{{ r.nAppartements|e('js') }}",
            floors: "{{ r.nEtages|e('js') }}",
            blocs: "{{ r.nBlocs|e('js') }}",
            image: "{{ r.imageR ? asset('uploads/images/' ~ r.imageR) : asset('frontend/images/property-placeholder.jpg') }}",
            deleteToken: "{{ csrf_token('residence_delete') }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];
    const residenceData = window.residenceData;

    const rowsPerPage = 10;
    let currentPage = 1;
    let sortValue = 'name';
    let sortDirection = 'asc';
    let filteredData = [...window.residenceData];

    function closeModal(id) {
        const modal = document.getElementById(id);
        if(modal) modal.style.display = 'none';
        document.querySelectorAll('.custom-glass-dropdown.open').forEach(d => {
            d.classList.remove('open');
            d.querySelector('.custom-glass-dropdown-menu').style.display = 'none';
        });
    }

    function openModal(id) {
        const modal = document.getElementById(id);
        if(modal) modal.style.display = 'flex';
    }

    function renderTable() {
        const tbody = document.getElementById('residence-table-body');
        tbody.innerHTML = '';

        if (filteredData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="padding: 5rem; opacity: 0.5; font-size: 1.2rem; font-weight: 500;">No properties matches your search criteria.</td></tr>';
            return;
        }

        const start = (currentPage - 1) * rowsPerPage;
        const end = Math.min(start + rowsPerPage, filteredData.length);

        for (let i = start; i < end; i++) {
            const r = filteredData[i];
            const tr = document.createElement('tr');
            // Calculate total units: apartments per floor × number of floors × number of blocs
            const aptsPerFloor = parseInt(r.apartments);
            const floors = parseInt(r.floors);
            // Count blocs by splitting comma-separated string
            const blocsCount = r.blocs ? r.blocs.split(',').length : 1;
            const totalUnits = aptsPerFloor * floors * blocsCount;
            
            tr.innerHTML = `
                <td style="font-weight: 800; color: #fff; font-size: 1.05rem;">${r.name}</td>
                <td style="opacity: 0.9;">${r.address}</td>
                <td><span style="opacity: 0.7; font-size: 0.9rem;">${r.date}</span></td>
                <td><span class="badge" style="background:rgba(0,198,255,0.15); color:#00c6ff; padding:0.5rem 1rem; border-radius:12px; border: 1px solid rgba(0,198,255,0.2); font-weight: 700;">${totalUnits} Units</span></td>
                <td><span style="font-weight: 600;">L${r.floors}</span></td>
                <td><span style="font-weight: 900; color: #ff2d92; text-shadow: 0 0 12px rgba(255, 45, 146, 0.35); font-size: 1.1rem;">${r.blocs}</span></td>
                <td>
                    <button class="users-btn-modify" onclick="viewDetails('${r.id}')" style="padding: 0.5rem 1.25rem; font-size: 0.95rem; border-radius: 12px;">
                        <i class="bx bxs-file-find"></i> Results
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        }
        renderPagination();
    }

    function renderPagination() {
        const totalPages = Math.ceil(filteredData.length / rowsPerPage);
        const pagesDiv = document.getElementById('residence-table-pages');
        pagesDiv.innerHTML = '';

        for (let i = 1; i <= totalPages; i++) {
            const btn = document.createElement('button');
            btn.className = `residence-table-page-btn ${i === currentPage ? 'active' : ''}`;
            btn.textContent = i;
            btn.onclick = () => { currentPage = i; renderTable(); };
            pagesDiv.appendChild(btn);
        }

        document.getElementById('residence-table-prev').disabled = currentPage === 1;
        document.getElementById('residence-table-next').disabled = currentPage === totalPages || totalPages === 0;
    }

    function viewDetails(id) {
        const r = residenceData.find(item => item.id == id);
        if (!r) return;

        document.getElementById('view-residence-image').src = r.image;
        document.getElementById('view-residence-name').textContent = r.name;
        document.getElementById('view-residence-address').textContent = r.address;
        document.getElementById('view-residence-date').textContent = r.date;
        // Calculate and display total units breakdown
        const aptsPerFloor = parseInt(r.apartments);
        const floors = parseInt(r.floors);
        const blocsCount = r.blocs ? r.blocs.split(',').length : 1;
        const totalUnits = aptsPerFloor * floors * blocsCount;
        
        document.getElementById('view-residence-capacity').textContent = `${aptsPerFloor} apts/floor × ${floors} levels × ${blocsCount} blocs = ${totalUnits} Total Units | Blocs: ${r.blocs}`;
        
        document.getElementById('btn-trigger-edit').onclick = () => openEditModal(r);
        
        const deleteForm = document.getElementById('view-residence-delete-form');
        document.getElementById('view-residence-delete-token').value = r.deleteToken;
        
        // Remove existing listeners to avoid duplicates
        const newDeleteForm = deleteForm.cloneNode(true);
        deleteForm.parentNode.replaceChild(newDeleteForm, deleteForm);
        
        newDeleteForm.onsubmit = (e) => {
            e.preventDefault();
            openModal('custom-confirm-modal');
            
            const confirmBtn = document.getElementById('confirm-delete-btn');
            // Remove old listeners
            const newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
            
        newConfirmBtn.onclick = () => {
                // Show loading state on button
                const originalText = newConfirmBtn.innerHTML;
                newConfirmBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Processing...';
                newConfirmBtn.disabled = true;
                
                const formData = new FormData(newDeleteForm);
                fetch(`/admin/residence/${r.id}/delete`, {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Remove from local data and re-render
                        window.residenceData = window.residenceData.filter(item => item.id != r.id);
                        filteredData = [...window.residenceData];
                        renderTable();
                        closeModal('residence-view-modal');
                        closeModal('custom-confirm-modal');
                        showCoolPopup('Success', data.message, 'success');
                    } else {
                        showCoolPopup('Error', data.message, 'error');
                        newConfirmBtn.innerHTML = originalText;
                        newConfirmBtn.disabled = false;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showCoolPopup('Error', 'An unexpected error occurred.', 'error');
                    newConfirmBtn.innerHTML = originalText;
                    newConfirmBtn.disabled = false;
                });
            };
        };

        openModal('residence-view-modal');
    }

    function openEditModal(r) {
        closeModal('residence-view-modal');
        document.getElementById('edit-residence-nom').value = r.name;
        document.getElementById('edit-residence-adresse').value = r.address;
        
        // Reset file trigger text
        document.querySelector('#residence-edit-modal .custom-file-text').textContent = "Current image maintained...";
        
        // Update hidden selects and custom dropdowns
        updateCustomDropdown('edit-residence-n-app', r.apartments);
        updateCustomDropdown('edit-residence-n-etages', r.floors);
        
        // Update Blocs Checkboxes
        // Find the container first to be sure
        const blocContainer = document.getElementById('edit-residence-n-blocs');
        if (blocContainer) {
            // Note: With named form 'residence_edit', inputs will have name="residence_edit[nBlocs][]"
            const blocCheckboxes = blocContainer.querySelectorAll('input[type="checkbox"]');
            
            // 1. Uncheck all first
            blocCheckboxes.forEach(cb => cb.checked = false);
            
            // 2. Check based on data
            if (r.blocs) {
                const selectedBlocs = r.blocs.split(',').map(s => s.trim()); // Trim to be safe
                blocCheckboxes.forEach(cb => {
                    // Check matches against value (A, B, etc.)
                   if (selectedBlocs.includes(cb.value)) {
                       cb.checked = true;
                   } 
                });
            }
        }
        
        const form = document.getElementById('residence-edit-form');
        form.onsubmit = function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            fetch(`/admin/residence/${r.id}/edit`, {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Update local data
                    const idx = window.residenceData.findIndex(item => item.id == r.id);
                    if (idx !== -1) {
                        // We need to fetch the updated data or just update known fields
                        // For now, let's update title/address which we know changed
                        window.residenceData[idx].name = formData.get('residence_edit[nomR]');
                        window.residenceData[idx].address = formData.get('residence_edit[adresse]');
                        window.residenceData[idx].apartments = formData.get('residence_edit[nAppartements]');
                        window.residenceData[idx].floors = formData.get('residence_edit[nEtages]');
                        
                        // Blocs are tricky since it's a multi-select, let's just reload for now or manually handle
                        const blocsArray = [];
                        this.querySelectorAll('input[name="residence_edit[nBlocs][]"]:checked').forEach(cb => blocsArray.push(cb.value));
                        window.residenceData[idx].blocs = blocsArray.join(',');
                        
                        filteredData = [...window.residenceData];
                        renderTable();
                    }
                    closeModal('residence-edit-modal');
                    showCoolPopup('Success', 'Residence updated successfully.', 'success');
                } else {
                    showCoolPopup('Error', data.message, 'error');
                }
            });
        };

        openModal('residence-edit-modal');
    }

    function updateCustomDropdown(targetId, value) {
        const select = document.getElementById(targetId);
        if(select) select.value = value;
        
        const dropdown = document.querySelector(`.custom-glass-dropdown[data-target="${targetId}"]`);
        if(dropdown) {
            dropdown.querySelector('.selected-text').textContent = dropdown.querySelector(`.custom-glass-dropdown-option[data-value="${value}"]`)?.textContent || value;
            dropdown.querySelectorAll('.custom-glass-dropdown-option').forEach(opt => {
                opt.classList.toggle('selected', opt.dataset.value == value);
            });
        }
    }

    function filterAndSort() {
    const search = document.querySelector('.residence-search-input').value.toLowerCase();
    filteredData = residenceData.filter(r => 
        r.name.toLowerCase().includes(search) || 
        r.address.toLowerCase().includes(search)
    );

    filteredData.sort((a, b) => {
        let valA, valB;
        
        // Handle different sort values with proper numeric comparison
        if (sortValue === 'date') {
            // Date comparison (string comparison should work if format is YYYY-MM-DD HH:MM)
            valA = a[sortValue];
            valB = b[sortValue];
        } 
        else if (sortValue === 'apartments' || sortValue === 'floors') {
            // NUMERIC COMPARISON - parse to integers
            valA = parseInt(a[sortValue]) || 0;
            valB = parseInt(b[sortValue]) || 0;
            
            // Direct numeric comparison (don't convert back to string)
            if (sortDirection === 'asc') {
                return valA - valB;
            } else {
                return valB - valA;
            }
        }
        else {
            // String values (name, address)
            valA = String(a[sortValue] || '').toLowerCase();
            valB = String(b[sortValue] || '').toLowerCase();
            
            if (sortDirection === 'asc') {
                return valA > valB ? 1 : -1;
            } else {
                return valA < valB ? 1 : -1;
            }
        }

        // For date values
        if (sortDirection === 'asc') {
            return valA > valB ? 1 : -1;
        } else {
            return valA < valB ? 1 : -1;
        }
    });

    currentPage = 1;
    renderTable();
}

    // Initialize Custom Dropdowns
    function initCustomDropdowns() {
        document.querySelectorAll('.custom-glass-dropdown').forEach(dropdown => {
            const trigger = dropdown.querySelector('.custom-glass-dropdown-trigger');
            const menu = dropdown.querySelector('.custom-glass-dropdown-menu');
            const options = dropdown.querySelectorAll('.custom-glass-dropdown-option');
            const targetId = dropdown.dataset.target;
            const hiddenSelect = document.getElementById(targetId);

            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                const isOpen = dropdown.classList.contains('open');
                
                // Close others
                document.querySelectorAll('.custom-glass-dropdown.open').forEach(d => {
                    if(d !== dropdown) {
                        d.classList.remove('open');
                        d.querySelector('.custom-glass-dropdown-menu').style.display = 'none';
                    }
                });

                dropdown.classList.toggle('open');
                menu.style.display = isOpen ? 'none' : 'flex';
            });

            options.forEach(opt => {
                opt.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const val = opt.dataset.value;
                    const text = opt.textContent;
                    
                    // Update trigger text
                    dropdown.querySelector('.selected-text').textContent = text;
                    
                    // Update hidden select
                    if(hiddenSelect) {
                        hiddenSelect.value = val;
                        hiddenSelect.dispatchEvent(new Event('change'));
                    }

                    // Handle selection UI
                    options.forEach(o => o.classList.remove('selected'));
                    opt.classList.add('selected');

                    // Close menu
                    dropdown.classList.remove('open');
                    menu.style.display = 'none';
                });
            });
        });

        // Global click handler to close dropdowns
        document.addEventListener('click', () => {
            document.querySelectorAll('.custom-glass-dropdown.open').forEach(d => {
                d.classList.remove('open');
                d.querySelector('.custom-glass-dropdown-menu').style.display = 'none';
            });
        });
    }

    function initFileInputs() {
        document.querySelectorAll('.hidden-select[type="file"]').forEach(input => {
            input.addEventListener('change', function() {
                const wrapper = this.closest('.residence-form-group');
                const textElem = wrapper.querySelector('.custom-file-text');
                if (this.files && this.files.length > 0) {
                    textElem.textContent = this.files[0].name;
                    textElem.style.color = "#00c6ff";
                    textElem.style.fontWeight = "700";
                } else {
                    textElem.textContent = "Click to upload property image...";
                    textElem.style.color = "";
                    textElem.style.fontWeight = "";
                }
            });
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Pill Tab Navigation Logic
        const pillTabs = document.querySelectorAll('.pill-tab');
        const pageContents = document.querySelectorAll('.residence-page-content');

        function switchPage(pageNumber) {
            // Update tabs
            pillTabs.forEach(tab => {
                tab.classList.toggle('active', tab.dataset.page === String(pageNumber));
            });

            // Update page content
            pageContents.forEach(content => {
                content.style.display = content.dataset.page === String(pageNumber) ? 'block' : 'none';
            });
        }

        pillTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const pageNum = parseInt(tab.dataset.page);
                switchPage(pageNum);
            });
        });

        // Initialize other features
        renderTable();
        initCustomDropdowns();
        initFileInputs();

        document.getElementById('btn-show-add-modal').onclick = () => openModal('residence-add-modal');
        
        const addForm = document.getElementById('residence-add-form');
        if (addForm) {
            addForm.onsubmit = function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                fetch(this.action, {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        // Add to local data
                        window.residenceData.push(data.residence);
                        filteredData = [...window.residenceData];
                        renderTable();
                        closeModal('residence-add-modal');
                        this.reset();
                        // Reset image text
                        const imgText = this.querySelector('.custom-file-text');
                        if(imgText) imgText.textContent = "Click to upload property image...";
                        
                        showCoolPopup('Success', 'Residence registered successfully.', 'success');
                    } else {
                        showCoolPopup('Error', data.message, 'error');
                    }
                })
                .catch(err => {
                    console.error(err);
                    showCoolPopup('Error', 'An unexpected error occurred.', 'error');
                });
            };
        }

        document.querySelector('.residence-search-input').oninput = filterAndSort;

        document.getElementById('residence-sort-pill-custom').onclick = function(e) {
            e.stopPropagation();
            const drop = document.getElementById('residence-sort-dropdown');
            drop.style.display = drop.style.display === 'none' ? 'flex' : 'none';
            // Also close any custom select dropdowns
            document.querySelectorAll('.custom-glass-dropdown.open').forEach(d => {
                d.classList.remove('open');
                d.querySelector('.custom-glass-dropdown-menu').style.display = 'none';
            });
        };

        document.querySelectorAll('.residence-sort-option').forEach(opt => {
            opt.onclick = function() {
                sortValue = this.dataset.value;
                document.getElementById('residence-sort-selected').textContent = this.textContent;
                document.getElementById('residence-sort-dropdown').style.display = 'none';
                filterAndSort();
            };
        });

        const sortDirBtn = document.getElementById('residence-sort-dir-pill');
        const sortIcon = document.getElementById('residence-sort-dir-icon-svg');
        const updateIcon = () => {
            sortIcon.innerHTML = sortDirection === 'asc' 
                ? '<i class="bx bx-sort-a-z" style="color:#00c6ff; font-size:1.7rem;"></i>'
                : '<i class="bx bx-sort-z-a" style="color:#00c6ff; font-size:1.7rem;"></i>';
        };
        updateIcon();
        sortDirBtn.onclick = () => {
            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            updateIcon();
            filterAndSort();
        };

        document.getElementById('residence-table-prev').onclick = () => { if (currentPage > 1) { currentPage--; renderTable(); } };
        document.getElementById('residence-table-next').onclick = () => { 
            if (currentPage < Math.ceil(filteredData.length / rowsPerPage)) { currentPage++; renderTable(); } 
        };

        document.addEventListener('click', (e) => {
            if (!document.getElementById('residence-sort-pill-custom').contains(e.target)) {
                document.getElementById('residence-sort-dropdown').style.display = 'none';
            }
        });
    });
</script>
<script>

    document.addEventListener('DOMContentLoaded', () => {
    // --- Appartement Logic ---
const appartementData = [
    {% for a in appartements %}
    {
        id: {{ a.idApp }},
        type: "{{ a.typeA|e('js') }}",
        surface: "{{ a.superficie ? a.superficie|e('js') : '-' }}",
        prixLocation: "{{ a.prixLocation ? a.prixLocation|e('js') : '-' }}", 
        residence: "{{ a.residence ? a.residence.nomR|e('js') : 'N/A' }}",
        resId: "{{ a.residence ? a.residence.idResidence : '' }}",
        owner: "{{ a.user ? a.user.emailUser|e('js') : 'N/A' }}",
        ownerId: "{{ a.user ? a.user.idUser : '' }}",
        parking: "{{ attribute(a.appartementInfo, 'parking')|default(a.parking) ? 'Yes' : 'No' }}",
        isParking: {{ attribute(a.appartementInfo, 'parking')|default(a.parking) ? 'true' : 'false' }},
        status: "{{ attribute(a.appartementInfo, 'disponible')|default(a.disponible) ? 'Available' : 'Occupied' }}",
        isAvailable: {{ attribute(a.appartementInfo, 'disponible')|default(a.disponible) ? 'true' : 'false' }},
        bloc: "{{ attribute(a.appartementInfo, 'bloc')|default('')|e('js') }}",
        floor: "{{ attribute(a.appartementInfo, 'floor')|default('')|e('js') }}",
        number: "{{ attribute(a.appartementInfo, 'number')|default('')|e('js') }}",
        image: "{{ a.imageA ? asset('appartement_images/' ~ a.imageA) : asset('frontend/images/property-placeholder.jpg') }}",
        deleteToken: "{{ csrf_token('appartement_delete') }}",
        predicted_price: "{{ predictions[a.idApp] }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
];
// Globalize for accessibility
window.appartementData = appartementData;

 const predictions = window.appartementData.map(apt => ({
        id: apt.id,
        actual: apt.prixLocation,
        predicted: apt.predicted_price,
        type: apt.type,
        surface: apt.surface
    }));
    
    console.log('All predictions:', predictions);
    const appRowsPerPage = 10;
    let appCurrentPage = 1;
    let appSortValue = 'type';
    let appSortDirection = 'asc';
    let appFilteredData = [...appartementData];

    // Dynamic Dropdown Logic for Apartment Form
    function updateAppFormData(residenceId, formScope) {
        // Find residence
        const r = window.residenceData ? window.residenceData.find(item => item.id == residenceId) : null;
        if(!r) return;

        // Helper to update select options
        const updateField = (selector, options) => {
             const select = document.querySelector(`${formScope} ${selector}`);
             if(!select) return;
             
             // Clear existing options (keep default)
             select.innerHTML = '';
             
             // Styling (Ensure it stays styled)
             select.style.appearance = 'none';
             select.style.backgroundImage = "url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e\")";
             select.style.backgroundRepeat = "no-repeat";
             select.style.backgroundPosition = "right 1rem center";
             select.style.backgroundSize = "1em";
             select.style.backgroundColor = "rgba(255, 255, 255, 0.03)";
             select.style.border = "1px solid rgba(255, 255, 255, 0.1)";
             select.style.color = "#fff";
             select.style.borderRadius = "12px";
             select.style.padding = "0.75rem 1rem";
             select.style.width = "100%";
             select.style.marginBottom = "0.5rem";
             select.style.cursor = 'pointer';

             // Add default option
             const def = document.createElement('option');
             def.text = 'Select...';
             def.value = '';
             // def.style.color = "#000"; // Avoid potential styling issues
             select.add(def);

             options.forEach(opt => {
                 const o = document.createElement('option');
                 o.text = opt;
                 o.value = opt;
                 o.style.color = "#000";
                 select.add(o);
             });
        };

        const blocs = r.blocs ? r.blocs.split(',').map(s => s.trim()) : [];
        updateField('.bloc-input', blocs);

        const floors = [];
        const floorCount = parseInt(r.floors) || 0;
        for(let i=0; i<= floorCount; i++) floors.push(i);
        updateField('.floor-input', floors);

        const nums = [];
        const aptCount = parseInt(r.apartments) || 0;
        for(let i=1; i<= aptCount; i++) nums.push(i);
        updateField('.number-input', nums);
    }

    // Attach listeners
    // Attach listeners
     const attach = (name, scope) => {
         const el = document.querySelector(`select[name="${name}"]`);
         if(el) {
             console.log('Attaching listener to:', name);
             el.addEventListener('change', function() {
                 console.log('Change detected on:', name, 'Value:', this.value);
                 updateAppFormData(this.value, scope);
             });
             if(el.value) {
                 console.log('Initial value found for:', name, 'Value:', el.value);
                 updateAppFormData(el.value, scope);
             }
         } else {
             console.warn('Could not find select with name:', name);
         }
     };
     
     attach('appartement_add[residence]', '#app-add-form');
     attach('appartement_edit[residence]', '#app-edit-form');

    function renderAppartementTable() {
        const tbody = document.getElementById('app-table-body');
        if(!tbody) return;
        tbody.innerHTML = '';

        const start = (appCurrentPage - 1) * appRowsPerPage;
        const end = start + appRowsPerPage;
        const pageData = appFilteredData.slice(start, end);

        if (pageData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding: 2rem;">No apartments found</td></tr>`;
        } else {
            pageData.forEach(a => {
                const tr = document.createElement('tr');
                tr.onclick = (e) => {
                    if(!e.target.closest('.residence-action-btn')) {
                         openViewAppModal(a.id);
                    }
                };
                tr.style.cursor = 'pointer';

                tr.innerHTML = `
                    <td>
                        <div class="residence-info">
                            <img src="${a.image}" alt="Unit" class="residence-img" style="width: 45px; height: 45px; object-fit: cover; border-radius: 10px;">
                            <div>
                                <div class="residence-name">Unit #${a.id}</div>
                                <div class="residence-address">${a.type}</div>
                            </div>
                        </div>
                    </td>
                    <td>${a.residence}</td>
                    <td>
                        <span class="badge ${a.status === 'Available' ? 'badge-green' : 'badge-red'}">
                            ${a.status}
                        </span>
                    </td>
                    <td><span class="badge badge-blue">${a.type}</span></td>
                    
                                        <td>${a.parking}</td>

                    <td>${a.surface}</td>
                    <td>${a.prixLocation}</td>
                    <td>
                        <div class="residence-actions">
                            <button class="users-btn-modify view-app-btn" data-id="${a.id}" style="padding: 0.5rem 1.25rem; font-size: 0.95rem; border-radius: 12px;">
                                <i class="bx bxs-file-find"></i> Results
                            </button>
                        </div>
                    </td>
                `;

                // Attach button listener
                const btn = tr.querySelector('.view-app-btn');
                if(btn) {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        openViewAppModal(a.id);
                    });
                }

                tbody.appendChild(tr);
            });
        }
        renderAppPagination();
    }

    function renderAppPagination() {
        const totalPages = Math.ceil(appFilteredData.length / appRowsPerPage);
        const pagesContainer = document.getElementById('app-table-pages');
        if(!pagesContainer) return;
        
        pagesContainer.innerHTML = '';
        
        if(totalPages <= 1) return;

        for (let i = 1; i <= totalPages; i++) {
            const btn = document.createElement('button');
            btn.className = `residence-table-page-btn ${i === appCurrentPage ? 'active' : ''}`;
            btn.textContent = i;
            btn.onclick = () => {
                appCurrentPage = i;
                renderAppartementTable();
            };
            pagesContainer.appendChild(btn);
        }
    }

function filterAndSortApps() {
    const searchInput = document.getElementById('app-search-input');
    if(!searchInput) return;
    const search = searchInput.value.toLowerCase();
    
    appFilteredData = window.appartementData.filter(a => 
        a.type.toLowerCase().includes(search) || 
        a.residence.toLowerCase().includes(search) ||
        a.owner.toLowerCase().includes(search) ||
        String(a.surface).includes(search) ||
        String(a.prixLocation).includes(search)
    );

    appFilteredData.sort((a, b) => {
        if (appSortValue === 'surface') {
            // NUMERIC COMPARISON for surface
            const valA = parseFloat(a.surface) || 0;
            const valB = parseFloat(b.surface) || 0;
            return appSortDirection === 'asc' ? valA - valB : valB - valA;
        }
        else if (appSortValue === 'price') {
            // NUMERIC COMPARISON for price
            const valA = parseFloat(a.prixLocation) || 0;
            const valB = parseFloat(b.prixLocation) || 0;
            return appSortDirection === 'asc' ? valA - valB : valB - valA;
        }
        else {
            // String comparison for other fields
            let valA = String(a[appSortValue] || '').toLowerCase();
            let valB = String(b[appSortValue] || '').toLowerCase();
            
            if (appSortDirection === 'asc') {
                return valA > valB ? 1 : -1;
            } else {
                return valA < valB ? 1 : -1;
            }
        }
    });

    appCurrentPage = 1;
    renderAppartementTable();
}   
    
    const appSortPill = document.getElementById('app-sort-pill-custom');
    if(appSortPill) {
        appSortPill.onclick = function(e) {
            e.stopPropagation();
            const drop = document.getElementById('app-sort-dropdown');
            drop.style.display = drop.style.display === 'none' ? 'flex' : 'none';
        };
    }

    document.querySelectorAll('#app-sort-dropdown .residence-sort-option').forEach(opt => {
        opt.onclick = function() {
            appSortValue = this.dataset.value;
            document.getElementById('app-sort-selected').textContent = this.textContent;
            document.getElementById('app-sort-dropdown').style.display = 'none';
            filterAndSortApps();
        };
    });

    const appSortDirBtn = document.getElementById('app-sort-dir-pill');
    const appSortIcon = document.getElementById('app-sort-dir-icon-svg');
    const updateAppIcon = () => {
        if(!appSortIcon) return;
        appSortIcon.innerHTML = appSortDirection === 'asc' 
            ? '<i class="bx bx-sort-a-z" style="color:#00c6ff; font-size:1.7rem;"></i>'
            : '<i class="bx bx-sort-z-a" style="color:#00c6ff; font-size:1.7rem;"></i>';
    };
    
    if(appSortDirBtn) {
        updateAppIcon(); // Init
        appSortDirBtn.onclick = () => {
            appSortDirection = appSortDirection === 'asc' ? 'desc' : 'asc';
            updateAppIcon();
            filterAndSortApps();
        };
    }

    if(document.getElementById('app-search-input')) {
        document.getElementById('app-search-input').oninput = filterAndSortApps;
    }

     window.openViewAppModal = (id) => {
        console.log('Opening View Modal for Apartment:', id);
        const a = window.appartementData.find(item => item.id == id);
        if(!a) {
            console.error('Apartment data not found for ID:', id);
            return;
        }

        document.getElementById('view-app-type').textContent = a.type;
        document.getElementById('view-app-residence').textContent = a.residence;
        document.getElementById('view-app-image').src = a.image;
        document.getElementById('view-app-owner').textContent = a.owner;
        document.getElementById('view-app-parking').textContent = a.parking === 'Yes' ? 'Parking Included' : 'No Parking';
        document.getElementById('view-app-status').textContent = a.status;
        document.getElementById('view-app-surface').textContent = a.surface;
        document.getElementById('view-app-prix-prediction').textContent = a.predicted_price;
        document.getElementById('view-app-prix-location').textContent = a.prixLocation;
        
        const deleteForm = document.getElementById('view-app-delete-form');
        if(deleteForm) {
            deleteForm.action = `/admin/appartement/${a.id}`;
            document.getElementById('view-app-delete-token').value = a.deleteToken;
            
            // Re-bind AJAX delete logic
            deleteForm.onsubmit = (e) => {
                e.preventDefault();
                showCoolPopup('Confirm Delete', 'Are you sure you want to remove this apartment unit?', 'confirm', () => {
                    const formData = new FormData(deleteForm);
                    fetch(deleteForm.action, {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if(data.success) {
                            window.appartementData = window.appartementData.filter(item => item.id != a.id);
                            appFilteredData = [...window.appartementData];
                            renderAppartementTable();
                            closeModal('app-view-modal');
                            showCoolPopup('Success', 'Apartment deleted successfully.', 'success');
                        } else {
                            showCoolPopup('Error', data.message, 'error');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showCoolPopup('Error', 'An unexpected error occurred.', 'error');
                    });
                });
            };
        }
        
        const editBtn = document.getElementById('btn-trigger-app-edit');
        if(editBtn) editBtn.onclick = () => window.openEditAppModal(a.id);

        openModal('app-view-modal');
     };

     window.openEditAppModal = (id) => {
    console.log('Opening Edit Modal for Apartment:', id);
    closeModal('app-view-modal'); 
    const a = window.appartementData.find(item => item.id == id);
    if(!a) {
        console.error('Apartment data not found for ID:', id);
        return;
    }
    
    const form = document.getElementById('app-edit-form');
    if(form) {
        form.action = `/admin/appartement/${id}/edit`;
        console.log('Form Action Set to:', form.action);
        
        const resSelect = form.querySelector('select[name="appartement_edit[residence]"]');
        if(resSelect) {
            resSelect.value = a.resId;
            console.log('Residence Set to:', a.resId);
            
            updateAppFormData(a.resId, '#app-edit-form');
            
            let attempts = 0;
            const maxAttempts = 10;
            
            const setDynamicFields = () => {
                const blocEl = form.querySelector('.bloc-input');
                const floorEl = form.querySelector('.floor-input');
                const numEl = form.querySelector('.number-input');
                
                if (blocEl && floorEl && numEl) {
                    if (blocEl.options.length > 1 && floorEl.options.length > 1 && numEl.options.length > 1) {
                        if (a.bloc) {
                            blocEl.value = a.bloc;
                            console.log('Bloc Set to:', a.bloc, 'Available options:', [...blocEl.options].map(o => o.value));
                        }
                        if (a.floor !== undefined && a.floor !== '') {
                            floorEl.value = a.floor;
                            console.log('Floor Set to:', a.floor);
                        }
                        if (a.number) {
                            numEl.value = a.number;
                            console.log('Number Set to:', a.number);
                        }
                        return true;
                    }
                }
                return false;
            };
            
            if (!setDynamicFields()) {
                const interval = setInterval(() => {
                    attempts++;
                    if (setDynamicFields() || attempts >= maxAttempts) {
                        clearInterval(interval);
                        if (attempts >= maxAttempts) {
                            console.warn('Failed to set dynamic fields after', maxAttempts, 'attempts');
                        }
                    }
                }, 100);
            }
        }

        const typeSelect = form.querySelector('select[name="appartement_edit[typeA]"]');
        if(typeSelect) {
            let found = false;
            for (let i = 0; i < typeSelect.options.length; i++) {
                if (typeSelect.options[i].value === a.type) {
                    typeSelect.selectedIndex = i;
                    found = true;
                    break;
                }
            }
            if (!found && a.type) {
                // Add the option if it doesn't exist
                const option = document.createElement('option');
                option.value = a.type;
                option.text = a.type;
                typeSelect.add(option);
                typeSelect.value = a.type;
            }
            console.log('Type Set to:', a.type);
        }

        const userSelect = form.querySelector('select[name="appartement_edit[user]"]');
        if(userSelect) {
            userSelect.value = a.ownerId;
            console.log('User Set to:', a.ownerId);
        }

        // 3. Set surface and price - THESE WERE MISSING!
        const surfaceInput = form.querySelector('input[name="appartement_edit[superficie]"]');
        if(surfaceInput) {
            surfaceInput.value = a.surface && a.surface !== '-' ? a.surface : '';
            console.log('Surface Set to:', surfaceInput.value);
        }
        
        const priceInput = form.querySelector('input[name="appartement_edit[prixLocation]"]');
        if(priceInput) {
            priceInput.value = a.prixLocation && a.prixLocation !== '-' ? a.prixLocation : '';
            console.log('Price Set to:', priceInput.value);
        }

        // 4. Set checkboxes
        const parkingCb = form.querySelector('input[name="appartement_edit[parking]"]');
        if(parkingCb) parkingCb.checked = a.isParking;

        const availCb = form.querySelector('input[name="appartement_edit[disponible]"]');
        if(availCb) availCb.checked = a.isAvailable;

        const imgText = form.querySelector('.custom-file-text');
        if(imgText) imgText.textContent = "Maintain existing image...";

        // 5. Update form submission handler
        form.onsubmit = function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            fetch(this.action, {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    // Update local data
                    const idx = window.appartementData.findIndex(item => item.id == a.id);
                    if(idx !== -1) {
                        // Merge the updated data
                        window.appartementData[idx] = {
                            ...window.appartementData[idx],
                            ...data.appartement,
                            // Ensure these fields are properly updated
                            surface: data.appartement.surface || formData.get('appartement_edit[superficie]'),
                            prixLocation: data.appartement.prixLocation || formData.get('appartement_edit[prixLocation]'),
                            bloc: formData.get('appartement_edit[bloc]'),
                            floor: formData.get('appartement_edit[floor]'),
                            number: formData.get('appartement_edit[number]'),
                            type: formData.get('appartement_edit[typeA]'),
                            isParking: formData.get('appartement_edit[parking]') === 'on',
                            parking: formData.get('appartement_edit[parking]') === 'on' ? 'Yes' : 'No',
                            isAvailable: formData.get('appartement_edit[disponible]') === 'on',
                            status: formData.get('appartement_edit[disponible]') === 'on' ? 'Available' : 'Occupied'
                        };
                        appFilteredData = [...window.appartementData];
                        renderAppartementTable();
                    }
                    closeModal('app-edit-modal');
                    showCoolPopup('Success', 'Apartment updated successfully.', 'success');
                } else {
                    showCoolPopup('Error', data.message, 'error');
                }
            })
            .catch(err => {
                console.error(err);
                showCoolPopup('Error', 'An unexpected error occurred.', 'error');
            });
        };

        openModal('app-edit-modal');
    }
};

    document.getElementById('btn-show-add-app-modal').onclick = () => openModal('app-add-modal');

    const appAddForm = document.getElementById('app-add-form');
    if(appAddForm) {
        appAddForm.onsubmit = function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            fetch(this.action, {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    window.appartementData.push(data.appartement);
                    appFilteredData = [...window.appartementData];
                    renderAppartementTable();
                    closeModal('app-add-modal');
                    this.reset();
                    // Reset image text
                    const imgText = this.querySelector('.custom-file-text');
                    if(imgText) imgText.textContent = "Click to upload unit image...";
                    showCoolPopup('Success', 'Apartment registered successfully.', 'success');
                } else {
                    showCoolPopup('Error', data.message, 'error');
                }
            })
            .catch(err => {
                console.error(err);
                showCoolPopup('Error', 'An unexpected error occurred.', 'error');
            });
        };
    }

    renderAppartementTable();
    
    const prevBtn = document.getElementById('app-table-prev');
    if(prevBtn) prevBtn.onclick = () => { if (appCurrentPage > 1) { appCurrentPage--; renderAppartementTable(); } };
     const nextBtn = document.getElementById('app-table-next');
    if(nextBtn) nextBtn.onclick = () => { 
        if (appCurrentPage < Math.ceil(appFilteredData.length / appRowsPerPage)) { appCurrentPage++; renderAppartementTable(); } 
    };
    });

document.addEventListener('DOMContentLoaded', function() {
    const superficieInput = document.querySelector('#{{ appartementAddForm.superficie.vars.id }}');
    const typeSelect = document.querySelector('#{{ appartementAddForm.typeA.vars.id }}');
    const parkingCheckbox = document.querySelector('#{{ appartementAddForm.parking.vars.id }}');
    const predictedDisplay = document.getElementById('predicted_price_display');
    const prixLocationField = document.querySelector('#{{ appartementAddForm.prixLocation.vars.id }}');
    
    if (!superficieInput || !typeSelect || !parkingCheckbox || !predictedDisplay) {
        return;
    }
    
    function fetchPrediction() {
        const superficie = superficieInput.value;
        const typeA = typeSelect.value;
        const parking = parkingCheckbox.checked;
        
        if (!superficie || superficie.trim() === '') {
            predictedDisplay.value = 'Entrez une superficie';
            predictedDisplay.style.color = '#6c757d';
            return;
        }
        
        const superficieFloat = parseFloat(superficie);
        if (isNaN(superficieFloat) || superficieFloat <= 0) {
            predictedDisplay.value = superficieFloat <= 0 ? 'Superficie doit être > 0' : 'Superficie invalide';
            predictedDisplay.style.color = '#6c757d';
            return;
        }
        
        predictedDisplay.value = 'Calcul en cours...';
        predictedDisplay.style.color = '#007bff';
        
        const url = '{{ path('prediction_prix') }}';
        
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                superficie: superficieFloat,
                type: typeA,
                parking: parking
            })
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (data.error || data.success === false) {
                throw new Error(data.error || 'Prediction failed');
            }
            
            const displayValue = data.formatted_price || 
                (data.predicted_price ? Number(data.predicted_price).toLocaleString('fr-FR') + ' TND' : 'Non disponible');
            
            predictedDisplay.value = displayValue;
            predictedDisplay.style.color = '#28a745';
            
            if (prixLocationField && !prixLocationField.value && data.predicted_price) {
                prixLocationField.value = data.predicted_price;
            }
        })
        .catch(() => {
            predictedDisplay.value = 'Erreur de calcul';
            predictedDisplay.style.color = '#dc3545';
        });
    }
    
    superficieInput.addEventListener('input', fetchPrediction);
    superficieInput.addEventListener('blur', fetchPrediction);
    typeSelect.addEventListener('change', fetchPrediction);
    parkingCheckbox.addEventListener('change', fetchPrediction);
    
    if (superficieInput.value && parseFloat(superficieInput.value) > 0) {
        fetchPrediction();
    }
});
</script>
{% endblock %}


