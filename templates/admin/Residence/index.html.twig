    const residencesData = [{% for r in residences|default([]) %} [ "{{ r.nomR|e('js') }}", "{{ r.adresse|e('js') }}", "{{ r.imageR|e('js') }}", "{{ r.idResidence }}", "{{ r.nAppartements }}", "{{ r.nEtages }}", "{{ r.nBlocs }}", "{{ csrf_token('delete' ~ r.idResidence)|e('js') }}" ]{% if not loop.last %},{% endif %} {% endfor %}];
    const appartementsData = [{% for a in appartements|default([]) %} [ 
        "{{ a.appartementInfo.number|default('—')|e('js') }}", 
        "{{ a.residence ? a.residence.nomR|e('js') : '—' }}", 
        "{{ a.disponible ? 'Available' : 'Occupied' }}", 
        "{{ a.idApp }}", 
        "{{ a.residence ? a.residence.idResidence : '' }}", 
