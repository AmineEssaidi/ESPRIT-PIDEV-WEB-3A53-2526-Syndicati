// Generate maintenance prediction
function generateMaintenancePrediction(appartementId, displayElement) {
    const url = `/appartement/${appartementId}/predict-maintenance`;
    
    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP Error: ${response.status}`);
        }
        return response.text();
    })
    .then(text => {
        console.log('Raw response:', text);
        
        if (!text) {
            throw new Error('Empty response from server');
        }
        
        try {
            return JSON.parse(text);
        } catch (e) {
            console.error('JSON parse error:', e);
            console.error('Response text was:', text);
            throw e;
        }
    })
    .then(data => {
        if (data.success) {
            const resultText = data.prediction || data.recommendationIa || 'Prédiction générée';
            displayElement.textContent = resultText;
            predictionsmaintenance[appartementId] = resultText;
        } else {
            displayElement.textContent = data.message || 'Erreur lors de la génération';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        displayElement.textContent = 'Erreur: ' + error.message;
    });
}

// Initialize apartment dropdowns
function initApartmentDropdowns() {
    const residenceSelect = document.getElementById('app-residence-select');
    
    if (!residenceSelect) {
        console.warn('Residence select not found');
        return false;
    }

    const blocSelect = document.getElementById('app-bloc-select');
    const floorSelect = document.getElementById('app-floor-select');
    const numberSelect = document.getElementById('app-number-select');
    const blocInput = document.getElementById('app-bloc-field');
    const floorInput = document.getElementById('app-floor-field');
    const numberInput = document.getElementById('app-number-field');

    // Sync selects with hidden inputs
    if (blocSelect && blocInput) {
        blocSelect.addEventListener('change', () => {
            blocInput.value = blocSelect.value;
        });
    }
    if (floorSelect && floorInput) {
        floorSelect.addEventListener('change', () => {
            floorInput.value = floorSelect.value;
        });
    }
    if (numberSelect && numberInput) {
        numberSelect.addEventListener('change', () => {
            numberInput.value = numberSelect.value;
        });
    }

    // When residence changes, populate dropdowns
    residenceSelect.addEventListener('change', function() {
        const selectedResId = this.value;
        
        // Reset all dropdowns
        if (blocSelect) {
            blocSelect.innerHTML = '<option value="">Select Bloc</option>';
            if (blocInput) blocInput.value = '';
        }
        if (floorSelect) {
            floorSelect.innerHTML = '<option value="">Select Floor</option>';
            if (floorInput) floorInput.value = '';
        }
        if (numberSelect) {
            numberSelect.innerHTML = '<option value="">Select Apartment</option>';
            if (numberInput) numberInput.value = '';
        }
        
        if (!selectedResId) return;

        // Find residence data
        const resData = residencesData.find(r => r[3] == selectedResId);
        
        if (!resData) {
            console.warn('No data found for residence ID:', selectedResId);
            return;
        }

        // Parse residence data
        const blocsString = resData[6] || '';
        const blocsArray = blocsString ? blocsString.split(',').map(b => b.trim()).filter(b => b) : [];
        const nEtages = parseInt(resData[5]) || 0;
        const nAppartements = parseInt(resData[4]) || 0;

        // Populate Bloc dropdown
        if (blocSelect && blocsArray.length > 0) {
            blocsArray.forEach(bloc => {
                const option = document.createElement('option');
                option.value = bloc;
                option.textContent = `Bloc ${bloc}`;
                blocSelect.appendChild(option);
            });
        }

        // Populate Floor dropdown
        if (floorSelect && nEtages > 0) {
            for (let i = 1; i <= nEtages; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = `Floor ${i}`;
                floorSelect.appendChild(option);
            }
        }

        // Populate Apartment Number dropdown
        if (numberSelect && nAppartements > 0) {
            for (let i = 1; i <= nAppartements; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = `Apartment ${i}`;
                numberSelect.appendChild(option);
            }
        }
    });

    return true;
}

function setupAddFormPrediction() {
    const superficieInput = document.querySelector('#app-add-form input[name*="superficie"]');
    const typeSelect = document.querySelector('#app-add-form select[name*="typeA"]');
    const predictedDisplay = document.getElementById('app-add-predicted-price');
    const prixLocationField = document.querySelector('#app-add-form input[name*="prixLocation"]');
    
    if (!superficieInput || !typeSelect || !predictedDisplay) {
        console.warn('Add form elements not found');
        return;
    }
    
    function updatePrediction() {
        const superficieValue = parseFloat(superficieInput.value);
        const typeValue = typeSelect.value;
        
        if (!superficieValue || superficieValue <= 0 || !typeValue) {
            predictedDisplay.value = 'Ajouter les données';
            return;
        }
        
        predictedDisplay.value = 'Chargement...';
        
        fetch('/residence/admin/prediction', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                superficie: superficieValue,
                type: typeValue
            })
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                predictedDisplay.value = data.formatted_price;
                if (prixLocationField && !prixLocationField.value) {
                    prixLocationField.value = Math.round(data.predicted_price);
                }
            } else {
                predictedDisplay.value = 'Erreur: ' + (data.error || 'Calcul échoué');
            }
        })
        .catch(error => {
            console.error('Prediction error:', error);
            predictedDisplay.value = 'Erreur de connexion';
        });
    }
    
    superficieInput.addEventListener('input', updatePrediction);
    typeSelect.addEventListener('change', updatePrediction);
}

