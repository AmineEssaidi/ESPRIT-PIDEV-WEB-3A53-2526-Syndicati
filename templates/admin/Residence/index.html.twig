<script>
let currentAppartment = null; 

const residencesData = [{% for r in residences|default([]) %} [ "{{ r.nomR|e('js') }}", "{{ r.adresse|e('js') }}", "{{ r.imageR|e('js') }}", "{{ r.idResidence }}", "{{ r.nAppartements }}", "{{ r.nEtages }}", "{{ r.nBlocs }}", "{{ csrf_token('delete' ~ r.idResidence)|e('js') }}" ]{% if not loop.last %},{% endif %} {% endfor %}];
const appartementsData = [{% for a in appartements|default([]) %} [ "{{ a.appartementInfo.number|default('—')|e('js') }}", "{{ a.residence ? a.residence.nomR|e('js') : '—' }}", "{{ a.disponible ? 'Available' : 'Occupied' }}", "{{ a.idApp }}", "{{ a.residence ? a.residence.idResidence : '' }}", "{{ a.user ? a.user.idUser : '' }}", "{{ a.typeA|e('js') }}", "{{ a.parking ? 'true' : 'false' }}", "{{ a.appartementInfo.bloc|default('')|e('js') }}", "{{ a.appartementInfo.floor|default('')|e('js') }}","{{ a.superficie|default('0')|e('js') }}","{{ a.prixLocation|default('0')|e('js') }}", "{{ a.imageA|e('js') }}", "{{ csrf_token('delete' ~ a.idApp)|e('js') }}","{{ predictions[a.idApp] }}", "{{ predictionsmaintenance[a.idApp]|default('')|e('js') }}" ]{% if not loop.last %},{% endif %} {% endfor %}];

const predictionsmaintenance = { {% for a in appartements|default([]) %} "{{ a.idApp }}": "{{ predictionsmaintenance[a.idApp]|default('')|e('js') }}"{% if not loop.last %},{% endif %} {% endfor %} };   

const editResUrlTemplate = "{{ path('admin_residence_edit', {id: 'ID_PLACEHOLDER'}) }}";
const deleteResUrlTemplate = "{{ path('admin_residence_delete', {id: 'ID_PLACEHOLDER'}) }}";
const editAppUrlTemplate = "{{ path('app_appartement_edit', {idApp: 'ID_PLACEHOLDER'}) }}";
const GenererMaintUrlTemplate = "{{ path('app_appartement_edit', {idApp: 'ID_PLACEHOLDER'}) }}";
const deleteAppUrlTemplate = "{{ path('app_appartement_delete', {idApp: 'ID_PLACEHOLDER'}) }}";

let resPage = 1, appPage = 1, resRows = [...residencesData], appRows = [...appartementsData], rowsPP = 10;
let resSortValue = 'name', resSortDir = 'asc';
let appSortValue = 'number', appSortDir = 'asc';

// Define openModal and closeModal functions globally
window.openModal = function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.add('active');
        modal.style.display = 'flex';
        console.log('Opened modal:', modalId);
    } else {
        console.error('Modal not found:', modalId);
    }
};

window.closeModal = function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.remove('active');
        modal.style.display = 'none';
    }
};

// Define switchGlassFace function globally
window.switchGlassFace = function(face, switcherId) {
    const switcher = document.getElementById(switcherId);
    if (switcher) {
        const faces = switcher.querySelectorAll('.glass-switcher-face');
        faces.forEach(f => f.style.display = 'none');
        
        let targetFace;
        if (face === 'main') {
            targetFace = switcher.querySelector('.glass-switcher-face-main');
        } else if (face === 'details') {
            targetFace = switcher.querySelector('.glass-switcher-face-details');
        } else if (face === 'edit') {
            targetFace = switcher.querySelector('.glass-switcher-face-edit');
        } else if (face === 'extra') {
            targetFace = switcher.querySelector('.glass-switcher-face-extra');
        }
        
        if (targetFace) {
            targetFace.style.display = 'block';
        }
    }
};

function updateResSortIcon() {
    const el = document.getElementById('res-sort-dir-icon-svg'); if(!el) return;
    el.innerHTML = resSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
}

function updateAppSortIcon() {
    const el = document.getElementById('app-sort-dir-icon-svg'); if(!el) return;
    el.innerHTML = appSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
}

window.selectResSortPill = function(pill) {
    resSortValue = pill.dataset.value;
    document.querySelectorAll('.res-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
    pill.classList.add('glass-pill-active');
    filterSortResidences();
};

window.selectAppSortPill = function(pill) {
    appSortValue = pill.dataset.value;
    document.querySelectorAll('.app-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
    pill.classList.add('glass-pill-active');
    filterSortAppartements();
};

function filterSortResidences() {
    const val = document.querySelector('.res-search-input').value.toLowerCase();
    let rows = residencesData.filter(d => d[0].toLowerCase().includes(val) || d[1].toLowerCase().includes(val));
    
    let idx = 0; // Name
    if(resSortValue === 'address') idx = 1;

    rows.sort((a,b) => {
        let vA = a[idx].toLowerCase(), vB = b[idx].toLowerCase();
        return resSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
    });
    resRows = rows; resPage = 1; renderResTable();
}

function filterSortAppartements() {
    const val = document.querySelector('.app-search-input').value.toLowerCase();
    let rows = appartementsData.filter(d => d[1].toLowerCase().includes(val) || d[0].toLowerCase().includes(val) || d[2].toLowerCase().includes(val));

    let idx = 0;
    let numeric = false;

    switch (appSortValue) {
        case "residence": idx = 1; break;
        case "status":    idx = 2; break;
        case "ID":        idx = 3; numeric = true; break;
        case "type":      idx = 6; break;
        case "surface":   idx = 10; numeric = true; break;
        case "price":     idx = 11; numeric = true; break;
    }

    rows.sort((a, b) => {
        if (numeric) {
            let vA = parseFloat(a[idx]) || 0;
            let vB = parseFloat(b[idx]) || 0;
            return appSortDir === 'asc' ? vA - vB : vB - vA;
        } else {
            let vA = a[idx].toLowerCase();
            let vB = b[idx].toLowerCase();
            return appSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        }
    });

    appRows = rows; appPage = 1; renderAppTable();
}

function renderResTable() {
    const tb = document.getElementById('res-table-body'); tb.innerHTML = '';
    const start = (resPage-1)*rowsPP, end = Math.min(start+rowsPP, resRows.length);
    for(let i=start; i<end; i++) {
        const d = resRows[i]; const r = document.createElement('tr');
        r.innerHTML = `<td><strong>${d[0]}</strong></td><td>${d[1]}</td><td><span class="glass-pill">Residence</span></td><td style="text-align: right;"><button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="viewRes(${i})"><i class="bx bx-show"></i> Details</button></td>`;
        tb.appendChild(r);
