{% extends 'base.html.twig' %}


{% block title %}Residence - Liquid Glass Admin{% endblock %}

{% block content %}
        <div class="liquid-glass-table-container">
            
            <div class="evenement-table-toolbar bg-faded" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
                <div class="col-sm-auto">

                    <form method="GET" action=" {{ path('admin_residence') }}">
                        <input type="text" 
                        class="evenement-search-input" 
                        name="cherche_residence"
                        value="{{ app.request.query.get('query') }}"
                        placeholder="Search evenement..." title="Search evenement...">
                        <i class="bx bx-search evenement-search-icon"></i>
                    </form>
                </div>
                    <div class="col-sm-auto">
                        <form method="GET" action=" {{ path('admin_residence') }}">
                        <select name="tri_r" id="tri_r"
                        value="{{ app.request.query.get('query') }}">Trier par: </span><button class="btn btn-primary" title="Add Evenement">
                            <option value="id">Défaut</option>
                            <option value="nom_r">Nom</option>
                            <option value="n_etages">Nombre étages</option>
                        </select>
                        <input type="submit" value="Trier">
                        </form>
                    </div>
                    <div class="col-sm-auto">
                        <span>Filtres: </span><button class="btn btn-primary" title="Add Evenement">ID</span>

                    </div>
                    <div class="col-sm-auto">
                    <button class="btn btn-info" title="Add Evenement">
                        <i class="bx bx-plus"></i><a class="text-white" href="{{ path('admin_residence_new') }}">Résidence</a>
                    </button>
                </div>
                    </div>
            <div class="container">
                <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Nom_r</th>
                <th>Adresse</th>
                <th>Image_r</th>
                <th>N appart</th>
                <th>N etages</th>
                <th>Date_ajout</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for residence in residences %}
            <tr>
                <td>{{ residence.nomR }}</td>
                <td>{{ residence.adresse }}</td>
                <td><img src="{{ residence.imageR ? asset('images/residence/' ~  residence.imageR) : '' }}" width="100"></td>
                <td>{{ residence.NAppartements }}</td>
                <td>{{ residence.NEtages }}</td>

                <td>{{ residence.dateAjout ? residence.dateAjout|date('Y-m-d') : '' }}</td>
                <td>
                <button class="btn btn-primary"><a class="text-white" href="{{ path('admin_residence_show', {'id': residence.id}) }}"><img src="https://img.icons8.com/?size=512&id=7695&format=png" width=15></a></button>
                <button class="btn btn-info"><a class="text-white" href="{{ path('admin_residence_edit', {'id': residence.id}) }}"><img src="https://img.icons8.com/m_two_tone/512/FFFFFF/edit.png" width=15></a></button>
                <button class="btn btn-danger"><a class="text-white" href="{{ path('admin_residence_delete', {'id': residence.id}) }}"><img src="https://img.icons8.com/m_rounded/512/FFFFFF/filled-trash.png" width=15></a></button>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

                </div>

</div>
</div>
</div>
{% endblock %}
{% block javascripts %}
	{{ parent() }}
{% endblock %}