    function setReviewStarValue(inputId, value) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const numericValue = Math.max(0, Math.min(10, parseInt(value || 0, 10)));
        input.value = numericValue;
        document.querySelectorAll(`.review-star-picker[data-target="${inputId}"] .review-star-option`).forEach(btn => {
            btn.classList.toggle('active', Number(btn.dataset.value) <= numericValue);
        });
        const caption = document.querySelector(`[data-caption-for="${inputId}"]`);
        if (caption) caption.textContent = `${numericValue}/10 stars selected`;
    }

    function initReviewStarPickers() {
        document.querySelectorAll('.review-star-picker').forEach(picker => {
            const target = picker.dataset.target;
            if (!target || picker.dataset.ready === 'true') return;
            picker.dataset.ready = 'true';
            for (let score = 0; score <= 10; score++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'review-star-option';
                btn.dataset.value = score;
                btn.innerHTML = score === 0 ? '0' : `${score}<i class='bx bxs-star'></i>`;
                btn.addEventListener('click', () => setReviewStarValue(target, score));
                picker.appendChild(btn);
            }
            setReviewStarValue(target, document.getElementById(target)?.value || 0);
        });
    }

