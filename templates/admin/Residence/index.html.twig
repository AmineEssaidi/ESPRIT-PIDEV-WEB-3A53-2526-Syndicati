{% extends 'base.html.twig' %}

{% block title %}Residences - Liquid Glass Admin{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
    <style>
        /* Hide scrollbars for specific modal containers while allowing them globally */
        .glass-switcher-face::-webkit-scrollbar,
        .users-edit-modal::-webkit-scrollbar,
        .users-edit-modal-body::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
        .glass-switcher-face,
        .users-edit-modal,
        .users-edit-modal-body {
            scrollbar-width: none !important; /* Firefox */
            -ms-overflow-style: none !important; /* IE 10+ */
        }

        /* Ensure box-sizing prevents padding overflow */
        .users-edit-modal, .users-edit-modal * {
            box-sizing: border-box !important;
        }

        /* Premium Modal Face-Lift - Obsidian Edition */
        /* Premium Modal Face-Lift - Obsidian Edition */
        .users-edit-modal {
            display: none;
            position: relative !important;
            width: 100% !important;
            height: auto !important;
            min-height: 100%;
            z-index: 10;
            padding: 0 !important; /* REMOVED PADDING */
            align-items: flex-start; 
            justify-content: flex-start; 
            background: transparent; 
        }
        .users-edit-modal::-webkit-scrollbar { display: none; /* Chrome/Safari/Webkit */ }

        .users-edit-modal.active {
            display: flex;
            animation: modalFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(40px) scale(0.97); filter: blur(10px); }
            to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }

        .users-edit-modal-card {
            background: transparent !important; /* REMOVED BACKGROUND */
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border: none !important; 
            box-shadow: none !important; 
            width: 100% !important;
            max-width: 100% !important; 
            margin: 0 !important; 
            
            /* Vertical Constraints */
            min-height: auto !important; 
            display: flex !important;
            flex-direction: column !important;

            border-radius: 0 !important; 
            overflow: visible; 
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .users-edit-modal-header {
            flex-shrink: 0; 
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1.5rem 2rem !important; /* REDUCED PADDING */
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent; 
        }
        .users-edit-modal-header h3 {
            font-size: 2rem !important;
            font-weight: 900 !important;
            letter-spacing: -0.04em !important;
            margin: 0 !important;
            color: #fff !important;
            text-shadow: 0 4px 12px rgba(0,0,0,0.3);
        }
        .users-edit-modal-subtitle {
            font-size: 1rem !important;
            color: rgba(255, 255, 255, 0.45) !important;
            margin-top: 0.5rem !important;
            font-weight: 500;
        }
        .users-edit-modal-close {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 50% !important;
            color: rgba(255, 255, 255, 0.6) !important;
            font-size: 1.6rem !important;
            display: flex !important;
            align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }
        .users-edit-modal-close:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            transform: rotate(180deg) scale(1.1);
            color: #fff !important;
        }
        .users-edit-modal-body {
            padding: 2rem !important; /* REDUCED PADDING */
            overflow-y: auto !important; 
            max-height: 80vh; /* Prevent it from growing too long */
            flex-grow: 1; 
            
            /* Hide scrollbar completely */
            scrollbar-width: none; 
            -ms-overflow-style: none; 
        }
        .users-edit-modal-body::-webkit-scrollbar {
            display: none; /* Chrome/Safari/Webkit */
        }

        /* Obsidian Form Styling */
        .glass-form-group {
            margin-bottom: 1.5rem; /* REDUCED MARGIN */
        }
        .glass-label {
            display: block;
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.3) !important;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            transition: all 0.3s ease;
        }
        .glass-form-group:focus-within .glass-label { color: rgba(255, 255, 255, 0.8) !important; transform: translateX(5px); }
        .glass-input, .form-control.bg-dark {
            width: 100%;
            background: rgba(0, 0, 0, 0.5) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 20px !important;
            padding: 1.2rem 1.6rem !important;
            color: #fff !important;
            font-size: 1.1rem !important;
            font-weight: 500;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.5) !important;
        }
        .glass-input:focus, .form-control.bg-dark:focus {
            background: rgba(0, 0, 0, 0.7) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 20px 40px rgba(0,0,0,0.4) !important;
            outline: none !important;
            transform: scale(1.01) translateY(-2px);
        }

        /* Obsidian View Details */
        .glass-view-row {
            display: flex;
            align-items: flex-start; /* ALIGNED TO TOP FOR LONG TEXT */
            padding: 1.8rem 2.5rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            margin-bottom: 1.5rem;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .glass-view-row:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            transform: translateX(12px) scale(1.01);
            box-shadow: -20px 0 40px rgba(0,0,0,0.3);
        }
        .glass-view-label {
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.25) !important;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            width: 180px;
            flex-shrink: 0;
        }
        .glass-view-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            flex: 1;
            word-break: break-all !important; /* PREVENTS OVERFLOW ON LONG STRINGS */
            white-space: pre-wrap !important; /* PRESERVES LINE BREAKS */
            line-height: 1.6;
        }

        /* Obsidian Buttons */
        .users-btn-modify {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%) !important;
            color: #fff !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            letter-spacing: 0.04em !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            cursor: pointer !important; transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1) !important;
            backdrop-filter: blur(5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
        }
        .users-btn-modify:hover {
            background: rgba(255, 255, 255, 0.15) !important;
            border-color: rgba(255, 255, 255, 0.3) !important;
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.1) !important;
        }
        .users-btn-delete {
            background: rgba(255, 59, 48, 0.05) !important;
            color: #ff3b30 !important;
            border: 1px solid rgba(255, 59, 48, 0.15) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            cursor: pointer !important;
            transition: all 0.4s ease !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            backdrop-filter: blur(5px);
        }
        .users-btn-delete:hover {
            background: rgba(255, 59, 48, 0.15) !important;
            border-color: #ff3b30 !important;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(255, 59, 48, 0.2) !important;
        }
        .users-btn-cancel, .users-btn-discard {
            background: rgba(255, 255, 255, 0.02) !important;
            color: rgba(255, 255, 255, 0.4) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
        }
        .users-btn-cancel:hover { background: rgba(255, 255, 255, 0.08) !important; color: #fff !important; }

        /* Premium Switcher Styles (Unified) */
        .premium-switcher-container {
            padding: 4px; background: rgba(10, 10, 10, 0.45); backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 100px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4); position: relative; z-index: 10; min-width: 400px;
        }
        .premium-switcher-pill { display: flex; position: relative; width: 100%; height: 44px; }
        .premium-switcher-slider {
            position: absolute; top: 0; left: 0; height: 100%;
            background: var(--accent-gradient, linear-gradient(90deg, #00c6ff 0%, #0072ff 100%));
            border-radius: 100px; box-shadow: 0 4px 20px rgba(0, 114, 255, 0.4);
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1); z-index: 1; pointer-events: none;
        }
        .premium-switcher-tab {
            flex: 1; position: relative; z-index: 2; background: transparent; border: none;
            color: rgba(255, 255, 255, 0.55); font-weight: 700; font-size: 0.95rem;
            letter-spacing: 0.03em; cursor: pointer; transition: all 0.3s ease;
            white-space: nowrap; outline: none; display: flex; align-items: center; justify-content: center;
            padding: 0 1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        .premium-switcher-tab.active { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }

        /* AI Prediction Styles */
        .ai-prediction-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 1rem;
            background: rgba(0, 198, 255, 0.1);
            border: 1px solid rgba(0, 198, 255, 0.2);
            border-radius: 100px;
            color: #00c6ff;
            font-weight: 700;
            font-size: 0.9rem;
        }
        .ai-prediction-display {
            font-size: 1.1rem;
            font-weight: 800;
            color: #00c6ff;
            text-shadow: 0 0 15px rgba(0, 198, 255, 0.3);
        }
        .prediction-spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(0, 198, 255, 0.3);
            border-top-color: #00c6ff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            display: none;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        
        /* Maintenance IA Specifics */
        .maintenance-ia-box {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 1.5rem;
            margin-top: 1rem;
        }
        .maintenance-header-ia {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 1rem;
            color: #00c6ff;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-size: 0.85rem;
        }
    </style>
{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Residences' } %}

<div class="users-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
    <div class="premium-switcher-container">
        <div class="premium-switcher-pill">
            <div class="premium-switcher-slider" id="residence-switcher-slider"></div>
            <button class="premium-switcher-tab active" data-page="1">Residences</button>
            <button class="premium-switcher-tab" data-page="2">Appartements</button>
            <button class="premium-switcher-tab" data-page="3">Maintenance</button>
        </div>
    </div>
</div>

<div id="residence-content" class="residence-content" style="margin-top: 1.5rem;">
    <!-- Page 1: Residences -->
    <div class="residence-page-content" data-page="1">
        <div class="glass-table-container">
            <div id="residenceGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
                        <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff;">Residences</h3>
                        <div style="flex: 1;"></div>
                        <button type="button" class="glass-btn-save" id="res-btn-add" style="padding: 0.6rem 1.5rem; font-size: 0.9rem;">
                            <i class="bx bx-plus"></i> Add Residence
                        </button>
                    </div>

                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
                            <i class="bx bx-search glass-search-icon"></i>
                            <input type="text" class="glass-search-input res-search-input" placeholder="Search residences...">
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active res-sort-option" data-value="name" onclick="selectResSortPill(this)">Name</div>
                            <div class="glass-pill res-sort-option" data-value="address" onclick="selectResSortPill(this)">Address</div>
                            <button class="glass-pagination-btn" id="res-sort-dir-pill" style="width: 38px; height: 38px;">
                                <span id="res-sort-dir-icon-svg"></span>
                            </button>
                        </div>
                    </div>

                    <div class="glass-table-scroll">
                        <table class="glass-table" id="res-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Address</th>
                                    <th>Type</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="res-table-body"><!-- Rendered by JS --></tbody>
                        </table>
                    </div>
                    <div class="glass-pagination-bar" id="res-pagination">
                        <button class="glass-pagination-btn" id="res-table-prev"><i class="bx bx-chevron-left"></i></button>
                        <div id="res-table-pages" style="display: flex; gap: 0.5rem;"></div>
                        <button class="glass-pagination-btn" id="res-table-next"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-details" id="res-view-face">
                    <div id="res-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Residence Details</h3><p class="users-edit-modal-subtitle">Full information overview</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('res-view-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                <div class="glass-view-details">
                                    <div class="glass-view-row"><div class="glass-view-label">Name</div><div class="glass-view-value" id="view-res-name">-</div></div>
                                    <div class="glass-view-row"><div class="glass-view-label">Address</div><div class="glass-view-value" id="view-res-address">-</div></div>
                                    <div class="glass-view-row" id="view-res-image-row" style="display: none; flex-direction: column;">
                                        <img id="view-res-image" src="" style="max-width: 100%; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
                                    </div>
                                </div>
                                <div class="users-view-modal-actions" style="margin-top: 2.5rem;">
                                    <button type="button" class="users-btn-modify" id="view-res-modify-btn"><i class="bx bx-edit"></i> Modify Residence</button>
                                    <form id="view-res-delete-form" method="post" style="display: inline-block; margin-left: 1rem;" data-ajax="true" data-refresh="softRefresh">
                                        <input type="hidden" name="_token" id="view-res-delete-token" value="">
                                        <button type="submit" class="users-btn-delete" data-delete-title="Delete Residence"><i class="bx bx-trash"></i> Delete Residence</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-edit" id="res-edit-face">
                    <div id="res-edit-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Edit Residence</h3><p class="users-edit-modal-subtitle">Update residence properties</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('res-edit-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if residenceEditForm is defined %}
                                {{ form_start(residenceEditForm, { 'attr': { 'id': 'res-edit-form', 'method': 'post', 'action': '', 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh', 'enctype': 'multipart/form-data' } }) }}
                                
                                {{ form_row(residenceEditForm.nomR, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                {{ form_row(residenceEditForm.adresse, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                
                                <div class="row">
                                    <div class="col-md-4">{{ form_row(residenceEditForm.nAppartements, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-4">{{ form_row(residenceEditForm.nEtages, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-4">{{ form_row(residenceEditForm.nBlocs, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                </div>
                                {{ form_row(residenceEditForm.imageR, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('res-edit-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-check"></i> Update Residence</button>
                                </div>
                                {{ form_end(residenceEditForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-extra" id="res-add-face">
                    <div id="res-add-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Add Residence</h3><p class="users-edit-modal-subtitle">Create a new entry</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('res-add-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if residenceAddForm is defined %}
                                {{ form_start(residenceAddForm, { 'attr': { 'id': 'res-add-form', 'method': 'post', 'action': path('admin_residence_add'), 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh', 'enctype': 'multipart/form-data' } }) }}
                                
                                {{ form_row(residenceAddForm.nomR, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                {{ form_row(residenceAddForm.adresse, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                
                                <div class="row">
                                    <div class="col-md-4">{{ form_row(residenceAddForm.nAppartements, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-4">{{ form_row(residenceAddForm.nEtages, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-4">{{ form_row(residenceAddForm.nBlocs, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                </div>
                                {{ form_row(residenceAddForm.imageR, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('res-add-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-plus"></i> Create Residence</button>
                                </div>
                                {{ form_end(residenceAddForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Page 2: Appartements -->
    <div class="residence-page-content" data-page="2" style="display: none;">
        <div class="glass-table-container">
            <div id="appartementGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
                        <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff;">Appartements</h3>
                        <div style="flex: 1;"></div>
                        <button type="button" class="glass-btn-save" id="app-btn-add" style="padding: 0.6rem 1.5rem; font-size: 0.9rem;">
                            <i class="bx bx-plus"></i> Add Appartement
                        </button>
                    </div>
                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
