        const reviewSearchInput = document.querySelector('.review-search-input');
        if (reviewSearchInput) reviewSearchInput.oninput = () => filterSortReviews();

        document.getElementById('res-btn-add').onclick = () => openModal('res-add-modal');
        const reviewAddBtn = document.getElementById('review-btn-add');
        if (reviewAddBtn) reviewAddBtn.onclick = () => openModal('review-add-modal');

        const notify = (icon, title, text) => {
            if (window.Swal) {
                Swal.fire({ icon, title, text, background: '#1a1a1a', color: '#fff', confirmButtonColor: '#ff6b6b' });
            } else {
                alert(text || title);
            }
        };
        const bindReviewAjax = (form, confirmMessage = null) => {
            if (!form) return;
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const submit = () => {
                    fetch(form.action, {
                        method: form.method || 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: new FormData(form)
                    })
                    .then(async response => {
                        const data = await response.json().catch(() => ({}));
                        if (!response.ok || data.success === false) {
                            throw new Error(data.message || 'Review action failed.');
                        }
                        notify('success', 'Done', data.message || 'Review saved.');
                        setTimeout(() => window.location.reload(), 500);
                    })
                    .catch(error => notify('error', 'Review Error', error.message));
                };

                if (!confirmMessage) {
                    submit();
                    return;
                }

                if (window.Swal) {
                    Swal.fire({
                        icon: 'warning',
                        title: confirmMessage,
                        text: 'This cannot be undone.',
                        showCancelButton: true,
                        confirmButtonText: 'Delete',
                        background: '#1a1a1a',
                        color: '#fff',
                        confirmButtonColor: '#ff4d4d'
                    }).then(result => { if (result.isConfirmed) submit(); });
                } else if (confirm(confirmMessage)) {
                    submit();
                }
            });
        };
        bindReviewAjax(document.getElementById('review-add-form'));
        bindReviewAjax(document.getElementById('review-edit-form'));
        bindReviewAjax(document.getElementById('view-review-delete-form'), 'Delete this review?');
        
        // Modified to initialize dropdowns when modal opens
        document.getElementById('app-btn-add').onclick = () => {
            openModal('app-add-modal');
            
            // Small delay to ensure modal is fully rendered
            setTimeout(() => {
                initApartmentDropdowns();
                setupAddFormPrediction();
            }, 150);
        };
        
        function setupAddFormPrediction() {
            const form = document.getElementById('app-add-form');
            const superficieInput = form.querySelector('[name*="superficie"]');
            const typeInput = form.querySelector('[name*="typeA"]');
            const targetEl = document.getElementById('add-app-prediction');
            const spinner = document.getElementById('add-prediction-spinner');

            if (!superficieInput || !typeInput) return;

            const update = () => {
                const s = superficieInput.value;
                const t = typeInput.value;
                if (s && t) fetchPrediction(s, t, targetEl, spinner);
            };

            superficieInput.addEventListener('input', update);
            typeInput.addEventListener('change', update);
        }

        function setupEditFormPrediction() {
            const form = document.getElementById('app-edit-form');
            const superficieInput = form.querySelector('[name*="superficie"]');
            const typeInput = form.querySelector('[name*="typeA"]');
            const targetEl = document.getElementById('edit-app-prediction');
            const spinner = document.getElementById('edit-prediction-spinner');

            if (!superficieInput || !typeInput) return;

            const update = () => {
                const s = superficieInput.value;
                const t = typeInput.value;
                if (s && t) fetchPrediction(s, t, targetEl, spinner);
            };

            superficieInput.addEventListener('input', update);
            typeInput.addEventListener('change', update);
            
            // Initial update
            update();
        }

        function fetchPrediction(superficie, type, targetEl, spinner) {
            if (spinner) spinner.style.display = 'block';
            
            fetch("{{ path('prediction_prix') }}", {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ superficie: superficie, type: type })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    targetEl.textContent = data.formatted_price;
                    targetEl.style.color = '#00c6ff';
                } else {
                    targetEl.textContent = 'Indisponible';
                }
            })
            .catch(() => {
                targetEl.textContent = 'Erreur';
            })
            .finally(() => {
                if (spinner) spinner.style.display = 'none';
            });
        }

        window.generateMaintenancePrediction = function(id, dataIdx) {
            const btn = document.getElementById('btn-generate-maintenance');
            const display = document.getElementById('view-app-maintenance-ia');
            
            btn.disabled = true;
            btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Analyse en cours...';
            display.style.opacity = '0.5';

            fetch(`/residence/appartement/${id}/predict-maintenance`, {
                method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    display.textContent = data.prediction;
                    display.style.opacity = '1';
                    display.style.color = '#fff';
                    
                    // Update main data array for future views without refresh
                    const mainIdx = appRows[dataIdx][3] == id ? dataIdx : -1; // Finding correct index just in case of filtering
                    if (mainIdx !== -1) {
                        appRows[mainIdx][17] = data.prediction;
                    }
                    // Find in global data as well
                    const globalIdx = appartementsData.findIndex(row => row[3] == id);
                    if (globalIdx !== -1) {
                        appartementsData[globalIdx][17] = data.prediction;
                    }
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Analyse Impossible',
                        text: data.message,
                        background: '#1a1a1a',
                        color: '#fff',
                        confirmButtonColor: '#00c6ff'
                    });
                }
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-refresh"></i> Réanalyser avec l\'IA';
            });
        };

        function initApartmentDropdowns() {
            // Try multiple selectors to find the residence dropdown
            const residenceSelect = document.querySelector('#app-add-form select[name*="residence"]') ||
                                  document.querySelector('select[name*="residence"]') ||
                                  document.querySelector('#app-add-form select');
            
            if (!residenceSelect) {
                console.error('Could not find residence select!');
                return;
            }

            const blocSelect = document.getElementById('app-bloc-select');
            const floorSelect = document.getElementById('app-floor-select');
            const numberSelect = document.getElementById('app-number-select');
            const blocInput = document.getElementById('app-bloc-field');
            const floorInput = document.getElementById('app-floor-field');
            const numberInput = document.getElementById('app-number-field');

            console.log('Initializing apartment dropdowns...');
            console.log('Residence select:', residenceSelect);

            // Sync selects with hidden inputs
            if (blocSelect && blocInput) {
                blocSelect.addEventListener('change', () => blocInput.value = blocSelect.value);
            }
            if (floorSelect && floorInput) {
                floorSelect.addEventListener('change', () => floorInput.value = floorSelect.value);
            }
            if (numberSelect && numberInput) {
                numberSelect.addEventListener('change', () => numberInput.value = numberSelect.value);
            }

            // Remove any existing listener and add new one
            const newResidenceSelect = residenceSelect.cloneNode(true);
            residenceSelect.parentNode.replaceChild(newResidenceSelect, residenceSelect);

            // When residence changes, populate dropdowns
            newResidenceSelect.addEventListener('change', function() {
                const selectedResId = this.value;
                console.log('Residence selected:', selectedResId);
                
                // Reset all dropdowns
                if (blocSelect) {
                    blocSelect.innerHTML = '<option value="">Select Bloc</option>';
                    if (blocInput) blocInput.value = '';
                }
                if (floorSelect) {
                    floorSelect.innerHTML = '<option value="">Select Floor</option>';
                    if (floorInput) floorInput.value = '';
                }
                if (numberSelect) {
                    numberSelect.innerHTML = '<option value="">Select Apartment</option>';
                    if (numberInput) numberInput.value = '';
                }
                
                if (!selectedResId) return;

                // Find residence data
                const resData = residencesData.find(r => r[3] == selectedResId);
                console.log('Found residence data:', resData);
                
                if (!resData) {
                    console.error('No data found for residence ID:', selectedResId);
                    return;
                }

                // Parse residence data
                const blocsString = resData[6] || '';
                const blocsArray = blocsString ? blocsString.split(',').map(b => b.trim()).filter(b => b) : [];
                const nEtages = parseInt(resData[5]) || 0;
                const nAppartements = parseInt(resData[4]) || 0;

                console.log('Populating - Blocs:', blocsArray, 'Floors:', nEtages, 'Apartments:', nAppartements);

                // Populate Bloc dropdown
                if (blocSelect && blocsArray.length > 0) {
                    blocsArray.forEach(bloc => {
                        const option = document.createElement('option');
                        option.value = bloc;
                        option.textContent = `Bloc ${bloc}`;
                        blocSelect.appendChild(option);
                    });
                    console.log('Populated', blocsArray.length, 'blocs');
                }

                // Populate Floor dropdown
                if (floorSelect && nEtages > 0) {
                    for (let i = 1; i <= nEtages; i++) {
                        const option = document.createElement('option');
                        option.value = i;
                        option.textContent = `Floor ${i}`;
                        floorSelect.appendChild(option);
                    }
                    console.log('Populated', nEtages, 'floors');
                }

                // Populate Apartment Number dropdown
                if (numberSelect && nAppartements > 0) {
                    for (let i = 1; i <= nAppartements; i++) {
                        const option = document.createElement('option');
                        option.value = i;
                        option.textContent = `Apartment ${i}`;
                        numberSelect.appendChild(option);
                    }
                    console.log('Populated', nAppartements, 'apartment numbers');
                }
            });
        }
    });
</script>
{% endblock %}
