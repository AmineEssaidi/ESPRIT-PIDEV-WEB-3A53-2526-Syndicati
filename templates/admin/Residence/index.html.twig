{% extends 'base.html.twig' %}


{% block title %}Residence - Liquid Glass Admin{% endblock %}

{% block content %}
        <div class="liquid-glass-table-container">
            
            <div class="evenement-table-toolbar bg-faded" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
                <div class="col-sm-3-auto">
                        <input type="text" class="evenement-search-input" placeholder="Search evenement..." title="Search evenement...">
                        <i class="bx bx-search evenement-search-icon"></i>
                </div>
                    <div class="col-sm-auto">
                        <span>Trier par: </span><button class="btn btn-primary" title="Add Evenement">ID</span>

                    </div>
                    <div class="col-sm-auto">
                        <span>Filtres: </span><button class="btn btn-primary" title="Add Evenement">ID</span>

                    </div>
                    <div class="col-sm-auto">
                    <button class="btn btn-info" title="Add Evenement">
                        <i class="bx bx-plus"></i> Ajouter Résidence
                    </button>
                </div>
                    </div>
            <div class="container">
                <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>Nom_r</th>
                <th>Adresse</th>
                <th>Image_r</th>
                <th>Date_ajout</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for residence in residences %}
            <tr>
                <td>{{ residence.id }}</td>
                <td>{{ residence.nomR }}</td>
                <td>{{ residence.adresse }}</td>
                <td>{{ residence.imageR }}</td>
                <td>{{ residence.dateAjout ? residence.dateAjout|date('Y-m-d') : '' }}</td>
                <td>
                <button class="btn btn-primary"><a class="text-white" href="{{ path('admin_residence_show', {'id': residence.id}) }}">Détails</a></button>
                <button class="btn btn-info"><a class="text-white" href="{{ path('admin_residence_edit', {'id': residence.id}) }}">Modifier</a></button>
                <button class="btn btn-danger"><a class="text-white" href="{{ path('admin_residence_delete', {'id': residence.id}) }}">Effacer</a></button>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

                </div>

</div>
</div>
</div>
{% endblock %}
{% block javascripts %}
	{{ parent() }}
{% endblock %}