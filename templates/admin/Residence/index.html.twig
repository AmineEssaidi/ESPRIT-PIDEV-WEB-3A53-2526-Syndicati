<script>


    const residencesData = [{% for r in residences|default([]) %} [ "{{ r.nomR|e('js') }}", "{{ r.adresse|e('js') }}", "{{ media_url(r.imageR, 'uploads/images')|default('')|e('js') }}", "{{ r.idResidence }}", "{{ r.nAppartements }}", "{{ r.nEtages }}", "{{ r.nBlocs }}", "{{ csrf_token('delete' ~ r.idResidence)|e('js') }}" ]{% if not loop.last %},{% endif %} {% endfor %}];
    const appartementsData = [{% for a in appartements|default([]) %} [ 
        "{{ a.appartementInfo ? a.appartementInfo.number|default('—')|e('js') : '—' }}", 
        "{{ a.residence ? a.residence.nomR|e('js') : '—' }}", 
        "{{ a.disponible ? 'Available' : 'Occupied' }}", 
        "{{ a.idApp }}", 
        "{{ a.residence ? a.residence.idResidence : '' }}", 
        "{{ a.user ? a.user.idUser : '' }}", 
        "{{ a.typeA|e('js') }}", 
        "{{ a.parking ? 'true' : 'false' }}", 
        "{{ a.appartementInfo ? a.appartementInfo.bloc|default('')|e('js') : '' }}", 
        "{{ a.appartementInfo ? a.appartementInfo.floor|default('')|e('js') : '' }}", 
        "{{ media_url(a.imageA, 'appartement_images')|default('')|e('js') }}", 
        "{{ a.superficie|default('—')|e('js') }}", 
        "{{ a.prixLocation|default('—')|e('js') }}", 
        "{{ a.prixVente|default('—')|e('js') }}", 
        "{{ a.dateConstruction ? a.dateConstruction|date('Y-m-d') : '—' }}", 
        "{{ csrf_token('delete' ~ a.idApp)|e('js') }}",
        "{{ predictions[a.idApp] ?? '—' }}",
        "{{ predictionsmaintenance[a.idApp]|default('Aucune recommandation générée.')|e('js') }}"
    ]{% if not loop.last %},{% endif %} {% endfor %}];
    
    const maintenancesData = [{% for m in maintenances|default([]) %} [
        "{{ m.idMaintenance }}",
        "{{ m.appartement and m.appartement.appartementInfo ? m.appartement.appartementInfo.number|default('—')|e('js') : '—' }}",
        "{{ m.etatApp|capitalize|e('js') }}",
        "{{ m.dateDerniereMaintenance ? m.dateDerniereMaintenance|date('Y-m-d') : '—' }}",
        "{{ m.descriptionMaint|e('js')|replace({"\n": ' ', "\r": ''}) }}",
        "{{ m.etatPlomberie|capitalize|e('js') }}",
        "{{ m.etatElectricite|capitalize|e('js') }}",
        "{{ m.etatChauffage|capitalize|e('js') }}",
        "{{ m.recommendationIa|default('Aucune recommandation générée.')|e('js')|replace({"\n": ' ', "\r": ''}) }}"
    ]{% if not loop.last %},{% endif %} {% endfor %}];

    const reviewsData = [{% for review in reviews|default([]) %} [
        "{{ review.idReview }}",
        "{{ review.appartement and review.appartement.residence ? review.appartement.residence.nomR|e('js') : '---' }}",
        "{{ review.appartement and review.appartement.appartementInfo ? review.appartement.appartementInfo.number|default(review.appartement.idApp)|e('js') : (review.appartement ? review.appartement.idApp : '---') }}",
        "{{ review.user ? ((review.user.firstName ~ ' ' ~ review.user.lastName)|trim|default(review.user.emailUser)|e('js')) : '---' }}",
        "{{ review.user ? review.user.emailUser|e('js') : '---' }}",
        "{{ review.score }}",
        "{{ csrf_token('review_edit_' ~ review.idReview)|e('js') }}",
        "{{ csrf_token('review_delete_' ~ review.idReview)|e('js') }}"
    ]{% if not loop.last %},{% endif %} {% endfor %}];
    
    const editResUrlTemplate = "{{ path('admin_residence_edit', {id: 'ID_PLACEHOLDER'}) }}";
    const deleteResUrlTemplate = "{{ path('admin_residence_delete', {id: 'ID_PLACEHOLDER'}) }}";
    const editAppUrlTemplate = "{{ path('app_appartement_edit', {idApp: 'ID_PLACEHOLDER'}) }}";
    const deleteAppUrlTemplate = "{{ path('app_appartement_delete', {idApp: 'ID_PLACEHOLDER'}) }}";
    const editReviewUrlTemplate = "{{ path('admin_residence_review_edit', {id: 'ID_PLACEHOLDER'}) }}";
    const deleteReviewUrlTemplate = "{{ path('admin_residence_review_delete', {id: 'ID_PLACEHOLDER'}) }}";

    let resPage = 1, appPage = 1, maintPage = 1, reviewPage = 1, resRows = [...residencesData], appRows = [...appartementsData], maintRows = [...maintenancesData], reviewRows = [...reviewsData], rowsPP = 10;
    let resSortValue = 'name', resSortDir = 'asc';
    let appSortValue = 'number', appSortDir = 'asc';
    let maintSortValue = 'date', maintSortDir = 'desc';
    let reviewSortValue = 'score', reviewSortDir = 'desc';

    function updateResSortIcon() {
        const el = document.getElementById('res-sort-dir-icon-svg'); if(!el) return;
        el.innerHTML = resSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }
    function updateAppSortIcon() {
        const el = document.getElementById('app-sort-dir-icon-svg'); if(!el) return;
        el.innerHTML = appSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }
    function updateMaintSortIcon() {
        const el = document.getElementById('maint-sort-dir-icon-svg'); if(!el) return;
        el.innerHTML = maintSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }
    function updateReviewSortIcon() {
        const el = document.getElementById('review-sort-dir-icon-svg'); if(!el) return;
        el.innerHTML = reviewSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }

    window.selectResSortPill = function(pill) {
        resSortValue = pill.dataset.value;
        document.querySelectorAll('.res-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        filterSortResidences();
    };

    window.selectAppSortPill = function(pill) {
        appSortValue = pill.dataset.value;
        document.querySelectorAll('.app-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        filterSortAppartements();
    };

    window.selectMaintSortPill = function(pill) {
        maintSortValue = pill.dataset.value;
        document.querySelectorAll('.maint-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        filterSortMaintenances();
    };

    window.selectReviewSortPill = function(pill) {
        reviewSortValue = pill.dataset.value;
        document.querySelectorAll('.review-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        filterSortReviews();
    };

    function filterSortResidences() {
        const val = document.querySelector('.res-search-input').value.toLowerCase();
        let rows = residencesData.filter(d => d[0].toLowerCase().includes(val) || d[1].toLowerCase().includes(val));
        
        let idx = 0; // Name
        if(resSortValue === 'address') idx = 1;

        rows.sort((a,b) => {
            let vA = a[idx].toLowerCase(), vB = b[idx].toLowerCase();
            return resSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });
        resRows = rows; resPage = 1; renderResTable();
    }

    function filterSortAppartements() {
        const val = document.querySelector('.app-search-input').value.toLowerCase();
        let rows = appartementsData.filter(d => d[0].toLowerCase().includes(val) || d[1].toLowerCase().includes(val) || d[2].toLowerCase().includes(val));
        
        let idx = 0; // Number
        if(appSortValue === 'residence') idx = 1;
        else if(appSortValue === 'status') idx = 2;

        rows.sort((a,b) => {
            let vA = a[idx].toLowerCase(), vB = b[idx].toLowerCase();
            return appSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });
        appRows = rows; appPage = 1; renderAppTable();
    }

    function filterSortMaintenances() {
        const val = document.querySelector('.maint-search-input').value.toLowerCase();
        let rows = maintenancesData.filter(d => 
            d[1].toLowerCase().includes(val) || 
            d[2].toLowerCase().includes(val) || 
            d[4].toLowerCase().includes(val)
        );
        
        let idx = 3; // Date
        if(maintSortValue === 'app') idx = 1;
        else if(maintSortValue === 'etat') idx = 2;

        rows.sort((a,b) => {
            let vA = a[idx].toLowerCase(), vB = b[idx].toLowerCase();
            if (idx === 3) { // Date sort
                return maintSortDir === 'asc' ? new Date(vA) - new Date(vB) : new Date(vB) - new Date(vA);
            }
            return maintSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });
        maintRows = rows; maintPage = 1; renderMaintenanceTable();
    }

    function filterSortReviews() {
        const input = document.querySelector('.review-search-input');
        const val = input ? input.value.toLowerCase() : '';
        let rows = reviewsData.filter(d =>
            d[1].toLowerCase().includes(val) ||
            String(d[2]).toLowerCase().includes(val) ||
            d[3].toLowerCase().includes(val) ||
            d[4].toLowerCase().includes(val)
        );

        let idx = 5;
        if (reviewSortValue === 'residence') idx = 1;
        else if (reviewSortValue === 'user') idx = 3;

        rows.sort((a, b) => {
            if (idx === 5) {
                return reviewSortDir === 'asc' ? Number(a[5]) - Number(b[5]) : Number(b[5]) - Number(a[5]);
            }
            const vA = String(a[idx]).toLowerCase(), vB = String(b[idx]).toLowerCase();
            return reviewSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });
        reviewRows = rows; reviewPage = 1; renderReviewTable();
    }

