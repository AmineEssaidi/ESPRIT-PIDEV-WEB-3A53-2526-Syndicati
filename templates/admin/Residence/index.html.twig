    document.getElementById('res-btn-add').onclick = () => openModal('res-add-modal');
    
    // FIXED: Add Appartement button with proper initialization
    const addAppButton = document.getElementById('app-btn-add');
    if (addAppButton) {
        addAppButton.addEventListener('click', function() {
            console.log('Add Appartement button clicked');
            openModal('app-add-modal');
            
            // Initialize dropdowns and prediction after modal opens
            setTimeout(() => {
                initApartmentDropdowns();
                setupAddFormPrediction();
            }, 300);
        });
    }

    // Setup edit form prediction with MutationObserver
    const editModal = document.getElementById('app-edit-modal');
    if (editModal) {
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                    if (editModal.style.display === 'flex') {
                        setTimeout(setupEditFormPrediction, 200);
                    }
                }
            });
        });
        
        observer.observe(editModal, { attributes: true });
    }
    
    setTimeout(setupEditFormPrediction, 500);

    console.log('Page initialization complete');
});
