    const total = Math.ceil(appRows.length / rowsPP), cont = document.getElementById('app-table-pages'); cont.innerHTML = '';
    for(let i=1; i<=total; i++) { const b = document.createElement('button'); b.className = 'glass-pagination-btn' + (i === appPage ? ' active' : ''); b.textContent = i; b.onclick = () => { appPage = i; renderAppTable(); }; cont.appendChild(b); }
}

