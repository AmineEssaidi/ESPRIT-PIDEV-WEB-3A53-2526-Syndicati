{% block javascripts %}
<script>
// Super Dashboard specific JavaScript
document.addEventListener('DOMContentLoaded', function() {
    // Initialize charts here if needed
    initDashboardCharts();
    
    // Set current date and time
    updateCurrentDateTime();
    
    // Update time every second
    setInterval(updateCurrentDateTime, 1000);
    
    // Initialize page management
    initPageManagement();
    
    // Initialize access control tabs
    initAccessControlTabs();
});

// Access Control Tab Functionality
function initAccessControlTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetTab = btn.getAttribute('data-tab');
            
            // Remove active class from all tabs and contents
            tabBtns.forEach(b => b.classList.remove('active'));
            tabContents.forEach(c => c.classList.remove('active'));
            
            // Add active class to clicked tab and corresponding content
            btn.classList.add('active');
            document.getElementById(targetTab + '-tab').classList.add('active');
        });
    });
}

// User Access Management Functions
function editUserAccess(userId) {
    // Placeholder function for editing user access
    console.log('Editing access for user:', userId);
    alert('User access editing functionality will be implemented when database is connected.');
}

// Page Permission Functions
function updatePagePermission(pageId, accessLevel) {
    // Placeholder function for updating page permissions
    console.log('Updating page permission:', pageId, 'to', accessLevel);
    alert('Page permission updating functionality will be implemented when database is connected.');
}

// Custom dropdown functionality
function initCustomDropdowns() {
    const dropdowns = document.querySelectorAll('.custom-dropdown');
    
    dropdowns.forEach(dropdown => {
        const trigger = dropdown.querySelector('.dropdown-trigger');
        const menu = dropdown.querySelector('.dropdown-menu');
        const options = dropdown.querySelectorAll('.dropdown-option');
        const valueSpan = dropdown.querySelector('.dropdown-value');
        
        // Toggle dropdown
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            
            // Close other dropdowns
            dropdowns.forEach(other => {
                if (other !== dropdown) {
                    other.classList.remove('active');
                }
            });
            
            dropdown.classList.toggle('active');
            
            // If opening dropdown, move it to body for better z-index
            if (dropdown.classList.contains('active')) {
                const menu = dropdown.querySelector('.dropdown-menu');
                const rect = trigger.getBoundingClientRect();
                
                // Create a portal container
                let portal = document.getElementById('dropdown-portal');
                if (!portal) {
                    portal = document.createElement('div');
                    portal.id = 'dropdown-portal';
                    portal.style.position = 'fixed';
                    portal.style.top = '0';
                    portal.style.left = '0';
                    portal.style.zIndex = '999999';
                    portal.style.pointerEvents = 'none';
                    document.body.appendChild(portal);
                }
                
                // Clone and position the menu
                const clonedMenu = menu.cloneNode(true);
                clonedMenu.style.position = 'fixed';
                clonedMenu.style.top = (rect.bottom + 5) + 'px';
                clonedMenu.style.left = rect.left + 'px';
                clonedMenu.style.width = rect.width + 'px';
                clonedMenu.style.pointerEvents = 'auto';
                clonedMenu.style.opacity = '1';
                clonedMenu.style.visibility = 'visible';
                clonedMenu.style.transform = 'translateY(0)';
                
                // Clear portal and add new menu
                portal.innerHTML = '';
                portal.appendChild(clonedMenu);
                
                // Add click handlers to cloned menu
                const clonedOptions = clonedMenu.querySelectorAll('.dropdown-option');
                clonedOptions.forEach(option => {
                    option.addEventListener('click', (e) => {
                        e.stopPropagation();
                        
                        // Remove active class from all options
                        options.forEach(opt => opt.classList.remove('active'));
                        
                        // Add active class to selected option
                        const originalOption = dropdown.querySelector(`[data-value="${option.dataset.value}"]`);
                        if (originalOption) {
                            originalOption.classList.add('active');
                        }
                        
                        // Update displayed value
                        valueSpan.textContent = option.textContent;
                        
                        // Get page and value
                        const page = dropdown.dataset.page;
                        const value = option.dataset.value;
                        
                        // Call update function
                        updatePagePermission(page, value);
                        
                        // Close dropdown
                        dropdown.classList.remove('active');
                        portal.innerHTML = '';
                    });
                });
            } else {
                // Close portal when dropdown is closed
                const portal = document.getElementById('dropdown-portal');
                if (portal) {
                    portal.innerHTML = '';
                }
            }
        });
        
        // Note: Option selection is now handled in the portal click handler above
    });
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', () => {
        dropdowns.forEach(dropdown => {
            dropdown.classList.remove('active');
        });
        
        // Close portal
        const portal = document.getElementById('dropdown-portal');
        if (portal) {
            portal.innerHTML = '';
        }
    });
    
    // Reposition dropdowns on window resize
    window.addEventListener('resize', () => {
        dropdowns.forEach(dropdown => {
            if (dropdown.classList.contains('active')) {
                const trigger = dropdown.querySelector('.dropdown-trigger');
                const menu = dropdown.querySelector('.dropdown-menu');
                const rect = trigger.getBoundingClientRect();
                
                menu.style.top = (rect.bottom + 5) + 'px';
                menu.style.left = rect.left + 'px';
                menu.style.width = rect.width + 'px';
            }
        });
    });
}

// Initialize custom dropdowns when DOM is loaded
document.addEventListener('DOMContentLoaded', initCustomDropdowns);

function updateCurrentDateTime() {
    const dateElement = document.getElementById('currentDate');
    const timeElement = document.getElementById('currentTime');
    
    if (dateElement) {
        const now = new Date();
        const options = { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric',
            weekday: 'long'
        };
        const formattedDate = now.toLocaleDateString('en-US', options);
        dateElement.textContent = formattedDate;
    }
    
    if (timeElement) {
        const now = new Date();
        const hours = now.getHours().toString().padStart(2, '0');
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const seconds = now.getSeconds().toString().padStart(2, '0');
        const formattedTime = `${hours}:${minutes}:${seconds}`;
        timeElement.textContent = formattedTime;
    }
}

