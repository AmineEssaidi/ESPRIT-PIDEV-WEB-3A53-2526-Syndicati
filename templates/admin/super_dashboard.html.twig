{% extends 'base.html.twig' %}

{% block title %}Super Dashboard — Syndicati Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/super_dashboard_obsidian.css') }}">
{% endblock %}

{% block content %}
{# Standard Syndicati Admin Header #}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Super Dashboard' } %}

<div class="hz-dashboard">
    <div class="matrix-section">
        <div class="matrix-header">
            <i class="bx bx-network-chart" style="font-size: 2rem; color: var(--accent, #7367f0);"></i>
            <h2 class="matrix-title">Navigation Matrix</h2>
        </div>

        <div class="row g-4">
            <!-- Frontend Pages -->
            <div class="col-lg-6">
                <div class="hz-glass p-4 h-100" style="border-radius: 16px; border: 1px solid var(--glass-border, rgba(255,255,255,0.12));">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <span class="badge bg-primary" style="background: var(--accent, #7367f0) !important; opacity: 0.8;">Frontend</span>
                        <h3 class="m-0 fs-5" style="color: var(--text, #e2e8f0);">User-facing Access</h3>
                    </div>
                    <div class="matrix-grid">
                        {% for page in frontendPages %}
                            <div class="hz-glass mb-3 p-3" style="border-radius: 12px; border: 1px solid var(--glass-border, rgba(255,255,255,0.1)); transition: transform 0.3s ease;">
                                <div class="page-card-top d-flex align-items-center gap-3">
                                    <div class="page-card-icon" style="width: 40px; height: 40px; background: rgba(var(--accent-rgb, 115, 103, 240), 0.1); color: var(--accent, #7367f0); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                        {{ page.icon }}
                                    </div>
                                    <div class="page-card-info flex-grow-1">
                                        <div class="page-card-name" style="font-weight: 700; color: var(--text, #e2e8f0);">{{ page.name }}</div>
                                        <div class="page-card-url" style="font-size: 0.75rem; color: var(--muted, #94a3b8); font-family: monospace;">{{ page.url }}</div>
                                    </div>
                                    <div class="page-toggle">
                                        <label class="obsidian-switch">
                                            <input type="checkbox" class="page-toggle-input" 
                                                   data-page-id="{{ page.id }}"
                                                   {% if page.status == 'online' %}checked{% endif %}>
                                            <span class="obsidian-slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Backend Pages -->
            <div class="col-lg-6">
                <div class="hz-glass p-4 h-100" style="border-radius: 16px; border: 1px solid var(--glass-border, rgba(255,255,255,0.12));">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <span class="badge bg-secondary" style="background: rgba(var(--muted-rgb, 148, 163, 184), 0.1) !important; color: var(--muted, #94a3b8) !important; border: 1px solid var(--glass-border, rgba(255,255,255,0.1));">Backend</span>
                        <h3 class="m-0 fs-5" style="color: var(--text, #e2e8f0);">System Controls</h3>
                    </div>
                    <div class="matrix-grid">
                        {% for page in backendPages %}
                            <div class="hz-glass mb-3 p-3" style="border-radius: 12px; border: 1px solid var(--glass-border, rgba(255,255,255,0.1)); transition: transform 0.3s ease;">
                                <div class="page-card-top d-flex align-items-center gap-3">
                                    <div class="page-card-icon" style="width: 40px; height: 40px; background: rgba(var(--accent-rgb, 115, 103, 240), 0.1); color: var(--accent, #7367f0); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                        {{ page.icon }}
                                    </div>
                                    <div class="page-card-info flex-grow-1">
                                        <div class="page-card-name" style="font-weight: 700; color: var(--text, #e2e8f0);">{{ page.name }}</div>
                                        <div class="page-card-url" style="font-size: 0.75rem; color: var(--muted, #94a3b8); font-family: monospace;">{{ page.url }}</div>
                                    </div>
                                    <div class="page-toggle">
                                        <label class="obsidian-switch">
                                            <input type="checkbox" class="page-toggle-input" 
                                                   data-page-id="{{ page.id }}"
                                                   {% if page.status == 'online' %}checked{% endif %}>
                                            <span class="obsidian-slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/super_dashboard_obsidian.js') }}"></script>
{% endblock %}
