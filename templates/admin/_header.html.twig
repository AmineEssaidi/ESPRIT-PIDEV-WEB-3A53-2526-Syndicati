<!-- Enhanced Header with Search and Profile -->
<nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center"
     id="layout-navbar">
    <!-- Burger menu removed -->

    <div class="navbar-nav-right d-flex align-items-center justify-content-between w-100" id="navbar-collapse">
        <!-- Enhanced Search Bar -->
        <div class="search-section">
            <div class="search-container">
                <i class="bx bx-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Rechercher..." aria-label="Rechercher..."/>
            </div>
        </div>

        <!-- Right Side Controls -->
        <div class="header-controls d-flex align-items-center gap-3">
            <!-- iOS Style Theme Toggle -->
            <div class="ios-theme-toggle">
                <div class="toggle-container" id="theme-toggle">
                    <div class="toggle-track">
                        <div class="toggle-thumb">
                            <span class="toggle-icon sun-icon">☀️</span>
                            <span class="toggle-icon moon-icon">🌙</span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Unified Notification Hub -->
            <div class="notif-wrapper">
                <div class="notif-bell" id="notifBell" title="Notifications">
                    <i class="bx bx-bell" style="font-size: 20px;"></i>
                    <span class="notif-badge" id="notifBadge" style="display: none;">0</span>
                </div>
                
                <div class="notif-hub" id="notifHub">
                    <div class="notif-hub-header">
                        <h5>{{ 'nav.notifications'|trans|default('Notifications') }}</h5>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <button id="notifMarkAllRead" class="notif-action-btn">{{ 'nav.mark_all_read'|trans|default('Tout lu') }}</button>
                            <button id="notifCloseHub" class="notif-close-btn"><i class="bx bx-x"></i></button>
                        </div>
                    </div>
                    <div class="notif-hub-body scrollbar-hide" id="notifScroll"></div>
                </div>
            </div>

            <!-- Enhanced User Profile Toggle Logic -->
            <script>
            document.addEventListener('DOMContentLoaded', function() {
                const bell = document.getElementById('notifBell');
                const hub = document.getElementById('notifHub');
                const closeBtn = document.getElementById('notifCloseHub');

                if (bell && hub) {
                    bell.onclick = function(e) {
                        e.stopPropagation();
                        const isActive = hub.classList.contains('active');
                        if (isActive) {
                            hub.classList.remove('active');
                            hub.style.display = 'none';
                        } else {
                            hub.style.display = 'flex';
                            hub.classList.add('active');
                        }
                    };

                    if (closeBtn) {
                        closeBtn.onclick = function(e) {
                            e.stopPropagation();
                            hub.classList.remove('active');
                            hub.style.display = 'none';
                        };
                    }

                    document.onclick = function(e) {
                        if (hub.classList.contains('active') && !hub.contains(e.target) && !bell.contains(e.target)) {
                            hub.classList.remove('active');
                            hub.style.display = 'none';
                        }
                    };
                }
            });
            </script>
            <div class="user-profile-dropdown">
