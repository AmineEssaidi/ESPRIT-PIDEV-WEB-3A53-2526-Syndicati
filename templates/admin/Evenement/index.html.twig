    // --- Custom dropdown logic for sorting pill ---
    const evenementSortPill = document.getElementById('evenement-sort-pill-custom');
    const evenementSortDropdown = document.getElementById('evenement-sort-dropdown');
    const evenementSortSelected = document.getElementById('evenement-sort-selected');
