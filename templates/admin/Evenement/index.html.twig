{% extends 'base.html.twig' %}

{% block title %}Evenements - Liquid Glass Admin{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
    <style>
        /* Hide scrollbars for specific modal containers while allowing them globally */
        .glass-switcher-face::-webkit-scrollbar,
        .users-edit-modal::-webkit-scrollbar,
        .users-edit-modal-body::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
        .glass-switcher-face,
        .users-edit-modal,
        .users-edit-modal-body {
            scrollbar-width: none !important; /* Firefox */
            -ms-overflow-style: none !important; /* IE 10+ */
        }

        /* Ensure box-sizing prevents padding overflow */
        .users-edit-modal, .users-edit-modal * {
            box-sizing: border-box !important;
        }

        /* Premium Modal Face-Lift - Obsidian Edition */
        /* Premium Modal Face-Lift - Obsidian Edition */
        .users-edit-modal {
            display: none;
            position: relative !important;
            width: 100% !important;
            height: auto !important;
            min-height: 100%;
            z-index: 10;
            padding: 0 !important; /* REMOVED PADDING */
            align-items: flex-start; 
            justify-content: flex-start; 
            background: transparent; 
        }
        .users-edit-modal::-webkit-scrollbar { display: none; /* Chrome/Safari/Webkit */ }

        .users-edit-modal.active {
            display: flex;
            animation: modalFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(40px) scale(0.97); filter: blur(10px); }
            to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }

        .users-edit-modal-card {
            background: transparent !important; /* REMOVED BACKGROUND */
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border: none !important; 
            box-shadow: none !important; 
            width: 100% !important;
            max-width: 100% !important; 
            margin: 0 !important; 
            
            /* Vertical Constraints */
            min-height: auto !important; 
            display: flex !important;
            flex-direction: column !important;

            border-radius: 0 !important; 
            overflow: visible; 
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .users-edit-modal-header {
            flex-shrink: 0; 
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1.5rem 2rem !important; /* REDUCED PADDING */
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent; 
        }
        .users-edit-modal-header h3 {
            font-size: 2rem !important;
            font-weight: 900 !important;
            letter-spacing: -0.04em !important;
            margin: 0 !important;
            color: #fff !important;
            text-shadow: 0 4px 12px rgba(0,0,0,0.3);
        }
        .users-edit-modal-subtitle {
            font-size: 1rem !important;
            color: rgba(255, 255, 255, 0.45) !important;
            margin-top: 0.5rem !important;
            font-weight: 500;
        }
        .users-edit-modal-close {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 50% !important;
            color: rgba(255, 255, 255, 0.6) !important;
            font-size: 1.6rem !important;
            display: flex !important;
            align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }
        .users-edit-modal-close:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            transform: rotate(180deg) scale(1.1);
            color: #fff !important;
        }
        .users-edit-modal-body {
            padding: 2rem !important; /* REDUCED PADDING */
            overflow-y: auto !important; 
            max-height: 80vh; /* Prevent it from growing too long */
            flex-grow: 1; 
            
            /* Hide scrollbar completely */
            scrollbar-width: none; 
            -ms-overflow-style: none; 
        }
        .users-edit-modal-body::-webkit-scrollbar {
            display: none; /* Chrome/Safari/Webkit */
        }

        /* Obsidian Form Styling */
        .glass-form-group {
            margin-bottom: 1.5rem; /* REDUCED MARGIN */
        }
        .glass-label {
            display: block;
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.3) !important;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            transition: all 0.3s ease;
        }
        .glass-form-group:focus-within .glass-label { color: rgba(255, 255, 255, 0.8) !important; transform: translateX(5px); }
        .glass-input, .form-control.bg-dark {
            width: 100%;
            background: rgba(0, 0, 0, 0.5) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 20px !important;
            padding: 1.2rem 1.6rem !important;
            color: #fff !important;
            font-size: 1.1rem !important;
            font-weight: 500;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.5) !important;
        }
        .glass-input:focus, .form-control.bg-dark:focus {
            background: rgba(0, 0, 0, 0.7) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 20px 40px rgba(0,0,0,0.4) !important;
            outline: none !important;
            transform: scale(1.01) translateY(-2px);
        }

        /* Obsidian View Details */
        .glass-view-row {
            display: flex;
            align-items: flex-start; /* ALIGNED TO TOP FOR LONG TEXT */
            padding: 1.8rem 2.5rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            margin-bottom: 1.5rem;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .glass-view-row:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            transform: translateX(12px) scale(1.01);
            box-shadow: -20px 0 40px rgba(0,0,0,0.3);
        }
        .glass-view-label {
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.25) !important;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            width: 180px;
            flex-shrink: 0;
        }
        .glass-view-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            flex: 1;
            word-break: break-all !important; /* PREVENTS OVERFLOW ON LONG STRINGS */
            white-space: pre-wrap !important; /* PRESERVES LINE BREAKS */
            line-height: 1.6;
        }

        /* Obsidian Buttons */
        .users-btn-modify {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%) !important;
            color: #fff !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            letter-spacing: 0.04em !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            cursor: pointer !important; transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1) !important;
            backdrop-filter: blur(5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
        }
        .users-btn-modify:hover {
            background: rgba(255, 255, 255, 0.15) !important;
            border-color: rgba(255, 255, 255, 0.3) !important;
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.1) !important;
        }
        .users-btn-delete {
            background: rgba(255, 59, 48, 0.05) !important;
            color: #ff3b30 !important;
            border: 1px solid rgba(255, 59, 48, 0.15) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            cursor: pointer !important;
            transition: all 0.4s ease !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            backdrop-filter: blur(5px);
        }
        .users-btn-delete:hover {
            background: rgba(255, 59, 48, 0.15) !important;
            border-color: #ff3b30 !important;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(255, 59, 48, 0.2) !important;
        }
        .users-btn-cancel, .users-btn-discard {
            background: rgba(255, 255, 255, 0.02) !important;
            color: rgba(255, 255, 255, 0.4) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
        }
        .users-btn-cancel:hover { background: rgba(255, 255, 255, 0.08) !important; color: #fff !important; }

        /* Premium Switcher Styles (Unified) */
        .premium-switcher-container {
            padding: 4px; background: rgba(10, 10, 10, 0.45); backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 100px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4); position: relative; z-index: 10; min-width: 400px;
        }
        .premium-switcher-pill { display: flex; position: relative; width: 100%; height: 44px; }
        .premium-switcher-slider {
            position: absolute; top: 0; left: 0; height: 100%;
            background: var(--accent-gradient, linear-gradient(90deg, #00c6ff 0%, #0072ff 100%));
            border-radius: 100px; box-shadow: 0 4px 20px rgba(0, 114, 255, 0.4);
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1); z-index: 1; pointer-events: none;
        }
        .premium-switcher-tab {
            flex: 1; position: relative; z-index: 2; background: transparent; border: none;
            color: rgba(255, 255, 255, 0.55); font-weight: 700; font-size: 0.95rem;
            letter-spacing: 0.03em; cursor: pointer; transition: all 0.3s ease;
            white-space: nowrap; outline: none; display: flex; align-items: center; justify-content: center;
            padding: 0 1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        .premium-switcher-tab.active { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
    </style>
{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Evenements' } %}

<div class="users-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
    <div class="premium-switcher-container">
        <div class="premium-switcher-pill">
            <div class="premium-switcher-slider" id="evenement-switcher-slider"></div>
            <button class="premium-switcher-tab active" data-page="1">Evenements</button>
            <button class="premium-switcher-tab" data-page="2">Participations</button>
        </div>
    </div>
</div>

<div id="evenement-content" class="evenement-content" style="margin-top: 1.5rem;">
    <!-- Page 1: Evenements -->
    <div class="evenement-page-content" data-page="1">
        <div class="glass-table-container">
            <div id="evenementGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
                        <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff;">Evenements</h3>
                        <div style="flex: 1;"></div>
                        <button type="button" class="glass-btn-save" id="event-btn-add" style="padding: 0.6rem 1.5rem; font-size: 0.9rem;">
                            <i class="bx bx-plus"></i> Add Event
                        </button>
                    </div>

                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
                            <i class="bx bx-search glass-search-icon"></i>
                            <input type="text" class="glass-search-input event-search-input" placeholder="Search events...">
                        </div>
                        
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active event-sort-option" data-value="date" onclick="selectEventSortPill(this)">Date</div>
                            <div class="glass-pill event-sort-option" data-value="title" onclick="selectEventSortPill(this)">Title</div>
                            <div class="glass-pill event-sort-option" data-value="location" onclick="selectEventSortPill(this)">Location</div>
                            <button class="glass-pagination-btn" id="event-sort-dir-pill" style="width: 38px; height: 38px;">
                                <span id="event-sort-dir-icon-svg"></span>
                            </button>
                        </div>
                    </div>

                    <div class="glass-table-scroll">
                        <table class="glass-table" id="event-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Location</th>
                                    <th>Date</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="event-table-body"><!-- Rendered by JS --></tbody>
                        </table>
                    </div>
                    <div class="glass-pagination-bar" id="event-pagination">
                        <button class="glass-pagination-btn" id="event-table-prev"><i class="bx bx-chevron-left"></i></button>
                        <div id="event-table-pages" style="display: flex; gap: 0.5rem;"></div>
                        <button class="glass-pagination-btn" id="event-table-next"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-details" id="event-view-face">
                    <div id="event-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Event Details</h3><p class="users-edit-modal-subtitle">Full information overview</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('event-view-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                <div class="glass-view-details">
                                    <div class="glass-view-row"><div class="glass-view-label">Title</div><div class="glass-view-value" id="view-event-title">-</div></div>
                                    <div class="glass-view-row"><div class="glass-view-label">Location</div><div class="glass-view-value" id="view-event-location">-</div></div>
                                    <div class="glass-view-row"><div class="glass-view-label">Date</div><div class="glass-view-value" id="view-event-date">-</div></div>
                                    <div class="glass-view-row" style="flex-direction: column; align-items: flex-start;">
                                        <div class="glass-view-label" style="width: 100%; margin-bottom: 0.5rem;">Description</div>
                                        <div class="glass-view-value" id="view-event-description" style="line-height: 1.6; opacity: 0.8;">-</div>
                                    </div>
                                    <div class="glass-view-row" id="view-event-image-row" style="display: none; flex-direction: column;">
                                        <img id="view-event-image" src="" style="max-width: 100%; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
                                    </div>
                                </div>
                                <div class="users-view-modal-actions" style="margin-top: 2.5rem;">
                                    <button type="button" class="users-btn-modify" id="view-event-modify-btn"><i class="bx bx-edit"></i> Modify Event</button>
                                    <form id="view-event-delete-form" method="post" style="display: inline-block; margin-left: 1rem;" data-ajax="true" data-refresh="softRefresh">
                                        <input type="hidden" name="_token" id="view-event-delete-token" value="">
                                        <button type="submit" class="users-btn-delete" data-delete-title="Delete Event"><i class="bx bx-trash"></i> Delete Event</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-edit" id="event-edit-face">
                    <div id="event-edit-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Edit Event</h3><p class="users-edit-modal-subtitle">Update event properties</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('event-edit-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if evenementEditForm is defined %}
                                {{ form_start(evenementEditForm, { 'attr': { 'id': 'event-edit-form', 'method': 'post', 'action': '', 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh', 'enctype': 'multipart/form-data' } }) }}
                                
                                <div class="row">
                                    <div class="col-md-8">
                                        {{ form_row(evenementEditForm.titre_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                    </div>
                                    <div class="col-md-4">
                                        {{ form_row(evenementEditForm.date_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                    </div>
                                </div>

                                {{ form_row(evenementEditForm.lieu_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                {{ form_row(evenementEditForm.description_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'style': 'height: 100px;' } }) }}
                                
                                <div class="row">
                                    <div class="col-md-6">{{ form_row(evenementEditForm.type_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-6">{{ form_row(evenementEditForm.statut_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">{{ form_row(evenementEditForm.nb_places, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-6">{{ form_row(evenementEditForm.nb_restants, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                </div>
                                {{ form_row(evenementEditForm.image_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('event-edit-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-check"></i> Update Event</button>
                                </div>
                                {{ form_end(evenementEditForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-extra" id="event-add-face">
                    <div id="event-add-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Add Event</h3><p class="users-edit-modal-subtitle">Create a new entry</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('event-add-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if evenementAddForm is defined %}
                                {{ form_start(evenementAddForm, { 'attr': { 'id': 'event-add-form', 'method': 'post', 'action': path('admin_evenement_add'), 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh', 'enctype': 'multipart/form-data' } }) }}
                                
                                <div class="row">
                                    <div class="col-md-8">
                                        {{ form_row(evenementAddForm.titre_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                    </div>
                                    <div class="col-md-4">
                                        {{ form_row(evenementAddForm.date_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                    </div>
                                </div>

                                {{ form_row(evenementAddForm.lieu_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                {{ form_row(evenementAddForm.description_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'style': 'height: 100px;' } }) }}
                                
                                <div class="row">
                                    <div class="col-md-6">{{ form_row(evenementAddForm.type_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-6">{{ form_row(evenementAddForm.statut_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">{{ form_row(evenementAddForm.nb_places, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-6">{{ form_row(evenementAddForm.nb_restants, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                </div>
                                {{ form_row(evenementAddForm.image_event, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('event-add-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-plus"></i> Post Event</button>
                                </div>
                                {{ form_end(evenementAddForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Page 2: Participations -->
    <div class="evenement-page-content" data-page="2" style="display: none;">
        <div class="glass-table-container">
            <div id="participationGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
                        <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff;">Participations</h3>
                    </div>
                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
                            <i class="bx bx-search glass-search-icon"></i>
                            <input type="text" class="glass-search-input part-search-input" placeholder="Search participations...">
                        </div>
                        
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active part-sort-option" data-value="date" onclick="selectPartSortPill(this)">Date</div>
                            <div class="glass-pill part-sort-option" data-value="user" onclick="selectPartSortPill(this)">User</div>
                            <div class="glass-pill part-sort-option" data-value="event" onclick="selectPartSortPill(this)">Event</div>
                            <button class="glass-pagination-btn" id="part-sort-dir-pill" style="width: 38px; height: 38px;">
                                <span id="part-sort-dir-icon-svg"></span>
                            </button>
                        </div>
                    </div>

                    <div class="glass-table-scroll">
                        <table class="glass-table" id="part-table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Event</th>
                                    <th>Date</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="part-table-body"><!-- Rendered by JS --></tbody>
                        </table>
                    </div>
                    <div class="glass-pagination-bar" id="part-pagination">
                        <button class="glass-pagination-btn" id="part-table-prev"><i class="bx bx-chevron-left"></i></button>
                        <div id="part-table-pages" style="display: flex; gap: 0.5rem;"></div>
                        <button class="glass-pagination-btn" id="part-table-next"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-details" id="part-view-face">
                    <div id="part-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Participation Details</h3><p class="users-edit-modal-subtitle">Information overview</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('part-view-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                <div class="glass-view-details">
                                    <div class="glass-view-row"><div class="glass-view-label">User</div><div class="glass-view-value" id="view-part-user">-</div></div>
                                    <div class="glass-view-row"><div class="glass-view-label">Event</div><div class="glass-view-value" id="view-part-event">-</div></div>
                                    <div class="glass-view-row"><div class="glass-view-label">Date</div><div class="glass-view-value" id="view-part-date">-</div></div>
                                </div>
                                <div class="users-view-modal-actions" style="margin-top: 2.5rem;">
                                    <button type="button" class="users-btn-modify" id="view-part-modify-btn"><i class="bx bx-edit"></i> Modify Participation</button>
                                    <form id="view-part-delete-form" method="post" style="display: inline-block; margin-left: 1rem;" data-ajax="true" data-refresh="softRefresh">
                                        <input type="hidden" name="_token" id="view-part-delete-token" value="">
                                        <button type="submit" class="users-btn-delete"><i class="bx bx-trash"></i> Delete Participation</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-edit" id="part-edit-face">
                    <div id="part-edit-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div><h3>Edit Participation</h3><p class="users-edit-modal-subtitle">Update record</p></div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('part-edit-modal')">&times;</button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if participationEditForm is defined %}
                                {{ form_start(participationEditForm, { 'attr': { 'id': 'part-edit-form', 'method': 'post', 'action': '', 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh' } }) }}
                                <div class="row">
                                    <div class="col-md-6">{{ form_row(participationEditForm.nb_accompagnants, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                    <div class="col-md-6">{{ form_row(participationEditForm.statut_participation, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}</div>
                                </div>
                                {{ form_row(participationEditForm.commentaire_participation, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'style': 'height: 100px;' } }) }}
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('part-edit-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-check"></i> Update Participation</button>
                                </div>
                                {{ form_end(participationEditForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>


    const eventsData = [{% for e in evenements|default([]) %} [ "{{ e.titreEvent|e('js') }}", "{{ e.lieuEvent|e('js') }}", "{{ e.descriptionEvent|e('js') }}", "{{ e.dateEvent|date('Y-m-d H:i') }}", "{{ e.imageEvent|e('js') }}", "{{ e.id }}", "{{ csrf_token('delete' ~ e.id)|e('js') }}" ]{% if not loop.last %},{% endif %} {% endfor %}];
    const partsData = [{% for p in participations|default([]) %} [ "{{ p.user ? p.user.emailUser|e('js') : '—' }}", "{{ p.evenement ? p.evenement.titreEvent|e('js') : '—' }}", "{{ p.dateParticipation|date('Y-m-d H:i') }}", "{{ p.id }}", "{{ csrf_token('delete' ~ p.id)|e('js') }}" ]{% if not loop.last %},{% endif %} {% endfor %}];

    const editEventUrlTemplate = "{{ path('admin_evenement_edit', {id: 'ID_PLACEHOLDER'}) }}";
    const deleteEventUrlTemplate = "{{ path('admin_evenement_delete', {id: 'ID_PLACEHOLDER'}) }}";
    const editPartUrlTemplate = "{{ path('admin_participation_edit', {id: 'ID_PLACEHOLDER'}) }}";
    const deletePartUrlTemplate = "{{ path('admin_participation_delete', {id: 'ID_PLACEHOLDER'}) }}";

    let evPage = 1, ptPage = 1, evRows = [...eventsData], ptRows = [...partsData], rowsPP = 10;
    let evSortValue = 'date', evSortDir = 'desc';
    let ptSortValue = 'date', ptSortDir = 'desc';

    function updateEventSortIcon() {
        const el = document.getElementById('event-sort-dir-icon-svg'); if(!el) return;
        el.innerHTML = evSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }
    function updatePartSortIcon() {
        const el = document.getElementById('part-sort-dir-icon-svg'); if(!el) return;
        el.innerHTML = ptSortDir === 'asc' ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>` : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }

    window.selectEventSortPill = function(pill) {
        evSortValue = pill.dataset.value;
        document.querySelectorAll('.event-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        filterSortEvents();
    };

    window.selectPartSortPill = function(pill) {
        ptSortValue = pill.dataset.value;
        document.querySelectorAll('.part-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        filterSortParts();
    };

    function filterSortEvents() {
        const val = document.querySelector('.event-search-input').value.toLowerCase();
        let rows = eventsData.filter(d => d[0].toLowerCase().includes(val) || d[1].toLowerCase().includes(val) || d[2].toLowerCase().includes(val));
        
        let idx = 3; // Date
        if(evSortValue === 'title') idx = 0;
        else if(evSortValue === 'location') idx = 1;

        rows.sort((a,b) => {
            let vA = a[idx].toLowerCase(), vB = b[idx].toLowerCase();
            return evSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });
        evRows = rows; evPage = 1; renderEvTable();
    }

    function filterSortParts() {
        const val = document.querySelector('.part-search-input').value.toLowerCase();
        let rows = partsData.filter(d => d[0].toLowerCase().includes(val) || d[1].toLowerCase().includes(val));
        
        let idx = 2; // Date
        if(ptSortValue === 'user') idx = 0;
        else if(ptSortValue === 'event') idx = 1;

        rows.sort((a,b) => {
            let vA = a[idx].toLowerCase(), vB = b[idx].toLowerCase();
            return ptSortDir === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });
        ptRows = rows; ptPage = 1; renderPtTable();
    }

    function renderEvTable() {
        const tb = document.getElementById('event-table-body'); tb.innerHTML = '';
        const start = (evPage-1)*rowsPP, end = Math.min(start+rowsPP, evRows.length);
        for(let i=start; i<end; i++) {
            const d = evRows[i]; const r = document.createElement('tr');
            r.innerHTML = `<td><strong>${d[0]}</strong></td><td>${d[1]}</td><td>${d[3]}</td><td style="text-align: right;"><button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="event.stopPropagation(); viewEvent(${i})"><i class="bx bx-show"></i> Details</button></td>`;
            tb.appendChild(r);
        }
        const total = Math.ceil(evRows.length / rowsPP), cont = document.getElementById('event-table-pages'); cont.innerHTML = '';
        for(let i=1; i<=total; i++) { const b = document.createElement('button'); b.className = 'glass-pagination-btn' + (i === evPage ? ' active' : ''); b.textContent = i; b.onclick = () => { evPage = i; renderEvTable(); }; cont.appendChild(b); }
    }
    function renderPtTable() {
        const tb = document.getElementById('part-table-body'); tb.innerHTML = '';
        const start = (ptPage-1)*rowsPP, end = Math.min(start+rowsPP, ptRows.length);
        for(let i=start; i<end; i++) {
            const d = ptRows[i]; const r = document.createElement('tr');
            r.innerHTML = `<td><strong>${d[0]}</strong></td><td>${d[1]}</td><td>${d[2]}</td><td style="text-align: right;"><button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="event.stopPropagation(); viewPart(${i})"><i class="bx bx-show"></i> Details</button></td>`;
            tb.appendChild(r);
        }
        const total = Math.ceil(ptRows.length / rowsPP), cont = document.getElementById('part-table-pages'); cont.innerHTML = '';
        for(let i=1; i<=total; i++) { const b = document.createElement('button'); b.className = 'glass-pagination-btn' + (i === ptPage ? ' active' : ''); b.textContent = i; b.onclick = () => { ptPage = i; renderPtTable(); }; cont.appendChild(b); }
    }

    window.viewEvent = function(idx) {
        const d = evRows[idx]; document.getElementById('view-event-title').textContent = d[0]; document.getElementById('view-event-location').textContent = d[1]; document.getElementById('view-event-description').textContent = d[2]; document.getElementById('view-event-date').textContent = d[3];
        const ir = document.getElementById('view-event-image-row'); if(d[4]) { document.getElementById('view-event-image').src = '/uploads/events/' + d[4]; ir.style.display = 'flex'; } else ir.style.display = 'none';
        document.getElementById('view-event-delete-token').value = d[6]; document.getElementById('view-event-delete-form').action = deleteEventUrlTemplate.replace('ID_PLACEHOLDER', d[5]);
        document.getElementById('view-event-modify-btn').onclick = () => {
            const f = document.getElementById('event-edit-form'); f.action = editEventUrlTemplate.replace('ID_PLACEHOLDER', d[5]);
            f.querySelector('[name*="titre_event"]').value = d[0]; f.querySelector('[name*="lieu_event"]').value = d[1]; f.querySelector('[name*="description_event"]').value = d[2]; f.querySelector('[name*="date_event"]').value = d[3].replace(' ', 'T');
            openModal('event-edit-modal');
        };
        // 1. Explicitly mark the modal as active before the switcher starts
        const vModal = document.getElementById('event-view-modal');
        if (vModal) {
            vModal.style.display = 'flex';
            void vModal.offsetWidth;
            vModal.classList.add('active');
        }
        openModal('event-view-modal');
    };
    window.viewPart = function(idx) {
        const d = ptRows[idx]; document.getElementById('view-part-user').textContent = d[0]; document.getElementById('view-part-event').textContent = d[1]; document.getElementById('view-part-date').textContent = d[2];
        document.getElementById('view-part-delete-token').value = d[4]; document.getElementById('view-part-delete-form').action = deletePartUrlTemplate.replace('ID_PLACEHOLDER', d[3]);
        document.getElementById('view-part-modify-btn').onclick = () => {
            const f = document.getElementById('part-edit-form'); f.action = editPartUrlTemplate.replace('ID_PLACEHOLDER', d[3]);
            openModal('part-edit-modal');
        };
        // 1. Explicitly mark the modal as active before the switcher starts
        const vModal = document.getElementById('part-view-modal');
        if (vModal) {
            vModal.style.display = 'flex';
            void vModal.offsetWidth;
            vModal.classList.add('active');
        }
        openModal('part-view-modal');
    };

    document.addEventListener('DOMContentLoaded', () => {
        const sl = document.getElementById('evenement-switcher-slider'), ts = document.querySelectorAll('.premium-switcher-tab'), ps = document.querySelectorAll('.evenement-page-content');
        ts.forEach((t, i) => t.addEventListener('click', () => {
            ts.forEach(x => x.classList.remove('active')); t.classList.add('active'); sl.style.left = (i * 50) + '%'; sl.style.width = '50%';
            ps.forEach(p => p.style.display = p.dataset.page === t.dataset.page ? 'block' : 'none');
            const as = document.querySelector(`.evenement-page-content[data-page="${t.dataset.page}"] .glass-switcher`); if(as) switchGlassFace('main', as.id);
        }));
        sl.style.width = '50%'; 
        renderEvTable(); 
        renderPtTable(); 
        updateEventSortIcon();
        updatePartSortIcon();
        switchGlassFace('main', 'evenementGlassSwitcher');

        document.getElementById('event-sort-dir-pill').onclick = () => { evSortDir = evSortDir === 'asc' ? 'desc' : 'asc'; updateEventSortIcon(); filterSortEvents(); };
        document.getElementById('part-sort-dir-pill').onclick = () => { ptSortDir = ptSortDir === 'asc' ? 'desc' : 'asc'; updatePartSortIcon(); filterSortParts(); };

        document.querySelector('.event-search-input').oninput = () => filterSortEvents();
        document.querySelector('.part-search-input').oninput = () => filterSortParts();

        document.getElementById('event-btn-add').onclick = () => openModal('event-add-modal');
    });
</script>
{% endblock %}
