    evenementSortPill.addEventListener('click', function(e) {
        e.stopPropagation();
        if (evenementSortDropdown.style.display === 'flex') {
            closeEvenementSortDropdown();
        } else {
            openEvenementSortDropdown();
        }
    });

    document.querySelectorAll('.evenement-sort-option').forEach(opt => {
        opt.addEventListener('click', function(e) {
