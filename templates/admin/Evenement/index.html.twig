			<script>
				// Participation data from controller
				const participationData = [
				{% for p in participations|default([]) %}
				[
					"{{ p.evenement ? p.evenement.titreEvent|e('js') : 'Deleted Event' }}",
					"{{ p.user ? (p.user.firstName ~ ' ' ~ p.user.lastName)|e('js') : '—' }}",
					"{{ p.dateParticipation|date('Y-m-d H:i') }}",
					"{{ p.statutParticipation|e('js') }}",
					"{{ p.nbAccompagnants }}",
					"{{ p.id }}",
					"{{ p.user ? p.user.emailUser|e('js') : '' }}",
					"{{ p.commentaireParticipation|e('js') }}"
				]{% if not loop.last %},{% endif %}
				{% endfor %}
				];

				const participationRowsPerPage = 10;
				let participationCurrentPage = 1;
				let participationSortValue = 'date';
				let participationSortDirection = 'desc'; 
				let participationFilteredRows = [...participationData];
				
				const participationSearchInput = document.getElementById('participation-search-input');
				const participationSortDirBtn = document.getElementById('participation-sort-dir-pill');
				const participationSortDirIconSvg = document.getElementById('participation-sort-dir-icon-svg');
				const participationSortPill = document.getElementById('participation-sort-pill-custom');
				const participationSortDropdown = document.getElementById('participation-sort-dropdown');
				const participationSortSelected = document.getElementById('participation-sort-selected');
				
				function updateParticipationSortDirIcon() {
					participationSortDirIconSvg.innerHTML = participationSortDirection === 'asc'
						? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 15 12 9 18 15" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`
						: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 9 12 15 18 9" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
				}
				
				function participationFilterAndSortRows() {
					let rows = [...participationData];
					const search = participationSearchInput.value.trim().toLowerCase();
					
					if (search) {
						rows = rows.filter(row => 
							row[0].toLowerCase().includes(search) || // Event
							row[1].toLowerCase().includes(search) || // User
							row[6].toLowerCase().includes(search)    // Email
						);
					}
					
					// Indices: 0=Event, 1=User, 2=Date, 3=Status, 4=Guests
					let sortIdx = 2; // Default Date
					if (participationSortValue === 'event') sortIdx = 0;
					else if (participationSortValue === 'user') sortIdx = 1;
					else if (participationSortValue === 'status') sortIdx = 3;
					else if (participationSortValue === 'date') sortIdx = 2;
					
					rows.sort((a, b) => {
						let valA = a[sortIdx].toLowerCase();
						let valB = b[sortIdx].toLowerCase();
						if (participationSortDirection === 'asc') return valA.localeCompare(valB);
						else return valB.localeCompare(valA);
					});
					
					participationFilteredRows = rows;
					participationCurrentPage = 1;
					updateParticipationTablePagination();
				}
				
				function renderParticipationTablePage(page) {
					const tbody = document.getElementById('participation-table-body');
					tbody.innerHTML = '';
					
					if (participationFilteredRows.length === 0) {
						 const row = document.createElement('tr');
						 row.innerHTML = '<td colspan="6" style="padding: 2rem; opacity: 0.7;">No participations found.</td>';
						 tbody.appendChild(row);
						 return;
					}

					const start = (page-1)*participationRowsPerPage;
					const end = Math.min(start+participationRowsPerPage, participationFilteredRows.length);
					
					for (let r = start; r < end; r++) {
						const row = document.createElement('tr');
						const data = participationFilteredRows[r];
						
						// Event
						const tdEvent = document.createElement('td');
						tdEvent.style.fontWeight = "600";
						tdEvent.textContent = data[0];
						row.appendChild(tdEvent);
						
						// User
						const tdUser = document.createElement('td');
						tdUser.innerHTML = `${data[1]}<br><small style="opacity:0.7">${data[6]}</small>`;
						row.appendChild(tdUser);
						
						// Date
						const tdDate = document.createElement('td');
						tdDate.textContent = data[2];
						row.appendChild(tdDate);
						
						// Status
						const tdStatus = document.createElement('td');
						let statusColor = '#f1c40f'; // en_attente (yellow)
						if(data[3] === 'confirme') statusColor = '#2ecc71';
						else if(data[3] === 'refuse' || data[3] === 'annule') statusColor = '#e74c3c';
						
						tdStatus.innerHTML = `<span style="color:${statusColor}; font-weight:600;">${data[3]}</span>`;
						row.appendChild(tdStatus);
						
						// Guests
						const tdGuests = document.createElement('td');
						tdGuests.textContent = data[4];
						row.appendChild(tdGuests);

						// Actions
						const tdActions = document.createElement('td');
						tdActions.innerHTML = `
							<button class="evenement-btn-modify participation-view-btn" 
									data-participation-id="${data[5]}"
									title="View Details" 
									style="padding: 0.35rem 1.25rem; font-size: 0.9rem;">
								<i class="bx bx-show"></i> View Details
							</button>
						`;
						row.appendChild(tdActions);
						
						tbody.appendChild(row);
					}
				}
				
				function renderParticipationTablePagination() {
					const totalPages = Math.ceil(participationFilteredRows.length / participationRowsPerPage);
					const pagesDiv = document.getElementById('participation-table-pages');
					pagesDiv.innerHTML = '';
					for (let i = 1; i <= totalPages; i++) {
						const btn = document.createElement('button');
						btn.className = 'evenement-table-page-btn' + (i === participationCurrentPage ? ' active' : '');
						btn.textContent = i;
						btn.onclick = () => { participationCurrentPage = i; updateParticipationTablePagination(); };
						pagesDiv.appendChild(btn);
					}
					document.getElementById('participation-table-prev').disabled = participationCurrentPage === 1;
					document.getElementById('participation-table-next').disabled = participationCurrentPage === totalPages;
				}
				
				function updateParticipationTablePagination() {
					renderParticipationTablePage(participationCurrentPage);
					renderParticipationTablePagination();
				}
				
				document.addEventListener('DOMContentLoaded', function() {
					updateParticipationSortDirIcon();
					updateParticipationTablePagination();
					
					participationSearchInput.addEventListener('input', participationFilterAndSortRows);
					
					participationSortDirBtn.addEventListener('click', function() {
						participationSortDirection = (participationSortDirection === 'asc') ? 'desc' : 'asc';
						updateParticipationSortDirIcon();
						participationFilterAndSortRows();
					});
					
					document.getElementById('participation-table-prev').onclick = function() {
						if (participationCurrentPage > 1) { participationCurrentPage--; updateParticipationTablePagination(); }
					};
					document.getElementById('participation-table-next').onclick = function() {
						const totalPages = Math.ceil(participationFilteredRows.length / participationRowsPerPage);
						if (participationCurrentPage < totalPages) { participationCurrentPage++; updateParticipationTablePagination(); }
					};
					
