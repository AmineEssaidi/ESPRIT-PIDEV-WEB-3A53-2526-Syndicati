    let sortValue = 'name';

    function closeSortDropdown() {
        if (sortDropdown) {
            sortDropdown.style.display = 'none';
        }
        if (sortPill) {
            sortPill.classList.remove('open');
        }
    }

    function openSortDropdown() {
        if (sortDropdown) {
            sortDropdown.style.display = 'flex';
        }
        if (sortPill) {
            sortPill.classList.add('open');
        }
    }

    if (sortPill && sortDropdown) {
        sortPill.addEventListener('click', function(e) {
            e.stopPropagation();
            if (sortDropdown.style.display === 'flex') {
                closeSortDropdown();
            } else {
                openSortDropdown();
            }
        });

        document.querySelectorAll('.evenement-sort-option').forEach(opt => {
            opt.addEventListener('click', function(e) {
                sortValue = this.getAttribute('data-value');
                sortSelected.textContent = this.textContent;
                document.querySelectorAll('.evenement-sort-option').forEach(o => o.classList.remove('active'));
                this.classList.add('active');
                closeSortDropdown();
                evenementSortValue = sortValue;
                evenementFilterAndSortRows();
            });
        });

        document.addEventListener('click', function(e) {
            if (!sortPill.contains(e.target)) {
                closeSortDropdown();
            }
        });

        sortPill.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeSortDropdown();
            }
            if (e.key === 'ArrowDown') {
                openSortDropdown();
                const first = sortDropdown.querySelector('.evenement-sort-option');
                if (first) first.focus();
            }
        });
    }

    // --- Pills logic ---
    function showEvenementPage(page) {
        document.querySelectorAll('.evenement-page-content').forEach(div => {
            div.style.display = div.dataset.page === page ? '' : 'none';
        });
    }

    function updatePillSlider() {
        const pills = document.querySelectorAll('.pill-tab');
        const slider = document.querySelector('.pill-slider');
        const active = document.querySelector('.pill-tab.active');

        if (!active || !slider) return;

        slider.style.left = active.offsetLeft + 'px';
        slider.style.width = active.offsetWidth + 'px';
    }

    document.querySelectorAll('.pill-tab').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.pill-tab').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            updatePillSlider();
            showEvenementPage(this.dataset.page);
        });
    });

    showEvenementPage('1');
    setTimeout(updatePillSlider, 100);
    window.addEventListener('resize', updatePillSlider);

    // --- Sort direction toggle logic ---
    let evenementSortDirection = 'asc';
    const evenementSortDirBtn = document.getElementById('evenement-sort-dir-pill');
