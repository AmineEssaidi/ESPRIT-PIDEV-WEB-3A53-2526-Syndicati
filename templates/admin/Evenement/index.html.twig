    const origRenderEvenementTablePagination = renderEvenementTablePagination;
    renderEvenementTablePagination = function() {
        const totalPages = Math.ceil(evenementFilteredRows.length / evenementRowsPerPage);
        const pagesDiv = document.getElementById('evenement-table-pages');
