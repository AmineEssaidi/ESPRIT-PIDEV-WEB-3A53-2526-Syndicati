        row.appendChild(tdDelete);

        tbody.appendChild(row);
    }
}

function renderEvenementTablePagination() {
    const totalPages = Math.ceil(evenementFilteredRows.length / evenementRowsPerPage);
    const pagesDiv = document.getElementById('evenement-table-pages');
    pagesDiv.innerHTML = '';

    for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.className = 'evenement-table-page-btn' + (i === evenementCurrentPage ? ' active' : '');
        btn.textContent = i;
        btn.onclick = () => {
            evenementCurrentPage = i;
            updateEvenementTablePagination();
        };
        pagesDiv.appendChild(btn);
    }

    document.getElementById('evenement-table-prev').disabled = (evenementCurrentPage === 1);
    document.getElementById('evenement-table-next').disabled = (evenementCurrentPage === totalPages);
}

function updateEvenementTablePagination() {
    renderEvenementTablePage(evenementCurrentPage);
    renderEvenementTablePagination();
}

document.addEventListener('DOMContentLoaded', function() {
