        }
        .evenement-edit-label {
            display: block;
            margin-bottom: 0.6rem;
            text-transform: none;
            color: #bfc9d8;
            font-weight: 500;
            font-size: 0.9rem;
        }
        [data-theme="light"] .evenement-edit-input {
            background: #f0f4f8;
            border-color: #dce2e8;
            color: #1c202a;
        }
        [data-theme="light"] .evenement-edit-input:focus {
            background: #fff;
            border-color: #0072ff;
            box-shadow: 0 0 0 3px rgba(0, 114, 255, 0.15);
        }
        [data-theme="light"] .evenement-edit-label {
            color: #4a5568;
