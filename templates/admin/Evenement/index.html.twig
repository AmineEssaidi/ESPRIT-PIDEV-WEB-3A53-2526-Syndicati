{% extends 'base.html.twig' %}

{% block title %}Evenement - Liquid Glass Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Evenement' } %}
<div class="evenement-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
	<div class="evenement-pagination-pills pills-animated">
		<button class="pill-tab active" data-page="1">Evenement</button>
		<button class="pill-tab" data-page="2">Participation</button>
		<button class="pill-tab" data-page="3">Page 3</button>
		<button class="pill-tab" data-page="4">Page 4</button>
	</div>
</div>
<div id="evenement-content" class="evenement-content" style="margin-top: 1.5rem;">
		<div class="evenement-page-content" data-page="1">
			<div class="liquid-glass-table-container">
				<h3 style="margin-bottom:1.5rem;">Evenements</h3>
				<div class="evenement-table-toolbar" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
					<div style="display: flex; align-items: center;">
						<button class="evenement-btn-add-db" title="Add Evenement"><i class="bx bx-plus"></i> Add Evenement</button>
					</div>
					<div style="display: flex; gap: 0.7rem; align-items: center;">
						<button class="evenement-sort-dir-pill" id="evenement-sort-dir-pill" title="Toggle Sort Direction" aria-label="Toggle Sort Direction">
							<span id="evenement-sort-dir-icon-svg"></span>
						</button>
						<div class="evenement-sort-pill" id="evenement-sort-pill-custom" tabindex="0">
							<span class="evenement-sort-selected" id="evenement-sort-selected">Sort by Date</span>
							<span class="evenement-sort-arrow"></span>
							<div class="evenement-sort-dropdown" id="evenement-sort-dropdown" style="display:none;">
								<div class="evenement-sort-option" data-value="date">Sort by Date</div>
								<div class="evenement-sort-option" data-value="bg">Sort by Title</div>
								<div class="evenement-sort-option" data-value="type">Sort by Type</div>
								<div class="evenement-sort-option" data-value="status">Sort by Status</div>
							</div>
						</div>
						<div class="evenement-search-pill">
							<input type="text" class="evenement-search-input" placeholder="Search evenement..." title="Search evenement..." />
							<i class="bx bx-search evenement-search-icon"></i>
						</div>
					</div>
				</div>
				<div class="liquid-glass-table-scroll">
					<table class="liquid-glass-table" id="evenement-table">
						<thead>
							<tr>
								<th>Title</th>
								<th>Date</th>
								<th>Location</th>
								<th>Type</th>
								<th>Status</th>
								<th>Host</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody id="evenement-table-body">
							<!-- Table rows will be rendered by JS -->
						</tbody>
					</table>
				</div>
				<div class="table-pagination-bar">
					<button class="evenement-table-arrow" id="evenement-table-prev" title="Previous Page"><i class="bx bx-chevron-left"></i></button>
					<div class="evenement-table-pages" id="evenement-table-pages"></div>
					<button class="evenement-table-arrow" id="evenement-table-next" title="Next Page"><i class="bx bx-chevron-right"></i></button>
				</div>
			</div>
			<script>
				// Evenement data from controller
				const evenementData = [
				{% for e in evenements|default([]) %}
				[
					"{{ e.titreEvent|e('js') }}",
					"{{ e.dateEvent|date('Y-m-d H:i') }}",
					"{{ e.lieuEvent|e('js') }}",
					"{{ e.typeEvent|e('js') }}",
					"{{ e.statutEvent|e('js') }}",
					"{{ e.user ? (e.user.firstName ~ ' ' ~ e.user.lastName)|e('js') : '—' }}",
					"{{ e.id }}",
					"{{ e.descriptionEvent|e('js') }}",
					"{{ e.dateEvent|date('Y-m-d H:i') }}",
					"{{ e.nbPlaces }}",
					"{{ e.nbRestants }}",
					"{{ e.imageEvent|e('js') }}"
				]{% if not loop.last %},{% endif %}
				{% endfor %}
				];

				const evenementRowsPerPage = 10;
				let evenementCurrentPage = 1;
				let evenementSortValue = 'date';
				let evenementSortDirection = 'desc'; // Default to newest first
				let evenementFilteredRows = [...evenementData];
				
				const evenementSearchInput = document.querySelector('.evenement-search-input');
				const evenementSortDirBtn = document.getElementById('evenement-sort-dir-pill');
				const evenementSortDirIconSvg = document.getElementById('evenement-sort-dir-icon-svg');
				const evenementSortPill = document.getElementById('evenement-sort-pill-custom');
				const evenementSortDropdown = document.getElementById('evenement-sort-dropdown');
				const evenementSortSelected = document.getElementById('evenement-sort-selected');
				
				function updateEvenementSortDirIcon() {
					evenementSortDirIconSvg.innerHTML = evenementSortDirection === 'asc'
						? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 15 12 9 18 15" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`
						: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 9 12 15 18 9" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
				}
				
				function evenementFilterAndSortRows() {
					let rows = [...evenementData];
					const search = evenementSearchInput.value.trim().toLowerCase();
					
					if (search) {
						rows = rows.filter(row => 
							row[0].toLowerCase().includes(search) || // Title
							row[2].toLowerCase().includes(search) || // Location
							row[3].toLowerCase().includes(search)    // Type
						);
					}
					
					// Sort indices: 0=Title, 1=Date, 2=Location, 3=Type, 4=Status, 5=Host
					let sortIdx = 1; // Default Date
					if (evenementSortValue === 'bg') sortIdx = 0; // Title (using 'bg' from prev example logic but keeping it consistent)
					else if (evenementSortValue === 'type') sortIdx = 3;
					else if (evenementSortValue === 'status') sortIdx = 4;
					else if (evenementSortValue === 'date') sortIdx = 1;
					
					rows.sort((a, b) => {
						let valA = a[sortIdx].toLowerCase();
						let valB = b[sortIdx].toLowerCase();
						if (evenementSortDirection === 'asc') return valA.localeCompare(valB);
						else return valB.localeCompare(valA);
					});
					
					evenementFilteredRows = rows;
					evenementCurrentPage = 1;
					updateEvenementTablePagination();
				}
				
				function renderEvenementTablePage(page) {
					const tbody = document.getElementById('evenement-table-body');
					tbody.innerHTML = '';
					
					if (evenementFilteredRows.length === 0) {
						 const row = document.createElement('tr');
						 row.innerHTML = '<td colspan="7" style="padding: 2rem; opacity: 0.7;">No events found.</td>';
						 tbody.appendChild(row);
						 return;
					}

					const start = (page-1)*evenementRowsPerPage;
					const end = Math.min(start+evenementRowsPerPage, evenementFilteredRows.length);
					
					for (let r = start; r < end; r++) {
						const row = document.createElement('tr');
						const data = evenementFilteredRows[r];
						
						// Title
						const tdTitle = document.createElement('td');
						tdTitle.style.fontWeight = "600";
						tdTitle.textContent = data[0];
						row.appendChild(tdTitle);
						
						// Date
						const tdDate = document.createElement('td');
						tdDate.textContent = data[1];
						row.appendChild(tdDate);

						// Location
						const tdLoc = document.createElement('td');
						tdLoc.textContent = data[2];
						row.appendChild(tdLoc);
						
						// Type
						const tdType = document.createElement('td');
						tdType.innerHTML = `<span class="badge" style="background:rgba(0,198,255,0.15); color:#00c6ff; padding:0.25rem 0.6rem; border-radius:12px; font-size:0.85rem;">${data[3]}</span>`;
						row.appendChild(tdType);
						
						// Status
						const tdStatus = document.createElement('td');
						let statusColor = '#2ecc71'; // planifie (green)
						if(data[4] === 'en_cours') statusColor = '#f1c40f';
						else if(data[4] === 'termine') statusColor = '#95a5a6';
						else if(data[4] === 'annule') statusColor = '#e74c3c';
						
						tdStatus.innerHTML = `<span style="color:${statusColor}; font-weight:600;">${data[4]}</span>`;
						row.appendChild(tdStatus);
						
						// Host
						const tdHost = document.createElement('td');
						tdHost.textContent = data[5];
						row.appendChild(tdHost);

						// Actions - View Details pill
						const tdActions = document.createElement('td');
						tdActions.innerHTML = `
							<button class="evenement-btn-modify evenement-view-btn" 
									data-event-id="${data[6]}"
									title="View Details" 
									style="padding: 0.35rem 1.25rem; font-size: 0.9rem;">
								<i class="bx bx-show"></i> View Details
							</button>
						`;
						row.appendChild(tdActions);
						
						tbody.appendChild(row);
					}
				}
				
				function renderEvenementTablePagination() {
					const totalPages = Math.ceil(evenementFilteredRows.length / evenementRowsPerPage);
					const pagesDiv = document.getElementById('evenement-table-pages');
					pagesDiv.innerHTML = '';
					for (let i = 1; i <= totalPages; i++) {
						const btn = document.createElement('button');
						btn.className = 'evenement-table-page-btn' + (i === evenementCurrentPage ? ' active' : '');
						btn.textContent = i;
						btn.onclick = () => { evenementCurrentPage = i; updateEvenementTablePagination(); };
						pagesDiv.appendChild(btn);
					}
					document.getElementById('evenement-table-prev').disabled = evenementCurrentPage === 1;
					document.getElementById('evenement-table-next').disabled = evenementCurrentPage === totalPages;
				}
				
				function updateEvenementTablePagination() {
					renderEvenementTablePage(evenementCurrentPage);
					renderEvenementTablePagination();
				}
				
				document.addEventListener('DOMContentLoaded', function() {
					updateEvenementSortDirIcon();
					updateEvenementTablePagination();
					
					evenementSearchInput.addEventListener('input', evenementFilterAndSortRows);
					
					evenementSortDirBtn.addEventListener('click', function() {
						evenementSortDirection = (evenementSortDirection === 'asc') ? 'desc' : 'asc';
						updateEvenementSortDirIcon();
						evenementFilterAndSortRows();
					});
					
					// Users-style pagination arrow logic
					document.getElementById('evenement-table-prev').onclick = function() {
						if (evenementCurrentPage > 1) { evenementCurrentPage--; updateEvenementTablePagination(); }
					};
					document.getElementById('evenement-table-next').onclick = function() {
						const totalPages = Math.ceil(evenementFilteredRows.length / evenementRowsPerPage);
						if (evenementCurrentPage < totalPages) { evenementCurrentPage++; updateEvenementTablePagination(); }
					};
					
					function closeEvenementSortDropdown() {
						if (evenementSortDropdown) {
							evenementSortDropdown.style.display = 'none';
							evenementSortPill.classList.remove('open');
						}
					}

					evenementSortPill.addEventListener('click', function(e) {
						e.stopPropagation();
						if (evenementSortDropdown.style.display === 'flex') {
							closeEvenementSortDropdown();
						} else {
							evenementSortDropdown.style.display = 'flex';
							evenementSortPill.classList.add('open');
						}
					});
					
					document.querySelectorAll('.evenement-sort-option').forEach(opt => {
						opt.addEventListener('click', function(e) {
							e.stopPropagation(); // Prevent bubbling
							evenementSortValue = this.getAttribute('data-value');
							evenementSortSelected.textContent = this.textContent;
							document.querySelectorAll('.evenement-sort-option').forEach(o => o.classList.remove('active'));
							this.classList.add('active');
							closeEvenementSortDropdown();
							evenementFilterAndSortRows();
						});
					});
					
					document.addEventListener('click', function(e) {
						if (!evenementSortPill.contains(e.target)) {
							closeEvenementSortDropdown();
						}
					});
					
					// --- CUSTOM CONFIRMATION MODAL LOGIC ---
					const customConfirmModal = document.getElementById('custom-confirm-modal');
					const confirmTitle = document.getElementById('confirm-title');
					const confirmText = document.getElementById('confirm-text');
					const confirmBtnCancel = document.getElementById('confirm-btn-cancel');
					const confirmBtnConfirm = document.getElementById('confirm-btn-confirm');
					let confirmCallback = null;

					function showCustomConfirm(title, message, callback) {
						confirmTitle.textContent = title;
						confirmText.textContent = message;
						confirmCallback = callback;
						if (customConfirmModal) customConfirmModal.style.display = 'flex';
					}

					function closeCustomConfirm() {
						if (customConfirmModal) customConfirmModal.style.display = 'none';
						confirmCallback = null;
					}

					if (confirmBtnCancel) confirmBtnCancel.addEventListener('click', closeCustomConfirm);
					if (confirmBtnConfirm) {
						confirmBtnConfirm.addEventListener('click', function() {
							if (confirmCallback) confirmCallback();
							closeCustomConfirm();
						});
					}
					if (customConfirmModal) {
						customConfirmModal.querySelector('.users-edit-modal-backdrop').addEventListener('click', closeCustomConfirm);
					}

					// --- EVENEMENT VIEW MODAL LOGIC ---
					const evenementViewModal = document.getElementById('evenement-view-modal');
					const evenementViewCloseBtn = document.getElementById('evenement-view-modal-close');
					const evenementViewCloseBtnBottom = document.getElementById('evenement-view-close-btn');
					const evenementViewDeleteForm = document.getElementById('view-evenement-delete-form');

					window.openEvenementViewModal = function(id) {
						const data = evenementData.find(e => e[6] == id);
						if (!data) return;

						document.getElementById('view-evenement-title').textContent = data[0];
						document.getElementById('view-evenement-date').textContent = data[1];
						document.getElementById('view-evenement-location').textContent = data[2];
						document.getElementById('view-evenement-type').textContent = data[3];
						document.getElementById('view-evenement-status').textContent = data[4];
						document.getElementById('view-evenement-host').textContent = data[5];

						// Set ID for modify button and delete form
						document.getElementById('view-evenement-modify-btn').setAttribute('data-id', id);
                        
                        if (evenementViewDeleteForm) {
                            evenementViewDeleteForm.setAttribute('data-id', id);
                            // Populate CSRF token
                            const tokenEl = document.getElementById('view-evenement-delete-token');
                            if (tokenEl) tokenEl.value = '{{ csrf_token("evenement_delete") }}';
                        }

						if (evenementViewModal) evenementViewModal.style.display = 'flex';
					};

					window.closeEvenementViewModal = function() {
						if (evenementViewModal) evenementViewModal.style.display = 'none';
					};

					if (evenementViewCloseBtn) evenementViewCloseBtn.addEventListener('click', window.closeEvenementViewModal);
					if (evenementViewCloseBtnBottom) evenementViewCloseBtnBottom.addEventListener('click', window.closeEvenementViewModal);
					if (evenementViewModal) {
						evenementViewModal.querySelector('.users-edit-modal-backdrop').addEventListener('click', window.closeEvenementViewModal);
					}

					// Event delegation for View Details buttons
					document.addEventListener('click', function(e) {
						const viewBtn = e.target.closest('.evenement-view-btn');
						if (viewBtn) {
							e.preventDefault();
							e.stopPropagation();
							const id = viewBtn.getAttribute('data-event-id');
							if (id) {
								window.openEvenementViewModal(id);
							}
							return false;
						}
					});
				});
			</script>
<style>
