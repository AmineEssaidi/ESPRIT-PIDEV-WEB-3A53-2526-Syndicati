{% extends 'base.html.twig' %}

{% block title %}Evenement - Liquid Glass Admin{% endblock %}

{% block stylesheets %}
<style>
/* Light theme improvements copied from Users */
[data-theme="light"] .liquid-glass-table-container {
    background: rgba(255,255,255,0.85);
    border: 1.5px solid #e3e8f7;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
}

[data-theme="light"] .liquid-glass-table {
    background: rgba(255,255,255,0.98);
    color: #23272f;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

[data-theme="light"] .liquid-glass-table th {
    background: #f5f7fa;
    color: #23272f;
}

[data-theme="light"] .liquid-glass-table td {
    background: transparent;
    color: #23272f;
}

[data-theme="light"] .evenement-btn-add-db {
    background: linear-gradient(90deg, #00bfae 0%, #00e676 100%);
    color: #fff;
    box-shadow: 0 2px 8px rgba(0,230,118,0.08);
}

[data-theme="light"] .evenement-btn-add-db:hover {
    background: linear-gradient(90deg, #00e676 0%, #00bfae 100%);
}

[data-theme="light"] .evenement-btn-modify {
    background: linear-gradient(90deg, #0072ff 0%, #00c6ff 100%);
    color: #fff;
}

[data-theme="light"] .evenement-btn-delete {
    background: linear-gradient(90deg, #ff2d92 0%, #ff3b30 100%);
    color: #fff;
}

[data-theme="light"] .evenement-pagination-pills {
    background: linear-gradient(135deg, #f5f7fa 80%, #e3e8f7 100%);
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

[data-theme="light"] .pill-tab {
    color: #23272f;
}

[data-theme="light"] .pill-tab.active,
[data-theme="light"] .pill-tab:focus {
    color: #fff;
    text-shadow: 0 2px 8px rgba(0,123,255,0.10);
}

[data-theme="light"] .pill-slider {
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    box-shadow: 0 4px 16px rgba(0,123,255,0.10);
}

[data-theme="light"] .evenement-sort-dir-pill {
    background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
    color: #23272f;
}

[data-theme="light"] .evenement-sort-dir-icon svg polyline {
    stroke: #0072ff;
}

[data-theme="light"] .evenement-sort-pill {
    background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
}

[data-theme="light"] .evenement-search-pill {
    background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
}

[data-theme="light"] .evenement-search-input {
    color: #23272f;
}

[data-theme="light"] .evenement-search-icon {
    color: #0072ff;
}

[data-theme="light"] .table-pagination-bar {
    background: transparent;
}

[data-theme="light"] .evenement-table-arrow {
    background: #fff;
    color: #0072ff;
    border: 1px solid #e3e8f7;
}

[data-theme="light"] .evenement-table-arrow svg polyline {
    stroke: #0072ff;
}

[data-theme="light"] .evenement-table-page-btn {
    background: #fff;
    color: #23272f;
    border: 1px solid #e3e8f7;
}

[data-theme="light"] .evenement-table-page-btn.active,
[data-theme="light"] .evenement-table-page-btn:hover {
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    color: #fff;
    border: none;
}

/* Users-style updown arrow pill CSS for Evenement */
[data-theme="light"] .evenement-sort-dir-pill {
    background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
    color: #23272f;
}

[data-theme="light"] .evenement-sort-dir-icon svg polyline {
    stroke: #0072ff;
}

.evenement-sort-dir-pill {
    background: linear-gradient(90deg, #2a2e39 0%, #23272f 100%);
    border: none;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
    outline: none;
    font-size: 1.1rem;
    color: #fff;
}

.evenement-sort-dir-pill:active,
.evenement-sort-dir-pill:focus {
    background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
}

.evenement-sort-dir-icon {
    font-size: 1.2rem;
    color: #bfc9d8;
}

/* Light theme improvements for search, sort, arrow pills from Users */
[data-theme="light"] .evenement-sort-dir-pill {
    background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
    color: #23272f;
}

[data-theme="light"] .evenement-sort-dir-icon svg polyline {
    stroke: #0072ff;
}

[data-theme="light"] .evenement-sort-pill {
    background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
    color: #fff !important;
    box-shadow: 0 2px 8px rgba(0,123,255,0.08);
}

[data-theme="light"] .evenement-search-pill {
    background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
}

[data-theme="light"] .evenement-search-input {
    color: #23272f;
}

[data-theme="light"] .evenement-search-icon {
    color: #0072ff;
}

/* Users-style arrow, sort pill, search bar, and dropdown CSS for Evenement */
.evenement-search-pill {
    display: flex;
    align-items: center;
    background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
    border-radius: 999px;
    padding: 0.3rem 1.1rem 0.3rem 1.1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    position: relative;
}

.evenement-search-input {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1rem;
    outline: none;
    width: 160px;
    padding: 0.2rem 0.5rem 0.2rem 0;
}

.evenement-search-icon {
    color: #bfc9d8;
    font-size: 1.2rem;
    margin-left: 0.3rem;
}

.evenement-sort-pill {
    position: relative;
    z-index: 20;
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    border-radius: 999px;
    padding: 0.3rem 1.1rem;
    box-shadow: 0 2px 8px rgba(0,123,255,0.10);
    display: flex;
    align-items: center;
    min-width: 160px;
    cursor: pointer;
    user-select: none;
    color: #fff;
    transition: background 0.18s, color 0.18s;
    overflow: visible;
}

[data-theme="light"] .evenement-sort-pill {
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    color: #fff !important;
    box-shadow: 0 2px 8px rgba(0,123,255,0.08);
}

.evenement-sort-selected {
    flex: 1;
    font-size: 1rem;
    font-weight: 600;
    padding-right: 1.2rem;
}

.evenement-sort-arrow {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    background: url("data:image/svg+xml;utf8,<svg fill='white' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><polyline points='6 9 12 15 18 9' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' fill='none'/></svg>") no-repeat center/contain;
    margin-left: -1.1em;
    pointer-events: none;
}

.evenement-sort-pill::after {
    display: none !important;
}

.evenement-sort-dropdown {
    position: absolute;
    left: 0;
    top: 110%;
    min-width: 100%;
    background: rgba(30, 60, 120, 0.85);
    border-radius: 1.2em;
    box-shadow: 0 8px 32px rgba(0,198,255,0.18);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    z-index: 10;
    padding: 0.3em 0;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    animation: evenement-sort-dropdown-fade 0.18s cubic-bezier(.4,1.4,.6,1) both;
}

@keyframes evenement-sort-dropdown-fade {
    0% {
        opacity: 0;
        transform: translateY(-10px) scale(0.98);
    }
    100% {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.evenement-sort-option {
    padding: 0.7em 1.5em;
    border-radius: 1em;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.13s, color 0.13s;
}

.evenement-sort-option:hover,
.evenement-sort-option.active {
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    color: #fff;
}

[data-theme="light"] .evenement-sort-dropdown {
    background: rgba(255,255,255,0.95);
    box-shadow: 0 8px 32px rgba(0,198,255,0.13);
}

[data-theme="light"] .evenement-sort-option {
    color: #0072ff;
}

[data-theme="light"] .evenement-sort-option:hover,
[data-theme="light"] .evenement-sort-option.active {
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    color: #fff;
}
</style>
{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Evenement' } %}

<div class="evenement-pagination-wrapper" style="margin-top: 2rem;">
    <div class="evenement-pagination-pills pills-animated">
        <div class="pill-slider-bar"><div class="pill-slider"></div></div>
        <button class="pill-tab active" data-page="1">Page 1</button>
        <button class="pill-tab" data-page="2">Page 2</button>
        <button class="pill-tab" data-page="3">Page 3</button>
        <button class="pill-tab" data-page="4">Page 4</button>
    </div>
</div>

<div id="evenement-content" class="evenement-content" style="margin-top: 1.5rem;">
    <div class="evenement-page-content" data-page="1">
        <div class="liquid-glass-table-container">
            <h3 style="margin-bottom:1.5rem">Demo Evenement Table (Page 1)</h3>

            <div class="evenement-table-toolbar" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
                <div style="display: flex; align-items: center;">
                    <button class="evenement-btn-add-db" title="Add Evenement">
                        <i class="bx bx-plus"></i> Add Evenement
                    </button>
                </div>

                <div style="display: flex; gap: 0.7rem; align-items: center;">
                    <button class="evenement-sort-dir-pill" id="evenement-sort-dir-pill" title="Toggle Sort Direction" aria-label="Toggle Sort Direction">
                        <span id="evenement-sort-dir-icon-svg"></span>
                    </button>

                    <div class="evenement-sort-pill" id="evenement-sort-pill-custom" tabindex="0" style="position:relative;">
                        <span class="evenement-sort-selected" id="evenement-sort-selected">Sort by Name</span>
                        <span class="evenement-sort-arrow"></span>
                        <div class="evenement-sort-dropdown" id="evenement-sort-dropdown" style="display:none; position:absolute; left:0; top:110%; min-width:100%;">
                            <div class="evenement-sort-option" data-value="name">Sort by Name</div>
                            <div class="evenement-sort-option" data-value="email">Sort by Email</div>
                            <div class="evenement-sort-option" data-value="date">Sort by Date</div>
                            <div class="evenement-sort-option" data-value="status">Sort by Status</div>
                        </div>
                    </div>

                    <div class="evenement-search-pill">
                        <input type="text" class="evenement-search-input" placeholder="Search evenement..." title="Search evenement...">
                        <i class="bx bx-search evenement-search-icon"></i>
                    </div>
                </div>
            </div>

            <div class="liquid-glass-table-scroll">
                <table class="liquid-glass-table" id="evenement-table">
                    <thead>
                        <tr>
                            {% for col in 1..8 %}
                            <th>Col {{ col }}</th>
                            {% endfor %}
                            <th>Modify</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody id="evenement-table-body">
                        <!-- Table rows will be rendered by JS -->
                    </tbody>
                </table>
            </div>

            <div class="table-pagination-bar">
                <button class="evenement-table-arrow" id="evenement-table-prev" title="Previous Page">
                    <i class="bx bx-chevron-left"></i>
                </button>
                <div class="evenement-table-pages" id="evenement-table-pages"></div>
                <button class="evenement-table-arrow" id="evenement-table-next" title="Next Page">
                    <i class="bx bx-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="evenement-page-content" data-page="2" style="display:none">
        <div class="evenement-list-demo">
            <h3 style="margin-bottom:1rem">Demo Evenements (Page 2)</h3>
            <ul style="list-style:none;padding:0">
                <li style="padding:0.5rem 0;border-bottom:1px solid #eee">Evenement Alpha</li>
                <li style="padding:0.5rem 0;border-bottom:1px solid #eee">Evenement Beta</li>
                <li style="padding:0.5rem 0">Evenement Gamma</li>
            </ul>
        </div>
    </div>

    <div class="evenement-page-content" data-page="3" style="display:none">
        <div class="evenement-list-demo">
            <h3 style="margin-bottom:1rem">Demo Evenements (Page 3)</h3>
            <ul style="list-style:none;padding:0">
                <li style="padding:0.5rem 0;border-bottom:1px solid #eee">Evenement Delta</li>
                <li style="padding:0.5rem 0">Evenement Epsilon</li>
            </ul>
        </div>
    </div>

    <div class="evenement-page-content" data-page="4" style="display:none">
        <div class="evenement-list-demo">
            <h3 style="margin-bottom:1rem">Demo Evenements (Page 4)</h3>
            <ul style="list-style:none;padding:0">
                <li style="padding:0.5rem 0">Evenement Zeta</li>
            </ul>
        </div>
    </div>
</div>

<style>
.evenement-pagination-pills {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    margin: 0 auto;
    padding: 0.25rem 0.5rem;
    background: linear-gradient(135deg, #23272f 80%, #2a2e39 100%);
    border-radius: 999px;
    min-width: 340px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    width: fit-content;
}

.pill-slider-bar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: transparent;
    z-index: 0;
    pointer-events: none;
}

.pill-slider {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 40px;
    width: 0;
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    border-radius: 999px;
    z-index: 2;
    transition: left 0.35s cubic-bezier(0.4,0,0.2,1), width 0.35s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 4px 16px rgba(0,123,255,0.15);
    pointer-events: none;
    opacity: 1;
}

.pill-tab {
    background: transparent;
    color: #bfc9d8;
    border: none;
    border-radius: 999px;
    padding: 0.5rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s, box-shadow 0.2s;
    box-shadow: none;
    outline: none;
    position: relative;
    z-index: 3;
}

.pill-tab.active,
.pill-tab:focus {
    color: #fff;
    text-shadow: 0 2px 8px rgba(0,123,255,0.10);
    z-index: 3;
}
</style>

<style>
.table-pagination-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.2rem;
    margin: 1.5rem 0 0.5rem 0;
}

.evenement-table-arrow {
    background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    cursor: pointer;
    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
    outline: none;
}

.evenement-table-arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.evenement-table-pages {
    display: flex;
    gap: 0.5rem;
}

.evenement-table-page-btn {
    background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
    outline: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.evenement-table-page-btn.active,
.evenement-table-page-btn:hover {
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    color: #fff;
    box-shadow: 0 4px 16px rgba(0,123,255,0.10);
}

.evenement-btn-add-db {
    border: none;
    border-radius: 999px;
    padding: 0.5rem 1.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
    outline: none;
    margin: 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-content: center;
    background: linear-gradient(90deg, #00e676 0%, #00bfae 100%);
    color: #fff;
    box-shadow: 0 2px 8px rgba(0,230,118,0.10);
}

.evenement-btn-add-db:hover {
    background: linear-gradient(90deg, #00bfae 0%, #00e676 100%);
    color: #fff;
}

.liquid-glass-table-container {
    background: rgba(30, 34, 44, 0.7);
    border-radius: 24px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
    backdrop-filter: blur(18px) saturate(180%);
    padding: 2.5rem 3rem 2rem 3rem;
    margin: 0 auto 2rem auto;
    max-width: 1600px;
    border: 1.5px solid rgba(255,255,255,0.08);
    position: relative;
}

.liquid-glass-table-scroll {
    overflow-x: auto;
}

.liquid-glass-table {
    min-width: 1400px;
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: rgba(255,255,255,0.04);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.10);
    font-size: 1rem;
    color: #e3e8f7;
}

.liquid-glass-table th,
.liquid-glass-table td {
    padding: 0.75rem 1.1rem;
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(8px);
    vertical-align: middle;
    word-break: break-word;
    white-space: normal;
    max-width: 180px;
}

.liquid-glass-table td {
    display: table-cell;
    text-align: center;
    vertical-align: middle;
}

.liquid-glass-table th {
    background: rgba(255,255,255,0.10);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
    border-top: none;
    text-align: center;
    vertical-align: middle;
}

.liquid-glass-table tr:last-child td {
    border-bottom: none;
}

.evenement-btn-modify,
.evenement-btn-delete {
    border: none;
    border-radius: 999px;
    padding: 0.4rem 1.1rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
    outline: none;
    margin: 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
}

.evenement-btn-modify {
    background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
    color: #fff;
    box-shadow: 0 2px 8px rgba(0,123,255,0.10);
}

.evenement-btn-modify:hover {
    background: linear-gradient(90deg, #0072ff 0%, #00c6ff 100%);
    color: #fff;
}

.evenement-btn-delete {
    background: linear-gradient(90deg, #ff3b30 0%, #ff2d92 100%);
    color: #fff;
    box-shadow: 0 2px 8px rgba(255,59,48,0.10);
}

.evenement-btn-delete:hover {
    background: linear-gradient(90deg, #ff2d92 0%, #ff3b30 100%);
    color: #fff;
}

.liquid-glass-table i.bx {
    font-size: 1.1em;
    vertical-align: middle;
}
</style>

<script>
// --- Demo data: 35 rows, 8 columns ---
const evenementDemoTableRows = Array.from({length: 35}, (_, r) => 
    Array.from({length: 8}, (_, c) => `R${r+1}C${c+1}`)
);

const evenementRowsPerPage = 10;
let evenementCurrentPage = 1;
let evenementSortValue = 'name';
let evenementSortDirection = 'asc';
let evenementFilteredRows = [...evenementDemoTableRows];

const evenementSearchInput = document.querySelector('.evenement-search-input');
const evenementSortDirBtn = document.getElementById('evenement-sort-dir-pill');
const evenementSortDirIconSvg = document.getElementById('evenement-sort-dir-icon-svg');
const evenementSortPill = document.getElementById('evenement-sort-pill-custom');
const evenementSortDropdown = document.getElementById('evenement-sort-dropdown');
const evenementSortSelected = document.getElementById('evenement-sort-selected');

function updateEvenementSortDirIcon() {
    evenementSortDirIconSvg.innerHTML = evenementSortDirection === 'asc' 
        ? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 15 12 9 18 15" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`
        : `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 9 12 15 18 9" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
}

function evenementFilterAndSortRows() {
    let rows = [...evenementDemoTableRows];

    const search = evenementSearchInput.value.trim().toLowerCase();
    if (search) {
        rows = rows.filter(row => row.some(cell => cell.toLowerCase().includes(search)));
    }

    if (evenementSortValue === 'name') {
        rows.sort((a, b) => evenementSortDirection === 'asc' ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]));
    } else if (evenementSortValue === 'email') {
        rows.sort((a, b) => evenementSortDirection === 'asc' ? a[1].localeCompare(b[1]) : b[1].localeCompare(a[1]));
    } else if (evenementSortValue === 'date') {
        rows.sort((a, b) => evenementSortDirection === 'asc' ? a[2].localeCompare(b[2]) : b[2].localeCompare(a[2]));
    } else if (evenementSortValue === 'status') {
        rows.sort((a, b) => evenementSortDirection === 'asc' ? a[3].localeCompare(b[3]) : b[3].localeCompare(a[3]));
    }

    evenementFilteredRows = rows;
    evenementCurrentPage = 1;
    updateEvenementTablePagination();
}

function renderEvenementTablePage(page) {
    const tbody = document.getElementById('evenement-table-body');
    tbody.innerHTML = '';

    const start = (page - 1) * evenementRowsPerPage;
    const end = Math.min(start + evenementRowsPerPage, evenementFilteredRows.length);

    for (let r = start; r < end; r++) {
        const row = document.createElement('tr');

        for (let c = 0; c < 8; c++) {
