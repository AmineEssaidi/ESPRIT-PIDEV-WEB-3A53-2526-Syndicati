{% block javascripts %}
   {{ parent() }}
    <!-- PREMIUM COOL POPUP SYSTEM -->
    <div id="coolPopup" class="cool-popup-overlay">
        <div class="cool-popup-glow-1"></div>
        <div class="cool-popup-glow-2"></div>
        <div class="cool-popup-content">
            <div id="coolPopupIcon" class="cool-popup-icon"></div>
            <h2 id="coolPopupTitle" class="cool-popup-title"></h2>
            <p id="coolPopupMessage" class="cool-popup-message"></p>
            
            <div id="coolPopupActions" class="cool-popup-actions">
                <!-- Buttons will be injected here -->
            </div>
        </div>
    </div>

    <style>
        .cool-popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 12, 16, 0.7);
            backdrop-filter: blur(8px); /* Reduced from 25px for performance */
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 30000;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .cool-popup-overlay.show {
            display: flex;
            opacity: 1;
        }

        .cool-popup-glow-1 {
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(0, 198, 255, 0.1) 0%, transparent 70%);
            top: 25%;
            left: 25%;
            filter: blur(40px);
            z-index: 1;
        }

        .cool-popup-glow-2 {
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(0, 114, 255, 0.1) 0%, transparent 70%);
            bottom: 25%;
            right: 25%;
            filter: blur(40px);
            z-index: 1;
        }

        .cool-popup-content {
            background: rgba(255, 255, 255, 0.05); /* Slightly more opaque glass */
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px); /* Localized blur is faster usually */
            padding: 3.5rem 2.5rem;
            border-radius: 35px;
            text-align: center;
            max-width: 480px;
            width: 90%;
            transform: scale(0.95);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            z-index: 10;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255,255,255,0.05);
        }

        .cool-popup-overlay.show .cool-popup-content {
            transform: scale(1) translateY(0);
        }

        .cool-popup-icon {
            font-size: 6rem;
            margin-bottom: 2rem;
            filter: drop-shadow(0 0 20px rgba(0, 198, 255, 0.3));
            animation: iconFloat 3s ease-in-out infinite;
        }

        @keyframes iconFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .cool-popup-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 900;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
            letter-spacing: -0.03em;
            background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.6) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .cool-popup-message {
            color: rgba(255, 255, 255, 0.65);
            font-size: 1.2rem;
            line-height: 1.7;
            margin-bottom: 3rem;
            font-weight: 500;
        }

        .cool-popup-actions {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
        }

        .cool-popup-btn {
            border: none;
            padding: 1.2rem 2.5rem;
            border-radius: 20px;
            font-weight: 800;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .cool-popup-btn-primary {
            background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
            color: white;
            box-shadow: 0 15px 35px -10px rgba(0, 114, 255, 0.5);
        }

        .cool-popup-btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .cool-popup-btn-danger {
            background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
            color: white;
            box-shadow: 0 15px 35px -10px rgba(255, 75, 43, 0.5);
        }

        .cool-popup-btn:hover {
            transform: translateY(-5px) scale(1.02);
        }
    </style>

    <script>
        function showCoolPopup(title, message, type = 'success', onConfirm = null) {
            const popup = document.getElementById('coolPopup');
            const icon = document.getElementById('coolPopupIcon');
            const titleEl = document.getElementById('coolPopupTitle');
            const msgEl = document.getElementById('coolPopupMessage');
            const actionsEl = document.getElementById('coolPopupActions');

            if(!popup || !icon || !titleEl || !msgEl || !actionsEl) return;

            titleEl.textContent = title;
            msgEl.innerHTML = message;
            actionsEl.innerHTML = ''; // Clear prior buttons

            if (type === 'success') {
                icon.innerHTML = "<i class='bx bxs-check-shield' style='color: #00d2ff;'></i>";
            } else if (type === 'error') {
                icon.innerHTML = "<i class='bx bxs-error-circle' style='color: #ff4d4d;'></i>";
            } else if (type === 'confirm') {
                icon.innerHTML = "<i class='bx bxs-help-circle' style='color: #ffcc00;'></i>";
            }

            if (type === 'confirm') {
                // Add Cancel Button
                const cancelBtn = document.createElement('button');
                cancelBtn.className = 'cool-popup-btn cool-popup-btn-secondary';
                cancelBtn.textContent = 'Cancel';
                cancelBtn.onclick = closeCoolPopup;
                actionsEl.appendChild(cancelBtn);

                // Add Confirm/Delete Button
                const confirmBtn = document.createElement('button');
                confirmBtn.className = 'cool-popup-btn cool-popup-btn-danger';
                confirmBtn.textContent = 'Confirm Delete';
                confirmBtn.onclick = () => {
                    closeCoolPopup();
                    if (onConfirm) onConfirm();
                };
                actionsEl.appendChild(confirmBtn);
            } else {
                // Single "Got it" Button for alerts
                const okBtn = document.createElement('button');
                okBtn.className = 'cool-popup-btn cool-popup-btn-primary';
                okBtn.textContent = 'Got it';
                okBtn.onclick = closeCoolPopup;
                actionsEl.appendChild(okBtn);
            }

            popup.style.display = 'flex';
            setTimeout(() => popup.classList.add('show'), 10);
        }

        function closeCoolPopup() {
            const popup = document.getElementById('coolPopup');
            if(!popup) return;
            popup.classList.remove('show');
            setTimeout(() => popup.style.display = 'none', 400);
        }
    </script>
{% endblock %}
