					</div>
					<div style="display: flex; gap: 0.7rem; align-items: center;">
						<button class="evenement-sort-dir-pill" id="participation-sort-dir-pill" title="Toggle Sort Direction" aria-label="Toggle Sort Direction">
							<span id="participation-sort-dir-icon-svg"></span>
						</button>
						<div class="evenement-sort-pill" id="participation-sort-pill-custom" tabindex="0">
