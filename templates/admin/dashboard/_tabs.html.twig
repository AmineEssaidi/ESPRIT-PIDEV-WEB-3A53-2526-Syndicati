<style>
    .hover-bump { transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
    .hover-bump:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.6); background: rgba(255,255,255,0.05) !important; z-index: 10; cursor: pointer; }
    .hover-bright { transition: all 0.4s ease; }
    .hover-bright:hover { opacity: 1 !important; transform: scale(1.05); }
    .hover-bright-bg { transition: background 0.2s ease; }
    .hover-bright-bg:hover { background: rgba(255,255,255,0.05) !important; cursor: pointer;}
</style>

{% if module == 'users' %}
    <div class="hz-stat-grid">
        <div class="hz-stat-card hz-stat-blue">
            <div class="hz-stat-icon"><i class='bx bx-group'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Registered Users</p>
                <p class="hz-stat-num">{{ stats.total|default(0) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-blue"></div>
        </div>
        <div class="hz-stat-card hz-stat-green">
            <div class="hz-stat-icon"><i class='bx bx-check-shield'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Verified Accounts</p>
                <p class="hz-stat-num">{{ stats.verified|default(0) }}</p>
                <p class="hz-stat-sub"><span class="hz-pill hz-pill-green">Good standing</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-green"></div>
        </div>
        <div class="hz-stat-card hz-stat-amber">
            <div class="hz-stat-icon"><i class='bx bx-user-pin'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Pending Verification</p>
                <p class="hz-stat-num">{{ max(0, stats.total|default(0) - stats.verified|default(0)) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-amber"></div>
        </div>
        <div class="hz-stat-card hz-stat-purple">
            <div class="hz-stat-icon"><i class='bx bx-pulse'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">7-Day Active Users</p>
                <p class="hz-stat-num">{{ stats.active_this_week|default(0) }}</p>
                <p class="hz-stat-sub"><span style="color:rgba(255,255,255,0.4)">Logged in recently</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-purple"></div>
        </div>
        
        {# Role Breakdown Card #}
        <div class="hz-glass hz-chart-card" style="grid-column: 1 / -1; margin-top: 1rem; padding: 2rem;">
            <h2 class="hz-panel-title" style="margin-bottom: 1.5rem;"><i class='bx bx-shield-quarter' style="color:#00c6ff;margin-right:6px"></i> Role Breakdown</h2>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                {% for role, count in stats.roles|default({}) %}
                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); padding: 1rem 1.5rem; border-radius: 12px; flex: 1; min-width: 150px;">
                    <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); margin-bottom: 0.5rem;">{{ role|replace({'ROLE_': ''})|trim }}</div>
                    <div style="font-size: 1.8rem; font-weight: 800; color: #fff;">{{ count }}</div>
                </div>
                {% else %}
                <p style="color:rgba(255,255,255,0.3)">No role data found.</p>
                {% endfor %}
            </div>
        </div>

        {# Latest Members Card #}
        <div class="hz-glass hz-chart-card" style="grid-column: 1 / -1; margin-top: 1rem; padding: 2rem;">
            <h2 class="hz-panel-title" style="margin-bottom: 1.5rem;"><i class='bx bx-user-plus' style="color:#a78bfa;margin-right:6px"></i> Latest Members</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                {% for user in stats.recent_users|default([]) %}
                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); padding: 1.5rem; border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;" class="hover-bump">
                    <div style="width: 60px; height: 60px; border-radius: 50%; overflow: hidden; border: 2px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05);">
                        <img src="https://ui-avatars.com/api/?name={{ user.first_name }}+{{ user.last_name }}&background=random" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name={{ user.first_name }}'"/>
                    </div>
                    <div style="text-align: center;">
                        <span style="display: block; color: #fff; font-weight: 600;">{{ user.first_name }} {{ user.last_name }}</span>
                        <span style="display: block; color: rgba(255,255,255,0.4); font-size: 0.75rem; text-transform: uppercase;">{{ user.role_user|replace({'ROLE_': ''})|trim }}</span>
                    </div>
                    <div style="margin-top: 0.5rem; font-size: 0.7rem; color: #a78bfa; background: rgba(167, 139, 250, 0.1); padding: 2px 8px; border-radius: 100px;">
                        Joined {{ user.created_at|date('M j') }}
                    </div>
                </div>
                {% else %}
                    <p style="color:rgba(255,255,255,0.3)">No recent users found.</p>
                {% endfor %}
            </div>
        </div>
    </div>

{% elseif module == 'forum' %}
    <div class="hz-stat-grid">
        <div class="hz-stat-card hz-stat-purple">
            <div class="hz-stat-icon"><i class='bx bx-news'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Publications</p>
                <p class="hz-stat-num">{{ stats.publications|default(0) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-purple"></div>
        </div>
        <div class="hz-stat-card hz-stat-blue">
            <div class="hz-stat-icon"><i class='bx bx-conversation'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Comments</p>
                <p class="hz-stat-num">{{ stats.comments|default(0) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-blue"></div>
        </div>
        <div class="hz-stat-card hz-stat-amber">
            <div class="hz-stat-icon"><i class='bx bx-pulse'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Engagement Ratio</p>
                <p class="hz-stat-num">
                    {% if stats.publications|default(0) > 0 %}
                        {{ (stats.comments|default(0) / stats.publications|default(1))|number_format(1) }} <span style="font-size: 1rem; color: rgba(255,255,255,0.5)">avg</span>
                    {% else %}
                        0
                    {% endif %}
                </p>
                <p class="hz-stat-sub"><span class="hz-pill hz-pill-amber">Comments per post</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-amber"></div>
        </div>
        <div class="hz-stat-card hz-stat-green">
            <div class="hz-stat-icon"><i class='bx bx-edit-alt'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Publications Today</p>
                <p class="hz-stat-num">{{ stats.pubs_today|default(0) }}</p>
                <p class="hz-stat-sub"><span style="color:rgba(255,255,255,0.4)">New content</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-green"></div>
        </div>
    </div>
    
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-top: 1.5rem;">
        {# Recent Pubs Masonry/Grid #}
        <div class="hz-glass hz-chart-card" style="padding: 2rem;">
            <h2 class="hz-panel-title" style="margin-bottom: 1.5rem;"><i class='bx bx-images' style="color:#00c6ff;margin-right:6px"></i> Latest Publications</h2>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                {% for pub in stats.recent_pubs|default([]) %}
                    <div style="position: relative; height: 180px; border-radius: 16px; overflow: hidden; background: #1a1a1a;" class="hover-bump">
                        {% if pub.image_pub %}
                            <img src="/forum_images/{{ pub.image_pub }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; transition: opacity 0.3s;" class="hover-bright"/>
                        {% else %}
                            <div style="width: 100%; height: 100%; background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%); display:flex; align-items:center; justify-content:center;">
                                <i class='bx bx-book-content' style="font-size: 3rem; color: rgba(255,255,255,0.1)"></i>
                            </div>
                        {% endif %}
                        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1rem; background: linear-gradient(to top, rgba(0,0,0,0.95), transparent); display: flex; align-items: flex-end; gap: 0.75rem;">
                            <img src="https://ui-avatars.com/api/?name={{ pub.first_name }}+{{ pub.last_name }}&background=random" style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05);" onerror="this.src='https://ui-avatars.com/api/?name={{ pub.first_name }}'"/>
                            <div style="flex: 1; overflow: hidden;">
                                <div style="color: #fff; font-weight: 600; font-size: 0.9rem; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">{{ pub.titre_pub }}</div>
                                <div style="color: rgba(255,255,255,0.5); font-size: 0.7rem;">{{ pub.first_name }} • {{ pub.date_creation_pub|date('M j') }}</div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p style="color:rgba(255,255,255,0.3)">No recent publications found.</p>
                {% endfor %}
            </div>
        </div>

        {# Top Contributors Card #}
        <div class="hz-glass hz-chart-card" style="padding: 2rem;">
            <h2 class="hz-panel-title" style="margin-bottom: 1.5rem;"><i class='bx bxs-star' style="color:#fbbf24;margin-right:6px"></i> Top Authors</h2>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                {% for author in stats.top_authors|default([]) %}
                    <div style="display:flex; justify-content:space-between; align-items:center; background: rgba(255,255,255,0.02); padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.03);" class="hover-bright-bg">
                        <div style="display:flex; align-items:center; gap: 0.75rem;">
                            <img src="https://ui-avatars.com/api/?name={{ author.first_name }}+{{ author.last_name }}&background=random" style="width: 40px; height: 40px; border-radius: 50%; object-fit:cover; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05);" onerror="this.src='https://ui-avatars.com/api/?name={{ author.first_name }}'"/>
                            <span style="color: #fff; font-weight: 500;">{{ author.first_name }}</span>
                        </div>
                        <span style="color: #fbbf24; background: rgba(251, 191, 36, 0.1); padding: 4px 10px; border-radius: 100px; font-size: 0.8rem; font-weight: 700;">{{ author.pub_count }} Posts</span>
                    </div>
                {% else %}
                    <p style="color:rgba(255,255,255,0.3)">No top authors found.</p>
                {% endfor %}
            </div>
        </div>
    </div>

{% elseif module == 'evenement' %}
    <div class="hz-stat-grid">
        <div class="hz-stat-card hz-stat-amber">
            <div class="hz-stat-icon"><i class='bx bx-calendar-star'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Lifetime Events</p>
                <p class="hz-stat-num">{{ stats.total|default(0) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-amber"></div>
        </div>
        <div class="hz-stat-card hz-stat-green">
            <div class="hz-stat-icon"><i class='bx bx-calendar-event'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Upcoming / Live Events</p>
                <p class="hz-stat-num">{{ stats.upcoming|default(0) }}</p>
                <p class="hz-stat-sub"><span class="hz-pill hz-pill-green">Active schedule</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-green"></div>
        </div>
        <div class="hz-stat-card hz-stat-blue">
            <div class="hz-stat-icon"><i class='bx bx-group'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Participations</p>
                <p class="hz-stat-num">{{ stats.participations|default(0) }}</p>
                <p class="hz-stat-sub"><span style="color:rgba(255,255,255,0.4)">All-time RSVP slots</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-blue"></div>
        </div>
    </div>
        
    <div class="hz-glass hz-chart-card" style="margin-top: 1.5rem; padding: 2rem;">
        <h2 class="hz-panel-title" style="margin-bottom: 1.5rem;"><i class='bx bx-camera-movie' style="color:#f43f5e;margin-right:6px"></i> Event Gallery</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
            {% for event in stats.recent_events|default([]) %}
                <div style="position: relative; height: 220px; border-radius: 16px; overflow: hidden; background: #1a1a1a;" class="hover-bump">
                    {% if event.image_event %}
                        <img src="/event_images/{{ event.image_event }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.7;" class="hover-bright"/>
                    {% else %}
                        <div style="width: 100%; height: 100%; background: linear-gradient(135deg, rgba(244, 63, 94, 0.1) 0%, rgba(255,255,255,0.02) 100%); display:flex; align-items:center; justify-content:center;">
                            <i class='bx bx-calendar' style="font-size: 3.5rem; color: rgba(255,255,255,0.05)"></i>
                        </div>
                    {% endif %}
                    
                    {# Status Badge top right #}
                    {% set color = event.statut_event == 'planifie' ? '#60a5fa' : (event.statut_event == 'termine' ? '#10b981' : (event.statut_event == 'en_cours' ? '#fbbf24' : '#ef4444')) %}
                    <div style="position: absolute; top: 1rem; right: 1rem; background: rgba(0,0,0,0.6); backdrop-filter: blur(10px); border: 1px solid {{ color|default('#fff') }}40; color: {{ color|default('#fff') }}; padding: 4px 12px; border-radius: 100px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; z-index: 2;">
                        {{ event.statut_event }}
                    </div>

                    <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.5rem; background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 60%, transparent 100%); pointer-events: none;">
                        <div style="color: #fff; font-weight: 700; font-size: 1.1rem; margin-bottom: 0.25rem;">{{ event.titre_event }}</div>
                        <div style="color: rgba(255,255,255,0.6); font-size: 0.8rem; display: flex; align-items: center; gap: 4px;">
                            <i class='bx bx-calendar-event'></i> {{ event.date_event|date('F j, Y') }}
                        </div>
                    </div>
                </div>
            {% else %}
                <p style="color:rgba(255,255,255,0.3)">No recent events found.</p>
            {% endfor %}
        </div>
    </div>

{% elseif module == 'syndicat' %}
    <div class="hz-stat-grid">
        <div class="hz-stat-card hz-stat-blue">
            <div class="hz-stat-icon"><i class='bx bx-buildings'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Syndicat Managers</p>
                <p class="hz-stat-num">{{ stats.total|default(0) }}</p>
                <p class="hz-stat-sub"><span class="hz-pill hz-pill-blue">Active roles</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-blue"></div>
        </div>
        <div class="hz-stat-card hz-stat-purple">
            <div class="hz-stat-icon"><i class='bx bx-file'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Reclamations</p>
                <p class="hz-stat-num">{{ stats.reclamations|default(0) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-purple"></div>
        </div>
        <div class="hz-stat-card hz-stat-amber">
            <div class="hz-stat-icon"><i class='bx bx-time-five'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Pending Reclamations</p>
                <p class="hz-stat-num">{{ stats.reclamations_pending|default(0) }}</p>
                <p class="hz-stat-sub"><span style="color:rgba(255,255,255,0.4)">Awaiting action</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-amber"></div>
        </div>
        <div class="hz-stat-card hz-stat-green">
            <div class="hz-stat-icon"><i class='bx bx-message-dots'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Responses</p>
                <p class="hz-stat-num">{{ stats.reponses|default(0) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-green"></div>
        </div>
    </div>
    
    <div class="hz-glass hz-chart-card" style="margin-top: 1.5rem; padding: 2rem;">
        <h2 class="hz-panel-title" style="margin-bottom: 1.5rem;"><i class='bx bx-list-check' style="color:#a78bfa;margin-right:6px"></i> Latest Reclamations</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;">
            {% for rec in stats.recent_reclamations|default([]) %}
                {% set statusColor = rec.statutreclamation == 'en_attente' ? '#fbbf24' : (rec.statutreclamation == 'termine' ? '#10b981' : '#f87171') %}
                <div style="display:flex; align-items: center; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); border-left: 4px solid {{ statusColor }}; border-radius: 12px; padding: 1rem; gap: 1rem;" class="hover-bright-bg">
                    
                    {% if rec.imagereclamation %}
                        <div style="width: 60px; height: 60px; border-radius: 8px; overflow: hidden; flex-shrink: 0; background: #000;">
                            <img src="/reclamation_images/{{ rec.imagereclamation }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.8;"/>
                        </div>
                    {% else %}
                        <div style="width: 60px; height: 60px; border-radius: 8px; flex-shrink: 0; background: rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center;">
                            <i class='bx bx-file-blank' style="font-size: 1.5rem; color: rgba(255,255,255,0.2);"></i>
                        </div>
                    {% endif %}
                    
                    <div style="flex: 1; overflow: hidden;">
                        <div style="color: #fff; font-weight: 600; font-size: 1rem; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; margin-bottom: 0.25rem;">{{ rec.titrereclamations }}</div>
                        <div style="display: inline-block; color: {{ statusColor }}; background: {{ statusColor }}20; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase;">{{ rec.statutreclamation|replace({'_':' '}) }}</div>
                    </div>
                </div>
            {% else %}
                <p style="color:rgba(255,255,255,0.3)">No recent reclamations found.</p>
            {% endfor %}
        </div>
    </div>

{% elseif module == 'residence' %}
    <div class="hz-stat-grid">
        <div class="hz-stat-card hz-stat-green">
            <div class="hz-stat-icon"><i class='bx bx-home-heart'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Registered Residents</p>
                <p class="hz-stat-num">{{ stats.total|default(0) }}</p>
                <p class="hz-stat-sub"><span class="hz-pill hz-pill-green">Verified occupants</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-green"></div>
        </div>
        <div class="hz-stat-card hz-stat-blue">
            <div class="hz-stat-icon"><i class='bx bx-buildings'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Residences</p>
                <p class="hz-stat-num">{{ stats.residences|default(0) }}</p>
                <p class="hz-stat-sub"><span style="color:rgba(255,255,255,0.4)">Managed properties</span></p>
            </div>
            <div class="hz-stat-glow hz-glow-blue"></div>
        </div>
        <div class="hz-stat-card hz-stat-purple">
            <div class="hz-stat-icon"><i class='bx bx-door-open'></i></div>
            <div class="hz-stat-body">
                <p class="hz-stat-label">Total Appartements</p>
                <p class="hz-stat-num">{{ stats.appartements|default(0) }}</p>
            </div>
            <div class="hz-stat-glow hz-glow-purple"></div>
        </div>
    </div>
    
    <div class="hz-glass hz-chart-card" style="margin-top: 1.5rem; padding: 2rem;">
        <h2 class="hz-panel-title" style="margin-bottom: 1.5rem;"><i class='bx bx-buildings' style="color:#60a5fa;margin-right:6px"></i> Property Portfolio</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
            {% for res in stats.recent_residences|default([]) %}
                <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; overflow: hidden;" class="hover-bump">
                    <div style="height: 140px; width: 100%; background: #111; position: relative;">
                        {% if res.image_r %}
                            <img src="/residence_images/{{ res.image_r }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.8;" class="hover-bright"/>
                        {% else %}
                            <div style="width: 100%; height: 100%; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, rgba(96, 165, 250, 0.1) 0%, rgba(255,255,255,0.02) 100%);">
                                <i class='bx bxs-city' style="font-size: 3rem; color: rgba(255,255,255,0.1);"></i>
                            </div>
                        {% endif %}
                        <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 50%; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); pointer-events:none;"></div>
                        <div style="position: absolute; bottom: 10px; left: 15px; color: #fff; font-weight: 700; font-size: 1.2rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8); pointer-events:none;">{{ res.nom_r }}</div>
                    </div>
                    <div style="padding: 1.25rem;">
                        <p style="color: rgba(255,255,255,0.6); font-size: 0.85rem; margin: 0; display:flex; align-items:center; gap: 6px;"><i class='bx bx-map' style="color:#60a5fa"></i> {{ res.adresse }}</p>
                    </div>
                </div>
            {% else %}
                <p style="color:rgba(255,255,255,0.3)">No recent properties found.</p>
            {% endfor %}
        </div>
    </div>
{% endif %}
