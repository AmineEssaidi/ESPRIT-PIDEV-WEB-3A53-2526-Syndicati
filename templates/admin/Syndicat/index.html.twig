{% extends 'base.html.twig' %}

{% block title %}Syndicat - Liquid Glass Admin{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
    <style>
        /* Hide Scrollbar Global */
        html, body, .admin-shell, .layout-wrapper, .layout-page, .content-wrapper, .container-xxl {
            scrollbar-width: none !important; /* Firefox */
            -ms-overflow-style: none !important; /* IE 10+ */
            overflow-x: hidden !important; /* Force no horizontal scroll */
        }
        html::-webkit-scrollbar, body::-webkit-scrollbar,
        .admin-shell::-webkit-scrollbar, .layout-wrapper::-webkit-scrollbar, 
        .layout-page::-webkit-scrollbar, .content-wrapper::-webkit-scrollbar, 
        .container-xxl::-webkit-scrollbar {
            display: none !important; /* Chrome/Safari/Webkit */
            width: 0 !important;
            height: 0 !important;
        }

        /* Ensure box-sizing prevents padding overflow */
        .users-edit-modal, .users-edit-modal * {
            box-sizing: border-box !important;
        }

        /* Premium Modal Face-Lift - Obsidian Edition */
        /* Premium Modal Face-Lift - Obsidian Edition */
        .users-edit-modal {
            display: none;
            position: relative !important;
            width: 100% !important;
            height: auto !important;
            min-height: 100%;
            z-index: 10;
            padding: 0 !important; /* REMOVED PADDING */
            align-items: flex-start; 
            justify-content: flex-start; 
            background: transparent; 
        }
        .users-edit-modal::-webkit-scrollbar { display: none; /* Chrome/Safari/Webkit */ }

        .users-edit-modal.active {
            display: flex;
            animation: modalFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(40px) scale(0.97); filter: blur(10px); }
            to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }

        .users-edit-modal-card {
            background: transparent !important; /* REMOVED BACKGROUND */
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border: none !important; 
            box-shadow: none !important; 
            width: 100% !important;
            max-width: 100% !important; 
            margin: 0 !important; 
            
            /* Vertical Constraints */
            min-height: auto !important; 
            display: flex !important;
            flex-direction: column !important;

            border-radius: 0 !important; 
            overflow: visible; 
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .users-edit-modal-header {
            flex-shrink: 0; 
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1.5rem 2rem !important; /* REDUCED PADDING */
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent; 
        }
        .users-edit-modal-header h3 {
            font-size: 2rem !important;
            font-weight: 900 !important;
            letter-spacing: -0.04em !important;
            margin: 0 !important;
            color: #fff !important;
            text-shadow: 0 4px 12px rgba(0,0,0,0.3);
        }
        .users-edit-modal-subtitle {
            font-size: 1rem !important;
            color: rgba(255, 255, 255, 0.45) !important;
            margin-top: 0.5rem !important;
            font-weight: 500;
        }
        .users-edit-modal-close {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 50% !important;
            color: rgba(255, 255, 255, 0.6) !important;
            font-size: 1.6rem !important;
            display: flex !important;
            align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }
        .users-edit-modal-close:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            transform: rotate(180deg) scale(1.1);
            color: #fff !important;
        }
        .users-edit-modal-body {
            padding: 2rem !important; /* REDUCED PADDING */
            overflow-y: visible !important; 
            flex-grow: 1; 
            
            /* Hide scrollbar completely */
            scrollbar-width: none; 
            -ms-overflow-style: none; 
        }
        .users-edit-modal-body::-webkit-scrollbar {
            display: none; /* Chrome/Safari/Webkit */
        }

        /* Obsidian Form Styling */
        .glass-form-group {
            margin-bottom: 1.5rem; /* REDUCED MARGIN */
        }
        .glass-label {
            display: block;
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.3) !important;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            transition: all 0.3s ease;
        }
        .glass-form-group:focus-within .glass-label { color: rgba(255, 255, 255, 0.8) !important; transform: translateX(5px); }
        .glass-input, .form-control.bg-dark {
            width: 100%;
            background: rgba(0, 0, 0, 0.5) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 20px !important;
            padding: 1.2rem 1.6rem !important;
            color: #fff !important;
            font-size: 1.1rem !important;
            font-weight: 500;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.5) !important;
        }
        .glass-input:focus, .form-control.bg-dark:focus {
            background: rgba(0, 0, 0, 0.7) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 20px 40px rgba(0,0,0,0.4) !important;
            outline: none !important;
            transform: scale(1.01) translateY(-2px);
        }

        /* Obsidian View Details */
        .glass-view-row {
            display: flex;
            align-items: flex-start; /* ALIGNED TO TOP FOR LONG TEXT */
            padding: 1.8rem 2.5rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            margin-bottom: 1.5rem;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .glass-view-row:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            transform: translateX(12px) scale(1.01);
            box-shadow: -20px 0 40px rgba(0,0,0,0.3);
        }
        .glass-view-label {
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.25) !important;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            width: 180px;
            flex-shrink: 0;
        }
        .glass-view-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            flex: 1;
            word-break: break-all !important; /* PREVENTS OVERFLOW ON LONG STRINGS */
            white-space: pre-wrap !important; /* PRESERVES LINE BREAKS */
            line-height: 1.6;
        }

        /* Obsidian Buttons */
        .users-btn-modify {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%) !important;
            color: #fff !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            letter-spacing: 0.04em !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            cursor: pointer !important; transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1) !important;
            backdrop-filter: blur(5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
        }
        .users-btn-modify:hover {
            background: rgba(255, 255, 255, 0.15) !important;
            border-color: rgba(255, 255, 255, 0.3) !important;
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.1) !important;
        }
        .users-btn-delete {
            background: rgba(255, 59, 48, 0.05) !important;
            color: #ff3b30 !important;
            border: 1px solid rgba(255, 59, 48, 0.15) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            cursor: pointer !important;
            transition: all 0.4s ease !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            backdrop-filter: blur(5px);
        }
        .users-btn-delete:hover {
            background: rgba(255, 59, 48, 0.15) !important;
            border-color: #ff3b30 !important;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(255, 59, 48, 0.2) !important;
        }
        .users-btn-cancel, .users-btn-discard {
            background: rgba(255, 255, 255, 0.02) !important;
            color: rgba(255, 255, 255, 0.4) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
        }
        .users-btn-cancel:hover { background: rgba(255, 255, 255, 0.08) !important; color: #fff !important; }

        /* Badge Styles Cleanup */
        .badge-premium-admin { background: rgba(255, 255, 255, 0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2); }
    word-break: break-word;
        }

        /* Premium Buttons */
        .users-btn-modify {
            background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%) !important;
            color: #fff !important;
            border: none !important;
            padding: 0.9rem 2rem !important;
            border-radius: 100px !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            letter-spacing: 0.02em !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 0.75rem !important;
            cursor: pointer !important;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1) !important;
            box-shadow: 0 10px 25px rgba(0, 114, 255, 0.4) !important;
        }
        .users-btn-modify:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 15px 35px rgba(0, 114, 255, 0.5) !important;
        }
        .users-btn-delete {
            background: rgba(255, 59, 48, 0.1) !important;
            color: #ff3b30 !important;
            border: 1px solid rgba(255, 59, 48, 0.3) !important;
            padding: 0.9rem 2rem !important;
            border-radius: 100px !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
            display: inline-flex !important; align-items: center !important; gap: 0.75rem !important;
            backdrop-filter: blur(5px);
        }
        .users-btn-delete:hover {
            background: rgba(255, 59, 48, 0.2) !important;
            border-color: #ff3b30 !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 59, 48, 0.3) !important;
        }
        .users-btn-cancel, .users-btn-discard {
            background: rgba(255, 255, 255, 0.05) !important;
            color: rgba(255, 255, 255, 0.6) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            padding: 0.9rem 2rem !important;
            border-radius: 100px !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
            backdrop-filter: blur(5px);
        }
        .users-btn-cancel:hover { background: rgba(255, 255, 255, 0.1) !important; color: #fff !important; }

        /* Premium Switcher Styles (Unified) */
        .premium-switcher-container {
            padding: 4px;
            background: rgba(10, 10, 10, 0.45);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 100px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 10;
            min-width: 400px;
        }
        .premium-switcher-pill { display: flex; position: relative; width: 100%; height: 44px; }
        .premium-switcher-slider {
            position: absolute; top: 0; left: 0; height: 100%;
            background: var(--accent-gradient, linear-gradient(90deg, #00c6ff 0%, #0072ff 100%));
            border-radius: 100px; box-shadow: 0 4px 20px rgba(0, 114, 255, 0.4);
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1); z-index: 1; pointer-events: none;
        }
        .premium-switcher-tab {
            flex: 1; position: relative; z-index: 2; background: transparent; border: none;
            color: rgba(255, 255, 255, 0.55); font-weight: 700; font-size: 0.95rem;
            letter-spacing: 0.03em; cursor: pointer; transition: all 0.3s ease;
            white-space: nowrap; outline: none; display: flex; align-items: center; justify-content: center;
            padding: 0 1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        .premium-switcher-tab.active { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .premium-switcher-tab:hover:not(.active) { color: #fff; background: rgba(255, 255, 255, 0.05); border-radius: 100px; }
    </style>
{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Syndicat' } %}

<div class="users-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
    <div class="premium-switcher-container">
        <div class="premium-switcher-pill">
            <div class="premium-switcher-slider" id="syndicat-switcher-slider"></div>
            <button class="premium-switcher-tab active" data-page="1">Reclamations</button>
            <button class="premium-switcher-tab" data-page="2">Responses</button>
        </div>
    </div>
</div>

<div id="syndicat-content" class="syndicat-content" style="margin-top: 1.5rem;">
    <!-- Page 1: Reclamations -->
    <div class="syndicat-page-content" data-page="1">
        <div class="glass-table-container">
            <div id="syndicatRecGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
                        <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff;">Reclamations</h3>
                        <div style="flex: 1;"></div>
                    </div>

                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
                            <i class="bx bx-search glass-search-icon"></i>
                            <input type="text" class="glass-search-input syndicat-rec-search-input" placeholder="Search reclamations...">
                        </div>
                        
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active syndicat-rec-sort-option" data-value="date" onclick="selectRecSortPill(this)">Date</div>
                            <div class="glass-pill syndicat-rec-sort-option" data-value="title" onclick="selectRecSortPill(this)">Title</div>
                            <div class="glass-pill syndicat-rec-sort-option" data-value="status" onclick="selectRecSortPill(this)">Status</div>
                            <button class="glass-pagination-btn" id="syndicat-rec-sort-dir-pill" style="width: 38px; height: 38px;">
                                <span id="syndicat-rec-sort-dir-icon-svg"></span>
                            </button>
                        </div>
                    </div>

                    <div class="glass-table-scroll">
                        <table class="glass-table" id="syndicat-rec-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>User</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="syndicat-rec-table-body">
                                <!-- Table rows rendered by JS -->
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="glass-pagination-bar" id="syndicat-rec-pagination">
                        <button class="glass-pagination-btn" id="syndicat-rec-table-prev"><i class="bx bx-chevron-left"></i></button>
                        <div id="syndicat-rec-table-pages" style="display: flex; gap: 0.5rem;"></div>
                        <button class="glass-pagination-btn" id="syndicat-rec-table-next"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div><!-- End .glass-switcher-face-main -->

                <div class="glass-switcher-face glass-switcher-face-details" id="rec-view-face">
                    <div id="rec-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Reclamation Details</h3>
                                    <p class="users-edit-modal-subtitle">View complete reclamation information</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('rec-view-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
                            </div>
                            <div class="users-edit-modal-body">
                                <div class="glass-view-details">
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Title</div>
                                        <div class="glass-view-value" id="view-rec-title">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">User</div>
                                        <div class="glass-view-value" id="view-rec-user">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Status</div>
                                        <div class="glass-view-value" id="view-rec-status">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Date</div>
                                        <div class="glass-view-value" id="view-rec-date">-</div>
                                    </div>
                                    <div class="glass-view-row" style="flex-direction: column; align-items: flex-start;">
                                        <div class="glass-view-label" style="width: 100%; margin-bottom: 0.5rem;">Description</div>
                                        <div class="glass-view-value" id="view-rec-description" style="line-height: 1.6; opacity: 0.8;">-</div>
                                    </div>
                                </div>
                                <div class="users-view-modal-actions" style="margin-top: 2.5rem;">
                                    <button type="button" class="users-btn-modify" id="view-rec-modify-btn">
                                        <i class="bx bx-edit"></i> Modify Reclamation
                                    </button>
                                    <form id="view-rec-delete-form" method="post" style="display: inline-block; margin-left: 1rem;" data-ajax="true" data-refresh="syndicatFilterSortRecs">
                                        <input type="hidden" name="_token" id="view-rec-delete-token" value="">
                                        <button type="submit" class="users-btn-delete" data-delete-title="Delete Reclamation">
                                            <i class="bx bx-trash"></i> Delete Reclamation
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-edit" id="rec-edit-face">
                    <div id="rec-edit-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Edit Reclamation</h3>
                                    <p class="users-edit-modal-subtitle">Modify reclamation status and details.</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('rec-edit-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if recEditForm is defined %}
                                {{ form_start(recEditForm, { 'attr': { 'id': 'rec-edit-form', 'method': 'post', 'action': '', 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'syndicatFilterSortRecs' } }) }}
                                
                                {{ form_row(recEditForm.titrereclamations, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                {{ form_row(recEditForm.descreclamation, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'style': 'height: 120px;' } }) }}
                                {{ form_row(recEditForm.statutreclamation, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('rec-edit-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-check"></i> Update Status</button>
                                </div>
                                {{ form_end(recEditForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Page 2: Responses -->
    <div class="syndicat-page-content" data-page="2" style="display: none;">
        <div class="glass-table-container">
            <div id="syndicatRepGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
                        <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff;">Responses</h3>
                    </div>

                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
                            <i class="bx bx-search glass-search-icon"></i>
                            <input type="text" class="glass-search-input syndicat-rep-search-input" placeholder="Search responses...">
                        </div>
                        
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active syndicat-rep-sort-option" data-value="date" onclick="selectRepSortPill(this)">Date</div>
                            <div class="glass-pill syndicat-rep-sort-option" data-value="user" onclick="selectRepSortPill(this)">User</div>
                            <button class="glass-pagination-btn" id="syndicat-rep-sort-dir-pill" style="width: 38px; height: 38px;">
                                <span id="syndicat-rep-sort-dir-icon-svg"></span>
                            </button>
                        </div>
                    </div>

                    <div class="glass-table-scroll">
                        <table class="glass-table" id="syndicat-rep-table">
                            <thead>
                                <tr>
                                    <th>Message</th>
                                    <th>User</th>
                                    <th>Reclamation</th>
                                    <th>Date</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="syndicat-rep-table-body">
                                <!-- Table rows rendered by JS -->
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="glass-pagination-bar" id="syndicat-rep-pagination">
                        <button class="glass-pagination-btn" id="syndicat-rep-table-prev"><i class="bx bx-chevron-left"></i></button>
                        <div id="syndicat-rep-table-pages" style="display: flex; gap: 0.5rem;"></div>
                        <button class="glass-pagination-btn" id="syndicat-rep-table-next"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-details" id="rep-view-face">
                    <div id="rep-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Response Details</h3>
                                    <p class="users-edit-modal-subtitle">View response content and metadata.</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('rep-view-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
                            </div>
                            <div class="users-edit-modal-body">
                                <div class="glass-view-details">
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">User</div>
                                        <div class="glass-view-value" id="view-rep-user">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Reclamation</div>
                                        <div class="glass-view-value" id="view-rep-rec">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Date</div>
                                        <div class="glass-view-value" id="view-rep-date">-</div>
                                    </div>
                                    <div class="glass-view-row" style="flex-direction: column; align-items: flex-start;">
                                        <div class="glass-view-label" style="width: 100%; margin-bottom: 0.5rem;">Message</div>
                                        <div class="glass-view-value" id="view-rep-message" style="line-height: 1.6; opacity: 0.8;">-</div>
                                    </div>
                                </div>
                                <div class="users-view-modal-actions" style="margin-top: 2.5rem;">
                                    <form id="view-rep-delete-form" method="post" style="display: inline-block;" data-ajax="true" data-refresh="syndicatFilterSortReps">
                                        <input type="hidden" name="_token" id="view-rep-delete-token" value="">
                                        <button type="submit" class="users-btn-delete">
                                            <i class="bx bx-trash"></i> Delete Response
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /**
     * Standardized Glass Switcher Logic
     */



    // --- Data Templates ---
    const reclamationsData = [
        {% for r in reclamations|default([]) %}
        [
            "{{ r.titrereclamations|e('js') }}",
            "{{ r.user ? r.user.emailUser|e('js') : '—' }}",
            "{{ r.statutreclamation|e('js') }}",
            "{{ (r.createdAt ?? r.datereclamation)|date('Y-m-d H:i') }}",
            "{{ r.id }}",
            "{{ r.descreclamation|e('js') }}",
            "{{ csrf_token('delete_reclamation')|e('js') }}"
        ]{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const reponsesData = [
        {% for rep in reponses|default([]) %}
        [
            "{{ rep.messagereponse|e('js')|slice(0, 50) }}...",
            "{{ rep.user ? rep.user.emailUser|e('js') : '—' }}",
            "{{ rep.reclamation ? rep.reclamation.titrereclamations|e('js') : 'Deleted' }}",
            "{{ rep.createdAt|date('Y-m-d H:i') }}",
            "{{ rep.id }}",
            "{{ rep.messagereponse|e('js') }}",
            "{{ csrf_token('delete' ~ rep.id)|e('js') }}"
        ]{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const editRecUrlTemplate = "{{ path('admin_reclamation_edit_ajax', {id: 'ID_PLACEHOLDER'}) }}";
    const deleteRecUrlTemplate = "{{ path('admin_syndicat_reclamation_delete', {id: 'ID_PLACEHOLDER'}) }}";
    const deleteRepUrlTemplate = "{{ path('admin_reponse_delete', {id: 'ID_PLACEHOLDER'}) }}";

    let recCurrentPage = 1;
    let recFilteredRows = [...reclamationsData];
    let recSortValue = 'date';
    let recSortDirection = 'desc';

    let repCurrentPage = 1;
    let repFilteredRows = [...reponsesData];
    let repSortValue = 'date';
    let repSortDirection = 'desc';

    const rowsPerPage = 10;

    function updateRecSortDirIcon() {
        const iconEl = document.getElementById('syndicat-rec-sort-dir-icon-svg');
        if (!iconEl) return;
        iconEl.innerHTML = recSortDirection === 'asc'
            ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>`
            : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }

    function updateRepSortDirIcon() {
        const iconEl = document.getElementById('syndicat-rep-sort-dir-icon-svg');
        if (!iconEl) return;
        iconEl.innerHTML = repSortDirection === 'asc'
            ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>`
            : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }

    window.selectRecSortPill = function(pill) {
        recSortValue = pill.dataset.value;
        document.querySelectorAll('.syndicat-rec-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        syndicatFilterSortRecs();
    };

    window.selectRepSortPill = function(pill) {
        repSortValue = pill.dataset.value;
        document.querySelectorAll('.syndicat-rep-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        syndicatFilterSortReps();
    };

    function syndicatFilterSortRecs() {
        const val = document.querySelector('.syndicat-rec-search-input').value.toLowerCase();
        let rows = reclamationsData.filter(d => d[0].toLowerCase().includes(val) || d[1].toLowerCase().includes(val) || d[5].toLowerCase().includes(val));
        
        let sortIdx = 3; // Date
        if (recSortValue === 'title') sortIdx = 0;
        else if (recSortValue === 'status') sortIdx = 2;

        rows.sort((a,b) => {
            let vA = a[sortIdx].toLowerCase(), vB = b[sortIdx].toLowerCase();
            return recSortDirection === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });

        recFilteredRows = rows;
        recCurrentPage = 1;
        renderRecTable();
    }

    function syndicatFilterSortReps() {
        const val = document.querySelector('.syndicat-rep-search-input').value.toLowerCase();
        let rows = reponsesData.filter(d => d[5].toLowerCase().includes(val) || d[1].toLowerCase().includes(val) || d[2].toLowerCase().includes(val));
        
        let sortIdx = 3; // Date
        if (repSortValue === 'user') sortIdx = 1;

        rows.sort((a,b) => {
            let vA = a[sortIdx].toLowerCase(), vB = b[sortIdx].toLowerCase();
            return repSortDirection === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });

        repFilteredRows = rows;
        repCurrentPage = 1;
        renderRepTable();
    }

    function renderRecTable() {
        const tbody = document.getElementById('syndicat-rec-table-body');
        tbody.innerHTML = '';
        const start = (recCurrentPage-1)*rowsPerPage;
        const end = Math.min(start+rowsPerPage, recFilteredRows.length);
        for(let i=start; i<end; i++) {
            const data = recFilteredRows[i];
            const row = document.createElement('tr');
            row.innerHTML = `
                <td><strong>${data[0]}</strong></td>
                <td>${data[1]}</td>
                <td><span class="glass-pill">${data[2]}</span></td>
                <td>${data[3]}</td>
                <td style="text-align: right;">
                    <button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="event.stopPropagation(); viewRec(${i})">
                        <i class="bx bx-show"></i> Details
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        }
        renderRecPagination();
    }

    function renderRepTable() {
        const tbody = document.getElementById('syndicat-rep-table-body');
        tbody.innerHTML = '';
        const start = (repCurrentPage-1)*rowsPerPage;
        const end = Math.min(start+rowsPerPage, repFilteredRows.length);
        for(let i=start; i<end; i++) {
            const data = repFilteredRows[i];
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>${data[0]}</td>
                <td>${data[1]}</td>
                <td><strong>${data[2]}</strong></td>
                <td>${data[3]}</td>
                <td style="text-align: right;">
                    <button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="event.stopPropagation(); viewRep(${i})">
                        <i class="bx bx-show"></i> Details
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        }
        renderRepPagination();
    }

    function renderRecPagination() {
        const total = Math.ceil(recFilteredRows.length / rowsPerPage);
        const container = document.getElementById('syndicat-rec-table-pages');
        container.innerHTML = '';
        for(let i=1; i<=total; i++) {
            const btn = document.createElement('button');
            btn.className = 'glass-pagination-btn' + (i === recCurrentPage ? ' active' : '');
            btn.textContent = i;
            btn.onclick = () => { recCurrentPage = i; renderRecTable(); };
            container.appendChild(btn);
        }
    }

    function renderRepPagination() {
        const total = Math.ceil(repFilteredRows.length / rowsPerPage);
        const container = document.getElementById('syndicat-rep-table-pages');
        container.innerHTML = '';
        for(let i=1; i<=total; i++) {
            const btn = document.createElement('button');
            btn.className = 'glass-pagination-btn' + (i === repCurrentPage ? ' active' : '');
            btn.textContent = i;
            btn.onclick = () => { repCurrentPage = i; renderRepTable(); };
            container.appendChild(btn);
        }
    }

    window.viewRec = function(index) {
        const data = recFilteredRows[index];
        document.getElementById('view-rec-title').textContent = data[0];
        document.getElementById('view-rec-user').textContent = data[1];
        document.getElementById('view-rec-status').textContent = data[2];
        document.getElementById('view-rec-date').textContent = data[3];
        document.getElementById('view-rec-description').textContent = data[5];
        
        document.getElementById('view-rec-delete-token').value = data[6];
        document.getElementById('view-rec-delete-form').action = deleteRecUrlTemplate.replace('ID_PLACEHOLDER', data[4]);
        
        document.getElementById('view-rec-modify-btn').onclick = () => {
            const form = document.getElementById('rec-edit-form');
            form.action = editRecUrlTemplate.replace('ID_PLACEHOLDER', data[4]);
            const titleInput = form.querySelector('[name*="titrereclamations"]');
            if(titleInput) titleInput.value = data[0];
            const descInput = form.querySelector('[name*="descreclamation"]');
            if(descInput) descInput.value = data[5];
            const statusInput = form.querySelector('[name*="statutreclamation"]');
            if(statusInput) statusInput.value = data[2];
            openModal('rec-edit-modal');
        };
        // 1. Explicitly mark the modal as active before the switcher starts
        const vModal = document.getElementById('rec-view-modal');
        if (vModal) {
            vModal.style.display = 'flex';
            void vModal.offsetWidth;
            vModal.classList.add('active');
        }
        openModal('rec-view-modal');
    };

    window.viewRep = function(index) {
        const data = repFilteredRows[index];
        document.getElementById('view-rep-message').textContent = data[5];
        document.getElementById('view-rep-user').textContent = data[1];
        document.getElementById('view-rep-rec').textContent = data[2];
        document.getElementById('view-rep-date').textContent = data[3];
        
        document.getElementById('view-rep-delete-token').value = data[6];
        document.getElementById('view-rep-delete-form').action = deleteRepUrlTemplate.replace('ID_PLACEHOLDER', data[4]);
        
        // 1. Explicitly mark the modal as active before the switcher starts
        const vModal = document.getElementById('rep-view-modal');
        if (vModal) {
            vModal.style.display = 'flex';
            void vModal.offsetWidth;
            vModal.classList.add('active');
        }
        openModal('rep-view-modal');
    };

    document.addEventListener('DOMContentLoaded', () => {
        const slider = document.getElementById('syndicat-switcher-slider');
        const tabs = document.querySelectorAll('.premium-switcher-tab');
        const pages = document.querySelectorAll('.syndicat-page-content');
        tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                slider.style.left = (index * (100 / tabs.length)) + '%';
                slider.style.width = (100 / tabs.length) + '%';
                const pageNum = tab.dataset.page;
                pages.forEach(p => p.style.display = p.dataset.page === pageNum ? 'block' : 'none');
                const activePage = document.querySelector(`.syndicat-page-content[data-page="${pageNum}"]`);
                const activeSwitcher = activePage.querySelector('.glass-switcher');
                if(activeSwitcher) switchGlassFace('main', activeSwitcher.id);
            });
        });
        slider.style.width = (100 / tabs.length) + '%';
        
        renderRecTable(); 
        renderRepTable();

        updateRecSortDirIcon();
        updateRepSortDirIcon();

        switchGlassFace('main', 'syndicatRecGlassSwitcher');

        // Sort Direction Toggles
        document.getElementById('syndicat-rec-sort-dir-pill').addEventListener('click', () => {
            recSortDirection = recSortDirection === 'asc' ? 'desc' : 'asc';
            updateRecSortDirIcon();
            syndicatFilterSortRecs();
        });

        document.getElementById('syndicat-rep-sort-dir-pill').addEventListener('click', () => {
            repSortDirection = repSortDirection === 'asc' ? 'desc' : 'asc';
            updateRepSortDirIcon();
            syndicatFilterSortReps();
        });

        // Search Inputs
        document.querySelector('.syndicat-rec-search-input').addEventListener('input', () => {
            syndicatFilterSortRecs();
        });

        document.querySelector('.syndicat-rep-search-input').addEventListener('input', () => {
            syndicatFilterSortReps();
        });
    });
</script>
{% endblock %}
