{% block stylesheets %}
	<style>
		/* Match Residence: pill tabs */
		.users-pagination-wrapper { width: 100%; max-width: 100%; }
		.users-pagination-pills {
			position: relative;
			display: inline-flex;
			background: linear-gradient(135deg, rgba(28, 32, 42, 0.85) 80%, rgba(22, 26, 34, 0.85) 100%);
			border-radius: 999px;
			padding: 0.35rem;
			box-shadow: 0 4px 16px rgba(0,0,0,0.25);
			gap: 0.4rem;
			backdrop-filter: blur(16px);
			border: 1px solid rgba(255,255,255,0.08);
		}
		.pill-tab {
			position: relative;
			background: transparent;
			border: none;
			color: rgba(191,201,216,0.8);
			padding: 0.75rem 2rem;
			border-radius: 999px;
			cursor: pointer;
			font-weight: 700;
			font-size: 1rem;
			transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			z-index: 2;
			white-space: nowrap;
		}
		.pill-tab:hover { color: #fff; background: rgba(255,255,255,0.05); }
		.pill-tab.active {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			color: #fff;
			text-shadow: none;
			box-shadow: 0 4px 12px rgba(0, 114, 255, 0.3);
		}
		.residence-page-content { animation: fadeIn 0.4s ease; }
		@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
		[data-theme="light"] .users-pagination-pills {
			background: linear-gradient(135deg, #f5f7fa 80%, #e3e8f7 100%);
			box-shadow: 0 2px 12px rgba(0,0,0,0.04);
			border-color: #e3e8f7;
		}
		[data-theme="light"] .pill-tab { color: #5c6370; }
		[data-theme="light"] .pill-tab:hover { color: #23272f; background: rgba(0,0,0,0.02); }
		[data-theme="light"] .pill-tab.active {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			color: #fff;
			box-shadow: 0 4px 16px rgba(0,123,255,0.15);
		}

		/* Residence-style toolbar, search, sort */
		[data-theme="light"] .residence-sort-dir-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
			color: #23272f;
		}
		[data-theme="light"] .residence-sort-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
			color: #fff !important;
			box-shadow: 0 2px 8px rgba(0,123,255,0.08);
		}
		[data-theme="light"] .residence-search-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
		}
		[data-theme="light"] .residence-search-input { color: #23272f; }
		[data-theme="light"] .residence-search-icon { color: #0072ff; }

		.residence-table-toolbar { width: 100%; display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; justify-content: space-between; }
		.residence-search-pill {
			display: flex;
			align-items: center;
			background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
			border-radius: 999px;
			padding: 0.3rem 1.1rem;
			box-shadow: 0 2px 8px rgba(0,0,0,0.10);
		}
		.residence-search-input {
			background: transparent;
			border: none;
			color: #fff;
			font-size: 1rem;
			outline: none;
			width: 160px;
			padding: 0.2rem 0.5rem 0.2rem 0;
		}
		.residence-search-icon { color: #bfc9d8; font-size: 1.2rem; margin-left: 0.3rem; }
		.residence-sort-dir-pill {
			background: linear-gradient(90deg, #2a2e39 0%, #23272f 100%);
			border: none;
			border-radius: 999px;
			padding: 0.3rem 0.7rem;
			box-shadow: 0 2px 8px rgba(0,0,0,0.10);
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: background 0.18s, color 0.18s;
			outline: none;
			font-size: 1.1rem;
			color: #fff;
		}
		.residence-sort-pill {
			position: relative;
			z-index: 20;
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			border-radius: 999px;
			padding: 0.3rem 1.1rem;
			box-shadow: 0 2px 8px rgba(0,123,255,0.10);
			display: flex;
			align-items: center;
			min-width: 160px;
			cursor: pointer;
			user-select: none;
			color: #fff;
			transition: background 0.18s, color 0.18s;
		}
		.residence-sort-selected { flex: 1; font-size: 1rem; font-weight: 600; padding-right: 1.2rem; }
		.residence-sort-arrow {
			display: inline-block;
			width: 1.1em;
			height: 1.1em;
			background: url('data:image/svg+xml;utf8,<svg fill="white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>') no-repeat center/contain;
			margin-left: -1.1em;
		}
		.residence-sort-dropdown {
			position: absolute;
			left: 0;
			top: 110%;
			min-width: 100%;
			background: rgba(30, 60, 120, 0.85);
			border-radius: 1.2em;
			box-shadow: 0 8px 32px rgba(0,198,255,0.18);
			backdrop-filter: blur(16px) saturate(160%);
			z-index: 10;
			padding: 0.3em 0;
			display: flex;
			flex-direction: column;
			gap: 0.1em;
			animation: residence-sort-dropdown-fade 0.18s cubic-bezier(.4,1.4,.6,1) both;
		}
		@keyframes residence-sort-dropdown-fade {
			0% { opacity: 0; transform: translateY(-10px) scale(0.98); }
			100% { opacity: 1; transform: translateY(0) scale(1); }
		}
		.residence-sort-option {
			padding: 0.7em 1.5em;
			border-radius: 1em;
			color: #fff;
			font-size: 1rem;
			cursor: pointer;
			transition: background 0.13s, color 0.13s;
		}
		.residence-sort-option:hover, .residence-sort-option.active {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
		}

		/* Light theme table */
		[data-theme="light"] .liquid-glass-table-container {
			background: rgba(255,255,255,0.85);
			border: 1.5px solid #e3e8f7;
			box-shadow: 0 8px 32px rgba(0,0,0,0.08);
		}
		[data-theme="light"] .liquid-glass-table {
			background: rgba(255,255,255,0.98);
			color: #23272f;
		}
		[data-theme="light"] .liquid-glass-table th { background: #f5f7fa; color: #23272f; }
		[data-theme="light"] .liquid-glass-table td { background: transparent; color: #23272f; }
		[data-theme="light"] .table-pagination-bar { background: transparent; }
		[data-theme="light"] .residence-table-arrow {
			background: #fff;
			color: #0072ff;
			border: 1px solid #e3e8f7;
		}
		[data-theme="light"] .residence-table-page-btn {
			background: transparent;
			color: #23272f;
		}
		[data-theme="light"] .residence-table-page-btn.active {
			background: #0072ff;
			color: #fff;
		}
	</style>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Syndicat - Horizon Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Syndicat' } %}

<div class="users-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
	<div class="users-pagination-pills pills-animated">
		<button class="pill-tab active" data-page="1">Reclamations</button>
		<button class="pill-tab" data-page="2">Responses</button>
		<button class="pill-tab" data-page="3">Page 3</button>
		<button class="pill-tab" data-page="4">Page 4</button>
	</div>
</div>
<div id="syndicat-content" class="residence-content" style="margin-top: 1.5rem;">
	<div class="residence-page-content" data-page="1">
		<div class="liquid-glass-table-container">
			<h3 style="margin-bottom:1.5rem;">Reclamations</h3>
			<div class="residence-table-toolbar">
				<div style="display: flex; align-items: center;"></div>
				<div style="display: flex; gap: 0.75rem; align-items: center;">
					<button class="residence-sort-dir-pill" id="reclamation-sort-dir-pill" title="Toggle Sort Direction">
						<span id="reclamation-sort-dir-icon-svg"></span>
					</button>
					<div class="residence-sort-pill" id="reclamation-sort-pill-custom" tabindex="0">
						<span class="residence-sort-selected" id="reclamation-sort-selected">Sort by Title</span>
						<span class="residence-sort-arrow"></span>
						<div class="residence-sort-dropdown" id="reclamation-sort-dropdown" style="display:none;">
							<div class="residence-sort-option" data-value="title">Title</div>
							<div class="residence-sort-option" data-value="date">Date</div>
							<div class="residence-sort-option" data-value="status">Status</div>
							<div class="residence-sort-option" data-value="user">User</div>
						</div>
					</div>
					<div class="residence-search-pill">
						<input type="text" class="residence-search-input" id="reclamation-search-input" placeholder="Search reclamations..." />
						<i class="bx bx-search residence-search-icon"></i>
					</div>
				</div>
			</div>
			<div class="liquid-glass-table-scroll">
				<table class="liquid-glass-table" id="reclamation-table">
					<thead>
						<tr>
							<th>Title</th>
							<th>Description</th>
							<th>User</th>
							<th>Status</th>
							<th>Date</th>
							<th>Details</th>
						</tr>
					</thead>
					<tbody id="reclamation-table-body">
						<!-- Dynamic rows from reclamationData -->
					</tbody>
				</table>
			</div>
			<div class="table-pagination-bar">
				<button class="residence-table-arrow" id="reclamation-table-prev"><i class="bx bx-chevron-left"></i></button>
				<div class="residence-table-pages" id="reclamation-table-pages"></div>
				<button class="residence-table-arrow" id="reclamation-table-next"><i class="bx bx-chevron-right"></i></button>
			</div>
		</div>
	</div>
	<div class="residence-page-content" data-page="2" style="display: none;">
		<div class="liquid-glass-table-container">
			<h3 style="margin-bottom:1.5rem;">Responses</h3>
			<div class="residence-table-toolbar">
				<div style="display: flex; align-items: center;"></div>
				<div style="display: flex; gap: 0.75rem; align-items: center;">
					<button class="residence-sort-dir-pill" id="reponse-sort-dir-pill" title="Toggle Sort Direction">
						<span id="reponse-sort-dir-icon-svg"></span>
					</button>
					<div class="residence-sort-pill" id="reponse-sort-pill-custom" tabindex="0">
						<span class="residence-sort-selected" id="reponse-sort-selected">Sort by Message</span>
						<span class="residence-sort-arrow"></span>
						<div class="residence-sort-dropdown" id="reponse-sort-dropdown" style="display:none;">
							<div class="residence-sort-option" data-value="message">Message</div>
							<div class="residence-sort-option" data-value="date">Date</div>
							<div class="residence-sort-option" data-value="user">User</div>
							<div class="residence-sort-option" data-value="reclamation">Reclamation</div>
						</div>
					</div>
					<div class="residence-search-pill">
						<input type="text" class="residence-search-input" id="reponse-search-input" placeholder="Search responses..." />
						<i class="bx bx-search residence-search-icon"></i>
					</div>
				</div>
			</div>
			<div class="liquid-glass-table-scroll">
				<table class="liquid-glass-table" id="reponse-table">
					<thead>
						<tr>
							<th>Message</th>
							<th>User</th>
							<th>Reclamation</th>
							<th>Date</th>
							<th>Details</th>
						</tr>
					</thead>
					<tbody id="reponse-table-body">
						<!-- Dynamic rows from reponseData -->
					</tbody>
				</table>
			</div>
			<div class="table-pagination-bar">
				<button class="residence-table-arrow" id="reponse-table-prev"><i class="bx bx-chevron-left"></i></button>
				<div class="residence-table-pages" id="reponse-table-pages"></div>
				<button class="residence-table-arrow" id="reponse-table-next"><i class="bx bx-chevron-right"></i></button>
			</div>
		</div>
	</div>
	<div class="residence-page-content" data-page="3" style="display: none;">
		<div class="liquid-glass-table-container">
			<h3 style="margin-bottom:1.5rem;">Page 3</h3>
			<p style="color: rgba(191,201,216,0.8);">Content placeholder.</p>
		</div>
	</div>
	<div class="residence-page-content" data-page="4" style="display: none;">
		<div class="liquid-glass-table-container">
			<h3 style="margin-bottom:1.5rem;">Page 4</h3>
			<p style="color: rgba(191,201,216,0.8);">Content placeholder.</p>
		</div>
	</div>
</div>

<style>
	/* Table & pagination – match Residence exactly */
	.liquid-glass-table-container { background: rgba(30, 34, 44, 0.7); border-radius: 24px; box-shadow: 0 8px 32px rgba(0,0,0,0.25); backdrop-filter: blur(18px); padding: 2.5rem 3rem 2rem 3rem; border: 1.5px solid rgba(255,255,255,0.08); }
	.liquid-glass-table-scroll { overflow-x: auto; margin-top: 1.75rem; }
	.liquid-glass-table { width: 100%; border-collapse: separate; border-spacing: 0; background: rgba(255,255,255,0.04); border-radius: 20px; overflow: hidden; color:#e3e8f7; border: 1px solid rgba(255,255,255,0.06); }
	.liquid-glass-table th { background: rgba(255,255,255,0.12); padding: 1.4rem; font-weight: 800; color:#fff; text-align: center; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; }
	.liquid-glass-table td { padding: 1.4rem; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.08); vertical-align: middle; }
	.table-pagination-bar { display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 3rem; }
	.residence-table-arrow { width: 48px; height: 48px; border-radius: 50%; border: none; background: rgba(255,255,255,0.07); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s; font-size: 1.8rem; border: 1px solid rgba(255,255,255,0.1); }
	.residence-table-arrow:hover:not(:disabled) { background: #0072ff; transform: scale(1.1); box-shadow: 0 0 20px rgba(0, 114, 255, 0.5); }
	.residence-table-arrow:disabled { opacity: 0.2; cursor: not-allowed; }
	.residence-table-page-btn { padding: 0.6rem 1.4rem; border-radius: 999px; border: none; background: transparent; color: #bfc9d8; cursor: pointer; transition: all 0.25s; font-weight: 700; font-size: 1rem; }
	.residence-table-page-btn.active { background: #0072ff; color: #fff; box-shadow: 0 6px 15px rgba(0, 114, 255, 0.4); }
	.users-btn-modify { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); color: #fff; box-shadow: 0 10px 25px rgba(0, 114, 255, 0.3); border: none; border-radius: 14px; padding: 0.9rem 1.75rem; font-size: 1.05rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 0.75rem; transition: all 0.3s; }
	.users-btn-modify:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0, 114, 255, 0.45); }
	.users-btn-cancel { background: rgba(255, 255, 255, 0.08); color: #bfc9d8; border: none; border-radius: 14px; padding: 0.9rem 1.75rem; font-size: 1.05rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 0.75rem; transition: all 0.3s; }
	.users-btn-cancel:hover { background: rgba(255, 255, 255, 0.15); color: #fff; transform: translateY(-2px); }
	.users-btn-delete { background: linear-gradient(135deg, #ff3b30 0%, #ff2d92 100%); color: #fff; box-shadow: 0 10px 25px rgba(255, 45, 146, 0.25); border: none; border-radius: 14px; padding: 0.9rem 1.75rem; font-size: 1.05rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 0.75rem; transition: all 0.3s; }
	.users-btn-delete:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(255, 45, 146, 0.4); }
	.users-edit-modal { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 2rem; }
	.users-edit-modal-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(8px); cursor: pointer; }
	.users-edit-modal-card { position: relative; background: linear-gradient(165deg, rgba(32, 38, 52, 0.98) 0%, rgba(20, 24, 32, 0.98) 100%); border-radius: 24px; box-shadow: 0 25px 80px rgba(0,0,0,0.7); max-width: 800px; width: 100%; border: 1px solid rgba(255,255,255,0.12); overflow: visible; max-height: 90vh; display: flex; flex-direction: column; }
	.users-edit-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.75rem 2.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
	.users-edit-modal-header h3 { margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff; }
	.users-edit-modal-subtitle { margin: 0.5rem 0 0 0; font-size: 0.9rem; color: rgba(191,201,216,0.8); }
	.users-edit-modal-close { background: rgba(255,255,255,0.08); border: none; color: #bfc9d8; width: 2.4rem; height: 2.4rem; border-radius: 50%; font-size: 1.6rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.25s ease; }
	.users-edit-modal-close:hover { background: rgba(255,255,255,0.15); color: #fff; transform: rotate(90deg); }
	.users-edit-modal-body { padding: 2.25rem 2.5rem; overflow-y: auto; scrollbar-width: none; }
	.users-edit-modal-body::-webkit-scrollbar { display: none; }
	.users-edit-modal-actions { display: flex; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 1rem; align-items: center; }
	.users-edit-modal-actions-spacer { flex: 1; }
	.forum-view-row { display: flex; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
	.forum-view-label { min-width: 120px; font-size: 0.9rem; font-weight: 700; color: rgba(191,201,216,0.7); text-transform: uppercase; letter-spacing: 0.08em; }
	.forum-view-value { flex: 1; font-size: 1.05rem; color: #e3e8f7; line-height: 1.6; }
	.residence-form-group { margin-bottom: 1.75rem; width: 100%; display: flex; flex-direction: column; }
	.residence-edit-label { display: block; margin-bottom: 0.75rem; color: #bfc9d8; font-weight: 600; font-size: 0.95rem; }
	.residence-edit-input { width: 100%; border: 1px solid rgba(255, 255, 255, 0.12); padding: 0.95rem 1.25rem; border-radius: 16px; background: rgba(0, 0, 0, 0.3); color: #fff; font-size: 1rem; outline: none; }
	.residence-edit-input:focus { border-color: rgba(0, 198, 255, 0.5); border-left: 4px solid #00c6ff; }
</style>

<!-- View Reclamation Modal (like Residence view modal) -->
<div id="reclamation-view-modal" class="users-edit-modal" style="display: none;">
	<div class="users-edit-modal-backdrop" onclick="closeModal('reclamation-view-modal')"></div>
	<div class="users-edit-modal-card">
		<div class="users-edit-modal-header">
			<div>
				<h3>Reclamation Overview</h3>
				<p class="users-edit-modal-subtitle">Detailed information from the reclamation database</p>
			</div>
			<button type="button" class="users-edit-modal-close" onclick="closeModal('reclamation-view-modal')">&times;</button>
		</div>
		<div class="users-edit-modal-body">
			<div class="forum-view-row">
				<div class="forum-view-label">Title</div>
				<div class="forum-view-value" id="view-reclamation-title" style="font-weight: 700;">—</div>
			</div>
			<div class="forum-view-row">
				<div class="forum-view-label">Description</div>
				<div class="forum-view-value" id="view-reclamation-description">—</div>
			</div>
			<div class="forum-view-row">
				<div class="forum-view-label">User</div>
				<div class="forum-view-value" id="view-reclamation-user">—</div>
			</div>
			<div class="forum-view-row">
				<div class="forum-view-label">Status</div>
				<div class="forum-view-value" id="view-reclamation-status">—</div>
			</div>
			<div class="forum-view-row">
				<div class="forum-view-label">Date</div>
				<div class="forum-view-value" id="view-reclamation-date" style="opacity: 0.8;">—</div>
			</div>
            <div class="forum-view-row" id="view-reclamation-images-row" style="display:none;">
                <div class="forum-view-label">Attachments</div>
                <div class="forum-view-value">
                    <div id="view-reclamation-images-container" style="display: flex; gap: 1rem; flex-wrap: wrap;"></div>
                </div>
            </div>
			<div class="users-edit-modal-actions">
				<button type="button" class="users-btn-cancel" onclick="closeModal('reclamation-view-modal')">Close</button>
				<span class="users-edit-modal-actions-spacer"></span>
				<button type="button" class="users-btn-modify" id="btn-trigger-reclamation-edit">
					<i class="bx bx-edit-alt"></i> Edit Record
				</button>
				<form method="post" id="view-reclamation-delete-form" style="display: inline;" data-ajax="true">
					<input type="hidden" name="_token" id="view-reclamation-delete-token" value="{{ csrf_token('delete_reclamation') }}">
					<button type="submit" class="users-btn-delete">
						<i class="bx bx-trash-alt"></i> Delete
					</button>
				</form>
			</div>
		</div>
	</div>
</div>

<!-- Edit Reclamation Modal (like Residence edit modal) -->
<div id="reclamation-edit-modal" class="users-edit-modal" style="display: none; z-index: 10001;">
	<div class="users-edit-modal-backdrop" onclick="closeModal('reclamation-edit-modal')"></div>
	<div class="users-edit-modal-card">
		<div class="users-edit-modal-header">
			<div>
				<h3>Edit Reclamation</h3>
				<p class="users-edit-modal-subtitle">Update and synchronize reclamation information</p>
			</div>
			<button type="button" class="users-edit-modal-close" onclick="closeModal('reclamation-edit-modal')">&times;</button>
		</div>
		<form id="reclamation-edit-form" class="users-edit-modal-body" enctype="multipart/form-data">
			<div class="residence-form-group">
				<label class="residence-edit-label">Title</label>
				<input type="text" name="title" id="edit-reclamation-title" class="residence-edit-input" required>
			</div>
			<div class="residence-form-group">
				<label class="residence-edit-label">Description</label>
				<textarea name="description" id="edit-reclamation-description" class="residence-edit-input" rows="4" required></textarea>
			</div>
			<div class="residence-form-group">
				<label class="residence-edit-label">Status</label>
				<select name="status" id="edit-reclamation-status" class="residence-edit-input" required>
					<option value="active">Active</option>
					<option value="en_attente">In Progress</option>
					<option value="refuse">Rejected</option>
					<option value="termine">Completed</option>
				</select>
			</div>
            
            <div class="residence-form-group" style="margin-bottom: 2.5rem;">
                <label class="residence-edit-label">Attachments (Images)</label>
                <div class="custom-file-wrapper" style="border: 2px dashed rgba(255,255,255,0.1); border-radius: 16px; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.3s; background: rgba(0,0,0,0.2);">
                    <input type="file" name="images[]" id="edit-reclamation-images" class="hidden-select" multiple accept="image/*" style="display: none;">
                    <div class="custom-file-trigger" onclick="document.getElementById('edit-reclamation-images').click()">
                        <div class="custom-file-icon" style="font-size: 3rem; color: #00c6ff; margin-bottom: 1rem;"><i class="bx bx-images"></i></div>
                        <div class="custom-file-text" style="color: #fff; font-weight: 600; font-size: 1.1rem;">Click to upload images...</div>
                        <div id="edit-reclamation-file-count" style="color: rgba(191,201,216,0.6); margin-top: 0.5rem; font-size: 0.9rem;">No files selected</div>
                    </div>
                </div>
            </div>
			<div class="users-edit-modal-actions">
				<button type="button" class="users-btn-cancel" onclick="closeModal('reclamation-edit-modal')">Discard</button>
				<span class="users-edit-modal-actions-spacer"></span>
				<button type="submit" class="users-btn-modify">Update Reclamation</button>
			</div>
		</form>
	</div>
</div>

<!-- Delete Confirmation Modal (like Residence custom-confirm-modal) -->
<div id="reclamation-confirm-modal" class="users-edit-modal" style="display: none;">
	<div class="users-edit-modal-backdrop" onclick="closeModal('reclamation-confirm-modal')"></div>
	<div class="users-edit-modal-card" style="max-width: 480px;">
		<div class="users-edit-modal-body" style="text-align: center; padding: 3rem 2.5rem;">
			<div style="width: 80px; height: 80px; background: rgba(255,59,48,0.13); color:#ff3b30; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:3rem; margin:0 auto 1.75rem auto;">
				<i class="bx bx-trash-alt"></i>
			</div>
			<h3 style="color:#fff; margin-bottom:1rem; font-size: 1.6rem; font-weight: 800;">Permanent Deletion?</h3>
			<p style="color:rgba(191,201,216,0.85); font-size:1.05rem; margin-bottom:2.5rem; line-height: 1.6;">Are you absolutely certain? Removing this reclamation will irrevocably delete all associated records.</p>
			<div style="display: flex; gap: 1.5rem;">
				<button type="button" class="users-btn-cancel" style="flex:1; justify-content: center;" onclick="closeModal('reclamation-confirm-modal')">Keep Reclamation</button>
				<button type="button" id="confirm-reclamation-delete-btn" class="users-btn-delete" style="flex:1; justify-content:center;">Confirm Delete</button>
			</div>
		</div>
	</div>
</div>

