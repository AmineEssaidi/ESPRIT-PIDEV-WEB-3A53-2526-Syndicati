<script>
document.addEventListener('DOMContentLoaded', function() {
	// Reclamation data from backend (no demo data)
	window.reclamationData = [
		{% for rec in reclamations %}
		{
			id: {{ rec.id }},
			title: {{ rec.titrereclamations|json_encode|raw }},
			description: {{ rec.descreclamation|json_encode|raw }},
			user: {{ (rec.user ? rec.user.emailUser : 'N/A')|json_encode|raw }},
			status: {{ (rec.statutreclamation|default('en_attente'))|json_encode|raw }},
			date: "{{ rec.createdAt ? rec.createdAt|date('Y-m-d H:i') : (rec.datereclamation ? rec.datereclamation|date('Y-m-d H:i') : '') }}",
			images: {{ rec.imagereclamation|json_encode|raw }} // Safer: output as string literal, then parsed in JS
		}{% if not loop.last %},{% endif %}
		{% endfor %}
	];
	const statusLabels = {
		'active': 'Active',
		'en_attente': 'In Progress',
		'refuse': 'Rejected',
		'termine': 'Completed'
	};

	const rowsPerPage = 10;
	let currentPage = 1;
	let sortValue = 'title';
	let sortDirection = 'asc';
	let filteredData = [...window.reclamationData];

	function renderReclamationTable() {
		const tbody = document.getElementById('reclamation-table-body');
		if (!tbody) return;
		tbody.innerHTML = '';

		if (filteredData.length === 0) {
			tbody.innerHTML = '<tr><td colspan="6" style="padding: 5rem; opacity: 0.5; font-size: 1.2rem; font-weight: 500;">No reclamations match your search.</td></tr>';
			renderReclamationPagination();
			return;
		}

		const start = (currentPage - 1) * rowsPerPage;
		const end = Math.min(start + rowsPerPage, filteredData.length);

		for (let i = start; i < end; i++) {
			const r = filteredData[i];
			const desc = (r.description || '').length > 80 ? (r.description || '').slice(0, 80) + '...' : (r.description || '');
			const statusLabel = statusLabels[r.status] || r.status;
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="font-weight: 800; color: #fff; font-size: 1.05rem;">${escapeHtml(r.title)}</td>
				<td style="opacity: 0.9; max-width: 280px; text-align: left;">${escapeHtml(desc)}</td>
				<td style="opacity: 0.9;">${escapeHtml(r.user)}</td>
				<td><span class="badge" style="background:rgba(0,198,255,0.15); color:#00c6ff; padding:0.5rem 1rem; border-radius:12px; border: 1px solid rgba(0,198,255,0.2); font-weight: 700;">${escapeHtml(statusLabel)}</span></td>
				<td><span style="opacity: 0.7; font-size: 0.9rem;">${escapeHtml(r.date)}</span></td>
				<td>
					<button class="users-btn-modify" onclick="viewReclamationDetails(${r.id})" style="padding: 0.5rem 1.25rem; font-size: 0.95rem; border-radius: 12px;">
						<i class="bx bxs-file-find"></i> Results
					</button>
				</td>
			`;
			tbody.appendChild(tr);
		}
		renderReclamationPagination();
	}

	function escapeHtml(str) {
		if (str == null) return '';
		const div = document.createElement('div');
		div.textContent = str;
		return div.innerHTML;
	}

	function closeModal(id) {
		const modal = document.getElementById(id);
		if (modal) modal.style.display = 'none';
	}
	function openModal(id) {
		const modal = document.getElementById(id);
		if (modal) modal.style.display = 'flex';
	}
	window.closeModal = closeModal;
	window.openModal = openModal;

	function viewReclamationDetails(id) {
		const r = window.reclamationData.find(function(item) { return item.id == id; });
		if (!r) return;

		document.getElementById('view-reclamation-title').textContent = r.title || '—';
		document.getElementById('view-reclamation-description').textContent = r.description || '—';
		document.getElementById('view-reclamation-user').textContent = r.user || '—';
		document.getElementById('view-reclamation-date').textContent = r.date || '—';
		document.getElementById('view-reclamation-status').textContent = statusLabels[r.status] || r.status || '—';

        // Images Logic
        const imgRow = document.getElementById('view-reclamation-images-row');
        const imgContainer = document.getElementById('view-reclamation-images-container');
        imgContainer.innerHTML = '';
        
        let images = [];
        try {
            if (typeof r.images === 'string') {
                images = JSON.parse(r.images);
            } else if (Array.isArray(r.images)) {
                images = r.images;
            }
        } catch(e) { console.error('Error parsing images JSON', e); }

        if (images && images.length > 0) {
            imgRow.style.display = 'flex';
            images.forEach(img => {
                const wrapper = document.createElement('div');
                wrapper.style.width = '100px';
                wrapper.style.height = '100px';
                wrapper.style.borderRadius = '12px';
                wrapper.style.overflow = 'hidden';
                wrapper.style.border = '1px solid rgba(255,255,255,0.1)';
                
                const elem = document.createElement('img');
                // Assuming backend stores relative path like 'folder/image.jpg' and public access is direct or via /uploads/reclamations/
                // Adjust base path as needed. Based on controller: $this->getParameter('reclamations_directory')
                // Usually symfony public access might need '/uploads/reclamations/' prepended if not in db path.
                // Let's assume DB path is relative to public/uploads/reclamations or similar. 
                // Wait, Controller stores: $folderName . '/' . $newFilename.
                // So we need to know the public prefix.
                // Correct path based on services.yaml: reclamations_directory: '%kernel.project_dir%/public/reclamation_images'
                // Controller stores 'Folder/File.jpg'
                // So public URL is '/reclamation_images/Folder/File.jpg'
                elem.src = '/reclamation_images/' + img; 
                elem.style.width = '100%';
                elem.style.height = '100%';
                elem.style.objectFit = 'cover';
                elem.style.cursor = 'pointer';
                elem.onerror = function() { this.style.display = 'none'; }; // Hide if broken
                elem.onclick = () => window.open(elem.src, '_blank');
                
                wrapper.appendChild(elem);
                imgContainer.appendChild(wrapper);
            });
        } else {
            imgRow.style.display = 'none';
        }

		document.getElementById('btn-trigger-reclamation-edit').onclick = function() { openEditReclamationModal(r.id); };

		var deleteForm = document.getElementById('view-reclamation-delete-form');
		document.getElementById('view-reclamation-delete-token').value = '{{ csrf_token('delete_reclamation') }}';
		var newDeleteForm = deleteForm.cloneNode(true);
		deleteForm.parentNode.replaceChild(newDeleteForm, deleteForm);

		newDeleteForm.onsubmit = function(e) {
			e.preventDefault();
			openModal('reclamation-confirm-modal');
			var confirmBtn = document.getElementById('confirm-reclamation-delete-btn');
			var newConfirmBtn = confirmBtn.cloneNode(true);
			confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
			newConfirmBtn.onclick = function() {
				var originalText = newConfirmBtn.innerHTML;
				newConfirmBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Processing...';
				newConfirmBtn.disabled = true;
				fetch('/admin/syndicat/reclamation/' + r.id + '/delete', {
					method: 'POST',
					body: new FormData(newDeleteForm)
				}).then(function(response) {
					if (response.redirected) {
						window.location.href = response.url;
					} else if (response.ok) {
						window.location.reload();
					} else {
						alert('Failed to delete reclamation.');
						newConfirmBtn.innerHTML = originalText;
						newConfirmBtn.disabled = false;
					}
				}).catch(function(err) {
					alert('An error occurred.');
					newConfirmBtn.innerHTML = originalText;
					newConfirmBtn.disabled = false;
				});
			};
		};

		openModal('reclamation-view-modal');
	}
	window.viewReclamationDetails = viewReclamationDetails;

	function openEditReclamationModal(id) {
		closeModal('reclamation-view-modal');
		var r = window.reclamationData.find(function(item) { return item.id == id; });
		if (!r) return;

		document.getElementById('edit-reclamation-title').value = r.title || '';
		document.getElementById('edit-reclamation-description').value = r.description || '';
		document.getElementById('edit-reclamation-status').value = r.status || 'en_attente';
        
        // Reset file input
        const fileInput = document.getElementById('edit-reclamation-images');
        const fileCount = document.getElementById('edit-reclamation-file-count');
        fileInput.value = '';
        fileCount.textContent = 'No files selected';
        
        fileInput.onchange = function() {
            if(this.files && this.files.length > 0) {
                fileCount.textContent = this.files.length + ' file(s) selected';
                fileCount.style.color = '#00c6ff';
            } else {
                fileCount.textContent = 'No files selected';
                fileCount.style.color = 'rgba(191,201,216,0.6)';
            }
        };

		var form = document.getElementById('reclamation-edit-form');
		form.onsubmit = function(e) {
			e.preventDefault();
			var formData = new FormData(form);
			var btn = form.querySelector('button[type="submit"]');
			var originalText = btn.innerHTML;
			btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Updating...';
			btn.disabled = true;
			fetch('/api/syndicat/reclamation/update/' + r.id, { method: 'POST', body: formData })
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (data.success) {
						// Reload to reflect changes (especially images) and reset UI state
						window.location.reload();
						return; 
					} else {
						alert(data.message || 'Update failed.');
					}
					btn.innerHTML = originalText;
					btn.disabled = false;

				})
				.catch(function() {
					alert('An error occurred.');
					btn.innerHTML = originalText;
					btn.disabled = false;
				});
		};
		openModal('reclamation-edit-modal');
	}
	window.openEditReclamationModal = openEditReclamationModal;

	function renderReclamationPagination() {
		const totalPages = Math.ceil(filteredData.length / rowsPerPage);
		const pagesDiv = document.getElementById('reclamation-table-pages');
		if (!pagesDiv) return;
		pagesDiv.innerHTML = '';

		for (let i = 1; i <= totalPages; i++) {
			const btn = document.createElement('button');
			btn.className = 'residence-table-page-btn' + (i === currentPage ? ' active' : '');
			btn.textContent = i;
			btn.onclick = function() { currentPage = i; renderReclamationTable(); };
			pagesDiv.appendChild(btn);
		}

		const prevEl = document.getElementById('reclamation-table-prev');
		const nextEl = document.getElementById('reclamation-table-next');
		if (prevEl) prevEl.disabled = currentPage === 1;
		if (nextEl) nextEl.disabled = currentPage === totalPages || totalPages === 0;
	}

	function filterAndSortReclamations() {
		const searchInput = document.getElementById('reclamation-search-input');
		const search = (searchInput ? searchInput.value : '').toLowerCase();
		filteredData = window.reclamationData.filter(r =>
			(r.title || '').toLowerCase().includes(search) ||
			(r.description || '').toLowerCase().includes(search) ||
			(r.user || '').toLowerCase().includes(search) ||
			(r.status || '').toLowerCase().includes(search)
		);

		filteredData.sort((a, b) => {
			let valA = a[sortValue];
			let valB = b[sortValue];
			if (sortValue === 'date') {
				valA = (a.date || '').toString();
				valB = (b.date || '').toString();
			} else {
				valA = String(valA || '').toLowerCase();
				valB = String(valB || '').toLowerCase();
			}
			const cmp = valA > valB ? 1 : (valA < valB ? -1 : 0);
			return sortDirection === 'asc' ? cmp : -cmp;
		});

		currentPage = 1;
		renderReclamationTable();
	}

	// Pill tab navigation (match Residence)
	function switchPage(pageNumber) {
		document.querySelectorAll('.pill-tab').forEach(function(tab) {
			tab.classList.toggle('active', tab.dataset.page === String(pageNumber));
		});
		document.querySelectorAll('#syndicat-content .residence-page-content').forEach(function(content) {
			content.style.display = content.dataset.page === String(pageNumber) ? 'block' : 'none';
		});
	}
	document.querySelectorAll('.pill-tab').forEach(function(tab) {
		tab.addEventListener('click', function() {
			switchPage(parseInt(this.dataset.page, 10));
		});
	});

	// Sort dropdown
	const sortPill = document.getElementById('reclamation-sort-pill-custom');
	const sortDropdown = document.getElementById('reclamation-sort-dropdown');
	const sortSelected = document.getElementById('reclamation-sort-selected');
	if (sortPill && sortDropdown) {
		sortPill.addEventListener('click', function(e) {
			e.stopPropagation();
			sortDropdown.style.display = sortDropdown.style.display === 'flex' ? 'none' : 'flex';
		});
		document.querySelectorAll('#reclamation-sort-dropdown .residence-sort-option').forEach(function(opt) {
			opt.addEventListener('click', function() {
				sortValue = this.dataset.value;
				sortSelected.textContent = this.textContent;
				document.querySelectorAll('#reclamation-sort-dropdown .residence-sort-option').forEach(function(o) { o.classList.remove('active'); });
				this.classList.add('active');
				sortDropdown.style.display = 'none';
				filterAndSortReclamations();
			});
		});
		document.addEventListener('click', function(e) {
			if (sortPill && !sortPill.contains(e.target)) sortDropdown.style.display = 'none';
		});
	}

	// Sort direction icon & toggle
	const sortDirBtn = document.getElementById('reclamation-sort-dir-pill');
	const sortDirIcon = document.getElementById('reclamation-sort-dir-icon-svg');
	function updateSortDirIcon() {
		if (sortDirIcon) {
			sortDirIcon.innerHTML = sortDirection === 'asc'
				? '<i class="bx bx-sort-a-z" style="color:#00c6ff; font-size:1.7rem;"></i>'
				: '<i class="bx bx-sort-z-a" style="color:#00c6ff; font-size:1.7rem;"></i>';
		}
	}
	updateSortDirIcon();
	if (sortDirBtn) {
		sortDirBtn.addEventListener('click', function() {
			sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
			updateSortDirIcon();
			filterAndSortReclamations();
		});
	}

	// Search input
	const searchInput = document.getElementById('reclamation-search-input');
	if (searchInput) searchInput.addEventListener('input', filterAndSortReclamations);

	// Pagination arrows
	const prevBtn = document.getElementById('reclamation-table-prev');
	const nextBtn = document.getElementById('reclamation-table-next');
	if (prevBtn) prevBtn.addEventListener('click', function() {
		if (currentPage > 1) { currentPage--; renderReclamationTable(); }
	});
	if (nextBtn) nextBtn.addEventListener('click', function() {
		const totalPages = Math.ceil(filteredData.length / rowsPerPage);
		if (currentPage < totalPages) { currentPage++; renderReclamationTable(); }
	});

	// Initial render
	filterAndSortReclamations();

	/* ==================== RESPONSES SECTION (Page 2) ==================== */
	// Response data from backend
	window.reponseData = [
		{% if reponses is defined %}
		{% for rep in reponses %}
		{
			id: {{ rep.id }},
			title: {{ rep.titrereponse|json_encode|raw }},
			message: {{ rep.messagereponse|json_encode|raw }},
			user: {{ (rep.user ? rep.user.emailUser : 'N/A')|json_encode|raw }},
			reclamation: {{ (rep.reclamation ? rep.reclamation.titrereclamations : 'N/A')|json_encode|raw }},
			date: "{{ rep.createdAt ? rep.createdAt|date('Y-m-d H:i') : '' }}",
			images: {{ rep.imagereponse|json_encode|raw }}
		}{% if not loop.last %},{% endif %}
		{% endfor %}
		{% endif %}
	];

	const repRowsPerPage = 10;
	let repCurrentPage = 1;
	let repSortValue = 'message';
	let repSortDirection = 'asc';
	let repFilteredData = [...window.reponseData];

	function renderReponseTable() {
		const tbody = document.getElementById('reponse-table-body');
		if (!tbody) return;
		tbody.innerHTML = '';
		const start = (repCurrentPage - 1) * repRowsPerPage;
		const end = start + repRowsPerPage;
		const pageData = repFilteredData.slice(start, end);
		pageData.forEach(function(r) {
			const row = document.createElement('tr');
			row.style.cursor = 'pointer';
			row.innerHTML = `
				<td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${r.message || '—'}</td>
				<td>${r.user || '—'}</td>
				<td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${r.reclamation || '—'}</td>
				<td>${r.date || '—'}</td>
				<td>
					<button class="users-btn-modify" onclick="openViewReponseModal(${r.id})" style="padding: 0.5rem 1.25rem; font-size: 0.95rem; border-radius: 12px;">
						<i class="bx bxs-file-find"></i> Results
					</button>
				</td>
			`;
			tbody.appendChild(row);
		});
		renderReponsePagination();
	}

	function renderReponsePagination() {
		const pagesContainer = document.getElementById('reponse-table-pages');
		if (!pagesContainer) return;
		pagesContainer.innerHTML = '';
		const totalPages = Math.ceil(repFilteredData.length / repRowsPerPage);
		for (let i = 1; i <= totalPages; i++) {
			const btn = document.createElement('button');
			btn.className = 'residence-table-page-btn';
			if (i === repCurrentPage) btn.classList.add('active');
			btn.textContent = i;
			btn.addEventListener('click', function() {
				repCurrentPage = i;
				renderReponseTable();
			});
			pagesContainer.appendChild(btn);
		}
	}

	function filterAndSortReponses() {
		const searchTerm = document.getElementById('reponse-search-input').value.toLowerCase();
		repFilteredData = window.reponseData.filter(function(r) {
			return (r.message && r.message.toLowerCase().includes(searchTerm)) ||
				   (r.user && r.user.toLowerCase().includes(searchTerm)) ||
				   (r.reclamation && r.reclamation.toLowerCase().includes(searchTerm));
		});
		repFilteredData.sort(function(a, b) {
			let aVal = a[repSortValue] || '';
			let bVal = b[repSortValue] || '';
			if (typeof aVal === 'string') aVal = aVal.toLowerCase();
			if (typeof bVal === 'string') bVal = bVal.toLowerCase();
			if (aVal < bVal) return repSortDirection === 'asc' ? -1 : 1;
			if (aVal > bVal) return repSortDirection === 'asc' ? 1 : -1;
			return 0;
		});
		repCurrentPage = 1;
		renderReponseTable();
	}

	// Sort dropdown
	const repSortPill = document.getElementById('reponse-sort-pill-custom');
	const repSortDropdown = document.getElementById('reponse-sort-dropdown');
	const repSortSelected = document.getElementById('reponse-sort-selected');
	if (repSortPill && repSortDropdown) {
		repSortPill.addEventListener('click', function(e) {
			e.stopPropagation();
			repSortDropdown.style.display = repSortDropdown.style.display === 'flex' ? 'none' : 'flex';
		});
		document.querySelectorAll('#reponse-sort-dropdown .residence-sort-option').forEach(function(opt) {
			opt.addEventListener('click', function() {
				repSortValue = this.dataset.value;
				repSortSelected.textContent = this.textContent;
				document.querySelectorAll('#reponse-sort-dropdown .residence-sort-option').forEach(function(o) { o.classList.remove('active'); });
				this.classList.add('active');
				repSortDropdown.style.display = 'none';
				filterAndSortReponses();
			});
		});
		document.addEventListener('click', function(e) {
			if (repSortPill && !repSortPill.contains(e.target)) repSortDropdown.style.display = 'none';
		});
	}

	// Sort direction
	const repSortDirBtn = document.getElementById('reponse-sort-dir-pill');
	const repSortDirIcon = document.getElementById('reponse-sort-dir-icon-svg');
	function updateRepSortDirIcon() {
		if (repSortDirIcon) {
			repSortDirIcon.innerHTML = repSortDirection === 'asc'
				? '<i class="bx bx-sort-a-z" style="color:#00c6ff; font-size:1.7rem;"></i>'
				: '<i class="bx bx-sort-z-a" style="color:#00c6ff; font-size:1.7rem;"></i>';
		}
	}
	updateRepSortDirIcon();
	if (repSortDirBtn) {
		repSortDirBtn.addEventListener('click', function() {
			repSortDirection = repSortDirection === 'asc' ? 'desc' : 'asc';
			updateRepSortDirIcon();
			filterAndSortReponses();
		});
	}

	// Search input
	const repSearchInput = document.getElementById('reponse-search-input');
	if (repSearchInput) repSearchInput.addEventListener('input', filterAndSortReponses);

	// Pagination arrows
	const repPrevBtn = document.getElementById('reponse-table-prev');
	const repNextBtn = document.getElementById('reponse-table-next');
	if (repPrevBtn) repPrevBtn.addEventListener('click', function() {
		if (repCurrentPage > 1) { repCurrentPage--; renderReponseTable(); }
	});
	if (repNextBtn) repNextBtn.addEventListener('click', function() {
		const totalPages = Math.ceil(repFilteredData.length / repRowsPerPage);
		if (repCurrentPage < totalPages) { repCurrentPage++; renderReponseTable(); }
	});

	// Initial render for responses
	filterAndSortReponses();

	// Open View Modal
	window.openViewReponseModal = function(id) {
		const rep = window.reponseData.find(r => r.id === id);
		if (!rep) return;
		document.getElementById('view-reponse-title').textContent = rep.title || '—';
		document.getElementById('view-reponse-message').textContent = rep.message || '—';
		document.getElementById('view-reponse-user').textContent = rep.user || '—';
		document.getElementById('view-reponse-reclamation').textContent = rep.reclamation || '—';
		document.getElementById('view-reponse-date').textContent = rep.date || '—';
		
		// Handle images
		const imagesRow = document.getElementById('view-reponse-images-row');
		const imagesContainer = document.getElementById('view-reponse-images-container');
		imagesContainer.innerHTML = '';
		
		if (rep.images) {
			let imgArray = [];
			try {
				imgArray = typeof rep.images === 'string' ? JSON.parse(rep.images) : rep.images;
			} catch (e) {
				console.error('Failed to parse images:', e);
			}
			
		if (Array.isArray(imgArray) && imgArray.length > 0) {
				imgArray.forEach(function(img) {
					const wrapper = document.createElement('div');
					wrapper.style.width = '100px';
					wrapper.style.height = '100px';
					wrapper.style.borderRadius = '12px';
					wrapper.style.overflow = 'hidden';
					wrapper.style.border = '1px solid rgba(255,255,255,0.1)';

					const elem = document.createElement('img');
					elem.src = '/reponse_images/' + img;
					elem.style.width = '100%';
					elem.style.height = '100%';
					elem.style.objectFit = 'cover';
					elem.style.cursor = 'pointer';
					elem.onerror = function() { this.style.display = 'none'; };
					elem.onclick = function() { window.open(this.src, '_blank'); };
					
					wrapper.appendChild(elem);
					imagesContainer.appendChild(wrapper);
				});
				imagesRow.style.display = 'flex';
			} else {
				imagesRow.style.display = 'none';
			}
		} else {
			imagesRow.style.display = 'none';
		}
		
		// Store current ID for Edit/Delete buttons
		window.currentReponseId = id;
		
		// Show modal
		document.getElementById('reponse-view-modal').style.display = 'flex';
	};

	// Edit button from View modal
	document.getElementById('btn-trigger-reponse-edit').addEventListener('click', function() {
		closeModal('reponse-view-modal');
		openEditReponseModal(window.currentReponseId);
	});

	// Delete button from View modal
	document.getElementById('btn-trigger-reponse-delete').addEventListener('click', function() {
		closeModal('reponse-view-modal');
		openDeleteReponseModal(window.currentReponseId);
	});

	// Open Edit Modal
	function openEditReponseModal(id) {
		const rep = window.reponseData.find(r => r.id === id);
		if (!rep) return;
		document.getElementById('edit-reponse-title').value = rep.title || '';
		document.getElementById('edit-reponse-message').value = rep.message || '';
		
		// Reset file input
		const fileInput = document.getElementById('edit-reponse-images');
		if (fileInput) fileInput.value = '';
		const fileCount = document.getElementById('edit-reponse-file-count');
		if (fileCount) fileCount.textContent = 'No files selected';
		
		window.currentReponseId = id;
		document.getElementById('reponse-edit-modal').style.display = 'flex';
	}
	
	// File input change handler for Reponse
	const repFileInput = document.getElementById('edit-reponse-images');
	if (repFileInput) {
		repFileInput.addEventListener('change', function() {
			const count = this.files ? this.files.length : 0;
			const label = document.getElementById('edit-reponse-file-count');
			if (label) label.textContent = count > 0 ? count + ' file(s) selected' : 'No files selected';
		});
	}

	// Handle Edit Form Submit
	const repEditForm = document.getElementById('reponse-edit-form');
	if (repEditForm) {
		repEditForm.onsubmit = function(e) {
			e.preventDefault();
			const btn = this.querySelector('.users-btn-modify');
			const originalText = btn.innerHTML;
			btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Updating...';
			btn.disabled = true;

			const formData = new FormData(this);
			
			fetch('/api/syndicat/reponse/update/' + window.currentReponseId, {
				method: 'POST',
				body: formData
			})
			.then(res => res.json())
			.then(data => {
				if (data.success) {
					window.location.reload(); 
				} else {
					alert(data.message || 'Update failed.');
					btn.innerHTML = originalText;
					btn.disabled = false;
				}
			})
			.catch(err => {
				console.error('Update error:', err);
				alert('Network error occurred.');
				btn.innerHTML = originalText;
				btn.disabled = false;
			});
		};
	}

	// Open Delete Confirmation Modal
	function openDeleteReponseModal(id) {
		window.currentReponseId = id;
		document.getElementById('reponse-confirm-modal').style.display = 'flex';
	}

	// Confirm Delete button
	document.getElementById('confirm-reponse-delete-btn').addEventListener('click', function() {
		const id = window.currentReponseId;
		if (!id) return;
		
		const btn = this;
		const originalText = btn.innerHTML;
		btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Deleting...';
		btn.disabled = true;

		fetch('/admin/syndicat/reponse/' + id + '/delete', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ _token: '{{ csrf_token('delete_reponse') }}' }) 
		})
				.then(res => res.json())
				.then(data => {
					if (data.success) {
						window.location.reload(); 
					} else {
						alert(data.message || 'Delete failed.');
						btn.innerHTML = originalText;
						btn.disabled = false;
					}
				})
				.catch(err => {
					console.error('Delete error:', err);
					alert('Network error occurred.');
					btn.innerHTML = originalText;
					btn.disabled = false;
				});
			});
});
</script>
{% endblock %}
