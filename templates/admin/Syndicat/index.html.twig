{% block stylesheets %}
	<style>
			/* --- Users-style pill, search, sort, dropdown, and arrow pill styles for Syndicat --- */
			.syndicat-table-toolbar { width: 100%; }
			.syndicat-search-pill {
				display: flex;
				align-items: center;
				background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
				border-radius: 999px;
				padding: 0.3rem 1.1rem 0.3rem 1.1rem;
				box-shadow: 0 2px 8px rgba(0,0,0,0.10);
				position: relative;
			}
			.syndicat-search-input {
				background: transparent;
				border: none;
				color: #fff;
				font-size: 1rem;
				outline: none;
				width: 160px;
				padding: 0.2rem 0.5rem 0.2rem 0;
			}
			.syndicat-search-icon {
				color: #bfc9d8;
				font-size: 1.2rem;
				margin-left: 0.3rem;
			}
			[data-theme="light"] .syndicat-sort-dir-pill {
				background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
				color: #23272f;
			}
			[data-theme="light"] .syndicat-sort-dir-icon svg polyline {
				stroke: #0072ff;
			}
			.syndicat-sort-dir-pill {
				background: linear-gradient(90deg, #2a2e39 0%, #23272f 100%);
				border: none;
				border-radius: 999px;
				padding: 0.3rem 0.7rem;
				box-shadow: 0 2px 8px rgba(0,0,0,0.10);
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: background 0.18s, color 0.18s;
				outline: none;
				font-size: 1.1rem;
				color: #fff;
			}
			.syndicat-sort-dir-pill:active, .syndicat-sort-dir-pill:focus {
				background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
			}
			.syndicat-sort-dir-icon {
				font-size: 1.2rem;
				color: #bfc9d8;
			}
						/* Users-style up/down arrow pill CSS for Syndicat */
						.syndicat-sort-dir-pill {
							background: linear-gradient(90deg, #2a2e39 0%, #23272f 100%);
							border: none;
							border-radius: 999px;
							padding: 0.3rem 0.7rem;
							box-shadow: 0 2px 8px rgba(0,0,0,0.10);
							display: flex;
							align-items: center;
							justify-content: center;
							cursor: pointer;
							transition: background 0.18s, color 0.18s;
							outline: none;
							font-size: 1.1rem;
							color: #fff;
						}
						.syndicat-sort-dir-pill:active, .syndicat-sort-dir-pill:focus {
							background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
						}
						.syndicat-sort-dir-icon {
							font-size: 1.2rem;
							color: #bfc9d8;
						}
			.syndicat-sort-pill {
				position: relative;
				z-index: 20;
				background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
				border-radius: 999px;
				padding: 0.3rem 1.1rem;
				box-shadow: 0 2px 8px rgba(0,123,255,0.10);
				display: flex;
				align-items: center;
				min-width: 160px;
				cursor: pointer;
				user-select: none;
				color: #fff;
				transition: background 0.18s, color 0.18s;
				overflow: visible;
			}
			[data-theme="light"] .syndicat-sort-pill {
				background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
				color: #fff !important;
				box-shadow: 0 2px 8px rgba(0,123,255,0.08);
			}
			.syndicat-sort-selected {
				flex: 1;
				font-size: 1rem;
				font-weight: 600;
				padding-right: 1.2rem;
			}
			.syndicat-sort-arrow {
				display: inline-block;
				width: 1.1em;
				height: 1.1em;
				background: url('data:image/svg+xml;utf8,<svg fill="white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>') no-repeat center/contain;
				margin-left: -1.1em;
				pointer-events: none;
			}
			.syndicat-sort-pill::after { display: none !important; }
			.syndicat-sort-dropdown {
				position: absolute;
				left: 0;
				top: 110%;
				min-width: 100%;
				background: rgba(30, 60, 120, 0.85);
				border-radius: 1.2em;
				box-shadow: 0 8px 32px rgba(0,198,255,0.18);
				backdrop-filter: blur(16px) saturate(160%);
				-webkit-backdrop-filter: blur(16px) saturate(160%);
				z-index: 10;
				padding: 0.3em 0;
				display: flex;
				flex-direction: column;
				gap: 0.1em;
				animation: syndicat-sort-dropdown-fade 0.18s cubic-bezier(.4,1.4,.6,1) both;
			}
			@keyframes syndicat-sort-dropdown-fade {
				0% { opacity: 0; transform: translateY(-10px) scale(0.98); }
				100% { opacity: 1; transform: translateY(0) scale(1); }
			}
			.syndicat-sort-option {
				padding: 0.7em 1.5em;
				border-radius: 1em;
				color: #fff;
				font-size: 1rem;
				cursor: pointer;
				transition: background 0.13s, color 0.13s;
			}
			.syndicat-sort-option:hover, .syndicat-sort-option.active {
				background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
				color: #fff;
			}
			[data-theme="light"] .syndicat-sort-dropdown {
				background: rgba(255,255,255,0.95);
				box-shadow: 0 8px 32px rgba(0,198,255,0.13);
			}
			[data-theme="light"] .syndicat-sort-option {
				color: #0072ff;
			}
			[data-theme="light"] .syndicat-sort-option:hover, [data-theme="light"] .syndicat-sort-option.active {
				background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
				color: #fff;
			}
			/* --- End Users-style pill, search, sort, dropdown, and arrow pill styles for Syndicat --- */
		/* Light theme improvements (copied from Users) */
		[data-theme="light"] .liquid-glass-table-container {
			background: rgba(255,255,255,0.85);
			border: 1.5px solid #e3e8f7;
			box-shadow: 0 8px 32px rgba(0,0,0,0.08);
		}
		[data-theme="light"] .liquid-glass-table {
			background: rgba(255,255,255,0.98);
			color: #23272f;
			box-shadow: 0 2px 12px rgba(0,0,0,0.04);
		}
		[data-theme="light"] .liquid-glass-table th {
			background: #f5f7fa;
			color: #23272f;
		}
		[data-theme="light"] .liquid-glass-table td {
			background: transparent;
			color: #23272f;
		}
		[data-theme="light"] .syndicat-btn-add-db {
			background: linear-gradient(90deg, #00bfae 0%, #00e676 100%);
			color: #fff;
			box-shadow: 0 2px 8px rgba(0,230,118,0.08);
		}
		[data-theme="light"] .syndicat-btn-add-db:hover {
			background: linear-gradient(90deg, #00e676 0%, #00bfae 100%);
		}
		[data-theme="light"] .syndicat-btn-modify {
			background: linear-gradient(90deg, #0072ff 0%, #00c6ff 100%);
			color: #fff;
		}
		[data-theme="light"] .syndicat-btn-delete {
			background: linear-gradient(90deg, #ff2d92 0%, #ff3b30 100%);
			color: #fff;
		}
		[data-theme="light"] .syndicat-pagination-pills {
			background: linear-gradient(135deg, #f5f7fa 80%, #e3e8f7 100%);
			box-shadow: 0 2px 12px rgba(0,0,0,0.04);
		}
		[data-theme="light"] .pill-tab {
			color: #23272f;
		}
		[data-theme="light"] .pill-tab.active, [data-theme="light"] .pill-tab:focus {
			color: #fff;
			text-shadow: 0 2px 8px rgba(0,123,255,0.10);
		}
		[data-theme="light"] .pill-slider {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			box-shadow: 0 4px 16px rgba(0,123,255,0.10);
		}
		[data-theme="light"] .syndicat-sort-dir-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
			color: #23272f;
		}
		[data-theme="light"] .syndicat-sort-dir-icon svg polyline {
			stroke: #0072ff;
		}
		[data-theme="light"] .syndicat-sort-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
		}
		[data-theme="light"] .syndicat-search-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
		}
		[data-theme="light"] .syndicat-search-input {
			color: #23272f;
		}
		[data-theme="light"] .syndicat-search-icon {
			color: #0072ff;
		}
		[data-theme="light"] .table-pagination-bar {
			background: transparent;
		}
		[data-theme="light"] .syndicat-table-arrow {
			background: #fff;
			color: #0072ff;
			border: 1px solid #e3e8f7;
		}
		[data-theme="light"] .syndicat-table-arrow svg polyline {
			stroke: #0072ff;
		}
		[data-theme="light"] .syndicat-table-page-btn {
			background: #fff;
			color: #23272f;
			border: 1px solid #e3e8f7;
		}
		[data-theme="light"] .syndicat-table-page-btn.active, [data-theme="light"] .syndicat-table-page-btn:hover {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			color: #fff;
			border: none;
		}
	</style>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Syndicat - Liquid Glass Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Syndicat' } %}
<div class="syndicat-pagination-wrapper" style="margin-top: 2rem;">
	<div class="syndicat-pagination-pills pills-animated">
		<div class="pill-slider-bar"></div>
		<div class="pill-slider"></div>
		<button class="pill-tab active" data-page="1">Page 1</button>
		<button class="pill-tab" data-page="2">Page 2</button>
		<button class="pill-tab" data-page="3">Page 3</button>
		<button class="pill-tab" data-page="4">Page 4</button>
	</div>
	<div id="syndicat-content" class="syndicat-content" style="margin-top: 1.5rem;">
		<div class="syndicat-page-content" data-page="1">
			<div class="liquid-glass-table-container">
				<h3 style="margin-bottom:1.5rem;">Demo Syndicat Table (Page 1)</h3>
				<div class="syndicat-table-toolbar" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
					<div style="display: flex; align-items: center;">
						<button class="syndicat-btn-add-db" title="Add Syndicat"><i class="bx bx-plus"></i> Add Syndicat</button>
					</div>
					<div style="display: flex; gap: 0.7rem; align-items: center;">
						<button class="syndicat-sort-dir-pill" id="syndicat-sort-dir-pill" title="Toggle Sort Direction" aria-label="Toggle Sort Direction">
							<span id="syndicat-sort-dir-icon-svg"></span>
						</button>
						<div class="syndicat-sort-pill" id="syndicat-sort-pill-custom" tabindex="0">
							<span class="syndicat-sort-selected" id="syndicat-sort-selected">Sort by Name</span>
							<span class="syndicat-sort-arrow"></span>
							<div class="syndicat-sort-dropdown" id="syndicat-sort-dropdown" style="display:none;">
								<div class="syndicat-sort-option" data-value="name">Sort by Name</div>
								<div class="syndicat-sort-option" data-value="email">Sort by Email</div>
								<div class="syndicat-sort-option" data-value="date">Sort by Date</div>
								<div class="syndicat-sort-option" data-value="status">Sort by Status</div>
							</div>
						</div>
						<div class="syndicat-search-pill">
							<input type="text" class="syndicat-search-input" placeholder="Search syndicat..." title="Search syndicat..." />
							<i class="bx bx-search syndicat-search-icon"></i>
						</div>
					</div>
				</div>
				<div class="liquid-glass-table-scroll">
					<table class="liquid-glass-table" id="syndicat-table">
						<thead>
							<tr>
								{% for col in 1..8 %}
									<th>Col {{ col }}</th>
								{% endfor %}
								<th>Modify</th>
								<th>Delete</th>
							</tr>
						</thead>
						<tbody id="syndicat-table-body">
							<!-- Table rows will be rendered by JS -->
						</tbody>
					</table>
				</div>
				<div class="table-pagination-bar">
					<button class="syndicat-table-arrow" id="syndicat-table-prev" title="Previous Page"><i class="bx bx-chevron-left"></i></button>
					<div class="syndicat-table-pages" id="syndicat-table-pages"></div>
					<button class="syndicat-table-arrow" id="syndicat-table-next" title="Next Page"><i class="bx bx-chevron-right"></i></button>
				</div>
			</div>
			<script>
// --- Users-style dropdown and sort pill logic for Syndicat ---
document.addEventListener('DOMContentLoaded', function() {
	const sortPill = document.getElementById('syndicat-sort-pill-custom');
	const sortDropdown = document.getElementById('syndicat-sort-dropdown');
	const sortSelected = document.getElementById('syndicat-sort-selected');
	let sortValue = 'name';
	function closeSortDropdown() {
		if (sortDropdown) {
			sortDropdown.style.display = 'none';
			sortPill && sortPill.classList.remove('open');
		}
	}
	function openSortDropdown() {
		if (sortDropdown) {
			sortDropdown.style.display = 'flex';
			sortPill && sortPill.classList.add('open');
		}
	}
	if (sortPill && sortDropdown) {
		sortPill.addEventListener('click', function(e) {
			e.stopPropagation();
			if (sortDropdown.style.display === 'flex') {
				closeSortDropdown();
			} else {
				openSortDropdown();
			}
		});
		document.querySelectorAll('.syndicat-sort-option').forEach(opt => {
			opt.addEventListener('click', function(e) {
				sortValue = this.getAttribute('data-value');
				sortSelected.textContent = this.textContent;
				document.querySelectorAll('.syndicat-sort-option').forEach(o => o.classList.remove('active'));
				this.classList.add('active');
				closeSortDropdown();
				syndicatSortValue = sortValue;
				syndicatFilterAndSortRows();
			});
		});
		document.addEventListener('click', function(e) {
			if (!sortPill.contains(e.target)) closeSortDropdown();
		});
		sortPill.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') closeSortDropdown();
			if (e.key === 'ArrowDown') {
				openSortDropdown();
				const first = sortDropdown.querySelector('.syndicat-sort-option');
				if (first) first.focus();
			}
		});
	}
});
				// Demo data: 35 rows, 8 columns
				const syndicatDemoTableRows = Array.from({length: 35}, (_, r) =>
					Array.from({length: 8}, (_, c) => `R${r+1}C${c+1}`)
				);
				const syndicatRowsPerPage = 10;
				let syndicatCurrentPage = 1;
				let syndicatSortValue = 'name';
				let syndicatSortDirection = 'asc';
				let syndicatFilteredRows = [...syndicatDemoTableRows];
				const syndicatSearchInput = document.querySelector('.syndicat-search-input');
				const syndicatSortDirBtn = document.getElementById('syndicat-sort-dir-pill');
				const syndicatSortDirIconSvg = document.getElementById('syndicat-sort-dir-icon-svg');
				const syndicatSortPill = document.getElementById('syndicat-sort-pill-custom');
				const syndicatSortDropdown = document.getElementById('syndicat-sort-dropdown');
				const syndicatSortSelected = document.getElementById('syndicat-sort-selected');
				function updateSyndicatSortDirIcon() {
					syndicatSortDirIconSvg.innerHTML = syndicatSortDirection === 'asc'
						? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 15 12 9 18 15" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`
						: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 9 12 15 18 9" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
				}
				function syndicatFilterAndSortRows() {
					let rows = [...syndicatDemoTableRows];
					const search = syndicatSearchInput.value.trim().toLowerCase();
					if (search) {
						rows = rows.filter(row => row.some(cell => cell.toLowerCase().includes(search)));
					}
					if (syndicatSortValue === 'name') {
						rows.sort((a, b) => syndicatSortDirection === 'asc' ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]));
					} else if (syndicatSortValue === 'email') {
						rows.sort((a, b) => syndicatSortDirection === 'asc' ? a[1].localeCompare(b[1]) : b[1].localeCompare(a[1]));
					} else if (syndicatSortValue === 'date') {
						rows.sort((a, b) => syndicatSortDirection === 'asc' ? a[2].localeCompare(b[2]) : b[2].localeCompare(a[2]));
					} else if (syndicatSortValue === 'status') {
						rows.sort((a, b) => syndicatSortDirection === 'asc' ? a[3].localeCompare(b[3]) : b[3].localeCompare(a[3]));
					}
					syndicatFilteredRows = rows;
					syndicatCurrentPage = 1;
					updateSyndicatTablePagination();
				}
				function renderSyndicatTablePage(page) {
					const tbody = document.getElementById('syndicat-table-body');
					tbody.innerHTML = '';
					const start = (page-1)*syndicatRowsPerPage;
					const end = Math.min(start+syndicatRowsPerPage, syndicatFilteredRows.length);
					for (let r = start; r < end; r++) {
						const row = document.createElement('tr');
						for (let c = 0; c < 8; c++) {
							const td = document.createElement('td');
							td.textContent = syndicatFilteredRows[r][c];
							row.appendChild(td);
						}
						// Modify button
						const tdModify = document.createElement('td');
						tdModify.innerHTML = '<button class="syndicat-btn-modify" title="Modify"><i class="bx bx-edit"></i> Modify</button>';
						row.appendChild(tdModify);
						// Delete button
						const tdDelete = document.createElement('td');
						tdDelete.innerHTML = '<button class="syndicat-btn-delete" title="Delete"><i class="bx bx-trash"></i> Delete</button>';
						row.appendChild(tdDelete);
						tbody.appendChild(row);
					}
				}
				function renderSyndicatTablePagination() {
					const totalPages = Math.ceil(syndicatFilteredRows.length / syndicatRowsPerPage);
					const pagesDiv = document.getElementById('syndicat-table-pages');
					pagesDiv.innerHTML = '';
					for (let i = 1; i <= totalPages; i++) {
						const btn = document.createElement('button');
						btn.className = 'syndicat-table-page-btn' + (i === syndicatCurrentPage ? ' active' : '');
						btn.textContent = i;
						btn.onclick = () => { syndicatCurrentPage = i; updateSyndicatTablePagination(); };
						pagesDiv.appendChild(btn);
					}
					document.getElementById('syndicat-table-prev').disabled = syndicatCurrentPage === 1;
					document.getElementById('syndicat-table-next').disabled = syndicatCurrentPage === totalPages;
				}
				function updateSyndicatTablePagination() {
					renderSyndicatTablePage(syndicatCurrentPage);
					renderSyndicatTablePagination();
				}
				document.addEventListener('DOMContentLoaded', function() {
					updateSyndicatSortDirIcon();
					updateSyndicatTablePagination();
					syndicatSearchInput.addEventListener('input', syndicatFilterAndSortRows);
					syndicatSortDirBtn.addEventListener('click', function() {
						syndicatSortDirection = (syndicatSortDirection === 'asc') ? 'desc' : 'asc';
						updateSyndicatSortDirIcon();
						syndicatFilterAndSortRows();
					});
					// Users-style pagination arrow logic
					document.getElementById('syndicat-table-prev').onclick = function() {
						if (syndicatCurrentPage > 1) { syndicatCurrentPage--; updateSyndicatTablePagination(); }
					};
					document.getElementById('syndicat-table-next').onclick = function() {
						const totalPages = Math.ceil(syndicatFilteredRows.length / syndicatRowsPerPage);
						if (syndicatCurrentPage < totalPages) { syndicatCurrentPage++; updateSyndicatTablePagination(); }
					};
					syndicatSortPill.addEventListener('click', function(e) {
						e.stopPropagation();
						if (syndicatSortDropdown.style.display === 'flex') {
							syndicatSortDropdown.style.display = 'none';
							syndicatSortPill.classList.remove('open');
						} else {
							syndicatSortDropdown.style.display = 'flex';
							syndicatSortPill.classList.add('open');
						}
					});
					document.querySelectorAll('.syndicat-sort-option').forEach(opt => {
						opt.addEventListener('click', function(e) {
							syndicatSortValue = this.getAttribute('data-value');
							syndicatSortSelected.textContent = this.textContent;
							document.querySelectorAll('.syndicat-sort-option').forEach(o => o.classList.remove('active'));
							this.classList.add('active');
							syndicatSortDropdown.style.display = 'none';
							syndicatSortPill.classList.remove('open');
							syndicatFilterAndSortRows();
						});
					});
					document.addEventListener('click', function(e) {
						if (!syndicatSortPill.contains(e.target)) {
							syndicatSortDropdown.style.display = 'none';
							syndicatSortPill.classList.remove('open');
						}
					});
				});
			</script>
			<style>
				.table-pagination-bar {
					display: flex;
					justify-content: center;
					align-items: center;
					gap: 1.2rem;
					margin: 1.5rem 0 0.5rem 0;
				}
				.syndicat-table-arrow {
					background: linear-gradient(90deg, #23272f 0%, #2a2e39 100%);
					color: #fff;
					border: none;
					border-radius: 50%;
					width: 2.5rem;
					height: 2.5rem;
