{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    // ── Switcher UI Logic
    const slider = document.getElementById('switcher-slider');
    const tabs = document.querySelectorAll('.premium-switcher-tab');
    
    // Set initial active state styling
    const updateActiveColors = () => {
        tabs.forEach(t => {
            if (t.classList.contains('active')) {
                t.style.color = '#fff';
                t.style.textShadow = '0 0 10px rgba(255,255,255,0.3)';
            } else {
                t.style.color = 'rgba(255,255,255,0.55)';
                t.style.textShadow = 'none';
            }
        });
    };

    function updateSlider(activeTab) {
        slider.style.width = activeTab.offsetWidth + 'px';
        slider.style.left = activeTab.offsetLeft + 'px';
    }

    function showDashboardPage(page) {
        document.querySelectorAll('.dashboard-page-content').forEach(div => {
            div.style.display = div.dataset.page == page ? 'block' : 'none';
        });
    }

    // Initialize first main tab
    const firstTab = document.querySelector('.premium-switcher-tab.active');
    if (firstTab) { updateSlider(firstTab); updateActiveColors(); }

    // ── General Tab Sub-Navigation Logic ──
    const subTabs = document.querySelectorAll('.gen-sub-tab');
    const subPages = document.querySelectorAll('.gen-sub-page');

    subTabs.forEach(tab => {
        tab.addEventListener('click', function() {
            if(this.classList.contains('active')) return;
            
            // Reset all sub tabs
            subTabs.forEach(t => {
                t.classList.remove('active');
                t.style.background = 'transparent';
                t.style.color = 'rgba(255,255,255,0.5)';
                t.style.border = '1px solid transparent';
            });
            
            // Activate clicked sub tab
            this.classList.add('active');
            this.style.background = 'rgba(167, 139, 250, 0.2)';
            this.style.color = '#fff';
            this.style.border = '1px solid rgba(167, 139, 250, 0.3)';

            // Show corresponding sub page
            const targetSub = this.dataset.sub;
            subPages.forEach(page => {
                if (page.dataset.sub === targetSub) {
                    page.style.opacity = '0';
                    page.style.display = 'block';
                    setTimeout(() => page.style.opacity = '1', 10);
                } else {
                    page.style.display = 'none';
                }
            });
        });
    });

    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            if(this.classList.contains('active')) return;
            tabs.forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            updateSlider(this);
            updateActiveColors();
            showDashboardPage(this.dataset.page);
            fetchLiveStats(this.dataset.page); // Fetch live stats immediately when switched
        });
        
        // Hover effects matching the pure CSS version
        tab.addEventListener('mouseenter', function() {
            if(!this.classList.contains('active')) this.style.color = '#fff';
        });
        tab.addEventListener('mouseleave', function() {
            if(!this.classList.contains('active')) this.style.color = 'rgba(255,255,255,0.55)';
        });
    });

    // ── Live Stats Fetching Logic
    let statsInterval;
    
    function fetchLiveStats(pageId) {
        const moduleMap = { '1': 'general', '2': 'users', '3': 'forum', '4': 'syndicat', '5': 'residence', '6': 'evenement' };
        const moduleName = moduleMap[pageId] || 'general';
        
        fetch(`/admin/dashboard/live?module=${moduleName}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.html) {
                const container = document.querySelector(`.dashboard-page-content[data-page="${pageId}"]`);
                if (container && pageId !== '1') {
                    container.innerHTML = data.html;
                }
            }
            
            // For general tab numeric bindings
            if (pageId === '1' && data.stats) {
                document.querySelectorAll('.hz-stat-num[data-live]').forEach(el => {
                    const key = el.getAttribute('data-live');
                    if (data.stats[key] !== undefined) el.textContent = data.stats[key];
                });
            }
        })
        .catch(console.error);
    }

    // Start polling every 10 seconds
    statsInterval = setInterval(() => {
        const activeTab = document.querySelector('.premium-switcher-tab.active');
        if (activeTab) {
            fetchLiveStats(activeTab.dataset.page);
        }
    }, 10000);
});
</script>
<script>
// Animated counters
document.querySelectorAll('.hz-stat-num[data-count]').forEach(el => {
    const target = parseInt(el.dataset.count, 10);
    if (!target) return;
    let start = 0;
    const step = Math.ceil(target / 40);
    const timer = setInterval(() => {
        start = Math.min(start + step, target);
        el.textContent = start.toLocaleString();
        if (start >= target) clearInterval(timer);
    }, 30);
});

// Bar height animation – CSS custom property `--h` is set inline, trigger animation via class
document.querySelectorAll('.hz-bar').forEach((bar, i) => {
    bar.style.height = '0%';
    setTimeout(() => { bar.style.height = bar.style.getPropertyValue('--h') || getComputedStyle(bar).getPropertyValue('--h'); }, 150 + i * 60);
});
</script>
{% endblock %}
