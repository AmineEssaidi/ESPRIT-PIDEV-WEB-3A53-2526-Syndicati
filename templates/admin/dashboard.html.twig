{% extends 'base.html.twig' %}

{% block title %}Dashboard - Liquid Glass Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Dashboard' } %}

<div class="admin-dashboard">
    <!-- Top Stat Cards -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon income-icon"></span>
                <span class="stat-label">Currency income</span>
            </div>
            <div class="stat-value">$2700</div>
            <div class="stat-sub">+12% vs last month</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon bills-icon"></span>
                <span class="stat-label">Bills</span>
            </div>
            <div class="stat-value">$1250</div>
            <div class="stat-sub">24 invoices pending</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon balance-icon"></span>
                <span class="stat-label">Balance</span>
            </div>
            <div class="stat-value">$3450</div>
            <div class="stat-sub">All accounts reconciled</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon payment-icon"></span>
                <span class="stat-label">Pending payment</span>
            </div>
            <div class="stat-value">$3428</div>
            <div class="stat-sub text-warning">5 invoices overdue</div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="dashboard-main">
        <!-- Activity / Chart Section -->
        <section class="activity-card glass-panel">
            <div class="panel-header">
                <div>
                    <h2 class="panel-title">Activity</h2>
                    <p class="panel-subtitle">Income vs Spent · This year</p>
                </div>
                <div class="legend">
                    <span class="legend-dot income-dot"></span><span>Income</span>
                    <span class="legend-dot spent-dot ms-3"></span><span>Spent</span>
                </div>
            </div>
            <div class="activity-chart">
                <!-- Simple bar chart inspired by the mockup -->
                {% set months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'] %}
                <div class="chart-bars">
                    {% for month in months %}
                        <div class="chart-bar">
                            <div class="bar-group">
                                <div class="bar bar-income"></div>
                                <div class="bar bar-spent"></div>
                            </div>
                            <span class="bar-label">{{ month }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="activity-footer">
                <div class="activity-metric">
                    <span class="metric-label">Total income</span>
                    <span class="metric-value">$124,580</span>
                </div>
                <div class="activity-metric">
                    <span class="metric-label">Total spent</span>
                    <span class="metric-value">$86,430</span>
                </div>
                <div class="activity-metric">
                    <span class="metric-label">Net balance</span>
                    <span class="metric-value text-success">+$38,150</span>
                </div>
            </div>
        </section>

        <!-- Right Column -->
        <aside class="dashboard-side">
            <!-- Upcoming Obligations -->
            <section class="obligations-card glass-panel">
                <h2 class="panel-title">Upcoming obligations</h2>
                <div class="obligation-box">
                    <h3 class="obligation-title">VAT declaration</h3>
                    <p class="obligation-text">You have 27 days left to submit the documentation.</p>
                    <button class="btn btn-sm btn-primary rounded-pill">View details</button>
                </div>
            </section>

            <!-- Agenda / Calendar -->
            <section class="agenda-card glass-panel">
                <div class="panel-header">
                    <h2 class="panel-title">Agenda</h2>
                    <span class="panel-subtitle">This month</span>
                </div>
                <div class="agenda-content">
                    <div class="mini-calendar">
                        <div class="calendar-header">
                            <span class="month-label">February 2026</span>
                        </div>
                        <div class="calendar-grid">
                            <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
                            {% for i in 1..28 %}
                                <button class="calendar-day {{ i == 10 ? 'is-today' : '' }}">{{ i }}</button>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="agenda-list">
                        <div class="agenda-item">
                            <div>
                                <p class="agenda-title">Meeting with Everis</p>
                                <p class="agenda-meta">Zoom · 09:00</p>
                            </div>
                            <span class="agenda-badge">Today</span>
                        </div>
                        <div class="agenda-item">
                            <div>
                                <p class="agenda-title">Board review</p>
                                <p class="agenda-meta">HQ · 15:30</p>
                            </div>
                            <span class="agenda-badge badge-soft">Tomorrow</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Monthly Billing -->
            <section class="billing-card glass-panel">
                <div class="panel-header">
                    <h2 class="panel-title">Monthly billing</h2>
                    <span class="panel-subtitle">Issued vs Received</span>
                </div>
                <div class="billing-content">
                    <div class="billing-gauge">
                        <div class="gauge-ring">
                            <div class="gauge-fill"></div>
                            <div class="gauge-center">
                                <span class="gauge-label">Total</span>
                                <span class="gauge-value">$1450</span>
                            </div>
                        </div>
                    </div>
                    <div class="billing-legend">
                        <div class="legend-row">
                            <span class="legend-dot issued-dot"></span>
                            <span>Issued</span>
                            <span class="legend-amount ms-auto">$950</span>
                        </div>
                        <div class="legend-row">
                            <span class="legend-dot received-dot"></span>
                            <span>Received</span>
                            <span class="legend-amount ms-auto">$500</span>
                        </div>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
// Keep the live date & time in the dashboard header.
// Date/Time logic moved to _dashboard_header.html.twig
</script>
{% endblock %}