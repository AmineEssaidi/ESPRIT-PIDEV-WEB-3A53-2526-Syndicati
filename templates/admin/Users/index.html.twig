    <div class="users-pagination-pills pills-animated">
        <div class="pill-slider-bar"></div>
        <div class="pill-slider"></div>
        <button class="pill-tab active" data-page="1">Users</button>
        <button class="pill-tab" data-page="2">Profile</button>
        <button class="pill-tab" data-page="3">Onboarding</button>
    </div>
