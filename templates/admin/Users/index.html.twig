                }
                [data-theme="light"] .table-pagination-bar {
                    background: transparent;
                }
                [data-theme="light"] .users-btn-modify {
                    background: var(--accent-gradient, linear-gradient(90deg, #6c5ce7 0%, #8b5cf6 100%));
