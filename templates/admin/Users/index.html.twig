            </div>
        </div><!-- End #usersGlassSwitcher -->
        </div><!-- End .glass-table-container -->
    </div><!-- End .users-page-content -->

            </style>


            <script>
                /**
                 * Robust Glass Switcher Transition Handler
                 * Manages 3D faces and dynamic height synchronization
                 */
                // User data for edit modal (id -> { firstName, lastName, email, role, isVerified })

                // User data for edit modal (id -> { firstName, lastName, email, role, isVerified })
                const usersData = {
                {% for u in users|default([]) %}
                "{{ u.idUser }}": { "firstName": "{{ u.firstName|e('js') }}", "lastName": "{{ u.lastName|e('js') }}", "email": "{{ u.emailUser|e('js') }}", "role": "{{ u.roleUser|e('js') }}", "isVerified": {{ u.isVerified ? 'true' : 'false' }} }{% if not loop.last %},{% endif %}
                {% endfor %}
                };
                const editUserUrlTemplate = "{{ path('admin_users_edit', {id: 0}) }}".replace('0', '__ID__');
                const deleteUserUrlTemplate = "{{ path('admin_users_delete', {id: 0}) }}".replace('0', '__ID__');
                const deleteCsrfToken = "{{ csrf_token('user_delete')|e('js') }}";

                // Profile data for edit modal (id_profile -> { avatar, theme, locale, timezone, description_profile })
                const profilesData = {
                {% for p in profiles|default([]) %}
                "{{ p.idProfile }}": { 
                    "avatar": {{ (p.avatar ?? '')|json_encode|raw }}, 
                    "theme": {{ p.theme is not null ? p.theme : 'null' }}, 
                    "locale": {{ (p.locale ?? '')|json_encode|raw }}, 
                    "timezone": {{ p.timezone is not null ? p.timezone : 'null' }}, 
                    "description_profile": {{ (p.descriptionProfile ?? '')|json_encode|raw }},
                    "userName": "{{ p.user ? (p.user.firstName ~ ' ' ~ p.user.lastName)|e('js') : '—' }}",
                    "userEmail": "{{ p.user ? p.user.emailUser|e('js') : '—' }}"
                }{% if not loop.last %},{% endif %}
                {% endfor %}
                };
                const editProfileUrlTemplate = "{{ path('admin_profile_edit', {id: 0}) }}".replace('0', '__ID__');
                
                const onboardingData = {
                {% for o in onboardings|default([]) %}
                "{{ o.idOnboarding }}": { 
                    "step": {{ o.step }}, 
                    "completed": {{ o.completed ? 'true' : 'false' }}, 
                    "selectedLocale": {{ (o.selectedLocale ?? '')|json_encode|raw }}, 
                    "selectedTheme": {{ (o.selectedTheme ?? '')|json_encode|raw }}, 
                    "suggestions": {{ (o.suggestions ?? '')|json_encode|raw }}, 
                    "selectedPreferences": {{ o.selectedPreferences ? o.selectedPreferences|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw : '{}' }},
                    "userName": "{{ o.user ? (o.user.firstName ~ ' ' ~ o.user.lastName)|e('js') : '—' }}",
                    "userEmail": "{{ o.user ? o.user.emailUser|e('js') : '—' }}"
                }{% if not loop.last %},{% endif %}
                {% endfor %}
                };
                const editOnboardingUrlTemplate = "{{ path('admin_onboarding_edit', {id: 0}) }}".replace('0', '__ID__');

                // Table rows from database (Name, Email, Date, Status, Role, ID, Created, Updated)
                const demoTableRows = [
                {% for u in users|default([]) %}
                [ "{{ (u.firstName ~ ' ' ~ u.lastName)|e('js') }}", "{{ u.emailUser|e('js') }}", "{{ u.createdAt|date('Y-m-d H:i') }}", "{{ u.isVerified ? 'Verified' : 'Pending' }}", "{{ u.roleUser|e('js') }}", "{{ u.idUser }}", "{{ u.createdAt|date('Y-m-d H:i') }}", "{{ u.updatedAt|date('Y-m-d H:i') }}" ]{% if not loop.last %},{% endif %}
                {% endfor %}
                ];
                const usersRowsPerPage = 10;
                let usersCurrentPage = 1;

                // Sorting and Filtering State
                let usersSortValue = 'name';
                let usersSortDirection = 'asc';
                let usersFilteredRows = [...demoTableRows];

                // Elements
                const usersSearchInput = document.querySelector('.users-search-input');
                const usersSortDirBtn = document.getElementById('users-sort-dir-pill');
                const usersSortDirIconSvg = document.getElementById('users-sort-dir-icon-svg');
                const usersSortPill = document.getElementById('users-sort-pill-custom');
                const usersSortDropdown = document.getElementById('users-sort-dropdown');
                const usersSortSelected = document.getElementById('users-sort-selected');

                function updateUsersSortDirIcon() {
                    const iconEl = document.getElementById('users-sort-dir-icon-svg');
                    if (!iconEl) return;
                    iconEl.innerHTML = usersSortDirection === 'asc'
                        ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>`
                        : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
                }

                window.selectSortPill = function(pill) {
                    const val = pill.getAttribute('data-value');
                    usersSortValue = val;
                    
                    document.querySelectorAll('.users-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
                    pill.classList.add('glass-pill-active');
                    
                    usersFilterAndSortRows();
                };

                function usersFilterAndSortRows() {
                    let rows = [...demoTableRows];
                    const search = usersSearchInput ? usersSearchInput.value.trim().toLowerCase() : '';
                    
                    if (search) {
                        rows = rows.filter(row => row.some(cell => String(cell).toLowerCase().includes(search)));
                    }

                    // Sort indices: 0=Name, 1=Email, 2=Date, 3=Status, 4=Role
                    let sortIdx = 0; // Default Name
                    if (usersSortValue === 'name') sortIdx = 0;
                    else if (usersSortValue === 'email') sortIdx = 1;
                    else if (usersSortValue === 'role') sortIdx = 4; // Role
                    else if (usersSortValue === 'status') sortIdx = 3;

                    rows.sort((a, b) => {
                        let valA = String(a[sortIdx]).toLowerCase();
                        let valB = String(b[sortIdx]).toLowerCase();
                        if (usersSortDirection === 'asc') return valA.localeCompare(valB);
                        else return valB.localeCompare(valA);
                    });

                    usersFilteredRows = rows;
                    usersCurrentPage = 1;
                    updateUsersTablePagination();
                }

                function renderUsersTablePage(page) {
                    const tbody = document.getElementById('users-table-body');
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    
                    if (usersFilteredRows.length === 0) {
                        const row = document.createElement('tr');
                        row.innerHTML = '<td colspan="5" style="padding: 2rem; opacity: 0.7;">No users found.</td>';
                        tbody.appendChild(row);
                        return;
                    }

                    const start = (page-1)*usersRowsPerPage;
                    const end = Math.min(start+usersRowsPerPage, usersFilteredRows.length);
                    for (let r = start; r < end; r++) {
                        const row = document.createElement('tr');
                        
                        // Column 1: Name
                        const tdName = document.createElement('td');
                        tdName.textContent = usersFilteredRows[r][0];
                        row.appendChild(tdName);
                        
                        // Column 2: Email
                        const tdEmail = document.createElement('td');
                        tdEmail.textContent = usersFilteredRows[r][1];
                        row.appendChild(tdEmail);
                        
                        // Column 3: Role
                        const tdRole = document.createElement('td');
                        tdRole.textContent = usersFilteredRows[r][4];
                        row.appendChild(tdRole);
                        
                        // Column 4: Status
                        const tdStatus = document.createElement('td');
                        tdStatus.textContent = usersFilteredRows[r][3];
                        row.appendChild(tdStatus);
                        
                        // Column 5: Actions - View Details pill
                        const userId = usersFilteredRows[r][5];
                        const tdActions = document.createElement('td');
                        tdActions.style.textAlign = 'right';
                        const viewBtn = document.createElement('button');
                        viewBtn.className = 'glass-btn-save users-btn-view-details';
                        viewBtn.title = 'View Details';
                        viewBtn.type = 'button';
                        viewBtn.dataset.userId = userId;
                        viewBtn.style.padding = '0.4rem 1.2rem';
                        viewBtn.style.fontSize = '0.85rem';
                        viewBtn.innerHTML = '<i class="bx bx-show"></i> Details';
                        tdActions.appendChild(viewBtn);
                        row.appendChild(tdActions);
                        
                        tbody.appendChild(row);
                    }
                }

                function renderUsersTablePagination() {
                    const totalPages = Math.ceil(usersFilteredRows.length / usersRowsPerPage);
                    const pagesDiv = document.getElementById('users-table-pages');
                    if (!pagesDiv) return;
                    pagesDiv.innerHTML = '';
                    for (let i = 1; i <= totalPages; i++) {
                        const btn = document.createElement('button');
                        btn.className = 'glass-pagination-btn' + (i === usersCurrentPage ? ' active' : '');
                        btn.textContent = i;
                        btn.onclick = () => { usersCurrentPage = i; updateUsersTablePagination(); };
                        pagesDiv.appendChild(btn);
                    }
                    if(document.getElementById('users-table-prev')) document.getElementById('users-table-prev').disabled = usersCurrentPage === 1;
                    if(document.getElementById('users-table-next')) document.getElementById('users-table-next').disabled = usersCurrentPage === totalPages;
                }

                function updateUsersTablePagination() {
                    renderUsersTablePage(usersCurrentPage);
                    renderUsersTablePagination();
                    
                    // Sync height for Users page switcher
                    const s = document.getElementById('usersGlassSwitcher');
                    if (s && !s.classList.contains('active-details') && 
                        !s.classList.contains('active-edit') && 
                        !s.classList.contains('active-extra')) {
                        switchGlassFace('main', 'usersGlassSwitcher');
                    }
                }

                document.addEventListener('DOMContentLoaded', function() {
                    // Initialize Sort UI
                    updateUsersSortDirIcon();
                    usersFilterAndSortRows();

                    // Search Input Listener
                    if (usersSearchInput) {
                        usersSearchInput.addEventListener('input', usersFilterAndSortRows);
                    }

                    // Sort Direction Toggle
                    if (usersSortDirBtn) {
                        usersSortDirBtn.addEventListener('click', function() {
                            usersSortDirection = (usersSortDirection === 'asc') ? 'desc' : 'asc';
                            updateUsersSortDirIcon();
                            usersFilterAndSortRows();
                        });
                    }

                    // Remove legacy dropdown listeners (handled by selectSortPill now)

                    // Pagination Buttons (New IDs)
                    if (document.getElementById('users-table-prev')) {
                        document.getElementById('users-table-prev').onclick = function() {
                            if (usersCurrentPage > 1) { usersCurrentPage--; updateUsersTablePagination(); }
                        };
                    }
                    if (document.getElementById('users-table-next')) {
                        document.getElementById('users-table-next').onclick = function() {
                            const totalPages = Math.ceil(usersFilteredRows.length / usersRowsPerPage);
                            if (usersCurrentPage < totalPages) { usersCurrentPage++; updateUsersTablePagination(); }
                        };
                    }


                    // Edit modal: open/close and Modify click
                    const modal = document.getElementById('user-edit-modal');
                    const editFormEl = document.getElementById('user-edit-form');
                    function openEditModal(userId) {
                        const idKey = String(userId);
                        const data = usersData[idKey] || usersData[userId];
                        if (!data || !editFormEl) return;
                        editFormEl.action = editUserUrlTemplate.replace('__ID__', idKey);
                        const formName = editFormEl.getAttribute('data-form-name') || 'user_type';
                        const setVal = (el, value) => { if (el) { el.value = value || ''; return true; } return false; };
                        const setChecked = (el, checked) => { if (el) { el.checked = !!checked; return true; } return false; };
                        function byId(attr) {
                            const id = editFormEl.getAttribute(attr);
                            return id ? document.getElementById(id) : null;
                        }
                        setVal(byId('data-id-first') || editFormEl.elements[formName + '[first_name]'], data.firstName);
                        setVal(byId('data-id-last') || editFormEl.elements[formName + '[last_name]'], data.lastName);
                        setVal(byId('data-id-email') || editFormEl.elements[formName + '[email_user]'], data.email);
                        setVal(byId('data-id-role') || editFormEl.elements[formName + '[role_user]'], data.role || 'RESIDENT');
                        setChecked(byId('data-id-verified') || editFormEl.elements[formName + '[is_verified]'], data.isVerified);
                        openModal('user-edit-modal');
                    }
                    function closeEditModal() {
                        closeModal('user-edit-modal');
                    }
                    if (document.getElementById('user-edit-modal-close')) document.getElementById('user-edit-modal-close').onclick = closeEditModal;
                    if (document.getElementById('user-edit-modal-cancel')) document.getElementById('user-edit-modal-cancel').onclick = closeEditModal;
                    if (modal && modal.querySelector('.users-edit-modal-backdrop')) modal.querySelector('.users-edit-modal-backdrop').onclick = closeEditModal;

                    // View Details modal logic
                    const viewModal = document.getElementById('user-view-modal');
                    const viewModifyBtn = document.getElementById('view-user-modify-btn');
                    const viewDeleteForm = document.getElementById('view-user-delete-form');
                    let currentActiveUserId = null;

                    function openViewModal(userId) {
                        const idKey = String(userId);
                        const userData = usersData[idKey];
                        const rowData = demoTableRows.find(r => r[5] == idKey);
                        
                        if (!userData || !rowData) return;
                        
                        currentActiveUserId = idKey;

                        // Populate basic info
                        document.getElementById('view-user-name').textContent = userData.firstName + ' ' + userData.lastName;
                        document.getElementById('view-user-email').textContent = userData.email;
                        
                        // Populate dates from demoTableRows or usersData if available
                        document.getElementById('view-user-created').textContent = rowData[6] || '-';
                        document.getElementById('view-user-updated').textContent = rowData[7] || '-';

                        // Role badge
                        const roleEl = document.getElementById('view-user-role');
                        roleEl.textContent = userData.role || 'RESIDENT';

                        // Status badge
                        const statusEl = document.getElementById('view-user-status');
                        const isVerified = userData.isVerified;
                        statusEl.textContent = isVerified ? 'Verified' : 'Pending';
                        statusEl.className = 'users-view-status-badge ' + (isVerified ? 'verified' : 'pending');

                        // Set up Delete Form action
                        viewDeleteForm.action = deleteUserUrlTemplate.replace('__ID__', idKey);
                        viewDeleteForm.onsubmit = function() { return confirm('Are you sure you want to delete this user?'); };

                        openModal('user-view-modal');
                    }

                    function closeViewModal() {
                        closeModal('user-view-modal');
                    }

                    // Wire up View Details button click from table
                    document.getElementById('users-content').addEventListener('click', function(e) {
                        const btn = e.target.closest('.users-btn-view-details');
                        if (btn && btn.dataset.userId) { 
                            e.preventDefault(); 
                            e.stopPropagation();
                            
                            // 1. Explicitly mark the modal as active before the switcher starts
                            const vModal = document.getElementById('user-view-modal');
                            if (vModal) {
                                vModal.style.display = 'flex';
                                void vModal.offsetWidth;
                                vModal.classList.add('active');
                            }
                            
                            openViewModal(btn.dataset.userId); 
                        }
                    });

                    // Wire up Modify button in View Modal
                    if (viewModifyBtn) {
                        viewModifyBtn.onclick = function() {
                            if (currentActiveUserId) {
                                closeViewModal();
                                openEditModal(currentActiveUserId);
                            }
                        };
                    }

                    if (document.getElementById('user-view-modal-close')) document.getElementById('user-view-modal-close').onclick = closeViewModal;
                    if (viewModal && viewModal.querySelector('.users-edit-modal-backdrop')) viewModal.querySelector('.users-edit-modal-backdrop').onclick = closeViewModal;

                    // Add User modal: open/close
                    const addModal = document.getElementById('user-add-modal');
                    const addBtn = document.getElementById('users-btn-add-user');
                    if (addBtn) addBtn.addEventListener('click', function() { openModal('user-add-modal'); });
                    if (document.getElementById('user-add-modal-close')) document.getElementById('user-add-modal-close').onclick = function() { closeModal('user-add-modal'); };
                    if (document.getElementById('user-add-modal-cancel')) document.getElementById('user-add-modal-cancel').onclick = function() { closeModal('user-add-modal'); };
                    if (addModal && addModal.querySelector('.users-edit-modal-backdrop')) addModal.querySelector('.users-edit-modal-backdrop').onclick = function() { closeModal('user-add-modal'); };

                    // Profile View Modal logic
                    const profileViewModal = document.getElementById('profile-view-modal');
                    const viewProfileModifyBtn = document.getElementById('view-profile-modify-btn');
                    let currentActiveProfileId = null;

                    function openProfileViewModal(profileId, avatarUrl) {
                        const idKey = String(profileId);
                        const data = profilesData[idKey];
                        if (!data) return;
                        
                        currentActiveProfileId = idKey;

                        // Populate info
                        document.getElementById('view-profile-user-name').textContent = data.userName;
                        document.getElementById('view-profile-user-email').textContent = data.userEmail;
                        document.getElementById('view-profile-theme').textContent = data.theme !== null ? data.theme : '—';
                        document.getElementById('view-profile-locale').textContent = data.locale || '—';
                        document.getElementById('view-profile-timezone').textContent = data.timezone !== null ? data.timezone : '—';
                        document.getElementById('view-profile-description').textContent = data.description_profile || '—';

                        // Avatar
                        const imgEl = document.getElementById('view-profile-avatar-img');
                        const placeholderEl = document.getElementById('view-profile-avatar-placeholder');
                        
                        if (avatarUrl) {
                            // Use the pre-resolved URL passed from the button
                            imgEl.src = avatarUrl;
                            imgEl.style.display = 'block';
                            placeholderEl.style.display = 'none';
                        } else {
                            imgEl.style.display = 'none';
                            placeholderEl.style.display = 'flex';
                        }

                        openModal('profile-view-modal');
                    }

                    function closeProfileViewModal() {
                        closeModal('profile-view-modal');
                    }

                    // Wire up View Details for Profile
                    document.getElementById('users-content').addEventListener('click', function(e) {
                        const btn = e.target.closest('.profile-view-btn');
                        if (btn && btn.dataset.profileId) { 
                            e.preventDefault(); 
                            openProfileViewModal(btn.dataset.profileId, btn.dataset.avatarUrl); 
                        }
                    });

                    // Wire up Modify inside Profile View
                    if (viewProfileModifyBtn) {
                        viewProfileModifyBtn.onclick = function() {
                            if (currentActiveProfileId) {
                                openProfileEditModal(currentActiveProfileId);
                            }
                        };
                    }

                    if (document.getElementById('profile-view-modal-close')) document.getElementById('profile-view-modal-close').onclick = closeProfileViewModal;
                    if (profileViewModal && profileViewModal.querySelector('.users-edit-modal-backdrop')) profileViewModal.querySelector('.users-edit-modal-backdrop').onclick = closeProfileViewModal;

                    // Profile edit modal (Page 2 - Profile table)
                    const profileEditModal = document.getElementById('profile-edit-modal');
                    const profileEditFormEl = document.getElementById('profile-edit-form');
                    function openProfileEditModal(profileId) {
                        const idKey = String(profileId);
                        const data = profilesData[idKey];
                        if (!data || !profileEditFormEl) return;
                        profileEditFormEl.action = editProfileUrlTemplate.replace('__ID__', idKey);
                        const formName = profileEditFormEl.getAttribute('data-form-name') || 'profile_type';
                        const setVal = (el, value) => { if (el) { el.value = value != null ? String(value) : ''; return true; } return false; };
                        setVal(profileEditFormEl.elements[formName + '[avatar]'], data.avatar);
                        setVal(profileEditFormEl.elements[formName + '[description_profile]'], data.description_profile);
                        setVal(profileEditFormEl.elements[formName + '[theme]'], data.theme);
                        setVal(profileEditFormEl.elements[formName + '[locale]'], data.locale);
                        setVal(profileEditFormEl.elements[formName + '[timezone]'], data.timezone);
                        openModal('profile-edit-modal');
                    }
                    function closeProfileEditModal() {
                        closeModal('profile-edit-modal');
                    }
                    if (document.getElementById('profile-edit-modal-close')) document.getElementById('profile-edit-modal-close').onclick = closeProfileEditModal;
                    if (document.getElementById('profile-edit-modal-cancel')) document.getElementById('profile-edit-modal-cancel').onclick = closeProfileEditModal;
                    if (profileEditModal && profileEditModal.querySelector('.users-edit-modal-backdrop')) profileEditModal.querySelector('.users-edit-modal-backdrop').onclick = closeProfileEditModal;

                    // Onboarding edit modal (Page 3) - 7-step wizard, populate from onboardingData
                    const onboardingEditModal = document.getElementById('onboarding-edit-modal');
                    const onboardingEditFormEl = document.getElementById('onboarding-edit-form');
                    const formName = onboardingEditFormEl ? (onboardingEditFormEl.getAttribute('data-form-name') || 'onboarding_type') : 'onboarding_type';
                    const setVal = (el, value) => { if (el) { el.value = value != null ? String(value) : ''; return true; } return false; };
                    const setChecked = (el, checked) => { if (el) { el.checked = !!checked; return true; } return false; };

                    function adminObShowStep(step) {
                        for (let s = 1; s <= 7; s++) {
                            const el = document.getElementById('admin-ob-step-' + s);
                            if (el) el.classList.toggle('ob-step-visible', s === step);
                        }
                        const dots = onboardingEditModal ? onboardingEditModal.querySelectorAll('.ob-dot') : [];
                        dots.forEach((d, i) => { d.classList.remove('ob-active', 'ob-done'); if (i + 1 < step) d.classList.add('ob-done'); else if (i + 1 === step) d.classList.add('ob-active'); });
                        const prevBtn = document.getElementById('admin-ob-prev');
                        const nextBtn = document.getElementById('admin-ob-next');
                        const submitBtn = document.getElementById('admin-ob-submit');
                        if (prevBtn) prevBtn.style.visibility = step === 1 ? 'hidden' : 'visible';
                        if (nextBtn) nextBtn.style.display = step === 7 ? 'none' : 'inline-flex';
                        if (submitBtn) submitBtn.style.display = step === 7 ? 'inline-flex' : 'none';

                        // Sync height with new step content
                        if (window.switchGlassFace) {
                            window.switchGlassFace('edit', 'onboardingGlassSwitcher');
                        }
                    }
                    function adminObSyncLocaleTheme() {
                        if (!onboardingEditModal || !onboardingEditFormEl) return;
                        const localeR = onboardingEditModal.querySelector('input[name="ob_locale_radio"]:checked');
                        const themeR = onboardingEditModal.querySelector('input[name="ob_theme_radio"]:checked');
                        const localeEl = onboardingEditFormEl.querySelector('[name*="[selectedLocale]"]');
                        const themeEl = onboardingEditFormEl.querySelector('[name*="[selectedTheme]"]');
                        if (localeR && localeEl) localeEl.value = localeR.value;
                        if (themeR && themeEl) themeEl.value = themeR.value;
                    }
                    if (onboardingEditModal) {
                        onboardingEditModal.querySelectorAll('input[name="ob_locale_radio"], input[name="ob_theme_radio"]').forEach(function(r) {
                            r.addEventListener('change', adminObSyncLocaleTheme);
                        });
                        if (document.getElementById('admin-ob-prev')) document.getElementById('admin-ob-prev').onclick = function() { adminObCurrentStep > 1 && adminObShowStep(--adminObCurrentStep); };
                        if (document.getElementById('admin-ob-next')) document.getElementById('admin-ob-next').onclick = function() { adminObCurrentStep < 7 && adminObShowStep(++adminObCurrentStep); };
                    }
                    let adminObCurrentStep = 1;

                    function openOnboardingEditModal(onboardingId) {
                        const idKey = String(onboardingId);
                        const data = onboardingData[idKey];
                        if (!data || !onboardingEditFormEl) return;
                        onboardingEditFormEl.action = editOnboardingUrlTemplate.replace('__ID__', idKey);
                        adminObCurrentStep = 1;
                        adminObShowStep(1);

                        setVal(onboardingEditFormEl.elements[formName + '[selectedLocale]'], data.selectedLocale || 'fr');
                        setVal(onboardingEditFormEl.elements[formName + '[selectedTheme]'], data.selectedTheme || 'dark');
                        const localeRadio = onboardingEditModal.querySelector('input[name="ob_locale_radio"][value="' + (data.selectedLocale || 'fr') + '"]');
                        const themeRadio = onboardingEditModal.querySelector('input[name="ob_theme_radio"][value="' + (data.selectedTheme || 'dark') + '"]');
                        if (localeRadio) localeRadio.checked = true;
                        if (themeRadio) themeRadio.checked = true;

                        onboardingEditModal.querySelectorAll('input[name^="prefs["]').forEach(function(r) { r.checked = false; });
                        let prefs = data.selectedPreferences;
                        if (typeof prefs === 'string') { try { prefs = prefs ? JSON.parse(prefs) : {}; } catch(e) { prefs = {}; } }
                        if (prefs && typeof prefs === 'object') {
                            Object.keys(prefs).forEach(function(key) {
                                const r = onboardingEditModal.querySelector('input[name="prefs[' + key + ']"][value="' + (prefs[key] || '') + '"]');
                                if (r) r.checked = true;
                            });
                        }

                        setVal(onboardingEditFormEl.elements[formName + '[suggestions]'], data.suggestions);
                        setVal(onboardingEditFormEl.elements[formName + '[step]'], data.step != null ? data.step : 1);
                        setChecked(onboardingEditFormEl.elements[formName + '[completed]'], data.completed);

                        openModal('onboarding-edit-modal');
                    }
                    function closeOnboardingEditModal() {
                        closeModal('onboarding-edit-modal');
                    }
                    
                    if (document.getElementById('onboarding-edit-modal-close')) document.getElementById('onboarding-edit-modal-close').onclick = closeOnboardingEditModal;
                    if (document.getElementById('onboarding-edit-modal-cancel')) document.getElementById('onboarding-edit-modal-cancel').onclick = closeOnboardingEditModal;
                    if (onboardingEditModal && onboardingEditModal.querySelector('.users-edit-modal-backdrop')) onboardingEditModal.querySelector('.users-edit-modal-backdrop').onclick = closeOnboardingEditModal;

                    // Onboarding View Modal logic
                    const obViewModal = document.getElementById('onboarding-view-modal');
                    const viewObModifyBtn = document.getElementById('view-ob-modify-btn');
                    let currentActiveObId = null;

                    function openObViewModal(obId) {
                        const idKey = String(obId);
                        const data = onboardingData[idKey];
                        
                        if (!data) return;
                        
                        currentActiveObId = idKey;
                        const setContent = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = val; };
                        
                        setContent('view-ob-user-name', data.userName || '—');
                        setContent('view-ob-user-email', data.userEmail || '—');
                        setContent('view-ob-locale', data.selectedLocale || '—');
                        setContent('view-ob-theme', data.selectedTheme || '—');
                        setContent('view-ob-suggestions', data.suggestions || '—');

                        const statusEl = document.getElementById('view-ob-status');
                        if (statusEl) {
                            statusEl.textContent = data.completed ? 'Completed' : 'Step ' + data.step + '/7';
                            statusEl.className = 'users-view-status-badge ' + (data.completed ? 'verified' : 'pending');
                        }
                        
                        // Format prefs
                        let prefsText = '—';
                        try {
                            let prefs = data.selectedPreferences;
                            if (typeof prefs === 'string') { try { prefs = JSON.parse(prefs); } catch(e) {} }
                            if (prefs && typeof prefs === 'object' && Object.keys(prefs).length > 0) {
                                prefsText = Object.entries(prefs).map(([k, v]) => `${k.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}: ${v}`).join('\n');
                            }
                        } catch(e) { }
                        setContent('view-ob-prefs', prefsText);

                        openModal('onboarding-view-modal');
                    }

                    function closeObViewModal() {
                        closeModal('onboarding-view-modal');
                    }

                    // Direct event listener on the table container for better delegation
                    const onboardingTableBody = document.getElementById('onboarding-table-body');
                    if (onboardingTableBody) {
                        onboardingTableBody.addEventListener('click', function(e) {
                            const btn = e.target.closest('.onboarding-view-btn');
                            if (btn && btn.dataset.onboardingId) {
                                e.preventDefault();
                                e.stopPropagation();
                                openObViewModal(btn.dataset.onboardingId);
                            }
                        });
                    }

                    if (viewObModifyBtn) {
                        viewObModifyBtn.onclick = function() {
                            if (currentActiveObId) {
                                openOnboardingEditModal(currentActiveObId);
                            }
                        };
                    }

                    if (document.getElementById('onboarding-view-modal-close')) document.getElementById('onboarding-view-modal-close').onclick = closeObViewModal;
                    if (obViewModal && obViewModal.querySelector('.users-edit-modal-backdrop')) obViewModal.querySelector('.users-edit-modal-backdrop').onclick = closeObViewModal;

                    // AJAX Form Submission Handler
                    function handleAjaxSubmit(form, onSuccess) {
                        form.addEventListener('submit', function(e) {
                            e.preventDefault();
                            const submitBtn = form.querySelector('button[type="submit"]');
                            const originalBtnHtml = submitBtn.innerHTML;
                            submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Processing...';
                            submitBtn.disabled = true;

                            const formData = new FormData(form);
                            fetch(form.action, {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                }
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    if (typeof showCoolPopup === 'function') {
                                        showCoolPopup('Success', data.message, 'success');
                                    } else {
                                        alert(data.message);
                                    }
                                    if (onSuccess) onSuccess(data);
                                    else window.location.reload();
                                } else {
                                    let errorMsg = data.message || 'An error occurred.';
                                    if (data.errors && Array.isArray(data.errors)) {
                                        errorMsg += '\n' + data.errors.join('\n');
                                    }
                                    if (typeof showCoolPopup === 'function') {
                                        showCoolPopup('Error', errorMsg, 'error');
                                    } else {
                                        alert(errorMsg);
                                    }
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                if (typeof showCoolPopup === 'function') {
                                    showCoolPopup('Error', 'A network error occurred.', 'error');
                                } else {
                                    alert('A network error occurred.');
                                }
                            })
                            .finally(() => {
                                submitBtn.innerHTML = originalBtnHtml;
                                submitBtn.disabled = false;
                            });
                        });
                    }

                    // Attach AJAX handlers
                    if (document.getElementById('user-add-form')) handleAjaxSubmit(document.getElementById('user-add-form'));
                    if (document.getElementById('user-edit-form')) handleAjaxSubmit(document.getElementById('user-edit-form'));
                    if (document.getElementById('profile-edit-form')) handleAjaxSubmit(document.getElementById('profile-edit-form'));
                    if (document.getElementById('onboarding-edit-form')) handleAjaxSubmit(document.getElementById('onboarding-edit-form'));

                    // Handle Delete via AJAX
                    if (viewDeleteForm) {
                        viewDeleteForm.onsubmit = function(e) {
                            e.preventDefault();
                            if (!confirm('Are you sure you want to delete this user?')) return;

                            const deleteBtn = viewDeleteForm.querySelector('button[type="submit"]');
                            const originalBtnHtml = deleteBtn.innerHTML;
                            deleteBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Deleting...';
                            deleteBtn.disabled = true;

                            fetch(viewDeleteForm.action, {
                                method: 'POST',
                                body: new FormData(viewDeleteForm),
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                }
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    if (typeof showCoolPopup === 'function') {
                                        showCoolPopup('Deleted', data.message, 'success');
                                    }
                                    window.location.reload();
                                } else {
                                    alert(data.message || 'Delete failed.');
                                }
                            })
                            .catch(error => alert('A network error occurred.'))
                            .finally(() => {
                                deleteBtn.innerHTML = originalBtnHtml;
                                deleteBtn.disabled = false;
                            });
                        };
                    }
                });
            </script>
            <style>
                /* Removed legacy/duplicate CSS block to allow Liquid Glass styles to apply correctly */
            </style>
