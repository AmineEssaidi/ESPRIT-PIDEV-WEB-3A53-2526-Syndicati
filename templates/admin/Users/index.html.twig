                                <script>
                                document.addEventListener('DOMContentLoaded', function() {
                                    // Custom dropdown logic for sorting pill
                                    const sortPill = document.getElementById('users-sort-pill-custom');
                                    const sortDropdown = document.getElementById('users-sort-dropdown');
                                    const sortSelected = document.getElementById('users-sort-selected');
                                    let sortValue = 'name';
                                    function closeSortDropdown() {
                                        sortDropdown.style.display = 'none';
                                        sortPill.classList.remove('open');
                                    }
                                    function openSortDropdown() {
                                        sortDropdown.style.display = 'flex';
                                        sortPill.classList.add('open');
                                    }
                                    sortPill.addEventListener('click', function(e) {
                                        e.stopPropagation();
                                        if (sortDropdown.style.display === 'flex') {
                                            closeSortDropdown();
                                        } else {
                                            openSortDropdown();
                                        }
                                    });
                                    document.querySelectorAll('.users-sort-option').forEach(opt => {
                                        opt.addEventListener('click', function(e) {
                                            sortValue = this.getAttribute('data-value');
                                            sortSelected.textContent = this.textContent;
                                            document.querySelectorAll('.users-sort-option').forEach(o => o.classList.remove('active'));
                                            this.classList.add('active');
                                            closeSortDropdown();
                                            filterAndSortRows();
                                        });
                                    });
                                    document.addEventListener('click', function(e) {
                                        if (!sortPill.contains(e.target)) closeSortDropdown();
                                    });
                                    sortPill.addEventListener('keydown', function(e) {
                                        if (e.key === 'Escape') closeSortDropdown();
                                        if (e.key === 'ArrowDown') {
                                            openSortDropdown();
                                            const first = sortDropdown.querySelector('.users-sort-option');
                                            if (first) first.focus();
                                        }
                                    });
                                    // Patch filterAndSortRows to use sortValue
                                    const origFilterAndSortRowsCustom = filterAndSortRows;
