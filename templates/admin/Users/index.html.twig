{% extends 'base.html.twig' %}

{% block title %}Users - Liquid Glass Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Users' } %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }}" style="margin: 1rem 1.5rem; padding: 0.75rem 1rem; border-radius: 8px; background: {{ label == 'success' ? 'rgba(0,230,118,0.15)' : 'rgba(255,59,48,0.15)' }}; color: {{ label == 'success' ? '#00e676' : '#ff3b30' }};">{{ message }}</div>
    {% endfor %}
{% endfor %}
<div class="users-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
    <div class="users-pagination-pills pills-animated">
        <button class="pill-tab active" data-page="1">Users</button>
        <button class="pill-tab" data-page="2">Profile</button>
        <button class="pill-tab" data-page="3">Onboarding</button>
    </div>
</div>
<div id="users-content" class="users-content" style="margin-top: 1.5rem;">
        <div class="users-page-content" data-page="1">
            <div class="liquid-glass-table-container">
                <h3 style="margin-bottom:1.5rem;">Users</h3>
                <div class="users-table-toolbar" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
                    <div style="display: flex; align-items: center;">
                        <button type="button" class="users-btn-add-db" id="users-btn-add-user" title="Add User"><i class="bx bx-plus"></i> Add User</button>
                    </div>
                    <div style="display: flex; gap: 0.7rem; align-items: center;">
                        <button class="users-sort-dir-pill" id="users-sort-dir-pill" title="Toggle Sort Direction" aria-label="Toggle Sort Direction">
                            <span id="users-sort-dir-icon-svg"></span>
                        </button>
                        <div class="users-sort-pill" id="users-sort-pill-custom" tabindex="0">
                            <span class="users-sort-selected" id="users-sort-selected">Sort by Name</span>
                            <span class="users-sort-arrow"></span>
                            <div class="users-sort-dropdown" id="users-sort-dropdown" style="display:none;">
                                <div class="users-sort-option" data-value="name">Sort by Name</div>
                                <div class="users-sort-option" data-value="email">Sort by Email</div>
                                <div class="users-sort-option" data-value="role">Sort by Role</div>
                                <div class="users-sort-option" data-value="status">Sort by Status</div>
                            </div>
                        </div>
                        <div class="users-search-pill">
                            <input type="text" class="users-search-input" placeholder="Search users..." title="Search users..." />
                            <i class="bx bx-search users-search-icon"></i>
                        </div>
                    </div>
                </div>
                <style>
                /* === RESIDENCE-STYLE MODAL & UI COMPONENTS === */
                /* Global Modal Reset & Box Sizing */
                .users-edit-modal *, .users-edit-modal *::before, .users-edit-modal *::after {
                    box-sizing: border-box !important;
                }

                /* Modal Styles */
                .users-edit-modal { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 2rem; }
                .users-edit-modal-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(8px); cursor: pointer; }
                .users-edit-modal-card { position: relative; background: linear-gradient(165deg, rgba(32, 38, 52, 0.98) 0%, rgba(20, 24, 32, 0.98) 100%); border-radius: 24px; box-shadow: 0 25px 80px rgba(0,0,0,0.7); max-width: 800px; width: 100%; border: 1px solid rgba(255,255,255,0.12); overflow: visible; max-height: 90vh; display: flex; flex-direction: column; }
                .users-edit-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.75rem 2.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
                .users-edit-modal-header h3 { margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: -0.01em; }
                .users-edit-modal-subtitle { margin: 0.5rem 0 0 0; font-size: 0.9rem; color: rgba(191,201,216,0.8); font-weight: 400; }
                .users-edit-modal-close { background: rgba(255,255,255,0.08); border: none; color: #bfc9d8; width: 2.4rem; height: 2.4rem; border-radius: 50%; font-size: 1.6rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.25s ease; }
                .users-edit-modal-close:hover { background: rgba(255,255,255,0.15); color: #fff; transform: rotate(90deg); }
                .users-edit-modal-body { padding: 2.25rem 2.5rem; display: flex; flex-direction: column; align-items: stretch; overflow-y: auto; scrollbar-width: none; overflow-x: visible; }
                .users-edit-modal-body::-webkit-scrollbar { display: none; }

                /* Modal Actions Grid */
                .users-edit-modal-actions { display: flex; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 1rem; align-items: center; }
                .users-edit-modal-actions-spacer { flex: 1; }

                /* Custom Form Groups & Inputs (Residence-style) */
                .residence-form-group { margin-bottom: 1.75rem; width: 100%; display: flex; flex-direction: column; }
                .residence-edit-label { display: block; margin-bottom: 0.75rem; color: #bfc9d8; font-weight: 600; font-size: 0.95rem; letter-spacing: 0.02em; }
                .residence-edit-input { width: 100%; border: 1px solid rgba(255, 255, 255, 0.12); padding: 0.95rem 1.25rem; border-radius: 16px; background: rgba(0, 0, 0, 0.3); color: #fff; font-size: 1rem; outline: none; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); border-left: 4px solid transparent; }
                .residence-edit-input:focus { border-color: rgba(0, 198, 255, 0.5); border-left-color: #00c6ff; background: rgba(0, 0, 0, 0.45); box-shadow: 0 8px 25px rgba(0,0,0,0.2); }
                
                /* Apply Residence input styling to modal inputs */
                .users-edit-modal-body input[type="text"],
                .users-edit-modal-body input[type="email"],
                .users-edit-modal-body input[type="password"],
                .users-edit-modal-body input[type="number"],
                .users-edit-modal-body textarea,
                .users-edit-modal-body select {
                    width: 100%;
                    border: 1px solid rgba(255, 255, 255, 0.12);
                    padding: 0.95rem 1.25rem;
                    border-radius: 16px;
                    background: rgba(0, 0, 0, 0.3);
                    color: #fff;
                    font-size: 1rem;
                    outline: none;
                    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                    border-left: 4px solid transparent;
                }
                .users-edit-modal-body input[type="text"]:focus,
                .users-edit-modal-body input[type="email"]:focus,
                .users-edit-modal-body input[type="password"]:focus,
                .users-edit-modal-body input[type="number"]:focus,
                .users-edit-modal-body textarea:focus,
                .users-edit-modal-body select:focus {
                    border-color: rgba(0, 198, 255, 0.5);
                    border-left-color: #00c6ff;
                    background: rgba(0, 0, 0, 0.45);
                    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
                }
                .users-edit-modal-body label {
                    display: block;
                    margin-bottom: 0.75rem;
                    color: #bfc9d8;
                    font-weight: 600;
                    font-size: 0.95rem;
                    letter-spacing: 0.02em;
                }

                [data-theme="light"] .residence-edit-input { background: #f0f4f8; border-color: #dce2e8; color: #1c202a; }
                [data-theme="light"] .residence-edit-input:focus { background: #fff; border-color: #0072ff; border-left-color: #00c6ff; }
                [data-theme="light"] .residence-edit-label { color: #4a5568; }
                [data-theme="light"] .users-edit-modal-body input[type="text"],
                [data-theme="light"] .users-edit-modal-body input[type="email"],
                [data-theme="light"] .users-edit-modal-body input[type="password"],
                [data-theme="light"] .users-edit-modal-body input[type="number"],
                [data-theme="light"] .users-edit-modal-body textarea,
                [data-theme="light"] .users-edit-modal-body select {
                    background: #f0f4f8;
                    border-color: #dce2e8;
                    color: #1c202a;
                }
                [data-theme="light"] .users-edit-modal-body input:focus,
                [data-theme="light"] .users-edit-modal-body textarea:focus,
                [data-theme="light"] .users-edit-modal-body select:focus {
                    background: #fff;
                    border-color: #0072ff;
                    border-left-color: #00c6ff;
                }
                [data-theme="light"] .users-edit-modal-body label {
                    color: #4a5568;
                }

                /* Custom Dropdown UI Styles */
                .custom-glass-dropdown {
                    position: relative;
                    width: 100%;
                    user-select: none;
                }
                .custom-glass-dropdown-trigger {
                    width: 100%;
                    background: rgba(0, 0, 0, 0.3);
                    border: 1px solid rgba(255, 255, 255, 0.12);
                    border-radius: 16px;
                    padding: 0 1.25rem;
                    color: #fff;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    cursor: pointer;
                    transition: all 0.25s ease;
                    font-size: 1rem;
                    height: 56px;
                    border-left: 4px solid transparent;
                }
                .custom-glass-dropdown-trigger:hover {
                    border-color: rgba(0, 198, 255, 0.45);
                    background: rgba(0, 0, 0, 0.4);
                }
                .custom-glass-dropdown.open .custom-glass-dropdown-trigger {
                    border-color: #0072ff;
                    border-left-color: #00c6ff;
                    box-shadow: 0 10px 30px rgba(0, 114, 255, 0.15);
                }
                .custom-glass-dropdown-arrow {
                    font-size: 1.4rem;
                    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                    color: #00c6ff;
                }
                .custom-glass-dropdown.open .custom-glass-dropdown-arrow {
                    transform: rotate(180deg);
                }
                .custom-glass-dropdown-menu {
                    position: absolute;
                    top: 115%;
                    left: 0;
                    width: 100%;
                    background: rgba(26, 30, 40, 0.98);
                    backdrop-filter: blur(35px) saturate(210%);
                    border: 1px solid rgba(255, 255, 255, 0.18);
                    border-radius: 16px;
                    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
                    z-index: 1000;
                    display: none;
                    flex-direction: column;
                    padding: 0.75rem;
                    max-height: 250px;
                    overflow-y: auto;
                    scrollbar-width: thin;
                    animation: dropdown-pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.1) forwards;
                }
                @keyframes dropdown-pop {
                    0% { opacity: 0; transform: translateY(-10px) scale(0.95); }
                    100% { opacity: 1; transform: translateY(0) scale(1); }
                }
                .custom-glass-dropdown-menu::-webkit-scrollbar { width: 5px; }
                .custom-glass-dropdown-menu::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }

                .custom-glass-dropdown-option {
                    padding: 0.9rem 1.25rem;
                    border-radius: 12px;
                    color: rgba(191, 201, 216, 0.9);
                    cursor: pointer;
                    transition: all 0.2s ease;
                    font-size: 1rem;
                    margin-bottom: 4px;
                }
                .custom-glass-dropdown-option:hover {
                    background: rgba(255, 255, 255, 0.12);
                    color: #fff;
                    transform: scale(1.02);
                    padding-left: 1.5rem;
                }
                .custom-glass-dropdown-option.selected {
                    background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
                    color: #fff;
                    font-weight: 700;
                    box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3);
                }

                /* Essential Fix for Overlapping boxes */
                .hidden-select {
                    display: none !important;
                    visibility: hidden !important;
                    height: 0 !important;
                    width: 0 !important;
                    position: absolute !important;
                    opacity: 0 !important;
                    overflow: hidden !important;
                }

                /* Responsive Grid System */
                .modal-grid-3 {
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 2rem;
                    width: 100%;
                    margin-bottom: 1.75rem;
                }

                /* Custom File Input UI */
                .custom-file-wrapper { position: relative; width: 100%; }
                .custom-file-trigger { 
                    width: 100%; 
                    background: rgba(0, 0, 0, 0.3); 
                    border: 1px dashed rgba(255, 255, 255, 0.2); 
                    border-radius: 16px; 
                    padding: 1rem 1.5rem; 
                    display: flex; 
                    align-items: center; 
                    gap: 1rem; 
                    cursor: pointer; 
                    transition: all 0.3s ease; 
                }
                .custom-file-trigger:hover { background: rgba(0, 198, 255, 0.05); border-color: #00c6ff; }
                .custom-file-icon { font-size: 1.8rem; color: #00c6ff; }
                .custom-file-text { flex: 1; color: rgba(191, 201, 216, 0.8); font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                .custom-file-btn { background: rgba(255, 255, 255, 0.1); color: #fff; padding: 0.5rem 1rem; border-radius: 10px; font-weight: 600; font-size: 0.85rem; }

                /* Legacy Compatibility Row */
                .forum-view-row { display: flex; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
                .forum-view-label { min-width: 120px; font-size: 0.9rem; font-weight: 700; color: rgba(191,201,216,0.7); text-transform: uppercase; letter-spacing: 0.08em; }
                .forum-view-value { flex: 1; font-size: 1.05rem; color: #e3e8f7; line-height: 1.6; }

                /* General Buttons Enhancements */
                .users-btn-cancel, .users-btn-modify, .users-btn-delete { 
                    border: none; border-radius: 14px; padding: 0.9rem 1.75rem; 
                    font-size: 1.05rem; font-weight: 700; cursor: pointer; 
                    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
                    display: inline-flex; align-items: center; gap: 0.75rem; 
                }
                .users-btn-cancel { background: rgba(255, 255, 255, 0.08); color: #bfc9d8; }
                .users-btn-cancel:hover { background: rgba(255, 255, 255, 0.15); color: #fff; transform: translateY(-2px); }
                .users-btn-modify { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); color: #fff; box-shadow: 0 10px 25px rgba(0, 114, 255, 0.3); }
                .users-btn-modify:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0, 114, 255, 0.45); }
                .users-btn-delete { background: linear-gradient(135deg, #ff3b30 0%, #ff2d92 100%); color: #fff; box-shadow: 0 10px 25px rgba(255, 45, 146, 0.25); }
                .users-btn-delete:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(255, 45, 146, 0.4); }

                [data-theme="light"] .custom-glass-dropdown-trigger { background: #f0f4f8; border-color: #dce2e8; color: #1c202a; }
                [data-theme="light"] .custom-glass-dropdown-menu { background: #fff; border-color: #dce2e8; }
                [data-theme="light"] .custom-file-trigger { background: #f0f4f8; border-color: #dce2e8; }
                /* === END RESIDENCE-STYLE COMPONENTS === */

                /* === LIQUID GLASS TABLE & PAGINATION (Added for Consistency) === */
                .liquid-glass-table-container { background: rgba(30, 34, 44, 0.7); border-radius: 24px; box-shadow: 0 8px 32px rgba(0,0,0,0.25); backdrop-filter: blur(18px); padding: 2.5rem 3rem 2rem 3rem; border: 1.5px solid rgba(255,255,255,0.08); position: relative; }
                .liquid-glass-table-scroll { overflow-x: auto; margin-top: 1.75rem; }
                .liquid-glass-table { width: 100%; min-width: 1000px; border-collapse: separate; border-spacing: 0; background: rgba(255,255,255,0.04); border-radius: 20px; overflow: hidden; color:#e3e8f7; border: 1px solid rgba(255,255,255,0.06); }
                .liquid-glass-table th { background: rgba(255,255,255,0.12); padding: 1.4rem; font-weight: 800; color:#fff; text-align: center; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; border-top: none; }
                .liquid-glass-table td { padding: 1.4rem; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.08); vertical-align: middle; }
                .liquid-glass-table tr:last-child td { border-bottom: none; }
                
                .table-pagination-bar { display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 3rem; }
                .table-arrow { width: 48px; height: 48px; border-radius: 50%; border: none; background: rgba(255,255,255,0.07); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s; font-size: 1.8rem; border: 1px solid rgba(255,255,255,0.1); }
                .table-arrow:hover:not(:disabled) { background: #0072ff; transform: scale(1.1); box-shadow: 0 0 20px rgba(0, 114, 255, 0.5); }
                .table-arrow:disabled { opacity: 0.2; cursor: not-allowed; }
                .table-page-btn { padding: 0.6rem 1.4rem; border-radius: 999px; border: none; background: transparent; color: #bfc9d8; cursor: pointer; transition: all 0.25s; font-weight: 700; font-size: 1rem; }
                .table-page-btn.active { background: #0072ff; color: #fff; box-shadow: 0 6px 15px rgba(0, 114, 255, 0.4); }

                /* Users Action Buttons (Ensure they match) */
                .users-btn-add-db { background: linear-gradient(135deg, #00e676 0%, #00bfae 100%); color:#fff; border:none; border-radius:999px; padding:0.85rem 2rem; font-weight:800; cursor:pointer; display:inline-flex; align-items:center; gap:0.75rem; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 8px 20px rgba(0, 230, 118, 0.25); height: fit-content; text-decoration: none; }
                .users-btn-add-db:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 12px 30px rgba(0, 230, 118, 0.35); color: #fff; }

                .users-btn-view-details { background: linear-gradient(135deg, #00e676 0%, #00bfae 100%); color:#fff; border:none; border-radius:999px; font-weight:800; cursor:pointer; display:inline-flex; align-items:center; gap:0.5rem; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 4px 15px rgba(0, 230, 118, 0.25); text-decoration: none; }
                .users-btn-view-details:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 230, 118, 0.35); color: #fff; }

                /* Light theme improvements */
                [data-theme="light"] .liquid-glass-table-container {
                    background: rgba(255,255,255,0.85);
                    border: 1.5px solid #e3e8f7;
                    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
                }
                [data-theme="light"] .table-pagination-bar {
                    background: transparent;
                }
                [data-theme="light"] .table-arrow {
                    background: #fff;
                    color: #0072ff;
