                    vertical-align: middle;
                }
                .liquid-glass-table tr:last-child td {
                    border-bottom: none;
                }
                .users-btn-modify, .users-btn-delete {
                    border: none;
                    border-radius: 999px;
                    padding: 0.4rem 1.1rem;
                    font-size: 1rem;
                    font-weight: 600;
                    cursor: pointer;
                    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
                    outline: none;
                    margin: 0 auto;
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                    justify-content: center;
                }
