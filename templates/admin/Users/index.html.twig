                                        }
                                        if (sortValue === 'name') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]));
                                        } else if (sortValue === 'email') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[1].localeCompare(b[1]) : b[1].localeCompare(a[1]));
                                        } else if (sortValue === 'date') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[2].localeCompare(b[2]) : b[2].localeCompare(a[2]));
                                        } else if (sortValue === 'status') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[3].localeCompare(b[3]) : b[3].localeCompare(a[3]));
                                        }
                                        filteredRows = rows;
                                        currentPage = 1;
