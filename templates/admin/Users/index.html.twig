{% extends 'base.html.twig' %}

{% block title %}Users - Liquid Glass Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Users' } %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }}" style="margin: 1rem 1.5rem; padding: 0.75rem 1rem; border-radius: 8px; background: {{ label == 'success' ? 'rgba(0,230,118,0.15)' : 'rgba(255,59,48,0.15)' }}; color: {{ label == 'success' ? '#00e676' : '#ff3b30' }};">{{ message }}</div>
    {% endfor %}
{% endfor %}
