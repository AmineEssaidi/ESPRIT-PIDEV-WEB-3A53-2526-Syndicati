                .users-edit-modal-close { background: rgba(255,255,255,0.06); border: none; color: #bfc9d8; width: 2rem; height: 2rem; border-radius: 50%; font-size: 1.4rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; transition: background 0.2s, color 0.2s; }
                .users-edit-modal-close:hover { background: rgba(255,255,255,0.12); color: #fff; }
                .users-edit-modal-body { padding: 1.5rem 1.75rem; display: flex; flex-direction: column; align-items: stretch; }
                .users-edit-modal-body form { display: flex; flex-direction: column; align-items: stretch; width: 100%; max-width: 100%; margin: 0 auto; }
                .users-edit-modal-body .mb-3 { margin-bottom: 1.1rem; width: 100%; }
                .users-edit-modal-body label { display: block; margin-bottom: 0.4rem; color: #bfc9d8; font-size: 0.9rem; font-weight: 500; }
                .users-edit-modal-body input[type="text"],
