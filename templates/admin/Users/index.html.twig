                            <script>
                                // Search and sort logic
                                document.addEventListener('DOMContentLoaded', function() {
                                    const searchInput = document.querySelector('.users-search-input');
                                    let filteredRows = [...demoTableRows];

                                    function filterAndSortRows() {
                                        let rows = [...demoTableRows];
                                        const search = searchInput.value.trim().toLowerCase();
                                        if (search) {
                                            rows = rows.filter(row => row.some(cell => cell.toLowerCase().includes(search)));
                                        }
                                        // Use global sortValue and sortDirection
                                        if (typeof sortValue === 'undefined') sortValue = 'name';
                                        if (sortValue === 'name') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]));
                                        } else if (sortValue === 'email') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[1].localeCompare(b[1]) : b[1].localeCompare(a[1]));
                                        } else if (sortValue === 'date') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[2].localeCompare(b[2]) : b[2].localeCompare(a[2]));
                                        } else if (sortValue === 'status') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[3].localeCompare(b[3]) : b[3].localeCompare(a[3]));
                                        }
                                        filteredRows = rows;
                                        currentPage = 1;
                                        updateTablePagination();
                                    }
                                    searchInput.addEventListener('input', filterAndSortRows);
                                    // Patch renderTablePage to use filteredRows
                                    const origRenderTablePage = renderTablePage;
                                    renderTablePage = function(page) {
                                        const tbody = document.getElementById('users-table-body');
                                        tbody.innerHTML = '';
                                        const start = (page-1)*rowsPerPage;
                                        const end = Math.min(start+rowsPerPage, filteredRows.length);
                                        for (let r = start; r < end; r++) {
                                            const row = document.createElement('tr');
                                            for (let c = 0; c < 8; c++) {
                                                const td = document.createElement('td');
                                                td.textContent = filteredRows[r][c];
                                                row.appendChild(td);
                                            }
                                            // Modify button
                                            const tdModify = document.createElement('td');
                                            tdModify.innerHTML = '<button class="users-btn-modify" title="Modify"><i class="bx bx-edit"></i> Modify</button>';
                                            row.appendChild(tdModify);
                                            // Delete button
                                            const tdDelete = document.createElement('td');
                                            tdDelete.innerHTML = '<button class="users-btn-delete" title="Delete"><i class="bx bx-trash"></i> Delete</button>';
                                            row.appendChild(tdDelete);
                                            tbody.appendChild(row);
                                        }
                                    };
                                    // Patch renderTablePagination to use filteredRows
                                    const origRenderTablePagination = renderTablePagination;
                                    renderTablePagination = function() {
                                        const totalPages = Math.ceil(filteredRows.length / rowsPerPage);
                                        const pagesDiv = document.getElementById('table-pages');
                                        pagesDiv.innerHTML = '';
                                        for (let i = 1; i <= totalPages; i++) {
                                            const btn = document.createElement('button');
                                            btn.className = 'table-page-btn' + (i === currentPage ? ' active' : '');
                                            btn.textContent = i;
                                            btn.onclick = () => { currentPage = i; updateTablePagination(); };
                                            pagesDiv.appendChild(btn);
                                        }
                                        document.getElementById('table-prev').disabled = currentPage === 1;
                                        document.getElementById('table-next').disabled = currentPage === totalPages;
                                    };
                                    // Initial filter and sort
                                    filterAndSortRows();
                                });
                            </script>
                <div class="liquid-glass-table-scroll">
                    <table class="liquid-glass-table" id="users-table">
                        <thead>
                            <tr>
                                {% for col in 1..8 %}
                                    <th>Col {{ col }}</th>
                                {% endfor %}
                                <th>Modify</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody id="users-table-body">
                            <!-- Table rows will be rendered by JS -->
                        </tbody>
                    </table>
                </div>
                <div class="table-pagination-bar">
                    <button class="table-arrow" id="table-prev" title="Previous Page"><i class="bx bx-chevron-left"></i></button>
                    <div class="table-pages" id="table-pages"></div>
                    <button class="table-arrow" id="table-next" title="Next Page"><i class="bx bx-chevron-right"></i></button>
                </div>
            </div>
            <script>
                // Demo data: 35 rows, 8 columns
                const demoTableRows = Array.from({length: 35}, (_, r) =>
                    Array.from({length: 8}, (_, c) => `R${r+1}C${c+1}`)
                );
                const rowsPerPage = 10;
                let currentPage = 1;
                function renderTablePage(page) {
                    const tbody = document.getElementById('users-table-body');
                    tbody.innerHTML = '';
                    const start = (page-1)*rowsPerPage;
                    const end = Math.min(start+rowsPerPage, demoTableRows.length);
                    for (let r = start; r < end; r++) {
                        const row = document.createElement('tr');
                        for (let c = 0; c < 8; c++) {
                            const td = document.createElement('td');
                            td.textContent = demoTableRows[r][c];
                            row.appendChild(td);
                        }
                        // Modify button
                        const tdModify = document.createElement('td');
                        tdModify.innerHTML = '<button class="users-btn-modify" title="Modify"><i class="bx bx-edit"></i> Modify</button>';
                        row.appendChild(tdModify);
                        // Delete button
                        const tdDelete = document.createElement('td');
                        tdDelete.innerHTML = '<button class="users-btn-delete" title="Delete"><i class="bx bx-trash"></i> Delete</button>';
                        row.appendChild(tdDelete);
                        tbody.appendChild(row);
                    }
                }
                function renderTablePagination() {
                    const totalPages = Math.ceil(demoTableRows.length / rowsPerPage);
                    const pagesDiv = document.getElementById('table-pages');
                    pagesDiv.innerHTML = '';
                    for (let i = 1; i <= totalPages; i++) {
                        const btn = document.createElement('button');
                        btn.className = 'table-page-btn' + (i === currentPage ? ' active' : '');
                        btn.textContent = i;
                        btn.onclick = () => { currentPage = i; updateTablePagination(); };
                        pagesDiv.appendChild(btn);
                    }
                    document.getElementById('table-prev').disabled = currentPage === 1;
                    document.getElementById('table-next').disabled = currentPage === totalPages;
                }
                function updateTablePagination() {
                    renderTablePage(currentPage);
                    renderTablePagination();
                }
                document.addEventListener('DOMContentLoaded', function() {
                    updateTablePagination();
                    document.getElementById('table-prev').onclick = function() {
                        if (currentPage > 1) { currentPage--; updateTablePagination(); }
                    };
                    document.getElementById('table-next').onclick = function() {
                        const totalPages = Math.ceil(demoTableRows.length / rowsPerPage);
                        if (currentPage < totalPages) { currentPage++; updateTablePagination(); }
                    };
                });
            </script>
            <style>
                                .table-pagination-bar {
                                    display: flex;
                                    justify-content: center;
