                .users-edit-modal-body input[type="password"] { width: 100%; max-width: 100%; box-sizing: border-box; padding: 0.6rem 0.9rem; border-radius: 10px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.06); color: #fff; font-size: 1rem; transition: border-color 0.2s, background 0.2s; }
                .users-edit-modal-body input[type="text"]:focus,
