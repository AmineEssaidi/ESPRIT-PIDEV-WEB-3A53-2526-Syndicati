<style>
                .users-pagination-pills {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        margin: 0 auto;
        padding: 0.25rem 0.5rem;
        background: linear-gradient(135deg, #23272f 80%, #2a2e39 100%);
        border-radius: 999px;
        min-width: 340px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        width: fit-content;
    }
    .pill-slider-bar {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        border-radius: 999px;
        background: transparent;
        z-index: 0;
        pointer-events: none;
    }
    .pill-slider {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        height: 40px;
        width: 0;
        background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
        border-radius: 999px;
        z-index: 2;
        transition: left 0.35s cubic-bezier(0.4,0,0.2,1), width 0.35s cubic-bezier(0.4,0,0.2,1);
        box-shadow: 0 4px 16px rgba(0,123,255,0.15);
        pointer-events: none;
        opacity: 1;
    }
    .pill-tab {
        background: transparent;
        color: #bfc9d8;
        border: none;
        border-radius: 999px;
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.2s, box-shadow 0.2s;
        box-shadow: none;
        outline: none;
        position: relative;
        z-index: 3;
    }
    .pill-tab.active, .pill-tab:focus {
        color: #fff;
        text-shadow: 0 2px 8px rgba(0,123,255,0.10);
        z-index: 3;
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        function showUsersPage(page) {
            document.querySelectorAll('.users-page-content').forEach(div => {
                div.style.display = (div.dataset.page == page) ? '' : 'none';
            });
        }

        // Pills animation logic
        function updatePillSlider() {
            const pills = document.querySelectorAll('.pill-tab');
            const slider = document.querySelector('.pill-slider');
            const active = document.querySelector('.pill-tab.active');
            if (!active || !slider) return;
            slider.style.left = (active.offsetLeft) + 'px';
            slider.style.width = active.offsetWidth + 'px';
        }

        document.querySelectorAll('.pill-tab').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.pill-tab').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                updatePillSlider();
                showUsersPage(this.dataset.page);
            });
        });

        // Initial load
        showUsersPage(1);
        setTimeout(updatePillSlider, 100);
        window.addEventListener('resize', updatePillSlider);
    });
</script>
