        </div>
        <div class="users-page-content" data-page="2" style="display:none;">
            <div class="liquid-glass-table-container">
                <h3 style="margin-bottom:1.5rem;">Profile</h3>
                <div class="liquid-glass-table-scroll">
                    <table class="liquid-glass-table" id="profile-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Avatar</th>
                                <th>Theme</th>
                                <th>Locale</th>
                                <th>Timezone</th>
                                <th>Description</th>
                                <th>Modify</th>
                            </tr>
                        </thead>
                        <tbody id="profile-table-body">
                            {% for p in profiles|default([]) %}
                            <tr>
                                <td>{{ p.idProfile }}</td>
                                <td>{{ p.user ? (p.user.firstName ~ ' ' ~ p.user.lastName) : '—' }}{% if p.user %} <small>({{ p.user.emailUser }})</small>{% endif %}</td>
                                <td>{{ p.avatar ? (p.avatar|length > 30 ? p.avatar|slice(0, 30) ~ '…' : p.avatar) : '—' }}</td>
                                <td>{{ p.theme ?? '—' }}</td>
                                <td>{{ p.locale ?? '—' }}</td>
                                <td>{{ p.timezone ?? '—' }}</td>
                                <td>{{ p.descriptionProfile ? (p.descriptionProfile|length > 40 ? p.descriptionProfile|slice(0, 40) ~ '…' : p.descriptionProfile) : '—' }}</td>
                                <td>
                                    <button type="button" class="users-btn-modify profile-modify-btn" data-profile-id="{{ p.idProfile }}" title="Edit profile"><i class="bx bx-edit"></i> Modify</button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="users-page-content" data-page="3" style="display:none;">
            <div class="liquid-glass-table-container">
                <h3 style="margin-bottom:1.5rem;">Onboarding</h3>
                <div class="liquid-glass-table-scroll">
                    <table class="liquid-glass-table" id="onboarding-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Step</th>
                                <th>Completed</th>
                                <th>Locale</th>
                                <th>Theme</th>
                                <th>Suggestions</th>
                                <th>Started</th>
                                <th>Completed at</th>
                                <th>Updated</th>
                                <th>Modify</th>
                            </tr>
                        </thead>
                        <tbody id="onboarding-table-body">
                            {% for o in onboardings|default([]) %}
                            <tr>
                                <td>{{ o.idOnboarding }}</td>
                                <td>{{ o.user ? (o.user.firstName ~ ' ' ~ o.user.lastName) : '—' }}{% if o.user %} <small>({{ o.user.emailUser }})</small>{% endif %}</td>
                                <td>{{ o.step }}</td>
                                <td>{{ o.completed ? 'Yes' : 'No' }}</td>
                                <td>{{ o.selectedLocale ?? '—' }}</td>
                                <td>{{ o.selectedTheme ?? '—' }}</td>
                                <td>{{ o.suggestions ? (o.suggestions|length > 30 ? o.suggestions|slice(0, 30) ~ '…' : o.suggestions) : '—' }}</td>
                                <td>{{ o.startedAt ? o.startedAt|date('Y-m-d H:i') : '—' }}</td>
                                <td>{{ o.completedAt ? o.completedAt|date('Y-m-d H:i') : '—' }}</td>
                                <td>{{ o.updatedAt ? o.updatedAt|date('Y-m-d H:i') : '—' }}</td>
                                <td>
                                    <button type="button" class="users-btn-modify onboarding-modify-btn" data-onboarding-id="{{ o.idOnboarding }}" title="Edit onboarding"><i class="bx bx-edit"></i> Modify</button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Edit Profile modal (outside page divs so it's visible when opened from Page 2) -->
        <div id="profile-edit-modal" class="users-edit-modal" style="display: none;">
            <div class="users-edit-modal-backdrop"></div>
            <div class="users-edit-modal-card">
                <div class="users-edit-modal-header">
                    <div>
                        <h3>Edit Profile</h3>
                        <p class="users-edit-modal-subtitle">Edit profile fields for this user.</p>
                    </div>
                    <button type="button" class="users-edit-modal-close" id="profile-edit-modal-close" aria-label="Close">&times;</button>
                </div>
                <div class="users-edit-modal-body">
                    {% if profileEditForm is defined %}
                    {{ form_start(profileEditForm, { 'attr': {
                        'id': 'profile-edit-form',
                        'method': 'post',
                        'action': '',
                        'class': 'users-edit-form',
                        'data-form-name': profileEditForm.vars.name
                    } }) }}
                    {{ form_row(profileEditForm.avatar, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.description_profile, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.theme, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.locale, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.timezone, { 'row_attr': { 'class': 'mb-3' } }) }}
                    <div class="users-edit-modal-actions">
                        <button type="button" class="users-btn-cancel" id="profile-edit-modal-cancel">Cancel</button>
                        <span class="users-edit-modal-actions-spacer"></span>
                        <button type="submit" class="users-btn-modify">Save changes</button>
                    </div>
                    {{ form_end(profileEditForm) }}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Edit Onboarding modal (Page 3) - same 7-step wizard as profile -->
        <div id="onboarding-edit-modal" class="users-edit-modal" style="display: none;">
            <div class="users-edit-modal-backdrop"></div>
            <div class="users-edit-modal-card onboarding-edit-modal-card">
                <div class="users-edit-modal-header">
                    <div>
                        <h3>Modify onboarding choices</h3>
                        <p class="users-edit-modal-subtitle">Update language, theme, preferences and suggestions.</p>
                    </div>
                    <button type="button" class="users-edit-modal-close" id="onboarding-edit-modal-close" aria-label="Close">&times;</button>
                </div>
                <div class="users-edit-modal-body">
                    {% if onboardingEditForm is defined %}
                    {{ form_start(onboardingEditForm, { 'attr': {
                        'id': 'onboarding-edit-form',
                        'method': 'post',
                        'action': path('admin_onboarding_edit', {id: 0}),
                        'class': 'users-edit-form',
                        'data-form-name': onboardingEditForm.vars.name
                    } }) }}
                    <div class="ob-progress ob-progress-admin" id="admin-ob-progress">{% for i in 1..7 %}<div class="ob-dot" data-step="{{ i }}"></div>{% endfor %}</div>

                    <div id="admin-ob-step-1" class="ob-step ob-step-visible">
                        <div class="ob-section"><span class="ob-label">Language</span>
                            <div class="ob-options"><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_fr" value="fr"><label for="admin_ob_locale_fr">🇫🇷 Français</label></div><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_en" value="en"><label for="admin_ob_locale_en">🇺🇸 English</label></div><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_ar" value="ar"><label for="admin_ob_locale_ar">🇸🇦 العربية</label></div><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_fr_ar" value="fr_ar"><label for="admin_ob_locale_fr_ar">🇫🇷🇸🇦 Bilingue FR/AR</label></div></div>
                        </div>
                        <div class="ob-section"><span class="ob-label">Theme</span>
                            <div class="ob-options"><div class="ob-opt"><input type="radio" name="ob_theme_radio" id="admin_ob_theme_light" value="light"><label for="admin_ob_theme_light">☀️ Light</label></div><div class="ob-opt"><input type="radio" name="ob_theme_radio" id="admin_ob_theme_dark" value="dark"><label for="admin_ob_theme_dark">🌙 Dark</label></div></div>
                        </div>
                    </div>
                    <div id="admin-ob-step-2" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Notification channel</span><div class="ob-options">{% for val, label in {'EMAIL':'📧 Email','SMS':'📱 SMS','IN_APP':'🔔 In app','ALL':'📬 All','NONE':'🔕 None'} %}<div class="ob-opt"><input type="radio" name="prefs[notification_channel]" id="admin_ob_nc_{{ val }}" value="{{ val }}"><label for="admin_ob_nc_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Frequency</span><div class="ob-options">{% for val, label in {'INSTANT':'Instant','DAILY_DIGEST':'Daily','WEEKLY_DIGEST':'Weekly','MONTHLY':'Monthly','IMPORTANT_ONLY':'Important only'} %}<div class="ob-opt"><input type="radio" name="prefs[notification_frequency]" id="admin_ob_nf_{{ val }}" value="{{ val }}"><label for="admin_ob_nf_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-3" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Property type</span><div class="ob-options">{% for val, label in {'APARTMENT':'Apartment','STUDIO':'Studio','DUPLEX':'Duplex'} %}<div class="ob-opt"><input type="radio" name="prefs[property_type]" id="admin_ob_pt_{{ val }}" value="{{ val }}"><label for="admin_ob_pt_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Occupancy</span><div class="ob-options">{% for val, label in {'OWNER_OCCUPIED':'Owner','OWNER_RENTING':'Landlord','TENANT':'Tenant','TEMPORARY':'Temporary'} %}<div class="ob-opt"><input type="radio" name="prefs[occupancy_status]" id="admin_ob_os_{{ val }}" value="{{ val }}"><label for="admin_ob_os_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Parking</span><div class="ob-options">{% for val, label in {'NONE':'None','OUTDOOR':'Outdoor','COVERED':'Covered','UNDERGROUND':'Underground','MULTIPLE':'Multiple'} %}<div class="ob-opt"><input type="radio" name="prefs[parking_type]" id="admin_ob_pk_{{ val }}" value="{{ val }}"><label for="admin_ob_pk_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-4" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Meeting participation</span><div class="ob-options">{% for val, label in {'IN_PERSON':'In person','ONLINE':'Online','HYBRID':'Hybrid','PROXY_ONLY':'Proxy only'} %}<div class="ob-opt"><input type="radio" name="prefs[meeting_participation]" id="admin_ob_mp_{{ val }}" value="{{ val }}"><label for="admin_ob_mp_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Documents</span><div class="ob-options">{% for val, label in {'DIGITAL':'Digital','PAPER':'Paper','BOTH':'Both','ECO_FRIENDLY':'Eco-friendly'} %}<div class="ob-opt"><input type="radio" name="prefs[document_delivery]" id="admin_ob_dd_{{ val }}" value="{{ val }}"><label for="admin_ob_dd_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Contact preference</span><div class="ob-options">{% for val, label in {'EMAIL':'Email','PHONE':'Phone','WHATSAPP':'WhatsApp','IN_PERSON':'In person','NO_CONTACT':'Urgency only'} %}<div class="ob-opt"><input type="radio" name="prefs[contact_preference]" id="admin_ob_cp_{{ val }}" value="{{ val }}"><label for="admin_ob_cp_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-5" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Maintenance</span><div class="ob-options">{% for val, label in {'URGENT_ONLY':'Urgent only','PREVENTIVE':'Preventive','SCHEDULED':'Scheduled','FLEXIBLE':'Flexible'} %}<div class="ob-opt"><input type="radio" name="prefs[maintenance_priority]" id="admin_ob_mt_{{ val }}" value="{{ val }}"><label for="admin_ob_mt_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Community engagement</span><div class="ob-options">{% for val, label in {'VERY_ACTIVE':'Very active','ACTIVE':'Active','MODERATE':'Moderate','OBSERVER':'Observer','MINIMAL':'Minimal'} %}<div class="ob-opt"><input type="radio" name="prefs[community_engagement]" id="admin_ob_ce_{{ val }}" value="{{ val }}"><label for="admin_ob_ce_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-6" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Payment</span><div class="ob-options">{% for val, label in {'BANK_TRANSFER':'Transfer','CASH':'Cash','CHECK':'Check','ONLINE':'Online','AUTO_DEBIT':'Auto debit'} %}<div class="ob-opt"><input type="radio" name="prefs[payment_method_preference]" id="admin_ob_pm_{{ val }}" value="{{ val }}"><label for="admin_ob_pm_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Noise sensitivity</span><div class="ob-options">{% for val, label in {'HIGH':'High','MODERATE':'Moderate','LOW':'Low','NOT_CONCERNED':'Not concerned'} %}<div class="ob-opt"><input type="radio" name="prefs[noise_sensitivity]" id="admin_ob_ns_{{ val }}" value="{{ val }}"><label for="admin_ob_ns_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Pets</span><div class="ob-options">{% for val, label in {'NO_PETS':'None','CAT':'Cat','DOG':'Dog','MULTIPLE':'Multiple','OTHER':'Other'} %}<div class="ob-opt"><input type="radio" name="prefs[pets_status]" id="admin_ob_ps_{{ val }}" value="{{ val }}"><label for="admin_ob_ps_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Accessibility</span><div class="ob-options">{% for val, label in {'NONE':'None','ELEVATOR_REQUIRED':'Elevator','WHEELCHAIR':'Wheelchair','VISUAL_IMPAIRMENT':'Visual','OTHER':'Other'} %}<div class="ob-opt"><input type="radio" name="prefs[accessibility_needs]" id="admin_ob_an_{{ val }}" value="{{ val }}"><label for="admin_ob_an_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-7" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Suggestions (optional)</span>{{ form_widget(onboardingEditForm.suggestions, { 'attr': { 'class': 'ob-textarea' } }) }}</div>
                        <div class="ob-section"><span class="ob-label">Step</span>{{ form_widget(onboardingEditForm.step) }}</div>
                        <div class="ob-section"><span class="ob-label">Completed</span>{{ form_widget(onboardingEditForm.completed) }}</div>
                    </div>

                    <div class="ob-select-hidden" aria-hidden="true">{{ form_widget(onboardingEditForm.selectedLocale) }}{{ form_widget(onboardingEditForm.selectedTheme) }}</div>

                    <div class="ob-actions">
                        <button type="button" class="ob-btn ob-btn-prev" id="admin-ob-prev" style="visibility:hidden;"><i class="bx bx-chevron-left"></i> Previous</button>
                        <div style="flex:1;"></div>
                        <button type="button" class="ob-btn ob-btn-next" id="admin-ob-next">Next <i class="bx bx-chevron-right"></i></button>
                        <button type="submit" class="ob-btn ob-btn-next" id="admin-ob-submit" style="display:none;">Save changes <i class="bx bx-check"></i></button>
                    </div>
                    {{ form_end(onboardingEditForm) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<style>
                .users-pagination-pills {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        margin: 0 auto;
        padding: 0.25rem 0.5rem;
        background: linear-gradient(135deg, #23272f 80%, #2a2e39 100%);
        border-radius: 999px;
        min-width: 340px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        width: fit-content;
    }
    .pill-slider-bar {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        border-radius: 999px;
        background: transparent;
        z-index: 0;
        pointer-events: none;
    }
    .pill-slider {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        height: 40px;
        width: 0;
        background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
        border-radius: 999px;
        z-index: 2;
        transition: left 0.35s cubic-bezier(0.4,0,0.2,1), width 0.35s cubic-bezier(0.4,0,0.2,1);
        box-shadow: 0 4px 16px rgba(0,123,255,0.15);
        pointer-events: none;
        opacity: 1;
    }
    .pill-tab {
        background: transparent;
        color: #bfc9d8;
        border: none;
        border-radius: 999px;
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.2s, box-shadow 0.2s;
        box-shadow: none;
        outline: none;
        position: relative;
        z-index: 3;
    }
    .pill-tab.active, .pill-tab:focus {
        color: #fff;
        text-shadow: 0 2px 8px rgba(0,123,255,0.10);
        z-index: 3;
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        function showUsersPage(page) {
            document.querySelectorAll('.users-page-content').forEach(div => {
                div.style.display = (div.dataset.page == page) ? '' : 'none';
            });
        }

        // Pills animation logic
        function updatePillSlider() {
            const pills = document.querySelectorAll('.pill-tab');
            const slider = document.querySelector('.pill-slider');
            const active = document.querySelector('.pill-tab.active');
            if (!active || !slider) return;
            slider.style.left = (active.offsetLeft) + 'px';
            slider.style.width = active.offsetWidth + 'px';
        }

        document.querySelectorAll('.pill-tab').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.pill-tab').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                updatePillSlider();
                showUsersPage(this.dataset.page);
            });
        });

        // Initial load
        showUsersPage(1);
        setTimeout(updatePillSlider, 100);
        window.addEventListener('resize', updatePillSlider);
    });
</script>
{% endblock %}

