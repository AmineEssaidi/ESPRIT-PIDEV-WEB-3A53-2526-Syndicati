                            <div class="mb-4 users-edit-modal-verified-wrap" style="background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                {{ form_row(editForm.is_verified, { 'attr': { 'class': 'users-edit-verified-cb' }, 'label_attr': { 'class': 'users-edit-verified-label', 'style': 'margin: 0; cursor: pointer;' } }) }}
                            </div>

                            <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                <button type="button" class="users-btn-cancel" onclick="closeModal('user-edit-modal')">Discard Changes</button>
                                <span class="users-edit-modal-actions-spacer"></span>
                                <button type="submit" class="users-btn-modify">Update Account</button>
