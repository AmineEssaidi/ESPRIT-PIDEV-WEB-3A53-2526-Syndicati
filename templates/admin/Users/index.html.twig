                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(addForm.first_name, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(addForm.last_name, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                </div>
                            </div>

                            {{ form_row(addForm.email_user, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}

                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(addForm.plainPassword.first, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(addForm.plainPassword.second, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                </div>
                            </div>

                            {{ form_row(addForm.role_user, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}

                            <div class="mb-4 users-edit-modal-verified-wrap" style="background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                {{ form_row(addForm.is_verified, { 'attr': { 'class': 'users-edit-verified-cb' }, 'label_attr': { 'class': 'users-edit-verified-label', 'style': 'margin: 0; cursor: pointer;' } }) }}
                            </div>

                            <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                <button type="button" class="users-btn-cancel" onclick="closeModal('user-add-modal')">Discard</button>
                                <span class="users-edit-modal-actions-spacer"></span>
