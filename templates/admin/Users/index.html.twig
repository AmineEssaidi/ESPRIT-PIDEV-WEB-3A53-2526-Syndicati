                            <script>
                                // Search and sort logic
                                document.addEventListener('DOMContentLoaded', function() {
                                    const searchInput = document.querySelector('.users-search-input');
                                    let filteredRows = [...demoTableRows];

                                    function filterAndSortRows() {
                                        let rows = [...demoTableRows];
                                        const search = searchInput.value.trim().toLowerCase();
                                        if (search) {
                                            rows = rows.filter(row => row.some(cell => cell.toLowerCase().includes(search)));
                                        }
                                        // Use global sortValue and sortDirection
                                        if (typeof sortValue === 'undefined') sortValue = 'name';
                                        if (sortValue === 'name') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]));
                                        } else if (sortValue === 'email') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[1].localeCompare(b[1]) : b[1].localeCompare(a[1]));
                                        } else if (sortValue === 'date') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[2].localeCompare(b[2]) : b[2].localeCompare(a[2]));
                                        } else if (sortValue === 'status') {
                                            rows.sort((a, b) => sortDirection === 'asc' ? a[3].localeCompare(b[3]) : b[3].localeCompare(a[3]));
                                        }
                                        filteredRows = rows;
                                        currentPage = 1;
                                        updateTablePagination();
                                    }
                                    searchInput.addEventListener('input', filterAndSortRows);
                                    // Patch renderTablePage to use filteredRows (same Modify/Delete as base)
                                    renderTablePage = function(page) {
                                        const tbody = document.getElementById('users-table-body');
                                        tbody.innerHTML = '';
                                        const start = (page-1)*rowsPerPage;
                                        const end = Math.min(start+rowsPerPage, filteredRows.length);
                                        for (let r = start; r < end; r++) {
                                            const row = document.createElement('tr');
                                            for (let c = 0; c < 8; c++) {
                                                const td = document.createElement('td');
                                                td.textContent = filteredRows[r][c];
                                                row.appendChild(td);
                                            }
                                            const userId = filteredRows[r][5];
                                            const tdModify = document.createElement('td');
                                            const modifyBtn = document.createElement('button');
                                            modifyBtn.className = 'users-btn-modify';
                                            modifyBtn.title = 'Modify';
                                            modifyBtn.type = 'button';
                                            modifyBtn.dataset.userId = userId;
                                            modifyBtn.innerHTML = '<i class="bx bx-edit"></i> Modify';
                                            tdModify.appendChild(modifyBtn);
                                            row.appendChild(tdModify);
                                            const tdDelete = document.createElement('td');
                                            const deleteForm = document.createElement('form');
                                            deleteForm.method = 'post';
                                            deleteForm.action = deleteUserUrlTemplate.replace('__ID__', userId);
                                            deleteForm.style.display = 'inline';
                                            deleteForm.onsubmit = function() { return confirm('Delete this user?'); };
                                            deleteForm.innerHTML = '<input type="hidden" name="_token" value="' + deleteCsrfToken + '"><button type="submit" class="users-btn-delete" title="Delete"><i class="bx bx-trash"></i> Delete</button>';
                                            tdDelete.appendChild(deleteForm);
                                            row.appendChild(tdDelete);
                                            tbody.appendChild(row);
                                        }
                                    };
                                    // Patch renderTablePagination to use filteredRows
                                    const origRenderTablePagination = renderTablePagination;
                                    renderTablePagination = function() {
                                        const totalPages = Math.ceil(filteredRows.length / rowsPerPage);
                                        const pagesDiv = document.getElementById('table-pages');
                                        pagesDiv.innerHTML = '';
                                        for (let i = 1; i <= totalPages; i++) {
                                            const btn = document.createElement('button');
                                            btn.className = 'table-page-btn' + (i === currentPage ? ' active' : '');
                                            btn.textContent = i;
                                            btn.onclick = () => { currentPage = i; updateTablePagination(); };
                                            pagesDiv.appendChild(btn);
                                        }
                                        document.getElementById('table-prev').disabled = currentPage === 1;
                                        document.getElementById('table-next').disabled = currentPage === totalPages;
                                    };
                                    // Initial filter and sort
                                    filterAndSortRows();
                                });
                            </script>
