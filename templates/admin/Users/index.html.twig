                const onboardingData = {
                {% for o in onboardings|default([]) %}
                "{{ o.idOnboarding }}": { "step": {{ o.step }}, "completed": {{ o.completed ? 'true' : 'false' }}, "selectedLocale": {{ (o.selectedLocale ?? '')|json_encode|raw }}, "selectedTheme": {{ (o.selectedTheme ?? '')|json_encode|raw }}, "suggestions": {{ (o.suggestions ?? '')|json_encode|raw }}, "selectedPreferences": {{ (o.selectedPreferences is not null and o.selectedPreferences is not empty ? o.selectedPreferences|json_encode(constant('JSON_UNESCAPED_UNICODE')) : '""')|json_encode|raw }} }{% if not loop.last %},{% endif %}
                {% endfor %}
                };
                const editOnboardingUrlTemplate = "{{ path('admin_onboarding_edit', {id: 0}) }}".replace('0', '__ID__');

                // Table rows from database (Name, Email, Date, Status, Role, ID, Created, Updated)
                const demoTableRows = [
                {% for u in users|default([]) %}
                [ "{{ (u.firstName ~ ' ' ~ u.lastName)|e('js') }}", "{{ u.emailUser|e('js') }}", "{{ u.createdAt|date('Y-m-d H:i') }}", "{{ u.isVerified ? 'Verified' : 'Pending' }}", "{{ u.roleUser|e('js') }}", "{{ u.idUser }}", "{{ u.createdAt|date('Y-m-d H:i') }}", "{{ u.updatedAt|date('Y-m-d H:i') }}" ]{% if not loop.last %},{% endif %}
                {% endfor %}
                ];
                const usersRowsPerPage = 10;
                let usersCurrentPage = 1;

                // Sorting and Filtering State
                let usersSortValue = 'name';
                let usersSortDirection = 'asc';
                let usersFilteredRows = [...demoTableRows];

                // Elements
                const usersSearchInput = document.querySelector('.users-search-input');
                const usersSortDirBtn = document.getElementById('users-sort-dir-pill');
                const usersSortDirIconSvg = document.getElementById('users-sort-dir-icon-svg');
                const usersSortPill = document.getElementById('users-sort-pill-custom');
                const usersSortDropdown = document.getElementById('users-sort-dropdown');
                const usersSortSelected = document.getElementById('users-sort-selected');

                function updateUsersSortDirIcon() {
                    if (!usersSortDirIconSvg) return;
                    usersSortDirIconSvg.innerHTML = usersSortDirection === 'asc'
                        ? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 15 12 9 18 15" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`
                        : `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 9 12 15 18 9" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
                }

                function usersFilterAndSortRows() {
                    let rows = [...demoTableRows];
                    const search = usersSearchInput ? usersSearchInput.value.trim().toLowerCase() : '';
                    
                    if (search) {
                        rows = rows.filter(row => row.some(cell => String(cell).toLowerCase().includes(search)));
                    }

                    // Sort indices: 0=Name, 1=Email, 2=Date, 3=Status, 4=Role
                    let sortIdx = 0; // Default Name
                    if (usersSortValue === 'name') sortIdx = 0;
                    else if (usersSortValue === 'email') sortIdx = 1;
                    else if (usersSortValue === 'role') sortIdx = 4; // Role
                    else if (usersSortValue === 'status') sortIdx = 3;

                    rows.sort((a, b) => {
                        let valA = String(a[sortIdx]).toLowerCase();
                        let valB = String(b[sortIdx]).toLowerCase();
                        if (usersSortDirection === 'asc') return valA.localeCompare(valB);
                        else return valB.localeCompare(valA);
                    });

                    usersFilteredRows = rows;
                    usersCurrentPage = 1;
                    updateUsersTablePagination();
                }

                function renderUsersTablePage(page) {
                    const tbody = document.getElementById('users-table-body');
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    
                    if (usersFilteredRows.length === 0) {
                        const row = document.createElement('tr');
                        row.innerHTML = '<td colspan="5" style="padding: 2rem; opacity: 0.7;">No users found.</td>';
                        tbody.appendChild(row);
                        return;
                    }

                    const start = (page-1)*usersRowsPerPage;
                    const end = Math.min(start+usersRowsPerPage, usersFilteredRows.length);
                    for (let r = start; r < end; r++) {
                        const row = document.createElement('tr');
                        
                        // Column 1: Name
                        const tdName = document.createElement('td');
                        tdName.textContent = usersFilteredRows[r][0];
                        row.appendChild(tdName);
                        
                        // Column 2: Email
                        const tdEmail = document.createElement('td');
                        tdEmail.textContent = usersFilteredRows[r][1];
                        row.appendChild(tdEmail);
                        
                        // Column 3: Role
                        const tdRole = document.createElement('td');
                        tdRole.textContent = usersFilteredRows[r][4];
                        row.appendChild(tdRole);
                        
                        // Column 4: Status
                        const tdStatus = document.createElement('td');
                        tdStatus.textContent = usersFilteredRows[r][3];
                        row.appendChild(tdStatus);
                        
                        // Column 5: Actions - View Details pill
                        const userId = usersFilteredRows[r][5];
                        const tdActions = document.createElement('td');
                        const viewBtn = document.createElement('button');
                        viewBtn.className = 'users-btn-view-details users-btn-add-db';
                        viewBtn.title = 'View Details';
                        viewBtn.type = 'button';
                        viewBtn.dataset.userId = userId;
                        viewBtn.style.padding = '0.35rem 1.25rem';
                        viewBtn.style.fontSize = '0.9rem';
                        viewBtn.innerHTML = '<i class="bx bx-show"></i> View Details';
                        tdActions.appendChild(viewBtn);
                        row.appendChild(tdActions);
                        
                        tbody.appendChild(row);
                    }
                }

                function renderUsersTablePagination() {
                    const totalPages = Math.ceil(usersFilteredRows.length / usersRowsPerPage);
                    const pagesDiv = document.getElementById('users-table-pages');
                    if (!pagesDiv) return;
                    pagesDiv.innerHTML = '';
                    for (let i = 1; i <= totalPages; i++) {
                        const btn = document.createElement('button');
                        btn.className = 'table-page-btn' + (i === usersCurrentPage ? ' active' : '');
                        btn.textContent = i;
                        btn.onclick = () => { usersCurrentPage = i; updateUsersTablePagination(); };
                        pagesDiv.appendChild(btn);
                    }
                    if(document.getElementById('users-table-prev')) document.getElementById('users-table-prev').disabled = usersCurrentPage === 1;
                    if(document.getElementById('users-table-next')) document.getElementById('users-table-next').disabled = usersCurrentPage === totalPages;
                }

                function updateUsersTablePagination() {
                    renderUsersTablePage(usersCurrentPage);
                    renderUsersTablePagination();
                }

                document.addEventListener('DOMContentLoaded', function() {
                    // Initialize Sort UI
                    updateUsersSortDirIcon();
                    usersFilterAndSortRows();

                    // Search Input Listener
                    if (usersSearchInput) {
                        usersSearchInput.addEventListener('input', usersFilterAndSortRows);
                    }

                    // Sort Direction Toggle
                    if (usersSortDirBtn) {
                        usersSortDirBtn.addEventListener('click', function() {
                            usersSortDirection = (usersSortDirection === 'asc') ? 'desc' : 'asc';
                            updateUsersSortDirIcon();
                            usersFilterAndSortRows();
                        });
                    }

                    function closeUsersSortDropdown() {
                        if (usersSortDropdown) {
                            usersSortDropdown.style.display = 'none';
                            usersSortPill.classList.remove('open');
                        }
                    }

                    // Sort Dropdown Toggle
                    if (usersSortPill && usersSortDropdown) {
                        usersSortPill.addEventListener('click', function(e) {
                            e.stopPropagation();
                            if (usersSortDropdown.style.display === 'flex') {
                                closeUsersSortDropdown();
                            } else {
                                usersSortDropdown.style.display = 'flex';
                                usersSortPill.classList.add('open');
                            }
                        });

                        document.addEventListener('click', function(e) {
                            if (!usersSortPill.contains(e.target)) {
                                closeUsersSortDropdown();
                            }
                        });
                    }

                    // Sort Options Click
                    document.querySelectorAll('.users-sort-option').forEach(opt => {
                        opt.addEventListener('click', function(e) {
                            e.stopPropagation(); // Prevent bubbling to the pill toggle
                            usersSortValue = this.getAttribute('data-value');
                            if (usersSortSelected) usersSortSelected.textContent = this.textContent;
                            document.querySelectorAll('.users-sort-option').forEach(o => o.classList.remove('active'));
                            this.classList.add('active');
                            closeUsersSortDropdown();
                            usersFilterAndSortRows();
                        });
                    });

                    // Pagination Buttons (New IDs)
                    if (document.getElementById('users-table-prev')) {
                        document.getElementById('users-table-prev').onclick = function() {
                            if (usersCurrentPage > 1) { usersCurrentPage--; updateUsersTablePagination(); }
                        };
                    }
                    if (document.getElementById('users-table-next')) {
                        document.getElementById('users-table-next').onclick = function() {
                            const totalPages = Math.ceil(usersFilteredRows.length / usersRowsPerPage);
                            if (usersCurrentPage < totalPages) { usersCurrentPage++; updateUsersTablePagination(); }
                        };
                    }


                    // Edit modal: open/close and Modify click
                    const modal = document.getElementById('user-edit-modal');
                    const editFormEl = document.getElementById('user-edit-form');
                    function openEditModal(userId) {
                        const idKey = String(userId);
                        const data = usersData[idKey] || usersData[userId];
                        if (!data || !editFormEl) return;
                        editFormEl.action = editUserUrlTemplate.replace('__ID__', idKey);
                        const formName = editFormEl.getAttribute('data-form-name') || 'user_type';
                        const setVal = (el, value) => { if (el) { el.value = value || ''; return true; } return false; };
                        const setChecked = (el, checked) => { if (el) { el.checked = !!checked; return true; } return false; };
                        function byId(attr) {
                            const id = editFormEl.getAttribute(attr);
                            return id ? document.getElementById(id) : null;
                        }
                        setVal(byId('data-id-first') || editFormEl.elements[formName + '[first_name]'], data.firstName);
                        setVal(byId('data-id-last') || editFormEl.elements[formName + '[last_name]'], data.lastName);
                        setVal(byId('data-id-email') || editFormEl.elements[formName + '[email_user]'], data.email);
                        setVal(byId('data-id-role') || editFormEl.elements[formName + '[role_user]'], data.role || 'RESIDENT');
                        setChecked(byId('data-id-verified') || editFormEl.elements[formName + '[is_verified]'], data.isVerified);
                        if (modal) modal.style.display = 'flex';
                    }
                    function closeEditModal() {
                        if (modal) modal.style.display = 'none';
                    }
                    if (document.getElementById('user-edit-modal-close')) document.getElementById('user-edit-modal-close').onclick = closeEditModal;
                    if (document.getElementById('user-edit-modal-cancel')) document.getElementById('user-edit-modal-cancel').onclick = closeEditModal;
                    if (modal && modal.querySelector('.users-edit-modal-backdrop')) modal.querySelector('.users-edit-modal-backdrop').onclick = closeEditModal;

                    // View Details modal logic
                    const viewModal = document.getElementById('user-view-modal');
                    const viewModifyBtn = document.getElementById('view-user-modify-btn');
                    const viewDeleteForm = document.getElementById('view-user-delete-form');
                    let currentActiveUserId = null;

                    function openViewModal(userId) {
                        const idKey = String(userId);
                        const userData = usersData[idKey];
                        const rowData = demoTableRows.find(r => r[5] == idKey);
                        
                        if (!userData || !rowData) return;
                        
                        currentActiveUserId = idKey;

                        // Populate basic info
                        document.getElementById('view-user-name').textContent = userData.firstName + ' ' + userData.lastName;
                        document.getElementById('view-user-email').textContent = userData.email;
                        
                        // Populate dates from demoTableRows or usersData if available
                        document.getElementById('view-user-created').textContent = rowData[6] || '-';
                        document.getElementById('view-user-updated').textContent = rowData[7] || '-';

                        // Role badge
                        const roleEl = document.getElementById('view-user-role');
                        roleEl.textContent = userData.role || 'RESIDENT';

                        // Status badge
                        const statusEl = document.getElementById('view-user-status');
                        const isVerified = userData.isVerified;
                        statusEl.textContent = isVerified ? 'Verified' : 'Pending';
                        statusEl.className = 'users-view-status-badge ' + (isVerified ? 'verified' : 'pending');

                        // Set up Delete Form action
                        viewDeleteForm.action = deleteUserUrlTemplate.replace('__ID__', idKey);
                        viewDeleteForm.onsubmit = function() { return confirm('Are you sure you want to delete this user?'); };

                        if (viewModal) viewModal.style.display = 'flex';
                    }

                    function closeViewModal() {
                        if (viewModal) viewModal.style.display = 'none';
                    }

                    // Wire up View Details button click from table
                    document.getElementById('users-content').addEventListener('click', function(e) {
                        const btn = e.target.closest('.users-btn-view-details');
                        if (btn && btn.dataset.userId) { 
                            e.preventDefault(); 
                            openViewModal(btn.dataset.userId); 
                        }
                    });

                    // Wire up Modify button in View Modal
                    if (viewModifyBtn) {
                        viewModifyBtn.onclick = function() {
                            if (currentActiveUserId) {
                                closeViewModal();
                                openEditModal(currentActiveUserId);
                            }
                        };
                    }

                    if (document.getElementById('user-view-modal-close')) document.getElementById('user-view-modal-close').onclick = closeViewModal;
                    if (viewModal && viewModal.querySelector('.users-edit-modal-backdrop')) viewModal.querySelector('.users-edit-modal-backdrop').onclick = closeViewModal;

                    // Add User modal: open/close
                    const addModal = document.getElementById('user-add-modal');
                    const addBtn = document.getElementById('users-btn-add-user');
                    if (addBtn) addBtn.addEventListener('click', function() { if (addModal) addModal.style.display = 'flex'; });
                    if (document.getElementById('user-add-modal-close')) document.getElementById('user-add-modal-close').onclick = function() { if (addModal) addModal.style.display = 'none'; };
                    if (document.getElementById('user-add-modal-cancel')) document.getElementById('user-add-modal-cancel').onclick = function() { if (addModal) addModal.style.display = 'none'; };
                    if (addModal && addModal.querySelector('.users-edit-modal-backdrop')) addModal.querySelector('.users-edit-modal-backdrop').onclick = function() { addModal.style.display = 'none'; };

                    // Profile View Modal logic
                    const profileViewModal = document.getElementById('profile-view-modal');
                    const viewProfileModifyBtn = document.getElementById('view-profile-modify-btn');
                    let currentActiveProfileId = null;

                    function openProfileViewModal(profileId, avatarUrl) {
                        const idKey = String(profileId);
                        const data = profilesData[idKey];
                        if (!data) return;
                        
                        currentActiveProfileId = idKey;

                        // Populate info
                        document.getElementById('view-profile-user-name').textContent = data.userName;
                        document.getElementById('view-profile-user-email').textContent = data.userEmail;
                        document.getElementById('view-profile-theme').textContent = data.theme !== null ? data.theme : '—';
                        document.getElementById('view-profile-locale').textContent = data.locale || '—';
                        document.getElementById('view-profile-timezone').textContent = data.timezone !== null ? data.timezone : '—';
                        document.getElementById('view-profile-description').textContent = data.description_profile || '—';

                        // Avatar
                        const imgEl = document.getElementById('view-profile-avatar-img');
                        const placeholderEl = document.getElementById('view-profile-avatar-placeholder');
                        
                        if (avatarUrl) {
                            // Use the pre-resolved URL passed from the button
                            imgEl.src = avatarUrl;
                            imgEl.style.display = 'block';
                            placeholderEl.style.display = 'none';
                        } else {
                            imgEl.style.display = 'none';
                            placeholderEl.style.display = 'flex';
                        }

                        if (profileViewModal) profileViewModal.style.display = 'flex';
                    }

                    function closeProfileViewModal() {
                        if (profileViewModal) profileViewModal.style.display = 'none';
                    }

                    // Wire up View Details for Profile
                    document.getElementById('users-content').addEventListener('click', function(e) {
                        const btn = e.target.closest('.profile-view-btn');
                        if (btn && btn.dataset.profileId) { 
                            e.preventDefault(); 
                            openProfileViewModal(btn.dataset.profileId, btn.dataset.avatarUrl); 
                        }
                    });

                    // Wire up Modify inside Profile View
                    if (viewProfileModifyBtn) {
                        viewProfileModifyBtn.onclick = function() {
                            if (currentActiveProfileId) {
                                closeProfileViewModal();
                                openProfileEditModal(currentActiveProfileId);
                            }
                        };
                    }

                    if (document.getElementById('profile-view-modal-close')) document.getElementById('profile-view-modal-close').onclick = closeProfileViewModal;
                    if (profileViewModal && profileViewModal.querySelector('.users-edit-modal-backdrop')) profileViewModal.querySelector('.users-edit-modal-backdrop').onclick = closeProfileViewModal;

                    // Profile edit modal (Page 2 - Profile table)
                    const profileEditModal = document.getElementById('profile-edit-modal');
                    const profileEditFormEl = document.getElementById('profile-edit-form');
                    function openProfileEditModal(profileId) {
                        const idKey = String(profileId);
                        const data = profilesData[idKey];
                        if (!data || !profileEditFormEl) return;
                        profileEditFormEl.action = editProfileUrlTemplate.replace('__ID__', idKey);
                        const formName = profileEditFormEl.getAttribute('data-form-name') || 'profile_type';
                        const setVal = (el, value) => { if (el) { el.value = value != null ? String(value) : ''; return true; } return false; };
                        setVal(profileEditFormEl.elements[formName + '[avatar]'], data.avatar);
                        setVal(profileEditFormEl.elements[formName + '[description_profile]'], data.description_profile);
                        setVal(profileEditFormEl.elements[formName + '[theme]'], data.theme);
                        setVal(profileEditFormEl.elements[formName + '[locale]'], data.locale);
                        setVal(profileEditFormEl.elements[formName + '[timezone]'], data.timezone);
                        if (profileEditModal) profileEditModal.style.display = 'flex';
                    }
                    function closeProfileEditModal() {
                        if (profileEditModal) profileEditModal.style.display = 'none';
                    }
                    if (document.getElementById('profile-edit-modal-close')) document.getElementById('profile-edit-modal-close').onclick = closeProfileEditModal;
                    if (document.getElementById('profile-edit-modal-cancel')) document.getElementById('profile-edit-modal-cancel').onclick = closeProfileEditModal;
                    if (profileEditModal && profileEditModal.querySelector('.users-edit-modal-backdrop')) profileEditModal.querySelector('.users-edit-modal-backdrop').onclick = closeProfileEditModal;

                    // Onboarding edit modal (Page 3) - 7-step wizard, populate from onboardingData
                    const onboardingEditModal = document.getElementById('onboarding-edit-modal');
                    const onboardingEditFormEl = document.getElementById('onboarding-edit-form');
                    const formName = onboardingEditFormEl ? (onboardingEditFormEl.getAttribute('data-form-name') || 'onboarding_type') : 'onboarding_type';
                    const setVal = (el, value) => { if (el) { el.value = value != null ? String(value) : ''; return true; } return false; };
                    const setChecked = (el, checked) => { if (el) { el.checked = !!checked; return true; } return false; };

                    function adminObShowStep(step) {
                        for (let s = 1; s <= 7; s++) {
                            const el = document.getElementById('admin-ob-step-' + s);
                            if (el) el.classList.toggle('ob-step-visible', s === step);
                        }
                        const dots = onboardingEditModal ? onboardingEditModal.querySelectorAll('.ob-dot') : [];
                        dots.forEach((d, i) => { d.classList.remove('ob-active', 'ob-done'); if (i + 1 < step) d.classList.add('ob-done'); else if (i + 1 === step) d.classList.add('ob-active'); });
                        const prevBtn = document.getElementById('admin-ob-prev');
                        const nextBtn = document.getElementById('admin-ob-next');
                        const submitBtn = document.getElementById('admin-ob-submit');
                        if (prevBtn) prevBtn.style.visibility = step === 1 ? 'hidden' : 'visible';
                        if (nextBtn) nextBtn.style.display = step === 7 ? 'none' : 'inline-flex';
                        if (submitBtn) submitBtn.style.display = step === 7 ? 'inline-flex' : 'none';
                    }
                    function adminObSyncLocaleTheme() {
                        if (!onboardingEditModal || !onboardingEditFormEl) return;
                        const localeR = onboardingEditModal.querySelector('input[name="ob_locale_radio"]:checked');
                        const themeR = onboardingEditModal.querySelector('input[name="ob_theme_radio"]:checked');
                        const localeEl = onboardingEditFormEl.querySelector('[name*="[selectedLocale]"]');
                        const themeEl = onboardingEditFormEl.querySelector('[name*="[selectedTheme]"]');
                        if (localeR && localeEl) localeEl.value = localeR.value;
                        if (themeR && themeEl) themeEl.value = themeR.value;
                    }
                    if (onboardingEditModal) {
                        onboardingEditModal.querySelectorAll('input[name="ob_locale_radio"], input[name="ob_theme_radio"]').forEach(function(r) {
                            r.addEventListener('change', adminObSyncLocaleTheme);
                        });
                        if (document.getElementById('admin-ob-prev')) document.getElementById('admin-ob-prev').onclick = function() { adminObCurrentStep > 1 && adminObShowStep(--adminObCurrentStep); };
                        if (document.getElementById('admin-ob-next')) document.getElementById('admin-ob-next').onclick = function() { adminObCurrentStep < 7 && adminObShowStep(++adminObCurrentStep); };
                    }
                    let adminObCurrentStep = 1;

                    function openOnboardingEditModal(onboardingId) {
                        const idKey = String(onboardingId);
                        const data = onboardingData[idKey];
                        if (!data || !onboardingEditFormEl) return;
                        onboardingEditFormEl.action = editOnboardingUrlTemplate.replace('__ID__', idKey);
                        adminObCurrentStep = 1;
                        adminObShowStep(1);

                        setVal(onboardingEditFormEl.elements[formName + '[selectedLocale]'], data.selectedLocale || 'fr');
                        setVal(onboardingEditFormEl.elements[formName + '[selectedTheme]'], data.selectedTheme || 'dark');
                        const localeRadio = onboardingEditModal.querySelector('input[name="ob_locale_radio"][value="' + (data.selectedLocale || 'fr') + '"]');
                        const themeRadio = onboardingEditModal.querySelector('input[name="ob_theme_radio"][value="' + (data.selectedTheme || 'dark') + '"]');
                        if (localeRadio) localeRadio.checked = true;
                        if (themeRadio) themeRadio.checked = true;

                        onboardingEditModal.querySelectorAll('input[name^="prefs["]').forEach(function(r) { r.checked = false; });
                        let prefs = data.selectedPreferences;
                        if (typeof prefs === 'string') { try { prefs = prefs ? JSON.parse(prefs) : {}; } catch(e) { prefs = {}; } }
                        if (prefs && typeof prefs === 'object') {
                            Object.keys(prefs).forEach(function(key) {
                                const r = onboardingEditModal.querySelector('input[name="prefs[' + key + ']"][value="' + (prefs[key] || '') + '"]');
                                if (r) r.checked = true;
                            });
                        }

                        setVal(onboardingEditFormEl.elements[formName + '[suggestions]'], data.suggestions);
                        setVal(onboardingEditFormEl.elements[formName + '[step]'], data.step != null ? data.step : 1);
                        setChecked(onboardingEditFormEl.elements[formName + '[completed]'], data.completed);

                        if (onboardingEditModal) onboardingEditModal.style.display = 'flex';
                    }
                    function closeOnboardingEditModal() {
                        if (onboardingEditModal) onboardingEditModal.style.display = 'none';
                    }
                    document.getElementById('users-content').addEventListener('click', function(e) {
                        const btn = e.target.closest('.onboarding-modify-btn');
                        if (btn && btn.dataset.onboardingId) { e.preventDefault(); openOnboardingEditModal(btn.dataset.onboardingId); }
                    });
                    if (document.getElementById('onboarding-edit-modal-close')) document.getElementById('onboarding-edit-modal-close').onclick = closeOnboardingEditModal;
                    if (document.getElementById('onboarding-edit-modal-cancel')) document.getElementById('onboarding-edit-modal-cancel').onclick = closeOnboardingEditModal;
                    if (onboardingEditModal && onboardingEditModal.querySelector('.users-edit-modal-backdrop')) onboardingEditModal.querySelector('.users-edit-modal-backdrop').onclick = closeOnboardingEditModal;
                });
            </script>
            <style>
                /* Removed legacy/duplicate CSS block to allow Liquid Glass styles to apply correctly */
            </style>
        </div>
        <div class="users-page-content" data-page="2" style="display:none;">
            <div class="liquid-glass-table-container">
                <h3 style="margin-bottom:1.5rem;">Profile</h3>
                <div class="liquid-glass-table-scroll">
                    <table class="liquid-glass-table" id="profile-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Avatar</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="profile-table-body">
                            {% for p in profiles|default([]) %}
                             <tr>
                                <td>{{ p.user ? (p.user.firstName ~ ' ' ~ p.user.lastName) : '—' }}{% if p.user %} <small style="display: block; opacity: 0.7;">{{ p.user.emailUser }}</small>{% endif %}</td>
                                <td>
                                    <div class="profile-avatar-container">
                                        {% if p.avatar %}
                                            <img src="{{ asset(p.avatar) }}" alt="Avatar" class="profile-avatar-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="profile-avatar-placeholder" style="display: none;"><i class="bx bx-user"></i></div>
                                        {% else %}
                                            <div class="profile-avatar-placeholder"><i class="bx bx-user"></i></div>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <button type="button" class="users-btn-view-details profile-view-btn users-btn-add-db" 
                                            data-profile-id="{{ p.idProfile }}" 
                                            data-avatar-url="{{ p.avatar ? asset(p.avatar) : '' }}"
                                            style="padding: 0.35rem 1.25rem; font-size: 0.9rem;" title="View profile details">
                                        <i class="bx bx-show"></i> View Details
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="users-page-content" data-page="3" style="display:none;">
            <div class="liquid-glass-table-container">
                <h3 style="margin-bottom:1.5rem;">Onboarding</h3>
                <div class="liquid-glass-table-scroll">
                    <table class="liquid-glass-table" id="onboarding-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Step</th>
                                <th>Completed</th>
                                <th>Locale</th>
                                <th>Theme</th>
                                <th>Suggestions</th>
                                <th>Started</th>
                                <th>Completed at</th>
                                <th>Updated</th>
                                <th>Modify</th>
                            </tr>
                        </thead>
                        <tbody id="onboarding-table-body">
                            {% for o in onboardings|default([]) %}
                            <tr>
                                <td>{{ o.idOnboarding }}</td>
                                <td>{{ o.user ? (o.user.firstName ~ ' ' ~ o.user.lastName) : '—' }}{% if o.user %} <small>({{ o.user.emailUser }})</small>{% endif %}</td>
                                <td>{{ o.step }}</td>
                                <td>{{ o.completed ? 'Yes' : 'No' }}</td>
                                <td>{{ o.selectedLocale ?? '—' }}</td>
                                <td>{{ o.selectedTheme ?? '—' }}</td>
                                <td>{{ o.suggestions ? (o.suggestions|length > 30 ? o.suggestions|slice(0, 30) ~ '…' : o.suggestions) : '—' }}</td>
                                <td>{{ o.startedAt ? o.startedAt|date('Y-m-d H:i') : '—' }}</td>
                                <td>{{ o.completedAt ? o.completedAt|date('Y-m-d H:i') : '—' }}</td>
                                <td>{{ o.updatedAt ? o.updatedAt|date('Y-m-d H:i') : '—' }}</td>
                                <td>
                                    <button type="button" class="users-btn-modify onboarding-modify-btn" data-onboarding-id="{{ o.idOnboarding }}" title="Edit onboarding"><i class="bx bx-edit"></i> Modify</button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- View Profile Details modal -->
        <div id="profile-view-modal" class="users-edit-modal" style="display: none;">
            <div class="users-edit-modal-backdrop"></div>
            <div class="users-edit-modal-card">
                <div class="users-edit-modal-header">
                    <div>
                        <h3>Profile Details</h3>
                        <p class="users-edit-modal-subtitle">Comprehensive profile information</p>
                    </div>
                    <button type="button" class="users-edit-modal-close" id="profile-view-modal-close" aria-label="Close">&times;</button>
                </div>
                <div class="users-edit-modal-body">
                    <div class="users-view-details">
                        <div style="display: flex; justify-content: center; margin-bottom: 1.5rem;">
                            <div class="profile-avatar-container" style="width: 80px; height: 80px;">
                                <img id="view-profile-avatar-img" src="" alt="Avatar" class="profile-avatar-img" style="width: 80px; height: 80px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div id="view-profile-avatar-placeholder" class="profile-avatar-placeholder" style="width: 80px; height: 80px; font-size: 2.5rem;"><i class="bx bx-user"></i></div>
                            </div>
                        </div>
                        <div class="users-view-row">
                            <div class="users-view-label">User</div>
                            <div class="users-view-value" id="view-profile-user-name">-</div>
                        </div>
                        <div class="users-view-row">
                            <div class="users-view-label">Email</div>
                            <div class="users-view-value" id="view-profile-user-email">-</div>
                        </div>
                        <div class="users-view-row">
                            <div class="users-view-label">Theme</div>
                            <div class="users-view-value" id="view-profile-theme">-</div>
                        </div>
                        <div class="users-view-row">
                            <div class="users-view-label">Locale</div>
                            <div class="users-view-value" id="view-profile-locale">-</div>
                        </div>
                        <div class="users-view-row">
                            <div class="users-view-label">Timezone</div>
                            <div class="users-view-value" id="view-profile-timezone">-</div>
                        </div>
                        <div class="users-view-row" style="flex-direction: column; align-items: flex-start;">
                            <div class="users-view-label" style="margin-bottom: 0.5rem;">Description</div>
                            <div class="users-view-value" id="view-profile-description" style="line-height: 1.5; color: rgba(255,255,255,0.7);">—</div>
                        </div>
                    </div>
                    <div class="users-view-modal-actions" style="margin-top: 2rem;">
                        <button type="button" class="users-btn-modify" id="view-profile-modify-btn">
                            <i class="bx bx-edit"></i> Modify
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Profile modal (outside page divs so it's visible when opened from Page 2) -->
        <div id="profile-edit-modal" class="users-edit-modal" style="display: none;">
            <div class="users-edit-modal-backdrop"></div>
            <div class="users-edit-modal-card">
                <div class="users-edit-modal-header">
                    <div>
                        <h3>Edit Profile</h3>
                        <p class="users-edit-modal-subtitle">Edit profile fields for this user.</p>
                    </div>
                    <button type="button" class="users-edit-modal-close" id="profile-edit-modal-close" aria-label="Close">&times;</button>
                </div>
                <div class="users-edit-modal-body">
                    {% if profileEditForm is defined %}
                    {{ form_start(profileEditForm, { 'attr': {
                        'id': 'profile-edit-form',
                        'method': 'post',
                        'action': '',
                        'class': 'users-edit-form',
                        'data-form-name': profileEditForm.vars.name
                    } }) }}
                    {{ form_row(profileEditForm.avatar, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.description_profile, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.theme, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.locale, { 'row_attr': { 'class': 'mb-3' } }) }}
                    {{ form_row(profileEditForm.timezone, { 'row_attr': { 'class': 'mb-3' } }) }}
                    <div class="users-edit-modal-actions">
                        <button type="button" class="users-btn-cancel" id="profile-edit-modal-cancel">Cancel</button>
                        <span class="users-edit-modal-actions-spacer"></span>
                        <button type="submit" class="users-btn-modify">Save changes</button>
                    </div>
                    {{ form_end(profileEditForm) }}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Edit Onboarding modal (Page 3) - same 7-step wizard as profile -->
        <div id="onboarding-edit-modal" class="users-edit-modal" style="display: none;">
            <div class="users-edit-modal-backdrop"></div>
            <div class="users-edit-modal-card onboarding-edit-modal-card">
                <div class="users-edit-modal-header">
                    <div>
                        <h3>Modify onboarding choices</h3>
                        <p class="users-edit-modal-subtitle">Update language, theme, preferences and suggestions.</p>
                    </div>
                    <button type="button" class="users-edit-modal-close" id="onboarding-edit-modal-close" aria-label="Close">&times;</button>
                </div>
                <div class="users-edit-modal-body">
                    {% if onboardingEditForm is defined %}
                    {{ form_start(onboardingEditForm, { 'attr': {
                        'id': 'onboarding-edit-form',
                        'method': 'post',
                        'action': path('admin_onboarding_edit', {id: 0}),
                        'class': 'users-edit-form',
                        'data-form-name': onboardingEditForm.vars.name
                    } }) }}
                    <div class="ob-progress ob-progress-admin" id="admin-ob-progress">{% for i in 1..7 %}<div class="ob-dot" data-step="{{ i }}"></div>{% endfor %}</div>

                    <div id="admin-ob-step-1" class="ob-step ob-step-visible">
                        <div class="ob-section"><span class="ob-label">Language</span>
                            <div class="ob-options"><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_fr" value="fr"><label for="admin_ob_locale_fr">🇫🇷 Français</label></div><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_en" value="en"><label for="admin_ob_locale_en">🇺🇸 English</label></div><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_ar" value="ar"><label for="admin_ob_locale_ar">🇸🇦 العربية</label></div><div class="ob-opt"><input type="radio" name="ob_locale_radio" id="admin_ob_locale_fr_ar" value="fr_ar"><label for="admin_ob_locale_fr_ar">🇫🇷🇸🇦 Bilingue FR/AR</label></div></div>
                        </div>
                        <div class="ob-section"><span class="ob-label">Theme</span>
                            <div class="ob-options"><div class="ob-opt"><input type="radio" name="ob_theme_radio" id="admin_ob_theme_light" value="light"><label for="admin_ob_theme_light">☀️ Light</label></div><div class="ob-opt"><input type="radio" name="ob_theme_radio" id="admin_ob_theme_dark" value="dark"><label for="admin_ob_theme_dark">🌙 Dark</label></div></div>
                        </div>
                    </div>
                    <div id="admin-ob-step-2" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Notification channel</span><div class="ob-options">{% for val, label in {'EMAIL':'📧 Email','SMS':'📱 SMS','IN_APP':'🔔 In app','ALL':'📬 All','NONE':'🔕 None'} %}<div class="ob-opt"><input type="radio" name="prefs[notification_channel]" id="admin_ob_nc_{{ val }}" value="{{ val }}"><label for="admin_ob_nc_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Frequency</span><div class="ob-options">{% for val, label in {'INSTANT':'Instant','DAILY_DIGEST':'Daily','WEEKLY_DIGEST':'Weekly','MONTHLY':'Monthly','IMPORTANT_ONLY':'Important only'} %}<div class="ob-opt"><input type="radio" name="prefs[notification_frequency]" id="admin_ob_nf_{{ val }}" value="{{ val }}"><label for="admin_ob_nf_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-3" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Property type</span><div class="ob-options">{% for val, label in {'APARTMENT':'Apartment','STUDIO':'Studio','DUPLEX':'Duplex'} %}<div class="ob-opt"><input type="radio" name="prefs[property_type]" id="admin_ob_pt_{{ val }}" value="{{ val }}"><label for="admin_ob_pt_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Occupancy</span><div class="ob-options">{% for val, label in {'OWNER_OCCUPIED':'Owner','OWNER_RENTING':'Landlord','TENANT':'Tenant','TEMPORARY':'Temporary'} %}<div class="ob-opt"><input type="radio" name="prefs[occupancy_status]" id="admin_ob_os_{{ val }}" value="{{ val }}"><label for="admin_ob_os_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Parking</span><div class="ob-options">{% for val, label in {'NONE':'None','OUTDOOR':'Outdoor','COVERED':'Covered','UNDERGROUND':'Underground','MULTIPLE':'Multiple'} %}<div class="ob-opt"><input type="radio" name="prefs[parking_type]" id="admin_ob_pk_{{ val }}" value="{{ val }}"><label for="admin_ob_pk_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-4" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Meeting participation</span><div class="ob-options">{% for val, label in {'IN_PERSON':'In person','ONLINE':'Online','HYBRID':'Hybrid','PROXY_ONLY':'Proxy only'} %}<div class="ob-opt"><input type="radio" name="prefs[meeting_participation]" id="admin_ob_mp_{{ val }}" value="{{ val }}"><label for="admin_ob_mp_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Documents</span><div class="ob-options">{% for val, label in {'DIGITAL':'Digital','PAPER':'Paper','BOTH':'Both','ECO_FRIENDLY':'Eco-friendly'} %}<div class="ob-opt"><input type="radio" name="prefs[document_delivery]" id="admin_ob_dd_{{ val }}" value="{{ val }}"><label for="admin_ob_dd_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Contact preference</span><div class="ob-options">{% for val, label in {'EMAIL':'Email','PHONE':'Phone','WHATSAPP':'WhatsApp','IN_PERSON':'In person','NO_CONTACT':'Urgency only'} %}<div class="ob-opt"><input type="radio" name="prefs[contact_preference]" id="admin_ob_cp_{{ val }}" value="{{ val }}"><label for="admin_ob_cp_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-5" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Maintenance</span><div class="ob-options">{% for val, label in {'URGENT_ONLY':'Urgent only','PREVENTIVE':'Preventive','SCHEDULED':'Scheduled','FLEXIBLE':'Flexible'} %}<div class="ob-opt"><input type="radio" name="prefs[maintenance_priority]" id="admin_ob_mt_{{ val }}" value="{{ val }}"><label for="admin_ob_mt_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Community engagement</span><div class="ob-options">{% for val, label in {'VERY_ACTIVE':'Very active','ACTIVE':'Active','MODERATE':'Moderate','OBSERVER':'Observer','MINIMAL':'Minimal'} %}<div class="ob-opt"><input type="radio" name="prefs[community_engagement]" id="admin_ob_ce_{{ val }}" value="{{ val }}"><label for="admin_ob_ce_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-6" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Payment</span><div class="ob-options">{% for val, label in {'BANK_TRANSFER':'Transfer','CASH':'Cash','CHECK':'Check','ONLINE':'Online','AUTO_DEBIT':'Auto debit'} %}<div class="ob-opt"><input type="radio" name="prefs[payment_method_preference]" id="admin_ob_pm_{{ val }}" value="{{ val }}"><label for="admin_ob_pm_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Noise sensitivity</span><div class="ob-options">{% for val, label in {'HIGH':'High','MODERATE':'Moderate','LOW':'Low','NOT_CONCERNED':'Not concerned'} %}<div class="ob-opt"><input type="radio" name="prefs[noise_sensitivity]" id="admin_ob_ns_{{ val }}" value="{{ val }}"><label for="admin_ob_ns_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Pets</span><div class="ob-options">{% for val, label in {'NO_PETS':'None','CAT':'Cat','DOG':'Dog','MULTIPLE':'Multiple','OTHER':'Other'} %}<div class="ob-opt"><input type="radio" name="prefs[pets_status]" id="admin_ob_ps_{{ val }}" value="{{ val }}"><label for="admin_ob_ps_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                        <div class="ob-section"><span class="ob-label">Accessibility</span><div class="ob-options">{% for val, label in {'NONE':'None','ELEVATOR_REQUIRED':'Elevator','WHEELCHAIR':'Wheelchair','VISUAL_IMPAIRMENT':'Visual','OTHER':'Other'} %}<div class="ob-opt"><input type="radio" name="prefs[accessibility_needs]" id="admin_ob_an_{{ val }}" value="{{ val }}"><label for="admin_ob_an_{{ val }}">{{ label }}</label></div>{% endfor %}</div></div>
                    </div>
                    <div id="admin-ob-step-7" class="ob-step">
                        <div class="ob-section"><span class="ob-label">Suggestions (optional)</span>{{ form_widget(onboardingEditForm.suggestions, { 'attr': { 'class': 'ob-textarea' } }) }}</div>
                        <div class="ob-section"><span class="ob-label">Step</span>{{ form_widget(onboardingEditForm.step) }}</div>
                        <div class="ob-section"><span class="ob-label">Completed</span>{{ form_widget(onboardingEditForm.completed) }}</div>
                    </div>

                    <div class="ob-select-hidden" aria-hidden="true">{{ form_widget(onboardingEditForm.selectedLocale) }}{{ form_widget(onboardingEditForm.selectedTheme) }}</div>

                    <div class="ob-actions">
                        <button type="button" class="ob-btn ob-btn-prev" id="admin-ob-prev" style="visibility:hidden;"><i class="bx bx-chevron-left"></i> Previous</button>
                        <div style="flex:1;"></div>
                        <button type="button" class="ob-btn ob-btn-next" id="admin-ob-next">Next <i class="bx bx-chevron-right"></i></button>
                        <button type="submit" class="ob-btn ob-btn-next" id="admin-ob-submit" style="display:none;">Save changes <i class="bx bx-check"></i></button>
                    </div>
                    {{ form_end(onboardingEditForm) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<style>
                .users-pagination-pills {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        margin: 0 auto;
        padding: 0.25rem 0.5rem;
        background: linear-gradient(135deg, #23272f 80%, #2a2e39 100%);
        border-radius: 999px;
        min-width: 340px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        width: fit-content;
    }

    .pill-tab {
        background: transparent;
        color: rgba(191,201,216,0.8);
        border: none;
        border-radius: 999px;
        padding: 0.75rem 2rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        outline: none;
        position: relative;
        z-index: 2;
        white-space: nowrap;
    }
    .pill-tab:hover {
        color: #fff;
        background: rgba(255,255,255,0.05);
    }
    .pill-tab.active, .pill-tab:focus {
        background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
        color: #fff;
        text-shadow: none;
        box-shadow: 0 4px 12px rgba(0, 114, 255, 0.3);
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        function showUsersPage(page) {
            document.querySelectorAll('.users-page-content').forEach(div => {
                div.style.display = (div.dataset.page == page) ? '' : 'none';
            });
        }

        // Pills animation logic
        document.querySelectorAll('.pill-tab').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.pill-tab').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                showUsersPage(this.dataset.page);
            });
        });

        // Initial load
        showUsersPage(1);
    });
</script>
{% endblock %}

