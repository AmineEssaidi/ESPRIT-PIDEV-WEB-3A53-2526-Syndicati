    <div class="users-pagination-pills pills-animated">
        <div class="pill-slider-bar"></div>
        <div class="pill-slider"></div>
        <button class="pill-tab active" data-page="1">Page 1</button>
        <button class="pill-tab" data-page="2">Page 2</button>
        <button class="pill-tab" data-page="3">Page 3</button>
        <button class="pill-tab" data-page="4">Page 4</button>
    </div>
