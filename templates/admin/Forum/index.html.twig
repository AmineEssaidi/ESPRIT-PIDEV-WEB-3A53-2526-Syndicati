                            <div class="users-edit-modal-body">
                                {% if commentEditForm is defined %}
                                {{ form_start(commentEditForm, { 'attr': { 'id': 'comment-edit-form', 'method': 'post', 'action': '', 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh' } }) }}
                                
                                {{ form_row(commentEditForm.description_commentaire, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'style': 'height: 120px;', 'required': 'required', 'minlength': '5' } }) }}
                                <div class="validation-container" data-field="description_commentaire"></div>
                                {{ form_row(commentEditForm.visibility, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                <div class="validation-container" data-field="visibility"></div>
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
