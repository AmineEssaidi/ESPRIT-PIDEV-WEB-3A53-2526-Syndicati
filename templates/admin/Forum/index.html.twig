                <i class="bx bx-error-circle"></i>
            </div>
            <div class="confirm-modal-content">
                <div class="confirm-modal-title" id="confirm-title">Are you sure?</div>
                <div class="confirm-modal-text" id="confirm-text">This action cannot be undone. Do you really want to delete this?</div>
            </div>
            <div class="confirm-modal-actions">
                <button type="button" class="confirm-btn-cancel" id="confirm-btn-cancel">
                    Cancel
                </button>
