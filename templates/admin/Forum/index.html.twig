<!-- Publication Add modal -->
<div id="pub-add-modal" class="users-edit-modal" style="display: none;">
    <div class="users-edit-modal-backdrop"></div>
    <div class="users-edit-modal-card">
        <div class="users-edit-modal-header">
            <div>
                <h3>Add Publication</h3>
                <p class="users-edit-modal-subtitle">Create a new publication for the forum.</p>
            </div>
            <button type="button" class="users-edit-modal-close" id="pub-add-modal-close" aria-label="Close">&times;</button>
        </div>
        <div class="users-edit-modal-body">
            {% if pubAddForm is defined %}
            {{ form_start(pubAddForm, { 'attr': {
                'id': 'pub-add-form',
                'method': 'post',
                'action': path('admin_forum_pub_add'),
                'enctype': 'multipart/form-data',
                'class': 'users-edit-form'
            } }) }}
            
            <div class="residence-form-group">
                <label class="residence-edit-label">Title</label>
                {{ form_widget(pubAddForm.titre_pub, { 'attr': { 'class': 'residence-edit-input', 'placeholder': 'Enter publication title' } }) }}
            </div>
            
            <div class="residence-form-group">
                <label class="residence-edit-label">Description</label>
                {{ form_widget(pubAddForm.description_pub, { 'attr': { 'class': 'residence-edit-input', 'style': 'min-height: 100px;', 'placeholder': 'Enter publication description' } }) }}
            </div>

            <div class="residence-form-group">
                <label class="residence-edit-label">Category</label>
                {{ form_widget(pubAddForm.categorie_pub, { 'attr': { 'class': 'hidden-select', 'id': 'add-pub-category' } }) }}
                <div class="custom-glass-dropdown" data-target="add-pub-category">
                    <div class="custom-glass-dropdown-trigger">
                        <span class="selected-text">Select Category</span>
                        <i class="bx bx-chevron-down custom-glass-dropdown-arrow"></i>
                    </div>
                    <div class="custom-glass-dropdown-menu">
                        <!-- Options will be populated by JS from the hidden select -->
                    </div>
                </div>
            </div>

            <div class="residence-form-group">
                <label class="residence-edit-label">Image (optional)</label>
                <div class="custom-file-wrapper">
                    {{ form_widget(pubAddForm.image_pub, { 'attr': { 'class': 'hidden-select residence-image-input' } }) }}
                    <div class="custom-file-trigger" onclick="document.querySelector('#pub-add-modal .residence-image-input').click()">
                        <div class="custom-file-icon"><i class="bx bx-image-add"></i></div>
                        <div class="custom-file-text">Click to upload image...</div>
                        <div class="custom-file-btn">Browse</div>
                    </div>
                </div>
            </div>
            
            <div class="users-edit-modal-actions">
                <button type="button" class="users-btn-cancel" id="pub-add-modal-cancel">Cancel</button>
                <span class="users-edit-modal-actions-spacer"></span>
                <button type="submit" class="users-btn-modify forum-btn-modify">
                    <i class="bx bx-plus"></i> Add Publication
                </button>
            </div>
            {{ form_end(pubAddForm) }}
            {% endif %}
        </div>
    </div>
</div>

