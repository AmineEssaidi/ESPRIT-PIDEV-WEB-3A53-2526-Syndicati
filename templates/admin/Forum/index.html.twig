    <!-- Page 2: Commentaires -->
    <div class="forum-page-content" data-page="2" style="display: none;">
        <div class="glass-table-container">
            <div id="forumCommentGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
