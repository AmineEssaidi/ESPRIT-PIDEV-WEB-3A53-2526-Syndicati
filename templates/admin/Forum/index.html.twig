                </div>

                <div class="glass-switcher-face glass-switcher-face-edit" id="comment-edit-face">
                    <div id="comment-edit-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Edit Comment</h3>
