			</div>
		</div>
		<div class="forum-page-content" data-page="3" style="display:none;">
			<div class="forum-list-demo">
				<h3 style="margin-bottom:1rem;">Demo Forums (Page 3)</h3>
				<ul style="list-style:none;padding:0;">
					<li style="padding:0.5rem 0;border-bottom:1px solid #eee;">Forum Topic 4</li>
					<li style="padding:0.5rem 0;">Forum Topic 5</li>
				</ul>
			</div>
		</div>
		<div class="forum-page-content" data-page="4" style="display:none;">
			<div class="forum-list-demo">
				<h3 style="margin-bottom:1rem;">Demo Forums (Page 4)</h3>
				<ul style="list-style:none;padding:0;">
					<li style="padding:0.5rem 0;">Forum Topic 6</li>
