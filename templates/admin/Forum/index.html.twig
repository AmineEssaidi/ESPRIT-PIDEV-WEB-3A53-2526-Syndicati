{% extends 'base.html.twig' %}

{% block title %}Forum - Liquid Glass Admin{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('frontend/css/glass_switcher.css') }}" rel="stylesheet">
    <style>
        /* Hide Scrollbar Global */
        html, body, .admin-shell, .layout-wrapper, .layout-page, .content-wrapper, .container-xxl {
            scrollbar-width: none !important; /* Firefox */
            -ms-overflow-style: none !important; /* IE 10+ */
            overflow-x: hidden !important; /* Force no horizontal scroll */
        }
        html::-webkit-scrollbar, body::-webkit-scrollbar,
        .admin-shell::-webkit-scrollbar, .layout-wrapper::-webkit-scrollbar, 
        .layout-page::-webkit-scrollbar, .content-wrapper::-webkit-scrollbar, 
        .container-xxl::-webkit-scrollbar {
            display: none !important; /* Chrome/Safari/Webkit */
            width: 0 !important;
            height: 0 !important;
        }

        /* Ensure box-sizing prevents padding overflow */
        .users-edit-modal, .users-edit-modal * {
            box-sizing: border-box !important;
        }

        /* Premium Modal Face-Lift - Obsidian Edition */
        /* Premium Modal Face-Lift - Obsidian Edition */
        .users-edit-modal {
            display: none;
            position: relative !important;
            width: 100% !important;
            height: auto !important;
            min-height: 100%;
            z-index: 10;
            padding: 0 !important; /* REMOVED PADDING */
            align-items: flex-start; 
            justify-content: flex-start; 
            background: transparent; 
        }
        .users-edit-modal::-webkit-scrollbar { display: none; /* Chrome/Safari/Webkit */ }

        .users-edit-modal.active {
            display: flex;
            animation: modalFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(40px) scale(0.97); filter: blur(10px); }
            to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }

        .users-edit-modal-card {
            background: transparent !important; /* REMOVED BACKGROUND */
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border: none !important; 
            box-shadow: none !important; 
            width: 100% !important;
            max-width: 100% !important; 
            margin: 0 !important; 
            
            /* Vertical Constraints */
            min-height: auto !important; 
            display: flex !important;
            flex-direction: column !important;

            border-radius: 0 !important;
            overflow: visible; 
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .users-edit-modal-header {
            flex-shrink: 0; 
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1.5rem 2rem !important; /* REDUCED PADDING */
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent; 
        }
        .users-edit-modal-header h3 {
            font-size: 2rem !important;
            font-weight: 900 !important;
            letter-spacing: -0.04em !important;
            margin: 0 !important;
            color: #fff !important;
            text-shadow: 0 4px 12px rgba(0,0,0,0.3);
        }
        .users-edit-modal-subtitle {
            font-size: 1rem !important;
            color: rgba(255, 255, 255, 0.45) !important;
            margin-top: 0.5rem !important;
            font-weight: 500;
        }
        .users-edit-modal-close {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 50% !important;
            color: rgba(255, 255, 255, 0.6) !important;
            font-size: 1.6rem !important;
            display: flex !important;
            align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }
        .users-edit-modal-close:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            transform: rotate(180deg) scale(1.1);
            color: #fff !important;
        }
        .users-edit-modal-body {
            padding: 2rem !important; /* REDUCED PADDING */
            overflow-y: visible !important; 
            flex-grow: 1; 
            
            /* Hide scrollbar completely */
            scrollbar-width: none; 
            -ms-overflow-style: none; 
        }
        .users-edit-modal-body::-webkit-scrollbar {
            display: none; /* Chrome/Safari/Webkit */
        }

        /* Obsidian Form Styling */
        .glass-form-group {
            margin-bottom: 1.5rem; /* REDUCED MARGIN */
        }
        .glass-label {
            display: block;
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.3) !important;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            transition: all 0.3s ease;
        }
        .glass-form-group:focus-within .glass-label { color: rgba(255, 255, 255, 0.8) !important; transform: translateX(5px); }
        .glass-input, .form-control.bg-dark {
            width: 100%;
            background: rgba(0, 0, 0, 0.5) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 20px !important;
            padding: 1.2rem 1.6rem !important;
            color: #fff !important;
            font-size: 1.1rem !important;
            font-weight: 500;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.5) !important;
        }
        .glass-input:focus, .form-control.bg-dark:focus {
            background: rgba(0, 0, 0, 0.7) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 20px 40px rgba(0,0,0,0.4) !important;
            outline: none !important;
            transform: scale(1.01) translateY(-2px);
        }

        /* Obsidian View Details */
        .glass-view-row {
            display: flex;
            align-items: flex-start; /* ALIGNED TO TOP FOR LONG TEXT */
            padding: 1.8rem 2.5rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            margin-bottom: 1.5rem;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .glass-view-row:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            transform: translateX(12px) scale(1.01);
            box-shadow: -20px 0 40px rgba(0,0,0,0.3);
        }
        .glass-view-label {
            font-size: 0.9rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.25) !important;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            width: 180px;
            flex-shrink: 0;
        }
        .glass-view-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            flex: 1;
            word-break: break-all !important; /* PREVENTS OVERFLOW ON LONG STRINGS */
            white-space: pre-wrap !important; /* PRESERVES LINE BREAKS */
            line-height: 1.6;
        }

        /* Obsidian Buttons */
        .users-btn-modify {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%) !important;
            color: #fff !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            letter-spacing: 0.04em !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            cursor: pointer !important; transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1) !important;
            backdrop-filter: blur(5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
        }
        .users-btn-modify:hover {
            background: rgba(255, 255, 255, 0.15) !important;
            border-color: rgba(255, 255, 255, 0.3) !important;
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.1) !important;
        }
        .users-btn-delete {
            background: rgba(255, 59, 48, 0.05) !important;
            color: #ff3b30 !important;
            border: 1px solid rgba(255, 59, 48, 0.15) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            cursor: pointer !important;
            transition: all 0.4s ease !important;
            display: inline-flex !important; align-items: center !important; gap: 1rem !important;
            backdrop-filter: blur(5px);
        }
        .users-btn-delete:hover {
            background: rgba(255, 59, 48, 0.15) !important;
            border-color: #ff3b30 !important;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(255, 59, 48, 0.2) !important;
        }
        .users-btn-cancel, .users-btn-discard {
            background: rgba(255, 255, 255, 0.02) !important;
            color: rgba(255, 255, 255, 0.4) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 1rem 2.5rem !important;
            border-radius: 100px !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
        }
        .users-btn-cancel:hover { background: rgba(255, 255, 255, 0.08) !important; color: #fff !important; }

        /* Badge Styles Cleanup */
        .badge-premium-admin { background: rgba(255, 255, 255, 0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2); }

        /* Premium Switcher Styles (Unified) */
        .premium-switcher-container {
            padding: 4px;
            background: rgba(10, 10, 10, 0.45);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 100px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 10;
            min-width: 400px;
        }
        .premium-switcher-pill { display: flex; position: relative; width: 100%; height: 44px; }
        .premium-switcher-slider {
            position: absolute; top: 0; left: 0; height: 100%;
            background: var(--accent-gradient, linear-gradient(90deg, #00c6ff 0%, #0072ff 100%));
            border-radius: 100px; box-shadow: 0 4px 20px rgba(0, 114, 255, 0.4);
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1); z-index: 1; pointer-events: none;
        }
        .premium-switcher-tab {
            flex: 1; position: relative; z-index: 2; background: transparent; border: none;
            color: rgba(255, 255, 255, 0.55); font-weight: 700; font-size: 0.95rem;
            letter-spacing: 0.03em; cursor: pointer; transition: all 0.3s ease;
            white-space: nowrap; outline: none; display: flex; align-items: center; justify-content: center;
            padding: 0 1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        .premium-switcher-tab.active { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .premium-switcher-tab:hover:not(.active) { color: #fff; background: rgba(255, 255, 255, 0.05); border-radius: 100px; }

        /* Badge Styles */
        .badge-neon {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .badge-neon-discussion { background: rgba(0, 198, 255, 0.15); color: #00c6ff; border-color: rgba(0, 198, 255, 0.3); }
        .badge-neon-announcement { background: rgba(255, 45, 146, 0.15); color: #ff2d92; border-color: rgba(255, 45, 146, 0.3); }
        .badge-neon-suggestion { background: rgba(0, 230, 118, 0.15); color: #00e676; border-color: rgba(0, 230, 118, 0.3); }
        .badge-neon-info { background: rgba(255, 193, 7, 0.15); color: #ffc107; border-color: rgba(255, 193, 7, 0.3); }
    </style>
{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Forum' } %}

<div class="users-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
    <div class="premium-switcher-container">
        <div class="premium-switcher-pill">
            <div class="premium-switcher-slider" id="forum-switcher-slider"></div>
            <button class="premium-switcher-tab active" data-page="1">Publications</button>
            <button class="premium-switcher-tab" data-page="2">Commentaires</button>
            <button class="premium-switcher-tab" data-page="3">Reactions</button>
        </div>
    </div>
</div>

<div id="forum-content" class="forum-content" style="margin-top: 1.5rem;">
    <!-- Page 1: Publications -->
    <div class="forum-page-content" data-page="1">
        <div class="glass-table-container">
            <div id="forumPubGlassSwitcher" class="glass-switcher style-slide">
                <div class="glass-switcher-face glass-switcher-face-main">
                    <div class="glass-toolbar">
                        <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff;">Publications</h3>
                        <div style="flex: 1;"></div>
                        <button type="button" class="glass-btn-save" id="forum-btn-add-pub" style="padding: 0.6rem 1.5rem; font-size: 0.9rem;">
                            <i class="bx bx-plus"></i> Add Publication
                        </button>
                    </div>

                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
                            <i class="bx bx-search glass-search-icon"></i>
                            <input type="text" class="glass-search-input forum-pub-search-input" placeholder="Search publications...">
                        </div>
                        
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active forum-pub-sort-option" data-value="date" onclick="selectPubSortPill(this)">Date</div>
                            <div class="glass-pill forum-pub-sort-option" data-value="name" onclick="selectPubSortPill(this)">Topic</div>
                            <div class="glass-pill forum-pub-sort-option" data-value="author" onclick="selectPubSortPill(this)">Author</div>
                            <button class="glass-pagination-btn" id="forum-pub-sort-dir-pill" style="width: 38px; height: 38px;">
                                <span id="forum-pub-sort-dir-icon-svg"></span>
                            </button>
                        </div>
                    </div>

                    <div class="glass-table-scroll">
                        <table class="glass-table" id="forum-pub-table">
                            <thead>
                                <tr>
                                    <th>Topic</th>
                                    <th>Category</th>
                                    <th>Author</th>
                                    <th>Date</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="forum-pub-table-body">
                                <!-- Table rows rendered by JS -->
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="glass-pagination-bar" id="forum-pub-pagination">
                        <button class="glass-pagination-btn" id="forum-pub-table-prev"><i class="bx bx-chevron-left"></i></button>
                        <div id="forum-pub-table-pages" style="display: flex; gap: 0.5rem;"></div>
                        <button class="glass-pagination-btn" id="forum-pub-table-next"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div><!-- End .glass-switcher-face-main -->

                <div class="glass-switcher-face glass-switcher-face-details" id="pub-view-face">
                    <div id="pub-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Publication Details</h3>
                                    <p class="users-edit-modal-subtitle">View complete publication information</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('pub-view-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
                            </div>
                            <div class="users-edit-modal-body">
                                <div class="glass-view-details">
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Topic</div>
                                        <div class="glass-view-value" id="view-pub-topic">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Author</div>
                                        <div class="glass-view-value" id="view-pub-author">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Category</div>
                                        <div class="glass-view-value" id="view-pub-category">-</div>
                                    </div>
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Date</div>
                                        <div class="glass-view-value" id="view-pub-date">-</div>
                                    </div>
                                    <div class="glass-view-row" style="flex-direction: column; align-items: flex-start;">
                                        <div class="glass-view-label" style="width: 100%; margin-bottom: 0.5rem;">Description</div>
                                        <div class="glass-view-value" id="view-pub-description" style="line-height: 1.6; opacity: 0.8;">-</div>
                                    </div>
                                    <div class="glass-view-row" id="view-pub-image-row" style="display: none; flex-direction: column; align-items: center;">
                                        <img id="view-pub-image" src="" alt="Publication Image" style="max-width: 100%; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
                                    </div>
                                </div>
                                <div class="users-view-modal-actions" style="margin-top: 2.5rem;">
                                    <button type="button" class="users-btn-modify" id="view-pub-modify-btn">
                                        <i class="bx bx-edit"></i> Modify Publication
                                    </button>
                                    <form id="view-pub-delete-form" method="post" style="display: inline-block; margin-left: 1rem;" data-ajax="true" data-refresh="softRefresh">
                                        <input type="hidden" name="_token" id="view-pub-delete-token" value="">
                                        <button type="submit" class="users-btn-delete">
                                            <i class="bx bx-trash"></i> Delete Publication
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-edit" id="pub-edit-face">
                    <div id="pub-edit-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Edit Publication</h3>
                                    <p class="users-edit-modal-subtitle">Modify the publication and save changes.</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('pub-edit-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if pubEditForm is defined %}
                                {{ form_start(pubEditForm, { 'attr': { 'id': 'pub-edit-form', 'method': 'post', 'action': '', 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh', 'enctype': 'multipart/form-data' } }) }}
                                
                                {{ form_row(pubEditForm.titre_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'required': 'required', 'minlength': '5' } }) }}
                                <div class="validation-container" data-field="titre_pub"></div>
                                {{ form_row(pubEditForm.description_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'style': 'height: 120px;', 'required': 'required', 'minlength': '20' } }) }}
                                <div class="validation-container" data-field="description_pub"></div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        {{ form_row(pubEditForm.categorie_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                        <div class="validation-container" data-field="categorie_pub"></div>
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_row(pubEditForm.image_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                        <div class="validation-container" data-field="image_pub"></div>
                                    </div>
                                </div>
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('pub-edit-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-check"></i> Update Publication</button>
                                </div>
                                {{ form_end(pubEditForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-extra" id="pub-add-face">
                    <div id="pub-add-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Add Publication</h3>
                                    <p class="users-edit-modal-subtitle">Create a new forum publication.</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('pub-add-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
                            </div>
                            <div class="users-edit-modal-body">
                                {% if pubAddForm is defined %}
                                {{ form_start(pubAddForm, { 'attr': { 'id': 'pub-add-form', 'method': 'post', 'action': path('admin_forum_pub_add'), 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh', 'enctype': 'multipart/form-data' } }) }}
                                
                                {{ form_row(pubAddForm.titre_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'required': 'required', 'minlength': '5' } }) }}
                                <div class="validation-container" data-field="titre_pub"></div>
                                {{ form_row(pubAddForm.description_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input', 'style': 'height: 120px;', 'required': 'required', 'minlength': '20' } }) }}
                                <div class="validation-container" data-field="description_pub"></div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        {{ form_row(pubAddForm.categorie_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                        <div class="validation-container" data-field="categorie_pub"></div>
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_row(pubAddForm.image_pub, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                        <div class="validation-container" data-field="image_pub"></div>
                                    </div>
                                </div>
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('pub-add-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-plus"></i> Post Publication</button>
                                </div>
                                {{ form_end(pubAddForm) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- End #forumPubGlassSwitcher -->
        </div><!-- End .glass-table-container -->
