                    </div>

                    <div class="glass-toolbar" style="margin-bottom: 1.5rem;">
                        <div class="glass-search-container">
                            <i class="bx bx-search glass-search-icon"></i>
                            <input type="text" class="glass-search-input forum-comment-search-input" placeholder="Search comments...">
                        </div>
                        
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active forum-comment-sort-option" data-value="date" onclick="selectCommentSortPill(this)">Date</div>
                            <div class="glass-pill forum-comment-sort-option" data-value="author" onclick="selectCommentSortPill(this)">Author</div>
                            <div class="glass-pill forum-comment-sort-option" data-value="publication" onclick="selectCommentSortPill(this)">Publication</div>
                            <button class="glass-pagination-btn" id="forum-comment-sort-dir-pill" style="width: 38px; height: 38px;">
                                <span id="forum-comment-sort-dir-icon-svg"></span>
                            </button>
                        </div>
                    </div>

                    <div class="glass-table-scroll">
                        <table class="glass-table" id="forum-comment-table">
                            <thead>
                                <tr>
                                    <th>Commentaire</th>
                                    <th>Publication</th>
                                    <th>Author</th>
                                    <th>Date</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="forum-comment-table-body">
                                <!-- Table rows rendered by JS -->
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="glass-pagination-bar" id="forum-comment-pagination">
                        <button class="glass-pagination-btn" id="forum-comment-table-prev"><i class="bx bx-chevron-left"></i></button>
                        <div id="forum-comment-table-pages" style="display: flex; gap: 0.5rem;"></div>
                        <button class="glass-pagination-btn" id="forum-comment-table-next"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div>

                <div class="glass-switcher-face glass-switcher-face-details" id="comment-view-face">
                    <div id="comment-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Comment Details</h3>
                                    <p class="users-edit-modal-subtitle">View comment content and metadata.</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('comment-view-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
                            </div>
                            <div class="users-edit-modal-body">
                                <div class="glass-view-details">
                                    <div class="glass-view-row">
                                        <div class="glass-view-label">Author</div>
                                        <div class="glass-view-value" id="view-comment-author">-</div>
