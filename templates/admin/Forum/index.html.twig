</div>
<style>
	.forum-pagination-pills {
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
		margin: 0 auto;
		padding: 0.25rem 0.5rem;
		background: linear-gradient(135deg, #23272f 80%, #2a2e39 100%);
		border-radius: 999px;
		min-width: 340px;
		box-shadow: 0 2px 12px rgba(0,0,0,0.08);
		width: fit-content;
	}
	.pill-slider-bar {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		border-radius: 999px;
		background: transparent;
		z-index: 0;
		pointer-events: none;
	}
	.pill-slider {
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		height: 40px;
		width: 0;
		background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
		border-radius: 999px;
		z-index: 2;
		transition: left 0.35s cubic-bezier(0.4,0,0.2,1), width 0.35s cubic-bezier(0.4,0,0.2,1);
		box-shadow: 0 4px 16px rgba(0,123,255,0.15);
		pointer-events: none;
		opacity: 1;
	}
	.pill-tab {
		background: transparent;
		color: #bfc9d8;
		border: none;
		border-radius: 999px;
		padding: 0.5rem 1.5rem;
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		transition: color 0.2s, box-shadow 0.2s;
		box-shadow: none;
		outline: none;
		position: relative;
		z-index: 3;
	}
	.pill-tab.active, .pill-tab:focus {
		color: #fff;
		text-shadow: 0 2px 8px rgba(0,123,255,0.10);
		z-index: 3;
	}
</style>
<script>
	// --- Users-style sort direction, dropdown, search, and pill slider logic, namespaced for forum ---
	document.addEventListener('DOMContentLoaded', function() {
	// --- Users-style dropdown and sort pill logic for Forum ---
	const sortPill = document.getElementById('forum-sort-pill-custom');
	const sortDropdown = document.getElementById('forum-sort-dropdown');
	const sortSelected = document.getElementById('forum-sort-selected');
	let sortValue = 'name';
	function closeSortDropdown() {
		if (sortDropdown) {
			sortDropdown.style.display = 'none';
			sortPill && sortPill.classList.remove('open');
		}
	}
	function openSortDropdown() {
		if (sortDropdown) {
			sortDropdown.style.display = 'flex';
			sortPill && sortPill.classList.add('open');
		}
	}
	if (sortPill && sortDropdown) {
		sortPill.addEventListener('click', function(e) {
			e.stopPropagation();
			if (sortDropdown.style.display === 'flex') {
				closeSortDropdown();
			} else {
				openSortDropdown();
			}
		});
		document.querySelectorAll('.forum-sort-option').forEach(opt => {
			opt.addEventListener('click', function(e) {
				sortValue = this.getAttribute('data-value');
				sortSelected.textContent = this.textContent;
				document.querySelectorAll('.forum-sort-option').forEach(o => o.classList.remove('active'));
				this.classList.add('active');
				closeSortDropdown();
				forumSortValue = sortValue;
				forumFilterAndSortRows();
			});
		});
		document.addEventListener('click', function(e) {
			if (!sortPill.contains(e.target)) closeSortDropdown();
		});
		sortPill.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') closeSortDropdown();
			if (e.key === 'ArrowDown') {
				openSortDropdown();
				const first = sortDropdown.querySelector('.forum-sort-option');
				if (first) first.focus();
			}
		});
	}
		// Pills logic
		function showForumPage(page) {
			document.querySelectorAll('.forum-page-content').forEach(div => {
				div.style.display = (div.dataset.page == page) ? '' : 'none';
			});
		}
		function updatePillSlider() {
			const pills = document.querySelectorAll('.pill-tab');
			const slider = document.querySelector('.pill-slider');
			const active = document.querySelector('.pill-tab.active');
			if (!active || !slider) return;
			slider.style.left = (active.offsetLeft) + 'px';
			slider.style.width = active.offsetWidth + 'px';
		}
		document.querySelectorAll('.pill-tab').forEach(btn => {
			btn.addEventListener('click', function() {
				document.querySelectorAll('.pill-tab').forEach(b => b.classList.remove('active'));
				this.classList.add('active');
				updatePillSlider();
				showForumPage(this.dataset.page);
			});
		});
		showForumPage(1);
		setTimeout(updatePillSlider, 100);
		window.addEventListener('resize', updatePillSlider);

		// Sort direction toggle logic
		let forumSortDirection = 'asc';
		const forumSortDirBtn = document.getElementById('forum-sort-dir-pill');
		const forumSortDirIconSvg = document.getElementById('forum-sort-dir-icon-svg');
		function updateForumSortDirIcon() {
			forumSortDirIconSvg.innerHTML = forumSortDirection === 'asc'
				? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 15 12 9 18 15" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`
				: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 9 12 15 18 9" stroke="#00c6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
		}
		updateForumSortDirIcon();
		forumSortDirBtn.addEventListener('click', function() {
			forumSortDirection = (forumSortDirection === 'asc') ? 'desc' : 'asc';
			updateForumSortDirIcon();
			forumFilterAndSortRows();
		});

		// Custom dropdown logic for sorting pill
		const forumSortPill = document.getElementById('forum-sort-pill-custom');
		const forumSortDropdown = document.getElementById('forum-sort-dropdown');
		const forumSortSelected = document.getElementById('forum-sort-selected');
		let forumSortValue = 'name';
		function closeForumSortDropdown() {
			forumSortDropdown.style.display = 'none';
			forumSortPill.classList.remove('open');
		}
		function openForumSortDropdown() {
			forumSortDropdown.style.display = 'flex';
			forumSortPill.classList.add('open');
		}
		forumSortPill.addEventListener('click', function(e) {
			e.stopPropagation();
			if (forumSortDropdown.style.display === 'flex') {
				closeForumSortDropdown();
			} else {
				openForumSortDropdown();
			}
		});
		document.querySelectorAll('.forum-sort-option').forEach(opt => {
			opt.addEventListener('click', function(e) {
				forumSortValue = this.getAttribute('data-value');
				forumSortSelected.textContent = this.textContent;
				document.querySelectorAll('.forum-sort-option').forEach(o => o.classList.remove('active'));
				this.classList.add('active');
				closeForumSortDropdown();
				forumFilterAndSortRows();
			});
		});
		document.addEventListener('click', function(e) {
			if (!forumSortPill.contains(e.target)) closeForumSortDropdown();
		});
		forumSortPill.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') closeForumSortDropdown();
			if (e.key === 'ArrowDown') {
				openForumSortDropdown();
				const first = forumSortDropdown.querySelector('.forum-sort-option');
				if (first) first.focus();
			}
		});

		// Search and sort logic
		const forumSearchInput = document.querySelector('.forum-search-input');
		let forumFilteredRows = [...forumDemoTableRows];
		function forumFilterAndSortRows() {
			let rows = [...forumDemoTableRows];
			const search = forumSearchInput.value.trim().toLowerCase();
			if (search) {
				rows = rows.filter(row => row.some(cell => cell.toLowerCase().includes(search)));
			}
			if (forumSortValue === 'name') {
				rows.sort((a, b) => forumSortDirection === 'asc' ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]));
			} else if (forumSortValue === 'email') {
				rows.sort((a, b) => forumSortDirection === 'asc' ? a[1].localeCompare(b[1]) : b[1].localeCompare(a[1]));
			} else if (forumSortValue === 'date') {
				rows.sort((a, b) => forumSortDirection === 'asc' ? a[2].localeCompare(b[2]) : b[2].localeCompare(a[2]));
			} else if (forumSortValue === 'status') {
				rows.sort((a, b) => forumSortDirection === 'asc' ? a[3].localeCompare(b[3]) : b[3].localeCompare(a[3]));
			}
			forumFilteredRows = rows;
			forumCurrentPage = 1;
			updateForumTablePagination();
		}
		forumSearchInput.addEventListener('input', forumFilterAndSortRows);
		// Patch renderForumTablePage to use forumFilteredRows
		const origRenderForumTablePage = renderForumTablePage;
		renderForumTablePage = function(page) {
			const tbody = document.getElementById('forum-table-body');
			tbody.innerHTML = '';
			const start = (page-1)*forumRowsPerPage;
			const end = Math.min(start+forumRowsPerPage, forumFilteredRows.length);
			for (let r = start; r < end; r++) {
				const row = document.createElement('tr');
				for (let c = 0; c < 8; c++) {
					const td = document.createElement('td');
					td.textContent = forumFilteredRows[r][c];
					row.appendChild(td);
				}
				// Modify button
				const tdModify = document.createElement('td');
				tdModify.innerHTML = '<button class="forum-btn-modify" title="Modify"><i class="bx bx-edit"></i> Modify</button>';
				row.appendChild(tdModify);
				// Delete button
				const tdDelete = document.createElement('td');
				tdDelete.innerHTML = '<button class="forum-btn-delete" title="Delete"><i class="bx bx-trash"></i> Delete</button>';
				row.appendChild(tdDelete);
				tbody.appendChild(row);
			}
		};
		// Patch renderForumTablePagination to use forumFilteredRows
		const origRenderForumTablePagination = renderForumTablePagination;
		renderForumTablePagination = function() {
			const totalPages = Math.ceil(forumFilteredRows.length / forumRowsPerPage);
			const pagesDiv = document.getElementById('forum-table-pages');
			pagesDiv.innerHTML = '';
			for (let i = 1; i <= totalPages; i++) {
				const btn = document.createElement('button');
				btn.className = 'forum-table-page-btn' + (i === forumCurrentPage ? ' active' : '');
				btn.textContent = i;
				btn.onclick = () => { forumCurrentPage = i; updateForumTablePagination(); };
				pagesDiv.appendChild(btn);
			}
			document.getElementById('forum-table-prev').disabled = forumCurrentPage === 1;
			document.getElementById('forum-table-next').disabled = forumCurrentPage === totalPages;
		};
		// Initial filter and sort
		forumFilterAndSortRows();
	});
</script>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
{% endblock %}
