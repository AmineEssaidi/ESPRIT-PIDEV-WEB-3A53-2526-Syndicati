                            </div>
                            <div class="users-edit-modal-body">
                                {% if reactionEditForm is defined %}
                                {{ form_start(reactionEditForm, { 'attr': { 'id': 'reaction-edit-form', 'method': 'post', 'action': '', 'class': 'users-edit-form', 'data-ajax': 'true', 'data-refresh': 'softRefresh' } }) }}
                                
                                {{ form_row(reactionEditForm.kind, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                <div class="validation-container" data-field="kind"></div>
                                {{ form_row(reactionEditForm.emoji, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                <div class="validation-container" data-field="emoji"></div>
                                {{ form_row(reactionEditForm.report_reason, { 'row_attr': { 'class': 'glass-form-group' }, 'label_attr': { 'class': 'glass-label' }, 'attr': { 'class': 'glass-input' } }) }}
                                <div class="validation-container" data-field="report_reason"></div>
                                
                                <div class="users-edit-modal-actions" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem;">
                                    <button type="button" class="users-btn-cancel" onclick="closeModal('reaction-edit-modal')"><i class="bx bx-x"></i> Discard</button>
                                    <span class="users-edit-modal-actions-spacer"></span>
                                    <button type="submit" class="users-btn-modify"><i class="bx bx-check"></i> Update Reaction</button>
