                    const pubEditForm = document.getElementById('pub-edit-form');

                    function openPubEditModal(id) {
                        const data = publicationsData.find(p => p[4] == id);
                        if (!data) return;

                        // Prefill data
                        const titleField = document.getElementById('publication_edit_titre_pub');
                        const descField = document.getElementById('publication_edit_description_pub');
                        const catField = document.getElementById('publication_edit_categorie_pub');

                        if (titleField) titleField.value = data[0];
                        if (catField) {
                            catField.value = data[1];
                            catField.dispatchEvent(new Event('sync-custom-select'));
                        }
                        if (descField) descField.value = data[6];

                        // Image preview in edit modal
                        const imagePreviewRow = document.getElementById('edit-pub-image-preview-row');
                        const imgTag = document.getElementById('edit-pub-image-preview');
                        const imageName = data[8];
                        if (imageName && imageName !== '') {
                            imgTag.src = '/forum_images/' + imageName;
                            imagePreviewRow.style.display = 'flex';
                        } else {
                            imagePreviewRow.style.display = 'none';
                        }

                        // Set action URL
                        if (pubEditForm) {
                            pubEditForm.action = editPubUrlTemplate.replace('ID_PLACEHOLDER', id);
                        }

                        if (pubEditModal) pubEditModal.style.display = 'flex';
                    }

                    function closePubEditModal() {
                        if (pubEditModal) pubEditModal.style.display = 'none';
                    }

                    if (pubEditCloseBtn) pubEditCloseBtn.addEventListener('click', closePubEditModal);
                    if (pubEditCancelBtn) pubEditCancelBtn.addEventListener('click', closePubEditModal);
                    if (pubEditModal) {
                        const backdrop = pubEditModal.querySelector('.users-edit-modal-backdrop');
                        if (backdrop) backdrop.addEventListener('click', closePubEditModal);
                    }

                    // Publication Add Modal
                    const pubAddModal = document.getElementById('pub-add-modal');
                    const pubAddBtn = document.getElementById('forum-add-pub-btn');
                    const pubAddCloseBtn = document.getElementById('pub-add-modal-close');
                    const pubAddCancelBtn = document.getElementById('pub-add-modal-cancel');

                    function openPubAddModal() {
                        if (pubAddModal) pubAddModal.style.display = 'flex';
                    }

                    function closePubAddModal() {
                        if (pubAddModal) pubAddModal.style.display = 'none';
                    }

                    if (pubAddBtn) pubAddBtn.addEventListener('click', openPubAddModal);
                    if (pubAddCloseBtn) pubAddCloseBtn.addEventListener('click', closePubAddModal);
                    if (pubAddCancelBtn) pubAddCancelBtn.addEventListener('click', closePubAddModal);
                    if (pubAddModal) {
                        const backdrop = pubAddModal.querySelector('.users-edit-modal-backdrop');
                        if (backdrop) backdrop.addEventListener('click', closePubAddModal);
                    }

                    // Wire up Modify buttons using delegation for better reliability
                    document.addEventListener('click', function(e) {
                        // Publication Modify
                        const pubModBtn = e.target.closest('#view-pub-modify-btn');
                        if (pubModBtn) {
                            e.preventDefault();
                            e.stopPropagation();
                            const id = pubModBtn.getAttribute('data-id');
                            if (id) {
                                closePubViewModal();
                                openPubEditModal(id);
                            }
                            return false;
                        }

                        // Commentaire Modify
                        const commModBtn = e.target.closest('#view-comment-modify-btn');
                        if (commModBtn) {
                            e.preventDefault();
                            e.stopPropagation();
                            const id = commModBtn.getAttribute('data-id');
                            if (id) {
                                closeCommentViewModal();
                                openCommentEditModal(id);
                            }
                            return false;
                        }
                    });

                    // Comments View Modal
                    const commentViewModal = document.getElementById('comment-view-modal');
                    const commentViewCloseBtn = document.getElementById('comment-view-modal-close');
                    const commentViewModifyBtn = document.getElementById('view-comment-modify-btn');
                    const commentViewDeleteForm = document.getElementById('view-comment-delete-form');

                    function openCommentViewModal(id) {
                        const data = commentsData.find(c => c[4] == id);
                        if (!data) return;

                        document.getElementById('view-comment-text').textContent = data[5]; // Full description
                        document.getElementById('view-comment-pub').textContent = data[1];
                        document.getElementById('view-comment-author').textContent = data[2] + ' (' + data[6] + ')';
                        document.getElementById('view-comment-date').textContent = data[3];

                        // Image handling
                        const imageRow = document.getElementById('view-comment-image-row');
                        const imgTag = document.getElementById('view-comment-image');
                        const imageName = data[7];
                        if (imageName && imageName !== '') {
                            imgTag.src = '/commentaire_images/' + imageName;
                            imageRow.style.display = 'flex';
                        } else {
                            imageRow.style.display = 'none';
                        }

                        // Set ID for modify button
                        commentViewModifyBtn.setAttribute('data-id', id);
                        
                        // Delete form
                        commentViewDeleteForm.action = deleteCommentUrlTemplate.replace('ID_PLACEHOLDER', id);
                        commentViewDeleteForm.onsubmit = function(e) { 
                            e.preventDefault();
                            showCustomConfirm(
                                'Delete Comment?',
                                'Are you sure you want to delete this comment? This action cannot be undone.',
                                function() {
                                    if (typeof showLoader === 'function') showLoader();
                                    commentViewDeleteForm.submit();
                                }
                            );
                            return false;
                        };
                    }

                    function closeCommentViewModal() {
                        if (commentViewModal) commentViewModal.style.display = 'none';
                    }

                    if (commentViewCloseBtn) commentViewCloseBtn.addEventListener('click', closeCommentViewModal);
                    if (commentViewModal) {
                        commentViewModal.querySelector('.users-edit-modal-backdrop').addEventListener('click', closeCommentViewModal);
                    }

                    // Commentaire Edit Modal
                    const commentEditModal = document.getElementById('comment-edit-modal');
                    const commentEditCloseBtn = document.getElementById('comment-edit-modal-close');
                    const commentEditCancelBtn = document.getElementById('comment-edit-modal-cancel');
                    const commentEditForm = document.getElementById('comment-edit-form');

                    function openCommentEditModal(id) {
                        const data = commentsData.find(c => c[4] == id);
                        if (!data) return;

                        // Prefill data
                        const descField = document.getElementById('comment_edit_description_commentaire');
                        const visField = document.getElementById('comment_edit_visibility');

                        if (descField) descField.value = data[5];
                        if (visField) {
                            visField.checked = data[8];
                        }

                        // Image preview in edit modal
                        const imagePreviewRow = document.getElementById('edit-comment-image-preview-row');
                        const imgTag = document.getElementById('edit-comment-image-preview');
                        const imageName = data[7];
                        if (imageName && imageName !== '') {
                            imgTag.src = '/commentaire_images/' + imageName;
                            imagePreviewRow.style.display = 'flex';
                        } else {
                            imagePreviewRow.style.display = 'none';
                        }

                        // Set action URL
                        if (commentEditForm) {
                            commentEditForm.action = editCommentUrlTemplate.replace('ID_PLACEHOLDER', id);
                        }


                        if (commentEditModal) commentEditModal.style.display = 'flex';
                    }

                    function closeCommentEditModal() {
                        if (commentEditModal) commentEditModal.style.display = 'none';
                    }

                    if (commentEditCloseBtn) commentEditCloseBtn.addEventListener('click', closeCommentEditModal);
                    if (commentEditCancelBtn) commentEditCancelBtn.addEventListener('click', closeCommentEditModal);
                    if (commentEditModal) {
                        const backdrop = commentEditModal.querySelector('.users-edit-modal-backdrop');
                        if (backdrop) backdrop.addEventListener('click', closeCommentEditModal);
                    }

                    // Delegation for "View Details" buttons
                    document.getElementById('forum-table-body').addEventListener('click', function(e) {
                        const btn = e.target.closest('.forum-btn-add-db');
                        if (btn && btn.title === 'View Details') {
                            const id = btn.getAttribute('data-id');
                            if (id) {
                                openPubViewModal(id);
                                if (pubViewModal) pubViewModal.style.display = 'flex';
                            }
                        }
                    });

                    document.getElementById('comments-table-body').addEventListener('click', function(e) {
                        const btn = e.target.closest('.forum-btn-add-db');
                        if (btn && btn.title === 'View Details') {
                            const id = btn.getAttribute('data-id');
                            if (id) {
