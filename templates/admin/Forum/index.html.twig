                <div class="glass-switcher-face glass-switcher-face-details" id="reaction-view-face">
                    <div id="reaction-view-modal" class="users-edit-modal">
                        <div class="users-edit-modal-card">
                            <div class="users-edit-modal-header">
                                <div>
                                    <h3>Reaction Details</h3>
                                    <p class="users-edit-modal-subtitle">View reaction content and metadata.</p>
                                </div>
                                <button type="button" class="users-edit-modal-close" onclick="closeModal('reaction-view-modal')" aria-label="Close"><i class="bx bx-x"></i></button>
