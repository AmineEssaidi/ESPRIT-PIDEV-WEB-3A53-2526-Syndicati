			</style>
			</style>
		</div>
		<div class="forum-page-content" data-page="2" style="display:none;">
			<div class="forum-list-demo">
				<h3 style="margin-bottom:1rem;">Demo Forums (Page 2)</h3>
				<ul style="list-style:none;padding:0;">
					<li style="padding:0.5rem 0;border-bottom:1px solid #eee;">Forum Topic 1</li>
					<li style="padding:0.5rem 0;border-bottom:1px solid #eee;">Forum Topic 2</li>
					<li style="padding:0.5rem 0;">Forum Topic 3</li>
