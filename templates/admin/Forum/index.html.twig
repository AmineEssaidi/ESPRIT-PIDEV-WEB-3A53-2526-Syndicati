{% extends 'base.html.twig' %}

{% block stylesheets %}
	<style>
		/* === RESIDENCE-STYLE MODAL & UI COMPONENTS === */
		.users-edit-modal *, .users-edit-modal *::before, .users-edit-modal *::after { box-sizing: border-box !important; }
		.users-edit-modal { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 2rem; }
		.users-edit-modal-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(8px); cursor: pointer; }
		.users-edit-modal-card { position: relative; background: linear-gradient(165deg, rgba(32, 38, 52, 0.98) 0%, rgba(20, 24, 32, 0.98) 100%); border-radius: 24px; box-shadow: 0 25px 80px rgba(0,0,0,0.7); max-width: 800px; width: 100%; border: 1px solid rgba(255,255,255,0.12); overflow: visible; max-height: 90vh; display: flex; flex-direction: column; }
		.users-edit-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.75rem 2.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
		.users-edit-modal-header h3 { margin: 0; font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: -0.01em; }
		.users-edit-modal-subtitle { margin: 0.5rem 0 0 0; font-size: 0.9rem; color: rgba(191,201,216,0.8); font-weight: 400; }
		.users-edit-modal-close { background: rgba(255,255,255,0.08); border: none; color: #bfc9d8; width: 2.4rem; height: 2.4rem; border-radius: 50%; font-size: 1.6rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.25s ease; }
		.users-edit-modal-close:hover { background: rgba(255,255,255,0.15); color: #fff; transform: rotate(90deg); }
		.users-edit-modal-body { padding: 2.25rem 2.5rem; display: flex; flex-direction: column; align-items: stretch; overflow-y: auto; scrollbar-width: none; overflow-x: visible; }
		.users-edit-modal-body::-webkit-scrollbar { display: none; }
		.users-edit-modal-actions { display: flex; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 1rem; align-items: center; }
		.users-edit-modal-actions-spacer { flex: 1; }
		.residence-form-group { margin-bottom: 1.75rem; width: 100%; display: flex; flex-direction: column; }
		.residence-edit-label { display: block; margin-bottom: 0.75rem; color: #bfc9d8; font-weight: 600; font-size: 0.95rem; letter-spacing: 0.02em; }
		.residence-edit-input { width: 100%; border: 1px solid rgba(255, 255, 255, 0.12); padding: 0.95rem 1.25rem; border-radius: 16px; background: rgba(0, 0, 0, 0.3); color: #fff; font-size: 1rem; outline: none; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); border-left: 4px solid transparent; }
		.residence-edit-input:focus { border-color: rgba(0, 198, 255, 0.5); border-left-color: #00c6ff; background: rgba(0, 0, 0, 0.45); box-shadow: 0 8px 25px rgba(0,0,0,0.2); }
		.users-edit-modal-body input[type="text"], .users-edit-modal-body input[type="email"], .users-edit-modal-body input[type="password"], .users-edit-modal-body input[type="number"], .users-edit-modal-body textarea, .users-edit-modal-body select { width: 100%; border: 1px solid rgba(255, 255, 255, 0.12); padding: 0.95rem 1.25rem; border-radius: 16px; background: rgba(0, 0, 0, 0.3); color: #fff; font-size: 1rem; outline: none; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); border-left: 4px solid transparent; }
		.users-edit-modal-body input:focus, .users-edit-modal-body textarea:focus, .users-edit-modal-body select:focus { border-color: rgba(0, 198, 255, 0.5); border-left-color: #00c6ff; background: rgba(0, 0, 0, 0.45); box-shadow: 0 8px 25px rgba(0,0,0,0.2); }
		.users-edit-modal-body label { display: block; margin-bottom: 0.75rem; color: #bfc9d8; font-weight: 600; font-size: 0.95rem; letter-spacing: 0.02em; }
		.custom-glass-dropdown { position: relative; width: 100%; user-select: none; }
		.custom-glass-dropdown-trigger { width: 100%; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; padding: 0 1.25rem; color: #fff; display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: all 0.25s ease; font-size: 1rem; height: 56px; border-left: 4px solid transparent; }
		.custom-glass-dropdown-trigger:hover { border-color: rgba(0, 198, 255, 0.45); background: rgba(0, 0, 0, 0.4); }
		.custom-glass-dropdown.open .custom-glass-dropdown-trigger { border-color: #0072ff; border-left-color: #00c6ff; box-shadow: 0 10px 30px rgba(0, 114, 255, 0.15); }
		.custom-glass-dropdown-arrow { font-size: 1.4rem; transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); color: #00c6ff; }
		.custom-glass-dropdown.open .custom-glass-dropdown-arrow { transform: rotate(180deg); }
		.custom-glass-dropdown-menu { position: absolute; top: 115%; left: 0; width: 100%; background: rgba(26, 30, 40, 0.98); backdrop-filter: blur(35px) saturate(210%); border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 16px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7); z-index: 1000; display: none; flex-direction: column; padding: 0.75rem; max-height: 250px; overflow-y: auto; scrollbar-width: thin; animation: dropdown-pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.1) forwards; }
		@keyframes dropdown-pop { 0% { opacity: 0; transform: translateY(-10px) scale(0.95); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
		.custom-glass-dropdown-menu::-webkit-scrollbar { width: 5px; }
		.custom-glass-dropdown-menu::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
		.custom-glass-dropdown-option { padding: 0.9rem 1.25rem; border-radius: 12px; color: rgba(191, 201, 216, 0.9); cursor: pointer; transition: all 0.2s ease; font-size: 1rem; margin-bottom: 4px; }
		.custom-glass-dropdown-option:hover { background: rgba(255, 255, 255, 0.12); color: #fff; transform: scale(1.02); padding-left: 1.5rem; }
		.custom-glass-dropdown-option.selected { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); color: #fff; font-weight: 700; box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3); }
		.hidden-select { display: none !important; visibility: hidden !important; height: 0 !important; width: 0 !important; position: absolute !important; opacity: 0 !important; overflow: hidden !important; }
		.modal-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; width: 100%; margin-bottom: 1.75rem; }
		.custom-file-wrapper { position: relative; width: 100%; }
		.custom-file-trigger { width: 100%; background: rgba(0, 0, 0, 0.3); border: 1px dashed rgba(255, 255, 255, 0.2); border-radius: 16px; padding: 1rem 1.5rem; display: flex; align-items: center; gap: 1rem; cursor: pointer; transition: all 0.3s ease; }
		.custom-file-trigger:hover { background: rgba(0, 198, 255, 0.05); border-color: #00c6ff; }
		.custom-file-icon { font-size: 1.8rem; color: #00c6ff; }
		.custom-file-text { flex: 1; color: rgba(191, 216, 0.8); font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
		.custom-file-btn { background: rgba(255, 255, 255, 0.1); color: #fff; padding: 0.5rem 1rem; border-radius: 10px; font-weight: 600; font-size: 0.85rem; }
		.forum-view-row { display: flex; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
		.forum-view-label { min-width: 120px; font-size: 0.9rem; font-weight: 700; color: rgba(191,201,216,0.7); text-transform: uppercase; letter-spacing: 0.08em; }
		.forum-view-value { flex: 1; font-size: 1.05rem; color: #e3e8f7; line-height: 1.6; }
		.users-btn-cancel, .users-btn-modify, .users-btn-delete { border: none; border-radius: 14px; padding: 0.9rem 1.75rem; font-size: 1.05rem; font-weight: 700; cursor: pointer; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); display: inline-flex; align-items: center; gap: 0.75rem; }
		.users-btn-cancel { background: rgba(255, 255, 255, 0.08); color: #bfc9d8; }
		.users-btn-cancel:hover { background: rgba(255, 255, 255, 0.15); color: #fff; transform: translateY(-2px); }
		.users-btn-modify { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); color: #fff; box-shadow: 0 10px 25px rgba(0, 114, 255, 0.3); }
		.users-btn-modify:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0, 114, 255, 0.45); }
		.users-btn-delete { background: linear-gradient(135deg, #ff3b30 0%, #ff2d92 100%); color: #fff; box-shadow: 0 10px 25px rgba(255, 45, 146, 0.25); }
		.users-btn-delete:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(255, 45, 146, 0.4); }
		[data-theme="light"] .custom-glass-dropdown-trigger { background: #f0f4f8; border-color: #dce2e8; color: #1c202a; }
		[data-theme="light"] .custom-glass-dropdown-menu { background: #fff; border-color: #dce2e8; }
		[data-theme="light"] .custom-file-trigger { background: #f0f4f8; border-color: #dce2e8; }
		[data-theme="light"] .residence-edit-input { background: #f0f4f8; border-color: #dce2e8; color: #1c202a; }
		[data-theme="light"] .residence-edit-input:focus { background: #fff; border-color: #0072ff; border-left-color: #00c6ff; }
		[data-theme="light"] .residence-edit-label { color: #4a5568; }
		[data-theme="light"] .users-edit-modal-body input, [data-theme="light"] .users-edit-modal-body textarea, [data-theme="light"] .users-edit-modal-body select { background: #f0f4f8; border-color: #dce2e8; color: #1c202a; }
		[data-theme="light"] .users-edit-modal-body input:focus, [data-theme="light"] .users-edit-modal-body textarea:focus, [data-theme="light"] .users-edit-modal-body select:focus { background: #fff; border-color: #0072ff; border-left-color: #00c6ff; }
		[data-theme="light"] .users-edit-modal-body label { color: #4a5568; }
		/* === END RESIDENCE-STYLE COMPONENTS === */

	/* Light theme improvements (copied from Users) */
		[data-theme="light"] .liquid-glass-table-container {
			background: rgba(255,255,255,0.85);
			border: 1.5px solid #e3e8f7;
			box-shadow: 0 8px 32px rgba(0,0,0,0.08);
		}
		[data-theme="light"] .liquid-glass-table {
			background: rgba(255,255,255,0.98);
			color: #23272f;
			box-shadow: 0 2px 12px rgba(0,0,0,0.04);
		}
		[data-theme="light"] .liquid-glass-table th {
			background: #f5f7fa;
			color: #23272f;
		}
		[data-theme="light"] .liquid-glass-table td {
			background: transparent;
			color: #23272f;
		}
		[data-theme="light"] .forum-btn-add-db {
			background: linear-gradient(90deg, #00bfae 0%, #00e676 100%);
			color: #fff;
			box-shadow: 0 2px 8px rgba(0,230,118,0.08);
		}
		[data-theme="light"] .forum-btn-add-db:hover {
			background: linear-gradient(90deg, #00e676 0%, #00bfae 100%);
		}
		[data-theme="light"] .forum-btn-modify {
			background: linear-gradient(90deg, #0072ff 0%, #00c6ff 100%);
			color: #fff;
		}
		[data-theme="light"] .forum-btn-delete {
			background: linear-gradient(90deg, #ff2d92 0%, #ff3b30 100%);
			color: #fff;
		}
		[data-theme="light"] .forum-pagination-pills {
			background: linear-gradient(135deg, #f5f7fa 80%, #e3e8f7 100%);
			box-shadow: 0 2px 12px rgba(0,0,0,0.04);
		}
		[data-theme="light"] .pill-tab {
			color: #5c6370;
		}
		[data-theme="light"] .pill-tab:hover {
			color: #23272f;
			background: rgba(0,0,0,0.02);
		}
		[data-theme="light"] .pill-tab.active, [data-theme="light"] .pill-tab:focus {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			color: #fff;
			text-shadow: none;
			box-shadow: 0 4px 16px rgba(0,123,255,0.15);
		}
		[data-theme="light"] .forum-sort-dir-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
			color: #23272f;
		}
		[data-theme="light"] .forum-sort-dir-icon svg polyline {
			stroke: #0072ff;
		}
		[data-theme="light"] .forum-sort-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
		}
		[data-theme="light"] .forum-search-pill {
			background: linear-gradient(90deg, #e3e8f7 0%, #f5f7fa 100%);
		}
		[data-theme="light"] .forum-search-input {
			color: #23272f;
		}
		[data-theme="light"] .forum-search-icon {
			color: #0072ff;
		}
		[data-theme="light"] .table-pagination-bar {
			background: transparent;
		}
		[data-theme="light"] .forum-table-arrow {
			background: #fff;
			color: #0072ff;
			border: 1px solid #e3e8f7;
		}
		[data-theme="light"] .forum-table-arrow svg polyline {
			stroke: #0072ff;
		}
		[data-theme="light"] .forum-table-page-btn {
			background: #fff;
			color: #23272f;
			border: 1px solid #e3e8f7;
		}
		[data-theme="light"] .forum-table-page-btn.active, [data-theme="light"] .forum-table-page-btn:hover {
			background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
			color: #fff;
			border: none;
		}

		/* === Pill Navigation Container (Page Tabs) ===  */
		.forum-pagination-wrapper, .users-pagination-wrapper {
			margin-top: 2rem;
			display: flex;
			justify-content: center;
		}
		.forum-pagination-pills, .users-pagination-pills, .pills-animated {
			background: rgba(30, 34, 44, 0.65);
			border-radius: 50px;
			padding: 0.5rem;
			display: inline-flex;
			gap: 0.5rem;
			box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
			backdrop-filter: blur(20px) saturate(120%);
			-webkit-backdrop-filter: blur(20px) saturate(120%);
			border: 1.5px solid rgba(255, 255, 255, 0.06);
		}
		.pill-tab {
			background: transparent;
			border: none;
			border-radius: 50px;
			padding: 0.75rem 2rem;
			font-weight: 700;
			font-size: 1rem;
			cursor: pointer;
			transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			color: rgba(255, 255, 255, 0.7);
			position: relative;
		}
		.pill-tab.active {
			background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
			color: #fff;
			box-shadow: 0 8px 20px rgba(0, 114, 255, 0.35);
		}
		.pill-tab:not(.active):hover {
			background: rgba(255, 255, 255, 0.08);
			color: #fff;
		}
		[data-theme="light"] .forum-pagination-pills,
		[data-theme="light"] .users-pagination-pills,
		[data-theme="light"] .pills-animated {
			background: rgba(255, 255, 255, 0.9);
			border-color: rgba(0, 198, 255, 0.25);
			box-shadow: 0 8px 32px rgba(0, 114, 255, 0.12);
		}
		[data-theme="light"] .pill-tab {
			color: #5c6370;
		}
		[data-theme="light"] .pill-tab.active {
			color: #fff;
		}
		[data-theme="light"] .pill-tab:not(.active):hover {
			background: rgba(0, 114, 255, 0.08);
			color: #0072ff;
		}

	</style>
{% endblock %}

{% block title %}Forum - Liquid Glass Admin{% endblock %}

{% block content %}
{% include 'admin/_dashboard_header.html.twig' with { 'title': 'Forum' } %}
<div class="forum-pagination-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
	<div class="forum-pagination-pills pills-animated">
		<button class="pill-tab active" data-page="1">Publication</button>
		<button class="pill-tab" data-page="2">Commentaire</button>
		<button class="pill-tab" data-page="3">Page 3</button>
		<button class="pill-tab" data-page="4">Page 4</button>
	</div>
</div>
<div id="forum-content" class="forum-content" style="margin-top: 1.5rem;">
		<div class="forum-page-content" data-page="1">
			<div class="liquid-glass-table-container">
				<h3 style="margin-bottom:1.5rem;">Publications</h3>
				<div class="forum-table-toolbar" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
					<div style="display: flex; align-items: center;">
						<button type="button" class="forum-btn-add-db" id="forum-add-pub-btn" title="Add Publication"><i class="bx bx-plus"></i> Add Publication</button>
					</div>
					<div style="display: flex; gap: 0.7rem; align-items: center;">
						<button class="forum-sort-dir-pill" id="forum-sort-dir-pill" title="Toggle Sort Direction" aria-label="Toggle Sort Direction">
							<span id="forum-sort-dir-icon-svg"></span>
						</button>
						<div class="forum-sort-pill" id="forum-sort-pill-custom" tabindex="0">
							<span class="forum-sort-selected" id="forum-sort-selected">Sort by Name</span>
							<span class="forum-sort-arrow"></span>
							<div class="forum-sort-dropdown" id="forum-sort-dropdown" style="display:none;">
								<div class="forum-sort-option" data-value="name">Sort by Topic</div>
								<div class="forum-sort-option" data-value="category">Sort by Category</div>
								<div class="forum-sort-option" data-value="author">Sort by Author</div>
								<div class="forum-sort-option" data-value="date">Sort by Date</div>
							</div>
						</div>
						<div class="forum-search-pill">
							<input type="text" class="forum-search-input" placeholder="Search forum..." title="Search forum..." />
							<i class="bx bx-search forum-search-icon"></i>
						</div>
					</div>
				</div>
				<div class="liquid-glass-table-scroll">
					<table class="liquid-glass-table" id="forum-table">
						<thead>
                                <th>Topic</th>
                                <th>Category</th>
                                <th>Author</th>
                                <th>Date</th>
								<th>Actions</th>
						</thead>
						<tbody id="forum-table-body">
							<!-- Table rows will be rendered by JS -->
						</tbody>
					</table>
				</div>
				<div class="table-pagination-bar">
					<button class="forum-table-arrow" id="forum-table-prev" title="Previous Page"><i class="bx bx-chevron-left"></i></button>
					<div class="forum-table-pages" id="forum-table-pages"></div>
					<button class="forum-table-arrow" id="forum-table-next" title="Next Page"><i class="bx bx-chevron-right"></i></button>
				</div>
			</div>
		</div>

		<!-- Page 2 Content: Commentaires -->
		<div class="forum-page-content" data-page="2" style="display:none;">
			<div class="liquid-glass-table-container">
				<h3 style="margin-bottom:1.5rem;">Commentaires</h3>
				<div class="forum-table-toolbar" style="display: flex; align-items: center; margin-bottom: 1.2rem; gap: 1.2rem; flex-wrap: wrap; width: 100%; justify-content: space-between;">
					<div style="display: flex; align-items: center;">
						<!-- Optional Add Comment button -->
					</div>
					<div style="display: flex; gap: 0.7rem; align-items: center;">
						<button class="forum-sort-dir-pill" id="comments-sort-dir-pill" title="Toggle Sort Direction" aria-label="Toggle Sort Direction">
							<span class="forum-sort-dir-icon" id="comments-sort-dir-icon-svg">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="6 15 12 9 18 15" stroke="var(--accent-color, #00c6ff)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</span>
						</button>
						<div class="forum-sort-pill" id="comments-sort-pill-custom">
							<span class="forum-sort-selected" id="comments-sort-selected">Sort by Date</span>
							<span class="forum-sort-arrow"></span>
							<div class="forum-sort-dropdown" id="comments-sort-dropdown" style="display:none;">
								<div class="forum-sort-option comment-sort-option" data-value="date">Sort by Date</div>
								<div class="forum-sort-option comment-sort-option" data-value="author">Sort by Author</div>
								<div class="forum-sort-option comment-sort-option" data-value="publication">Sort by Publication</div>
							</div>
						</div>
						<div class="forum-search-pill">
							<i class="bx bx-search users-search-icon" style="font-size: 1.2rem; color: var(--accent-color, #00c6ff);"></i>
							<input type="text" class="forum-search-input" id="comments-search-input" placeholder="Search comments...">
						</div>
					</div>
				</div>
				<div class="liquid-glass-table-scroll">
					<table class="liquid-glass-table" id="comments-table">
						<thead>
                                <th>Comment</th>
                                <th>Publication</th>
                                <th>Author</th>
                                <th>Date</th>
								<th>Actions</th>
						</thead>
						<tbody id="comments-table-body">
							<!-- Table rows will be rendered by JS -->
						</tbody>
					</table>
				</div>
				<div class="table-pagination-bar">
                    <button class="forum-table-arrow" id="comments-table-prev" title="Previous Page"><i class="bx bx-chevron-left"></i></button>
                    <div class="forum-table-pages" id="comments-table-pages"></div>
                    <button class="forum-table-arrow" id="comments-table-next" title="Next Page"><i class="bx bx-chevron-right"></i></button>
				</div>
			</div>
		</div>
			<script>
                // --- PUBLICATIONS TABLE LOGIC ---
                // Publications data from controller
                const publicationsData = [
                {% for p in publications|default([]) %}
                [
                    "{{ p.titrePub|e('js') }}", 
                    "{{ p.categoriePub|e('js') }}",
                    "{{ p.user ? (p.user.firstName ~ ' ' ~ p.user.lastName)|e('js') : '—' }}", 
                    "{{ p.dateCreationPub|date('Y-m-d H:i') }}",
                    "{{ p.id }}",
