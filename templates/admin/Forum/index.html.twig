                                    <div class="glass-view-row" style="flex-direction: column; align-items: flex-start;">
                                        <div class="glass-view-label" style="width: 100%; margin-bottom: 0.5rem;">Commentaire</div>
                                        <div class="glass-view-value" id="view-comment-text" style="line-height: 1.6; opacity: 0.8;">-</div>
                                    </div>
                                </div>
                                <div class="users-view-modal-actions" style="margin-top: 2.5rem;">
                                    <button type="button" class="users-btn-modify" id="view-comment-modify-btn">
