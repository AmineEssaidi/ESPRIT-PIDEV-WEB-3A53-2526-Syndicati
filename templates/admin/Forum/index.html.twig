                    // --- CUSTOM SELECT LOGIC ---
                    // --- CUSTOM DROPDOWN LOGIC (Residence Style) ---
                    function initCustomDropdowns() {
                        document.querySelectorAll('.custom-glass-dropdown').forEach(dropdown => {
                            const trigger = dropdown.querySelector('.custom-glass-dropdown-trigger');
                            const menu = dropdown.querySelector('.custom-glass-dropdown-menu');
                            const targetId = dropdown.dataset.target;
                            const hiddenSelect = document.getElementById(targetId);

                            // Lazy load options on click to ensure specific timing doesn't break it
                            trigger.addEventListener('click', (e) => {
                                e.stopPropagation();
                                
                                // Fallback: try previous sibling if ID lookup failed
                                let select = hiddenSelect;
                                if (!select) {
                                    const prev = dropdown.previousElementSibling;
                                    if (prev && prev.tagName === 'SELECT') {
                                        select = prev;
                                    }
                                }

                                // POPULATE OPTIONS IF EMPTY
                                if (select && menu.children.length === 0 && select.options.length > 0) {
                                    Array.from(select.options).forEach(opt => {
                                        // Skip empty placeholders if you want, or include them
                                        // if (opt.value === '') return; 
                                        
                                        const customOpt = document.createElement('div');
                                        customOpt.className = 'custom-glass-dropdown-option';
                                        customOpt.dataset.value = opt.value;
                                        customOpt.textContent = opt.text;
                                        
                                        if(select.value === opt.value) {
                                            customOpt.classList.add('selected');
                                            dropdown.querySelector('.selected-text').textContent = opt.text;
                                        }

                                        customOpt.addEventListener('click', (e) => {
                                            e.stopPropagation();
                                            const val = customOpt.dataset.value;
                                            const text = customOpt.textContent;
                                            
                                            // Update trigger text
                                            dropdown.querySelector('.selected-text').textContent = text;
                                            
                                            // Update hidden select
                                            select.value = val;
                                            select.dispatchEvent(new Event('change'));

                                            // Handle selection UI
                                            menu.querySelectorAll('.custom-glass-dropdown-option').forEach(o => o.classList.remove('selected'));
                                            customOpt.classList.add('selected');

                                            // Close menu
                                            dropdown.classList.remove('open');
                                            menu.style.display = 'none';
                                        });
                                        
                                        menu.appendChild(customOpt);
                                    });
                                }

                                const isOpen = dropdown.classList.contains('open');
                                
                                // Close others
                                document.querySelectorAll('.custom-glass-dropdown.open').forEach(d => {
                                    if(d !== dropdown) {
                                        d.classList.remove('open');
                                        d.querySelector('.custom-glass-dropdown-menu').style.display = 'none';
                                    }
                                });

                                dropdown.classList.toggle('open');
                                menu.style.display = isOpen ? 'none' : 'flex';
                            });
                             // Remove old static option listeners as they are now dynamic
                        });

                        // Global click handler to close dropdowns
                        document.addEventListener('click', () => {
                            document.querySelectorAll('.custom-glass-dropdown.open').forEach(d => {
                                d.classList.remove('open');
                                d.querySelector('.custom-glass-dropdown-menu').style.display = 'none';
                            });
                        });
                    }
                    
