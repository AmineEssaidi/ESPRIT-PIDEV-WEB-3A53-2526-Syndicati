                    </div>
                </div>
            </div><!-- End #forumReactionGlassSwitcher -->
        </div><!-- End .glass-table-container -->
    </div><!-- End Page 2 -->
</div>

<script>
    /**
     * Standardized Glass Switcher Logic
     */


    // --- Data Templates ---
    const publicationsData = [
        {% for p in publications|default([]) %}
            {{ [
                p.titrePub,
                p.categoriePub,
                p.user ? (p.user.firstName ~ ' ' ~ p.user.lastName) : '-',
                p.dateCreationPub ? p.dateCreationPub|date('Y-m-d H:i') : '',
                p.id,
                p.descriptionPub,
                p.imagePub ? media_url(p.imagePub, 'forum_images') : '',
                csrf_token('delete' ~ p.id)
            ]|json_encode|raw }}{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const commentsData = [
        {% for c in commentaires|default([]) %}
            {{ [
                (c.descriptionCommentaire|default(''))|slice(0, 50) ~ '...',
                c.publication ? c.publication.titrePub : 'Deleted',
                c.user ? (c.user.firstName ~ ' ' ~ c.user.lastName) : '-',
                c.createdAt ? c.createdAt|date('Y-m-d H:i') : '',
                c.idCommentaire,
                c.descriptionCommentaire,
                c.visibility ? 'true' : 'false',
                csrf_token('delete' ~ c.idCommentaire)
            ]|json_encode|raw }}{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const reactionsData = [
        {% for r in reactions|default([]) %}
            {{ [
                r.kind,
                r.publication ? 'Pub: ' ~ r.publication.titrePub : (r.commentaire ? 'Comm: ' ~ (r.commentaire.descriptionCommentaire|slice(0, 30)) : 'N/A'),
                r.user ? (r.user.firstName ~ ' ' ~ r.user.lastName) : '-',
                r.createdAt ? r.createdAt|date('Y-m-d H:i') : '',
                r.idReaction,
                r.emoji,
                r.reportReason,
                csrf_token('delete' ~ r.idReaction)
            ]|json_encode|raw }}{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const editPubUrlTemplate = "{{ path('admin_forum_pub_edit', {id: 'ID_PLACEHOLDER'}) }}";
    const deletePubUrlTemplate = "{{ path('app_publication_delete', {id: 'ID_PLACEHOLDER'}) }}";
    const deleteCommentUrlTemplate = "{{ path('forum_comment_delete', {id: 'ID_PLACEHOLDER'}) }}";
    const editCommentUrlTemplate = "{{ path('admin_forum_comment_edit', {id: 'ID_PLACEHOLDER'}) }}";
    const editReactionUrlTemplate = "{{ path('admin_forum_reaction_edit', {id: 'ID_PLACEHOLDER'}) }}";
    const deleteReactionUrlTemplate = "{{ path('admin_forum_reaction_delete', {id: 'ID_PLACEHOLDER'}) }}";

    // --- Table Management ---
    let pubCurrentPage = 1;
    let pubFilteredRows = [...publicationsData];
    let pubSortValue = 'date';
    let pubSortDirection = 'desc';

    let commentCurrentPage = 1;
    let commentFilteredRows = [...commentsData];
    let commentSortValue = 'date';
    let commentSortDirection = 'desc';

    let reactionCurrentPage = 1;
    let reactionFilteredRows = [...reactionsData];
    let reactionSortValue = 'date';
    let reactionSortDirection = 'desc';

    const rowsPerPage = 10;

    function updatePubSortDirIcon() {
        const iconEl = document.getElementById('forum-pub-sort-dir-icon-svg');
        if (!iconEl) return;
        iconEl.innerHTML = pubSortDirection === 'asc'
            ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>`
            : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }

    function updateCommentSortDirIcon() {
        const iconEl = document.getElementById('forum-comment-sort-dir-icon-svg');
        if (!iconEl) return;
        iconEl.innerHTML = commentSortDirection === 'asc'
            ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>`
            : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }

    function updateReactionSortDirIcon() {
        const iconEl = document.getElementById('forum-reaction-sort-dir-icon-svg');
        if (!iconEl) return;
        iconEl.innerHTML = reactionSortDirection === 'asc'
            ? `<i class="bx bx-sort-up" style="color: #00c6ff; font-size: 1.2rem;"></i>`
            : `<i class="bx bx-sort-down" style="color: #00c6ff; font-size: 1.2rem;"></i>`;
    }

    window.selectPubSortPill = function(pill) {
        pubSortValue = pill.dataset.value;
        document.querySelectorAll('.forum-pub-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        forumFilterSortPubs();
    };

    window.selectCommentSortPill = function(pill) {
        commentSortValue = pill.dataset.value;
        document.querySelectorAll('.forum-comment-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        forumFilterSortComments();
    };

    window.selectReactionSortPill = function(pill) {
        reactionSortValue = pill.dataset.value;
        document.querySelectorAll('.forum-reaction-sort-option').forEach(p => p.classList.remove('glass-pill-active'));
        pill.classList.add('glass-pill-active');
        forumFilterSortReactions();
    };

    function forumFilterSortPubs() {
        const val = document.querySelector('.forum-pub-search-input').value.toLowerCase();
        let rows = publicationsData.filter(d => d[0].toLowerCase().includes(val) || d[2].toLowerCase().includes(val) || d[5].toLowerCase().includes(val));
        
        let sortIdx = 3; // Date
        if (pubSortValue === 'name') sortIdx = 0;
        else if (pubSortValue === 'author') sortIdx = 2;

        rows.sort((a,b) => {
            let vA = a[sortIdx].toLowerCase(), vB = b[sortIdx].toLowerCase();
            return pubSortDirection === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });

        pubFilteredRows = rows;
        pubCurrentPage = 1;
        renderPubTable();
    }

    function forumFilterSortComments() {
        const val = document.querySelector('.forum-comment-search-input').value.toLowerCase();
        let rows = commentsData.filter(d => d[5].toLowerCase().includes(val) || d[1].toLowerCase().includes(val) || d[2].toLowerCase().includes(val));
        
        let sortIdx = 3; // Date
        if (commentSortValue === 'author') sortIdx = 2;
        else if (commentSortValue === 'publication') sortIdx = 1;

        rows.sort((a,b) => {
            let vA = a[sortIdx].toLowerCase(), vB = b[sortIdx].toLowerCase();
            return commentSortDirection === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });

        commentFilteredRows = rows;
        commentCurrentPage = 1;
        renderCommentTable();
    }

    function forumFilterSortReactions() {
        const val = document.querySelector('.forum-reaction-search-input').value.toLowerCase();
        let rows = reactionsData.filter(d => d[0].toLowerCase().includes(val) || d[1].toLowerCase().includes(val) || d[2].toLowerCase().includes(val));
        
        let sortIdx = 3; // Date
        if (reactionSortValue === 'author') sortIdx = 2;
        else if (reactionSortValue === 'kind') sortIdx = 0;

        rows.sort((a,b) => {
            let vA = a[sortIdx].toLowerCase(), vB = b[sortIdx].toLowerCase();
            return reactionSortDirection === 'asc' ? vA.localeCompare(vB) : vB.localeCompare(vA);
        });

        reactionFilteredRows = rows;
        reactionCurrentPage = 1;
        renderReactionTable();
    }

    window.filterSortPublications = forumFilterSortPubs;
    window.filterSortComments = forumFilterSortComments;
    window.filterSortReactions = forumFilterSortReactions;

    function renderPubTable() {
        const tbody = document.getElementById('forum-pub-table-body');
        tbody.innerHTML = '';
        const start = (pubCurrentPage-1)*rowsPerPage;
        const end = Math.min(start+rowsPerPage, pubFilteredRows.length);
        
        for(let i=start; i<end; i++) {
            const row = document.createElement('tr');
            const data = pubFilteredRows[i];
            row.innerHTML = `
                <td><strong>${data[0]}</strong></td>
                <td><span class="badge-neon badge-neon-discussion">${data[1]}</span></td>
                <td>${data[2]}</td>
                <td>${data[3]}</td>
                <td style="text-align: right;">
                    <button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="event.stopPropagation(); viewPub(${i})">
                        <i class="bx bx-show"></i> Details
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        }
        renderPubPagination();
    }

    function renderCommentTable() {
        const tbody = document.getElementById('forum-comment-table-body');
        tbody.innerHTML = '';
        const start = (commentCurrentPage-1)*rowsPerPage;
        const end = Math.min(start+rowsPerPage, commentFilteredRows.length);
        
        for(let i=start; i<end; i++) {
            const row = document.createElement('tr');
            const data = commentFilteredRows[i];
            row.innerHTML = `
                <td>${data[0]}</td>
                <td><strong>${data[1]}</strong></td>
                <td>${data[2]}</td>
                <td>${data[3]}</td>
                <td style="text-align: right;">
                    <button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="event.stopPropagation(); viewComment(${i})">
                        <i class="bx bx-show"></i> Details
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        }
        renderCommentPagination();
    }

    function renderReactionTable() {
        const tbody = document.getElementById('forum-reaction-table-body');
        tbody.innerHTML = '';
        const start = (reactionCurrentPage-1)*rowsPerPage;
        const end = Math.min(start+rowsPerPage, reactionFilteredRows.length);
        
        for(let i=start; i<end; i++) {
            const row = document.createElement('tr');
            const data = reactionFilteredRows[i];
            row.innerHTML = `
                <td><span class="badge-neon badge-neon-${data[0].toLowerCase() === 'report' ? 'announcement' : 'discussion'}">${data[0]}</span></td>
                <td><strong>${data[1]}</strong></td>
                <td>${data[2]}</td>
                <td>${data[3]}</td>
                <td style="text-align: right;">
                    <button class="glass-btn-save" style="padding: 0.4rem 1.2rem; font-size: 0.85rem;" onclick="event.stopPropagation(); viewReaction(${i})">
                        <i class="bx bx-show"></i> Details
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        }
        renderReactionPagination();
    }

    function renderPubPagination() {
        const total = Math.ceil(pubFilteredRows.length / rowsPerPage);
        const container = document.getElementById('forum-pub-table-pages');
        container.innerHTML = '';
        for(let i=1; i<=total; i++) {
            const btn = document.createElement('button');
            btn.className = 'glass-pagination-btn' + (i === pubCurrentPage ? ' active' : '');
            btn.textContent = i;
            btn.onclick = () => { pubCurrentPage = i; renderPubTable(); };
            container.appendChild(btn);
        }
    }

    function renderCommentPagination() {
        const total = Math.ceil(commentFilteredRows.length / rowsPerPage);
        const container = document.getElementById('forum-comment-table-pages');
        container.innerHTML = '';
        for(let i=1; i<=total; i++) {
            const btn = document.createElement('button');
            btn.className = 'glass-pagination-btn' + (i === commentCurrentPage ? ' active' : '');
            btn.textContent = i;
            btn.onclick = () => { commentCurrentPage = i; renderCommentTable(); };
            container.appendChild(btn);
        }
    }

    function renderReactionPagination() {
        const total = Math.ceil(reactionFilteredRows.length / rowsPerPage);
        const container = document.getElementById('forum-reaction-table-pages');
        container.innerHTML = '';
        for(let i=1; i<=total; i++) {
            const btn = document.createElement('button');
            btn.className = 'glass-pagination-btn' + (i === reactionCurrentPage ? ' active' : '');
            btn.textContent = i;
            btn.onclick = () => { reactionCurrentPage = i; renderReactionTable(); };
            container.appendChild(btn);
        }
    }

    // --- Modal View Handlers ---
    window.viewPub = function(index) {
        const data = pubFilteredRows[index];
        document.getElementById('view-pub-topic').textContent = data[0];
        document.getElementById('view-pub-category').textContent = data[1];
        document.getElementById('view-pub-author').textContent = data[2];
        document.getElementById('view-pub-date').textContent = data[3];
        document.getElementById('view-pub-description').textContent = data[5];
        
        const imgRow = document.getElementById('view-pub-image-row');
        if(data[6]) {
            document.getElementById('view-pub-image').src = data[6];
            imgRow.style.display = 'flex';
        } else {
            imgRow.style.display = 'none';
        }

        document.getElementById('view-pub-delete-token').value = data[7];
        document.getElementById('view-pub-delete-form').action = deletePubUrlTemplate.replace('ID_PLACEHOLDER', data[4]);
        
        document.getElementById('view-pub-modify-btn').onclick = () => {
            const form = document.getElementById('pub-edit-form');
            form.action = editPubUrlTemplate.replace('ID_PLACEHOLDER', data[4]);
            // Pre-fill form fields if possible
            const titleInput = form.querySelector('[name*="titre_pub"]');
            if(titleInput) titleInput.value = data[0];
            const descInput = form.querySelector('[name*="description_pub"]');
            if(descInput) descInput.value = data[5];
            const catInput = form.querySelector('[name*="categorie_pub"]');
            if(catInput) catInput.value = data[1];

            openModal('pub-edit-modal');
        };

        // 1. Explicitly mark the modal as active before the switcher starts
        const vModal = document.getElementById('pub-view-modal');
        if (vModal) {
            vModal.style.display = 'flex';
            void vModal.offsetWidth;
            vModal.classList.add('active');
        }
        openModal('pub-view-modal');
    };

    window.viewComment = function(index) {
        const data = commentFilteredRows[index];
        document.getElementById('view-comment-text').textContent = data[5];
        document.getElementById('view-comment-pub').textContent = data[1];
        document.getElementById('view-comment-author').textContent = data[2];
        document.getElementById('view-comment-date').textContent = data[3];

        document.getElementById('view-comment-delete-token').value = data[7];
        document.getElementById('view-comment-delete-form').action = deleteCommentUrlTemplate.replace('ID_PLACEHOLDER', data[4]);

        document.getElementById('view-comment-modify-btn').onclick = () => {
            const form = document.getElementById('comment-edit-form');
            form.action = editCommentUrlTemplate.replace('ID_PLACEHOLDER', data[4]);
            const descInput = form.querySelector('[name*="description_commentaire"]');
            if(descInput) descInput.value = data[5];
            const visInput = form.querySelector('[name*="visibility"]');
            if(visInput) visInput.checked = data[6] === 'true';

            openModal('comment-edit-modal');
        };

        // 1. Explicitly mark the modal as active before the switcher starts
        const vModal = document.getElementById('comment-view-modal');
        if (vModal) {
            vModal.style.display = 'flex';
            void vModal.offsetWidth;
            vModal.classList.add('active');
        }
        openModal('comment-view-modal');
    };

    window.viewReaction = function(index) {
        const data = reactionFilteredRows[index];
        document.getElementById('view-reaction-kind').textContent = data[0];
        document.getElementById('view-reaction-author').textContent = data[2];
        document.getElementById('view-reaction-target').textContent = data[1];
        document.getElementById('view-reaction-date').textContent = data[3];
        document.getElementById('view-reaction-reason').innerHTML = (data[5] ? `Emoji: ${data[5]}<br>` : '') + (data[6] ? `Reason: ${data[6]}` : '');

        document.getElementById('view-reaction-delete-token').value = data[7];
        document.getElementById('view-reaction-delete-form').action = deleteReactionUrlTemplate.replace('ID_PLACEHOLDER', data[4]);

        document.getElementById('view-reaction-modify-btn').onclick = () => {
            const form = document.getElementById('reaction-edit-form');
            form.action = editReactionUrlTemplate.replace('ID_PLACEHOLDER', data[4]);
            
            const kindSelect = form.querySelector('[name*="kind"]');
            if(kindSelect) kindSelect.value = data[0];
            const emojiInput = form.querySelector('[name*="emoji"]');
            if(emojiInput) emojiInput.value = data[5];
            const reasonInput = form.querySelector('[name*="report_reason"]');
            if(reasonInput) reasonInput.value = data[6];

            openModal('reaction-edit-modal');
        };

        const vModal = document.getElementById('reaction-view-modal');
        if (vModal) {
            vModal.style.display = 'flex';
            void vModal.offsetWidth;
            vModal.classList.add('active');
        }
        openModal('reaction-view-modal');
    };

    document.addEventListener('DOMContentLoaded', () => {
        // --- Premium Switcher ---
        const slider = document.getElementById('forum-switcher-slider');
        const tabs = document.querySelectorAll('.premium-switcher-tab');
        const pages = document.querySelectorAll('.forum-page-content');

        tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                slider.style.left = (index * (100 / tabs.length)) + '%';
                slider.style.width = (100 / tabs.length) + '%';
                
                const pageNum = tab.dataset.page;
                pages.forEach(p => p.style.display = p.dataset.page === pageNum ? 'block' : 'none');
                
                // Adjust height of switcher on page change
                const activePage = document.querySelector(`.forum-page-content[data-page="${pageNum}"]`);
                const activeSwitcher = activePage.querySelector('.glass-switcher');
                if(activeSwitcher) {
                    const currentFace = activeSwitcher.classList.contains('active-details') ? 'details' : 
                                       (activeSwitcher.classList.contains('active-edit') ? 'edit' : 
                                       (activeSwitcher.classList.contains('active-extra') ? 'extra' : 'main'));
                    switchGlassFace(currentFace, activeSwitcher.id);
                }
            });
        });
        
        // Initial slider position
        slider.style.width = (100 / tabs.length) + '%';

        // Initial table renders
        renderPubTable();
        renderCommentTable();
        renderReactionTable();

        updatePubSortDirIcon();
        updateCommentSortDirIcon();
        updateReactionSortDirIcon();
        
        // Initial height set
        switchGlassFace('main', 'forumPubGlassSwitcher');
        
        // Sort Direction Toggles
        document.getElementById('forum-pub-sort-dir-pill').addEventListener('click', () => {
            pubSortDirection = pubSortDirection === 'asc' ? 'desc' : 'asc';
            updatePubSortDirIcon();
            forumFilterSortPubs();
        });

        document.getElementById('forum-comment-sort-dir-pill').addEventListener('click', () => {
            commentSortDirection = commentSortDirection === 'asc' ? 'desc' : 'asc';
            updateCommentSortDirIcon();
            forumFilterSortComments();
        });

        document.getElementById('forum-reaction-sort-dir-pill').addEventListener('click', () => {
            reactionSortDirection = reactionSortDirection === 'asc' ? 'desc' : 'asc';
            updateReactionSortDirIcon();
            forumFilterSortReactions();
        });

        // Add Pub button
        document.getElementById('forum-btn-add-pub').addEventListener('click', () => openModal('pub-add-modal'));

        // Search Pub
        document.querySelector('.forum-pub-search-input').addEventListener('input', (e) => {
            forumFilterSortPubs();
        });

        // Search Comment
        document.querySelector('.forum-comment-search-input').addEventListener('input', (e) => {
            forumFilterSortComments();
        });

        // Search Reaction
        document.querySelector('.forum-reaction-search-input').addEventListener('input', (e) => {
            forumFilterSortReactions();
        });
    });
</script>
{% endblock %}
