                            <input type="text" class="glass-search-input forum-reaction-search-input" placeholder="Search reactions (kind, reason, user)...">
                        </div>
                        
                        <div style="display: flex; gap: 0.5rem;">
                            <div class="glass-pill glass-pill-active forum-reaction-sort-option" data-value="date" onclick="selectReactionSortPill(this)">Date</div>
                            <div class="glass-pill forum-reaction-sort-option" data-value="kind" onclick="selectReactionSortPill(this)">Kind</div>
                            <div class="glass-pill forum-reaction-sort-option" data-value="author" onclick="selectReactionSortPill(this)">Author</div>
                            <button class="glass-pagination-btn" id="forum-reaction-sort-dir-pill" style="width: 38px; height: 38px;">
